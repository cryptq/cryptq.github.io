<Item XName="Subterminals" Type="SerItem">
<Item XName="T1" Type="SubTerm">
<NetName>16</NetName></Item></Item></Item></Item></Item>
<Item XName="Equations" Type="Equation">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>&#x000D;&#x000A;&#x000D;&#x000A;%%%%%%%%%%%%%%%%%%%%%%%%%% range check %%%%%%%%%%%%%%%%%%%%%%%%%%%%&#x000D;&#x000A;if (FCarrier &gt;= 410e6 &amp;&amp; FCarrier &lt;= 7125e6)&#x000D;&#x000A;&#x0009;FrequencyRange = 0; %FR1&#x000D;&#x000A;elseif (FCarrier &gt;= 24.25e9 &amp;&amp; FCarrier &lt;= 52.6e9)&#x000D;&#x000A;%&#x0009;error(&apos;FCarrier in [24250MHz, 52600MHz] for FR2 is not supported by this workspace&apos;);&#x000D;&#x000A;&#x0009;FrequencyRange = 1; %FR2&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;error(&apos;FCarrier should be in range: {FR1: 410 MHz ~ 7125 MHz} or {FR2: 24250 MHz ~ 52600 MHz}&apos;);&#x000D;&#x000A;&#x0009;FrequencyRange = 0;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if (SignalPower &lt;= 0)&#x000D;&#x000A;&#x0009;error(&apos;SignalPower should be greater than 0(W)&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if (MirrorSignal&lt;0 || MirrorSignal&gt;1)&#x000D;&#x000A;&#x0009;error(&apos;MirrorSignal should be 0(No) or 1(Yes)&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if (Bandwidth &lt; 0 || Bandwidth &gt; 14)&#x000D;&#x000A;&#x0009;error(&apos;Bandwidth should be in range [0, 14]&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if (OversamplingOption &lt; 0 || OversamplingOption &gt; 6)&#x000D;&#x000A;&#x0009;error(&apos;OversamplingOption should be in range [0, 6]&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if (EnableTxFilter&lt;0 || EnableTxFilter&gt;1)&#x000D;&#x000A;&#x0009;error(&apos;EnableTxFilter should be 0(disabled) or 1(enabled)&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if (EnableTxFilter==1 &amp;&amp; (FIR_Taps&lt;1 || FIR_Taps&gt;1000))&#x000D;&#x000A;&#x0009;error(&apos;FIR_Taps should be in range [1, 1000]&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if (EnableRxFilter&lt;0 || EnableRxFilter&gt;1)&#x000D;&#x000A;&#x0009;error(&apos;EnableRxFilter should be 0(disabled) or 1(enabled)&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if (ReportEVMIndB&lt;0 || ReportEVMIndB&gt;1)&#x000D;&#x000A;&#x0009;error(&apos;ReportEVMIndB should be 0(No) or 1(Yes)&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if (SaveConstellation&lt;0 || SaveConstellation&gt;1)&#x000D;&#x000A;&#x0009;error(&apos;SaveConstellation should be 0(No) or 1(Yes)&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;SaveSubcarriersResults = SaveConstellation; % Save(1) the demodulated constellation to dataset for display or Not(0)&#x000D;&#x000A;&#x000D;&#x000A;if (UseTestModel&lt;0 || UseTestModel&gt;1)&#x000D;&#x000A;&#x0009;error(&apos;UseTestModel should be 0(No) or 1(Yes)&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if (DuplexType&lt;0 || DuplexType&gt;1)&#x000D;&#x000A;&#x0009;error(&apos;DuplexType should be 0(TDD) or 1(FDD)&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if (UseTestModel==0 &amp;&amp; (SimNumSubframes&lt;=10 || mod(SimNumSubframes,10)&gt;0))&#x000D;&#x000A;&#x0009;error(&apos;SimNumSubframes should be multiples of 10 and no less than 20 to complete EVM measurements based on NR radio frame&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if (UseTestModel==1 &amp;&amp; (SimNumSubframes&lt;=20 || mod(SimNumSubframes,10)&gt;0))&#x000D;&#x000A;&#x0009;error(&apos;SimNumSubframes should be multiples of 10 and no less than 30 to complete TestModel EVM measurements based on NR radio frame&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if (FrequencyRange==0 &amp;&amp; (EnableTxRFLink&lt;0 || EnableTxRFLink&gt;1))&#x000D;&#x000A;&#x0009;error(&apos;EnableTxRFLink should be 0(disabled) or 1(enabled)&apos;);&#x000D;&#x000A;elseif (FrequencyRange==1 &amp;&amp; (EnableTxRFLink~=0))&#x000D;&#x000A;&#x0009;error(&apos;TxRFLink only works for FR1,please set EnableTxRFLink to 0(disabled)&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if (RunFromMATLAB&lt;0 || RunFromMATLAB&gt;1)&#x000D;&#x000A;&#x0009;error(&apos;RunFromMATLAB should be 0(No) or 1(Yes)&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if (FrequencyRange==0)&#x000D;&#x000A;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;switch Numerology&#x000D;&#x000A;&#x0009;case 0&#x000D;&#x000A;&#x0009;&#x0009;if (Bandwidth &gt; 7)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;error(&apos;Bandwidth should not be wider than 50MHz for Numerolgoy 0(15kHz) in FR1 {410 MHz ~ 7125 MHz}&apos;);&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;case 1&#x000D;&#x000A;&#x0009;&#x0009;if (Bandwidth &gt; 12)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;error(&apos;Bandwidth should not be wider than 100MHz for Numerolgoy 1(30kHz) in FR1 {410 MHz ~ 7125 MHz}&apos;);&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;case 2&#x000D;&#x000A;&#x0009;&#x0009;if (Bandwidth &gt; 12)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;error(&apos;Bandwidth should not be wider than 100MHz for Numerolgoy 2(60kHz) in FR1 {410 MHz ~ 7125 MHz}&apos;);&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;if (Bandwidth &lt; 1)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;error(&apos;Bandwidth should not be less than 10MHz for Numerolgoy 2(60kHz) in FR1 {410 MHz ~ 7125 MHz}&apos;);&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;otherwise&#x000D;&#x000A;&#x0009;&#x0009;error(&apos;Numerology should be 0(15kHz), 1(30kHz) or 2(60kHz) in FR1 {410 MHz ~ 7125 MHz}&apos;);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x000D;&#x000A;else&#x000D;&#x000A;%&#x0009;error(&apos;FR2 is not supported by this workspace&apos;);&#x000D;&#x000A;&#x0009;if (Bandwidth ~= 7 &amp;&amp; Bandwidth &lt; 12)&#x000D;&#x000A;&#x0009;&#x0009;error(&apos;Bandwidth should be 50MHz, 100MHz, 200MHz or 400MHz in FR2 {24250MHz ~ 52600MHz}&apos;);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;if (Bandwidth == 14 &amp;&amp; Numerology ==2)&#x000D;&#x000A;&#x0009;&#x0009;error(&apos;Bandwidth should be less than 400MHz for Numerolgoy 2(60kHz) in FR2 {24250MHz ~ 52600MHz}&apos;);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x0009;&#x000D;&#x000A;&#x0009;if (Numerology&lt;2 || Numerology&gt;4)&#x000D;&#x000A;&#x0009;&#x0009;error(&apos;Numerology should be 2(60kHz), 3(120kHz) or 4(240kHz) in FR2 {24250MHz ~ 52600MHz}&apos;);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;BandwidthTable =[5e6,10e6,15e6,20e6,25e6,30e6,40e6,50e6,60e6,70e6,80e6,90e6,100e6,200e6,400e6];&#x000D;&#x000A;&#x000D;&#x000A;FR1NumRBsTable=[25,52,79,106,133,160,216,270,0,0,0,0,0;&#x000D;&#x000A;&#x0009;&#x0009;11,24,38,51,65,78,106,133,162,189,217,245,273;&#x000D;&#x000A;&#x0009;&#x0009;0,11,18,24,31,38,51,65,79,93,107,121,135];&#x000D;&#x000A;FR2NumRBsTable=[66,132,264,0;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;32,66,132,264;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;17,34,69,138];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;if(FrequencyRange ==0)&#x000D;&#x000A;&#x0009;CarrierNumRBs = FR1NumRBsTable(Numerology+1,Bandwidth+1);&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;if(Bandwidth&lt;10)&#x000D;&#x000A;&#x0009;&#x0009;NumRBsIdx = 1;&#x000D;&#x000A;&#x0009;else&#x000D;&#x000A;&#x0009;&#x0009;NumRBsIdx = Bandwidth-10;&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x0009;CarrierNumRBs = FR2NumRBsTable(Numerology-1,NumRBsIdx);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if(UseTestModel == 0)&#x0009;% Non-TM&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;if (PDSCH_Enable==0 &amp;&amp; SSB_Enable==0)&#x000D;&#x000A;&#x0009;&#x0009;error(&apos;Either SSB or PDSCH should be enabled&apos;);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;if((Numerology==2 || Numerology==4) &amp;&amp; SSB_Enable==1)&#x000D;&#x000A;&#x0009;&#x0009;error(&apos;SSB should be disabled when Numerology is 60kHz or 240kHz&apos;)&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x0009;&#x000D;&#x000A;&#x0009;if (SSB_Enable&lt;0 || SSB_Enable&gt;1)&#x000D;&#x000A;&#x0009;&#x0009;error(&apos;SSB_Enable should be 0(disabled) or 1(enabled)&apos;);&#x000D;&#x000A;&#x0009;elseif (SSB_Enable == 1)&#x000D;&#x000A;&#x0009;&#x0009;if (SSB_RBOffset &lt; 0)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;error(&apos;SSB_RBOffset should be equal to or greater than 0&apos;);&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;if (SSB_RBOffset+20 &gt; CarrierNumRBs)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;error(&apos;SSB is in RB range of [%d, %d], which is out of BWP range. Please check SSB_RBOffset or Bandwidth configuration or to set SSB_Enable to 0&apos;,SSB_RBOffset,SSB_RBOffset+19);&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;if Numerology &lt; 2&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;if (SSB_Lmax&lt;0 || SSB_Lmax&gt;1)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;error(&apos;SSB_Lmax should be 0(L=4) or 1(L=8)&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;else&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;if (SSB_Lmax~=2)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;error(&apos;SSB_Lmax should be 2(L=64)&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;if (PDSCH_Enable&lt;0 || PDSCH_Enable&gt;1)&#x000D;&#x000A;&#x0009;&#x0009;error(&apos;PDSCH_Enable should be 0 or 1&apos;);&#x000D;&#x000A;&#x0009;elseif (PDSCH_Enable == 1)&#x000D;&#x000A;&#x0009;&#x0009;if (PDSCH_RBOffset &lt; 0)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;error(&apos;PDSCH_RBOffset should be equal to or greater than 0&apos;);&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;if (PDSCH_NumRBs &lt;= 0)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;error(&apos;PDSCH_NumRBs should be greater than 0&apos;);&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;if (PDSCH_NumRBs + PDSCH_RBOffset &gt; CarrierNumRBs)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;str = [&apos;For the selected Bandwidth, BWP NumRBs is &apos; num2str(CarrierNumRBs) &apos;. Plese check PDSCH_RBOffset and PDSCH_NumRBs as it is out of BWP&apos;];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;error(str);&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x0009;&#x000D;&#x000A;&#x0009;if (Modulation &lt; 1 || Modulation &gt; 4)&#x000D;&#x000A;&#x0009;&#x0009;error(&apos;Modulation should be in range [1, 4]&apos;);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x0009;EPRE=10*log10(SignalPower*1e3) -10*log10(PDSCH_NumRBs*12*2^Numerology);&#x000D;&#x000A;&#x0009;NumPorts =2;&#x000D;&#x000A;&#x0009;&#x000D;&#x000A;else&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;if (FrequencyRange==0 &amp;&amp; (TestModel&lt;0 || TestModel&gt;7))&#x000D;&#x000A;&#x0009;&#x0009;error(&apos;TestModel should be in range [0, 7] for FR1 {24250MHz ~ 52600MHz}&apos;);&#x000D;&#x000A;&#x0009;elseif (FrequencyRange==1 &amp;&amp; (TestModel&lt;8 || TestModel&gt;10))&#x000D;&#x000A;&#x0009;&#x0009;error(&apos;TestModel should be in range [8, 10] for FR2 {24250MHz ~ 52600MHz}&apos;);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;if (FrequencyRange==1 &amp;&amp; DuplexType==1)&#x000D;&#x000A;&#x0009;&#x0009;error(&apos;FDD is not supported for TestModel in FR2 {24250MHz ~ 52600MHz}&apos;);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x0009;&#x000D;&#x000A;&#x0009;SSB_Enable = 0;&#x000D;&#x000A;&#x0009;SSB_RBOffset = 0;&#x000D;&#x000A;&#x0009;SSB_Lmax = 0;&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;PDSCH_NumRBs = [CarrierNumRBs,CarrierNumRBs,1,1,CarrierNumRBs,CarrierNumRBs,CarrierNumRBs,CarrierNumRBs,CarrierNumRBs,1,CarrierNumRBs];&#x000D;&#x000A;&#x0009;EPRE=10*log10(SignalPower*1e3) -10*log10(PDSCH_NumRBs(TestModel+1)*12*2^Numerology);&#x000D;&#x000A;&#x0009;&#x000D;&#x000A;&#x0009;%%support all test models&#x000D;&#x000A;&#x0009;PortsTableTDD =[8,12,10,10,8,8,12,12,8,12,8];&#x000D;&#x000A;&#x0009;PortsTableFDD =[4,6,6,6,4,4,6,6];&#x000D;&#x000A;&#x0009;if(DuplexType==1)&#x000D;&#x000A;&#x0009;&#x0009;NumPorts = PortsTableFDD(TestModel+1);&#x0009;&#x000D;&#x000A;&#x0009;else&#x000D;&#x000A;&#x0009;&#x0009;NumPorts = PortsTableTDD(TestModel+1);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;BWP_RBOffset = 0;&#x000D;&#x000A;&#x000D;&#x000A;if(SSB_Enable==0)&#x000D;&#x000A;&#x0009;SSB_Numerology = 0;&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;SSB_Numerology = Numerology;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;SSB_RBOffset_EVM = SSB_RBOffset;  %(240khz SSB isn&apos;t supported)&#x000D;&#x000A;&#x000D;&#x000A;L_Table = [4, 8, 64];&#x000D;&#x000A;Num_SSB = L_Table(SSB_Lmax + 1);&#x000D;&#x000A;ActiveSSB = [0:Num_SSB-1];&#x000D;&#x000A;PDSCH_NumAllocatedSlots = 10 * 2^Numerology;&#x000D;&#x000A;PDSCH_AllocatedSlots = [0:PDSCH_NumAllocatedSlots-1];&#x000D;&#x000A;EVM_StartSlot = PDSCH_AllocatedSlots(1);&#x0009;&#x000D;&#x000A;EVM_NumSlots = PDSCH_NumAllocatedSlots;&#x000D;&#x000A;&#x0009;&#x000D;&#x000A;ResLenInSubframes = 10;&#x000D;&#x000A;MeasInterval = 140*2^Numerology;&#x000D;&#x000A;AnalysisBoundary = 0;&#x000D;&#x000A;&#x000D;&#x000A;if(OversamplingOption &gt;1)&#x000D;&#x000A;&#x0009;OversamplingOptionEVM = 1;&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;OversamplingOptionEVM = OversamplingOption;&#x000D;&#x000A;end&#x000D;&#x000A;FilterType = 2*EnableTxFilter;&#x000D;&#x000A;FilterBandwidth = BandwidthTable(Bandwidth+1);&#x000D;&#x000A;DownSampleFactor = 2^(OversamplingOption)/2;&#x000D;&#x000A;&#x000D;&#x000A;SamplingRate = 2^ceil(log2(CarrierNumRBs*12))*2^(OversamplingOption)*15e3*2^Numerology;&#x0009;% System sample rate calculation&#x000D;&#x000A;BlockSize = 0.001*SamplingRate;&#x000D;&#x000A;NumElement = 1e-3 * SamplingRate;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;% total number of samples per subframe&#x000D;&#x000A;SimNumSlots = SimNumSubframes*2^Numerology;&#x000D;&#x000A;SimNumFrames = floor((SimNumSubframes-5)/10); % ceil(SimNumSubframes/10);&#x000D;&#x000A;&#x000D;&#x000A;if (NumElement&gt;2457600) % 122.88e6*10e-3&#x000D;&#x000A;&#x0009;error(&apos;Transferring over %d samples per subframe between SystemVueEngind and Matlab is memory comsuming due to large Bandwidth, Numerology or OversamplingOption. Please check these parameters&apos;,NumElement);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;SyncType = 0;&#x0009;&#x0009;&#x0009;% EVM_Sync_Auto&#x000D;&#x000A;SinkTime = 10e-3;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;  &#x000D;&#x000A;FCarrierRx = FCarrier;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x000D;&#x000A;setvariable(&apos;Tx_Data&apos;,&apos;ResFCarrier&apos;,FCarrierRx);&#x000D;&#x000A;setvariable(&apos;Tx_Data&apos;,&apos;NumBWPs&apos;,NumPorts/2);&#x000D;&#x000A;</Text>
