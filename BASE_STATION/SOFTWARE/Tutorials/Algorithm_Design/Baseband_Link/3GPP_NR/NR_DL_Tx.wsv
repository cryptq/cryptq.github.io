<Item XName="ACLR_Calculation" UserName="ACLR_Calculation" Type="Folder">
<IsOpen><T>Bool</T><D>0</D></IsOpen>
<Selected><T>Bool</T><D>0</D></Selected>
<Item XName="NR_ACLR_Measurement" UserName="NR_ACLR_Measurement" Type="function">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>function ACLR = NR_ACLR_Measurement(FCarrier, ResFCarrier, Numerology, Bandwidth, Spec_CxVlotage, Spec_CxVlotage_Freq, Offset)&#x000D;&#x000A;% calcualte the Adjacent Channel Leakage Ratio of NR siganl&#x000D;&#x000A;% FCarrier: center frequency of the NR signal&#x000D;&#x000A;% Numerology: 0: 15kHz;1:30kHz;2,60kHz;3,120kHz,4,240kHz&#x000D;&#x000A;% Bandwidth: NR signal bandwidth&#x000D;&#x000A;% Spec_Power: spectrum power got from SpectrumAnalyzer&#x000D;&#x000A;% Spec_Power_Freq: frequency corresponding to the Spec_Power&#x000D;&#x000A;% Offset: freqeuncy offset, -1 means adjacent channel frequency center frequency offset below the signal carrier frequency by BW&#x000D;&#x000A;&#x000D;&#x000A;BWTable = [5e6,10e6,15e6,20e6,25e6,30e6,40e6,50e6,60e6,70e6,80e6,90e6,100e6,200e6,400e6] % actual Bandwidth&#x000D;&#x000A;BW = BWTable(Bandwidth+1);&#x000D;&#x000A;&#x000D;&#x000A;FR1NumRBsTable=[25,52,79,106,133,160,216,270,0,0,0,0,0;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;11,24,38,51,65,78,106,133,162,189,217,245,273;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;0,11,18,24,31,38,51,65,79,93,107,121,135];&#x000D;&#x000A;FR2NumRBsTable=[66,132,264,0;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;32,66,132,264;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;17,34,69,138];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;if(FCarrier &lt;=7.125e9)&#x000D;&#x000A;&#x0009;CarrierNumRBs = FR1NumRBsTable(Numerology+1,Bandwidth+1);&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;if(Bandwidth&lt;10)&#x000D;&#x000A;&#x0009;&#x0009;NumRBsIdx = 1;&#x000D;&#x000A;&#x0009;else&#x000D;&#x000A;&#x0009;&#x0009;NumRBsIdx = Bandwidth-10;&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x0009;CarrierNumRBs = FR2NumRBsTable(Numerology-1,NumRBsIdx);&#x000D;&#x000A;end&#x000D;&#x000A;RefBW =CarrierNumRBs*180e3*2^Numerology; % transmission bandwidth&#x000D;&#x000A;&#x000D;&#x000A;Fc = ResFCarrier; % center frequency&#x000D;&#x000A;Ref_Fstart = Fc - RefBW/2; &#x000D;&#x000A;Ref_Fstop = Fc + RefBW/2;&#x000D;&#x000A;&#x000D;&#x000A;Fc_Offset = Fc + Offset*BW; % adjacent channel frequency&#x000D;&#x000A;Offset_Fstart = Fc_Offset - RefBW/2;&#x000D;&#x000A;Offset_Fstop = Fc_Offset + RefBW/2;&#x000D;&#x000A;&#x000D;&#x000A;index_Low = find(Spec_CxVlotage_Freq &gt;= Ref_Fstart, 1, &apos;first&apos;);&#x000D;&#x000A;index_High = find(Spec_CxVlotage_Freq &gt;= Ref_Fstop, 1, &apos;first&apos;);&#x000D;&#x000A;Spec_Power = abs(Spec_CxVlotage).^2;&#x000D;&#x000A;Power_Ref = sum(Spec_Power(index_Low:index_High));&#x000D;&#x000A;&#x000D;&#x000A;if (Offset_Fstart&lt;Spec_CxVlotage_Freq(1) || Offset_Fstart&gt;Spec_CxVlotage_Freq(end))&#x000D;&#x000A;&#x0009;index_Low = int16.empty(1,0);&#x000D;&#x000A;elseif (Offset_Fstop&lt;Spec_CxVlotage_Freq(1) || Offset_Fstop&gt;Spec_CxVlotage_Freq(end))&#x000D;&#x000A;&#x0009;index_High = int16.empty(1,0);&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;index_Low = find(Spec_CxVlotage_Freq &gt;= Offset_Fstart, 1, &apos;first&apos;);&#x000D;&#x000A;&#x0009;index_High = find(Spec_CxVlotage_Freq &gt;= Offset_Fstop, 1, &apos;first&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;Power_Offset = sum(Spec_Power(index_Low:index_High));&#x000D;&#x000A;&#x000D;&#x000A;ACLR = 10*log10( Power_Ref / Power_Offset );&#x000D;&#x000A;&#x000D;&#x000A;end</Text>
