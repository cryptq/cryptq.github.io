<Item XName="Parameter" UserName="Parameter" Type="Equation">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>&#x000D;&#x000A;&#x000D;&#x000A;xAxis = 0.5*[0:7];&#x000D;&#x000A;yAxis = 0.5*[0:7];&#x000D;&#x000A;&#x000D;&#x000A;[X,Y] = meshgrid(xAxis,yAxis);&#x000D;&#x000A;X = X(:);&#x000D;&#x000A;Y = Y(:);&#x000D;&#x000A;</Text>
