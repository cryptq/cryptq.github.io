<Item XName="Radar System 2 (Modified)" UserName="Radar System 2 (Modified)" Type="Folder">
<IsOpen><T>Bool</T><D>1</D></IsOpen>
<Selected><T>Bool</T><D>1</D></Selected>
<Item XName="2DPattern" UserName="2DPattern" Type="Equation">
<AutoCalc><T>Bool</T><D>0</D></AutoCalc>
<Selected><T>Bool</T><D>0</D></Selected>
<Text>using(&apos;Radar_PhaseArrayData&apos;);&#x000D;&#x000A;&#x000D;&#x000A;Pattern_Value = abs(PatternData);&#x000D;&#x000A;Pattern_mat = reshape(Pattern_Value, 181, 361);&#x000D;&#x000A;Pattern_mat = Pattern_mat&apos;;&#x000D;&#x000A;&#x000D;&#x000A;%% According to the antenna data format of EMpro and HFSS&#x000D;&#x000A;%% The range of theta is [0:pi]&#x000D;&#x000A;%% The range of phi is [0:2*pi]&#x000D;&#x000A;theta = [0 : 180];&#x000D;&#x000A;phi = [0 : 360];&#x000D;&#x000A;[T P] = meshgrid(theta, phi);&#x000D;&#x000A;&#x000D;&#x000A;%% For XY-plane, x axis is along the horizontal direction and y axis is along the vertical direction&#x000D;&#x000A;u = sin(T/180*pi) .* cos(P/180*pi);&#x000D;&#x000A;v = sin(T/180*pi) .* sin(P/180*pi);&#x000D;&#x000A;w = cos(T/180*pi);&#x000D;&#x000A;&#x000D;&#x000A;graph = graph_figure(&apos;Planar Array 2D array pattern&apos;);&#x000D;&#x000A;graph.clear_data();&#x000D;&#x000A;graph.add_surface_data(u,v, Pattern_mat,&apos;surface1&apos;);&#x000D;&#x000A;graph.set_title(&apos;Planar Array 2D array pattern&apos;);&#x000D;&#x000A;graph.set_label_x(&apos;u_coord&apos;);&#x000D;&#x000A;graph.set_label_y(&apos;V_coord&apos;);</Text>
<Item XName="BPMgr" Type="BPMgr">
<BPLines><T>Empty</T></BPLines>
<BPStates><T>Empty</T></BPStates></Item>
