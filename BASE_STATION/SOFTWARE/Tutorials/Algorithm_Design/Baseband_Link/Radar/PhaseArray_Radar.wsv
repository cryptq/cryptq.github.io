<AutoCalc><T>Bool</T><D>0</D></AutoCalc>
<Selected><T>Bool</T><D>0</D></Selected>
<Text>using(&apos;Radar_PhaseArrayData&apos;);&#x000D;&#x000A;&#x000D;&#x000A;Pattern_Value = abs(PatternData);&#x000D;&#x000A;%Pattern_Value = 20*log10(Pattern_Value);&#x000D;&#x000A;Pattern_mat = reshape(Pattern_Value, 181, 361);&#x000D;&#x000A;Pattern_mat = Pattern_mat&apos;;&#x000D;&#x000A;&#x000D;&#x000A;%% For XY-plane, x axis is along the horizontal direction and y axis is along the vertical direct&#x000D;&#x000A;theta = [0 : 180];&#x000D;&#x000A;phi = [0 : 360];&#x000D;&#x000A;[T P] = meshgrid(theta, phi);&#x000D;&#x000A;u = sin(T/180*pi) .* cos(P/180*pi);&#x000D;&#x000A;v = sin(T/180*pi) .* sin(P/180*pi);&#x000D;&#x000A;w = cos(T/180*pi);&#x000D;&#x000A;&#x000D;&#x000A;%% The function cart2sph convert the data to the spherical coordinates using azimuth and elevation&#x000D;&#x000A;%% Please refer to Matlab cart2sph help doc&#x000D;&#x000A;[Azm,Elv,Pattern_mat_re] = cart2sph(Pattern_mat.*u,Pattern_mat.*v,Pattern_mat.*w);&#x000D;&#x000A;&#x000D;&#x000A;%% Verify that our u,v,w do what we think they do.&#x000D;&#x000A;assert(norm(Pattern_mat(:)-Pattern_mat_re(:))&lt;1e-9);&#x000D;&#x000A;&#x000D;&#x000A;graph = graph_figure(&apos;Planar Array Spherical Pattern View&apos;);&#x000D;&#x000A;%% The function add_spherical_data uses the phi and theta&#x000D;&#x000A;%% The phi equals to the azimuth used by cart2sph&#x000D;&#x000A;%% The theta equals to pi/2-elevation used by cart2sph&#x000D;&#x000A;%% Please refer to the Matlab Script add_spherical_data help doc&#x000D;&#x000A;graph.clear_data();&#x000D;&#x000A;graph.add_spherical_data(Azm, pi/2-Elv, Pattern_mat_re,&apos;surface2&apos;);&#x000D;&#x000A;graph.set_title(&apos;Planar Array Spherical Pattern View&apos;);&#x000D;&#x000A;graph.set_colormap(&apos;arctic&apos;);</Text>
