n 0in 0pt&quot; class=MsoNormal&gt;&lt;SPAN style=&quot;mso-font-kerning: 1.0pt; mso-fareast-font-family: SimSun&quot;&gt;&lt;FONT face=Calibri&gt;p(x) = x^11 + x^2 + 1&lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;&lt;/TD&gt;&lt;/TR&gt;&#x000D;&#x000A;&lt;TR style=&quot;mso-yfti-irow: 3&quot;&gt;&#x000D;&#x000A;&lt;TD style=&quot;BORDER-BOTTOM: black 1pt solid; BORDER-LEFT: black 1pt solid; PADDING-BOTTOM: 0in; BACKGROUND-COLOR: transparent; PADDING-LEFT: 5.4pt; WIDTH: 2.7in; PADDING-RIGHT: 5.4pt; BORDER-TOP: #ece9d8; BORDER-RIGHT: black 1pt solid; PADDING-TOP: 0in; mso-border-alt: solid black .5pt; mso-border-themecolor: text1; mso-border-top-alt: solid black .5pt; mso-border-top-themecolor: text1&quot; width=259&gt;&#x000D;&#x000A;&lt;P style=&quot;TEXT-ALIGN: center; LINE-HEIGHT: normal; MARGIN: 0in 0in 0pt&quot; class=MsoNormal align=center&gt;&lt;FONT face=Calibri&gt;&lt;SPAN style=&quot;mso-font-kerning: 1.0pt; mso-fareast-font-family: SimSun&quot;&gt;PN12&lt;/SPAN&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/P&gt;&lt;/TD&gt;&#x000D;&#x000A;&lt;TD style=&quot;BORDER-BOTTOM: black 1pt solid; BORDER-LEFT: #ece9d8; PADDING-BOTTOM: 0in; BACKGROUND-COLOR: transparent; PADDING-LEFT: 5.4pt; WIDTH: 3.95in; PADDING-RIGHT: 5.4pt; BORDER-TOP: #ece9d8; BORDER-RIGHT: black 1pt solid; PADDING-TOP: 0in; mso-border-alt: solid black .5pt; mso-border-themecolor: text1; mso-border-left-alt: solid black .5pt; mso-border-left-themecolor: text1; mso-border-top-alt: solid black .5pt; mso-border-top-themecolor: text1; mso-border-bottom-themecolor: text1; mso-border-right-themecolor: text1&quot; width=379&gt;&#x000D;&#x000A;&lt;P style=&quot;LINE-HEIGHT: normal; MARGIN: 0in 0in 0pt&quot; class=MsoNormal&gt;&lt;SPAN style=&quot;mso-font-kerning: 1.0pt; mso-fareast-font-family: SimSun&quot;&gt;&lt;FONT face=Calibri&gt;p(x) = x^12 + x^6 + x^4 + x + 1&lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;&lt;/TD&gt;&lt;/TR&gt;&#x000D;&#x000A;&lt;TR style=&quot;mso-yfti-irow: 4&quot;&gt;&#x000D;&#x000A;&lt;TD style=&quot;BORDER-BOTTOM: black 1pt solid; BORDER-LEFT: black 1pt solid; PADDING-BOTTOM: 0in; BACKGROUND-COLOR: transparent; PADDING-LEFT: 5.4pt; WIDTH: 2.7in; PADDING-RIGHT: 5.4pt; BORDER-TOP: #ece9d8; BORDER-RIGHT: black 1pt solid; PADDING-TOP: 0in; mso-border-alt: solid black .5pt; mso-border-themecolor: text1; mso-border-top-alt: solid black .5pt; mso-border-top-themecolor: text1&quot; width=259&gt;&#x000D;&#x000A;&lt;P style=&quot;TEXT-ALIGN: center; LINE-HEIGHT: normal; MARGIN: 0in 0in 0pt&quot; class=MsoNormal align=center&gt;&lt;FONT face=Calibri&gt;&lt;SPAN style=&quot;mso-font-kerning: 1.0pt; mso-fareast-font-family: SimSun&quot;&gt;PN13&lt;/SPAN&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/P&gt;&lt;/TD&gt;&#x000D;&#x000A;&lt;TD style=&quot;BORDER-BOTTOM: black 1pt solid; BORDER-LEFT: #ece9d8; PADDING-BOTTOM: 0in; BACKGROUND-COLOR: transparent; PADDING-LEFT: 5.4pt; WIDTH: 3.95in; PADDING-RIGHT: 5.4pt; BORDER-TOP: #ece9d8; BORDER-RIGHT: black 1pt solid; PADDING-TOP: 0in; mso-border-alt: solid black .5pt; mso-border-themecolor: text1; mso-border-left-alt: solid black .5pt; mso-border-left-themecolor: text1; mso-border-top-alt: solid black .5pt; mso-border-top-themecolor: text1; mso-border-bottom-themecolor: text1; mso-border-right-themecolor: text1&quot; width=379&gt;&#x000D;&#x000A;&lt;P style=&quot;LINE-HEIGHT: normal; MARGIN: 0in 0in 0pt&quot; class=MsoNormal&gt;&lt;SPAN style=&quot;mso-font-kerning: 1.0pt; mso-fareast-font-family: SimSun&quot;&gt;&lt;FONT face=Calibri&gt;p(x) = x^13 + x^4 + x^3 + x + 1&lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;&lt;/TD&gt;&lt;/TR&gt;&#x000D;&#x000A;&lt;TR style=&quot;mso-yfti-irow: 5&quot;&gt;&#x000D;&#x000A;&lt;TD style=&quot;BORDER-BOTTOM: black 1pt solid; BORDER-LEFT: black 1pt solid; PADDING-BOTTOM: 0in; BACKGROUND-COLOR: transparent; PADDING-LEFT: 5.4pt; WIDTH: 2.7in; PADDING-RIGHT: 5.4pt; BORDER-TOP: #ece9d8; BORDER-RIGHT: black 1pt solid; PADDING-TOP: 0in; mso-border-alt: solid black .5pt; mso-border-themecolor: text1; mso-border-top-alt: solid black .5pt; mso-border-top-themecolor: text1&quot; width=259&gt;&#x000D;&#x000A;&lt;P style=&quot;TEXT-ALIGN: center; LINE-HEIGHT: normal; MARGIN: 0in 0in 0pt&quot; class=MsoNormal align=center&gt;&lt;FONT face=Calibri&gt;&lt;SPAN style=&quot;mso-font-kerning: 1.0pt; mso-fareast-font-family: SimSun&quot;&gt;PN14&lt;/SPAN&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/P&gt;&lt;/TD&gt;&#x000D;&#x000A;&lt;TD style=&quot;BORDER-BOTTOM: black 1pt solid; BORDER-LEFT: #ece9d8; PADDING-BOTTOM: 0in; BACKGROUND-COLOR: transparent; PADDING-LEFT: 5.4pt; WIDTH: 3.95in; PADDING-RIGHT: 5.4pt; BORDER-TOP: #ece9d8; BORDER-RIGHT: black 1pt solid; PADDING-TOP: 0in; mso-border-alt: solid black .5pt; mso-border-themecolor: text1; mso-border-left-alt: solid black .5pt; mso-border-left-themecolor: text1; mso-border-top-alt: solid black .5pt; mso-border-top-themecolor: text1; mso-border-bottom-themecolor: text1; mso-border-right-themecolor: text1&quot; width=379&gt;&#x000D;&#x000A;&lt;P style=&quot;LINE-HEIGHT: normal; MARGIN: 0in 0in 0pt&quot; class=MsoNormal&gt;&lt;SPAN style=&quot;mso-font-kerning: 1.0pt; mso-fareast-font-family: SimSun&quot;&gt;&lt;FONT face=Calibri&gt;p(x) = x^14 + x^10 + x^6 + x + 1&lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;&lt;/TD&gt;&lt;/TR&gt;&#x000D;&#x000A;&lt;TR style=&quot;mso-yfti-irow: 6&quot;&gt;&#x000D;&#x000A;&lt;TD style=&quot;BORDER-BOTTOM: black 1pt solid; BORDER-LEFT: black 1pt solid; PADDING-BOTTOM: 0in; BACKGROUND-COLOR: transparent; PADDING-LEFT: 5.4pt; WIDTH: 2.7in; PADDING-RIGHT: 5.4pt; BORDER-TOP: #ece9d8; BORDER-RIGHT: black 1pt solid; PADDING-TOP: 0in; mso-border-alt: solid black .5pt; mso-border-themecolor: text1; mso-border-top-alt: solid black .5pt; mso-border-top-themecolor: text1&quot; width=259&gt;&#x000D;&#x000A;&lt;P style=&quot;TEXT-ALIGN: center; LINE-HEIGHT: normal; MARGIN: 0in 0in 0pt&quot; class=MsoNormal align=center&gt;&lt;FONT face=Calibri&gt;&lt;SPAN style=&quot;mso-font-kerning: 1.0pt; mso-fareast-font-family: SimSun&quot;&gt;PN15&lt;/SPAN&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/P&gt;&lt;/TD&gt;&#x000D;&#x000A;&lt;TD style=&quot;BORDER-BOTTOM: black 1pt solid; BORDER-LEFT: #ece9d8; PADDING-BOTTOM: 0in; BACKGROUND-COLOR: transparent; PADDING-LEFT: 5.4pt; WIDTH: 3.95in; PADDING-RIGHT: 5.4pt; BORDER-TOP: #ece9d8; BORDER-RIGHT: black 1pt solid; PADDING-TOP: 0in; mso-border-alt: solid black .5pt; mso-border-themecolor: text1; mso-border-left-alt: solid black .5pt; mso-border-left-themecolor: text1; mso-border-top-alt: solid black .5pt; mso-border-top-themecolor: text1; mso-border-bottom-themecolor: text1; mso-border-right-themecolor: text1&quot; width=379&gt;&#x000D;&#x000A;&lt;P style=&quot;LINE-HEIGHT: normal; MARGIN: 0in 0in 0pt&quot; class=MsoNormal&gt;&lt;SPAN style=&quot;mso-font-kerning: 1.0pt; mso-fareast-font-family: SimSun&quot;&gt;&lt;FONT face=Calibri&gt;p(x) = x^15 + x + 1&lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;&lt;/TD&gt;&lt;/TR&gt;&#x000D;&#x000A;&lt;TR style=&quot;mso-yfti-irow: 7; mso-yfti-lastrow: yes&quot;&gt;&#x000D;&#x000A;&lt;TD style=&quot;BORDER-BOTTOM: black 1pt solid; BORDER-LEFT: black 1pt solid; PADDING-BOTTOM: 0in; BACKGROUND-COLOR: transparent; PADDING-LEFT: 5.4pt; WIDTH: 2.7in; PADDING-RIGHT: 5.4pt; BORDER-TOP: #ece9d8; BORDER-RIGHT: black 1pt solid; PADDING-TOP: 0in; mso-border-alt: solid black .5pt; mso-border-themecolor: text1; mso-border-top-alt: solid black .5pt; mso-border-top-themecolor: text1&quot; width=259&gt;&#x000D;&#x000A;&lt;P style=&quot;TEXT-ALIGN: center; LINE-HEIGHT: normal; MARGIN: 0in 0in 0pt&quot; class=MsoNormal align=center&gt;&lt;FONT face=Calibri&gt;&lt;SPAN style=&quot;mso-font-kerning: 1.0pt; mso-fareast-font-family: SimSun&quot;&gt;PN16&lt;/SPAN&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/P&gt;&lt;/TD&gt;&#x000D;&#x000A;&lt;TD style=&quot;BORDER-BOTTOM: black 1pt solid; BORDER-LEFT: #ece9d8; PADDING-BOTTOM: 0in; BACKGROUND-COLOR: transparent; PADDING-LEFT: 5.4pt; WIDTH: 3.95in; PADDING-RIGHT: 5.4pt; BORDER-TOP: #ece9d8; BORDER-RIGHT: black 1pt solid; PADDING-TOP: 0in; mso-border-alt: solid black .5pt; mso-border-themecolor: text1; mso-border-left-alt: solid black .5pt; mso-border-left-themecolor: text1; mso-border-top-alt: solid black .5pt; mso-border-top-themecolor: text1; mso-border-bottom-themecolor: text1; mso-border-right-themecolor: text1&quot; width=379&gt;&#x000D;&#x000A;&lt;P&gt;&lt;SPAN style=&quot;FONT-FAMILY: &apos;Calibri&apos;,&apos;sans-serif&apos;; FONT-SIZE: 11pt; mso-bidi-font-family: &apos;Times New Roman&apos;; mso-font-kerning: 1.0pt; mso-fareast-font-family: SimSun; mso-ascii-theme-font: minor-latin; mso-hansi-theme-font: minor-latin; mso-bidi-theme-font: minor-bidi&quot;&gt;p(x) = x^16 + x^12 + x^3 + x + 1&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&lt;/TD&gt;&lt;/TR&gt;&lt;/TBODY&gt;&lt;/TABLE&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; &#x000D;&#x000A;&lt;P&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P&gt;In &quot;Design1 (Schematic)&quot; Equation tab, there is a variable SNR, which can be used to control the power of AWGN. Only positive values are valid for this variable.set.&lt;/P&gt;&#x000D;&#x000A;&lt;P&gt;&amp;nbsp;&lt;/P&gt;&#x000D;&#x000A;&lt;P&gt;d) Rx&lt;/P&gt;&#x000D;&#x000A;&lt;P&gt;It consist of a matched filter, symbol timing synchronization with Gardner algorithm, and QPSK demodulator. It uses a polyphase filter to get 16 samples per symbol and adjust the sampling position according to the detected result of the Gardner detector.&lt;/P&gt;&#x000D;&#x000A;&lt;P&gt;&amp;nbsp;&lt;/P&gt;&#x000D;&#x000A;&lt;P&gt;The Gardner detector&amp;nbsp;result is:&lt;/P&gt;&#x000D;&#x000A;&lt;P&gt;Er = YI(r-1/2) * [YI(r) - YI(r-1)] + YQ(r-1/2) * [YQ(r) -&amp;nbsp;YQ(r-1)]&lt;/P&gt;&#x000D;&#x000A;&lt;P&gt;where YI(r) is the sample in I path and YI(r-1/2) is the sample half symbol behind YI(r); YQ(r) is the sample in&amp;nbsp;Q path and YQ(r-1/2) is the sample half symbol behind YQ(r).&lt;/P&gt;&#x000D;&#x000A;&lt;P&gt;When Er is less than 0,&amp;nbsp;the current sampling position is leading the optimal sampling position; otherwise, when Er is larger than 0, the current sampling position is lagging the optimal sampling position.&lt;/P&gt;&#x000D;&#x000A;&lt;P&gt;&amp;nbsp;&lt;/P&gt;&#x000D;&#x000A;&lt;P&gt;The detected Er value&amp;nbsp;goes through a loop filter and is fed back to the polyphase filter to select the sampling position. In &quot;loop_filter&quot; model, the detected Er values&amp;nbsp;are accumulated. When the accumulated value is larger than the parameter &quot;loop_threshold&quot;&amp;nbsp;(specified in equation tab of &quot;loop_filter&quot; model), the sampling position is adjusted accordingly.&lt;/P&gt;&#x000D;&#x000A;&lt;P&gt;&amp;nbsp;&lt;/P&gt;&#x000D;&#x000A;&lt;P&gt;e) BER&lt;/P&gt;&#x000D;&#x000A;&lt;P&gt;This model is used to compare Tx and Rx bit streams. It outputs &quot;err_num&quot; and &quot;total_num&quot; to represent the numbers of error bits and total bits. Then BER ratio can be calculated. This model can&amp;nbsp;also be implemented in FPGA,&amp;nbsp;and &quot;err_num&quot; and &quot;total_num&quot; are output from FPGA for BER ratio calculation.&lt;/P&gt;&#x000D;&#x000A;&lt;P&gt;&amp;nbsp;&lt;/P&gt;&#x000D;&#x000A;&lt;P&gt;&lt;STRONG&gt;Note&lt;/STRONG&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P&gt;Make sure to remove the sinks in qpsk_demod model before running the HDL Code Generation because the sinks are not supported in&amp;nbsp;HDL code generation. &lt;/P&gt;&#x000D;&#x000A;&lt;P&gt;&lt;/SPAN&gt;&amp;nbsp;&lt;/P&gt;</Text>
