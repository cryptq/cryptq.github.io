<Item XName="Note1" UserName="Note1" Type="Notes">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>&lt;P align=center&gt;&lt;STRONG&gt;&lt;FONT size=4&gt;QPSK Transceiver with symbol timing recovery&lt;/FONT&gt;&lt;/STRONG&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P&gt;&amp;nbsp;&lt;/P&gt;&#x000D;&#x000A;&lt;P&gt;This example workspace demonstrates&amp;nbsp;a QPSK&amp;nbsp;transmitter and&amp;nbsp;receiver system built entirely from parts in the Hardware Design library. This makes it possible to generate HDL code for the entire system, so that it can be implemented on an FPGA.&lt;/P&gt;&#x000D;&#x000A;&lt;P&gt;&amp;nbsp;&lt;/P&gt;&#x000D;&#x000A;&lt;P&gt;This QPSK&amp;nbsp;transmitter/receiver system consists of:&lt;/P&gt;&#x000D;&#x000A;&lt;P&gt;&amp;nbsp;&lt;/P&gt;&#x000D;&#x000A;&lt;P&gt;a)&amp;nbsp; Bit_Source&lt;/P&gt;&#x000D;&#x000A;&lt;P&gt;It can generate&amp;nbsp;pseudo-random bit sequence. The bit sequence is obtained by performing an XOR operation between a PN15_Bits and a PN9_Bits sequences. Both&amp;nbsp;PN15_Bits and PN_9Bits are generated using an LFSR (Linear Feedback Shift Register). Their&amp;nbsp;primitive ploynomials are:&lt;/P&gt;&#x000D;&#x000A;&lt;P&gt;&amp;nbsp;&lt;/P&gt;&#x000D;&#x000A;&lt;P&gt;&lt;SPAN style=&quot;FONT-FAMILY: &#x00E5;&#x00AE;&#x008B;&#x00E4;&#x00BD;&#x0093;; FONT-SIZE: 12pt; mso-bidi-font-family: &apos;Times New Roman&apos;; mso-font-kerning: 1.0pt; mso-ansi-language: EN-US; mso-fareast-language: ZH-CN; mso-bidi-language: AR-SA&quot; lang=EN-US&gt;&lt;FONT face=Arial&gt;&lt;SPAN style=&quot;FONT-FAMILY: &#x00E5;&#x00AE;&#x008B;&#x00E4;&#x00BD;&#x0093;; FONT-SIZE: 12pt; mso-bidi-font-family: &apos;Times New Roman&apos;; mso-font-kerning: 1.0pt; mso-ansi-language: EN-US; mso-fareast-language: ZH-CN; mso-bidi-language: AR-SA&quot; lang=EN-US&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P&gt;&lt;SPAN style=&quot;FONT-FAMILY: &#x00E5;&#x00AE;&#x008B;&#x00E4;&#x00BD;&#x0093;; FONT-SIZE: 12pt; mso-bidi-font-family: &apos;Times New Roman&apos;; mso-font-kerning: 1.0pt; mso-ansi-language: EN-US; mso-fareast-language: ZH-CN; mso-bidi-language: AR-SA&quot; lang=EN-US&gt;&#x000D;&#x000A;&lt;TABLE style=&quot;BORDER-BOTTOM: medium none; BORDER-LEFT: medium none; BORDER-COLLAPSE: collapse; BORDER-TOP: medium none; BORDER-RIGHT: medium none; mso-border-alt: solid black .5pt; mso-border-themecolor: text1; mso-yfti-tbllook: 1184; mso-padding-alt: 0in 5.4pt 0in 5.4pt&quot; class=MsoTableGrid border=1 cellSpacing=0 cellPadding=0&gt;&#x000D;&#x000A;&lt;TBODY&gt;&#x000D;&#x000A;&lt;TR style=&quot;mso-yfti-irow: 0; mso-yfti-firstrow: yes&quot;&gt;&#x000D;&#x000A;&lt;TD style=&quot;BORDER-BOTTOM: black 1pt solid; BORDER-LEFT: black 1pt solid; PADDING-BOTTOM: 0in; BACKGROUND-COLOR: transparent; PADDING-LEFT: 5.4pt; WIDTH: 2.7in; PADDING-RIGHT: 5.4pt; BORDER-TOP: black 1pt solid; BORDER-RIGHT: black 1pt solid; PADDING-TOP: 0in; mso-border-alt: solid black .5pt; mso-border-themecolor: text1&quot; width=259&gt;&#x000D;&#x000A;&lt;P style=&quot;TEXT-ALIGN: center; LINE-HEIGHT: normal; MARGIN: 0in 0in 0pt&quot; class=MsoNormal align=center&gt;&lt;FONT face=Calibri&gt;PN15_Bits&lt;?xml:namespace prefix = o ns = &quot;urn:schemas-microsoft-com:office:office&quot; /&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/P&gt;&lt;/TD&gt;&#x000D;&#x000A;&lt;TD style=&quot;BORDER-BOTTOM: black 1pt solid; BORDER-LEFT: #ece9d8; PADDING-BOTTOM: 0in; BACKGROUND-COLOR: transparent; PADDING-LEFT: 5.4pt; WIDTH: 3.95in; PADDING-RIGHT: 5.4pt; BORDER-TOP: black 1pt solid; BORDER-RIGHT: black 1pt solid; PADDING-TOP: 0in; mso-border-alt: solid black .5pt; mso-border-themecolor: text1; mso-border-left-alt: solid black .5pt; mso-border-left-themecolor: text1&quot; width=379&gt;&#x000D;&#x000A;&lt;P style=&quot;LINE-HEIGHT: normal; MARGIN: 0in 0in 0pt&quot; class=MsoNormal&gt;&lt;FONT face=Calibri&gt;p(x)=x^15 + x + 1&lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/P&gt;&lt;/TD&gt;&lt;/TR&gt;&#x000D;&#x000A;&lt;TR style=&quot;mso-yfti-irow: 1; mso-yfti-lastrow: yes&quot;&gt;&#x000D;&#x000A;&lt;TD style=&quot;BORDER-BOTTOM: black 1pt solid; BORDER-LEFT: black 1pt solid; PADDING-BOTTOM: 0in; BACKGROUND-COLOR: transparent; PADDING-LEFT: 5.4pt; WIDTH: 2.7in; PADDING-RIGHT: 5.4pt; BORDER-TOP: #ece9d8; BORDER-RIGHT: black 1pt solid; PADDING-TOP: 0in; mso-border-alt: solid black .5pt; mso-border-themecolor: text1; mso-border-top-alt: solid black .5pt; mso-border-top-themecolor: text1&quot; width=259&gt;&#x000D;&#x000A;&lt;P style=&quot;TEXT-ALIGN: center; LINE-HEIGHT: normal; MARGIN: 0in 0in 0pt&quot; class=MsoNormal align=center&gt;&lt;FONT face=Calibri&gt;&lt;SPAN style=&quot;mso-font-kerning: 1.0pt; mso-fareast-font-family: SimSun&quot;&gt;PN9_Bits&lt;/SPAN&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/P&gt;&lt;/TD&gt;&#x000D;&#x000A;&lt;TD style=&quot;BORDER-BOTTOM: black 1pt solid; BORDER-LEFT: #ece9d8; PADDING-BOTTOM: 0in; BACKGROUND-COLOR: transparent; PADDING-LEFT: 5.4pt; WIDTH: 3.95in; PADDING-RIGHT: 5.4pt; BORDER-TOP: #ece9d8; BORDER-RIGHT: black 1pt solid; PADDING-TOP: 0in; mso-border-alt: solid black .5pt; mso-border-themecolor: text1; mso-border-left-alt: solid black .5pt; mso-border-left-themecolor: text1; mso-border-top-alt: solid black .5pt; mso-border-top-themecolor: text1; mso-border-bottom-themecolor: text1; mso-border-right-themecolor: text1&quot; width=379&gt;&#x000D;&#x000A;&lt;P style=&quot;LINE-HEIGHT: normal; MARGIN: 0in 0in 0pt&quot; class=MsoNormal&gt;&lt;FONT face=Calibri&gt;p(x)=x^9 + x^4 + 1&lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/P&gt;&lt;/TD&gt;&lt;/TR&gt;&lt;/TBODY&gt;&lt;/TABLE&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P&gt;&lt;SPAN style=&quot;FONT-FAMILY: &#x00E5;&#x00AE;&#x008B;&#x00E4;&#x00BD;&#x0093;; FONT-SIZE: 12pt; mso-bidi-font-family: &apos;Times New Roman&apos;; mso-font-kerning: 1.0pt; mso-ansi-language: EN-US; mso-fareast-language: ZH-CN; mso-bidi-language: AR-SA&quot; lang=EN-US&gt;&lt;/SPAN&gt;&amp;nbsp;&lt;/P&gt;&#x000D;&#x000A;&lt;P&gt;&lt;SPAN style=&quot;FONT-FAMILY: &#x00E5;&#x00AE;&#x008B;&#x00E4;&#x00BD;&#x0093;; FONT-SIZE: 12pt; mso-bidi-font-family: &apos;Times New Roman&apos;; mso-font-kerning: 1.0pt; mso-ansi-language: EN-US; mso-fareast-language: ZH-CN; mso-bidi-language: AR-SA&quot; lang=EN-US&gt;&lt;FONT face=Arial&gt;b) Tx&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P&gt;&lt;SPAN style=&quot;FONT-FAMILY: &#x00E5;&#x00AE;&#x008B;&#x00E4;&#x00BD;&#x0093;; FONT-SIZE: 12pt; mso-bidi-font-family: &apos;Times New Roman&apos;; mso-font-kerning: 1.0pt; mso-ansi-language: EN-US; mso-fareast-language: ZH-CN; mso-bidi-language: AR-SA&quot; lang=EN-US&gt;&lt;FONT face=Arial&gt;It is a QPSK modulator. After QPSK mapping, the signal&amp;nbsp;is upsampled by 4&amp;nbsp;and goes through a square root raise cosine &lt;/FONT&gt;&lt;/SPAN&gt;&lt;SPAN style=&quot;FONT-FAMILY: &#x00E5;&#x00AE;&#x008B;&#x00E4;&#x00BD;&#x0093;; FONT-SIZE: 12pt; mso-bidi-font-family: &apos;Times New Roman&apos;; mso-font-kerning: 1.0pt; mso-ansi-language: EN-US; mso-fareast-language: ZH-CN; mso-bidi-language: AR-SA&quot; lang=EN-US&gt;&lt;FONT face=Arial&gt;filter with a roll-off factor 0.5.&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P&gt;&lt;SPAN style=&quot;FONT-FAMILY: &#x00E5;&#x00AE;&#x008B;&#x00E4;&#x00BD;&#x0093;; FONT-SIZE: 12pt; mso-bidi-font-family: &apos;Times New Roman&apos;; mso-font-kerning: 1.0pt; mso-ansi-language: EN-US; mso-fareast-language: ZH-CN; mso-bidi-language: AR-SA&quot; lang=EN-US&gt;&lt;/SPAN&gt;&amp;nbsp;&lt;/P&gt;&#x000D;&#x000A;&lt;P&gt;&lt;SPAN style=&quot;FONT-FAMILY: &#x00E5;&#x00AE;&#x008B;&#x00E4;&#x00BD;&#x0093;; FONT-SIZE: 12pt; mso-bidi-font-family: &apos;Times New Roman&apos;; mso-font-kerning: 1.0pt; mso-ansi-language: EN-US; mso-fareast-language: ZH-CN; mso-bidi-language: AR-SA&quot; lang=EN-US&gt;&lt;FONT face=Arial&gt;c) PN_AWGN&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P&gt;&lt;SPAN style=&quot;FONT-FAMILY: &#x00E5;&#x00AE;&#x008B;&#x00E4;&#x00BD;&#x0093;; FONT-SIZE: 12pt; mso-bidi-font-family: &apos;Times New Roman&apos;; mso-font-kerning: 1.0pt; mso-ansi-language: EN-US; mso-fareast-language: ZH-CN; mso-bidi-language: AR-SA&quot; lang=EN-US&gt;&lt;/SPAN&gt;&lt;SPAN style=&quot;FONT-FAMILY: &#x00E5;&#x00AE;&#x008B;&#x00E4;&#x00BD;&#x0093;; FONT-SIZE: 12pt; mso-bidi-font-family: &apos;Times New Roman&apos;; mso-font-kerning: 1.0pt; mso-ansi-language: EN-US; mso-fareast-language: ZH-CN; mso-bidi-language: AR-SA&quot; lang=EN-US&gt;&lt;FONT face=Arial&gt;It is an approximation of an&amp;nbsp;AWGN noise generator. According to the law of large number, eight pseudo-random integer generators &lt;/FONT&gt;&lt;/SPAN&gt;&lt;SPAN style=&quot;FONT-FAMILY: &#x00E5;&#x00AE;&#x008B;&#x00E4;&#x00BD;&#x0093;; FONT-SIZE: 12pt; mso-bidi-font-family: &apos;Times New Roman&apos;; mso-font-kerning: 1.0pt; mso-ansi-language: EN-US; mso-fareast-language: ZH-CN; mso-bidi-language: AR-SA&quot; lang=EN-US&gt;&lt;FONT face=Arial&gt;are added together to approximate AWGN noise.&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P&gt;&lt;SPAN style=&quot;FONT-FAMILY: &#x00E5;&#x00AE;&#x008B;&#x00E4;&#x00BD;&#x0093;; FONT-SIZE: 12pt; mso-bidi-font-family: &apos;Times New Roman&apos;; mso-font-kerning: 1.0pt; mso-ansi-language: EN-US; mso-fareast-language: ZH-CN; mso-bidi-language: AR-SA&quot; lang=EN-US&gt;&lt;FONT face=Arial&gt;The eight pseudo-random integer generators are all implemented using LFSRs (a&amp;nbsp;SerToPara part is used to convert 8 bits to an integer).&amp;nbsp;The &lt;/FONT&gt;&lt;/SPAN&gt;&lt;SPAN style=&quot;FONT-FAMILY: &#x00E5;&#x00AE;&#x008B;&#x00E4;&#x00BD;&#x0093;; FONT-SIZE: 12pt; mso-bidi-font-family: &apos;Times New Roman&apos;; mso-font-kerning: 1.0pt; mso-ansi-language: EN-US; mso-fareast-language: ZH-CN; mso-bidi-language: AR-SA&quot; lang=EN-US&gt;&lt;FONT face=Arial&gt;primitive polynomials for the LFSRs are:&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P&gt;&lt;SPAN style=&quot;FONT-FAMILY: &#x00E5;&#x00AE;&#x008B;&#x00E4;&#x00BD;&#x0093;; FONT-SIZE: 12pt; mso-bidi-font-family: &apos;Times New Roman&apos;; mso-font-kerning: 1.0pt; mso-ansi-language: EN-US; mso-fareast-language: ZH-CN; mso-bidi-language: AR-SA&quot; lang=EN-US&gt;&lt;/SPAN&gt;&lt;SPAN style=&quot;FONT-FAMILY: &#x00E5;&#x00AE;&#x008B;&#x00E4;&#x00BD;&#x0093;; FONT-SIZE: 12pt; mso-bidi-font-family: &apos;Times New Roman&apos;; mso-font-kerning: 1.0pt; mso-ansi-language: EN-US; mso-fareast-language: ZH-CN; mso-bidi-language: AR-SA&quot; lang=EN-US&gt;&lt;FONT face=Arial&gt;&lt;SPAN style=&quot;LINE-HEIGHT: 150%; FONT-FAMILY: &#x00E5;&#x00AE;&#x008B;&#x00E4;&#x00BD;&#x0093;; mso-bidi-font-size: 10.5pt&quot; lang=EN-US&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&#x000D;&#x000A;&lt;P&gt;&lt;SPAN style=&quot;FONT-FAMILY: &#x00E5;&#x00AE;&#x008B;&#x00E4;&#x00BD;&#x0093;; FONT-SIZE: 12pt; mso-bidi-font-family: &apos;Times New Roman&apos;; mso-font-kerning: 1.0pt; mso-ansi-language: EN-US; mso-fareast-language: ZH-CN; mso-bidi-language: AR-SA&quot; lang=EN-US&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;TABLE style=&quot;BORDER-BOTTOM: medium none; BORDER-LEFT: medium none; BORDER-COLLAPSE: collapse; BORDER-TOP: medium none; BORDER-RIGHT: medium none; mso-border-alt: solid black .5pt; mso-border-themecolor: text1; mso-yfti-tbllook: 1184; mso-padding-alt: 0in 5.4pt 0in 5.4pt&quot; class=MsoTableGrid border=1 cellSpacing=0 cellPadding=0&gt;&#x000D;&#x000A;&lt;TBODY&gt;&#x000D;&#x000A;&lt;TR style=&quot;mso-yfti-irow: 0; mso-yfti-firstrow: yes&quot;&gt;&#x000D;&#x000A;&lt;TD style=&quot;BORDER-BOTTOM: black 1pt solid; BORDER-LEFT: black 1pt solid; PADDING-BOTTOM: 0in; BACKGROUND-COLOR: transparent; PADDING-LEFT: 5.4pt; WIDTH: 2.7in; PADDING-RIGHT: 5.4pt; BORDER-TOP: black 1pt solid; BORDER-RIGHT: black 1pt solid; PADDING-TOP: 0in; mso-border-alt: solid black .5pt; mso-border-themecolor: text1&quot; width=259&gt;&#x000D;&#x000A;&lt;P style=&quot;TEXT-ALIGN: center; LINE-HEIGHT: normal; MARGIN: 0in 0in 0pt&quot; class=MsoNormal align=center&gt;&lt;FONT face=Calibri&gt;&lt;SPAN style=&quot;mso-font-kerning: 1.0pt; mso-fareast-font-family: SimSun&quot;&gt;PN9&lt;/SPAN&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/P&gt;&lt;/TD&gt;&#x000D;&#x000A;&lt;TD style=&quot;BORDER-BOTTOM: black 1pt solid; BORDER-LEFT: #ece9d8; PADDING-BOTTOM: 0in; BACKGROUND-COLOR: transparent; PADDING-LEFT: 5.4pt; WIDTH: 3.95in; PADDING-RIGHT: 5.4pt; BORDER-TOP: black 1pt solid; BORDER-RIGHT: black 1pt solid; PADDING-TOP: 0in; mso-border-alt: solid black .5pt; mso-border-themecolor: text1; mso-border-left-alt: solid black .5pt; mso-border-left-themecolor: text1&quot; width=379&gt;&#x000D;&#x000A;&lt;P style=&quot;LINE-HEIGHT: normal; MARGIN: 0in 0in 0pt&quot; class=MsoNormal&gt;&lt;SPAN style=&quot;mso-font-kerning: 1.0pt; mso-fareast-font-family: SimSun&quot;&gt;&lt;FONT face=Calibri&gt;p(x) = x^9 + x^4 + 1&lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;&lt;/TD&gt;&lt;/TR&gt;&#x000D;&#x000A;&lt;TR style=&quot;mso-yfti-irow: 1&quot;&gt;&#x000D;&#x000A;&lt;TD style=&quot;BORDER-BOTTOM: black 1pt solid; BORDER-LEFT: black 1pt solid; PADDING-BOTTOM: 0in; BACKGROUND-COLOR: transparent; PADDING-LEFT: 5.4pt; WIDTH: 2.7in; PADDING-RIGHT: 5.4pt; BORDER-TOP: #ece9d8; BORDER-RIGHT: black 1pt solid; PADDING-TOP: 0in; mso-border-alt: solid black .5pt; mso-border-themecolor: text1; mso-border-top-alt: solid black .5pt; mso-border-top-themecolor: text1&quot; width=259&gt;&#x000D;&#x000A;&lt;P style=&quot;TEXT-ALIGN: center; LINE-HEIGHT: normal; MARGIN: 0in 0in 0pt&quot; class=MsoNormal align=center&gt;&lt;FONT face=Calibri&gt;&lt;SPAN style=&quot;mso-font-kerning: 1.0pt; mso-fareast-font-family: SimSun&quot;&gt;PN10&lt;/SPAN&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/P&gt;&lt;/TD&gt;&#x000D;&#x000A;&lt;TD style=&quot;BORDER-BOTTOM: black 1pt solid; BORDER-LEFT: #ece9d8; PADDING-BOTTOM: 0in; BACKGROUND-COLOR: transparent; PADDING-LEFT: 5.4pt; WIDTH: 3.95in; PADDING-RIGHT: 5.4pt; BORDER-TOP: #ece9d8; BORDER-RIGHT: black 1pt solid; PADDING-TOP: 0in; mso-border-alt: solid black .5pt; mso-border-themecolor: tex