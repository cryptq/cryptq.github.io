<Text>&lt;P&gt;&lt;STRONG&gt;Header File Contents&lt;/STRONG&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P&gt;&amp;nbsp;&lt;/P&gt;&#x000D;&#x000A;&lt;P&gt;&lt;FONT face=&quot;Courier New&quot;&gt;#pragma once&lt;BR&gt;#include &quot;SystemVue/ModelBuilder.h&quot;&lt;/FONT&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P&gt;&lt;FONT face=&quot;Courier New&quot;&gt;class GAD_timing : public SystemVueModelBuilder::DFModel&lt;BR&gt;{&lt;BR&gt;public:&lt;BR&gt;&amp;nbsp;// This Macro is required for all classes derived from DFModel&lt;BR&gt;&amp;nbsp;DECLARE_MODEL_INTERFACE( GAD_timing );&lt;/FONT&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P&gt;&lt;FONT face=&quot;Courier New&quot;&gt;&lt;/FONT&gt;&amp;nbsp;&lt;/P&gt;&#x000D;&#x000A;&lt;P&gt;&lt;FONT face=&quot;Courier New&quot;&gt;&amp;nbsp;// Constructor to initialize parameters&lt;BR&gt;&amp;nbsp;GAD_timing();&lt;BR&gt;&amp;nbsp;&lt;BR&gt;&amp;nbsp;//-------- Function Overloads --------&lt;BR&gt;&amp;nbsp;virtual bool Run();&lt;BR&gt;&amp;nbsp;virtual bool Initialize();&lt;/FONT&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P&gt;&lt;FONT face=&quot;Courier New&quot;&gt;&lt;/FONT&gt;&amp;nbsp;&lt;/P&gt;&#x000D;&#x000A;&lt;P&gt;&lt;FONT face=&quot;Courier New&quot;&gt;&amp;nbsp;// Ports&lt;BR&gt;&amp;nbsp;SystemVueModelBuilder::CircularBuffer&amp;lt; double &amp;gt; input, output;&lt;BR&gt;&amp;nbsp;&lt;BR&gt;&amp;nbsp;// persistent y;&lt;BR&gt;&amp;nbsp;double y[3];&lt;BR&gt;};&lt;/FONT&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P&gt;&amp;nbsp;&lt;/P&gt;&#x000D;&#x000A;&lt;P&gt;&amp;nbsp;&lt;/P&gt;&#x000D;&#x000A;&lt;P&gt;&lt;STRONG&gt;Source File Contents&lt;/STRONG&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P&gt;&amp;nbsp;&lt;/P&gt;&#x000D;&#x000A;&lt;P&gt;&lt;FONT face=&quot;Courier New&quot;&gt;#include &quot;GAD_timing.h&quot;&lt;/FONT&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P&gt;&lt;FONT face=&quot;Courier New&quot;&gt;&lt;/FONT&gt;&amp;nbsp;&lt;/P&gt;&#x000D;&#x000A;&lt;P&gt;&lt;FONT face=&quot;Courier New&quot;&gt;#ifndef SV_CODE_GEN&lt;BR&gt;DEFINE_MODEL_INTERFACE ( GAD_timing )&lt;BR&gt;{&amp;nbsp;&lt;BR&gt;&amp;nbsp;ADD_MODEL_INPUT( input );&lt;BR&gt;&amp;nbsp;ADD_MODEL_OUTPUT( output );&lt;BR&gt;&amp;nbsp;return true;&lt;BR&gt;}&lt;BR&gt;#endif&lt;/FONT&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P&gt;&lt;FONT face=&quot;Courier New&quot;&gt;&lt;/FONT&gt;&amp;nbsp;&lt;/P&gt;&#x000D;&#x000A;&lt;P&gt;&lt;FONT face=&quot;Courier New&quot;&gt;GAD_timing::GAD_timing()&lt;BR&gt;{&lt;BR&gt;}&lt;/FONT&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P&gt;&lt;FONT face=&quot;Courier New&quot;&gt;&lt;/FONT&gt;&amp;nbsp;&lt;/P&gt;&#x000D;&#x000A;&lt;P&gt;&lt;FONT face=&quot;Courier New&quot;&gt;bool GAD_timing::Initialize()&lt;BR&gt;{&lt;BR&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; for (int i = 0; i &amp;lt; 3; ++i)&lt;BR&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; y[i] = 0;&lt;/FONT&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P&gt;&lt;FONT face=&quot;Courier New&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; return true;&lt;BR&gt;}&lt;/FONT&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P&gt;&lt;FONT face=&quot;Courier New&quot;&gt;&lt;/FONT&gt;&amp;nbsp;&lt;/P&gt;&#x000D;&#x000A;&lt;P&gt;&lt;FONT face=&quot;Courier New&quot;&gt;//-----------------------------------------------------------------------------------&lt;BR&gt;//&amp;nbsp;Run&lt;BR&gt;//&amp;nbsp;&amp;nbsp;Here we do the math&lt;BR&gt;//-----------------------------------------------------------------------------------&lt;BR&gt;bool GAD_timing::Run()&lt;BR&gt;{&lt;BR&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; y[2] = y[1];&lt;BR&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; y[1] = y[0];&lt;BR&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; y[0] = input[0];&lt;/FONT&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P&gt;&lt;FONT face=&quot;Courier New&quot;&gt;&amp;nbsp;&amp;nbsp; &amp;nbsp;output[0] = y[2 - 1] * (y[1 - 1] - y[3 - 1]);&lt;BR&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; return true;&lt;BR&gt;}&lt;/FONT&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P&gt;&lt;FONT face=&quot;Courier New&quot;&gt;&lt;/FONT&gt;&amp;nbsp;&lt;/P&gt;</Text>
