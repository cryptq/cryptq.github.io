<Text>using(&apos;DF1_Data&apos;)&#x000D;&#x000A;[y,x]=size(FFT)&#x000D;&#x000A;f1=graph_figure(&apos;Bluetooth Frequency Hopping&apos;);&#x000D;&#x000A;[xx,yy] = meshgrid(linspace(2,202,x),linspace(.625,.625*y,y));&#x000D;&#x000A;f1.add_mesh_data(xx,yy,10*log(abs(FFT)),&apos;Spectrum&apos;);&#x000D;&#x000A;f1.set_title (&apos;Bluetooth Frequency Hopping&apos;);&#x000D;&#x000A;%f1.set_label_x(&apos;MHz&apos;);&#x000D;&#x000A;%f1.set_label_y (&apos;ms&apos;);</Text>
