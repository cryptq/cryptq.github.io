<Item XName="Plot Sphere" UserName="Plot Sphere" Type="Equation">
<AutoCalc><T>Bool</T><D>0</D></AutoCalc>
<Selected><T>Bool</T><D>0</D></Selected>
<Text>f3=graph_figure(&apos;Sphere&apos;);&#x000D;&#x000A;p=100;&#x000D;&#x000A;t = 0:1/(p-1):1;&#x000D;&#x000A;[th,ph] = meshgrid( t*pi,t*2*pi );&#x000D;&#x000A;x = cos(th);&#x000D;&#x000A;y = sin(th).*cos(ph);&#x000D;&#x000A;z = sin(th).*sin(ph);&#x000D;&#x000A;f3.add_mesh_data(x,y,z);</Text>
