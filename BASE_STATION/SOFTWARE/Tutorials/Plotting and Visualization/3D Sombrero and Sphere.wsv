<Item XName="Page" Type="PageMgr" />
<Item XName="Plot Sombrero" UserName="Plot Sombrero" Type="Equation">
<AutoCalc><T>Bool</T><D>0</D></AutoCalc>
<Selected><T>Bool</T><D>0</D></Selected>
<Text>[X,Y] = meshgrid(-8:.1:8);&#x000D;&#x000A;R = sqrt(X.^2 + Y.^2) + eps;&#x000D;&#x000A;Z = sin(R)./R;&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;f2 = graph_figure(&apos;Sombrero&apos;);&#x000D;&#x000A;f2.add_mesh_data(X,Y,Z);&#x000D;&#x000A;</Text>
