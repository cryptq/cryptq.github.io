<Description>idle interval between two frame packet</Description>
<Unit><T>Int</T><D>7004</D></Unit>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="MCS" Type="PartParam">
<DataEntry>[MCSValue]</DataEntry>
<Description>modulation coding scheme for all data stream, in range [0:9]</Description>
<Enum />
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="N_SS" Type="PartParam">
<DataEntry>[2]</DataEntry>
<Description>number of spatial streams for all user, range[1:8] for single active user and [1:4] for multi-active users</Description>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="NumMPDUPerUser" Type="PartParam">
<DataEntry>[1]</DataEntry>
<Description>number of MPDU for all user, range[0:8]</Description>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="NumTx" Type="PartParam">
<DataEntry>2</DataEntry>
<Description>number of transmit antennas</Description>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="NumUsers" Type="PartParam">
<DataEntry>1</DataEntry>
<Description>number of users</Description>
<Validate><T>Int</T><D>11</D></Validate></Item>
<Item XName="OversampleRatio" Type="PartParam">
<DataEntry>1</DataEntry>
<Description>oversample ratio, could be 1x, 2x, 4x and 8x</Description>
<Enum>WLAN_11ac_Source_OversampleRatio@WLAN 11ac Enums</Enum>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="ReInitialize" Type="PartParam">
<DataEntry>1</DataEntry>
<Description>whether reset the initial state of the scrambler each burst by or not</Description>
<Enum>WLAN_11ac_Source_ReInitialize@WLAN 11ac Enums</Enum>
<HideCondition>1</HideCondition>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="STBC" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>whether STBC is used or not</Description>
<Enum>WLAN_11ac_Source_STBC@WLAN 11ac Enums</Enum>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="ScrambleSeed" Type="PartParam">
<DataEntry>[1, 0, 1, 1, 1, 0, 1]</DataEntry>
<Description>initial state of scrambler(should not be all 0)</Description>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="ShortGI" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>whether short guard interval is used or not</Description>
<Enum>WLAN_11ac_Source_ShortGI@WLAN 11ac Enums</Enum>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="SpatialMappingMatrix" Type="PartParam">
<DataEntry>[1]</DataEntry>
<Description>user definned spatial mapping matrix</Description>
<Enum />
<HideCondition>SpatialMappingScheme &lt; 2</HideCondition>
<Validate><T>Int</T><D>15</D></Validate></Item>
<Item XName="SpatialMappingScheme" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>spatial mapping scheme</Description>
<Enum>WLAN_11ac_Source_SpatialMappingScheme@WLAN 11ac Enums</Enum>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="TransmissionMode" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>1: MU  0:SU</Description>
<Enum>WLAN_11ac_Source_TransmissionMode@WLAN 11ac Enums</Enum>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="User0_MPDUDataLength" Type="PartParam">
<DataEntry>[1024]</DataEntry>
<Description>data length of each MPDU for user0, range[0:11426]</Description>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="User0_MPDUMACHeader" Type="PartParam">
<DataEntry>[0,0,0,0,0,0,0,0]</DataEntry>
<Description>MAC Header type of each MPDU for user0, each element: 0 for General, 1 for RTS, 2 for CTS</Description>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="User1_MPDUDataLength" Type="PartParam">
<DataEntry>[1024,1024,1024,1024,1024,1024,1024,1024]</DataEntry>
<Description>data length of each MPDU for User1, range[0:11426]</Description>
<HideCondition>NumUsers &lt; 2</HideCondition>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="User1_MPDUMACHeader" Type="PartParam">
<DataEntry>[0,0,0,0,0,0,0,0]</DataEntry>
<Description>MAC Header type of each MPDU for User1, each element: 0 for General, 1 for RTS, 2 for CTS</Description>
<HideCondition>NumUsers &lt; 2</HideCondition>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="User2_MPDUDataLength" Type="PartParam">
<DataEntry>[1024,1024,1024,1024,1024,1024,1024,1024]</DataEntry>
<Description>data length of each MPDU for User2, range[0:11426]</Description>
<HideCondition>NumUsers &lt; 3</HideCondition>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="User2_MPDUMACHeader" Type="PartParam">
<DataEntry>[0,0,0,0,0,0,0,0]</DataEntry>
<Description>MAC Header type of each MPDU for User2, each element: 0 for General, 1 for RTS, 2 for CTS</Description>
<HideCondition>NumUsers &lt; 3</HideCondition>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="User3_MPDUDataLength" Type="PartParam">
<DataEntry>[1024,1024,1024,1024,1024,1024,1024,1024]</DataEntry>
<Description>data length of each MPDU for User3, range[0:11426]</Description>
<HideCondition>NumUsers &lt; 4</HideCondition>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="User3_MPDUMACHeader" Type="PartParam">
<DataEntry>[0,0,0,0,0,0,0,0]</DataEntry>
<Description>MAC Header type of each MPDU for User3, each element: 0 for General, 1 for RTS, 2 for CTS</Description>
<HideCondition>NumUsers &lt; 4</HideCondition>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="WindowingLength" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>time windowing length</Description>
<Enum />
<Validate><T>Int</T><D>14</D></Validate></Item></Item></Item>
