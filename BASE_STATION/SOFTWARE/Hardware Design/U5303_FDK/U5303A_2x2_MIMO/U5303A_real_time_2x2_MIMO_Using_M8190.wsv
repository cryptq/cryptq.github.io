<Item XName="Equations" Type="Equation">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>if(FPGASimMap(1)==1)&#x000D;&#x000A;&#x0009;FPGA0_OutPortNum = length(FPGA0_OutPortWL);&#x000D;&#x000A;&#x0009;if(RegMap(1)==1)&#x000D;&#x000A;&#x0009;&#x0009;FPGA0_RegNum = length(FPGA0_RegWL);&#x000D;&#x000A;&#x0009;else&#x000D;&#x000A;&#x0009;&#x0009;FPGA0_RegNum = 1;&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x0009;if(BlockRegMap(1)==1)&#x000D;&#x000A;&#x0009;&#x0009;FPGA0_BlockRegNum = length(FPGA0_BlockRegWL);&#x000D;&#x000A;&#x0009;else&#x000D;&#x000A;&#x0009;&#x0009;FPGA0_BlockRegNum = 1;&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;FPGA0_OutPortNum = 1;&#x000D;&#x000A;&#x0009;FPGA0_RegNum = 1;&#x000D;&#x000A;&#x0009;FPGA0_BlockRegNum = 1;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;FPGACLKFreq = (1-ClockMode)*(INTCLKSampleRate*1.6e9+(1-INTCLKSampleRate)*1.0e9)/8 + ClockMode*EXTCLKSampleRate*1.0e9/8/(1+(ADCWorkMode~=0));&#x000D;&#x000A;EnableTrigger = (TriggerType ~= 0);&#x000D;&#x000A;&#x000D;&#x000A;% Trigger signals FXP format parameters&#x000D;&#x000A;TriggerFlagWL = 1;&#x000D;&#x000A;TriggerFlagIWL = 1;&#x000D;&#x000A;TriggerFlagSign = 0;&#x000D;&#x000A;&#x000D;&#x000A;TriggerIntegerPosWL = 7;&#x000D;&#x000A;TriggerIntegerPosIWL = 7;&#x000D;&#x000A;TriggerIntegerPosSign = 0;&#x000D;&#x000A;&#x000D;&#x000A;TriggerFractionPosWL = 32;&#x000D;&#x000A;TriggerFractionPosIWL = 0;&#x000D;&#x000A;TriggerFractionPosSign = 0;</Text>
<UnitUse><T>Int</T><D>2</D></UnitUse>
