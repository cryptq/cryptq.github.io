<Item XName="Equations" Type="Equation">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>&#x000D;&#x000A;ModulationMode = tune(1); % 0: QPSK;  1: 16QAM;  2: 64QAM&#x000D;&#x000A;SimMode = tune(0); % 0: Download waveform to M8190;  1: Real-time demod with M9703A&#x000D;&#x000A;&#x000D;&#x000A;if(ModulationMode==0)&#x000D;&#x000A;&#x0009;EVM_ModMode = 1;&#x000D;&#x000A;elseif(ModulationMode == 1)&#x000D;&#x000A;&#x0009;EVM_ModMode = 4;&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;EVM_ModMode = 6;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if(ModulationMode == 0)&#x000D;&#x000A;&#x0009;MCSValue = 1;&#x000D;&#x000A;elseif(ModulationMode == 1)&#x000D;&#x000A;&#x0009;MCSValue = 3;&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;MCSValue = 7;&#x000D;&#x000A;end&#x000D;&#x000A;PlotFrameNum = 100;&#x000D;&#x000A;&#x000D;&#x000A;WorkMode = 1;&#x0009;% 0: Adjust Power;  1: constellation demod&#x000D;&#x000A;InGain = 1/2;&#x000D;&#x000A;DisplayGain = 1/2^15;&#x000D;&#x000A;Wave_SampleRate = 200e6;&#x000D;&#x000A;Fc = 100e6;&#x000D;&#x000A;UpSampleRate = 8;&#x000D;&#x000A;&#x000D;&#x000A;DDCFreq = zeros(1,2);&#x000D;&#x000A;DDCFreq(1) = 0;&#x000D;&#x000A;DDCFreq(2) = 1/4;&#x000D;&#x000A;AFCSwitch = 3;&#x000D;&#x000A;&#x000D;&#x000A;SyncPowerThres = 10;&#x000D;&#x000A;SyncRatioThres = 0.7;&#x000D;&#x000A;OFDMProtectSamp = 64;&#x000D;&#x000A;SyncSearchRange = 1024;&#x000D;&#x000A;&#x000D;&#x000A;if(WorkMode == 0)&#x000D;&#x000A;&#x0009;SampleNumPerCap = 100000;&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;SampleNumPerCap = 800;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;FFTSCHVec = [1 0 1 1 2];&#x000D;&#x000A;% FFT configure word setting&#x000D;&#x000A;% LSB 8 bits : lower 5 bits are FFT size, 3 bits padding 0&#x000D;&#x000A;FFTConfigWord = 0;&#x000D;&#x000A;% Forward FFT: 1&#x000D;&#x000A;FFTConfigWord = FFTConfigWord + 1;&#x000D;&#x000A;% FFT scheduling &#x000D;&#x000A;% [01 00 10 00 10 10 11]&#x000D;&#x000A;% [1 0 2 0 2 2 3]&#x000D;&#x000A;&#x000D;&#x000A;SCHValue = 0;&#x000D;&#x000A;for ii= 1:length(FFTSCHVec)&#x000D;&#x000A;&#x0009;SCHValue = SCHValue + FFTSCHVec(ii)*4^(length(FFTSCHVec)-ii);&#x000D;&#x000A;end&#x000D;&#x000A;FFTConfigWord = FFTConfigWord + SCHValue*2^1;</Text>
