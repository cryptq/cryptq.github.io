s;SCPICommands;AutoScale;InstructionTimeout;RefClockSrc;RefClockFreq;ConfigMIMO;MasterSrc</D></ParamOrder>
<Item XName="AmplitudeOutputAC_dBm" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>amplitude in dBm (range. -5dBm to +5dBm)</Description>
<HideCondition>(OutputAmplifier ~=1)</HideCondition>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="AmplitudeOutputDAC" Type="PartParam">
<DataEntry>900</DataEntry>
<Description>amplitude in V (range: 50mV - 500mV)</Description>
<HideCondition>(OutputAmplifier ~= 2)</HideCondition>
<Unit><T>Int</T><D>9003</D></Unit>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="AmplitudeOutputDC" Type="PartParam">
<DataEntry>0.5</DataEntry>
<Description>amplitude in V (range: 0.05V - 2V)</Description>
<HideCondition>(OutputAmplifier ~= 0)</HideCondition>
<Unit><T>Int</T><D>9001</D></Unit>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="ArbOn" Type="PartParam">
<DataEntry>1</DataEntry>
<Description>Turn outputs ON of OFF</Description>
<Enum>NO_YES@Eagleware</Enum>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="AutoScale" Type="PartParam">
<DataEntry>1</DataEntry>
<Description>Normalize waveform into [-1, 1] Volt range before downloading.  YES: auto scale;  NO: no auto scale.</Description>
<Enum>NO_YES@Eagleware</Enum>
<HideCondition>(ShowAdvancedParams == 0)</HideCondition>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="ConfigMIMO" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>Establish the Master-Slave relationship among multiple 81180; 1:YES, 0:NO</Description>
<Enum>NO_YES@Eagleware</Enum>
<HideCondition>(ShowAdvancedParams == 0)</HideCondition>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="EventMarkers" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>Enable event markers outputs of specified channel(s)</Description>
<Enum>ESGEventMarker@Eagleware</Enum>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="FileName" Type="PartParam">
<DataEntry>myWaveform.bin</DataEntry>
<Description>File name for the downloaded waveform</Description>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>4</D></Validate></Item>
<Item XName="HWAvailable" Type="PartParam">
<DataEntry>1</DataEntry>
<Description>YES: HW available. NO: HW not exist</Description>
<Enum>NO_YES@Eagleware</Enum>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="IOType" Type="PartParam">
<DataEntry>LAN</DataEntry>
<Description>Instrument Communication type: &apos;LAN&apos;, &apos;TCPIP&apos;, or &apos;GPIB&apos;</Description>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>4</D></Validate></Item>
<Item XName="InstructionTimeout" Type="PartParam">
<DataEntry>10</DataEntry>
<Description>Instrument instruction timeout limit</Description>
<HideCondition>(ShowAdvancedParams == 0)</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Unit><T>Int</T><D>7004</D></Unit>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="MarkerLength" Type="PartParam">
<DataEntry>20</DataEntry>
<Description>Duration of event marker pulse measured in number of samples.</Description>
<Enum />
<HideCondition>EventMarkers==0</HideCondition>
<Validate><T>Int</T><D>3</D></Validate></Item>
<Item XName="MarkerStart" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>Sample index to start event marker pulse. (Note: sample index starts at 0).</Description>
<Enum />
<HideCondition>EventMarkers==0</HideCondition>
<Validate><T>Int</T><D>11</D></Validate></Item>
<Item XName="MasterSrc" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>Mark this 81180 as the master that will generate the synchronization trigger ; 1:YES, 0:NO</Description>
<Enum>NO_YES@Eagleware</Enum>
<HideCondition>(ShowAdvancedParams == 0 || ConfigMIMO == 0)</HideCondition>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="OutputAmplifier" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>Select Output Amplifier</Description>
<Enum>Output_Amplifier_81180@Eagleware</Enum>
<Unit><T>Int</T><D>0</D></Unit>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="PrimAddress" Type="PartParam">
<DataEntry>=M8190IPAddress</DataEntry>
<Description>Primary address: IP address (LAN) or instrument GPIB address (GPIB)</Description>
<Validate><T>Int</T><D>4</D></Validate></Item>
