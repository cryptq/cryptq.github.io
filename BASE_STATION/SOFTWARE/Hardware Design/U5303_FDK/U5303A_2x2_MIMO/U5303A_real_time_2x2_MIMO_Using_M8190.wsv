<Text>clear all;&#x000D;&#x000A;&#x000D;&#x000A;Cons_0_I = getvariable(&apos;Design2 Analysis_Design2_Data&apos;, &apos;Data0_I&apos;);&#x000D;&#x000A;Cons_0_Q = getvariable(&apos;Design2 Analysis_Design2_Data&apos;, &apos;Data0_Q&apos;);&#x000D;&#x000A;&#x000D;&#x000A;Cons_1_I = getvariable(&apos;Design2 Analysis_Design2_Data&apos;, &apos;Data1_I&apos;);&#x000D;&#x000A;Cons_1_Q = getvariable(&apos;Design2 Analysis_Design2_Data&apos;, &apos;Data1_Q&apos;);&#x000D;&#x000A;&#x000D;&#x000A;Cons_0_I_Valid = getvariable(&apos;Design2 Analysis_Design2_Data&apos;, &apos;VOut&apos;);&#x000D;&#x000A;&#x000D;&#x000A;Cons_0_V = Cons_0_I(find(Cons_0_I_Valid)) + 1j * Cons_0_Q(find(Cons_0_I_Valid));&#x000D;&#x000A;Cons_1_V = Cons_1_I(find(Cons_0_I_Valid)) + 1j * Cons_1_Q(find(Cons_0_I_Valid));</Text>
