<DataEntry>Diagram of M9703 FPGA0 and FPGA1 Design</DataEntry>
<TextParam><T>Bool</T><D>1</D></TextParam></Item></Item>
<Item XName="Annotate21" Type="TextA">
<BorderColor><T>Int</T><D>-16777215</D></BorderColor>
