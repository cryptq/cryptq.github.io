<Data><T>Array_Dbl64</T><D>2;8;1;;QcPcPcPc9}3;QcPcPcPcP}3;qCpCpCpCZ}3;QcPcPcPcf}3;;WcPcPcPc9}3;RcPcPcPcP}3</D></Data></Item>
