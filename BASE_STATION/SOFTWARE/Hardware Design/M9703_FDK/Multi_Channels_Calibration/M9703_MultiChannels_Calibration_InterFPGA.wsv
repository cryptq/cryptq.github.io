<Item XName="Equations" Type="Equation">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>% ------------------- M9703A Design Template Variables (Please don&apos;t edit this area) -------------------------------------&#x000D;&#x000A;OutPortNum = length(OutPortWL);&#x000D;&#x000A;if(UseReg==0)&#x000D;&#x000A;&#x0009;RegNum = 1;&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;RegNum = length(RegWL);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if(UseBlockReg==0)&#x000D;&#x000A;&#x0009;BlockRegNum = 1;&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;BlockRegNum = length(BlockRegWL);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;EXTIO_WL = 51;&#x000D;&#x000A;% ------------------------------------------------------------------------------------------------------------------------&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;% ---------------------------------- Start customized equations here -----------------------------------------------------&#x000D;&#x000A;CoefLen = 32;&#x000D;&#x000A;CoefAddrWL = round(log2(CoefLen));</Text>
