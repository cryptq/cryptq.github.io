<Item XName="Equations" Type="Equation">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>Calibration_Step=tune(1);&#x000D;&#x000A;&#x000D;&#x000A;if(Calibration_Step==1)&#x000D;&#x000A;&#x0009;SimulationMode = 0;&#x000D;&#x000A;&#x0009;WorkMode = 0;&#x000D;&#x000A;&#x0009;SimSampleNum = 30000;&#x000D;&#x000A;elseif(Calibration_Step==2)&#x000D;&#x000A;&#x0009;SimulationMode = 1;&#x000D;&#x000A;&#x0009;WorkMode = 0;&#x000D;&#x000A;&#x0009;SimSampleNum = 30000;&#x000D;&#x000A;elseif(Calibration_Step==3)&#x000D;&#x000A;&#x0009;SimulationMode = 2;&#x000D;&#x000A;&#x0009;WorkMode = 0;&#x000D;&#x000A;&#x0009;SimSampleNum = 512;&#x000D;&#x000A;elseif(Calibration_Step==4)&#x000D;&#x000A;&#x0009;SimulationMode = 3;&#x000D;&#x000A;&#x0009;WorkMode = 1;&#x000D;&#x000A;&#x0009;SimSampleNum = 30000;&#x000D;&#x000A;elseif(Calibration_Step==5)&#x000D;&#x000A;&#x0009;SimulationMode = 2;&#x000D;&#x000A;&#x0009;WorkMode = 1;&#x000D;&#x000A;&#x0009;SimSampleNum = 30000;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;DDCIFFreq = 320; % MHz&#x000D;&#x000A;DDCFreq = mod(DDCIFFreq/1600 * [0:7], 1);&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;% Simulate Mode&#x000D;&#x000A;%SimulationMode = 3;  % 0: Software simulation;     1: M8190 download single frequencys sequence;&#x0009;2: M9703 Connection;&#x0009;-1: M8190 download LFM&#x000D;&#x000A;%WorkMode = 0;&#x0009;% 0: measure;&#x0009;1: correction&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;% For M9703 Connection Mode&#x000D;&#x000A;% Specify the absolute path of your local &quot;M9703A_TEMPLATE&quot; folder that was generated by FPGA image automatic flow in advance&#x000D;&#x000A;% Specify your M9703 address, you can open Agilent IO Library to see your M9703 address&#x000D;&#x000A;RAMSize = 8*1024*1024;&#x000D;&#x000A;&#x000D;&#x000A;Threshold = 0.075;&#x000D;&#x000A;&#x000D;&#x000A;RegVec = [Threshold, WorkMode];&#x000D;&#x000A;&#x000D;&#x000A;freqvec = 1e6*(320+[-100+200/64: 200/32: 100-200/64]);&#x000D;&#x000A;commvec = [4.5*6, 4.5*8192*ones(1,15), 4.5*8192-17];&#x000D;&#x000A;sine_sample_rate = 7.2e9;&#x000D;&#x000A;&#x000D;&#x000A;N = 32;&#x000D;&#x000A;CoefI3 = [zeros(1, N/2-1), 1, zeros(1,N/2)];&#x000D;&#x000A;CoefQ3 = [zeros(1, N)];&#x000D;&#x000A;&#x000D;&#x000A;CoefI = [zeros(1, N/2-1), 1, zeros(1,N/2)];&#x000D;&#x000A;CoefQ = [zeros(1, N)];&#x000D;&#x000A;&#x000D;&#x000A;if(SimulationMode==2 &amp;&amp; WorkMode==0)&#x000D;&#x000A;&#x0009;hn3 = GetCoef(0);&#x000D;&#x000A;elseif(SimulationMode==2 &amp;&amp; WorkMode==1)&#x000D;&#x000A;&#x0009;CoefI3 = getvariable(&apos;Compensation_Coef&apos;, &apos;CoefI3&apos;);&#x000D;&#x000A;&#x0009;CoefQ3 = getvariable(&apos;Compensation_Coef&apos;, &apos;CoefQ3&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;CoefI = fliplr(CoefI);&#x000D;&#x000A;CoefQ = fliplr(CoefQ);&#x000D;&#x000A;&#x000D;&#x000A;CoefI3 = fliplr(CoefI3);&#x000D;&#x000A;CoefQ3 = fliplr(CoefQ3);&#x000D;&#x000A;</Text>
<UnitUse><T>Int</T><D>2</D></UnitUse>
