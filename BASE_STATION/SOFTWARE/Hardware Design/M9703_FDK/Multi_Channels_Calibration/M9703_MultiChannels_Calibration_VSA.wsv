<Item XName="GetCoef" UserName="GetCoef" Type="function">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>function [CoefV] = GetCoef(reset)&#x000D;&#x000A;&#x000D;&#x000A;hn = [];&#x000D;&#x000A;&#x000D;&#x000A;if(reset==1)&#x000D;&#x000A;&#x0009;hn = [];&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;if( isempty(hn) )&#x000D;&#x000A;&#x0009;&#x0009;phase_data3 = getvariable(&apos;DF1_Design3_Data&apos;,&apos;Post_Calibration_Phase&apos;);&#x000D;&#x000A;&#x0009;&#x0009;mag_data3 = getvariable(&apos;DF1_Design3_Data&apos;,&apos;Post_Calibration_Magnitude&apos;);&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;&#x0009;phase_test3 = zeros(1,16);&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;&#x0009;corr_vecI3 = zeros(1,32);&#x000D;&#x000A;&#x0009;&#x0009;corr_vecQ3 = zeros(1,32);&#x000D;&#x000A;&#x0009;&#x0009;for i=1:16&#x000D;&#x000A;&#x0009;&#x0009;    corr_vecI3(8+i) = mean(mag_data3(1024*(i-1)+400:1024*(i-1)+400+255)) * cos( pi*mean(phase_data3(1024*(i-1)+400:1024*(i-1)+400+255))/180 );&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;corr_vecQ3(8+i) = mean(mag_data3(1024*(i-1)+400:1024*(i-1)+400+255)) * sin( pi*mean(phase_data3(1024*(i-1)+400:1024*(i-1)+400+255))/180 );&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;phase_test3(i) = mean(phase_data3(1024*(i-1)+400:1024*(i-1)+400+255));&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;&#x0009;corr_vecI3 = [corr_vecI3(9)*ones(1,8), corr_vecI3(9:24), corr_vecI3(24)*ones(1,8)]&apos;;&#x000D;&#x000A;&#x0009;&#x0009;corr_vecQ3 = [corr_vecQ3(9)*ones(1,8), corr_vecQ3(9:24), corr_vecQ3(24)*ones(1,8)]&apos;;&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;&#x0009;hn = ifft([corr_vecI3(17:32)+j*corr_vecQ3(17:32); corr_vecI3(1:16)+j*corr_vecQ3(1:16)]);&#x000D;&#x000A;&#x0009;&#x0009;hn = flipud(hn);&#x000D;&#x000A;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;real_hn3 = real(hn);&#x000D;&#x000A;&#x0009;&#x0009;imag_hn3 = imag(hn);&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;&#x0009;N = 32;&#x000D;&#x000A;    &#x0009;CoefI3 = [real_hn3(N/2+1:N);real_hn3(1:N/2)]&apos;;&#x000D;&#x000A;&#x0009;&#x0009;CoefQ3 = [imag_hn3(N/2+1:N);imag_hn3(1:N/2)]&apos;;&#x000D;&#x000A;&#x0009;&#x0009;setvariable(&apos;Compensation_Coef&apos;, &apos;CoefI3&apos;, CoefI3);&#x000D;&#x000A;&#x0009;&#x0009;setvariable(&apos;Compensation_Coef&apos;, &apos;CoefQ3&apos;, CoefQ3);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;CoefV = hn;&#x000D;&#x000A;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;</Text>
