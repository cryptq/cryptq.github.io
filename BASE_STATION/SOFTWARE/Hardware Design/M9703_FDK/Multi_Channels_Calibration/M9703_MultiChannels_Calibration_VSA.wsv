<Item XName="S8" Type="Part">
<Category>Sources</Category>
<Description>Sine Wave Output</Description>
<DisabledNetlist />
<Footprint />
<MathLang><T>Bool</T><D>1</D></MathLang>
<Model>SineGen@Data Flow Models</Model>
<ModelID />
<Netlist>output,scom(1)?Connect44</Netlist>
<ParentPartName>SineGen@Algorithm Design</ParentPartName>
<SectionNum><T>Int</T><D>0</D></SectionNum>
<ShortSymbol />
