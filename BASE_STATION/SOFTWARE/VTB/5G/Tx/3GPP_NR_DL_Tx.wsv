<DataEntry>1</DataEntry>
<Description>Determines the amount of data acquired in the measurement</Description>
<DocSymbol />
<Enum>NR_DL_EVM__AcquisitionMode@5G Advanced Modem Enums</Enum>
<Range />
<RunTimeTunable><T>Bool</T><D>0</D></RunTimeTunable>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="AmpTracking" Type="PartParam">
<DataEntry>1</DataEntry>
<Description>whether or not tracking the amplitude err</Description>
<DocSymbol />
<Enum>NR_DL_EVM__AmpTracking@5G Advanced Modem Enums</Enum>
<HideCondition> 0 == TrackingMode</HideCondition>
<Range />
<RunTimeTunable><T>Bool</T><D>0</D></RunTimeTunable>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="AnalysisBoundary" Type="PartParam">
<DataEntry>AnalysisBoundary</DataEntry>
<Description>analysis start boundary</Description>
<DocSymbol />
<Enum>NR_DL_EVM__AnalysisBoundary@5G Advanced Modem Enums</Enum>
<Range />
<RunTimeTunable><T>Bool</T><D>0</D></RunTimeTunable>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="BWP_Idx" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>BWP index for observe</Description>
<DocSymbol />
<HideCondition>0 == ContinuousMode</HideCondition>
<Range />
<RunTimeTunable><T>Bool</T><D>0</D></RunTimeTunable>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>11</D></Validate></Item>
<Item XName="BWP_NumRBs" Type="PartParam">
<DataEntry>PDSCH_NumRBs</DataEntry>
<Description>number of PRBs in every BWP</Description>
<DocSymbol />
<Range />
<RunTimeTunable><T>Bool</T><D>0</D></RunTimeTunable>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="BWP_RBOffset" Type="PartParam">
<DataEntry>PDSCH_RBOffset</DataEntry>
<Description>the starting RB index of resource blocks allocated to every BWP in the whole bandwidth</Description>
<DocSymbol />
<Range />
<RunTimeTunable><T>Bool</T><D>0</D></RunTimeTunable>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="BandWidth" Type="PartParam">
<DataEntry>Bandwidth</DataEntry>
<Description>BandWidth</Description>
<DocSymbol />
<Enum>NR_DL_EVM__BandWidth@5G Advanced Modem Enums</Enum>
<Range />
<RunTimeTunable><T>Bool</T><D>0</D></RunTimeTunable>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="CORESET_Index" Type="PartParam">
<DataEntry>[1]</DataEntry>
<Description>A control resource set index in the range of 0 ~ 11, but 0 is not supported so far.</Description>
<DocSymbol />
<HideCondition>PDCCH_Enable==0</HideCondition>
<Range />
<RunTimeTunable><T>Bool</T><D>0</D></RunTimeTunable>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="CORESET_InterleaverSize" Type="PartParam">
<DataEntry>[6]</DataEntry>
<Description>the interleaver size (R) given by higher-layer parameter CORESET-interleaver-size. The value should be {2,3,6}</Description>
<DocSymbol />
<HideCondition>PDCCH_Enable==0</HideCondition>
<Range />
<RunTimeTunable><T>Bool</T><D>0</D></RunTimeTunable>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="CORESET_MappingType" Type="PartParam">
<DataEntry>[0]</DataEntry>
<Description> the CCE-to-REG mapping type for each CORESET in each BWP. 0 means non-interleaved while 1 means interleaved</Description>
<DocSymbol />
<HideCondition>PDCCH_Enable==0</HideCondition>
<Range />
<RunTimeTunable><T>Bool</T><D>0</D></RunTimeTunable>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="CORESET_NumSyms" Type="PartParam">
<DataEntry>[1]</DataEntry>
<Description> number of OFDM symbols in the time domain for each CORESET in each BWP. The value should be {1,2,3}</Description>
<DocSymbol />
<HideCondition>PDCCH_Enable==0</HideCondition>
<Range />
<RunTimeTunable><T>Bool</T><D>0</D></RunTimeTunable>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="CORESET_RB_Bitmap" Type="PartParam">
<DataEntry>[1, 1, 1, 1, 1, 1, 1, 1]</DataEntry>
<Description>PRB bitmap for each CORESET in each BWP in ascending order. Each bit represents a non-overlapping group of 6 PRBs. LSB means the lowest group of 6 PRBs.</Description>
<DocSymbol />
<HideCondition>PDCCH_Enable==0</HideCondition>
<Range />
<RunTimeTunable><T>Bool</T><D>0</D></RunTimeTunable>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="CORESET_REG_BundleSize" Type="PartParam">
<DataEntry>[6]</DataEntry>
<Description>the REG bundle size for each CORESET in each BWP configured by the higher-layer parameter CORESET-REG-bundle-size. {2,6} for CORESET_NumSyms=1; {CORESET_NumSyms,6} for CORESET_NumSyms={2,3}</Description>
<DocSymbol />
<HideCondition>PDCCH_Enable==0</HideCondition>
<Range />
<RunTimeTunable><T>Bool</T><D>0</D></RunTimeTunable>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="CORESET_ShiftIndex" Type="PartParam">
<DataEntry>[0]</DataEntry>
<Description>the shift given by the higher-layer parameter CORESET-shift-index. The value should be {0,1,...,274}</Description>
<DocSymbol />
<HideCondition>PDCCH_Enable==0</HideCondition>
<Range />
<RunTimeTunable><T>Bool</T><D>0</D></RunTimeTunable>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="CORESET_SymOffset" Type="PartParam">
<DataEntry>[0]</DataEntry>
<Description> start OFDM symbol index in the time domain for each CORESET in each BWP.</Description>
<DocSymbol />
<HideCondition>PDCCH_Enable==0</HideCondition>
<Range />
<RunTimeTunable><T>Bool</T><D>0</D></RunTimeTunable>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="CSIRS_AntennaPort" Type="PartParam">
<DataEntry>[3000]</DataEntry>
<Description>Sets the antenna port to be mapped to the selected CSI-RS.</Description>
<DocSymbol />
<HideCondition>sum(CSIRS_Enable) == 0</HideCondition>
<Range />
<RunTimeTunable><T>Bool</T><D>0</D></RunTimeTunable>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="CSIRS_Density" Type="PartParam">
<DataEntry>1</DataEntry>
<Description>0: density = 0.5, 1: density = 1, 2: density = 3, density of CSI-RS transmission in frequency domain defined in Table 7.4.1.5.3-1: CSI-RS locations within a slot in 3GPP TS 38.211</Description>
<DocSymbol />
<HideCondition>sum(CSIRS_Enable) == 0</HideCondition>
<Range />
<RunTimeTunable><T>Bool</T><D>0</D></RunTimeTunable>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="CSIRS_Enable" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>0: disable CSI-RS, 1: enable NZP CSI-RS, 2: enable ZP CSI-RS</Description>
<DocSymbol />
<Range />
<RunTimeTunable><T>Bool</T><D>0</D></RunTimeTunable>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="CSIRS_FirstSym" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>the time-domain locations l0 in the range of {0, 1, ..., 13}</Description>
<DocSymbol />
<HideCondition>sum(CSIRS_Enable) == 0</HideCondition>
<Range />
<RunTimeTunable><T>Bool</T><D>0</D></RunTimeTunable>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="CSIRS_FirstSym2" Type="PartParam">
<DataEntry>2</DataEntry>
<Description>the time-domain locations l1 in the range of {2, 3, ..., 12}, which is defined in section 7.4.1.5.3 in 3GPP TS 38.211</Description>
<DocSymbol />
<HideCondition>sum(CSIRS_Enable) == 0</HideCondition>
<Range />
<RunTimeTunable><T>Bool</T><D>0</D></RunTimeTunable>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="CSIRS_FreqDomainBitmap" Type="PartParam">
<DataEntry>[1, 1, 1, 1]</DataEntry>
<Description>the bitmap is used to indicate CSI-RS symbols&apos; locations in frequency domain in each resource block (RB)</Description>
<DocSymbol />
<HideCondition>sum(CSIRS_Enable) == 0</HideCondition>
<Range />
<RunTimeTunable><T>Bool</T><D>0</D></RunTimeTunable>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="CSIRS_N_ID" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>N_ID for CSI-RS sequence generation</Description>
<DocSymbol />
<HideCondition>sum(CSIRS_Enable) == 0</HideCondition>
<Range />
<RunTimeTunable><T>Bool</T><D>0</D></RunTimeTunable>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="CSIRS_NumRBs" Type="PartParam">
<DataEntry>20</DataEntry>
<Description>number of resource blocks (RBs) for each CSI-RS.</Description>
<DocSymbol />
<HideCondition>sum(CSIRS_Enable) == 0</HideCondition>
<Range />
<RunTimeTunable><T>Bool</T><D>0</D></RunTimeTunable>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="CSIRS_Periodicity" Type="PartParam">
<DataEntry>4</DataEntry>
<Description>in the range of {4, 5, 8, 10, 16, 20, 32, 40, 64, 80, 160, 320, 640}, the periodicity (in slots) of CSI-RS transmission</Description>
<DocSymbol />
<HideCondition>sum(CSIRS_Enable) == 0</HideCondition>
<Range />
<RunTimeTunable><T>Bool</T><D>0</D></RunTimeTunable>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="CSIRS_PosDot5" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>0: Even, 1: Odd (CSI-RS could be transmitted in either even RBs or odd RBs when density=0.5)</Description>
<DocSymbol />
<HideCondition>sum(CSIRS_Enable) == 0</HideCondition>
<Range />
<RunTimeTunable><T>Bool</T><D>0</D></RunTimeTunable>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="CSIRS_PowerBoosting" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>CSI-RS power boosting in dB</Description>
<DocSymbol />
<HideCondition>sum(CSIRS_Enable) == 0</HideCondition>
<Range />
<RunTimeTunable><T>Bool</T><D>0</D></RunTimeTunable>
<Validate><T>Int</T><D>14</D></Validate></Item>
<Item XName="CSIRS_RBOffset" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>the index of the first resource block (RB) allocated to each CSI-RS.</Description>
<DocSymbol />
<HideCondition>sum(CSIRS_Enable) == 0</HideCondition>
<Range />
<RunTimeTunable><T>Bool</T><D>0</D></RunTimeTunable>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="CSIRS_RowIndexOfLocTable" Type="PartParam">
<DataEntry>1</DataEntry>
<Description>in the range of {1, 2, ..., 18}, the row index of Table 7.4.1.5.3-1: CSI-RS locations within a slot in 3GPP TS 38.211</Description>
<DocSymbol />
<HideCondition>sum(CSIRS_Enable) == 0</HideCondition>
<Range />
<RunTimeTunable><T>Bool</T><D>0</D></RunTimeTunable>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="CSIRS_SlotOffset" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>the slot offset (in slots) allocated to CSI-RS transmission in each CSI-RS transmission period.</Description>
<DocSymbol />
<HideCondition>sum(CSIRS_Enable) == 0</HideCondition>
<Range />
<RunTimeTunable><T>Bool</T><D>0</D></RunTimeTunable>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="CellID" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>cell identity</Description>
<DocSymbol />
<Range />
<RunTimeTunable><T>Bool</T><D>0</D></RunTimeTunable>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>11</D></Validate></Item>
<Item XName="ContinuousMode" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>Run simulation in continuous mode</Description>
<DocSymbol />
<Enum>NR_DL_EVM__ContinuousMode@5G Advanced Modem Enums</Enum>
<Range />
<RunTimeTunable><T>Bool</T><D>0</D></RunTimeTunable>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="CyclicPrefix" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>CP type, 0 is for normal cyclic prefix and 1 is for extended cyclic prefix.</Description>
<DocSymbol />
<Enum>NR_DL_EVM__CyclicPrefix@5G Advanced Modem Enums</Enum>
<Range />
<RunTimeTunable><T>Bool</T><D>0</D></RunTimeTunable>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="DCI_BitNum" Type="PartParam">
<DataEntry>[20]</DataEntry>
<Description>The number of DCI bits for each PDCCH.</Description>
<DocSymbol />
<HideCondition>PDCCH_Enable==0</HideCondition>
<Range />
<RunTimeTunable><T>Bool</T><D>0</D></RunTimeTunable>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="DCPunctured" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>When DC Punctured is enabled, the DC subcarrier is excluded from measurement results. This is often helpful to avoid obscuring measurement results with artifacts of LO feedthrough.</Description>
<DocSymbol />
<Enum>NR_DL_EVM__DCPunctured@5G Advanced Modem Enums</Enum>
<Range />
<RunTimeTunable><T>Bool</T><D>0</D></RunTimeTunable>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="DisplayFrame" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>the Frame number for display some vector measurement results</Description>
<DocSymbol />
<Range />
<RunTimeTunable><T>Bool</T><D>0</D></RunTimeTunable>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>11</D></Validate></Item>
<Item XName="EqualizerTraining" Type="PartParam">
<DataEntry>2</DataEntry>
<Description>Specify how equalizer is trained</Description>
<DocSymbol />
<Enum>NR_DL_EVM__EqualizerTraining@5G Advanced Modem Enums</Enum>
<Range />
<RunTimeTunable><T>Bool</T><D>0</D></RunTimeTunable>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="EqualizerTrainingFreqMovingAvgSize" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>Per-carrier setting for specifying whether or not to perform a moving average (frequency smoothing) on the reference signal subcarriers during equalization. A value of 0 indicates the smoothing is off.</Description>
<DocSymbol />
<Range />
<RunTimeTunable><T>Bool</T><D>0</D></RunTimeTunable>
<Validate><T>Int</T><D>11</D></Validate></Item>
<Item XName="EqualizerTrainingTimeAverage" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>Per-carrier setting for specifying equalizer time averaging length</Description>
<DocSymbol />
<Enum>NR_DL_EVM__EqualizerTrainingTimeAverage@5G Advanced Modem Enums</Enum>
<Range />
<RunTimeTunable><T>Bool</T><D>0</D></RunTimeTunable>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="FCarrierRx" Type="PartParam">
<DataEntry>NR_Fc</DataEntry>
<Description>frequency carrier of the received signal</Description>
<DocSymbol />
<Range />
<RunTimeTunable><T>Bool</T><D>0</D></RunTimeTunable>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="FilterBandwidth" Type="PartParam">
<DataEntry>FilterBandwidth</DataEntry>
<Description>specify bandwidth for input signal.</Description>
<DocSymbol />
<HideCondition>UseMcFilter==0</HideCondition>
<Range />
<RunTimeTunable><T>Bool</T><D>0</D></RunTimeTunable>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="FramesToMeas" Type="PartParam">
<DataEntry>TimesToRun</DataEntry>
<Description>number of frames that will be averaged if AverageType is RMS (Video)</Description>
<DocSymbol />
<Range />
<RunTimeTunable><T>Bool</T><D>0</D></RunTimeTunable>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>11</D></Validate></Item>
<Item XName="GridStart" Type="PartParam">
<DataEntry>[0]</DataEntry>
<Description>Resource block start position according to point A for different numerology, exclusive of SSB_Numerology. Elements in GridStart should correspond to the ascending order of different Numerologies for valid BWPs.</Description>
<DocSymbol />
<Range />
<RunTimeTunable><T>Bool</T><D>0</D></RunTimeTunable>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="MCS" Type="PartParam">
<DataEntry>[0]</DataEntry>
<Description>modulation and coding scheme (MCS) for each user</Description>
<DocSymbol />
<HideCondition>PDSCH_Enable==0 || Payload_Config == 1</HideCondition>
<Range />
<RunTimeTunable><T>Bool</T><D>0</D></RunTimeTunable>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="MCSTable" Type="PartParam">
<DataEntry>[0]</DataEntry>
<Description>The MCS index table. [0~2] for CP-OFDM. [1,3,4] for DFT-s-OFDM. [0: 64QAM table | 1: 256QAM table | 2: 64QAMLowSE table | 3: DFT-64QAM table | 4: DFT-64QAMLowSE]</Description>
<DocSymbol />
<HideCondition>PDSCH_Enable==0 || Payload_Config == 1</HideCondition>
<Range />
<RunTimeTunable><T>Bool</T><D>0</D></RunTimeTunable>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="MeasInterval" Type="PartParam">
<DataEntry>MeasInterval</DataEntry>
<Description>specifies measurement interval in symbols used for EVM computation, starting from the slot and symbol offset specified by MeasOffset.It is based on the used maximum subcarrier spacing.</Description>
<DocSymbol />
<Range />
<RunTimeTunable><T>Bool</T><D>0</D></RunTimeTunable>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>11</D></Validate></Item>
<Item XName="MeasOffset" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>specifies measurement offset in symbols, from which EVM is computed. It is based on the used maximum subcarrier spacing.</Description>
<DocSymbol />
<Range />
<RunTimeTunable><T>Bool</T><D>0</D></RunTimeTunable>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>11</D></Validate></Item>
<Item XName="MirrorFreqSpectrum" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>whether or not the entire frequency spectrum be flipped around the carrier frequency</Description>
<DocSymbol />
<Enum>NR_DL_EVM__MirrorFreqSpectrum@5G Advanced Modem Enums</Enum>
<Range />
<RunTimeTunable><T>Bool</T><D>0</D></RunTimeTunable>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="Modulation" Type="PartParam">
<DataEntry>Modulation</DataEntry>
<Description>the modulation orders in each slot. ( 1:QPSK, 2:16QAM, 3:64QAM, 4:256QAM )</Description>
<DocSymbol />
<HideCondition>PDSCH_Enable==0 || Payload_Config == 0</HideCondition>
<Range />
<RunTimeTunable><T>Bool</T><D>0</D></RunTimeTunable>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="NumBWPs" Type="PartParam">
<DataEntry>1</DataEntry>
<Description>the number of BWPs</Description>
<DocSymbol />
<Range />
<RunTimeTunable><T>Bool</T><D>0</D></RunTimeTunable>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>11</D></Validate></Item>
<Item XName="NumRxRFChains" Type="PartParam">
<DataEntry>1</DataEntry>
<Description>the number of RX RF chains</Description>
<DocSymbol />
<Range />
<RunTimeTunable><T>Bool</T><D>0</D></RunTimeTunable>
<Validate><T>Int</T><D>11</D></Validate></Item>
<Item XName="Numerologies" Type="PartParam">
<DataEntry>Numerology</DataEntry>
<Description>OFDM numerologies(0:15kHz, 1:30kHz, 2:60kHz, 3:120kHz, 4:240kHz)</Description>
<DocSymbol />
<Range />
<RunTimeTunable><T>Bool</T><D>0</D></RunTimeTunable>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="OversamplingOption" Type="PartParam">
<DataEntry>OversamplingOptionEVM</DataEntry>
<Description>oversampling ratio option(0:Ratio_1, 1:Ratio_2, 2:Ratio_4, 3:Ratio_8, 4:Ratio_16, 5:Ratio_32, 6:Ration_64)</Description>
<DocSymbol />
<Enum>NR_DL_EVM__OversamplingOption@5G Advanced Modem Enums</Enum>
<Range />
<RunTimeTunable><T>Bool</T><D>0</D></RunTimeTunable>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PBCH_DMRS_PowerBoosting" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>DMRS of PBCH power boosting in dB</Description>
<DocSymbol />
<HideCondition>SSBEnable==0</HideCondition>
<Range />
<RunTimeTunable><T>Bool</T><D>0</D></RunTimeTunable>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="PDCCH_AggregationLevel" Type="PartParam">
<DataEntry>[2]</DataEntry>
<Description> number of control-channel elements (CCEs) for each PDCCH in each BWP. The value should be {1, 2, 4, 8, 16}.</Description>
<DocSymbol />
<HideCondition>PDCCH_Enable==0</HideCondition>
<Range />
<RunTimeTunable><T>Bool</T><D>0</D></RunTimeTunable>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PDCCH_CandidateIndex" Type="PartParam">
<DataEntry>[0]</DataEntry>
<Description>PDCCH candidate index in the range of 0 ~ PDCCH_NumCandidates - 1.</Description>
<DocSymbol />
<HideCondition>PDCCH_Enable==0</HideCondition>
