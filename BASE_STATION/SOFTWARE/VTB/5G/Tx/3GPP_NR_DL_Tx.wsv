D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDCCH_StartSlot = [0,10,20,30,40,50,60,70];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDCCH_NumSlots = [8,8,8,8,8,8,8,8];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDSCH_NumSlots = ones(1,length(PDSCH_AllocatedSlots));&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDSCH_StartSlot = PDSCH_AllocatedSlots;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;otherwise&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;NumBWPs = 6;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;BWP_NumRBs_t = BWP_NumRBs;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;BWP_RBOffset_t = BWP_RBOffset;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDSCH_n_RNTI = [2];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDSCH_PowerBoosting =[0];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;Modulation = [3];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PTRS_Enable = 1;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDSCH_PTRS_TimeDensity = [2];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDSCH_PTRS_FrequencyDensity =[0];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDSCH_PTRS_ResourceElementOffset =[0];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDSCH_PTRS_PowerBoosting =[0];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDSCH_DMRS_AddPos = [0];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDSCH_DMRS_Length_t = PDSCH_DMRS_Length;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDSCH_DMRS_AddPos_t = PDSCH_DMRS_AddPos;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDSCH_DMRS_TypeA_Pos_t = PDSCH_DMRS_TypeA_Pos;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;for i=1:NumBWPs&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDSCH_DMRS_Length(i) = PDSCH_DMRS_Length_t(mod(i-1,length(PDSCH_DMRS_Length_t))+1);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDSCH_DMRS_AddPos(i) = PDSCH_DMRS_AddPos_t(mod(i-1,length(PDSCH_DMRS_AddPos_t))+1);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDSCH_DMRS_TypeA_Pos(i) = PDSCH_DMRS_TypeA_Pos_t(mod(i-1,length(PDSCH_DMRS_TypeA_Pos_t))+1);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;BWP_NumRBs(i)= BWP_NumRBs_t(mod(i-1,length(BWP_NumRBs_t))+1);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;BWP_RBOffset(i)= BWP_RBOffset_t(mod(i-1,length(BWP_RBOffset_t))+1);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;CORESET_NumSyms = [2,0,0,0,0,0];&#x000D;&#x000A;&#x0009;otherwise&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;EqualizerTraining = 2;&#x000D;&#x000A;EqualizerTrainingFreqMovingAvgSize = 0;&#x000D;&#x000A;SymTimeAdjMode = 4;&#x000D;&#x000A;&#x000D;&#x000A;%%%%%%%%%%%about number of subframes&#x000D;&#x000A;%%%%subframe case&#x000D;&#x000A;if(NumSubframes&lt;10)&#x000D;&#x000A;&#x0009;if(NumSubframes &gt;1 &amp;&amp;NumSubframes&lt;10)&#x000D;&#x000A;&#x0009;&#x0009;warning(&apos;NumSubframes more than 1 and less than 10 is not supported now, NumSubframes is set to 1.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;NumSubframes = 1;&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x0009;TimesToRun = NumSubframes;&#x0009;&#x000D;&#x000A;&#x0009;ResLenInSubframes = 1;&#x000D;&#x000A;&#x0009;MeasInterval = 14*2^Numerology;&#x000D;&#x000A;&#x0009;AnalysisBoundary = 2;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;%%%%%%% frame case&#x000D;&#x000A;if(NumSubframes &gt;9)&#x000D;&#x000A;&#x0009;TimesToRun = floor(NumSubframes/10 +0.5);&#x0009;&#x000D;&#x000A;&#x0009;ResLenInSubframes = 10;&#x000D;&#x000A;&#x0009;MeasInterval = 140*2^Numerology;&#x000D;&#x000A;&#x0009;AnalysisBoundary = 0;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;%if (DuplexType==0)&#x000D;&#x000A;%&#x0009;ResLenInSubframes = 10*2;&#x000D;&#x000A;%&#x0009;MeasInterval = 140*2^Numerology*2;&#x000D;&#x000A;%&#x0009;AnalysisBoundary = 0;&#x000D;&#x000A;%end&#x0009;&#x000D;&#x000A;%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%End of Test Model&#x000D;&#x000A;</Text>
