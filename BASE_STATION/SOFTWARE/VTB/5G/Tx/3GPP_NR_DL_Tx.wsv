gy];&#x000D;&#x000A;&#x0009;&#x0009;else&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDSCH_RA_Type0Bitmap =[PDSCH_RA_Type0Bitmap,PDSCH_RA_Type0Bitmap];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDSCH_PowerBoosting = [PDSCH_PowerBoosting,PDSCH_PowerBoosting];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;switch(Numerology)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;case 0&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDSCH_StartOFDMSym = [2,2, 0,0,0,0];&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDSCH_NumOFDMSyms =[12,8, 14,14,10,10];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDSCH_GroupNumAllocSlots = [2];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDCCH_GroupNumAllocSlots = [2];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDSCH_StartSlot = [0,5,3,8, 0,5,0,5,3,8,3,8];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDSCH_NumSlots = [3,3,1,1, 3,3,3,3,1,1,1,1];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDCCH_StartSlot = [0,5];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDCCH_NumSlots = [4,4];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;case 1&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDSCH_StartOFDMSym = [2,2, 0,0,0,0];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDSCH_NumOFDMSyms =[12,4, 14,14,6,6];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDSCH_GroupNumAllocSlots = [2];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDCCH_GroupNumAllocSlots = [2];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDSCH_StartSlot = [0,10,7,17, 0,10,0,10,7,17,7,17];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDSCH_NumSlots = [7,7,1,1, 7,7,7,7,1,1,1,1];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDCCH_StartSlot = [0,10];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDCCH_NumSlots = [8,8];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;case 2&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDSCH_StartOFDMSym = [2,2,  0,0,0,0];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDSCH_NumOFDMSyms =[12,10,  14,14,12,1