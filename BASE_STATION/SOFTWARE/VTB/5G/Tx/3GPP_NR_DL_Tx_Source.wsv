<Item XName="Equations" Type="Equation">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>G_RE_per_RB = 12;&#x000D;&#x000A;if ((FCarrierTx &gt;= 410e6) &amp;&amp; (FCarrierTx &lt;= 7.125e9))&#x000D;&#x000A;&#x0009;FrequencyRange = 0;&#x000D;&#x000A;elseif ((FCarrierTx &gt;= 24.25e9) &amp;&amp; (FCarrierTx &lt;= 52.6e9))&#x000D;&#x000A;&#x0009;FrequencyRange = 1;&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;error(&apos;FCarrierTx is not in the legit range: {FR1: 410 MHz ~ 7125 MHz} or {FR2: 24250 MHz ~ 52600 MHz}&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;%%%%%%%%%%%%%%%%%BandWidth&amp;FR CarrierNumRBs&#x000D;&#x000A;if (FrequencyRange==0)&#x000D;&#x000A;&#x0009;if(Numerology &gt;2)&#x000D;&#x000A;&#x0009;&#x0009;error(&apos;Numerology should not be more than 2(60kHz) in FR1&apos;);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x0009;switch Numerology&#x000D;&#x000A;&#x0009;case 0&#x000D;&#x000A;&#x0009;&#x0009;if (Bandwidth &gt; 7)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;error(&apos;Bandwidth should not be more than 50MHz for Numerolgoy 0(15kHz) in FR1&apos;);&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;case 1&#x000D;&#x000A;&#x0009;&#x0009;if (Bandwidth &gt; 12)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;error(&apos;Bandwidth should not be more than 100MHz for Numerolgoy 1(30kHz) in FR1&apos;);&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;case 2&#x000D;&#x000A;&#x0009;&#x0009;if (Bandwidth &gt; 12)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;error(&apos;Bandwidth should not be more than 100MHz for Numerolgoy 2(60kHz) in FR1&apos;);&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;if (Bandwidth &lt; 1)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;error(&apos;Bandwidth should not be less than 10MHz for Numerolgoy 2(60kHz) in FR1&apos;);&#x000D;&#x000A;&#x0009;&#x0009;end&#x0009;&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;if (Numerology &lt;2)&#x000D;&#x000A;&#x0009;&#x0009;error(&apos;Numerology should not be less than 2(60kHz) in FR2&apos;);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x0009;&#x000D;&#x000A;&#x0009;if Numerology == 4&#x000D;&#x000A;&#x0009;&#x0009;error(&apos;Numerology 240 is not defined by Test Model.&apos;);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;if (Bandwidth ~= 7 &amp;&amp; Bandwidth &lt; 12)&#x000D;&#x000A;&#x0009;&#x0009;error(&apos;Bandwidth should be 50MHz, 100MHz, 200MHz or 400MHz in FR2&apos;);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;if (Bandwidth == 14 &amp;&amp; Numerology ==2)&#x000D;&#x000A;&#x0009;&#x0009;error(&apos;Bandwidth should be less than 400MHz for Numerolgoy 2(60kHz) in FR2&apos;);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;TestModelNameList = {&apos;0:NR-FR1-TM1.1&apos;, &apos;1:NR-FR1-TM1.2&apos;, &apos;2:NR-FR1-TM2&apos;, &apos;3:NR-FR1-TM2a&apos;, &apos;4:NR-FR1-TM3.1&apos;, &apos;5:NR-FR1-TM3.1a&apos;, &apos;6:NR-FR1-3.2&apos;, &apos;7:NR-FR1-3.3&apos;, &apos;8:NR-FR2-TM1.1&apos;, &apos;9:NR-FR2-TM2&apos;, &apos;10:NR-FR2-TM3.1&apos;};&#x000D;&#x000A;if(FrequencyRange ==0 &amp;&amp; TestModel&gt;7)&#x000D;&#x000A;&#x0009;error(&apos;Wrong test model! %s is not avaiable in frequency range 0.&apos;, TestModelNameList{TestModel + 1});&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if(FrequencyRange ==1 &amp;&amp; TestModel&lt;8)&#x000D;&#x000A;&#x0009;error(&apos;Wrong test model! %s is not avaiable in frequency range 1.&apos;, TestModelNameList{TestModel + 1});&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if(DuplexType ==1 &amp;&amp; TestModel&gt;7)&#x000D;&#x000A;&#x0009;error(&apos;FDD is not supported for FR2.&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if(Numerology&lt;2 &amp;&amp; TestModel&gt;7)&#x000D;&#x000A;&#x0009;error(&apos;Numerology should be no less than 60kHz for FR2 test model.&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if(Numerology&gt;2 &amp;&amp; TestModel&lt;8)&#x000D;&#x000A;&#x0009;error(&apos;Numerology should be no more than 60kHz for FR1 test model.&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;FR1NumRBsTable=[25,52,79,106,133,160,216,270,0,0,0,0,0;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;11,24,38,51,65,78,106,133,162,189,217,245,273;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;0,11,18,24,31,38,51,65,79,93,107,121,135];&#x000D;&#x000A;FR2NumRBsTable=[66,132,264,0;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;32,66,132,264;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;17,34,69,138];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;if(FrequencyRange ==0)&#x000D;&#x000A;&#x0009;CarrierNumRBs = FR1NumRBsTable(Numerology+1,Bandwidth+1);&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;if(Bandwidth&lt;10)&#x000D;&#x000A;&#x0009;&#x0009;NumRBsIdx = 1;&#x000D;&#x000A;&#x0009;else&#x000D;&#x000A;&#x0009;&#x0009;NumRBsIdx = Bandwidth-10;&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x0009;CarrierNumRBs = FR2NumRBsTable(Numerology-1,NumRBsIdx);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;%%%%%%%%%%%%%%%%%%%%%%%%%%Parameter Setting for Test Model //DL&#x000D;&#x000A;%%%Common Setting&#x000D;&#x000A;CyclicPrefix = [0];&#x000D;&#x000A;CellID = 1;&#x000D;&#x000A;BWP_RBOffset = [0];&#x000D;&#x000A;BWP_NumRBs = [CarrierNumRBs];&#x000D;&#x000A;&#x000D;&#x000A;%%%PDCCH&#x000D;&#x000A;PDCCH_Enable = 1;&#x000D;&#x000A;CORESET_ShareMode = [1];&#x000D;&#x000A;CORESET_RB_Bitmap = [1];&#x000D;&#x000A;CORESET_NumSyms = [2];&#x000D;&#x000A;CORESET_SymOffset = [0];&#x000D;&#x000A;CORESET_MappingType = [0];&#x000D;&#x000A;PDCCH_n_RNTI = [0];&#x000D;&#x000A;PDCCH_AggregationLevel =[1];&#x000D;&#x000A;PDCCH_DMRS_MapMode = [1];&#x000D;&#x000A;PDCCH_DMRS_PowerBoosting =[0];&#x000D;&#x000A;PDCCH_PowerBoosting =[0];&#x000D;&#x000A;&#x000D;&#x000A;nCI = 0;&#x000D;&#x000A;PDCCH_DMRS_ScramblingID = [CellID];&#x000D;&#x000A;DCI_BitNum =[20];&#x000D;&#x000A;CORESET_Index =[1];&#x000D;&#x000A;CORESET_REG_BundleSize = [6];&#x000D;&#x000A;CORESET_InterleaverSize= [6];&#x000D;&#x000A;CORESET_ShiftIndex = [0];&#x000D;&#x000A;SearchSpaceType = [0];&#x000D;&#x000A;PDCCH_NumCandidates =[4];&#x000D;&#x000A;PDCCH_CandidateIndex = [0];&#x000D;&#x000A;&#x000D;&#x000A;%%%%PDSCH&#x000D;&#x000A;PDSCH_Enable = 1;&#x000D;&#x000A;PDSCH_RBOffset = [0];&#x000D;&#x000A;PDSCH_NumRBs = CarrierNumRBs;&#x000D;&#x000A;PDSCH_n_ID = [0];&#x000D;&#x000A;PDSCH_DMRS_N_ID = [CellID];&#x000D;&#x000A;PDSCH_DMRS_n_SCID = [0];&#x000D;&#x000A;PDSCH_MappingType = [0];&#x000D;&#x000A;PDSCH_DMRS_TypeA_Pos = [2];&#x000D;&#x000A;PDSCH_DMRS_AddPos = [1];&#x000D;&#x000A;PDSCH_DMRS_ConfigType = [0];&#x000D;&#x000A;PDSCH_DMRS_Length = [1];&#x000D;&#x000A;PDSCH_DMRS_PowerBoosting = [0];&#x000D;&#x000A;PDSCH_DMRS_NumPorts =[1];&#x000D;&#x000A;PDSCH_DMRS_PortList = [1000];&#x000D;&#x000A;PDSCH_ResourceAllocationType =[1];&#x000D;&#x000A;PDSCH_RA_Type0Bitmap = ones(1,8);&#x000D;&#x000A;PDSCH_RBG_Configuration =[0];&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;DC_Reserved = 0;&#x000D;&#x000A;SSB_Enable = 0;&#x000D;&#x000A;SSB_Lmax = 0;&#x000D;&#x000A;SSB_ActiveBlocks = [0:3];&#x000D;&#x000A;SSB_RBOffset = 0;&#x000D;&#x000A;SSB_k0 =0;&#x000D;&#x000A;SubCarrierSpacingCommon = 2;&#x000D;&#x000A;SSB_Periodicity = 0;&#x000D;&#x000A;SSB_TimeOffset = 0;&#x000D;&#x000A;SSB_SymStartOption30K = 0;&#x000D;&#x000A;PSS_PowerBoosting = 0;&#x000D;&#x000A;SSS_PowerBoosting = 0;&#x000D;&#x000A;PBCH_PowerBoosting = 0;&#x000D;&#x000A;PBCH_DMRS_PowerBoosting = 0;&#x000D;&#x000A;PDSCH_DMRS_CDMGroupNum =[1];&#x000D;&#x000A;Payload_Config = 1;&#x000D;&#x000A;TransBlockSize = [2555];&#x000D;&#x000A;LDPCBaseGraphType =[0];&#x000D;&#x000A;MCS =[0];&#x000D;&#x000A;MCSTable =[0];&#x000D;&#x000A;PTRS_Enable = 0;&#x000D;&#x000A;PDSCH_PTRS_TimeDensity = [0];&#x000D;&#x000A;PDSCH_PTRS_FrequencyDensity =[0];&#x000D;&#x000A;PDSCH_PTRS_ResourceElementOffset =[0];&#x000D;&#x000A;PDSCH_PTRS_PowerBoosting =[0];&#x000D;&#x000A;HARQ_Enable = 0;&#x000D;&#x000A;NumHARQ =[8];&#x000D;&#x000A;MaxHARQTrans = [4];&#x000D;&#x000A;RV_Sequence = [0,1,2,3];&#x000D;&#x000A;CSIRS_Enable = 0;&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;switch(TestModel)&#x000D;&#x000A;&#x0009;case {0,4,5}&#x000D;&#x000A;&#x0009;&#x0009;if(TestModel ==0)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;Modulation = 1;&#x000D;&#x000A;&#x0009;&#x0009;else if(TestModel ==4)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;Modulation = 3;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009; else if(TestModel ==5)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009; &#x0009;&#x0009;Modulation = 4;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;  end&#x000D;&#x000A;&#x0009;&#x0009;&#x0009; end&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;if(DuplexType == 1)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;NumBWPs = 2;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDSCH_n_RNTI = [0,2];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDSCH_PowerBoosting =[0];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDCCH_NumAllocatedSlots = [10*2^Numerology];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDCCH_AllocatedSlots =[0:10*2^Numerology-1];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDCCH_DMRS_PowerBoosting =[20*log10(0.5)];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDCCH_PowerBoosting =[20*log10(0.5)];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDSCH_NumAllocatedSlots = [10*2^Numerology];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDSCH_AllocatedSlots =[0:10*2^Numerology-1];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDSCH_StartOFDMSym = [0,2];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDSCH_NumOFDMSyms =[14,12];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDSCH_RBOffset = [3,0];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDSCH_NumRBs = [CarrierNumRBs-3,3];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDSCH_DMRS_Length = [1,1];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDSCH_DMRS_AddPos = [1,1];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDSCH_DMRS_TypeA_Pos = [2,2];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;BWP_RBOffset= [0,0];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;BWP_NumRBs= [CarrierNumRBs,CarrierNumRBs];&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;else&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;switch(Numerology)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;case 0&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDCCH_NumAllocatedSlots = [6,2, 6,2];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDCCH_AllocatedSlots =[0:2,5:7,3,8, 0:2,5:7,3,8];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDSCH_NumAllocatedSlots = [6,2, 6,2];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDSCH_AllocatedSlots =[0:2,5:7,3,8, 0:2,5:7,3,8];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDSCH_StartOFDMSym = [0, 0, 2,2];&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDSCH_NumOFDMSyms =[14,10,12,8];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;case 1&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDCCH_NumAllocatedSlots = [14,2, 14,2];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDCCH_AllocatedSlots =[0:6,10:16,7,17, 0:6,10:16,7,17];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDSCH_NumAllocatedSlots = [14,2,14,2];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDSCH_AllocatedSlots =[0:6,10:16,7,17, 0:6,10:16,7,17];&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDSCH_StartOFDMSym = [0, 0, 2,2];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDSCH_NumOFDMSyms =[14,6,12,4];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;case 2&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDCCH_NumAllocatedSlots = [28,2, 28,2];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDCCH_AllocatedSlots =[0:13,20:33,14,34,0:13,20:33,14,34];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDSCH_NumAllocatedSlots = [28,2, 28,2];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDSCH_AllocatedSlots =[0:13,20:33,14,34,0:13,20:33,14,34];&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDSCH_StartOFDMSym = [0,0,2,2];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDSCH_NumOFDMSyms =[14,12,12,10];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;otherwise&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;NumBWPs = 4;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDCCH_DMRS_PowerBoosting =[20*log10(0.5)];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDCCH_PowerBoosting =[20*log10(0.5)];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDSCH_n_RNTI = [0, 0, 2, 2];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDSCH_PowerBoosting =[0];&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDSCH_DMRS_Length_t = PDSCH_DMRS_Length;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDSCH_DMRS_AddPos_t = PDSCH_DMRS_AddPos;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDSCH_DMRS_TypeA_Pos_t = PDSCH_DMRS_TypeA_Pos;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDSCH_RBOffset = [3,3,0,0];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDSCH_NumRBs = [CarrierNumRBs-3,CarrierNumRBs-3,3,3];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;BWP_RBOffset= [0,0,0,0]&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;BWP_NumRBs= [CarrierNumRBs,CarrierNumRBs,CarrierNumRBs,CarrierNumRBs];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;for i=1:NumBWPs&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDSCH_DMRS_Length(i) = PDSCH_DMRS_Length_t(mod(i-1,length(PDSCH_DMRS_Length_t))+1);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDSCH_DMRS_AddPos(i) = PDSCH_DMRS_AddPos_t(mod(i-1,length(PDSCH_DMRS_AddPos_t))+1);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDSCH_DMRS_TypeA_Pos(i) = PDSCH_DMRS_TypeA_Pos_t(mod(i-1,length(PDSCH_DMRS_TypeA_Pos_t))+1);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;end&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;case {1,6,7}&#x000D;&#x000A;&#x0009;&#x0009;PDSCH_ResourceAllocationType =[0];&#x000D;&#x000A;&#x0009;&#x0009;PDSCH_RBG_Configuration =[0];&#x000D;&#x000A;&#x0009;&#x0009;BWP_RBOffset = [3];&#x000D;&#x000A;&#x0009;&#x0009;BWP_NumRBs = [CarrierNumRBs-3];&#x000D;&#x000A;&#x0009;&#x0009;%%%%%%%%%%%%%%%%%%%%%%%calculate P for test case TM1.2,TM3.2 and TM3.3&#x000D;&#x000A;&#x0009;&#x0009;if(BWP_NumRBs &gt;=1 &amp;&amp; BWP_NumRBs&lt;=36)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;P = 2;&#x000D;&#x000A;&#x0009;&#x0009;elseif(BWP_NumRBs &gt;=37 &amp;&amp; BWP_NumRBs&lt;=72)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;P = 4;&#x000D;&#x000A;&#x0009;&#x0009;elseif(BWP_NumRBs &gt;=73 &amp;&amp; BWP_NumRBs&lt;=144)&#x000D;&#x000A; &#x0009;&#x0009;&#x0009;P = 8;&#x000D;&#x000A;&#x0009;  &#x0009;else&#x000D;&#x000A;&#x0009;  &#x0009;&#x0009;P = 16;&#x000D;&#x000A;&#x0009;&#x0009;end&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;RBG_All = ceil((BWP_NumRBs + mod(BWP_RBOffset,P))/P);&#x000D;&#x000A;&#x0009;&#x0009;if(TestModel ==1)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;Modulation = [1,1];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDSCH_n_RNTI = [0,1];%%%%boosted, deboosted&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;N_RBG= min(floor(0.4*(CarrierNumRBs-3)/P),0.5*(floor((CarrierNumRBs-3+mod(3,P)-P)/P)-mod(floor((CarrierNumRBs-3+mod(3,P)-P)/P),2))+1); %%%%%boosted&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;bitmap_boosted = zeros(1,RBG_All);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;for i =0:2:2*(N_RBG-2)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;bitmap_boosted(i+1+1) = 1;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;bitmap_boosted(floor((CarrierNumRBs-3)/P+mod(3,P)/P)) = 1;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;bitmap_deboosted = ~bitmap_boosted;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDSCH_RA_Type0Bitmap = [bitmap_boosted,bitmap_deboosted];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDSCH_PowerBoosting =[3,10*log10(((CarrierNumRBs-3)-10^(0.3)*P*N_RBG)/((CarrierNumRBs-3)-P*N_RBG))];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDSCH_DMRS_PowerBoosting = PDSCH_PowerBoosting;&#x000D;&#x000A;&#x0009;&#x0009;else if(TestModel ==6)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;Modulation = [1,2];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDSCH_n_RNTI = [0,1];%%%%boosted, deboosted&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;N_RBG= min(floor(0.6*(CarrierNumRBs-3)/P),0.5*(floor((CarrierNumRBs-3+mod(3,P)-P)/P)-mod(floor((CarrierNumRBs-3+mod(3,P)-P)/P),2))+1); %%%%%deboosted&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;bitmap_deboosted =