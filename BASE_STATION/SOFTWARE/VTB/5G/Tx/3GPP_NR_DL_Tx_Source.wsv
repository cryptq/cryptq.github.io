0D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDSCH_StartOFDMSym = [2,2,2,2,2,2];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDSCH_NumOFDMSyms =[12,12,12,4,4,4];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDSCH_RBOffset = [0,floor(CarrierNumRBs/2),CarrierNumRBs-1,0,floor(CarrierNumRBs/2),CarrierNumRBs-1];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDSCH_NumRBs =[1,1,1,1,1,1];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;otherwise&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;NumBWPs = 6;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDSCH_n_RNTI = [2];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDSCH_PowerBoosting =[0];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;Modulation = [3];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PTRS_Enable = 1;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDSCH_PTRS_TimeDensity = [2];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDSCH_PTRS_FrequencyDensity =[0];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDSCH_PTRS_ResourceElementOffset =[0];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDSCH_PTRS_PowerBoosting =[0];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDSCH_DMRS_AddPos = [0];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDSCH_DMRS_Length_t = PDSCH_DMRS_Length;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDSCH_DMRS_AddPos_t = PDSCH_DMRS_AddPos;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDSCH_DMRS_TypeA_Pos_t = PDSCH_DMRS_TypeA_Pos;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;BWP_NumRBs_t = BWP_NumRBs;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;BWP_RBOffset_t = BWP_RBOffset;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;for i=1:NumBWPs&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDSCH_DMRS_Length(i) = PDSCH_DMRS_Length_t(mod(i-1,length(PDSCH_DMRS_Length_t))+1);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDSCH_DMRS_AddPos(i) = PDSCH_DMRS_AddPos_t(mod(i-1,length(PDSCH_DMRS_AddPos_t))+1);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDSCH_DMRS_TypeA_Pos(i) = PDSCH_DMRS_TypeA_Pos_t(mod(i-1,length(PDSCH_DMRS_TypeA_Pos_t))+1);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;BWP_NumRBs(i)= BWP_NumRBs_t(mod(i-1,length(BWP_NumRBs_t))+1);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;BWP_RBOffset(i)= BWP_RBOffset_t(mod(i-1,length(BWP_RBOffset_t))+1);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;otherwise&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%End of Test Model&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;%%%%%calculate FFTSize and SamplingRate%%%%%%%%%%%%%%%%%%%%&#x000D;&#x000A;CC_Bandwidth = CarrierNumRBs*12*15e3*2^Numerology;&#x000D;&#x000A;FFTSize = 2^ceil(log2(CarrierNumRBs*12))*2^(OversamplingOption);&#x000D;&#x000A;SamplingRate = FFTSize*15e3*2^Numerology;&#x000D;&#x000A;switch(Numerology)&#x000D;&#x000A;case 0 &#x000D;&#x000A;&#x0009;SCS = 15;&#x000D;&#x000A;case 1 &#x000D;&#x000A;&#x0009;SCS = 30;&#x000D;&#x000A;case 2 &#x000D;&#x000A;&#x0009;SCS = 60;&#x000D;&#x000A;case 3 &#x000D;&#x000A;&#x0009;SCS = 120;&#x000D;&#x000A;case 4 &#x000D;&#x000A;&#x0009;SCS = 240;&#x000D;&#x000A;otherwise&#x000D;&#x000A;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;postinfo([&apos;The SamplingRate is &apos; num2str(SamplingRate) &apos; Hz, the bandwidth of CC is &apos; num2str(CC_Bandwidth) &apos; Hz and the FFTSize is &apos; num2str(FFTSize) &apos; for Numerology &apos; num2str(Numerology) &apos; (&apos; num2str(SCS) &apos;kHz)&apos;]);&#x000D;&#x000A;&#x000D;&#x000A;CellID_Group = floor(CellID/3);&#x000D;&#x000A;CellID_Sector = mod(CellID, 3);&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;if log2(FFTSize) - floor(log2(FFTSize)) ~= 0 %not integer&#x000D;&#x000A;&#x0009;error(&apos;SamplingRate is not valid. (SamplingRate / Subcarrier Spacing) should be integral exponent of 2.&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if FFTSize &lt; BWP_NumRBs * 12&#x000D;&#x000A;&#x0009;error(&apos;BWP size is out of bandwidth.&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;%Range check&#x000D;&#x000A;if (length(PDSCH_DMRS_PortList)&lt;1)&#x000D;&#x000A;error(&apos;PDSCH_DMRS_PortList should be empty!!&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;%parsing BWP ports&#x000D;&#x000A;PDSCH_PortNum = zeros(1, NumBWPs);&#x000D;&#x000A;PDSCH_PortList = cell(1, NumBWPs);&#x000D;&#x000A;PDCCH_PortNum = zeros(1, NumBWPs);&#x000D;&#x000A;PDCCH_PortList = cell(1, NumBWPs);&#x000D;&#x000A;local_PDSCH_DMRS_NumPorts = zeros(1, NumBWPs);&#x000D;&#x000A;off = 0;&#x000D;&#x000A;for i = 1 : NumBWPs&#x000D;&#x000A;&#x0009;portNum = PDSCH_DMRS_NumPorts(mod(i - 1, length(PDSCH_DMRS_NumPorts)) + 1);&#x000D;&#x000A;&#x0009;schList = [];&#x000D;&#x000A;&#x0009;cchList = [];&#x000D;&#x000A;&#x0009;for j = 1 : portNum&#x000D;&#x000A;&#x0009;&#x0009;port = PDSCH_DMRS_PortList(mod(off + j - 1, length(PDSCH_DMRS_PortList)) + 1);&#x000D;&#x000A;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;if (port &gt;= 1000 &amp;&amp; port &lt;= 1011)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;schList = [schList, port];&#x000D;&#x000A;&#x0009;&#x0009;end&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x0009;if(PDCCH_Enable)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;cchList = [2000];&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x0009;PDSCH_PortList{i} = {unique(schList)};&#x000D;&#x000A;&#x0009;PDCCH_PortList{i} = {unique(cchList)};&#x000D;&#x000A;&#x0009;&#x000D;&#x000A;&#x0009;PDSCH_PortNum(i) = length(unique(schList));&#x000D;&#x000A;&#x0009;PDCCH_PortNum(i) = length(unique(cchList));&#x000D;&#x000A;&#x0009;&#x000D;&#x000A;&#x0009;local_PDSCH_DMRS_NumPorts(i) = PDSCH_PortNum(i) + PDCCH_PortNum(i);&#x000D;&#x000A;&#x000D;&#x000A;%&#x0009;if local_PDSCH_DMRS_NumPorts(i) ~= portNum&#x000D;&#x000A;%&#x0009;&#x0009;error(&apos;For a BWP, all ports should be unique.&apos;);&#x000D;&#x000A;%&#x0009;end&#x000D;&#x000A;&#x0009;&#x000D;&#x000A;&#x0009;%Check port list&#x000D;&#x000A;%&#x0009;if PDCCH_Enable == 1&#x000D;&#x000A;%&#x0009;&#x0009;if PDCCH_PortNum(i) ~= 1&#x000D;&#x000A;%&#x0009;&#x0009;&#x0009;error(&apos;When PDCCH is enabled, PDSCH_DMRS_PortList should have port 2000 for each BWP.&apos;);&#x000D;&#x000A;%&#x0009;&#x0009;end&#x000D;&#x000A;%&#x0009;end&#x000D;&#x000A;&#x0009;&#x000D;&#x000A;&#x0009;if PDSCH_Enable == 1&#x000D;&#x000A;&#x0009;&#x0009;if PDSCH_PortNum(i) &lt; 1 || PDSCH_PortNum(i) &gt; 12&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;error(&apos;When PDSCH is enabled, ports for PDSCH in PDSCH_DMRS_PortList should be 1000~1011.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x0009;&#x000D;&#x000A;&#x0009;off = off + portNum;&#x000D;&#x000A;end&#x000D;&#x000A;NumLayers = PDSCH_PortNum;&#x000D;&#x000A;&#x000D;&#x000A;local_PDSCH_PortList = [];&#x000D;&#x000A;for i = 1: NumBWPs&#x000D;&#x000A;&#x0009;local_PDSCH_PortList = [local_PDSCH_PortList, cell2mat(PDSCH_PortList{i})];&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if length(BWP_RBOffset) ~= length(BWP_NumRBs)&#x000D;&#x000A;error(&apos;The element number in BWP_RBOffset and BWP_NumRBs should be the same.&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if (length(BWP_RBOffset) ~= NumBWPs&amp;&amp;length(BWP_RBOffset) ~= 1)&#x000D;&#x000A;error(&apos;The element number in BWP_RBOffset should be equal to 1 or NumBWPs.&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;for i=1:length(BWP_NumRBs)&#x000D;&#x000A;if( BWP_NumRBs(i) &gt;275)&#x000D;&#x000A;error(&apos;BWP_NumRBs should be in range [20,275]&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;for i=1:length(BWP_NumRBs)&#x000D;&#x000A;if(BWP_RBOffset(i)+BWP_NumRBs(i) &gt; CarrierNumRBs)&#x000D;&#x000A;error(&apos;BWP is out of CC, please check BWP_RBOffset and BWP_NumRBs!!&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x0009;if(PDSCH_Enable)&#x000D;&#x000A;&#x0009;&#x0009;if(N_GridStart&gt; BWP_RBOffset(i))&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;error(&apos;BWP_RBOffset should be no less than N_GridStart of this numerology!!&apos;);&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if(PDCCH_Enable)&#x000D;&#x000A;if CORESET_NumSyms &gt; 3&#x000D;&#x000A;error(&apos;PDCCH_NumSyms should be less than or equal to 3.&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if(PDSCH_Enable)&#x000D;&#x000A;if (length(PDSCH_RBOffset) ~= length(PDSCH_NumRBs))&#x000D;&#x000A;%error(&apos;The element number in PDSCH_RBOffset and PDSCH_NumRBs should be the same.&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;for i = 1:length(PDSCH_RBOffset)&#x000D;&#x000A;&#x0009;if (PDSCH_RBOffset(i) + PDSCH_NumRBs(i)) &gt; BWP_NumRBs&#x000D;&#x000A;&#x0009;%error(&apos;PDSCH %d is out of BWP. Please check PDSCH_RBOffset and PDSCH_NumRBs.&apos;, i);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if (length(PDSCH_StartOFDMSym) ~= length(PDSCH_NumOFDMSyms))&#x000D;&#x000A;error(&apos;The element number in PDSCH_StartOFDMSym and PDSCH_NumOFDMSyms should be the same.&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;for i = 1:length(PDSCH_StartOFDMSym)&#x000D;&#x000A;&#x0009;if (PDSCH_StartOFDMSym(i) + PDSCH_NumOFDMSyms(i)) &gt; 14&#x000D;&#x000A;&#x0009;error(&apos;PDSCH %d is out of slot. Please check PDSCH_StartOFDMSym and PDSCH_NumOFDMSyms.&apos;, i);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if (length(PDSCH_StartOFDMSym) ~= length(PDSCH_DMRS_Length))&#x000D;&#x000A;error(&apos;The element number in PDSCH_StartOFDMSym and PDSCH_DMRS_Length should be the same.&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if (length(PDSCH_StartOFDMSym) ~= length(PDSCH_DMRS_AddPos))&#x000D;&#x000A;error(&apos;The element number in PDSCH_StartOFDMSym and PDSCH_DMRS_AddPos should be the same.&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;for i = 1:length(PDSCH_StartOFDMSym)&#x000D;&#x000A;&#x0009;if (PDSCH_DMRS_Length(i) ~= 1 &amp;&amp; PDSCH_DMRS_Length(i) ~= 2)&#x000D;&#x000A;&#x0009;&#x0009;error(&apos;PDSCH_DMRS_Length %d should be in the range of 1~2&apos;, i);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if PDSCH_MappingType == 0&#x000D;&#x000A;&#x0009;for i = 1:length(PDSCH_StartOFDMSym)&#x000D;&#x000A;&#x0009;&#x0009;DurationOFDMSym = PDSCH_StartOFDMSym(i) + PDSCH_NumOFDMSyms(i);&#x000D;&#x000A;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;if PDSCH_DMRS_TypeA_Pos(i) == 3 &#x000D;&#x000A;&#x0009;&#x0009;&#x0009;if PDSCH_DMRS_AddPos(i) == 3&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;error(&apos;For PDSCH_MappingType 0, the case PDSCH_DMRS_AddPos equal to 3 is only supported when PDSCH_DMRS_TypeA_Pos is equal to 2.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;if DurationOFDMSym == 4 || DurationOFDMSym == 3&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;error(&apos;Duration of 3 or 4 symbols is only applicable for PDSCH_DMRS_TypeA_Pos equals 2&apos;, i);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;if PDSCH_DMRS_Length(i) == 2&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;if PDSCH_DMRS_AddPos(i) &gt; 1&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;error(&apos;PDSCH_DMRS_AddPos %d should be 0 or 1&apos;, i);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;for i = 1:length(PDSCH_DMRS_AddPos)&#x000D;&#x000A;&#x0009;&#x0009;DurationOFDMSym = PDSCH_NumOFDMSyms(i);&#x000D;&#x000A;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;if PDSCH_DMRS_Length(i) == 1&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;if DurationOFDMSym == 2 || DurationOFDMSym == 4 || DurationOFDMSym ==6 || DurationOFDMSym == 7&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;if (PDSCH_DMRS_AddPos(i) &gt; 1)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;error(&apos;PDSCH_DMRS_AddPos %d should be 0 or 1 for PDSCH mapping type B.&apos;, i);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;else&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;if DurationOFDMSym ==6 || DurationOFDMSym == 7&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;if (PDSCH_DMRS_AddPos(i) &gt; 1)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;error(&apos;PDSCH_DMRS_AddPos %d should be 0 or 1 for PDSCH mapping type B.&apos;, i);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if (SSB_Enable ==1&amp;&amp;((SSB_Lmax==0||SSB_Lmax==1)&amp;&amp;(Numerology ==3||Numerology ==4)))&#x000D;&#x000A;error(&apos;SSB_Lmax should be 2:L=64 in Numerology 3 and Numerology 4.&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if(SSB_Enable ==1&amp;&amp;(SSB_Lmax==2&amp;&amp;(Numerology ==0||Numerology ==1)))&#x000D;&#x000A;error(&apos;SSB_Lmax should not be 2:L=64 in Numerology 0 and Numerology 1.&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if(SSB_Enable ==1&amp;&amp;Numerology ==2)&#x000D;&#x000A;error(&apos;SSB should be disable in Numerology 2.&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if(SSB_Enable ==1&amp;&amp;Numerology ==4)&#x000D;&#x000A;error(&apos;SSB in 240kHz is not supported now.&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if Payload_Config == 0 %MCS&#x000D;&#x000A;&#x0009;for i = 1:length(MCSTable)&#x000D;&#x000A;&#x0009;&#x0009;if MCSTable(i) &lt; 0 || MCSTable(i) &gt; 2&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;error(&apos;MCSTable should be select from 0: Table 5.1.3.1 - 1 | 1: Table 5.1.3.1 - 2 | 2: Table 5.1.3.1 - 3.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;%%%% 240kHz is not included&#x000D;&#x000A;SSB_FreqShift = 0;&#x000D;&#x000A;SSB_SubcOffset =0;&#x000D;&#x000A;if(SSB_Enable == 1)&#x000D;&#x000A;&#x0009;if Numerology == 0&#x000D;&#x000A;&#x0009;&#x0009;SSB_SubcOffset = SSB_RBOffset*G_RE_per_RB + SSB_k0;&#x000D;&#x000A;&#x0009;&#x0009;SSB_FreqShift = 0;&#x000D;&#x000A;&#x0009;&#x0009;SSB_RBOffset_Numerology = SSB_RBOffset;&#x000D;&#x000A;&#x0009;elseif&#x0009;Numerology == 1&#x000D;&#x000A;&#x0009;&#x0009;SSB_SubcOffset = SSB_RBOffset*(G_RE_per_RB/2) + floor(SSB_k0/2);&#x000D;&#x000A;&#x0009;&#x0009;SSB_FreqShift = mod(SSB_k0,2)*0.5;&#x000D;&#x000A;&#x0009;&#x0009;SSB_RBOffset_Numerology = SSB_RBOffset/2;&#x000D;&#x000A;&#x0009;else %% currently, only 120kHz (mu==3) is supported&#x000D;&#x000A;&#x0009;&#x0009;if&#x0009;SubCarrierSpacingCommon == 2&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;SSB_SubcOffset = SSB_RBOffset*(G_RE_per_RB/2) + floor(SSB_k0/2);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;SSB_FreqShift = mod(SSB_k0,2)*0.5;&#x000D;&#x000A;&#x0009;&#x0009;else %% SubCarrierSpacingCommon == 3&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;SSB_SubcOffset = SSB_RBOffset*(G_RE_per_RB/2) + SSB_k0;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;SSB_FreqShift = 0;&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;SSB_RBOffset_Numerology = SSB_RBOffset/2;&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x0009;if(N_GridStart&gt;SSB_RBOffset_Numerology)&#x000D;&#x000A;&#x0009;&#x0009;error(&apos;SSB_RBOffset should be no less than N_GridStart of this numerology!!&apos;);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x0009;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;t_BWP_Loc = [];&#x000D;&#x000A;t_BWP_NumRBs=[];&#x000D;&#x000A;FreqShift =[];&#x000D;&#x000A;for i=1:length(local_PDSCH_DMRS_NumPorts)&#x000D;&#x000A;&#x0009;for j = 1:local_PDSCH_DMRS_NumPorts(i)&#x000D;&#x000A;&#x0009;&#x0009;t_BWP_Loc = [t_BWP_Loc,BWP_RBOffset(mod(i-1,length(BWP_RBOffset))+1)*G_RE_per_RB];&#x000D;&#x000A;&#x0009;&#x0009;t_BWP_NumRBs = [t_BWP_NumRBs,BWP_NumRBs(mod(i-1,length(BWP_NumRBs))+1)];&#x000D;&#x000A;&#x0009;&#x0009;FreqShift =[FreqShift,0];&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if(SSB_Enable)&#x000D;&#x000A;SSB_NumRBs =20;&#x000D;&#x000A;else&#x000D;&#x000A;SSB_NumRBs = 0;&#x000D;&#x000A;end&#x000D;&#x000A;NumPorts = sum(local_PDSCH_DMRS_NumPorts)+1;&#x000D;&#x000A;t_BWP_Loc = [t_BWP_Loc, SSB_SubcOffset];&#x000D;&#x000A;t_BWP_NumRBs = [t_BWP_NumRBs, SSB_NumRBs];&#x000D;&#x000A;FreqShift =[FreqShift,SSB_FreqShift];&#x000D;&#x000A;&#x000D;&#x000A;if SSB_Enable~=0 &amp;&amp; Numerology == 2&#x000D;&#x000A;&#x0009;error(&apos;SSB_Enable should be disabled when 60 kHz is configured&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if SSB_Enable~=0 &amp;&amp; Numerology == 4&#x000D;&#x000A;&#x0009;error(&apos;SSB transmission transmission in 240 kHz subcarriers is not supported yet&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;for i=1:length(Modulation)&#x000D;&#x000A;                if Modulation(i) == 0&#x000D;&#x000A;                                error(&apos;BPSK is not allowed by downlink.&apos;);&#x000D;&#x000A;                end&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;for i=1:length(PDSCH_DMRS_NumPorts)&#x000D;&#x000A;if(PDSCH_DMRS_NumPorts&gt;4)&#x000D;&#x000A;&#x0009;NumCWs = 2;&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;NumCWs = 1;&#x000D;&#x000A;end&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;%%%%%%%%%%%%%%%%%post info about code rate&#x000D;&#x000A;%if Payload_Config == 1&#x000D;&#x000A;%&#x0009;for i = 0:NumBWPs-1&#x000D;&#x000A;%&#x0009;&#x0009;if(PDSCH_DMRS_ConfigType(mod(i,length(PDSCH_DMRS_ConfigType))+1)==0)&#x000D;&#x000A;%&#x0009;&#x0009;&#x0009;SubcRate = 0.5;&#x000D;&#x000A;%&#x0009;&#x0009;else&#x000D;&#x000A;%&#x0009;&#x0009;&#x0009;SubcRate = 1/3;&#x000D;&#x000A;%&#x0009;&#x0009;end&#x000D;&#x000A;%&#x0009;&#x0009;if(PDSCH_DMRS_Length(mod(i,length(PDSCH_DMRS_Length))+1)==1)&#x000D;&#x000A;%&#x0009;&#x0009;&#x0009;NumDMRSSyms = PDSCH_DMRS_AddPos(mod(i,length(PDSCH_DMRS_AddPos))+1) +1;&#x000D;&#x000A;%&#x0009;&#x0009;else&#x000D;&#x000A;%&#x0009;&#x0009;&#x0009;NumDMRSSyms = (PDSCH_DMRS_AddPos(mod(i,length(PDSCH_DMRS_AddPos))+1) +1)*2;&#x000D;&#x000A;%&#x0009;&#x0009;end&#x000D;&#x000A;%&#x0009;&#x0009;switch(Modulation(mod(i,length(Modulation))+1))&#x000D;&#x000A;%&#x0009;&#x0009;case 0 &#x000D;&#x000A;%&#x0009;&#x0009;&#x0009;Sym2Bits = 1;&#x000D;&#x000A;%&#x0009;&#x0009;case 1 &#x000D;&#x000A;%&#x0009;&#x0009;&#x0009;Sym2Bits = 2;&#x000D;&#x000A;%&#x0009;&#x0009;case 2 &#x000D;&#x000A;%&#x0009;&#x0009;&#x0009;Sym2Bits = 4;&#x000D;&#x000A;%&#x0009;&#x0009;case 3 &#x000D;&#x000A;%&#x0009;&#x0009;&#x0009;Sym2Bits = 6;&#x000D;&#x000A;%&#x0009;&#x0009;case 4 &#x000D;&#x000A;%&#x0009;&#x0009;&#x0009;Sym2Bits = 8;&#x000D;&#x000A;%&#x0009;&#x0009;otherwise&#x000D;&#x000A;%&#x0009;&#x0009;&#x0009;Sym2Bits = 2;&#x000D;&#x000A;%&#x0009;&#x0009;end&#x000D;&#x000A;%&#x0009;&#x0009;UncodedBits = (PDSCH_NumRBs(mod(i,length(PDSCH_NumRBs))+1)*PDSCH_NumOFDMSyms(mod(i,length(PDSCH_NumOFDMSyms))+1)*12-PDSCH_NumRBs(mod(i,length(PDSCH_NumRBs))+1)*12*SubcRate*NumDMRSSyms)*Sym2Bits;&#x000D;&#x000A;%&#x0009;&#x0009;CodeRate = Payload(mod(i,length(Payload))+1)/UncodedBits;&#x000D;&#x000A;%&#x0009;&#x0009;postinfo([&apos;The TBS for BWP&apos; num2str(i+1) &apos; of Numerology &apos; num2str(Numerology) &apos; (&apos; num2str(SCS) &apos;kHz) is &apos; num2str(Payload(mod(i,length(Payload))+1)) &apos;, the uncoded bits is &apos; num2str(UncodedBits) &apos;, and the code rate is &apos; num2str(CodeRate) &apos;.&apos;]);&#x000D;&#x000A;%&#x0009;end&#x000D;&#x000A;%end&#x000D;&#x000A;&#x000D;&#x000A;%%%%%%%%%%%%Post error if Numerology_k0 is out of FFTSize&#x000D;&#x000A;if((abs(Numerology_k0) &gt; (FFTSize -CarrierNumRBs*G_RE_per_RB)/2))%%%%%||N_GridStart&gt;(FFTSize -CarrierNumRBs*G_RE_per_RB)/2+Numerology_k0)&#x000D;&#x000A;&#x0009;error(&apos;Common resource block is out of FFTSize, please check N_GridStart or Numerology_k0.&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;%%%%%%%%%%%%%%%%%% for test model%%%%%%%%%%%&#x000D;&#x000A;NumCCEs = length(find(CORESET_RB_Bitmap ==1));&#x000D;&#x000A;DataPattern = NumCCEs*6*9*2; %%%%1(# of PDCCH) * 1(# of CCE per PDCCH) * 6(REG per CCE) * 9(data RE per REG) * 2(bits per RE)</Text>
