<ParamOrder><T>Array_BString</T><D>1;26;FCarrier_In;FCarrier_Out;SignalPower;MirrorSignal;GainImbalance;PhaseImbalance;I_OriginOffset;Q_OriginOffset;IQ_Rotation;Bandwidth;OversamplingOption;NR_Fc;Numerology;UseTestModel;TestModel;DuplexType;SSB_Enable;SSB_RBOffset;SSB_Lmax;PDSCH_Enable;PDSCH_RBOffset;PDSCH_NumRBs;Modulation;EnableTxFilter;FIR_Taps;NumSubframes</D></ParamOrder>
<Item XName="Bandwidth" Type="PartParam">
<DataEntry>7</DataEntry>
<Description>bandwidth</Description>
<Enum>NR_VSA_Gen__BandWidth@5G Advanced Modem Enums</Enum>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="DuplexType" Type="PartParam">
<DataEntry>1</DataEntry>
<Description>duplex type (valid only when UseTestModel is YES)</Description>
<Enum>NR_TestModel_DuplexType@5G Advanced Modem Enums</Enum>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="EnableTxFilter" Type="PartParam">
<DataEntry>1</DataEntry>
<Description>whether enable the Tx spectrum shaping filter (an Ideal Lowpass FIR filter) or not</Description>
<Enum>NR_MuxSlot__PhaseRotation_Enable@5G Advanced Modem Enums</Enum>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="FCarrier_In" Type="PartParam">
<DataEntry>2e9</DataEntry>
<Description>carrier frequency of the input signal to DUT; Range: (0:Inf)</Description>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="FCarrier_Out" Type="PartParam">
<DataEntry>2e9</DataEntry>
<Description>carrier frequency of the output signal from DUT; Range: (0:Inf)</Description>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="FIR_Taps" Type="PartParam">
<DataEntry>51</DataEntry>
<Description>number of taps of the ideal lowpass filter; Range: [1:1000] (valid only when EnableTxFilter is YES)</Description>
<Enum />
<Validate><T>Int</T><D>11</D></Validate></Item>
<Item XName="GainImbalance" Type="PartParam">
<DataEntry>0.0</DataEntry>
<Description>gain imbalance in dB; Range: (-Inf:+Inf)</Description>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="IQ_Rotation" Type="PartParam">
<DataEntry>0.0</DataEntry>
<Description>IQ rotation; Range: (-Inf:+Inf). In ADS, this parameter is in unit of Radian.</Description>
<Unit><T>Int</T><D>8001</D></Unit>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="I_OriginOffset" Type="PartParam">
<DataEntry>0.0</DataEntry>
<Description>I origin offset; Range: (-Inf:+Inf)</Description>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="MirrorSignal" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>mirror signal about carrier</Description>
<Enum>Modulator__MirrorSignal@Data Flow Enums</Enum>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="Modulation" Type="PartParam">
<DataEntry>2</DataEntry>
<Description>the modulation orders in each slot (1: QPSK; 2:16QAM; 3: 64QAM; 4:256QAM) (valid only when UseTestModel is NO)</Description>
<Enum />
<Validate><T>Int</T><D>11</D></Validate></Item>
<Item XName="NR_Fc" Type="PartParam">
<DataEntry>2e9</DataEntry>
<Description>carrier center frequency for the NR signal to be generated. It&apos;s the frequency determine NR operating on FR1 or FR2.</Description>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="NumSubframes" Type="PartParam">
<DataEntry>1</DataEntry>
<Description>number of subframe to run</Description>
<Enum />
<Unit><T>Int</T><D>0</D></Unit>
<Validate><T>Int</T><D>11</D></Validate></Item>
<Item XName="Numerology" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>numerology</Description>
<Enum>NR_Numerology@5G Advanced Modem Enums</Enum>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="OversamplingOption" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>oversampling option</Description>
<Enum>NR_DL_FrameSync__OversampleOption@5G Advanced Modem Enums</Enum>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="PDSCH_Enable" Type="PartParam">
<DataEntry>1</DataEntry>
<Description>enable or disable PDSCH and its DMRS transmission (valid only when UseTestModel is NO)</Description>
<Enum>NR_DL_EVM__PDSCH_Enable@5G Advanced Modem Enums</Enum>
