];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;PDSCH_DMRS_PowerBoosting = PDSCH_PowerBoosting;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;  end&#x000D;&#x000A;&#x0009;&#x0009;&#x0009; end&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;if(DuplexType == 1)%FDD&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;NumBWPs = 3;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;Modulation = [Modulation, 1];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDSCH_n_RNTI = [PDSCH_n_RNTI, 2];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;CORESET_NumSyms = [0,0,2];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDCCH_DMRS_PowerBoosting =[0];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDCCH_PowerBoosting =[0];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDCCH_NumAllocatedSlots = [10*2^Numerology];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDCCH_AllocatedSlots =[0:10*2^Numerology-1];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDSCH_NumAllocatedSlots = [10*2^Numerology];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDSCH_AllocatedSlots =[0:10*2^Numerology-1];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDSCH_StartOFDMSym = [0,0,2];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDSCH_NumOFDMSyms =[14,14,12];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDSCH_DMRS_Length_t = PDSCH_DMRS_Length;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDSCH_DMRS_AddPos_t = PDSCH_DMRS_AddPos;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDSCH_DMRS_TypeA_Pos_t = PDSCH_DMRS_TypeA_Pos;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDSCH_RA_Type0Bitmap = [PDSCH_RA_Type0Bitmap, 1, 1]; %The ending 1,1 is for PDSCH with nRNTI=2&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDSCH_PowerBoosting = [PDSCH_PowerBoosting, 0];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDSCH_DMRS_PowerBoosting = PDSCH_PowerBoosting;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;BWP_RBOffset= [3,3,0];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;BWP_NumRBs= [CarrierNumRBs-3,CarrierNumRBs-3,3]; %6 is the min of REG&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;for i=1:NumBWPs&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDSCH_DMRS_Length(i) = PDSCH_DMRS_Length_t(mod(i-1,length(PDSCH_DMRS_Length_t))+1);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDSCH_DMRS_AddPos(i) = PDSCH_DMRS_AddPos_t(mod(i-1,length(PDSCH_DMRS_AddPos_t))+1);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDSCH_DMRS_TypeA_Pos(i) = PDSCH_DMRS_TypeA_Pos_t(mod(i-1,length(PDSCH_DMRS_TypeA_Pos_t))+1);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;%BWP_NumRBs(i)= BWP_NumRBs_t(mod(i-1,length(BWP_NumRBs_t))+1);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;%BWP_RBOffset(i)= BWP_RBOffset_t(mod(i-1,length(BWP_RBOffset_t))+1);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;else&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDSCH_RA_Type0Bitmap =[PDSCH_RA_Type0Bitmap,PDSCH_RA_Type0Bitmap];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDSCH_PowerBoosting = [PDSCH_PowerBoosting,PDSCH_PowerBoosting];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDSCH_DMRS_PowerBoosting = PDSCH_PowerBoosting;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;switch(Numerology)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;case 0&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDCCH_NumAllocatedSlots = [6,6,2,2,6,2];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDCCH_AllocatedSlots =[0:2,5:7,0:2,5:7,3,8,3,8, 0:2,5:7,3,8];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDSCH_NumAllocatedSlots = [6,6,2,2,6,2];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDSCH_AllocatedSlots =[0:2,5:7,0:2,5:7,3,8,3,8, 0:2,5:7,3,8];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDSCH_StartOFDMSym = [0,0,0,0, 2,2];&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDSCH_NumOFDMSyms =[14,14,10,10,12,8 ];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;case 1&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDCCH_NumAllocatedSlots = [14,14,2,2, 14,2];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDCCH_AllocatedSlots =[0:6,10:16,0:6,10:16,7,17,7,17, 0:6,10:16,7,17];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;P