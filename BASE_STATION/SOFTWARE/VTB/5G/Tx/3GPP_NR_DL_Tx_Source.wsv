<Item XName="P1" Type="PartPin">
<Direction><T>Int</T><D>1</D></Direction>
<PartID>NR_DL_Numerology_Src_1</PartID>
<PinName>SSB_Out</PinName>
<SchObject>Part4</SchObject>
<TermNum>2</TermNum>
<Item XName="Subterminals" Type="SerItem">
<Item XName="T1" Type="SubTerm">
<NetName>31</NetName></Item></Item></Item></Item></Item>
<Item XName="Equations" Type="Equation">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>%%%%%%%%%%%%%%%%%%%%%%%%%% range check %%%%%%%%%%%%%%%%%%%%%%%%%%%%&#x000D;&#x000A;if ((NR_Fc &gt;= 410e6) &amp;&amp; (NR_Fc &lt;= 7.125e9))&#x000D;&#x000A;&#x0009;FrequencyRange = 0;&#x000D;&#x000A;elseif ((NR_Fc &gt;= 24.25e9) &amp;&amp; (NR_Fc &lt;= 52.6e9))&#x000D;&#x000A;&#x0009;FrequencyRange = 1;&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;error(&apos;NR_Fc is not in the legit range: {FR1: 410 MHz ~ 7125 MHz} or {FR2: 24250 MHz ~ 52600 MHz}&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if(FrequencyRange ==0&amp;&amp;Numerology&gt;2)&#x000D;&#x000A;&#x0009;error(&apos;Numerology 120kHz and 240kHz are not supported in FR1(410MHz &lt; NR_Fc &lt; 7125MHz)&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;if(FrequencyRange ==1&amp;&amp;Numerology&lt;2)&#x000D;&#x000A;&#x0009;error(&apos;Numerology 15kHz and 30kHz are not supported in FR2(24250MHz &lt; NR_Fc &lt; 52600MHz)&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if (FrequencyRange==0)&#x000D;&#x000A;&#x0009;switch Numerology&#x000D;&#x000A;&#x0009;case 0&#x000D;&#x000A;&#x0009;&#x0009;if (Bandwidth &gt; 7)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;error(&apos;Bandwidth should not be wider than 50MHz for Numerolgoy 0(15kHz) in FR1(410MHz &lt; NR_Fc &lt; 7125MHz)&apos;);&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;case 1&#x000D;&#x000A;&#x0009;&#x0009;if (Bandwidth &gt; 12)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;error(&apos;Bandwidth should not be wider than 100MHz for Numerolgoy 1(30kHz) in FR1(410MHz &lt; NR_Fc &lt; 7125MHz)&apos;);&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;case 2&#x000D;&#x000A;&#x0009;&#x0009;if (Bandwidth &gt; 12)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;error(&apos;Bandwidth should not be wider than 100MHz for Numerolgoy 2(60kHz) in FR1(410MHz &lt; NR_Fc &lt; 7125MHz)&apos;);&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;if (Bandwidth &lt; 1)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;error(&apos;Bandwidth should not be less than 10MHz for Numerolgoy 2(60kHz) in FR1(410MHz &lt; NR_Fc &lt; 7125MHz)&apos;);&#x000D;&#x000A;&#x0009;&#x0009;end&#x0009;&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;if (Bandwidth ~= 7 &amp;&amp; Bandwidth &lt; 12)&#x000D;&#x000A;&#x0009;&#x0009;error(&apos;Bandwidth should be 50MHz, 100MHz, 200MHz or 400MHz in FR2(24250MHz &lt; NR_Fc &lt; 52600MHz)&apos;);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;if (Bandwidth == 14 &amp;&amp; Numerology ==2)&#x000D;&#x000A;&#x0009;&#x0009;error(&apos;Bandwidth should be less than 400MHz for Numerolgoy 2(60kHz) in FR2(24250MHz &lt; FCarrier_Out &lt; 52600MHz)&apos;);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if NumSubframes &lt; 1&#x000D;&#x000A;&#x0009;error(&apos;NumSubframes could not be less than 1.&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;FR1NumRBsTable=[25,52,79,106,133,160,216,270,0,0,0,0,0;&#x000D;&#x000A;&#x0009;&#x0009;11,24,38,51,65,78,106,133,162,189,217,245,273;&#x000D;&#x000A;&#x0009;&#x0009;0,11,18,24,31,38,51,65,79,93,107,121,135];&#x000D;&#x000A;FR2NumRBsTable=[66,132,264,0;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;32,66,132,264;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;17,34,69,138];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;if(FrequencyRange ==0)&#x000D;&#x000A;&#x0009;CarrierNumRBs = FR1NumRBsTable(Numerology+1,Bandwidth+1);&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;if(Bandwidth&lt;10)&#x000D;&#x000A;&#x0009;&#x0009;NumRBsIdx = 1;&#x000D;&#x000A;&#x0009;else&#x000D;&#x000A;&#x0009;&#x0009;NumRBsIdx = Bandwidth-10;&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x0009;CarrierNumRBs = FR2NumRBsTable(Numerology-1,NumRBsIdx);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if(UseTestModel ==0)&#x000D;&#x000A;&#x0009;if SSB_Enable == 0 &amp;&amp; PDSCH_Enable == 0&#x000D;&#x000A;&#x0009;&#x0009;error(&apos;At least one of SSB_Enable and PDSCH_Enable should be enabled. Otherwise, no signal is generated!&apos;)&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x0009;&#x000D;&#x000A;&#x0009;if(Numerology ==2 &amp;&amp; SSB_Enable ==1)&#x000D;&#x000A;&#x0009;&#x0009;error(&apos;SSB should be disabled when numerology is 60kHz!&apos;)&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;if SSB_Enable&#x000D;&#x000A;&#x0009;&#x0009;if SSB_RBOffset &lt; 0 || SSB_RBOffset &gt; (CarrierNumRBs -20)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;error(&apos;SSB_RBOffset should be in the range of [0~%d]. &apos;, (CarrierNumRBs -20));&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;if Numerology &lt; 2&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;if SSB_Lmax == 2&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;error(&apos;SSB_Lmax should be 4 or 8.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;else&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;if SSB_Lmax &lt; 2&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;error(&apos;SSB_Lmax should be 64.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;if PDSCH_Enable&#x000D;&#x000A;&#x0009;&#x0009;if(PDSCH_RBOffset&lt; 0 || PDSCH_RBOffset &gt;= CarrierNumRBs)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;error(&apos;PPDSCH_RBOffset should be in the range of [0~%d].&apos;, CarrierNumRBs-1);&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;if(PDSCH_NumRBs &lt; 1 || PDSCH_NumRBs &gt; CarrierNumRBs)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;error(&apos;PDSCH_NumRBs should be in the range of [1~%d].&apos;, CarrierNumRBs);&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;&#x0009;if(PDSCH_RBOffset+PDSCH_NumRBs &gt; CarrierNumRBs)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;error(&apos;PDSCH_RBOffset+PDSCH_NumRBs should not be greater than %d.&apos;, CarrierNumRBs);&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x0009;&#x000D;&#x000A;&#x0009;if Modulation &lt; 1 || Modulation &gt; 4&#x000D;&#x000A;&#x0009;&#x0009;error(&apos;Modulation should be in the range of 1~4.&apos;, CarrierNumRBs);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;%%%%%%%%%%%%%%%%%%%%%%%%%% range check end%%%%%%%%%%%%%%%%%%%%%%%%%%%%&#x000D;&#x000A;&#x000D;&#x000A;BandwidthTable =[5e6,10e6,15e6,20e6,25e6,30e6,40e6,50e6,60e6,70e6,80e6,90e6,100e6,200e6,400e6];&#x000D;&#x000A;SamplingRate = 2.^ceil(log2(BandwidthTable(Bandwidth+1)/15e3))*2^(OversamplingOption)*15e3;&#x000D;&#x000A;&#x000D;&#x000A;BlockSize = 0.001*SamplingRate;&#x000D;&#x000A;&#x000D;&#x000A;if(UseTestModel==0)&#x000D;&#x000A;&#x0009;if(Numerology ==2 &amp;&amp; SSB_Enable ==1)&#x000D;&#x000A;&#x0009;&#x0009;error(&apos;SSB should be disabled when numerology is 60kHz!&apos;)&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;SSB_RBOffset_EVM = SSB_RBOffset;&#x000D;&#x000A;&#x000D;&#x000A;EPRE=10*log10(SignalPower*1e3) -10*log10(PDSCH_NumRBs*12*2^Numerology);&#x000D;&#x000A;&#x000D;&#x000A;L_Table = [4, 8, 64];&#x000D;&#x000A;Num_SSB = L_Table(SSB_Lmax + 1);&#x000D;&#x000A;ActiveSSB = [0:Num_SSB-1];&#x000D;&#x000A;&#x000D;&#x000A;%%%%%%%%%%%about number of subframes&#x000D;&#x000A;%%%%subframe case&#x000D;&#x000A;if(NumSubframes&lt;10)&#x000D;&#x000A;&#x0009;if(NumSubframes &gt;1 &amp;&amp;NumSubframes&lt;10)&#x000D;&#x000A;&#x0009;&#x0009;warning(&apos;NumSubframes more than 1 and less than 10 is not supported now, NumSubframes is set to 1 in this simulation.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;NumSubframes = 1;&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x0009;NumSlotsPerRun = 1 * 2^Numerology;&#x000D;&#x000A;&#x0009;ActiveSlots = [0:NumSlotsPerRun*NumSubframes-1];&#x0009;&#x000D;&#x000A;&#x0009;SimTime = 1e-3;&#x0009;&#x000D;&#x000A;end&#x000D;&#x000A;%%%%%%% frame case&#x000D;&#x000A;if(NumSubframes &gt;9)&#x000D;&#x000A;&#x0009;TimesToRun = floor(NumSubframes/10 +0.5);&#x0009;&#x000D;&#x000A;&#x0009;NumSlotsPerRun = 10 * 2^Numerology;&#x000D;&#x000A;&#x0009;ActiveSlots = [0:NumSlotsPerRun-1];&#x000D;&#x000A;&#x0009;SimTime = 10e-3;&#x0009;&#x000D;&#x000A;end&#x000D;&#x000A;NumPorts =2;&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;%%%%%%%%%%%%%%%%%%%for test model&#x000D;&#x000A;%%%%calculate CarrierNumRBs&#x000D;&#x000A;if(UseTestModel)&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;if(DuplexType==1&amp;&amp;TestModel&gt;7)&#x000D;&#x000A;&#x0009;&#x0009;error(&apos;FDD is not supported for TestModel 8:NR-FR2-TM1.1, 9:NR-FR2-TM2 and 10:NR-FR2-TM3.1.&apos;);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;if(Numerology==4)&#x000D;&#x000A;&#x0009;&#x0009;error(&apos;Numrology 240kHz is invalid for Test Model.&apos;);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x0009;&#x000D;&#x000A;&#x0009;FR1NumRBsTable=[25,52,79,106,133,160,216,270,0,0,0,0,0;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;11,24,38,51,65,78,106,133,162,189,217,245,273;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;0,11,18,24,31,38,51,65,79,93,107,121,135];&#x000D;&#x000A;&#x0009;FR2NumRBsTable=[66,132,264,0;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;32,66,132,264;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;17,34,69,138];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;if(FCarrier_In &lt;=7.125e9)&#x000D;&#x000A;&#x0009;&#x0009;CarrierNumRBs = FR1NumRBsTable(Numerology+1,Bandwidth+1);&#x000D;&#x000A;&#x0009;else&#x000D;&#x000A;&#x0009;&#x0009;if(Bandwidth&lt;10)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;NumRBsIdx = 1;&#x000D;&#x000A;&#x0009;&#x0009;else&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;NumRBsIdx = Bandwidth-10;&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;CarrierNumRBs = FR2NumRBsTable(Numerology-1,NumRBsIdx);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;PDSCH_NumRBs = [CarrierNumRBs,CarrierNumRBs,1,1,CarrierNumRBs,CarrierNumRBs,CarrierNumRBs,CarrierNumRBs,CarrierNumRBs,1,CarrierNumRBs];&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;EPRE=10*log10(SignalPower*1e3) -10*log10(PDSCH_NumRBs(TestModel+1)*12*2^Numerology);&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;%%%%%%%%%%%%%%%%define NumPorts&#x000D;&#x000A;&#x0009;%%support all test models&#x000D;&#x000A;&#x0009;PortsTableTDD =[8,12,10,10,8,8,12,12,8,12,8];&#x000D;&#x000A;&#x0009;PortsTableFDD =[4,6,6,6,4,4,6,6];&#x000D;&#x000A;&#x0009;&#x000D;&#x000A;&#x0009;if(DuplexType==1)&#x000D;&#x000A;&#x0009;&#x0009;NumPorts = PortsTableFDD(TestModel+1);&#x0009;&#x000D;&#x000A;&#x0009;else&#x000D;&#x000A;&#x0009;&#x0009;NumPorts = PortsTableTDD(TestModel+1);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x000D;&#x000A;&#x0009;&#x000D;&#x000A;FilterType = 2*EnableTxFilter;&#x000D;&#x000A;</Text>
