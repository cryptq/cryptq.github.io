<NetName>7</NetName></Item></Item></Item></Item></Item>
<Item XName="Equations" Type="Equation">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>BandwidthTable =[5e6,10e6,15e6,20e6,25e6,30e6,40e6,50e6,60e6,70e6,80e6,90e6,100e6,200e6,400e6];&#x000D;&#x000A;SamplingRate = 2.^ceil(log2(BandwidthTable(Bandwidth+1)/15e3))*2^(OversamplingOption)*15e3;&#x000D;&#x000A;&#x000D;&#x000A;%%%%%%%%%%%%%%%%%%%%%%%%%% range check %%%%%%%%%%%%%%%%%%%%%%%%%%%%&#x000D;&#x000A;if ((NR_Fc &gt;= 450e6) &amp;&amp; (NR_Fc &lt;= 6e9))&#x000D;&#x000A;&#x0009;FrequencyRange = 0;&#x000D;&#x000A;elseif ((NR_Fc &gt;= 24.25e9) &amp;&amp; (NR_Fc&lt;= 52.6e9))&#x000D;&#x000A;&#x0009;FrequencyRange = 1;&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;error(&apos;NR_Fc is not in the legit range: {FR1: 450 MHz ~ 6000 MHz} or {FR2: 24250 MHz ~ 52600 MHz}&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if(FrequencyRange ==0&amp;&amp;Numerology&gt;2)&#x000D;&#x000A;error(&apos;Numerology 120kHz and 240kHz are not supported in FR1(450MHz &lt; NR_Fc &lt; 6000MHz)&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;if(FrequencyRange ==1&amp;&amp;Numerology&lt;2)&#x000D;&#x000A;error(&apos;Numerology 15kHz and 30kHz are not supported in FR2(24250MHz &lt; NR_Fc &lt; 52600MHz)&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if (FrequencyRange==0)&#x000D;&#x000A;&#x0009;if Bandwidth == 9&#x000D;&#x000A;&#x0009;&#x0009;error(&apos;Bandwidth 70MHz is not defined for uplink!&apos;);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x0009;&#x000D;&#x000A;&#x0009;switch Numerology&#x000D;&#x000A;&#x0009;case 0&#x000D;&#x000A;&#x0009;&#x0009;if (Bandwidth &gt; 7)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;error(&apos;Bandwidth should not be wider than 50MHz for Numerolgoy 0(15kHz) in FR1(450MHz &lt; NR_Fc &lt; 6000MHz)&apos;);&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;case 1&#x000D;&#x000A;&#x0009;&#x0009;if (Bandwidth &gt; 12)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;error(&apos;Bandwidth should not be wider than 100MHz for Numerolgoy 1(30kHz) in FR1(450MHz &lt; NR_Fc &lt; 6000MHz)&apos;);&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;case 2&#x000D;&#x000A;&#x0009;&#x0009;if (Bandwidth &gt; 12)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;error(&apos;Bandwidth should not be wider than 100MHz for Numerolgoy 2(60kHz) in FR1(450MHz &lt; NR_Fc &lt; 6000MHz)&apos;);&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;if (Bandwidth &lt; 1)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;error(&apos;Bandwidth should not be less than 10MHz for Numerolgoy 2(60kHz) in FR1(450MHz &lt; NR_Fc &lt; 6000MHz)&apos;);&#x000D;&#x000A;&#x0009;&#x0009;end&#x0009;&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;if (Numerology == 4 &amp;&amp; UseCommonConfig == 1)&#x000D;&#x000A;&#x0009;&#x0009;error(&apos;Numerology 4(240kHz) is not defined for Common Config.&apos;);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x0009;&#x000D;&#x000A;&#x0009;if (Bandwidth ~= 7 &amp;&amp; Bandwidth &lt; 12)&#x000D;&#x000A;&#x0009;&#x0009;error(&apos;Bandwidth should be 50MHz, 100MHz, 200MHz or 400MHz in FR2(24250MHz &lt; NR_Fc &lt; 52600MHz)&apos;);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;if (Bandwidth == 14 &amp;&amp; Numerology ==2)&#x000D;&#x000A;&#x0009;&#x0009;error(&apos;Bandwidth should be less than 400MHz for Numerolgoy 2(60kHz) in FR2(24250MHz &lt; NR_Fc &lt; 52600MHz)&apos;);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if UseCommonConfig == 1&#x000D;&#x000A;&#x0009;if FrequencyRange == 0&#x000D;&#x000A;&#x0009;&#x0009;if CommonConfig_FR1 &lt; 0 || CommonConfig_FR1 &gt; 7&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;error(&apos;CommonConfig_FR1 should be in the range 0~ 7&apos;);&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;else&#x000D;&#x000A;&#x0009;&#x0009;if CommonConfig_FR2 &lt; 0 || CommonConfig_FR2 &gt; 5&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;error(&apos;CommonConfig_FR2 should be in the range 0~ 5&apos;);&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if NumSubframes &lt; 1&#x000D;&#x000A;&#x0009;error(&apos;NumSubframes could not be less than 1.&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;FR1NumRBsTable=[25,52,79,106,133,160,216,270,0,0,0,0,0;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;11,24,38,51,65,78,106,133,162,189,217,245,273;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;0,11,18,24,31,38,51,65,79,93,107,121,135];&#x000D;&#x000A;FR2NumRBsTable=[66,132,264,0;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;32,66,132,264;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;17,34,69,138];&#x000D;&#x000A;&#x0009;&#x0009;&#x000D;&#x000A;if(FrequencyRange ==0)&#x000D;&#x000A;&#x0009;CarrierNumRBs = FR1NumRBsTable(Numerology+1,Bandwidth+1);&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;if(Bandwidth&lt;10)&#x000D;&#x000A;&#x0009;&#x0009;NumRBsIdx = 1;&#x000D;&#x000A;&#x0009;else&#x000D;&#x000A;&#x0009;&#x0009;NumRBsIdx = Bandwidth-10;&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x0009;CarrierNumRBs = FR2NumRBsTable(Numerology-1,NumRBsIdx);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if UseCommonConfig == 0&#x000D;&#x000A;&#x0009;if(PUSCH_RBOffset&lt; 0 || PUSCH_RBOffset &gt;= CarrierNumRBs)&#x000D;&#x000A;&#x0009;&#x0009;error(&apos;PUSCH_RBOffset should be in the range of [0~%d].&apos;, CarrierNumRBs-1);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x0009;if(PUSCH_NumRBs &lt; 1 || PUSCH_NumRBs &gt; CarrierNumRBs)&#x000D;&#x000A;&#x0009;&#x0009;error(&apos;PUSCH_NumRBs should be in the range of [1~%d].&apos;, CarrierNumRBs);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;if(PUSCH_RBOffset+PUSCH_NumRBs &gt; CarrierNumRBs)&#x000D;&#x000A;&#x0009;&#x0009;error(&apos;PUSCH_RBOffset+PUSCH_NumRBs should not be greater than %d.&apos;, CarrierNumRBs);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x0009;&#x000D;&#x000A;&#x0009;if Modulation &lt; 0 || Modulation &gt; 4&#x000D;&#x000A;&#x0009;&#x0009;error(&apos;Modulation should be in the range of 0~4.&apos;, CarrierNumRBs);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x0009;&#x000D;&#x000A;&#x0009;if OFDM_Type &lt;0 || OFDM_Type &gt; 1&#x000D;&#x000A;&#x0009;&#x0009;error(&apos;OFDM_Type should be either 0 or 1!&apos;);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if FIR_Taps &lt; 1 &#x000D;&#x000A;&#x0009;error(&apos;FIR_Taps should not less than 1!&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;%%%%%%%%%%%%%%%%%%%%%%%%%% range check end%%%%%%%%%%%%%%%%%%%%%%%%%%%%&#x000D;&#x000A;&#x000D;&#x000A;NumSlots = 10 * 2^Numerology;&#x000D;&#x000A;ActiveSlots = [0:NumSlots-1];&#x000D;&#x000A;&#x000D;&#x000A;if UseCommonConfig == 0&#x000D;&#x000A;&#x0009;CyclicPrefix = 0;&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;BWP_RBOffset = PUSCH_RBOffset;&#x000D;&#x000A;&#x0009;BWP_NumRBs = PUSCH_NumRBs;&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;PUSCH_n_RNTI = [1];&#x000D;&#x000A;&#x0009;PUSCH_n_ID = [0];&#x000D;&#x000A;&#x0009;PUSCH_NumAllocatedSlots = NumSlots;&#x000D;&#x000A;&#x0009;PUSCH_AllocatedSlots = ActiveSlots;&#x000D;&#x000A;&#x0009;PUSCH_StartOFDMSym = [0];&#x000D;&#x000A;&#x0009;PUSCH_NumOFDMSyms = [14];&#x000D;&#x000A;&#x0009;PUSCH_RBOffset = [0];&#x000D;&#x000A;&#x0009;PUSCH_NumRBs = [PUSCH_NumRBs];&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;PUSCH_PowerBoosting = [0];&#x000D;&#x000A;&#x0009;PUSCH_MappingType = [0];&#x000D;&#x000A;&#x0009;PUSCH_DMRS_PowerBoosting = [3];&#x000D;&#x000A;&#x0009;PUSCH_DMRS_Length = [1];&#x000D;&#x000A;&#x0009;PUSCH_DMRS_AddPos = [2];&#x000D;&#x000A;&#x0009;PUSCH_DMRS_ConfigType = [0];&#x000D;&#x000A;&#x0009;PUSCH_DMRS_CDMGroupNum = [2];&#x000D;&#x000A;&#x0009;PUSCH_DMRS_GroupHoppingEnabled = [0];&#x000D;&#x000A;&#x0009;PUSCH_DMRS_TypeA_Pos = [2];&#x000D;&#x000A;&#x0009;PUSCH_DMRS_SequenceHoppingEnabled = [0];&#x000D;&#x000A;&#x0009;PUSCH_DMRS_n_RS_ID = [0];&#x000D;&#x000A;&#x0009;PUSCH_DMRS_n_SCID = [0];&#x000D;&#x000A;&#x0009;PUSCH_DMRS_N_ID = [0];&#x000D;&#x000A;&#x0009;if OFDM_Type == 0&#x000D;&#x000A;&#x0009;TransformPrecodingEnabled = [1];&#x000D;&#x000A;&#x0009;else&#x000D;&#x000A;&#x0009;TransformPrecodingEnabled = [0];&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x0009;&#x000D;&#x000A;&#x0009;if TransformPrecodingEnabled(1) == 1&#x000D;&#x000A;&#x0009;&#x0009;switch Modulation&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;case 0&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;MCSTable = [3];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;MCS = [0];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;case 1&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;MCSTable = [3];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;MCS = [2];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;case 2&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;MCSTable = [3];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;MCS = [10];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;case 3&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;MCSTable = [3];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;MCS = [18];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;case 4&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;MCSTable = [1];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;MCS = [20];&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;else&#x000D;&#x000A;&#x0009;&#x0009;switch Modulation&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;case 0&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;error(&apos;pi/2 BPSK is not supported for CP-OFDM&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;case 1&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;MCSTable = [0];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;MCS = [2];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;case 2&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;MCSTable = [0];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;MCS = [10];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;case 3&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;MCSTable = [0];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;MCS = [19];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;case 4&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;MCSTable = [1];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;MCS = [20];&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x0009;BPSKEnabled = [1];&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;%%%%%%%%%%%%%%%%%%%%%%&#x000D;&#x000A;&#x0009;%common config&#x000D;&#x000A;&#x0009;CyclicPrefix = 0;&#x000D;&#x000A;&#x0009;PUSCH_Enable = 1;&#x000D;&#x000A;&#x0009;PUCCH_Enable = 0;&#x000D;&#x000A;&#x0009;SRS_Enable = 0;&#x000D;&#x000A;&#x0009;PTRS_Enable = 0;&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;BWP_RBOffset = [0];&#x000D;&#x000A;&#x0009;BWP_NumRBs = CarrierNumRBs;&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;PUSCH_n_RNTI = [1];&#x000D;&#x000A;&#x0009;PUSCH_n_ID = [0];&#x000D;&#x000A;&#x0009;PUSCH_DMRS_CDMGroupNum = [2];&#x000D;&#x000A;&#x0009;PUSCH_NumAllocatedSlots = NumSlots;&#x000D;&#x000A;&#x0009;PUSCH_AllocatedSlots = ActiveSlots;&#x000D;&#x000A;&#x0009;PUSCH_StartOFDMSym = [0];&#x000D;&#x000A;&#x0009;PUSCH_NumOFDMSyms = [14];&#x000D;&#x000A;&#x0009;PUSCH_FreqHoppingType = [0];&#x000D;&#x000A;&#x0009;Payload_Config = [0];&#x000D;&#x000A;&#x0009;PUSCH_MappingType = [0];&#x000D;&#x000A;&#x0009;PUSCH_PowerBoosting = [0];&#x000D;&#x000A;&#x0009;PUSCH_DMRS_PowerBoosting = [3];&#x000D;&#x000A;&#x0009;PUSCH_DMRS_Length = [1];&#x000D;&#x000A;&#x0009;PUSCH_DMRS_AddPos = [2];&#x000D;&#x000A;&#x0009;PUSCH_DMRS_ConfigType = [0];&#x000D;&#x000A;&#x0009;PUSCH_DMRS_GroupHoppingEnabled = [0];&#x000D;&#x000A;&#x0009;PUSCH_DMRS_TypeA_Pos = [2];&#x000D;&#x000A;&#x0009;PUSCH_DMRS_SequenceHoppingEnabled = [0];&#x000D;&#x000A;&#x0009;PUSCH_DMRS_n_RS_ID = [0];&#x000D;&#x000A;&#x0009;PUSCH_DMRS_n_SCID = [0];&#x000D;&#x000A;&#x0009;PUSCH_DMRS_N_ID = [0];&#x000D;&#x000A;&#x0009;BPSKEnabled = [1];&#x000D;&#x000A;&#x0009;&#x000D;&#x000A;&#x0009;if OFDM_Type == 0&#x000D;&#x000A;&#x0009;&#x0009;TransformPrecodingEnabled = [1];&#x000D;&#x000A;&#x0009;&#x0009;switch Modulation&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;case 0&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;MCSTable = [3];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;MCS = [0];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;BPSKEnabled = [1];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;case 1&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;MCSTable = [3];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;MCS = [2];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;case 2&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;MCSTable = [3];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;MCS = [10];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;case 3&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;MCSTable = [3];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;MCS = [18];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;case 4&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;MCSTable = [1];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;MCS = [20];&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;else&#x000D;&#x000A;&#x0009;&#x0009;TransformPrecodingEnabled = [0];&#x000D;&#x000A;&#x0009;&#x0009;switch Modulation&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;case 0&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;error(&apos;pi/2 BPSK is not supported for CP-OFDM&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;case 1&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;MCSTable = [0];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;MCS = [2];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;case 2&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;MCSTable = [0];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;MCS = [10];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;case 3&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;MCSTable = [0];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;MCS = [19];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;case 4&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;MCSTable = [1];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;MCS = [20];&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;nRBAll = CarrierNumRBs;&#x000D;&#x000A;&#x0009;if mod(nRBAll,2) == 0&#x000D;&#x000A;&#x0009;&#x0009;nRBHalf = nRBAll / 2;&#x000D;&#x000A;&#x0009;else&#x000D;&#x000A;&#x0009;&#x0009;nRBHalf = floor(nRBAll / 4) * 2 + 1;&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;M_RB = [1, 2, 3, 4, 5, 6, 8, 9, 10, 12, 15, 16, 18, 20, 24, 25, 27, 30, 32, 36, 40, 45, 48, 50, 54, 60, 64, 72, 75, 80, 81, 90, 96, 100, 108, 120, 125, 128, 135, 144, 150, 160, 162, 180, 192, 200, 216, 225, 240, 243, 250, 256, 270, 288 ];&#x000D;&#x000A;&#x0009;M_RB = M_RB(end:-1:1);&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;if(FrequencyRange ==0)&#x000D;&#x000A;&#x0009;&#x0009;switch CommonConfig_FR1&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;case 0&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PUSCH_RBOffset = [0];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PUSCH_NumRBs = [2];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;case 1&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PUSCH_RBOffset = [nRBAll - 2];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PUSCH_NumRBs = [2];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;case 2&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PUSCH_RBOffset = [0];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PUSCH_NumRBs = [1];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;case 3&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PUSCH_RBOffset = [nRBAll - 1];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PUSCH_NumRBs = [1];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;case 4&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PUSCH_RBOffset = [0];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;if OFDM_Type == 0&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;idx = find(M_RB &lt;= nRBAll, 1, &apos;first&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;rbNum = M_RB(idx);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;if (Bandwidth == 11 &amp;&amp; Numerology == 1) % 90MHz 30kHz&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;rbNum = 240;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;PUSCH_NumRBs = [rbNum];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;else&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;PUSCH_NumRBs = [nRBAll];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;case 5&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;if OFDM_Type == 0&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;idx = find(M_RB &lt;= nRBHalf, 1, &apos;first&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;rbNum = M_RB(idx);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;PUSCH_NumRBs = [rbNum];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;else&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;PUSCH_NumRBs = [nRBHalf];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PUSCH_RBOffset = floor(PUSCH_NumRBs / 2);&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;case 6&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PUSCH_RBOffset = [1];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PUSCH_NumRBs = [1];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;case 7&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PUSCH_RBOffset = [nRBAll - 2];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PUSCH_NumRBs = [1];&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;else&#x000D;&#x000A;&#x0009;&#x0009;if Bandwidth == 14 &amp;&amp; Numerology == 2&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;error(&apos;Numerology 60kHz is not defined for bandwidth 400MHz&apos;);&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;switch CommonConfig_FR2&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;case 0&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PUSCH_RBOffset = [0];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;if OFDM_Type == 0&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;idx = find(M_RB &lt;= nRBAll, 1, &apos;first&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;rbNum = M_RB(idx);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;PUSCH_NumRBs = [rbNum];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;else&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;PUSCH_NumRBs = [nRBAll];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;case 1&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PUSCH_RBOffset = [0];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PUSCH_NumRBs = [1];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;case 2&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PUSCH_RBOffset = [nRBAll - 1];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PUSCH_NumRBs = [1];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;case 3&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PUSCH_RBOffset = ceil(nRBAll / 3);&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;numTable = [20, 22, 10, 11; 40, 44, 20, 22; 81, 88, 40, 44; -1, -1, 64, 64];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;BW = Bandwidth - 10;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;if BW &lt; 1&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;BW = 1;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PUSCH_NumRBs = numTable(BW, (Numerology-2)*2+OFDM_Type+1);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;case 4&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PUSCH_RBOffset = ceil(nRBAll / 3);&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PUSCH_NumRBs = 1;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;case 5&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PUSCH_NumRBs = 1;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;offsetTable = [43, 21; 87, 43; 175, 87; -1, 197];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;BW = Bandwidth - 10;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;if BW &lt; 1&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;BW = 1;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PUSCH_RBOffset = offsetTable(BW, (Numerology-2)*2+1);&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;SlotNumber = 1;&#x000D;&#x000A;&#x000D;&#x000A;BlockSize = 0.001*SamplingRate;&#x000D;&#x000A;&#x000D;&#x000A;SubcarrierSpacing = 15e3 * 2^Numerology;&#x000D;&#x000A;SlotTimeInterval = 0.001 / 2^Numerology;&#x000D;&#x000A;WaveformLength = SamplingRate * SlotTimeInterval * SlotNumber;&#x000D;&#x000A;&#x000D;&#x000A;%%%% for ACLR&#x000D;&#x000A;FilterEnable =1;&#x000D;&#x000A;PassFreq = 25e6;&#x000D;&#x000A;StopFreq = 30e6;&#x000D;&#x000A;&#x000D;&#x000A;EPRE = 10*log10(Power*1e3) - 10*log10(PUSCH_NumRBs * 12 * 2^Numerology);%%% dBm/15kHz&#x000D;&#x000A;&#x000D;&#x000A;EvmFilterBandwidth = BandwidthTable(Bandwidth+1);&#x000D;&#x000A;SymbolNum_Table = [14, 12];&#x000D;&#x000A;&#x000D;&#x000A;FilterType = 2*EnableTxFilter;&#x000D;&#x000A;&#x000D;&#x000A;NumToMeas = round(NumSubframes / 10);&#x000D;&#x000A;&#x000D;&#x000A;if NumToMeas == 0&#x000D;&#x000A;&#x0009;if NumSubframes &gt; 1&#x000D;&#x000A;&#x0009;&#x0009;warning(&apos;The actual measured subframes number is 1.&apos;);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x0009;MeasInterval = SymbolNum_Table(CyclicPrefix + 1) * 2^Numerology;&#x000D;&#x000A;&#x0009;ResLenInSubframes = 1;&#x000D;&#x000A;&#x0009;AnalysisBoundary = 2;&#x000D;&#x000A;&#x0009;FramesToMeas = 1;&#x000D;&#x000A;&#x0009;TimeInterval = 1e-3;&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;if (NumSubframes ~= NumToMeas * 10)&#x000D;&#x000A;&#x0009;&#x0009;warning(&apos;The actual measured subframes number is %d.&apos;, NumToMeas * 10);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x0009;MeasInterval = 10*SymbolNum_Table(CyclicPrefix + 1) * 2^Numerology;&#x000D;&#x000A;&#x0009;ResLenInSubframes = 10;&#x000D;&#x000A;&#x0009;AnalysisBoundary = 0;&#x000D;&#x000A;&#x0009;FramesToMeas = NumToMeas;&#x000D;&#x000A;&#x0009;TimeInterval = 10e-3;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if OversamplingOption &gt; 1&#x000D;&#x000A;&#x0009;OversamplingOptionEVM = 1;&#x000D;&#x000A;&#x0009;EnableDownsamp = 0;&#x000D;&#x000A;&#x0009;DownSampFactor = 2^(OversamplingOption - OversamplingOptionEVM);&#x000D;&#x000A;&#x0009;FilterBandwidth = BandwidthTable(Bandwidth+1)*1.25;&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;OversamplingOptionEVM = OversamplingOption;&#x000D;&#x000A;&#x0009;EnableDownsamp = 2;&#x000D;&#x000A;&#x0009;DownSampFactor = 1;&#x000D;&#x000A;&#x0009;FilterBandwidth = BandwidthTable(Bandwidth+1);&#x000D;&#x000A;end</Text>
