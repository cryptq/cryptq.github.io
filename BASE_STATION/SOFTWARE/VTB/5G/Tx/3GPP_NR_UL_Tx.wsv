<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PUCCH_StartOFDMSym" Type="PartParam">
<DataEntry>[1]</DataEntry>
<Description>the index for the first OFDM symbol allocated to each PUCCH.</Description>
<HideCondition>0==PUCCH_Enable</HideCondition>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PUCCH_StartRB" Type="PartParam">
<DataEntry>[0]</DataEntry>
<Description>the index of the first resource blocks (RB) allocated to each PUCCH.</Description>
<HideCondition>0==PUCCH_Enable</HideCondition>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PUCCH_n_ID" Type="PartParam">
<DataEntry>[0]</DataEntry>
<Description>Data-scrambling-Identity for each PUCCH format2/3/4. 0 ~ 1023 or CellID.</Description>
<HideCondition>0==PUCCH_Enable || (PUCCH_Format ~= 2&amp;&amp;PUCCH_Format ~= 3&amp;&amp;PUCCH_Format ~= 4)</HideCondition>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PUCCH_n_RNTI" Type="PartParam">
<DataEntry>[0]</DataEntry>
<Description>radio network temporary identifier for each PUCCH format 2/3/4.</Description>
<HideCondition>0==PUCCH_Enable || (PUCCH_Format ~= 2&amp;&amp;PUCCH_Format ~= 3&amp;&amp;PUCCH_Format ~= 4)</HideCondition>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PUSCH_AllocatedSlots" Type="PartParam">
<DataEntry>PUSCH_AllocatedSlots</DataEntry>
<Description>Allocated slot indices for PUSCH in each frame for all BWPs. The index starts from 0 to (N-1), where N is the number of slots per frame.</Description>
<HideCondition>PUSCH_Enable==0</HideCondition>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PUSCH_BitInfoLength_CSI1" Type="PartParam">
<DataEntry>[10]</DataEntry>
<Description>The number of information bits of CSI1 in PUSCH.</Description>
<HideCondition>0==PUSCH_Enable || 0 == PUSCH_CSI1_Enabled</HideCondition>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PUSCH_BitInfoLength_CSI2" Type="PartParam">
<DataEntry>[10]</DataEntry>
<Description>The number of information bits of CSI2 in PUSCH.</Description>
<HideCondition>0==PUSCH_Enable || 0 == PUSCH_CSI2_Enabled</HideCondition>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PUSCH_BitInfoLength_HARQACK" Type="PartParam">
<DataEntry>[10]</DataEntry>
<Description>The number of information bits of HARQACK in PUSCH.</Description>
<HideCondition>0==PUSCH_Enable || 0 == PUSCH_HARQACK_Enabled</HideCondition>
<Validate><T>Int</T><D>13</D></Validate></Item>
