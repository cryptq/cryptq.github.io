<Item XName="Equations" Type="Equation">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>% Parameters Range Check&#x000D;&#x000A;if (FCarrier_In&lt;=0)&#x000D;&#x000A;&#x0009;error(&apos;FCarrier_In should be greater than 0&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;if (FCarrier_Out&lt;=0)&#x000D;&#x000A;&#x0009;error(&apos;FCarrier_Out should be greater than 0&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;if (OutputSampleRate&lt;=0)&#x000D;&#x000A;&#x0009;error(&apos;OutputSampleRate must be a positive number&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;if (CC0_FreqOffset&lt;=-FCarrier_In)&#x000D;&#x000A;&#x0009;error(&apos;CC0_FreqOffset should be greater than -FCarrier_In&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;if (CC1_FreqOffset&lt;=-FCarrier_In)&#x000D;&#x000A;&#x0009;error(&apos;CC1_FreqOffset should be greater than -FCarrier_In&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;if (CC2_FreqOffset&lt;=-FCarrier_In)&#x000D;&#x000A;&#x0009;error(&apos;CC2_FreqOffset should be greater than -FCarrier_In&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;if (CC3_FreqOffset&lt;=-FCarrier_In)&#x000D;&#x000A;&#x0009;error(&apos;CC3_FreqOffset should be greater than -FCarrier_In&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;if (CC4_FreqOffset&lt;=-FCarrier_In)&#x000D;&#x000A;&#x0009;error(&apos;CC4_FreqOffset should be greater than -FCarrier_In&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;if (CC0_FreqOffset&lt;=-FCarrier_Out)&#x000D;&#x000A;&#x0009;error(&apos;CC0_FreqOffset should be greater than -FCarrier_Out&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;if (CC1_FreqOffset&lt;=-FCarrier_Out)&#x000D;&#x000A;&#x0009;error(&apos;CC1_FreqOffset should be greater than -FCarrier_Out&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;if (CC2_FreqOffset&lt;=-FCarrier_Out)&#x000D;&#x000A;&#x0009;error(&apos;CC2_FreqOffset should be greater than -FCarrier_Out&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;if (CC3_FreqOffset&lt;=-FCarrier_Out)&#x000D;&#x000A;&#x0009;error(&apos;CC3_FreqOffset should be greater than -FCarrier_Out&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;if (CC4_FreqOffset&lt;=-FCarrier_Out)&#x000D;&#x000A;&#x0009;error(&apos;CC4_FreqOffset should be greater than -FCarrier_Out&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;if (CC0_SignalPower&lt;0)&#x000D;&#x000A;&#x0009;error(&apos;CC0_SignalPower should be greater than or equal to 0&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;if (CC1_SignalPower&lt;0)&#x000D;&#x000A;&#x0009;error(&apos;CC1_SignalPower should be greater than or equal to 0&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;if (CC2_SignalPower&lt;0)&#x000D;&#x000A;&#x0009;error(&apos;CC2_SignalPower should be greater than or equal to 0&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;if (CC3_SignalPower&lt;0)&#x000D;&#x000A;&#x0009;error(&apos;CC3_SignalPower should be greater than or equal to 0&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;if (CC4_SignalPower&lt;0)&#x000D;&#x000A;&#x0009;error(&apos;CC4_SignalPower should be greater than or equal to 0&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;if (CC0_UE1_Config==0 &amp;&amp; (CC0_UE1_Payload&lt;-1 || CC0_UE1_Payload&gt;28 || mod(CC0_UE1_Payload,1)~=0))&#x000D;&#x000A;&#x0009;error(&apos;When CC0_UE1_Config is set to &quot;MCS index&quot;, the integer value in CC0_UE1_Payload should be in range [-1, 28] (-1 means no block is allocated)&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;if (CC0_UE1_Config==1 &amp;&amp; (CC0_UE1_Payload&lt;0 || mod(CC0_UE1_Payload,1)~=0))&#x000D;&#x000A;&#x0009;error(&apos;When CC0_UE1_Config is set to &quot;Transport block size&quot;, the integer value in CC0_UE1_Payload should be in range [0, inf) (0 means no block is allocated)&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;if (CC0_UE1_Config==2 &amp;&amp; (CC0_UE1_Payload&lt;0 || CC0_UE1_Payload&gt;10))&#x000D;&#x000A;&#x0009;error(&apos;When CC0_UE1_Config is set to &quot;Code rate&quot;, the float value in CC0_UE1_Payload should be in range [0, 10] (0 means no block is allocated)&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;if (CC0_UE1_Config==0)&#x000D;&#x000A;&#x0009;if CC0_UE1_Payload &lt; 10&#x000D;&#x000A;&#x0009;&#x0009;CC0_UE1_MappingType = 0;&#x000D;&#x000A;&#x0009;elseif CC0_UE1_Payload &lt; 17&#x000D;&#x000A;&#x0009;&#x0009;CC0_UE1_MappingType = 1;&#x000D;&#x000A;&#x0009;else&#x000D;&#x000A;&#x0009;&#x0009;CC0_UE1_MappingType = 2;&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x000D;&#x000A;if (CC0_UE1_MappingType&lt;0 || CC0_UE1_MappingType&gt;2)&#x000D;&#x000A;&#x0009;error(&apos;CC0_UE1_MappingType should be integer in range [0, 2]&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if (CC1_Enable==1)&#x000D;&#x000A;&#x0009;if (CC1_UE1_Config==0 &amp;&amp; (CC1_UE1_Payload&lt;-1 || CC1_UE1_Payload&gt;28 || mod(CC1_UE1_Payload,1)~=0))&#x000D;&#x000A;&#x0009;&#x0009;error(&apos;When CC1_UE1_Config is set to &quot;MCS index&quot;, the integer value in CC1_UE1_Payload should be in range [-1, 28] (-1 means no block is allocated)&apos;);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x0009;if (CC1_UE1_Config==1 &amp;&amp; (CC1_UE1_Payload&lt;0 || mod(CC1_UE1_Payload,1)~=0))&#x000D;&#x000A;&#x0009;&#x0009;error(&apos;When CC1_UE1_Config is set to &quot;Transport block size&quot;, the integer value in CC1_UE1_Payload should be in range [0, inf) (0 means no block is allocated)&apos;);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x0009;if (CC1_UE1_Config==2 &amp;&amp; (CC1_UE1_Payload&lt;0 || CC1_UE1_Payload&gt;10))&#x000D;&#x000A;&#x0009;&#x0009;error(&apos;When CC1_UE1_Config is set to &quot;Code rate&quot;, the float value in CC1_UE1_Payload should be in range [0, 10] (0 means no block is allocated)&apos;);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x0009;if (CC1_UE1_Config==0)&#x000D;&#x000A;&#x0009;&#x0009;if CC1_UE1_Payload &lt; 10&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;CC1_UE1_MappingType = 0;&#x000D;&#x000A;&#x0009;&#x0009;elseif CC1_UE1_Payload &lt; 17&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;CC1_UE1_MappingType = 1;&#x000D;&#x000A;&#x0009;&#x0009;else&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;CC1_UE1_MappingType = 2;&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x0009;if (CC1_UE1_MappingType&lt;0 || CC1_UE1_MappingType&gt;2)&#x000D;&#x000A;&#x0009;&#x0009;error(&apos;CC1_UE1_MappingType should be integer in range [0, 2]&apos;);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x000D;&#x000A;if (CC2_Enable==1)&#x000D;&#x000A;&#x0009;if (CC2_UE1_Config==0 &amp;&amp; (CC2_UE1_Payload&lt;-1 || CC2_UE1_Payload&gt;28 || mod(CC2_UE1_Payload,1)~=0))&#x000D;&#x000A;&#x0009;&#x0009;error(&apos;When CC2_UE1_Config is set to &quot;MCS index&quot;, the integer value in CC2_UE1_Payload should be in range [-1, 28] (-1 means no block is allocated)&apos;);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x0009;if (CC2_UE1_Config==1 &amp;&amp; (CC2_UE1_Payload&lt;0 || mod(CC2_UE1_Payload,1)~=0))&#x000D;&#x000A;&#x0009;&#x0009;error(&apos;When CC2_UE1_Config is set to &quot;Transport block size&quot;, the integer value in CC2_UE1_Payload should be in range [0, inf) (0 means no block is allocated)&apos;);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x0009;if (CC2_UE1_Config==2 &amp;&amp; (CC2_UE1_Payload&lt;0 || CC2_UE1_Payload&gt;10))&#x000D;&#x000A;&#x0009;&#x0009;error(&apos;When CC2_UE1_Config is set to &quot;Code rate&quot;, the float value in CC2_UE1_Payload should be in range [0, 10] (0 means no block is allocated)&apos;);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x0009;if (CC2_UE1_Config==0)&#x000D;&#x000A;&#x0009;&#x0009;if CC2_UE1_Payload &lt; 10&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;CC2_UE1_MappingType = 0;&#x000D;&#x000A;&#x0009;&#x0009;elseif CC2_UE1_Payload &lt; 17&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;CC2_UE1_MappingType = 1;&#x000D;&#x000A;&#x0009;&#x0009;else&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;CC2_UE1_MappingType = 2;&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x0009;if (CC2_UE1_MappingType&lt;0 || CC2_UE1_MappingType&gt;2)&#x000D;&#x000A;&#x0009;&#x0009;error(&apos;CC2_UE1_MappingType should be integer in range [0, 2]&apos;);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x000D;&#x000A;if (CC3_Enable==1)&#x000D;&#x000A;&#x0009;if (CC3_UE1_Config==0 &amp;&amp; (CC3_UE1_Payload&lt;-1 || CC3_UE1_Payload&gt;28 || mod(CC3_UE1_Payload,1)~=0))&#x000D;&#x000A;&#x0009;&#x0009;error(&apos;When CC3_UE1_Config is set to &quot;MCS index&quot;, the integer value in CC3_UE1_Payload should be in range [-1, 28] (-1 means no block is allocated)&apos;);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x0009;if (CC3_UE1_Config==1 &amp;&amp; (CC3_UE1_Payload&lt;0 || mod(CC3_UE1_Payload,1)~=0))&#x000D;&#x000A;&#x0009;&#x0009;error(&apos;When CC3_UE1_Config is set to &quot;Transport block size&quot;, the integer value in CC3_UE1_Payload should be in range [0, inf) (0 means no block is allocated)&apos;);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x0009;if (CC3_UE1_Config==2 &amp;&amp; (CC3_UE1_Payload&lt;0 || CC3_UE1_Payload&gt;10))&#x000D;&#x000A;&#x0009;&#x0009;error(&apos;When CC3_UE1_Config is set to &quot;Code rate&quot;, the float value in CC3_UE1_Payload should be in range [0, 10] (0 means no block is allocated)&apos;);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x0009;if (CC3_UE1_Config==0)&#x000D;&#x000A;&#x0009;&#x0009;if CC3_UE1_Payload &lt; 10&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;CC3_UE1_MappingType = 0;&#x000D;&#x000A;&#x0009;&#x0009;elseif CC3_UE1_Payload &lt; 17&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;CC3_UE1_MappingType = 1;&#x000D;&#x000A;&#x0009;&#x0009;else&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;CC3_UE1_MappingType = 2;&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x0009;if (CC3_UE1_MappingType&lt;0 || CC3_UE1_MappingType&gt;2)&#x000D;&#x000A;&#x0009;&#x0009;error(&apos;CC3_UE1_MappingType should be integer in range [0, 2]&apos;);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x000D;&#x000A;if (CC4_Enable==1)&#x000D;&#x000A;&#x0009;if (CC4_UE1_Config==0 &amp;&amp; (CC4_UE1_Payload&lt;-1 || CC4_UE1_Payload&gt;28 || mod(CC4_UE1_Payload,1)~=0))&#x000D;&#x000A;&#x0009;&#x0009;error(&apos;When CC4_UE1_Config is set to &quot;MCS index&quot;, the integer value in CC4_UE1_Payload should be in range [-1, 28] (-1 means no block is allocated)&apos;);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x0009;if (CC4_UE1_Config==1 &amp;&amp; (CC4_UE1_Payload&lt;0 || mod(CC4_UE1_Payload,1)~=0))&#x000D;&#x000A;&#x0009;&#x0009;error(&apos;When CC4_UE1_Config is set to &quot;Transport block size&quot;, the integer value in CC4_UE1_Payload should be in range [0, inf) (0 means no block is allocated)&apos;);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x0009;if (CC4_UE1_Config==2 &amp;&amp; (CC4_UE1_Payload&lt;0 || CC4_UE1_Payload&gt;10))&#x000D;&#x000A;&#x0009;&#x0009;error(&apos;When CC4_UE1_Config is set to &quot;Code rate&quot;, the float value in CC4_UE1_Payload should be in range [0, 10] (0 means no block is allocated)&apos;);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x0009;if (CC4_UE1_Config==0)&#x000D;&#x000A;&#x0009;&#x0009;if CC4_UE1_Payload &lt; 10&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;CC4_UE1_MappingType = 0;&#x000D;&#x000A;&#x0009;&#x0009;elseif CC4_UE1_Payload &lt; 17&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;CC4_UE1_MappingType = 1;&#x000D;&#x000A;&#x0009;&#x0009;else&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;CC4_UE1_MappingType = 2;&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x0009;if (CC4_UE1_MappingType&lt;0 || CC4_UE1_MappingType&gt;2)&#x000D;&#x000A;&#x0009;&#x0009;error(&apos;CC4_UE1_MappingType should be integer in range [0, 2]&apos;);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x000D;&#x000A;if (EnableTxFilter==1 &amp;&amp; (FIR_Taps&lt;1 || FIR_Taps&gt;1000))&#x000D;&#x000A;&#x0009;error(&apos;When EnableTxFilter is enabled, FIR_Taps should be integer in range [1, 1000]&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;if (TimeStop&lt;0)&#x000D;&#x000A;&#x0009;error(&apos;TimeStop should be in range [0, inf)&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;NumCC = 1+CC1_Enable+CC2_Enable+CC3_Enable+CC4_Enable;&#x000D;&#x000A;BW_Table = [1.4,3,5,10,15,20]*1e6;&#x000D;&#x000A;SamplingTable=[1.92 3.84 7.68 15.36 23.04 30.72];&#x000D;&#x000A;RB_Table = [6,15,25,50,75,100];&#x000D;&#x000A;&#x000D;&#x000A;CC0_FCarrier = FCarrier_In + CC0_FreqOffset;&#x000D;&#x000A;CC1_FCarrier = FCarrier_In + CC1_FreqOffset;&#x000D;&#x000A;CC2_FCarrier = FCarrier_In + CC2_FreqOffset;&#x000D;&#x000A;CC3_FCarrier = FCarrier_In + CC3_FreqOffset;&#x000D;&#x000A;CC4_FCarrier = FCarrier_In + CC4_FreqOffset;&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;CC0_CyclicPrefix = 0;&#x000D;&#x000A;CC0_RB_MappingType = 0;&#x000D;&#x000A;CC0_RB_Gap = 0;&#x000D;&#x000A;CC0_RB_AllocType = 0;&#x000D;&#x000A;if CC0_FullRB_Alloc==1&#x000D;&#x000A;&#x0009;CC0_UE1_RB_Alloc = [0,RB_Table(CC0_Bandwidth+1)];&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;CC0_UE1_RB_Alloc = [CC0_StartRB, CC0_NumRBs];&#x000D;&#x000A;&#x0009;TotalRB = RB_Table(CC0_Bandwidth+1);&#x000D;&#x000A;&#x0009;if (CC0_StartRB&lt;0 || CC0_StartRB&gt;TotalRB-1)&#x000D;&#x000A;&#x0009;&#x0009;error(&apos;CC0_StartRB is out of the allowable RB range.&apos;);&#x000D;&#x000A;&#x0009;elseif (CC0_NumRBs&lt;1 || CC0_NumRBs&gt;TotalRB)&#x000D;&#x000A;&#x0009;&#x0009;error(&apos;CC0_NumRBs is out of the allowable RB range.&apos;);&#x000D;&#x000A;&#x0009;elseif (CC0_StartRB+CC0_NumRBs-1&gt;TotalRB-1)&#x000D;&#x000A;&#x0009;&#x0009;error(&apos;CC0 RB allocation is out of the allowable RB range.&apos;);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x000D;&#x000A;CC0_SignalPower_dBm = 10*log10(CC0_SignalPower) + 30;&#x000D;&#x000A;CC0_RS_EPRE = CC0_SignalPower - 10*log10(RB_Table(CC0_Bandwidth+1)*12);&#x000D;&#x000A;&#x000D;&#x000A;CC1_CyclicPrefix = 0;&#x000D;&#x000A;CC1_RB_MappingType = 0;&#x000D;&#x000A;CC1_RB_Gap = 0;&#x000D;&#x000A;CC1_RB_AllocType = 0;&#x000D;&#x000A;if CC1_FullRB_Alloc==1&#x000D;&#x000A;&#x0009;CC1_UE1_RB_Alloc = [0,RB_Table(CC1_Bandwidth+1)];&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;CC1_UE1_RB_Alloc = [CC1_StartRB, CC1_NumRBs];&#x000D;&#x000A;&#x0009;TotalRB = RB_Table(CC1_Bandwidth+1);&#x000D;&#x000A;&#x0009;if (CC1_Enable==1)&#x000D;&#x000A;&#x0009;&#x0009;if (CC1_StartRB&lt;0 || CC1_StartRB&gt;TotalRB-1)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;error(&apos;CC1_StartRB is out of the allowable RB range.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;elseif (CC1_NumRBs&lt;1 || CC1_NumRBs&gt;TotalRB)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;error(&apos;CC1_NumRBs is out of the allowable RB range.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;elseif (CC1_StartRB+CC1_NumRBs-1&gt;TotalRB-1)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;error(&apos;CC1 RB allocation is out of the allowable RB range.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x000D;&#x000A;CC1_SignalPower_dBm = 10*log10(CC1_SignalPower) + 30;&#x000D;&#x000A;CC1_RS_EPRE = CC1_SignalPower - 10*log10(RB_Table(CC1_Bandwidth+1)*12);&#x000D;&#x000A;&#x000D;&#x000A;CC2_CyclicPrefix = 0;&#x000D;&#x000A;CC2_RB_MappingType = 0;&#x000D;&#x000A;CC2_RB_Gap = 0;&#x000D;&#x000A;CC2_RB_AllocType = 0;&#x000D;&#x000A;if CC2_FullRB_Alloc==1&#x000D;&#x000A;&#x0009;CC2_UE1_RB_Alloc = [0,RB_Table(CC2_Bandwidth+1)];&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;CC2_UE1_RB_Alloc = [CC2_StartRB, CC2_NumRBs];&#x000D;&#x000A;&#x0009;TotalRB = RB_Table(CC2_Bandwidth+1);&#x000D;&#x000A;&#x0009;if (CC2_Enable==1)&#x000D;&#x000A;&#x0009;&#x0009;if (CC2_StartRB&lt;0 || CC2_StartRB&gt;TotalRB-1)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;error(&apos;CC2_StartRB is out of the allowable RB range.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;elseif (CC2_NumRBs&lt;1 || CC2_NumRBs&gt;TotalRB)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;error(&apos;CC2_NumRBs is out of the allowable RB range.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;elseif (CC2_StartRB+CC2_NumRBs-1&gt;TotalRB-1)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;error(&apos;CC2 RB allocation is out of the allowable RB range.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x000D;&#x000A;CC2_SignalPower_dBm = 10*log10(CC2_SignalPower) + 30;&#x000D;&#x000A;CC2_RS_EPRE = CC2_SignalPower - 10*log10(RB_Table(CC2_Bandwidth+1)*12);&#x000D;&#x000A;&#x000D;&#x000A;CC3_CyclicPrefix = 0;&#x000D;&#x000A;CC3_RB_MappingType = 0;&#x000D;&#x000A;CC3_RB_Gap = 0;&#x000D;&#x000A;CC3_RB_AllocType = 0;&#x000D;&#x000A;if CC3_FullRB_Alloc==1&#x000D;&#x000A;&#x0009;CC3_UE1_RB_Alloc = [0,RB_Table(CC3_Bandwidth+1)];&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;CC3_UE1_RB_Alloc = [CC3_StartRB, CC3_NumRBs];&#x000D;&#x000A;&#x0009;TotalRB = RB_Table(CC3_Bandwidth+1);&#x000D;&#x000A;&#x0009;if (CC3_Enable==1)&#x000D;&#x000A;&#x0009;&#x0009;if (CC3_StartRB&lt;0 || CC3_StartRB&gt;TotalRB-1)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;error(&apos;CC3_StartRB is out of the allowable RB range.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;elseif (CC3_NumRBs&lt;1 || CC3_NumRBs&gt;TotalRB)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;error(&apos;CC3_NumRBs is out of the allowable RB range.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;elseif (CC3_StartRB+CC3_NumRBs-1&gt;TotalRB-1)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;error(&apos;CC3 RB allocation is out of the allowable RB range.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x000D;&#x000A;CC3_SignalPower_dBm = 10*log10(CC3_SignalPower) + 30;&#x000D;&#x000A;CC3_RS_EPRE = CC3_SignalPower - 10*log10(RB_Table(CC3_Bandwidth+1)*12);&#x000D;&#x000A;&#x000D;&#x000A;CC4_CyclicPrefix = 0;&#x000D;&#x000A;CC4_RB_MappingType = 0;&#x000D;&#x000A;CC4_RB_Gap = 0;&#x000D;&#x000A;CC4_RB_AllocType = 0;&#x000D;&#x000A;if CC4_FullRB_Alloc==1&#x000D;&#x000A;&#x0009;CC4_UE1_RB_Alloc = [0,RB_Table(CC4_Bandwidth+1)];&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;CC4_UE1_RB_Alloc = [CC4_StartRB, CC4_NumRBs];&#x000D;&#x000A;&#x0009;TotalRB = RB_Table(CC4_Bandwidth+1);&#x000D;&#x000A;&#x0009;if (CC4_Enable==1)&#x000D;&#x000A;&#x0009;&#x0009;if (CC4_StartRB&lt;0 || CC4_StartRB&gt;TotalRB-1)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;error(&apos;CC4_StartRB is out of the allowable RB range.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;elseif (CC4_NumRBs&lt;1 || CC4_NumRBs&gt;TotalRB)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;error(&apos;CC4_NumRBs is out of the allowable RB range.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;elseif (CC4_StartRB+CC4_NumRBs-1&gt;TotalRB-1)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;error(&apos;CC4 RB allocation is out of the allowable RB range.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x000D;&#x000A;CC4_SignalPower_dBm = 10*log10(CC4_SignalPower) + 30;&#x000D;&#x000A;CC4_RS_EPRE = CC4_SignalPower - 10*log10(RB_Table(CC4_Bandwidth+1)*12);&#x000D;&#x000A;&#x000D;&#x000A;CC0_TransmissionBW = RB_Table(CC0_Bandwidth+1) * 180e3;&#x000D;&#x000A;CC0_ChannelBW = BW_Table(CC0_Bandwidth+1);&#x000D;&#x000A;&#x000D;&#x000A;CC1_TransmissionBW = RB_Table(CC1_Bandwidth+1) * 180e3;&#x000D;&#x000A;CC1_ChannelBW = BW_Table(CC1_Bandwidth+1);&#x000D;&#x000A;&#x000D;&#x000A;CC2_TransmissionBW = RB_Table(CC2_Bandwidth+1) * 180e3;&#x000D;&#x000A;CC2_ChannelBW = BW_Table(CC2_Bandwidth+1);&#x000D;&#x000A;&#x000D;&#x000A;CC3_TransmissionBW = RB_Table(CC3_Bandwidth+1) * 180e3;&#x000D;&#x000A;CC3_ChannelBW = BW_Table(CC3_Bandwidth+1);&#x000D;&#x000A;&#x000D;&#x000A;CC4_TransmissionBW = RB_Table(CC4_Bandwidth+1) * 180e3;&#x000D;&#x000A;CC4_ChannelBW = BW_Table(CC4_Bandwidth+1);&#x000D;&#x000A;&#x000D;&#x000A;CC0_OVSR = 2^CC0_OversamplingOption;&#x000D;&#x000A;CC0_SamplingFreq=1e6*SamplingTable(CC0_Bandwidth+1);&#x000D;&#x000A;CC0_SamplingRate=CC0_SamplingFreq*CC0_OVSR;&#x000D;&#x000A;&#x000D;&#x000A;CC1_OVSR = 2^CC1_OversamplingOption;&#x000D;&#x000A;CC1_SamplingFreq=1e6*SamplingTable(CC1_Bandwidth+1);&#x000D;&#x000A;CC1_SamplingRate=CC1_SamplingFreq*CC1_OVSR;&#x000D;&#x000A;&#x000D;&#x000A;CC2_OVSR = 2^CC2_OversamplingOption;&#x000D;&#x000A;CC2_SamplingFreq=1e6*SamplingTable(CC2_Bandwidth+1);&#x000D;&#x000A;CC2_SamplingRate=CC2_SamplingFreq*CC2_OVSR;&#x000D;&#x000A;&#x000D;&#x000A;CC3_OVSR = 2^CC3_OversamplingOption;&#x000D;&#x000A;CC3_SamplingFreq=1e6*SamplingTable(CC3_Bandwidth+1);&#x000D;&#x000A;CC3_SamplingRate=CC3_SamplingFreq*CC3_OVSR;&#x000D;&#x000A;&#x000D;&#x000A;CC4_OVSR = 2^CC4_OversamplingOption;&#x000D;&#x000A;CC4_SamplingFreq=1e6*SamplingTable(CC4_Bandwidth+1);&#x000D;&#x000A;CC4_SamplingRate=CC4_SamplingFreq*CC4_OVSR;&#x000D;&#x000A;&#x000D;&#x000A;AllCC_Fc = [CC0_FCarrier,CC1_FCarrier,CC2_FCarrier,CC3_FCarrier,CC4_FCarrier];&#x000D;&#x000A;AllCC_Bandwidth = [CC0_Bandwidth,CC1_Bandwidth,CC2_Bandwidth,CC3_Bandwidth,CC4_Bandwidth];&#x000D;&#x000A;AllCC_SamplingRate = [CC0_SamplingRate,CC1_SamplingRate,CC2_SamplingRate,CC3_SamplingRate,CC4_SamplingRate];&#x000D;&#x000A;&#x000D;&#x000A;FCarriers = AllCC_Fc(1:NumCC);&#x000D;&#x000A;Bandwidths = AllCC_Bandwidth(1:NumCC);&#x000D;&#x000A;SampleRates = AllCC_SamplingRate(1:NumCC);&#x000D;&#x000A;&#x000D;&#x000A;% adjust BlockSize so the IPC overhead is negligible and still preserve reasonable latency&#x000D;&#x000A;BlockSize = floor(OutputSampleRate * 0.001 /10 + 0.5);&#x000D;&#x000A;&#x000D;&#x000A;OutputSampleRateOption = 1;&#x000D;&#x000A;BaseOutputSampleRate = CC0_SamplingRate;&#x000D;&#x000A;&#x000D;&#x000A;if (EnableTxFilter == 1)&#x000D;&#x000A;&#x0009;AllCC_SpectrumShapingType = 1;&#x000D;&#x000A;&#x0009;AllCC_FIR_withInterp = 0;&#x000D;&#x000A;&#x0009;AllCC_FIR_FilterType = 1;&#x000D;&#x000A;&#x0009;AllCC_RRC_Alpha = 0.22;&#x000D;&#x000A;&#x0009;AllCC_WindowType = 0;&#x000D;&#x000A;&#x0009;AllCC_CyclicInterval = 6;&#x000D;&#x000A;&#x0009;AllCC_CI_StartPos = -3;&#x000D;&#x000A;&#x0009;AllCC_FIR_Taps = FIR_Taps;&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;AllCC_SpectrumShapingType = 0;&#x000D;&#x000A;&#x0009;AllCC_WindowType = 0;&#x000D;&#x000A;&#x0009;AllCC_CyclicInterval = 0;&#x000D;&#x000A;&#x0009;AllCC_CI_StartPos = 0;&#x000D;&#x000A;&#x0009;AllCC_FIR_withInterp = 0;&#x000D;&#x000A;&#x0009;AllCC_FIR_FilterType = 1;&#x000D;&#x000A;&#x0009;AllCC_RRC_Alpha = 0.22;&#x000D;&#x000A;&#x0009;AllCC_FIR_Taps = FIR_Taps;&#x000D;&#x000A;end &#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;</Text>
