<DataEntry>[2,2,2,2,2,2]</DataEntry>
<Description>MIMO Mode for each UE, 1 for TD, 0 for SM</Description>
<HideCondition>0==ShowMIMO_Parameters</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="UEs_NumOfCWs" Type="PartParam">
<DataEntry>[1,1,1,1,1,1]</DataEntry>
<Description>number of code words for each UE</Description>
<HideCondition>0==ShowMIMO_Parameters</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="UEs_NumOfLayers" Type="PartParam">
<DataEntry>[1,1,1,1,1,1]</DataEntry>
<Description>number of layers for each UE</Description>
<HideCondition>0==ShowMIMO_Parameters</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="UEs_Pa" Type="PartParam">
<DataEntry>[0,0,0,0,0,0]</DataEntry>
<Description>UE specific power parameter for each UE</Description>
<HideCondition>0==ShowPowerParameters</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>14</D></Validate></Item>
<Item XName="UEs_SpecificRS" Type="PartParam">
<DataEntry>[0,0,0,0,0,0]</DataEntry>
<Description>the antenna port for tramsmission mode 8 for each UE, 0 is port7, 1is port8</Description>
<Enum />
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="UEs_TransMode" Type="PartParam">
<DataEntry>[0,0,0,0,0,0]</DataEntry>
<Description>UEs transmission mode[0,8]</Description>
<HideCondition>0==ShowSystemParameters</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="UEs_n_RNTI" Type="PartParam">
<DataEntry>[1,2,3,4,5,6]</DataEntry>
<Description>Radio network temporary identifier for each UE</Description>
<Enum />
<HideCondition>0==ShowUE1_Parameters</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="UEs_n_SCID" Type="PartParam">
<DataEntry>[0, 0, 0, 0, 0, 0]</DataEntry>
<Description>n_SCID of each user, given by the scrambling identity field in the most recent DCI format 2B associated with the PDSCH transmission for each layer</Description>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="UserDefinedAntMappingMatrix" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>whether use customized virtual antenna mapping matrix or not</Description>
<Enum>LTE_A_DL_Src_UserDefinedAntMappingMatrix@LTE Advanced Enums</Enum>
<HideCondition>0==ShowSystemParameters</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="WindowType" Type="PartParam">
<DataEntry>AllCC_WindowType</DataEntry>
<Description>type of time transition windowing between two consecutive symbols, valid when SpectrumShapingType=TimeWindowing</Description>
<Enum>LTE_DL_MIMO_2Ant_Src_WindowType@LTE 8.9 Enums</Enum>
<HideCondition>0==ShowSpectrumShapingParameters || SpectrumShapingType ~=0</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Unit><T>Int</T><D>0</D></Unit>
<Validate><T>Int</T><D>16</D></Validate></Item></Item></Item></Item>
