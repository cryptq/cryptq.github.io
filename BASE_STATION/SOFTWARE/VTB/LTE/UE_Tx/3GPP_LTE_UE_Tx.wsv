<Item XName="Equations" Type="Equation">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>% Parameters Range Check&#x000D;&#x000A;if (FCarrier_In&lt;=0)&#x000D;&#x000A;&#x0009;error(&apos;FCarrier_In should be greater than 0&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;if (FCarrier_Out&lt;=0)&#x000D;&#x000A;&#x0009;error(&apos;FCarrier_Out should be greater than 0&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;if (SignalPower&lt;0)&#x000D;&#x000A;&#x0009;error(&apos;SignalPower should be greater than or equal to 0&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;if (Payload_Config==0 &amp;&amp; (Payload&lt;-1 || Payload&gt;28 || mod(Payload,1)~=0))&#x000D;&#x000A;&#x0009;error(&apos;When Payload_Config is set to &quot;MCS index&quot;, the integer value in Payload should be in range [-1, 28] (-1 means no block is allocated)&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;if (Payload_Config==1 &amp;&amp; (Payload&lt;0 || mod(Payload,1)~=0))&#x000D;&#x000A;&#x0009;error(&apos;When Payload_Config is set to &quot;Transport block size&quot;, the integer value in Payload should be in range [0, inf) (0 means no block is allocated)&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;if (Payload_Config==2 &amp;&amp; (Payload&lt;0 || Payload&gt;10))&#x000D;&#x000A;&#x0009;error(&apos;When Payload_Config is set to &quot;Code rate&quot;, the float value in Payload should be in range [0, 10] (0 means no block is allocated)&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;if (EnableTxFilter==1 &amp;&amp; (FIR_Taps&lt;1 || FIR_Taps&gt;1000))&#x000D;&#x000A;&#x0009;error(&apos;When EnableTxFilter is enabled, FIR_Taps should be integer in range [1, 1000]&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;if (NumFrames&lt;1)&#x000D;&#x000A;&#x0009;error(&apos;NumFrames should be integer in range [1, inf)&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;if (Payload_Config==0)&#x000D;&#x000A;&#x0009;if Payload &lt; 10&#x000D;&#x000A;&#x0009;&#x0009;MappingType = 0;&#x000D;&#x000A;&#x0009;elseif Payload &lt; 17&#x000D;&#x000A;&#x0009;&#x0009;MappingType = 1;&#x000D;&#x000A;&#x0009;else&#x000D;&#x000A;&#x0009;&#x0009;MappingType = 2;&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x000D;&#x000A;if (MappingType&lt;0 || MappingType&gt;2)&#x000D;&#x000A;&#x0009;error(&apos;MappingType should be integer in range [0, 2]&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;% SamplingRate&#x000D;&#x000A;SamplingTable = [1.92 3.84 7.68 15.36 23.04 30.72];&#x000D;&#x000A;SamplingFreq = 1e6 * SamplingTable(Bandwidth+1);&#x000D;&#x000A;SamplingRate = SamplingFreq * (2^OversamplingOption);&#x000D;&#x000A;SampsPerSF = 0.001 * SamplingRate;&#x000D;&#x000A;SampsPerFrame = 10 * SampsPerSF;&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;NumRB_Table = [6,15,25,50,75,100];&#x000D;&#x000A;TotalRB = NumRB_Table(Bandwidth+1);&#x000D;&#x000A;&#x000D;&#x000A;%%% Users can move following parameters in the &quot;Parameters&quot; tab if necessary&#x000D;&#x000A;CyclicPrefix = 0; % Normal CP&#x000D;&#x000A;&#x000D;&#x000A;RB_AllocType = 0;&#x000D;&#x000A;if (FullRB_Alloc == 1)&#x000D;&#x000A;&#x0009;RB_AllocType = 0;&#x000D;&#x000A;&#x0009;RB_Alloc = [0, TotalRB];&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;RB_Alloc = [StartRB, NumRBs];&#x000D;&#x000A;&#x0009;if (StartRB&lt;0 || StartRB&gt;TotalRB-1)&#x000D;&#x000A;&#x0009;&#x0009;error(&apos;StartRB is out of the allowable RB range.&apos;);&#x000D;&#x000A;&#x0009;elseif (NumRBs&lt;1 || NumRBs&gt;TotalRB)&#x000D;&#x000A;&#x0009;&#x0009;error(&apos;NumRBs is out of the allowable RB range.&apos;);&#x000D;&#x000A;&#x0009;elseif (StartRB+NumRBs-1&gt;TotalRB-1)&#x000D;&#x000A;&#x0009;&#x0009;error(&apos;RB allocation is out of the allowable RB range.&apos;);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x000D;&#x000A;SignalPower = SignalPower * TotalRB / RB_Alloc(2);&#x000D;&#x000A;if (EnableTxFilter == 1)&#x000D;&#x000A;&#x0009;SpectrumShapingType = 1;&#x000D;&#x000A;&#x0009;FIR_withInterp = 0;&#x000D;&#x000A;&#x0009;FIR_FilterType = 1;&#x000D;&#x000A;&#x0009;RRC_Alpha = 0.22;&#x000D;&#x000A;&#x0009;WindowType = 0;&#x000D;&#x000A;&#x0009;CyclicInterval = 6;&#x000D;&#x000A;&#x0009;CI_StartPos = -3;&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;SpectrumShapingType = 0;&#x000D;&#x000A;&#x0009;WindowType = 0;&#x000D;&#x000A;&#x0009;CyclicInterval = 0;&#x000D;&#x000A;&#x0009;CI_StartPos = 0;&#x000D;&#x000A;&#x0009;FIR_withInterp = 0;&#x000D;&#x000A;&#x0009;FIR_FilterType = 1;&#x000D;&#x000A;&#x0009;RRC_Alpha = 0.22;&#x000D;&#x000A;end &#x000D;&#x000A;&#x000D;&#x000A;% adjust BlockSize so the IPC overhead is negligible and still preserve reasonable latency&#x000D;&#x000A;if SampsPerSF &gt; 10000&#x000D;&#x000A;&#x0009;BlockSize = floor(SampsPerSF / 10 + 0.5);&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;BlockSize = SampsPerSF;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if (FullRB_Alloc == 1)&#x000D;&#x000A;setvariable( &apos;LTE_UE_Tx_Data&apos;, &apos;NumRBs&apos;, TotalRB);&#x000D;&#x000A;else&#x000D;&#x000A;setvariable( &apos;LTE_UE_Tx_Data&apos;, &apos;NumRBs&apos;, NumRBs);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;setvariable( &apos;LTE_UE_Tx_Data&apos;, &apos;EVM_MappingType&apos;, MappingType);&#x000D;&#x000A;</Text>
