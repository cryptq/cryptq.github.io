<Item XName="CCDF_MeanPower_dBm" Type="Variable">
<ByAnalysis><T>Bool</T><D>1</D></ByAnalysis>
<Data><T>Double</T><D>10.00139883328906</D></Data>
<IndepValue>Analysis\LTE_UE_Tx_Data\Eqns\VarBlock\CCDF_MeanPower_dBm_Index</IndepValue></Item>
<Item XName="CCDF_MeanPower_dBm_Index" Type="Variable">
<ByAnalysis><T>Bool</T><D>1</D></ByAnalysis>
<Data><T>Int</T><D>0</D></Data></Item>
<Item XName="CCDF_PeakPower_dBm" Type="Variable">
<ByAnalysis><T>Bool</T><D>1</D></ByAnalysis>
<Data><T>Double</T><D>15.76932233177309</D></Data>
<IndepValue>Analysis\LTE_UE_Tx_Data\Eqns\VarBlock\CCDF_PeakPower_dBm_Index</IndepValue></Item>
<Item XName="CCDF_PeakPower_dBm_Index" Type="Variable">
<ByAnalysis><T>Bool</T><D>1</D></ByAnalysis>
<Data><T>Int</T><D>0</D></Data></Item>
<Item XName="CCDF_Ref" Type="Variable">
<DataEntry>=exp(-1*(10.^(CCDF_CCDF_SignalRange_dB/10)))*100</DataEntry>
<IndepValue>CCDF_CCDF_SignalRange_dB</IndepValue></Item>
<Item XName="EVM_MappingType" Type="Variable">
<Data><T>Double</T><D>0</D></Data></Item>
<Item XName="EVM_PassFailFlag" Type="Variable">
<DataEntry>=isempty(find(L1_EVM&gt;EVM_Required))</DataEntry></Item>
<Item XName="EVM_Required" Type="Variable">
<DataEntry>=17.5*(EVM_MappingType==0)+12.5*(EVM_MappingType==1)+8*(EVM_MappingType==2)</DataEntry></Item>
<Item XName="EnableTxFilter" Type="Variable">
<ByAnalysis><T>Bool</T><D>1</D></ByAnalysis>
