<Selected><T>Bool</T><D>0</D></Selected>
<Text>&lt;DIV style=&quot;BORDER-TOP: medium none; BORDER-RIGHT: medium none; BORDER-BOTTOM: windowtext 1pt solid; PADDING-BOTTOM: 1pt; PADDING-TOP: 0in; PADDING-LEFT: 0in; BORDER-LEFT: medium none; PADDING-RIGHT: 0in; mso-element: para-border-div; mso-border-bottom-alt: solid windowtext .75pt&quot;&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;BORDER-TOP: medium none; BORDER-RIGHT: medium none; BORDER-BOTTOM: medium none; PADDING-BOTTOM: 0in; TEXT-ALIGN: center; PADDING-TOP: 0in; PADDING-LEFT: 0in; BORDER-LEFT: medium none; MARGIN: 0in 0in 0pt; PADDING-RIGHT: 0in; mso-border-bottom-alt: solid windowtext .75pt; mso-padding-alt: 0in 0in 1.0pt 0in&quot; align=center&gt;&lt;B&gt;&lt;SPAN style=&apos;FONT-SIZE: 18pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif; mso-fareast-font-family: &quot;Times New Roman&quot;; mso-bidi-font-size: 11.0pt&apos;&gt;PA DPD Simulation Solution&lt;/SPAN&gt;&lt;/B&gt;&lt;SPAN style=&apos;mso-fareast-font-family: &quot;Times New Roman&quot;; mso-ascii-font-family: Calibri; mso-hansi-font-family: Calibri; mso-bidi-font-family: Calibri&apos;&gt;&lt;?xml:namespace prefix = &quot;o&quot; ns = &quot;urn:schemas-microsoft-com:office:office&quot; /&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&lt;/DIV&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: center; MARGIN: 0in 0in 0pt&quot; align=center&gt;&lt;SPAN style=&apos;FONT-SIZE: 10pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif; mso-fareast-font-family: &quot;Times New Roman&quot;; mso-bidi-font-size: 12.0pt&apos;&gt;Keysight Technologies SystemVue&amp;nbsp;Workspace&lt;/SPAN&gt;&lt;SPAN style=&apos;FONT-SIZE: 10pt; FONT-FAMILY: &quot;Times New Roman&quot;,serif; mso-fareast-font-family: &quot;Times New Roman&quot;; mso-bidi-font-size: 12.0pt&apos;&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: center; MARGIN: 0in 0in 0pt&quot; align=center&gt;&lt;SPAN style=&apos;FONT-SIZE: 10pt; FONT-FAMILY: &quot;Times New Roman&quot;,serif; mso-fareast-font-family: &quot;Times New Roman&quot;; mso-bidi-font-size: 12.0pt&apos;&gt;&amp;nbsp;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 0pt; tab-stops: 45.8pt 91.6pt 137.4pt 183.2pt 229.0pt 274.8pt 320.6pt 366.4pt 412.2pt 458.0pt 503.8pt 549.6pt 595.4pt 641.2pt 687.0pt 732.8pt&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif; mso-fareast-font-family: &quot;Times New Roman&quot;&apos;&gt;This VTB design&amp;nbsp;&lt;SPAN style=&quot;COLOR: #333333&quot;&gt;demonstrates how you can employ DPD to improve your PA&#x2019;s linearity. &lt;/SPAN&gt;&lt;/SPAN&gt;&lt;SPAN style=&apos;FONT-SIZE: 10pt; FONT-FAMILY: &quot;Courier New&quot;; mso-fareast-font-family: &quot;Times New Roman&quot;&apos;&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 0pt; tab-stops: 45.8pt 91.6pt 137.4pt 183.2pt 229.0pt 274.8pt 320.6pt 366.4pt 412.2pt 458.0pt 503.8pt 549.6pt 595.4pt 641.2pt 687.0pt 732.8pt&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif; COLOR: #333333; mso-fareast-font-family: &quot;Times New Roman&quot;&apos;&gt;This example is meant to show the concept of DPD whose algorithms are generic ones but not the state-of-the-art ones. We intend to educate designers on a method (but certainly not the only one) of simulating DPD with ADS.&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 0pt; tab-stops: 45.8pt 91.6pt 137.4pt 183.2pt 229.0pt 274.8pt 320.6pt 366.4pt 412.2pt 458.0pt 503.8pt 549.6pt 595.4pt 641.2pt 687.0pt 732.8pt&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif; COLOR: #333333; mso-fareast-font-family: &quot;Times New Roman&quot;&apos;&gt;&lt;o:p&gt;&amp;nbsp;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 0pt; tab-stops: 45.8pt 91.6pt 137.4pt 183.2pt 229.0pt 274.8pt 320.6pt 366.4pt 412.2pt 458.0pt 503.8pt 549.6pt 595.4pt 641.2pt 687.0pt 732.8pt&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif; COLOR: #333333; mso-fareast-font-family: &quot;Times New Roman&quot;&apos;&gt;The configuration of this workspace:&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 0pt; tab-stops: 45.8pt 91.6pt 137.4pt 183.2pt 229.0pt 274.8pt 320.6pt 366.4pt 412.2pt 458.0pt 503.8pt 549.6pt 595.4pt 641.2pt 687.0pt 732.8pt&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif; COLOR: #333333; mso-fareast-font-family: &quot;Times New Roman&quot;&apos;&gt;&lt;o:p&gt;&amp;nbsp;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;UL style=&quot;MARGIN-TOP: 0in&quot; type=disc&gt;&#x000D;&#x000A;&lt;LI class=MsoListParagraph style=&quot;MARGIN: 0in 0in 0pt; mso-list: l1 level1 lfo1&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif&apos;&gt;The center frequency of the input signal to DUT(&lt;I&gt;SVE_Link&lt;/I&gt;&amp;nbsp;in the design) is set by&amp;nbsp;&lt;B&gt;FCarrier.&lt;o:p&gt;&lt;/o:p&gt;&lt;/B&gt;&lt;/SPAN&gt;&lt;/LI&gt;&#x000D;&#x000A;&lt;LI class=MsoListParagraph style=&quot;MARGIN: 0in 0in 0pt; mso-list: l1 level1 lfo1&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif&apos;&gt;The PA input signal mean power is set by&amp;nbsp;&lt;B&gt;SignalPower&lt;/B&gt;.&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/LI&gt;&#x000D;&#x000A;&lt;LI class=MsoListParagraph style=&quot;MARGIN: 0in 0in 0pt; mso-list: l1 level1 lfo1&quot;&gt;&lt;B&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif&apos;&gt;Operation &lt;/SPAN&gt;&lt;/B&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif&apos;&gt;specifies which DPD step is performed. 0 denotes Extraction and 1 denotes Application.&lt;/SPAN&gt;&lt;/LI&gt;&#x000D;&#x000A;&lt;LI class=MsoListParagraph style=&quot;MARGIN: 0in 0in 0pt; mso-list: l1 level1 lfo1&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif&apos;&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif&apos;&gt;&lt;STRONG&gt;WorkingFolderDirectory&lt;/STRONG&gt; specifies the full path of a folder. This folder must be writable. It&apos;s used to exchange data between DPD operations.&lt;/SPAN&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/LI&gt;&#x000D;&#x000A;&lt;LI class=MsoListParagraph style=&quot;MARGIN: 0in 0in 0pt; mso-list: l1 level1 lfo1&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif&apos;&gt;Below parameters are used to define the stimulus signal.&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/LI&gt;&#x000D;&#x000A;&lt;UL style=&quot;MARGIN-TOP: 0in&quot; type=circle&gt;&#x000D;&#x000A;&lt;LI class=MsoListParagraph style=&quot;MARGIN: 0in 0in 0pt; mso-list: l1 level2 lfo1&quot;&gt;&lt;B style=&quot;mso-bidi-font-weight: normal&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif&apos;&gt;SignalType&lt;/SPAN&gt;&lt;/B&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif&apos;&gt; specifies the waveform type. I/Q File | LTE DL | LTE UL | WLAN 11ac | NR DL | NR UL.&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/LI&gt;&#x000D;&#x000A;&lt;LI class=MsoListParagraph style=&quot;MARGIN: 0in 0in 0pt; mso-list: l1 level2 lfo1&quot;&gt;&lt;B style=&quot;mso-bidi-font-weight: normal&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif&apos;&gt;OversamplingRatio&lt;/SPAN&gt;&lt;/B&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif&apos;&gt; specifies the oversampling ratio used by the signal.&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/LI&gt;&#x000D;&#x000A;&lt;LI class=MsoListParagraph style=&quot;MARGIN: 0in 0in 0pt; mso-list: l1 level2 lfo1&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif&apos;&gt;Below parameters, they take effect only when &lt;B style=&quot;mso-bidi-font-weight: normal&quot;&gt;SignalType&lt;/B&gt; is a specific type.&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/LI&gt;&#x000D;&#x000A;&lt;UL&gt;&#x000D;&#x000A;&lt;LI class=MsoListParagraph style=&quot;MARGIN: 0in 0in 0pt; mso-list: l1 level2 lfo1&quot;&gt;&lt;B style=&quot;mso-bidi-font-weight: normal&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif&apos;&gt;IQ_Waveform_I&lt;/SPAN&gt;&lt;/B&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif&apos;&gt; specifies the file name of I part when &lt;B style=&quot;mso-bidi-font-weight: normal&quot;&gt;SignalType&lt;/B&gt; is I/Q File.&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/LI&gt;&#x000D;&#x000A;&lt;LI class=MsoListParagraph style=&quot;MARGIN: 0in 0in 0pt; mso-list: l1 level2 lfo1&quot;&gt;&lt;B style=&quot;mso-bidi-font-weight: normal&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif&apos;&gt;IQ_Waveform_Q&lt;/SPAN&gt;&lt;/B&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif&apos;&gt; specifies the file name of I part when &lt;B style=&quot;mso-bidi-font-weight: normal&quot;&gt;SignalType&lt;/B&gt; is I/Q File.&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/LI&gt;&#x000D;&#x000A;&lt;LI class=MsoListParagraph style=&quot;MARGIN: 0in 0in 0pt; mso-list: l1 level2 lfo1&quot;&gt;&lt;B style=&quot;mso-bidi-font-weight: normal&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif&apos;&gt;IQ_Bandwidth&lt;/SPAN&gt;&lt;/B&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif&apos;&gt; specifies the nominal bandwidth when &lt;B style=&quot;mso-bidi-font-weight: normal&quot;&gt;SignalType&lt;/B&gt; is I/Q File.&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/LI&gt;&#x000D;&#x000A;&lt;LI class=MsoListParagraph style=&quot;MARGIN: 0in 0in 0pt; mso-list: l1 level2 lfo1&quot;&gt;&lt;B style=&quot;mso-bidi-font-weight: normal&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif&apos;&gt;IQ_EffectiveBandwidth&lt;/SPAN&gt;&lt;/B&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif&apos;&gt; specifies the effective bandwidth (excluding guard band) when &lt;B style=&quot;mso-bidi-font-weight: normal&quot;&gt;SignalType&lt;/B&gt; is I/Q File.&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/LI&gt;&#x000D;&#x000A;&lt;LI class=MsoListParagraph style=&quot;MARGIN: 0in 0in 0pt; mso-list: l1 level2 lfo1&quot;&gt;&lt;B style=&quot;mso-bidi-font-weight: normal&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif&apos;&gt;IQ_SampleRate&lt;/SPAN&gt;&lt;/B&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif&apos;&gt; specifies the sampling rate used by IQ waveform when &lt;B style=&quot;mso-bidi-font-weight: normal&quot;&gt;SignalType&lt;/B&gt; is I/Q File.&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/LI&gt;&#x000D;&#x000A;&lt;LI class=MsoListParagraph style=&quot;MARGIN: 0in 0in 0pt; mso-list: l1 level2 lfo1&quot;&gt;&lt;B style=&quot;mso-bidi-font-weight: normal&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif&apos;&gt;IQ_WaveformLength&lt;/SPAN&gt;&lt;/B&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif&apos;&gt; specifies the number of samples contained in the IQ waveform file when &lt;B style=&quot;mso-bidi-font-weight: normal&quot;&gt;SignalType&lt;/B&gt; is I/Q File.&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/LI&gt;&#x000D;&#x000A;&lt;LI class=MsoListParagraph style=&quot;MARGIN: 0in 0in 0pt; mso-list: l1 level2 lfo1&quot;&gt;&lt;B style=&quot;mso-bidi-font-weight: normal&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif&apos;&gt;LTE_Bandwidth&lt;/SPAN&gt;&lt;/B&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif&apos;&gt; specifies the bandwidth when &lt;B style=&quot;mso-bidi-font-weight: normal&quot;&gt;SignalType&lt;/B&gt; is LTE DL/LTE UL. 0: 1.4MHz; 1: 3MHz; 2: 5MHz; 3: 10MHz; 4:15MHz; 5:20MHz.&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/LI&gt;&#x000D;&#x000A;&lt;LI class=MsoListParagraph style=&quot;MARGIN: 0in 0in 0pt; mso-list: l1 level2 lfo1&quot;&gt;&lt;B style=&quot;mso-bidi-font-weight: normal&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif&apos;&gt;LTE_Modulation&lt;/SPAN&gt;&lt;/B&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif&apos;&gt; specifies the modulation format when &lt;B style=&quot;mso-bidi-font-weight: normal&quot;&gt;SignalType&lt;/B&gt; is LTE DL/LET UL. 0: QPSK; 1: 16QAM; 2: 64QAM.&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/LI&gt;&#x000D;&#x000A;&lt;LI class=MsoListParagraph style=&quot;MARGIN: 0in 0in 0pt; mso-list: l1 level2 lfo1&quot;&gt;&lt;B style=&quot;mso-bidi-font-weight: normal&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif&apos;&gt;WLAN11ac_Bandwidth&lt;/SPAN&gt;&lt;/B&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif&apos;&gt; specifies the bandwidth when &lt;B style=&quot;mso-bidi-font-weight: normal&quot;&gt;SignalType&lt;/B&gt; is WLAN11ac. 0: 20MHz; 1: 40MHz; 2: 80MHz; 3: 160MHz.&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/LI&gt;&#x000D;&#x000A;&lt;LI class=MsoListParagraph style=&quot;MARGIN: 0in 0in 0pt; mso-list: l1 level2 lfo1&quot;&gt;&lt;B style=&quot;mso-bidi-font-weight: normal&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif&apos;&gt;WLAN11ac_MCS&lt;/SPAN&gt;&lt;/B&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-ser