<Item XName="EquationText" Type="PartParam">
<DataEntry>%%% This is a simple example for DPD_PreDistorter&#x000D;&#x000A;%%% You can import your own IP here to customize the pre-distorter&#x000D;&#x000A;%%% The DPD model used in this example is memoryless&#x000D;&#x000A;%%% Input Ports:&#x000D;&#x000A;%%%&#x0009;&#x0009;&#x0009;DPD_Input: the input data to the PreDistorter&#x000D;&#x000A;%%%&#x0009;&#x0009;&#x0009;DPD_Coef:  DPD coefficients, which is the output of ModelExtractor&#x000D;&#x000A;%%% Output Ports:&#x000D;&#x000A;%%%&#x0009;&#x0009;&#x0009;DPD_Output: the output data after pre-distortion&#x000D;&#x000A;%%% Parameters:&#x000D;&#x000A;%%%&#x0009;&#x0009;&#x0009;NonlinearOrder: the nonlinear order of the pre-distorter&#x000D;&#x000A;%%%&#x0009;&#x0009;&#x0009;NumOfInputSamples: the number of samples to do pre-distortion in each run&#x000D;&#x000A;&#x000D;&#x000A;%%% Get parameters&#x000D;&#x000A;N = NumOfInputSamples;&#x000D;&#x000A;n = NonlinearOrder;&#x000D;&#x000A;&#x000D;&#x000A;%%% Get input data&#x000D;&#x000A;y = DPD_Input;&#x000D;&#x000A;p = DPD_Coef;&#x000D;&#x000A;&#x000D;&#x000A;%%%%%%%%%%%%%%%%%&#x000D;&#x000A;%%% Apply DPD %%%&#x000D;&#x000A;%%%%%%%%%%%%%%%%%&#x000D;&#x000A;A=zeros(N,n);&#x000D;&#x000A;yH_y = conj(y).*y;&#x000D;&#x000A;% Replace those very small samples which may cause exceptions&#x000D;&#x000A;% in the followed calculations&#x000D;&#x000A;zerosIndex = find(yH_y&lt;1e-100);&#x000D;&#x000A;yH_y(zerosIndex) = 1e-100; &#x000D;&#x000A;for k=1:n&#x000D;&#x000A;     A(:,k)=y.*yH_y.^(n-k);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;%output&#x000D;&#x000A;DPD_Output = A * p;&#x000D;&#x000A;</DataEntry>
<Description>Equation Text to Parse, edited in the equation set</Description>
<DocSymbol />
<IsSettable><T>Bool</T><D>0</D></IsSettable>
<Range />
<RunTimeTunable><T>Bool</T><D>0</D></RunTimeTunable>
<Show><T>Bool</T><D>0</D></Show>
