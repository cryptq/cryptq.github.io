<Item XName="Equations" Type="Equation">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>if Operation == 0&#x000D;&#x000A;&#x0009;Step1 = 0;&#x000D;&#x000A;&#x0009;Step2 = 1;&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;Step1 = 1;&#x000D;&#x000A;&#x0009;Step2 = 0;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if Meas_Option == 0&#x000D;&#x000A;&#x0009;MeasOff = 0;&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;MeasOff = 1;&#x000D;&#x000A;end&#x000D;&#x000A;&#x0009;&#x000D;&#x000A;if Meas_Option == 0 || Meas_Option == 1 || Meas_Option == 2&#x000D;&#x000A;&#x0009;MeasACP = 0;&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;MeasACP = 1;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if Meas_Option == 0 || Meas_Option == 1 || Meas_Option == 3&#x000D;&#x000A;&#x0009;MeasEVM = 0;&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;MeasEVM = 1;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;LengthRatioForEVM = 1;&#x000D;&#x000A;if SignalType == 1&#x000D;&#x000A;&#x0009;LengthRatioForEVM = 10;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if SignalType == 0&#x000D;&#x000A;&#x0009;SamplingRate = IQ_SamplingRate;&#x000D;&#x000A;&#x0009;&#x000D;&#x000A;&#x0009;ACLR_BW = IQ_EffectiveBandwidth;&#x000D;&#x000A;&#x0009;ACLR_Offset = IQ_Bandwidth;&#x000D;&#x000A;&#x0009;waveformLength = IQ_WaveformLength;&#x000D;&#x000A;&#x0009;extractionLength = waveformLength/2;&#x000D;&#x000A;&#x0009;RBW = 100e3;&#x000D;&#x000A;&#x0009;&#x000D;&#x000A;elseif SignalType == 1 || SignalType == 2&#x000D;&#x000A;&#x0009;LTE_BaseSamplingRateTable = [1.92, 3.84, 7.68, 15.36, 23.04, 30.72 ]*1e6;&#x000D;&#x000A;&#x0009;SamplingRate = LTE_BaseSamplingRateTable(LTE_Bandwidth + 1);&#x000D;&#x000A;&#x0009;&#x000D;&#x000A;&#x0009;LTE_BandwidthTable = [1.4, 3, 5, 10, 15, 20]*1e6;&#x000D;&#x000A;&#x0009;NumRB = [6,15,25,50,75,100];&#x000D;&#x000A;&#x0009;LTE_NumRB = NumRB(LTE_Bandwidth+1)*15e3*12;&#x000D;&#x000A;&#x0009;ACLR_BW = LTE_NumRB;&#x000D;&#x000A;&#x0009;ACLR_Offset = LTE_BandwidthTable(LTE_Bandwidth+1);&#x000D;&#x000A;&#x0009;waveformLength = floor(SamplingRate *2^(OversamplingRatio) * 0.01/10);&#x000D;&#x000A;&#x0009;extractionLength = waveformLength/2;&#x000D;&#x000A;&#x0009;RBW = 15e3;&#x000D;&#x000A;&#x000D;&#x000A;elseif SignalType == 3&#x000D;&#x000A;&#x0009;WLAN11ac_BaseSamplingRateTable = [20, 40, 80, 160 ]*1e6;&#x000D;&#x000A;&#x0009;SamplingRate = WLAN11ac_BaseSamplingRateTable(WLAN11ac_Bandwidth + 1);&#x000D;&#x000A;&#x0009;&#x000D;&#x000A;&#x0009;RBW = 312.5e3;&#x000D;&#x000A;&#x0009;WLAN11ac_ActiveBWTable = [56, 114, 242, 484]*RBW;&#x000D;&#x000A;&#x0009;ACLR_BW = WLAN11ac_ActiveBWTable(WLAN11ac_Bandwidth + 1);&#x000D;&#x000A;&#x0009;ACLR_Offset = WLAN11ac_BaseSamplingRateTable(WLAN11ac_Bandwidth+1);&#x000D;&#x000A;&#x0009;&#x000D;&#x000A;&#x0009;waveformLengthTable = [14640, 15040, 16000, 19840;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;14080, 14560, 15360, 19200;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;9680, 10240, 11520, 15360;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;13840, 14240, 15040, 18560;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;9520, 10080, 11200, 14720;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;13680, 14080, 15040, 18560;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;12240, 12800, 13760, 17280;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;11120, 11680, 12800, 16640;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;17840, 18080, 18560, 22400];&#x000D;&#x000A;&#x0009;waveformLength = waveformLengthTable(WLAN11ac_MCS + 1, WLAN11ac_Bandwidth + 1) *2^(OversamplingRatio);&#x000D;&#x000A;&#x0009;extractionLength = waveformLength/2;&#x000D;&#x000A;&#x0009;&#x000D;&#x000A;elseif SignalType == 4 || SignalType == 5&#x000D;&#x000A;&#x0009;NR_BandwidthTable =[5e6,10e6,15e6,20e6,25e6,30e6,40e6,50e6,60e6,70e6,80e6,90e6,100e6,200e6,400e6];&#x000D;&#x000A;&#x0009;SamplingRate = 2.^ceil(log2(NR_BandwidthTable(NR_Bandwidth+1)/15e3))*15e3;&#x000D;&#x000A;&#x0009;&#x000D;&#x000A;&#x0009;if FCarrier &lt; 24e9&#x000D;&#x000A;&#x0009;NR_FrequencyRange = 0;&#x000D;&#x000A;&#x0009;else&#x000D;&#x000A;&#x0009;NR_FrequencyRange = 1;&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;FR1NumRBsTable=[25,52,79,106,133,160,216,270,0,0,0,0,0;&#x000D;&#x000A;&#x0009;    11,24,38,51,65,78,106,133,162,189,217,245,273;&#x000D;&#x000A;&#x0009;    0,11,18,24,31,38,51,65,79,93,107,121,135];&#x000D;&#x000A;&#x0009;FR2NumRBsTable=[66,132,264,0;&#x000D;&#x000A;&#x0009;    32,66,132,264;&#x000D;&#x000A;&#x0009;    17,34,69,138];&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;if(NR_FrequencyRange == 0)&#x000D;&#x000A;&#x0009;    NR_NumRBs = FR1NumRBsTable(NR_Numerology+1,NR_Bandwidth+1);&#x000D;&#x000A;&#x0009;else&#x000D;&#x000A;&#x0009;    if(NR_Bandwidth&lt;10)&#x000D;&#x000A;&#x0009;        NumRBsIdx = 1;&#x000D;&#x000A;&#x0009;    else&#x000D;&#x000A;&#x0009;        NumRBsIdx = NR_Bandwidth-10;&#x000D;&#x000A;&#x0009;    end&#x000D;&#x000A;&#x0009;    NR_NumRBs = FR2NumRBsTable(NR_Numerology-1,NumRBsIdx);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x0009;&#x000D;&#x000A;&#x0009;RBW = 15e3*2^NR_Numerology;&#x000D;&#x000A;&#x0009;ACLR_BW = NR_NumRBs*RBW*12;&#x000D;&#x000A;&#x0009;ACLR_Offset = NR_BandwidthTable(NR_Bandwidth+1);&#x000D;&#x000A;&#x0009;waveformLength = floor(SamplingRate *2^(OversamplingRatio) * 0.01/10);&#x000D;&#x000A;&#x0009;extractionLength = waveformLength/2;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;DPD_NumOfDPDExtractionSamples=extractionLength;&#x000D;&#x000A;DPD_NumOfPredistortedSamples=waveformLength;&#x000D;&#x000A;Meas_ACLR_LowerBW=ACLR_BW;&#x000D;&#x000A;Meas_ACLR_LowerOffset=-ACLR_Offset;&#x000D;&#x000A;Meas_ACLR_RefBW = ACLR_BW;&#x000D;&#x000A;Meas_ACLR_RefOffset =0;&#x000D;&#x000A;Meas_ACLR_UpperBW=ACLR_BW;&#x000D;&#x000A;Meas_ACLR_UpperOffset=ACLR_Offset;&#x000D;&#x000A;Meas_Spectrum_ResBW=RBW;&#x000D;&#x000A;CFR_Filter_PassFreq = ACLR_BW / 2;&#x000D;&#x000A;CFR_Filter_StopFreq = ACLR_Offset / 2;&#x000D;&#x000A;CFR_BlockSize = waveformLength;&#x000D;&#x000A;&#x000D;&#x000A;setvariable(&apos;DPD_Application_Data&apos;, &apos;FCarrier&apos;, FCarrier);&#x000D;&#x000A;setvariable(&apos;DPD_Application_Data&apos;, &apos;SignalPower&apos;, SignalPower);&#x000D;&#x000A;setvariable(&apos;DPD_Application_Data&apos;, &apos;SignalType&apos;, SignalType);&#x000D;&#x000A;setvariable(&apos;DPD_Application_Data&apos;, &apos;Meas_ACLR_LowerBW&apos;, Meas_ACLR_LowerBW);&#x000D;&#x000A;setvariable(&apos;DPD_Application_Data&apos;, &apos;Meas_ACLR_LowerOffset&apos;, Meas_ACLR_LowerOffset);&#x000D;&#x000A;setvariable(&apos;DPD_Application_Data&apos;, &apos;Meas_ACLR_RefBW&apos;, Meas_ACLR_RefBW);&#x000D;&#x000A;setvariable(&apos;DPD_Application_Data&apos;, &apos;Meas_ACLR_RefOffset&apos;, Meas_ACLR_RefOffset);&#x000D;&#x000A;setvariable(&apos;DPD_Application_Data&apos;, &apos;Meas_ACLR_UpperBW&apos;, Meas_ACLR_UpperBW);&#x000D;&#x000A;setvariable(&apos;DPD_Application_Data&apos;, &apos;Meas_ACLR_UpperOffset&apos;, Meas_ACLR_UpperOffset);&#x000D;&#x000A;setvariable(&apos;DPD_Application_Data&apos;, &apos;Meas_Spectrum_ResBW&apos;, Meas_Spectrum_ResBW);&#x000D;&#x000A;&#x000D;&#x000A;if SignalType == 1&#x000D;&#x000A;EVM_SignalType=2;&#x000D;&#x000A;elseif SignalType == 2&#x000D;&#x000A;EVM_SignalType=3;&#x000D;&#x000A;elseif SignalType == 3&#x000D;&#x000A;EVM_SignalType=4;&#x000D;&#x000A;elseif SignalType == 4&#x000D;&#x000A;EVM_SignalType=7;&#x000D;&#x000A;elseif SignalType == 5&#x000D;&#x000A;EVM_SignalType=8;&#x000D;&#x000A;else&#x000D;&#x000A;EVM_SignalType=0;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;SamplingRate = SamplingRate *2^(OversamplingRatio);&#x000D;&#x000A;&#x000D;&#x000A;LengthOfPiece = floor(DPD_NumOfPredistortedSamples / 2);&#x000D;&#x000A;&#x000D;&#x000A;if (DPD_ModelType == 0)&#x000D;&#x000A;&#x0009;if (DPD_NonlinearOrderSelection==0)&#x000D;&#x000A;&#x0009;&#x0009;if (DPD_UseCustomModelExtractor==1)&#x000D;&#x000A;&#x0009;&#x0009;    CoefLength = floor((DPD_NonlinearOrder+1)/2);&#x000D;&#x000A;&#x0009;&#x0009;else&#x000D;&#x000A;&#x0009;&#x0009;    CoefLength = (DPD_MemoryOrder+1)*floor((DPD_NonlinearOrder+1)/2);&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;else&#x000D;&#x000A;&#x0009;&#x0009;if (DPD_UseCustomModelExtractor==1)&#x000D;&#x000A;&#x0009;&#x0009;    CoefLength = DPD_NonlinearOrder;&#x000D;&#x000A;&#x0009;&#x0009;else&#x000D;&#x000A;&#x0009;&#x0009;    CoefLength = (DPD_MemoryOrder+1) * DPD_NonlinearOrder;&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;K = floor((DPD_NonlinearOrder+1)/2);&#x000D;&#x000A;&#x0009;CoefLength = K * (DPD_MemoryOrder + 1) + DPD_CrossTermOrder * K * (K-1) / 2;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;%directory = getworkspacedir;&#x000D;&#x000A;WorkingFolderDirectory = strrep(WorkingFolderDirectory,&apos;\&apos;,&apos;/&apos;);&#x000D;&#x000A;%if exist(WorkingFolderDirectory, &apos;dir&apos;)&#x000D;&#x000A;&#x0009;directory = WorkingFolderDirectory;&#x000D;&#x000A;%else&#x000D;&#x000A;%&#x0009;error(&apos;%s is not a valid folder!&apos;, WorkingFolderDirectory);&#x000D;&#x000A;%end&#x000D;&#x000A;DPD_Coefficients_Real_FileName = [&apos;DPD_Coefficients_Real.txt&apos;];&#x000D;&#x000A;DPD_Coefficients_Imag_FileName = [&apos;DPD_Coefficients_Imag.txt&apos;];&#x000D;&#x000A;LUT_Power_File = [&apos;DPD_LUT_Power.txt&apos;];&#x000D;&#x000A;LUT_Gain_File = [&apos;DPD_LUT_Gain.txt&apos;];&#x000D;&#x000A;LUT_Phase_File = [&apos;DPD_LUT_Phase.txt&apos;];&#x000D;&#x000A;PA_Output_Real_FileName = &apos;PA_Output_Real.txt&apos;;&#x000D;&#x000A;PA_Output_Imag_FileName = &apos;PA_Output_Imag.txt&apos;;&#x000D;&#x000A;&#x000D;&#x000A;DPD_Coefficients_Real_FullFileName = [directory,&apos;/&apos;, DPD_Coefficients_Real_FileName];&#x000D;&#x000A;DPD_Coefficients_Imag_FullFileName = [directory,&apos;/&apos;, DPD_Coefficients_Imag_FileName];&#x000D;&#x000A;LUT_Power_FullFile = [directory,&apos;/&apos;, LUT_Power_File];&#x000D;&#x000A;LUT_Gain_FullFile = [directory,&apos;/&apos;, LUT_Gain_File];&#x000D;&#x000A;LUT_Phase_FullFile = [directory,&apos;/&apos;, LUT_Phase_File];&#x000D;&#x000A;NMSE_FileName = [directory,&apos;/NMSE.txt&apos;];&#x000D;&#x000A;Gain_FileName = [directory,&apos;/Gain1.txt&apos;];&#x000D;&#x000A;PA_Output_Real_FullFileName = [directory,&apos;/&apos;, PA_Output_Real_FileName];&#x000D;&#x000A;PA_Output_Imag_FullFileName = [directory,&apos;/&apos;, PA_Output_Imag_FileName];&#x000D;&#x000A;&#x000D;&#x000A;StartSample = 0;&#x000D;&#x000A;StopSample = DPD_NumOfPredistortedSamples;&#x000D;&#x000A;&#x000D;&#x000A;Gain_NoBackoff = 0.0;&#x000D;&#x000A;targetPower = 10*log10(SignalPower*1e3);&#x000D;&#x000A;waveformDuration = DPD_NumOfPredistortedSamples / SamplingRate;&#x000D;&#x000A;&#x000D;&#x000A;setvariable(&apos;DPD_Application_Data&apos;, &apos;directory&apos;, directory);&#x000D;&#x000A;&#x000D;&#x000A;if Operation == 0%for step 1 extraction&#x000D;&#x000A;&#x0009;PowerAlignment = 0.0;&#x000D;&#x000A;&#x0009;NMSE = 0.0;&#x000D;&#x000A;&#x0009;setvariable(&apos;DPD_Application_Data&apos;, &apos;NMSE&apos;, NMSE);&#x000D;&#x000A;else%for step 2 application&#x000D;&#x000A;&#x0009;% read step1&apos;s results&#x000D;&#x000A;&#x0009;&#x000D;&#x000A;&#x0009;if exist(Gain_FileName, &apos;file&apos;)&gt;0&#x000D;&#x000A;&#x0009;&#x0009;fileID = fopen(Gain_FileName, &apos;r&apos;);&#x000D;&#x000A;&#x0009;&#x0009;PowerAlignment = fscanf(fileID, &apos;%f&apos;);&#x000D;&#x000A;&#x0009;&#x0009;fclose(fileID);&#x000D;&#x000A;&#x0009;else&#x000D;&#x000A;&#x0009;    error(&apos;Gain1.txt does not exist. Please run DPD extraction first before applying DPD!&apos;);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;if exist(NMSE_FileName, &apos;file&apos;)&gt;0&#x000D;&#x000A;&#x0009;&#x0009;fileID = fopen(NMSE_FileName, &apos;r&apos;);&#x000D;&#x000A;&#x0009;&#x0009;NMSE = fscanf(fileID, &apos;%f&apos;);&#x000D;&#x000A;&#x0009;&#x0009;fclose(fileID);&#x000D;&#x000A;&#x0009;&#x0009;setvariable(&apos;DPD_Application_Data&apos;, &apos;NMSE&apos;, NMSE);&#x000D;&#x000A;&#x0009;else&#x000D;&#x000A;&#x0009;    error(&apos;Gain1.txt does not exist. Please run DPD extraction first before applying DPD!&apos;);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x0009;&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;if exist(PA_Output_Real_FullFileName, &apos;file&apos;)&gt;0 &amp;&amp; exist(PA_Output_Imag_FullFileName, &apos;file&apos;)&gt;0&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;else&#x000D;&#x000A;&#x0009;    error(&apos;PA_Output_Real.txt or PA_Output_Imag.txt does not exist. Please run DPD extraction first before applying DPD!&apos;);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if DPD_ModelType == 2&#x000D;&#x000A;&#x0009;DPD_CoeffImag = zeros(1,1);setvariable(&apos;DPD_Application_Data&apos;, &apos;DPD_CoeffImag&apos;, DPD_CoeffImag);&#x000D;&#x000A;&#x0009;DPD_CoeffReal = zeros(1,1);setvariable(&apos;DPD_Application_Data&apos;, &apos;DPD_CoeffReal&apos;, DPD_CoeffReal);&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;LUT_Power = zeros(1,1);setvariable(&apos;DPD_Application_Data&apos;, &apos;LUT_Power&apos;, LUT_Power);&#x000D;&#x000A;&#x0009;LUT_Gain = zeros(1,1);setvariable(&apos;DPD_Application_Data&apos;, &apos;LUT_Gain&apos;, LUT_Gain);&#x000D;&#x000A;&#x0009;LUT_Phase = zeros(1,1);setvariable(&apos;DPD_Application_Data&apos;, &apos;LUT_Phase&apos;, LUT_Phase);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;</Text>
<UnitUse><T>Int</T><D>2</D></UnitUse>
<Item XName="BPMgr" Type="BPMgr">
<BPLines><T>Array_I64</T><D>1;0;</D></BPLines>
<BPStates><T>Array_I64</T><D>1;0;</D></BPStates></Item>
<Item XName="EqnBlock" Type="EqnBlock">
