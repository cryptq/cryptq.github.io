<HideCondition>PUSCH_Enable == 0 || PTRS_Enable == 0</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>14</D></Validate></Item>
<Item XName="PUSCH_PTRS_ResourceElementOffset" Type="PartParam">
<DataEntry>[0]</DataEntry>
<Description>set the PTRS RE Offset for PUSCH PTRS signal generation when TransformPrecodingEnabled is NO. [0: 00; 1: 01; 2: 10; 3: 11]</Description>
