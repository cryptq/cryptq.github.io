<Item XName="CalculateEVM" UserName="CalculateEVM" Type="function">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>function EVM = CalculateEVM(SignalType, type)&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;EVM_Original_VarName={&apos;Original_EVM__Generic&apos;, &apos;Original_EVM__LTE_DL_EVM&apos;, &apos;Original_EVM__LTE_UL_EVM&apos;, &apos;Original_EVM__WLAN_11ac_Avg_DataRCE_dB&apos;, &apos;Original_EVM__NR_DL_EVM&apos;, &apos;Original_EVM__NR_UL_EVM&apos;}&#x000D;&#x000A;EVM_PA_VarName={&apos;PA_EVM__Generic&apos;, &apos;PA_EVM__LTE_DL_EVM&apos;, &apos;PA_EVM__LTE_UL_EVM&apos;, &apos;PA_EVM__WLAN_11ac_Avg_DataRCE_dB&apos;, &apos;PA_EVM__NR_DL_EVM&apos;, &apos;PA_EVM__NR_UL_EVM&apos;}&#x000D;&#x000A;EVM_DPD_PA_VarName={&apos;DPD_PA_EVM__Generic&apos;, &apos;DPD_PA_EVM__LTE_DL_EVM&apos;, &apos;DPD_PA_EVM__LTE_UL_EVM&apos;, &apos;DPD_PA_EVM__WLAN_11ac_Avg_DataRCE_dB&apos;, &apos;DPD_PA_EVM__NR_DL_EVM&apos;, &apos;DPD_PA_EVM__NR_UL_EVM&apos;}&#x000D;&#x000A;&#x000D;&#x000A;EVM = 999.0;&#x000D;&#x000A;&#x000D;&#x000A;if type==0&#x000D;&#x000A;&#x0009;EVM=getvariable(&apos;DPD_Application_Data&apos;, EVM_Original_VarName{SignalType+1});&#x000D;&#x000A;elseif type ==1&#x000D;&#x000A;&#x0009;EVM=getvariable(&apos;DPD_Application_Data&apos;, EVM_PA_VarName{SignalType+1});&#x000D;&#x000A;elseif type==2&#x000D;&#x000A;&#x0009;EVM=getvariable(&apos;DPD_Application_Data&apos;, EVM_DPD_PA_VarName{SignalType+1});&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;end</Text>
