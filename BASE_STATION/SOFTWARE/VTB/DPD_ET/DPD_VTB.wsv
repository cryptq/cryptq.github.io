<HideCondition>0==PUCCH_Enable || 0==PUCCH_Format</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>14</D></Validate></Item>
<Item XName="PUCCH_Enable" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>enable or disable PDCCH and its DMRS transmission</Description>
<Enum>NR_DL_MuxOFDMSym__PDCCH_Enable@5G Advanced Modem Enums</Enum>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="PUCCH_Format" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>PUCCH Formats</Description>
<Enum>NR_HARQ_Controller__PUCCH_Format@5G Advanced Modem Enums</Enum>
<HideCondition>0==PUCCH_Enable</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="PUCCH_Format3_4_Modulation" Type="PartParam">
<DataEntry>[1]</DataEntry>
<Description>the modulation format for PUCCH Format 3/4 in each slot. (0: Pi/2 BPSK, 1: QPSK)</Description>
<HideCondition>0==PUCCH_Enable || (PUCCH_Format ~= 3&amp;&amp;PUCCH_Format ~= 4)</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PUCCH_GroupHopping" Type="PartParam">
<DataEntry>[0]</DataEntry>
<Description>group hopping mode (6.3.2.2.1 of 38.211) for each PUCCH. 0: Neither; 1: Enabled; 2: Disable</Description>
<HideCondition>0==PUCCH_Enable || PUCCH_Format ==2</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PUCCH_HoppingID" Type="PartParam">
<DataEntry>[0]</DataEntry>
<Description>hopping ID (nID in 6.3.2.2.1 of 38.211) for each PUCCH.</Description>
<HideCondition>0==PUCCH_Enable || PUCCH_Format ==2</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PUCCH_IntraSlotHopping" Type="PartParam">
<DataEntry>[0]</DataEntry>
<Description>enable or disable intra slot hopping for format 1/3/4.</Description>
<HideCondition>0==PUCCH_Enable || (PUCCH_Format ~= 1&amp;&amp;PUCCH_Format ~= 3&amp;&amp;PUCCH_Format ~= 4)</HideCondition>
