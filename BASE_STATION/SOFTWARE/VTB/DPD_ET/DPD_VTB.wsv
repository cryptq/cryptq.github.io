<HideCondition>PUSCH_Enable==0</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PUSCH_DMRS_ConfigType" Type="PartParam">
<DataEntry>[0]</DataEntry>
<Description>dmrs configuration type for PUSCH. 0: Configuration Type 1; 1: Configuration Type 2.</Description>
