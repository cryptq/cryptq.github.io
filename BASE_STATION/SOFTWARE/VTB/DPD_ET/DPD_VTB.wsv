<Symbol>AutoSymDF</Symbol>
<Item XName="ModelsParamSet" Type="ModelsParamSet">
<Item XName="ModelSet_0" Type="ModelListEntry">
<Indentifier />
<ModelName>DPD_Source</ModelName>
<SymbolName>AutoSymDF</SymbolName>
<Item XName="ParamSet" Type="ParamSet">
<ParamOrder><T>Array_BString</T><D>1;32;FCarrier;SignalType;OversamplingRatio;IQ_Waveform_I;IQ_Waveform_Q;IQ_Bandwidth;IQ_SamplingRate;LTE_Bandwidth;LTE_Modulation;WLAN11ac_Bandwidth;WLAN11ac_MCS;NR_Bandwidth;NR_Numerology;NR_Modulation;NR_UL_TransformPrecodingEnabled;CFREnable;CFR_LTE_ClippingThreshold;CFR_LTE_EVMThreshold_QPSK;CFR_LTE_EVMThreshold_16QAM;CFR_LTE_EVMThreshold_64QAM;CFR_Algorithm;CFR_TargetPAPR_dB;CFR_Max_IterationNum;CFR_Beta;CFR_Max_WindowLength;CFR_BlockSize;CFR_ClippingThreshold;CFR_Filter_PassFreq;CFR_Filter_PassRipple;CFR_Filter_StopFreq;CFR_Filter_StopRipple;CFR_Filter_MaximumOrder</D></ParamOrder>
<Item XName="CFREnable" Type="PartParam">
<DataEntry>CFREnable</DataEntry>
<Description>whether enable CFR</Description>
<Enum>DPD_CFREnable@DPD Enums</Enum>
<Tunable><T>Bool</T><D>1</D></Tunable>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="CFR_Algorithm" Type="PartParam">
<DataEntry>CFR_Algorithm</DataEntry>
<Description>when CFR is enabled and SignalType is not LTE DL, specify CFR algorithm. 0 for clipping and filtering, 1 for peak windowing</Description>
<Enum />
<HideCondition>CFREnable==0 || SignalType == 1</HideCondition>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="CFR_Beta" Type="PartParam">
<DataEntry>CFR_Beta</DataEntry>
<Description>when CFR is enabled, CFR_Algorithm is Peak Windowing  and SignalType is not LTE DL, specify Kaiser windown adjustment parameter</Description>
<HideCondition>CFREnable==0 || SignalType == 1 || CFR_Algorithm ==0</HideCondition>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="CFR_BlockSize" Type="PartParam">
<DataEntry>CFR_BlockSize</DataEntry>
<Description>when CFR is enabled, CFR_Algorithm is Peak Windowing  and SignalType is not LTE DL, specify the blocksize for each CFR operation</Description>
<Enum />
<HideCondition>CFREnable==0 || SignalType == 1 || CFR_Algorithm ==0</HideCondition>
<Validate><T>Int</T><D>3</D></Validate></Item>
<Item XName="CFR_ClippingThreshold" Type="PartParam">
<DataEntry>=CFR_ClippingThreshold</DataEntry>
<Description>when CFR is enabled, SignalType is not LTE DL and CFR_Algorithm is Clipping and Filtering, specify the clipping threshlod in dB.</Description>
<HideCondition>CFREnable==0 || SignalType == 1 || CFR_Algorithm ==1</HideCondition>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="CFR_Filter_MaximumOrder" Type="PartParam">
<DataEntry>CFR_Filter_MaximumOrder</DataEntry>
<Description>when CFR is enabled, SignalType is not LTE DL and CFR_Algorithm is Clipping and Filtering, specify maximum filter order for Parks-McClellan filter design</Description>
<HideCondition>CFREnable==0 || SignalType == 1 || CFR_Algorithm ==1</HideCondition>
<Validate><T>Int</T><D>11</D></Validate></Item>
<Item XName="CFR_Filter_PassFreq" Type="PartParam">
<DataEntry>CFR_Filter_PassFreq</DataEntry>
<Description>when CFR is enabled, SignalType is not LTE DL and CFR_Algorithm is Clipping and Filtering, specify passband edge frequency</Description>
<HideCondition>CFREnable==0 || SignalType == 1 || CFR_Algorithm ==1</HideCondition>
<Unit><T>Int</T><D>1003</D></Unit>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="CFR_Filter_PassRipple" Type="PartParam">
<DataEntry>CFR_Filter_PassRipple</DataEntry>
<Description>when CFR is enabled, SignalType is not LTE DL and CFR_Algorithm is Clipping and Filtering, specify passband ripple in dB</Description>
<HideCondition>CFREnable==0 || SignalType == 1 || CFR_Algorithm ==1</HideCondition>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="CFR_Filter_StopFreq" Type="PartParam">
<DataEntry>CFR_Filter_StopFreq</DataEntry>
<Description>when CFR is enabled, SignalType is not LTE DL and CFR_Algorithm is Clipping and Filtering, specify stopband edge frequency</Description>
<HideCondition>CFREnable==0 || SignalType == 1 || CFR_Algorithm ==1</HideCondition>
<Unit><T>Int</T><D>1003</D></Unit>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="CFR_Filter_StopRipple" Type="PartParam">
<DataEntry>CFR_Filter_StopRipple</DataEntry>
<Description>when CFR is enabled, SignalType is not LTE DL and CFR_Algorithm is Clipping and Filtering, specify stopband ripple in dB</Description>
<HideCondition>CFREnable==0 || SignalType == 1 || CFR_Algorithm ==1</HideCondition>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="CFR_LTE_ClippingThreshold" Type="PartParam">
<DataEntry>CFR_LTE_ClippingThreshold</DataEntry>
<Description>when CFR is enabled and SignalType is not LTE DL, specify clipping threshold used in CFR</Description>
<HideCondition>SignalType~=1 || CFREnable==0</HideCondition>
<Tunable><T>Bool</T><D>1</D></Tunable>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="CFR_LTE_EVMThreshold_16QAM" Type="PartParam">
<DataEntry>CFR_LTE_EVMThreshold_16QAM</DataEntry>
<Description>when CFR is enabled and SignalType is LTE DL, specify EVM threshold for 16QAM</Description>
<HideCondition>SignalType~=1 || CFREnable==0</HideCondition>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="CFR_LTE_EVMThreshold_64QAM" Type="PartParam">
<DataEntry>CFR_LTE_EVMThreshold_64QAM</DataEntry>
<Description>when CFR is enabled and SignalType is LTE DL, specify EVM threshold for 64QAM</Description>
<HideCondition>SignalType~=1 || CFREnable==0</HideCondition>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="CFR_LTE_EVMThreshold_QPSK" Type="PartParam">
<DataEntry>CFR_LTE_EVMThreshold_QPSK</DataEntry>
<Description>when CFR is enabled and SignalType is LTE DL, specify EVM threshold for QPSK</Description>
<HideCondition>SignalType~=1 || CFREnable==0</HideCondition>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="CFR_Max_IterationNum" Type="PartParam">
<DataEntry>CFR_Max_IterationNum</DataEntry>
<Description>when CFR is enabled, CFR_Algorithm is Peak Windowing and SignalType is not LTE DL, specify maximum iteration times</Description>
<Enum />
<HideCondition>CFREnable==0 || SignalType == 1 || CFR_Algorithm ==0</HideCondition>
<Validate><T>Int</T><D>3</D></Validate></Item>
<Item XName="CFR_Max_WindowLength" Type="PartParam">
<DataEntry>CFR_Max_WindowLength</DataEntry>
<Description>when CFR is enabled, CFR_Algorithm is Peak Windowing  and SignalType is not LTE DL, specify maximum Kaiser window length</Description>
<Enum />
<HideCondition>CFREnable==0 || SignalType == 1 || CFR_Algorithm ==0</HideCondition>
<Validate><T>Int</T><D>3</D></Validate></Item>
<Item XName="CFR_TargetPAPR_dB" Type="PartParam">
<DataEntry>CFR_TargetPAPR_dB</DataEntry>
<Description>when CFR is enabled, CFR_Algorithm is Peak Windowing and SignalType is not LTE DL, specify traget PAPR value after CFR</Description>
<HideCondition>CFREnable==0 || SignalType == 1 || CFR_Algorithm ==0</HideCondition>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="FCarrier" Type="PartParam">
<DataEntry>FCarrier</DataEntry>
<Description>carrier center frequency</Description>
<Unit><T>Int</T><D>1001</D></Unit>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="IQ_Bandwidth" Type="PartParam">
<DataEntry>IQ_Bandwidth</DataEntry>
<Description>when SignalType is I/Q file, Signal Studio file and SDF file, specify their bandwidth</Description>
<HideCondition>SignalType~=0</HideCondition>
<Unit><T>Int</T><D>1003</D></Unit>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="IQ_SamplingRate" Type="PartParam">
<DataEntry>IQ_SamplingRate</DataEntry>
<Description>when SignalType is I/Q file, Signal Studio file and SDF file, specify their base sampling rate</Description>
<HideCondition>SignalType~=0</HideCondition>
<Unit><T>Int</T><D>1003</D></Unit>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="IQ_Waveform_I" Type="PartParam">
<DataEntry>=IQ_Waveform_I</DataEntry>
<Description>when SignalType is I/Q File, specify the file name of I part</Description>
<Enum />
<HideCondition>SignalType~=0</HideCondition>
<Validate><T>Int</T><D>10</D></Validate></Item>
<Item XName="IQ_Waveform_Q" Type="PartParam">
<DataEntry>=IQ_Waveform_Q</DataEntry>
<Description>when SignalType is I/Q File, specify the file name of Q part</Description>
<Enum />
<HideCondition>SignalType~=0</HideCondition>
<Validate><T>Int</T><D>10</D></Validate></Item>
<Item XName="LTE_Bandwidth" Type="PartParam">
<DataEntry>LTE_Bandwidth</DataEntry>
<Description>when SignalType is LTE DL or LTE UL, specify the bandwidth</Description>
<Enum>LTE_UL_Src_Bandwidth@LTE 8.9 Enums</Enum>
<HideCondition>SignalType~=1 &amp;&amp; SignalType~=2</HideCondition>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="LTE_Modulation" Type="PartParam">
<DataEntry>LTE_Modulation</DataEntry>
<Description>when SignalType is LTE DL or LTE UL, specify the modulation orders . (0:QPSK, 1:16QAM, 2:64QAM)</Description>
<Enum>DPD_LTE_ModulationFormat_VTB@DPD Enums</Enum>
<HideCondition>SignalType~=1 &amp;&amp; SignalType~=2</HideCondition>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="NR_Bandwidth" Type="PartParam">
<DataEntry>NR_Bandwidth</DataEntry>
<Description>when SignalType is NR DL or NR UL, specify its bandwidth</Description>
<Enum>NR_VSA_Gen__BandWidth@5G Advanced Modem Enums</Enum>
<HideCondition>SignalType~=4 &amp;&amp; SignalType~=5</HideCondition>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="NR_Modulation" Type="PartParam">
<DataEntry>NR_Modulation</DataEntry>
<Description>when SignalType is NR DL or NR UL, specify the modulation format. (0:BPSK or Pi/2 BPSK, 1:QPSK, 2:16QAM, 3:64QAM, 4:256QAM).</Description>
<Enum>DPD_NR_ModulationFormat_VTB@DPD Enums</Enum>
<HideCondition>SignalType~=4 &amp;&amp; SignalType~=5</HideCondition>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="NR_Numerology" Type="PartParam">
<DataEntry>NR_Numerology</DataEntry>
<Description>when SignalType is NR DL or NR UL, specify the numerology.</Description>
<Enum>DPD_NR_Numerology_VTB@DPD Enums</Enum>
<HideCondition>SignalType~=4 &amp;&amp; SignalType~=5</HideCondition>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="NR_UL_TransformPrecodingEnabled" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>when SignalType is NR UL, specify whether transform precoding is enabled</Description>
<Enum>NR_TransformPrecoder__TransformPrecodingEnabled@5G Advanced Modem Enums</Enum>
<HideCondition>SignalType~=5</HideCondition>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="OversamplingRatio" Type="PartParam">
<DataEntry>OversamplingRatio</DataEntry>
