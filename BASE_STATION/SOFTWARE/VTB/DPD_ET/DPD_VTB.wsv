<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PUSCH_BitInfoLength_CSI2" Type="PartParam">
<DataEntry>[10]</DataEntry>
<Description>The number of information bits of CSI2 in PUSCH.</Description>
<HideCondition>0==PUSCH_Enable || 0 == PUSCH_CSI2_Enabled</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
