<Item XName="CFREnable" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>whether enable CFR</Description>
<Enum>DPD_CFREnable@DPD Enums</Enum>
<Tunable><T>Bool</T><D>1</D></Tunable>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="CFR_Algorithm" Type="PartParam">
<DataEntry>1</DataEntry>
<Description>when CFR is enabled and SignalType is not LTE DL, specify CFR algorithm. 0 for clipping and filtering, 1 for peak windowing</Description>
<Enum>DPD_CFR_Algorithm_VTB@DPD Enums</Enum>
<HideCondition>CFREnable==0 || SignalType == 1</HideCondition>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="CFR_Beta" Type="PartParam">
<DataEntry>3.5</DataEntry>
<Description>when CFR is enabled, CFR_Algorithm is Peak Windowing  and SignalType is not LTE DL, specify Kaiser windown adjustment parameter</Description>
<HideCondition>CFREnable==0 || SignalType == 1 || CFR_Algorithm ==0</HideCondition>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="CFR_BlockSize" Type="PartParam">
<DataEntry>39080</DataEntry>
<Description>when CFR is enabled, CFR_Algorithm is Peak Windowing  and SignalType is not LTE DL, specify the blocksize for each CFR operation</Description>
<Enum />
<HideCondition>CFREnable==0 || SignalType == 1 || CFR_Algorithm ==0</HideCondition>
<Validate><T>Int</T><D>3</D></Validate></Item>
<Item XName="CFR_ClippingThreshold" Type="PartParam">
<DataEntry>2</DataEntry>
<Description>when CFR is enabled, SignalType is not LTE DL and CFR_Algorithm is Clipping and Filtering, specify the clipping threshlod in dB.</Description>
<HideCondition>CFREnable==0 || SignalType == 1 || CFR_Algorithm ==1</HideCondition>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="CFR_Filter_MaximumOrder" Type="PartParam">
<DataEntry>1300</DataEntry>
<Description>when CFR is enabled, SignalType is not LTE DL and CFR_Algorithm is Clipping and Filtering, specify maximum filter order for Parks-McClellan filter design</Description>
<HideCondition>CFREnable==0 || SignalType == 1 || CFR_Algorithm ==1</HideCondition>
<Validate><T>Int</T><D>11</D></Validate></Item>
<Item XName="CFR_Filter_PassFreq" Type="PartParam">
<DataEntry>39</DataEntry>
<Description>when CFR is enabled, SignalType is not LTE DL and CFR_Algorithm is Clipping and Filtering, specify passband edge frequency</Description>
<HideCondition>CFREnable==0 || SignalType == 1 || CFR_Algorithm ==1</HideCondition>
<Unit><T>Int</T><D>1003</D></Unit>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="CFR_Filter_PassRipple" Type="PartParam">
<DataEntry>0.1</DataEntry>
<Description>when CFR is enabled, SignalType is not LTE DL and CFR_Algorithm is Clipping and Filtering, specify passband ripple in dB</Description>
<HideCondition>CFREnable==0 || SignalType == 1 || CFR_Algorithm ==1</HideCondition>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="CFR_Filter_StopFreq" Type="PartParam">
<DataEntry>40</DataEntry>
<Description>when CFR is enabled, SignalType is not LTE DL and CFR_Algorithm is Clipping and Filtering, specify stopband edge frequency</Description>
<HideCondition>CFREnable==0 || SignalType == 1 || CFR_Algorithm ==1</HideCondition>
<Unit><T>Int</T><D>1003</D></Unit>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="CFR_Filter_StopRipple" Type="PartParam">
<DataEntry>70</DataEntry>
<Description>when CFR is enabled, SignalType is not LTE DL and CFR_Algorithm is Clipping and Filtering, specify stopband ripple in dB</Description>
<HideCondition>CFREnable==0 || SignalType == 1 || CFR_Algorithm ==1</HideCondition>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="CFR_LTE_ClippingThreshold" Type="PartParam">
<DataEntry>1.15e-05</DataEntry>
<Description>when CFR is enabled and SignalType is not LTE DL, specify clipping threshold used in CFR</Description>
<HideCondition>SignalType~=1 || CFREnable==0</HideCondition>
<Tunable><T>Bool</T><D>1</D></Tunable>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="CFR_LTE_EVMThreshold_16QAM" Type="PartParam">
<DataEntry>0.1</DataEntry>
<Description>when CFR is enabled and SignalType is LTE DL, specify EVM threshold for 16QAM</Description>
<HideCondition>SignalType~=1 || CFREnable==0</HideCondition>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="CFR_LTE_EVMThreshold_64QAM" Type="PartParam">
<DataEntry>0.1</DataEntry>
<Description>when CFR is enabled and SignalType is LTE DL, specify EVM threshold for 64QAM</Description>
<HideCondition>SignalType~=1 || CFREnable==0</HideCondition>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="CFR_LTE_EVMThreshold_QPSK" Type="PartParam">
<DataEntry>0.1</DataEntry>
<Description>when CFR is enabled and SignalType is LTE DL, specify EVM threshold for QPSK</Description>
<HideCondition>SignalType~=1 || CFREnable==0</HideCondition>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="CFR_Max_IterationNum" Type="PartParam">
<DataEntry>12</DataEntry>
<Description>when CFR is enabled, CFR_Algorithm is Peak Windowing and SignalType is not LTE DL, specify maximum iteration times</Description>
<Enum />
<HideCondition>CFREnable==0 || SignalType == 1 || CFR_Algorithm ==0</HideCondition>
<Validate><T>Int</T><D>3</D></Validate></Item>
<Item XName="CFR_Max_WindowLength" Type="PartParam">
<DataEntry>512</DataEntry>
<Description>when CFR is enabled, CFR_Algorithm is Peak Windowing  and SignalType is not LTE DL, specify maximum Kaiser window length</Description>
<Enum />
<HideCondition>CFREnable==0 || SignalType == 1 || CFR_Algorithm ==0</HideCondition>
<Validate><T>Int</T><D>3</D></Validate></Item>
<Item XName="CFR_TargetPAPR_dB" Type="PartParam">
<DataEntry>6.50</DataEntry>
<Description>when CFR is enabled, CFR_Algorithm is Peak Windowing and SignalType is not LTE DL, specify traget PAPR value after CFR</Description>
<HideCondition>CFREnable==0 || SignalType == 1 || CFR_Algorithm ==0</HideCondition>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="FCarrier" Type="PartParam">
<DataEntry>2412000000</DataEntry>
<Description>carrier center frequency</Description>
<Unit><T>Int</T><D>1001</D></Unit>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="IQ_Bandwidth" Type="PartParam">
<DataEntry>80</DataEntry>
<Description>when SignalType is I/Q file, Signal Studio file and SDF file, specify their bandwidth</Description>
