solid; PADDING-BOTTOM: 0in; PADDING-TOP: 0in; PADDING-LEFT: 5.4pt; BORDER-LEFT: #f0f0f0; PADDING-RIGHT: 5.4pt; BACKGROUND-COLOR: transparent; mso-border-alt: solid windowtext .5pt; mso-border-left-alt: solid windowtext .5pt; mso-border-top-alt: solid windowtext .5pt&quot; vAlign=top width=312&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 0pt 0.25in&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif&apos;&gt;256QAM&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&lt;/TD&gt;&lt;/TR&gt;&lt;/TBODY&gt;&lt;/TABLE&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 0pt 0.5in&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif&apos;&gt;&lt;o:p&gt;&amp;nbsp;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&lt;/BLOCKQUOTE&gt;&#x000D;&#x000A;&lt;UL style=&quot;MARGIN-TOP: 0in&quot; type=disc&gt;&#x000D;&#x000A;&lt;UL&gt;&#x000D;&#x000A;&lt;UL&gt;&#x000D;&#x000A;&lt;LI class=MsoListParagraph style=&quot;COLOR: #333333; MARGIN: 0in 0in 0pt; mso-list: l1 level2 lfo1&quot;&gt;&lt;B style=&quot;mso-bidi-font-weight: normal&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif; COLOR: windowtext&apos;&gt;NR_Bandwidth&lt;/SPAN&gt;&lt;/B&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif; COLOR: windowtext&apos;&gt; specifies the bandwidth when &lt;B style=&quot;mso-bidi-font-weight: normal&quot;&gt;SignalType&lt;/B&gt; is NR_DL/NR_UL. 0:&lt;/SPAN&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif; BACKGROUND: white&apos;&gt;5MHz, 1:10MHz, 2:15MHz, 3:20MHz, 4:25MHz, 5:30MHz, 6:40MHz, 7:50MHz, 8:60MHz, 9:70MHz, 10:80MHz, 11:90MHz, 12:100MHz, 13:200MHz, 14:400MHz&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/LI&gt;&#x000D;&#x000A;&lt;LI class=MsoListParagraph style=&quot;MARGIN: 0in 0in 0pt; mso-list: l1 level2 lfo1&quot;&gt;&lt;B style=&quot;mso-bidi-font-weight: normal&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif&apos;&gt;NR_Numerology&lt;/SPAN&gt;&lt;/B&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif&apos;&gt; specifies the subcarrier spacing when &lt;B style=&quot;mso-bidi-font-weight: normal&quot;&gt;SignalType&lt;/B&gt; is NR_DL/NR_UL. 0: 15kHz; 1:30kHz; 2: 60kHz; 3: 120kHz.&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/LI&gt;&#x000D;&#x000A;&lt;LI class=MsoListParagraph style=&quot;MARGIN: 0in 0in 0pt; mso-list: l1 level2 lfo1&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif&apos;&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif&apos;&gt;&lt;B style=&quot;mso-bidi-font-weight: normal&quot;&gt;NR_Modulation&lt;/B&gt; specifies the modulation format when &lt;B style=&quot;mso-bidi-font-weight: normal&quot;&gt;SignalType&lt;/B&gt; is NR_DL/NR_UL. 0:BPSK; 1:QPSK; 2:16QAM; 3:64QAM;4: 256QAM. BPSK is only valid when &lt;B style=&quot;mso-bidi-font-weight: normal&quot;&gt;SignalType&lt;/B&gt; is NR_UL and &lt;B style=&quot;mso-bidi-font-weight: normal&quot;&gt;NR_UL_TransformPrecodingEnabled &lt;/B&gt;is YES.&lt;/SPAN&gt;&lt;/LI&gt;&#x000D;&#x000A;&lt;LI class=MsoListParagraph style=&quot;MARGIN: 0in 0in 0pt; mso-list: l1 level2 lfo1&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif&apos;&gt;&lt;B style=&quot;mso-bidi-font-weight: normal&quot;&gt;NR_UL_TransformPrecodingEnabled &lt;/B&gt;specifies whether TransformPrecoding is enabled when &lt;B style=&quot;mso-bidi-font-weight: normal&quot;&gt;SignalType&lt;/B&gt; is NR_UL. If it&#x2019;s NO, NR uplink signal is CP-OFDM, otherwise, it&#x2019;s DFT-OFDM.&lt;o:p&gt;&lt;/o:p&gt;&lt;/LI&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/UL&gt;&lt;/UL&gt;&#x000D;&#x000A;&lt;LI class=MsoListParagraph style=&quot;MARGIN: 0in 0in 0pt; mso-list: l1 level1 lfo1&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif&apos;&gt;Below parameters are used to configure CFR.&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/LI&gt;&#x000D;&#x000A;&lt;UL style=&quot;MARGIN-TOP: 0in&quot; type=circle&gt;&#x000D;&#x000A;&lt;LI class=MsoListParagraph style=&quot;MARGIN: 0in 0in 0pt; mso-list: l1 level2 lfo1&quot;&gt;&lt;B style=&quot;mso-bidi-font-weight: normal&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif&apos;&gt;CFREnable&lt;/SPAN&gt;&lt;/B&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif&apos;&gt; specifies whether CFR is enabled. &lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/LI&gt;&#x000D;&#x000A;&lt;LI class=MsoListParagraph style=&quot;MARGIN: 0in 0in 0pt; mso-list: l1 level2 lfo1&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif&apos;&gt;Below parameters are active when &lt;B style=&quot;mso-bidi-font-weight: normal&quot;&gt;CFREnable&lt;/B&gt; is Yes and &lt;/SPAN&gt;&lt;B style=&quot;mso-bidi-font-weight: normal&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif; COLOR: #333333; mso-fareast-font-family: &quot;Times New Roman&quot;&apos;&gt;SignalType&lt;/SPAN&gt;&lt;/B&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif; COLOR: #333333; mso-fareast-font-family: &quot;Times New Roman&quot;&apos;&gt; is LTE_DL.&lt;/SPAN&gt;&lt;B style=&quot;mso-bidi-font-weight: normal&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif&apos;&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/B&gt;&lt;/LI&gt;&#x000D;&#x000A;&lt;UL style=&quot;MARGIN-TOP: 0in&quot; type=square&gt;&#x000D;&#x000A;&lt;LI class=MsoListParagraph style=&quot;COLOR: #333333; MARGIN: 0in 0in 0pt; mso-list: l1 level3 lfo1&quot;&gt;&lt;B style=&quot;mso-bidi-font-weight: normal&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif; COLOR: windowtext&apos;&gt;CFR_LTE_&lt;/SPAN&gt;&lt;/B&gt;&lt;B style=&quot;mso-bidi-font-weight: normal&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif; mso-fareast-font-family: &quot;Times New Roman&quot;&apos;&gt;ClippingThreshold&lt;/SPAN&gt;&lt;/B&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif; mso-fareast-font-family: &quot;Times New Roman&quot;&apos;&gt; specifies the threshold for the simple clipping. The maximum magnitude of the clipped signal would be no larger than &lt;B style=&quot;mso-bidi-font-weight: normal&quot;&gt;CFR_LTE_ClippingThreshold&lt;/B&gt;.&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/LI&gt;&#x000D;&#x000A;&lt;LI class=MsoListParagraph style=&quot;BACKGROUND: white; COLOR: #333333; MARGIN: 0in 0in 0pt; mso-list: l1 level3 lfo1; mso-margin-top-alt: auto; mso-margin-bottom-alt: auto&quot;&gt;&lt;B style=&quot;mso-bidi-font-weight: normal&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif; COLOR: windowtext&apos;&gt;CFR_LTE_&lt;/SPAN&gt;&lt;/B&gt;&lt;B style=&quot;mso-bidi-font-weight: normal&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif; mso-fareast-font-family: &quot;Times New Roman&quot;&apos;&gt;EVM_Threshold_QPSK&lt;/SPAN&gt;&lt;/B&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif; mso-fareast-font-family: &quot;Times New Roman&quot;&apos;&gt; specifies the EVM threshold set for QPSK symbols.&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/LI&gt;&#x000D;&#x000A;&lt;LI class=MsoListParagraph style=&quot;BACKGROUND: white; COLOR: #333333; MARGIN: 0in 0in 0pt; mso-list: l1 level3 lfo1; mso-margin-top-alt: auto; mso-margin-bottom-alt: auto&quot;&gt;&lt;B style=&quot;mso-bidi-font-weight: normal&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif; COLOR: windowtext&apos;&gt;CFR_LTE_&lt;/SPAN&gt;&lt;/B&gt;&lt;B style=&quot;mso-bidi-font-weight: normal&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif; mso-fareast-font-family: &quot;Times New Roman&quot;&apos;&gt;EVM_Threshold_16QAM&lt;/SPAN&gt;&lt;/B&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif; mso-fareast-font-family: &quot;Times New Roman&quot;&apos;&gt; specifies the EVM threshold set for 16QAM symbols.&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/LI&gt;&#x000D;&#x000A;&lt;LI class=MsoListParagraph style=&quot;BACKGROUND: white; COLOR: #333333; MARGIN: 0in 0in 0pt; mso-list: l1 level3 lfo1; mso-margin-top-alt: auto; mso-margin-bottom-alt: auto&quot;&gt;&lt;B style=&quot;mso-bidi-font-weight: normal&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif; COLOR: windowtext&apos;&gt;CFR_LTE_&lt;/SPAN&gt;&lt;/B&gt;&lt;B style=&quot;mso-bidi-font-weight: normal&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif; mso-fareast-font-family: &quot;Times New Roman&quot;&apos;&gt;EVM_Threshold_64QAM&lt;/SPAN&gt;&lt;/B&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif; mso-fareast-font-family: &quot;Times New Roman&quot;&apos;&gt; specifies the EVM threshold set for 64QAM symbols.&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/LI&gt;&lt;/UL&gt;&#x000D;&#x000A;&lt;LI class=MsoListParagraph style=&quot;COLOR: #333333; MARGIN: 0in 0in 0pt; mso-list: l1 level2 lfo1&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif; COLOR: windowtext&apos;&gt;Below parameters are active when &lt;B style=&quot;mso-bidi-font-weight: normal&quot;&gt;CFREnable&lt;/B&gt; is Yes and &lt;/SPAN&gt;&lt;B style=&quot;mso-bidi-font-weight: normal&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif; mso-fareast-font-family: &quot;Times New Roman&quot;&apos;&gt;SignalType&lt;/SPAN&gt;&lt;/B&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif; mso-fareast-font-family: &quot;Times New Roman&quot;&apos;&gt; is not LTE_DL.&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/LI&gt;&#x000D;&#x000A;&lt;UL style=&quot;MARGIN-TOP: 0in&quot; type=square&gt;&#x000D;&#x000A;&lt;LI class=MsoListParagraph style=&quot;MARGIN: 0in 0in 0pt; mso-list: l1 level3 lfo1&quot;&gt;&lt;B style=&quot;mso-bidi-font-weight: normal&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif&apos;&gt;CFR_Algorithm &lt;/SPAN&gt;&lt;/B&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif&apos;&gt;specifies the CFR algorithm to use.&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/LI&gt;&#x000D;&#x000A;&lt;LI class=MsoListParagraph style=&quot;COLOR: #333333; MARGIN: 0in 0in 0pt; mso-list: l1 level3 lfo1&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif; COLOR: windowtext&apos;&gt;Below parameters are active when &lt;B style=&quot;mso-bidi-font-weight: normal&quot;&gt;CFR_Algorithm &lt;/B&gt;is Clipping and Filtering&lt;/SPAN&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif; mso-fareast-font-family: &quot;Times New Roman&quot;&apos;&gt;.&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/LI&gt;&#x000D;&#x000A;&lt;UL style=&quot;MARGIN-TOP: 0in&quot; type=disc&gt;&#x000D;&#x000A;&lt;LI class=MsoListParagraph style=&quot;COLOR: #333333; MARGIN: 0in 0in 0pt; mso-list: l1 level4 lfo1&quot;&gt;&lt;B style=&quot;mso-bidi-font-weight: normal&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif; mso-fareast-font-family: &quot;Times New Roman&quot;&apos;&gt;CFR_ClippingThreshold&lt;/SPAN&gt;&lt;/B&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif; mso-fareast-font-family: &quot;Times New Roman&quot;&apos;&gt; specifies the clipping threshold in dB;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/LI&gt;&#x000D;&#x000A;&lt;LI class=MsoListParagraph style=&quot;COLOR: #333333; MARGIN: 0in 0in 0pt; mso-list: l1 level4 lfo1&quot;&gt;&lt;B style=&quot;mso-bidi-font-weight: normal&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif; mso-fareast-font-family: &quot;Times New Roman&quot;&apos;&gt;CFR_Filter_PassRipple&lt;/SPAN&gt;&lt;/B&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif; mso-fareast-font-family: &quot;Times New Roman&quot;&apos;&gt; specifies the passband ripple in dB.&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/LI&gt;&#x000D;&#x000A;&lt;LI class=MsoListParagraph style=&quot;COLOR: #333333; MARGIN: 0in 0in 0pt; mso-list: l1 level4 lfo1&quot;&gt;&lt;B style=&quot;mso-bidi-font-weight: normal&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif; mso-fareast-font-family: &quot;Times New Roman&quot;&apos;&gt;CFR_Filter_MaximumOrder&lt;/SPAN&gt;&lt;/B&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif; mso-fareast-font-family: &quot;Times New Roman&quot;&apos;&gt; specifies the maximum filter order for Parks-McClellan filter.&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/LI&gt;&lt;/UL&gt;&#x000D;&#x000A;&lt;LI class=MsoListParagraph style=&quot;COLOR: #333333; MARGIN: 0in 0in 0pt; mso-list: l1 level3 lfo1&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif; COLOR: windowtext&apos;&gt;Below parameters are active when &lt;B style=&quot;mso-bidi-font-weight: normal&quot;&gt;CFR_Algorithm &lt;/B&gt;is Clipping and Filtering&lt;/SPAN&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif; mso-fareast-font-family: &quot;Times New Roman&quot;&apos;&gt;.&lt;SPAN style=&quot;mso-tab-count: 1&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;/SPAN&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/LI&gt;&#x000D;&#x000A;&lt;UL style=&quot;MARGIN-TOP: 0in&quot; type=disc&gt;&#x000D;&#x000A;&lt;LI class=MsoListParagraph style=&quot;MARGIN: 0in 0in 0pt; mso-list: l1 level4 lfo1&quot;&gt;&lt;B style=&quot;mso-bidi-font-weight: normal&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif&apos;&gt;CFR_TargetPAPR_dB&lt;/SPAN&gt;&lt;/B&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif&apos;&gt; specifies the target PAPR value after CFR. It must be &amp;gt;=3.&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/LI&gt;&#x000D;&#x000A;&lt;LI class=MsoListParagraph style=&quot;MARGIN: 0in 0in 0pt; mso-list: l1 level4 lfo1&quot;&gt;&lt;B style=&quot;mso-bidi-font-weight: normal&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif&apos;&gt;CFR_Max_IterationNum&lt;/SPAN&gt;&lt;/B&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif&apos;&gt; specifies the maximum iteration number. Its range is [1,20].&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/LI&gt;&#x000D;&#x000A;&lt;LI class=MsoListParagraph style=&quot;MARGIN: 0in 0in 0pt; mso-list: l1 level4 lfo1&quot;&gt;&lt;B style=&quot;mso-bidi-font-weight: normal&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif&apos;&gt;CFR_Beta&lt;/SPAN&gt;&lt;/B&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif&apos;&gt; specifies the Kaiser window adjustment parameter. Its range is [2, 20].&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/LI&gt;&#x000D;&#x000A;&lt;LI class=MsoListParagraph style=&quot;MARGIN: 0in 0in 0pt; mso-list: l1 level4 lfo1&quot;&gt;&lt;B style=&quot;mso-bidi-font-weight: normal&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif&apos;&gt;CFR_Max_Window_Length&lt;/SPAN&gt;&lt;/B&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif&apos;&gt; specifies the maximum Kaiser window length.&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/LI&gt;&lt;/UL&gt;&lt;/UL&gt;&lt;/UL&gt;&#x000D;&#x000A;&lt;LI class=MsoListParagraph style=&quot;MARGIN: 0in 0in 0pt; mso-list: l1 level1 lfo1&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif&apos;&gt;Below parameters are used to define the DPD.&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/LI&gt;&#x000D;&#x000A;&lt;UL style=&quot;MARGIN-TOP: 0in&quot; type=circle&gt;&#x000D;&#x000A;&lt;LI class=MsoListParagraph style=&quot;MARGIN: 0in 0in 0pt; mso-list: l1 level2 lfo1&quot;&gt;&lt;B style=&quot;mso-bidi-font-weight: normal&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif&apos;&gt;DPD_ModelType&lt;/SPAN&gt;&lt;/B&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif&apos;&gt; specifies the DPD model to use. Memory Polynomial, Volterra Series and Look-Up Table. &lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/LI&gt;&#x000D;&#x000A;&lt;LI class=MsoListParagraph style=&quot;MARGIN: 0in 0in 0pt; mso-list: l1 level2 lfo1&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif&apos;&gt;Below parameters are active when &lt;B style=&quot;mso-bidi-font-weight: normal&quot;&gt;DPD_ModelType&lt;/B&gt; is Memory Polynomial or Volterra Series.&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/LI&gt;&#x000D;&#x000A;&lt;UL type=square&gt;&#x000D;&#x000A;&lt;LI class=MsoListParagraph style=&quot;MARGIN: 0in 0in 0pt; mso-list: l1 level3 lfo1; mso-margin-top-alt: auto; mso-margin-bottom-alt: auto&quot;&gt;&lt;B style=&quot;mso-bidi-font-weight: normal&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif&apos;&gt;DPD_ ModelIdentificationAlgorithm&lt;/SPAN&gt;&lt;/B&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif&apos;&gt; specifies the algorithm used for the DPD model identification: LSE using QR, LSE using SVD.&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/LI&gt;&#x000D;&#x000A;&lt;LI class=MsoListParagraph style=&quot;MARGIN: 0in 0in 0pt; mso-list: l1 level3 lfo1; mso-margin-top-alt: auto; mso-margin-bottom-alt: auto&quot;&gt;&lt;B style=&quot;mso-bidi-font-weight: normal&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif&apos;&gt;DPD_ MemoryOrder&lt;/SPAN&gt;&lt;/B&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif&apos;&gt; specifies the memory order of RF power amplifier deployed in wideband communication system.&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/LI&gt;&#x000D;&#x000A;&lt;LI class=MsoListParagraph style=&quot;MARGIN: 0in 0in 0pt; mso-list: l1 level3 lfo1; mso-margin-top-alt: auto; mso-margin-bottom-alt: auto&quot;&gt;&lt;B style=&quot;mso-bidi-font-weight: normal&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif&apos;&gt;DPD_ NonlinearOrder&lt;/SPAN&gt;&lt;/B&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif&apos;&gt; specifies the nonlinear order of RF power amplifier deployed in communication system.&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/LI&gt;&#x000D;&#x000A;&lt;LI class=MsoListParagraph style=&quot;MARGIN: 0in 0in 0pt; mso-list: l1 level3 lfo1; mso-margin-top-alt: auto; mso-margin-bottom-alt: auto&quot;&gt;&lt;B style=&quot;mso-bidi-font-weight: normal&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif&apos;&gt;DPD_NonlinearOrderSelection&lt;/SPAN&gt;&lt;/B&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif&apos;&gt; specifies whether to use odd order only for nonlinear effect.&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/LI&gt;&lt;/UL&gt;&#x000D;&#x000A;&lt;LI class=MsoListParagraph style=&quot;MARGIN: 0in 0in 0pt; mso-list: l1 level2 lfo1; mso-margin-top-alt: auto; mso-margin-bottom-alt: auto&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif&apos;&gt;Below parameters are active when &lt;B style=&quot;mso-bidi-font-weight: normal&quot;&gt;DPD_ModelType&lt;/B&gt; is Volterra Series.&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/LI&gt;&#x000D;&#x000A;&lt;UL type=square&gt;&#x000D;&#x000A;&lt;LI class=MsoListParagraph style=&quot;MARGIN: 0in 0in 0pt; mso-list: l1 level3 lfo1; mso-margin-top-alt: auto; mso-margin-bottom-alt: auto&quot;&gt;&lt;B style=&quot;mso-bidi-font-weight: normal&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif&apos;&gt;DPD_CrossTermOrder&lt;/SPAN&gt;&lt;/B&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif&apos;&gt; specifies the max order of the cross terms in Volterra polynomial.&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/LI&gt;&lt;/UL&gt;&#x000D;&#x000A;&lt;LI class=MsoListParagraph style=&quot;MARGIN: 0in 0in 0pt; mso-list: l1 level2 lfo1; mso-margin-top-alt: auto; mso-margin-bottom-alt: auto&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif&apos;&gt;Below parameters are active when &lt;B style=&quot;mso-bidi-font-weight: normal&quot;&gt;DPD_ModelType&lt;/B&gt; is LUT.&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/LI&gt;&#x000D;&#x000A;&lt;UL type=square&gt;&#x000D;&#x000A;&lt;LI class=MsoListParagraph style=&quot;MARGIN: 0in 0in 0pt; mso-list: l1 level3 lfo1; mso-margin-top-alt: auto; mso-margin-bottom-alt: auto&quot;&gt;&lt;B style=&quot;mso-bidi-font-weight: normal&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif&apos;&gt;DPD_LUTSize&lt;/SPAN&gt;&lt;/B&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif&apos;&gt; specifies the size of look up table.&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/LI&gt;&#x000D;&#x000A;&lt;LI class=MsoListParagraph style=&quot;MARGIN: 0in 0in 0pt; mso-list: l1 level3 lfo1; mso-margin-top-alt: auto; mso-margin-bottom-alt: auto&quot;&gt;&lt;B style=&quot;mso-bidi-font-weight: normal&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif&apos;&gt;DPD_LUTStep&lt;/SPAN&gt;&lt;/B&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif&apos;&gt; specifies the step of the input power of look up table.&lt;/SPAN&gt;&lt;/LI&gt;&lt;/UL&gt;&lt;/UL&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif&apos;&gt;&lt;FONT face=Calibri&gt;&#x000D;&#x000A;&lt;LI class=MsoListParagraph style=&quot;MARGIN: 0in 0in 0pt; mso-list: l1 level1 lfo1&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif&apos;&gt;Below parameters are used to define the ET.&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/LI&gt;&#x000D;&#x000A;&lt;UL&gt;&#x000D;&#x000A;&lt;LI class=MsoNormal style=&quot;MARGIN: 0in 0in 8pt&quot;&gt;&lt;/FONT&gt;&lt;STRONG&gt;ET_Enable&lt;/STRONG&gt; specifies whether enable Envelop&lt;!--__SearchResult__0--&gt;&lt;/A&gt;e&lt;/SPAN&gt; Tracking function.&lt;o:p&gt;&lt;/o:p&gt;&lt;/LI&gt;&#x000D;&#x000A;&lt;LI class=MsoNormal style=&quot;MARGIN: 0in 0in 8pt&quot;&gt;&lt;B style=&quot;mso-bidi-font-weight: normal&quot;&gt;ET_Vsupply&lt;/B&gt; specifies the fixed power supply voltage when &lt;STRONG&gt;ET_Enable&lt;/STRONG&gt; is NO.&lt;o:p&gt;&lt;/o:p&gt;&lt;/LI&gt;&#x000D;&#x000A;&lt;LI class=MsoListParagraph style=&quot;MARGIN: 0in 0in 0pt; mso-list: l1 level3 lfo1; mso-margin-top-alt: auto; mso-margin-bottom-alt: auto&quot;&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 8pt&quot;&gt;&lt;B style=&quot;mso-bidi-font-weight: normal&quot;&gt;ET_ShapingTable_FileName&lt;/B&gt; specifies a local file name that has shaping table when &lt;STRONG&gt;ET_Enable&lt;/STRONG&gt; is YES. This file must exist in the folder specified by &lt;STRONG&gt;WorkingFolderDirectory&lt;/STRONG&gt;. The file format of the shaping table is the same as an example below.&lt;o:p&gt;&lt;/o:p&gt;&lt;/P&gt;&lt;/LI&gt;&lt;/UL&gt;&lt;/UL&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 8pt 1in; mso-list: l1 level3 lfo1; mso-margin-top-alt: auto; mso-margin-bottom-alt: auto&quot;&gt;BEGIN GMDIF&lt;o:p&gt;&lt;/o:p&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 8pt 1in; mso-list: l1 level3 lfo1; mso-margin-top-alt: auto; mso-margin-bottom-alt: auto&quot;&gt;% Pin_dBm(1)&lt;SPAN style=&quot;mso-spacerun: yes&quot;&gt;&amp;nbsp;&amp;nbsp; &lt;/SPAN&gt;&lt;SPAN style=&quot;mso-tab-count: 1&quot;&gt;&lt;/SPAN&gt;voltage(1) &lt;o:p&gt;&lt;/o:p&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 8pt 1in; mso-list: l1 level3 lfo1; mso-margin-top-alt: auto; mso-margin-bottom-alt: auto&quot;&gt;&lt;o:p&gt;&amp;nbsp;&lt;/o:p&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 8pt 1in; mso-list: l1 level3 lfo1; mso-margin-top-alt: auto; mso-margin-bottom-alt: auto&quot;&gt;-7.530000000e+00 1.250000000e+00&lt;o:p&gt;&lt;/o:p&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 8pt 1in; mso-list: l1 level3 lfo1; mso-margin-top-alt: auto; mso-margin-bottom-alt: auto&quot;&gt;-1.150000000e+00 1.500000000e+00&lt;o:p&gt;&lt;/o:p&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 8pt 1in; mso-list: l1 level3 lfo1; mso-margin-top-alt: auto; mso-margin-bottom-alt: auto&quot;&gt;1.935000000e+00 1.750000000e+00&lt;o:p&gt;&lt;/o:p&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 8pt 1in; mso-list: l1 level3 lfo1; mso-margin-top-alt: auto; mso-margin-bottom-alt: auto&quot;&gt;4.070000000e+00 2.000000000e+00&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 8pt 1in; mso-list: l1 level3 lfo1; mso-margin-top-alt: auto; mso-margin-bottom-alt: auto&quot;&gt;...&amp;nbsp;&amp;nbsp; ...&lt;/P&gt;&#x000D;&#x000A;&lt;UL style=&quot;MARGIN-TOP: 0in&quot; type=disc&gt;&#x000D;&#x000A;&lt;UL&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/UL&gt;&#x000D;&#x000A;&lt;LI class=MsoListParagraph style=&quot;MARGIN: 0in 0in 0pt; mso-list: l1 level2 lfo1&quot;&gt;&lt;B style=&quot;mso-bidi-font-weight: normal&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif&apos;&gt;Meas_Option &lt;/SPAN&gt;&lt;/B&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif&apos;&gt;specifies the measurements to be performed. Reducing the measurements to be made can speed up the simulation.&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/LI&gt;&lt;/UL&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 0pt 1.25in&quot;&gt;&lt;B style=&quot;mso-bidi-font-weight: normal&quot;&gt;&lt;I style=&quot;mso-bidi-font-style: normal&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif&apos;&gt;All&lt;/SPAN&gt;&lt;/I&gt;&lt;/B&gt;&lt;B style=&quot;mso-bidi-font-weight: normal&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif&apos;&gt;: &lt;/SPAN&gt;&lt;/B&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif&apos;&gt;All the measurements will be performed, including&lt;B style=&quot;mso-bidi-font-weight: normal&quot;&gt; &lt;/B&gt;ACLR, EVM, AM-AM, AM-PM, Spectrum, and Waveform;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 0pt 1.25in&quot;&gt;&lt;B style=&quot;mso-bidi-font-weight: normal&quot;&gt;&lt;I style=&quot;mso-bidi-font-style: normal&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif&apos;&gt;ACP and EVM&lt;/SPAN&gt;&lt;/I&gt;&lt;/B&gt;&lt;B style=&quot;mso-bidi-font-weight: normal&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif&apos;&gt;: &lt;/SPAN&gt;&lt;/B&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif&apos;&gt;measure ACLR, EVM, and Spectrum.&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 0pt 1.25in&quot;&gt;&lt;B style=&quot;mso-bidi-font-weight: normal&quot;&gt;&lt;I style=&quot;mso-bidi-font-style: normal&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif&apos;&gt;ACP Only&lt;/SPAN&gt;&lt;/I&gt;&lt;/B&gt;&lt;B style=&quot;mso-bidi-font-weight: normal&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif&apos;&gt;: &lt;/SPAN&gt;&lt;/B&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif&apos;&gt;measure ACLR and spectrum.&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 0pt 1.25in&quot;&gt;&lt;B style=&quot;mso-bidi-font-weight: normal&quot;&gt;&lt;I style=&quot;mso-bidi-font-style: normal&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif&apos;&gt;EVM only&lt;/SPAN&gt;&lt;/I&gt;&lt;/B&gt;&lt;B style=&quot;mso-bidi-font-weight: normal&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif&apos;&gt;: &lt;/SPAN&gt;&lt;/B&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif&apos;&gt;measure EVM.&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 0pt&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif; mso-fareast-font-family: &quot;Times New Roman&quot;&apos;&gt;&lt;o:p&gt;&amp;nbsp;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 0pt&quot;&gt;&lt;SPAN lang=EN-GB style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif; mso-bidi-font-size: 10.0pt; mso-ansi-language: EN-GB&apos;&gt;Run &lt;B style=&quot;mso-bidi-font-weight: normal&quot;&gt;&lt;I style=&quot;mso-bidi-font-style: normal&quot;&gt;DPD&lt;SPAN style=&quot;mso-bidi-font-weight: bold; mso-bidi-font-style: italic&quot;&gt;_Analysis&lt;/SPAN&gt;&lt;/I&gt;&lt;/B&gt; and check the simulation results.&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;UL style=&quot;MARGIN-TOP: 0in&quot; type=disc&gt;&#x000D;&#x000A;&lt;UL style=&quot;MARGIN-TOP: 0in&quot; type=disc&gt;&#x000D;&#x000A;&lt;LI class=MsoListParagraph style=&quot;MARGIN: 0in 0in 0pt; mso-list: l0 level2 lfo2&quot;&gt;&lt;SPAN lang=EN-GB style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif; mso-bidi-font-size: 10.0pt; mso-ansi-language: EN-GB; mso-fareast-language: EN-US&apos;&gt;Table&lt;I&gt; &lt;B&gt;ACLR_Original&lt;/B&gt;&lt;/I&gt; shows &lt;/SPAN&gt;&lt;SPAN lang=EN-GB style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif; mso-ansi-language: EN-GB; mso-fareast-language: EN-US&apos;&gt;Adjacent Channel Leakage power Ratio measured on the original signal.&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/LI&gt;&#x000D;&#x000A;&lt;LI class=MsoListParagraph style=&quot;MARGIN: 0in 0in 0pt; mso-list: l0 level2 lfo2&quot;&gt;&lt;SPAN lang=EN-GB style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif; mso-bidi-font-size: 10.0pt; mso-ansi-language: EN-GB; mso-fareast-language: EN-US&apos;&gt;Table&lt;I&gt; &lt;B&gt;ACLR_PA&lt;/B&gt;&lt;/I&gt; shows &lt;/SPAN&gt;&lt;SPAN lang=EN-GB style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif; mso-ansi-language: EN-GB; mso-fareast-language: EN-US&apos;&gt;Adjacent Channel Leakage power Ratio measured on the PA output signal without DPD.&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/LI&gt;&#x000D;&#x000A;&lt;LI class=MsoListParagraph style=&quot;MARGIN: 0in 0in 0pt; mso-list: l0 level2 lfo2&quot;&gt;&lt;SPAN lang=EN-GB style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif; mso-bidi-font-size: 10.0pt; mso-ansi-language: EN-GB; mso-fareast-language: EN-US&apos;&gt;Table&lt;I&gt; &lt;B&gt;ACLR_withDPD&lt;/B&gt;&lt;/I&gt; shows &lt;/SPAN&gt;&lt;SPAN lang=EN-GB style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif; mso-ansi-language: EN-GB; mso-fareast-language: EN-US&apos;&gt;Adjacent Channel Leakage power Ratio measured on the PA output signal with DPD.&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/LI&gt;&#x000D;&#x000A;&lt;LI class=MsoListParagraph style=&quot;MARGIN: 0in 0in 0pt; mso-list: l0 level2 lfo2&quot;&gt;&lt;SPAN lang=EN-GB style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif; mso-ansi-language: EN-GB&apos;&gt;Graph &lt;/SPAN&gt;&lt;B&gt;&lt;I&gt;&lt;SPAN lang=EN-GB style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif; mso-ansi-language: EN-GB; mso-fareast-language: EN-US&apos;&gt;CCDF&lt;/SPAN&gt;&lt;/I&gt;&lt;/B&gt;&lt;SPAN lang=EN-GB style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif; mso-ansi-language: EN-GB; mso-fareast-language: EN-US&apos;&gt; shows the Complementary Cumulative Distribution Function measured on original signal, PA output signal without DPD and PA output signal with DPD.&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/LI&gt;&#x000D;&#x000A;&lt;LI class=MsoListParagraph style=&quot;MARGIN: 0in 0in 0pt; mso-list: l0 level2 lfo2&quot;&gt;&lt;SPAN lang=EN-GB style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif; mso-ansi-language: EN-GB&apos;&gt;Graph &lt;B style=&quot;mso-bidi-font-weight: normal&quot;&gt;&lt;I style=&quot;mso-bidi-font-style: normal&quot;&gt;DPD_PA_AM_AM_Normalized&lt;/I&gt;&lt;/B&gt; shows the normalized AMAM curve measured on PA without DPD and PA with DPD.&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/LI&gt;&#x000D;&#x000A;&lt;LI class=MsoListParagraph style=&quot;MARGIN: 0in 0in 0pt; mso-list: l0 level2 lfo2&quot;&gt;&lt;SPAN lang=EN-GB style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif; mso-ansi-language: EN-GB&apos;&gt;Graph &lt;B style=&quot;mso-bidi-font-weight: normal&quot;&gt;&lt;I style=&quot;mso-bidi-font-style: normal&quot;&gt;DPD_PA_AM_PM&lt;/I&gt;&lt;/B&gt; shows the AMPM curve measured on PA without DPD and PA with DPD.&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/LI&gt;&#x000D;&#x000A;&lt;LI class=MsoListParagraph style=&quot;MARGIN: 0in 0in 0pt; mso-list: l0 level2 lfo2&quot;&gt;&lt;SPAN lang=EN-GB style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif; mso-ansi-language: EN-GB&apos;&gt;Table &lt;B style=&quot;mso-bidi-font-weight: normal&quot;&gt;&lt;I style=&quot;mso-bidi-font-style: normal&quot;&gt;DPD_PA_MeanPower_PeakPower&lt;/I&gt;&lt;/B&gt; shows the PAPR, Peak Power and Mean Power measured on PA output signal with DPD.&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/LI&gt;&#x000D;&#x000A;&lt;LI class=MsoListParagraph style=&quot;MARGIN: 0in 0in 0pt; mso-list: l0 level2 lfo2&quot;&gt;&lt;SPAN lang=EN-GB style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif; mso-ansi-language: EN-GB&apos;&gt;Table &lt;B style=&quot;mso-bidi-font-weight: normal&quot;&gt;&lt;I style=&quot;mso-bidi-font-style: normal&quot;&gt;PA_MeanPower_PeakPower&lt;/I&gt;&lt;/B&gt; shows the PAPR, Peak Power and Mean Power measured on PA output signal without DPD.&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/LI&gt;&#x000D;&#x000A;&lt;LI class=MsoListParagraph style=&quot;MARGIN: 0in 0in 0pt; mso-list: l0 level2 lfo2&quot;&gt;&lt;SPAN lang=EN-GB style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif; mso-ansi-language: EN-GB&apos;&gt;Table &lt;B style=&quot;mso-bidi-font-weight: normal&quot;&gt;&lt;I style=&quot;mso-bidi-font-style: normal&quot;&gt;EVM&lt;/I&gt;&lt;/B&gt; shows the EVM &lt;/SPAN&gt;&lt;SPAN lang=EN-GB style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif; mso-ansi-language: EN-GB; mso-fareast-language: EN-US&apos;&gt;measured on original signal, PA output signal without DPD and PA output signal with DPD.&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/LI&gt;&#x000D;&#x000A;&lt;LI class=MsoListParagraph style=&quot;MARGIN: 0in 0in 0pt; mso-list: l0 level2 lfo2&quot;&gt;&lt;SPAN lang=EN-GB style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif; mso-ansi-language: EN-GB&apos;&gt;Table &lt;B style=&quot;mso-bidi-font-weight: normal&quot;&gt;&lt;I style=&quot;mso-bidi-font-style: normal&quot;&gt;NMSE&lt;/I&gt;&lt;/B&gt; shows the NMSE which evaluate the accuracy of extracted DPD model. The lower the NMSE, the more accurate of DPD model.&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/LI&gt;&#x000D;&#x000A;&lt;LI class=MsoListParagraph style=&quot;MARGIN: 0in 0in 0pt; mso-list: l0 level2 lfo2&quot;&gt;&lt;SPAN lang=EN-GB style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif; mso-fareast-font-family: &quot;Times New Roman&quot;; mso-ansi-language: EN-GB; mso-fareast-language: EN-US&apos;&gt;Graph &lt;B&gt;&lt;I&gt;Spectrum&lt;/I&gt;&lt;/B&gt; shows the spectrum in complex voltage of &lt;/SPAN&gt;&lt;SPAN lang=EN-GB style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif; mso-ansi-language: EN-GB; mso-fareast-language: EN-US&apos;&gt;original signal, PA output signal without DPD and PA output signal with DPD.&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/LI&gt;&#x000D;&#x000A;&lt;LI class=MsoListParagraph style=&quot;MARGIN: 0in 0in 0pt; mso-list: l0 level2 lfo2&quot;&gt;&lt;SPAN lang=EN-GB style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif; mso-fareast-font-family: &quot;Times New Roman&quot;; mso-ansi-language: EN-GB; mso-fareast-language: EN-US&apos;&gt;Graph &lt;B&gt;&lt;I&gt;Waveform &lt;/I&gt;&lt;/B&gt;shows the original time domain waveform.&lt;/SPAN&gt;&lt;SPAN style=&apos;FONT-SIZE: 10pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif; mso-fareast-font-family: &quot;Times New Roman&quot;&apos;&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/LI&gt;&lt;/UL&gt;&lt;/UL&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 0pt&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif; mso-ansi-language: EN-GB&apos;&gt;&lt;SPAN style=&quot;mso-spacerun: yes&quot;&gt;&amp;nbsp;&lt;/SPAN&gt;&lt;SPAN lang=EN-GB&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 0pt&quot;&gt;&lt;SPAN lang=EN-GB style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif; mso-ansi-language: EN-GB&apos;&gt;Note:&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;OL style=&quot;MARGIN-TOP: 0in&quot; type=1&gt;&#x000D;&#x000A;&lt;OL style=&quot;MARGIN-TOP: 0in&quot; type=1&gt;&#x000D;&#x000A;&lt;LI class=MsoListParagraph style=&quot;MARGIN: 0in 0in 0pt; mso-list: l2 level2 lfo3&quot;&gt;&lt;SPAN lang=EN-GB style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif; mso-ansi-language: EN-GB&apos;&gt;For those parameters set to be hidden in the workspace&#x2019;s parameter list, they are internally determined in the Equation according to the specified &lt;B style=&quot;mso-bidi-font-weight: normal&quot;&gt;SignalType&lt;/B&gt;. By doing this, the setup of signal can be simplified and easy to use.&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/LI&gt;&#x000D;&#x000A;&lt;LI class=MsoListParagraph style=&quot;MARGIN: 0in 0in 0pt; mso-list: l2 level2 lfo3&quot;&gt;&lt;SPAN lang=EN-GB style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif; mso-ansi-language: EN-GB&apos;&gt;DPD is performed with two steps. Run first step by setting Operation to 0, and second step by setting Operation to 1. The measurements results are valid only after running step 1 and step 2. Only running one step may result in error or wrong measurement results.&lt;/SPAN&gt;&lt;/LI&gt;&#x000D;&#x000A;&lt;LI class=MsoListParagraph style=&quot;MARGIN: 0in 0in 0pt; mso-list: l2 level2 lfo3&quot;&gt;&lt;SPAN lang=EN-GB style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif; mso-ansi-language: EN-GB&apos;&gt;&lt;SPAN lang=EN-GB style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif; mso-ansi-language: EN-GB&apos;&gt;If the SignalType is I/Q File, the EVM measurement is invalid.&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/LI&gt;&#x000D;&#x000A;&lt;LI class=MsoListParagraph style=&quot;MARGIN: 0in 0in 0pt; mso-list: l2 level2 lfo3&quot;&gt;&lt;SPAN lang=EN-GB style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif; mso-ansi-language: EN-GB&apos;&gt;The performance may be degraded if the stimulus signal is a burst one with idle part.&lt;/SPAN&gt;&lt;/LI&gt;&#x000D;&#x000A;&lt;LI class=MsoListParagraph style=&quot;MARGIN: 0in 0in 0pt; mso-list: l2 level2 lfo3&quot;&gt;&lt;SPAN lang=EN-GB style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif; mso-ansi-language: EN-GB&apos;&gt;&lt;SPAN lang=EN-GB style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif; mso-ansi-language: EN-GB&apos;&gt;&lt;SPAN lang=EN-GB style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif; mso-ansi-language: EN-GB&apos;&gt;Don&apos;t delete the data set DPD_ET_Application_Data. There are equations to do post processing.&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/LI&gt;&lt;/OL&gt;&lt;/OL&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 0pt&quot;&gt;&lt;SPAN lang=EN-GB style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif; mso-ansi-language: EN-GB&apos;&gt;&lt;o:p&gt;&amp;nbsp;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 0pt&quot;&gt;&lt;SPAN lang=EN-GB style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif; mso-ansi-language: EN-GB&apos;&gt;&lt;o:p&gt;&amp;nbsp;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;</Text>
