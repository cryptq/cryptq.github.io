<HideCondition>PUSCH_Enable==0</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PUSCH_DMRS_n_RS_ID" Type="PartParam">
<DataEntry>[0]</DataEntry>
<Description>it&apos;s used when generating PUSCH DMRS sequence when Transform Precoding is enabled. Please refer to 6.4.1.1.1.2 in 38.211.</Description>
<HideCondition>0==TransformPrecodingEnabled || PUSCH_Enable==0</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PUSCH_DMRS_n_SCID" Type="PartParam">
<DataEntry>[0]</DataEntry>
<Description>used for PUSCH DMRS initialization (0/1).</Description>
<HideCondition>1==TransformPrecodingEnabled || PUSCH_Enable==0</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PUSCH_Enable" Type="PartParam">
<DataEntry>1</DataEntry>
<Description>enable or disable PDSCH and its DMRS transmission</Description>
<Enum>NR_UL_MuxOFDMSym__PUSCH_Enable@5G Advanced Modem Enums</Enum>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="PUSCH_FreqHoppingRBOffset" Type="PartParam">
<DataEntry>[0]</DataEntry>
<Description>The RB offset number for frequency hopping.</Description>
<Enum />
<HideCondition>PUSCH_Enable==0</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PUSCH_FreqHoppingType" Type="PartParam">
<DataEntry>[0]</DataEntry>
<Description>The type of PUSCH frequency hopping. 0: None;  1: Intra-Slot Frequency Hopping;  2: Inter-Slot Frequency Hopping</Description>
<Enum />
<HideCondition>PUSCH_Enable==0</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PUSCH_HARQACK_BetaOffsetIndex" Type="PartParam">
<DataEntry>[0]</DataEntry>
<Description>The beta offset index of HARQACK when multiplexing with UL_SCH. Range: 0 - 15.</Description>
<HideCondition>0==PUSCH_Enable</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PUSCH_HARQACK_Enabled" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>Enable or disable HARQACK when UCI is multiplexed with UL-SCH.</Description>
<Enum>NR_HARQ_Controller__PUSCH_Enable@5G Advanced Modem Enums</Enum>
<HideCondition>0==PUSCH_Enable</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="PUSCH_MappingType" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>PDSCH mapping type (A or B)</Description>
<Enum>NR_HARQ_Controller__PUSCH_MappingType@5G Advanced Modem Enums</Enum>
<HideCondition>PUSCH_Enable==0</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="PUSCH_NumAllocatedSlots" Type="PartParam">
<DataEntry>NumAllocatedSlots</DataEntry>
<Description>Number of allocated slots for PUSCH in each frame for each BWP.The size of this parameter is equal to NumBWPs</Description>
<HideCondition>PUSCH_Enable==0</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PUSCH_NumAntennaPorts" Type="PartParam">
<DataEntry>[1]</DataEntry>
