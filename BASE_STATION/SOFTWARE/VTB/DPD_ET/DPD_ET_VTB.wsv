<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PUSCH_PTRS_FrequencyDensity" Type="PartParam">
<DataEntry>[0]</DataEntry>
<Description>set the Frequency Density (K_PTRS) for PUSCH PTRS signal when TransformPrecodingEnabled is NO. [0: 2 RBs; 1: 4 RBs]</Description>
<Enum />
<HideCondition>PUSCH_Enable == 0 || PTRS_Enable == 0 || TransformPrecodingEnabled == 1</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PUSCH_PTRS_N_ID" Type="PartParam">
<DataEntry>[0]</DataEntry>
<Description>nPUSCH-Identity used to generate PTRS sequence when TransformPrecoding is enabled.</Description>
<HideCondition>PUSCH_Enable == 0 || PTRS_Enable == 0 || TransformPrecodingEnabled == 0</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PUSCH_PTRS_NumGroup" Type="PartParam">
<DataEntry>[0]</DataEntry>
<Description>the number of PTRS groups for each PUSCH when TransformPrecodingEnabled is YES. [0: 2; 1: 4; 2: 8].</Description>
<HideCondition>PUSCH_Enable == 0 || PTRS_Enable == 0 || TransformPrecodingEnabled == 0</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PUSCH_PTRS_NumPorts" Type="PartParam">
<DataEntry>[1]</DataEntry>
<Description>the number of PTRS ports used by each PUSCH when TransformPrecodingEnabled is NO. Range 1~2.</Description>
<Enum />
<HideCondition>PUSCH_Enable == 0 || PTRS_Enable == 0 || TransformPrecodingEnabled == 1</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PUSCH_PTRS_NumSamplePerGroup" Type="PartParam">
<DataEntry>[0]</DataEntry>
<Description>the number of samples per PTRS group for each PUSCH when TransformPrecodingEnabled is YES. [0: 2; 1: 4;].</Description>
<HideCondition>PUSCH_Enable == 0 || PTRS_Enable == 0 || TransformPrecodingEnabled == 0</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PUSCH_PTRS_PowerBoosting" Type="PartParam">
<DataEntry>[0]</DataEntry>
<Description>PUSCH PTRS power boosting in dB for each PUSCH PTRS.</Description>
