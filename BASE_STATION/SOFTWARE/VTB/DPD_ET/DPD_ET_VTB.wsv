<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PUCCH_PowerBoosting" Type="PartParam">
<DataEntry>[0]</DataEntry>
<Description>power boosting for each PUCCH in dB.</Description>
<HideCondition>0==PUCCH_Enable</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>14</D></Validate></Item>
<Item XName="PUCCH_R_max_UCI" Type="PartParam">
<DataEntry>[0.5]</DataEntry>
