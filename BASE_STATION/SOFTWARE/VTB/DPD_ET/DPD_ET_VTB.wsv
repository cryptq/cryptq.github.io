<Item XName="EquationText" Type="PartParam">
<DataEntry>function Initialize()&#x000D;&#x000A;&#x0009;if ET_Enable == 1 %&#x000D;&#x000A;&#x0009;&#x0009;% Set up code and pre-allocation goes here&#x000D;&#x000A;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;if exist(ShapingTable_FileName, &apos;file&apos;) &lt;= 0&#x000D;&#x000A;&#x0009;&#x0009;    error(&apos;%s does not exist. Please run Generate_ETPA_ShapingTable first before applying ET!&apos;, ShapingTable_FileName);&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;fid = fopen(ShapingTable_FileName,&apos;r&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;str1 = fgetl(fid);&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;&#x0009;if (ischar( str1))&#x000D;&#x000A;&#x0009;&#x0009;  find_header = strfind(str1,&apos;BEGIN GMDIF&apos;);&#x000D;&#x000A;&#x0009;&#x0009;  loop_ind = 0;&#x000D;&#x000A;&#x0009;&#x0009;  loop_max = 10;&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;&#x0009;  while(find_header &lt;0 &amp;&amp; loop_ind &lt; loop_max)&#x000D;&#x000A;&#x0009;&#x0009;    str1 = fgetl(fid);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;if ( ischar( str1 ) &lt;1)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;  break;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;    find_header = strfind(str1,&apos;BEGIN GMDIF&apos;);&#x000D;&#x000A;&#x0009;&#x0009;    loop_ind = loop_ind + 1;&#x000D;&#x000A;&#x0009;&#x0009;  end&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;&#x0009;  if (find_header &gt; 0)   % find file header&#x000D;&#x000A;&#x0009;&#x0009;    str1 = fgetl(fid);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;if ( ischar( str1 ) &lt;1)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;  fclose(fid);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;  return;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;&#x0009;    find_variable = strfind(str1,&apos;% Pin_dBm(1)&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;loop_ind = 0;&#x000D;&#x000A;&#x0009;&#x0009;    &#x000D;&#x000A;&#x0009;&#x0009;&#x0009;while(find_variable &lt;0 &amp;&amp; loop_ind &lt; loop_max)&#x000D;&#x000A;&#x0009;&#x0009;      str1 = fgetl(fid);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;  if ( ischar( str1 ) &lt;1)&#x000D;&#x000A;&#x0009;  &#x0009;&#x0009;    fclose(fid);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;    return;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;  end&#x000D;&#x000A;&#x0009;&#x0009;      find_variable = strfind(str1,&apos;% Pin_dBm(1)&apos;);&#x000D;&#x000A;&#x0009;&#x0009;      loop_ind = loop_ind + 1;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;if(find_variable &gt; 0)   % find file header&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;  line_count = 0;&#x000D;&#x000A;&#x0009;&#x0009;      str1 = fgetl(fid);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;  line_end = 0;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;  while ( ischar( str1 ) &gt; 0 &amp;&amp; line_end ==0)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;    [data count] = sscanf(str1, &apos;%f %f&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;if (count == 2)&#x000D;&#x000A;&#x0009;&#x0009;          line_count = line_count + 1;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;  M_State.data_x(line_count) = data(1);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;  M_State.data_y(line_count) = data(2);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;str1 = fgetl(fid);&#x000D;&#x000A;&#x0009;&#x0009;    &#x000D;&#x000A;&#x0009;&#x0009;&#x0009;    if ( ischar( str1 ) &gt;0)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;      find_end = strfind(str1,&apos;END&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;  if (find_end &gt;0)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;    line_end = 1;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;  end&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;    else&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;  line_end = 2;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;  end&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;end&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;  end&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;&#x0009;fclose(fid);&#x000D;&#x000A;&#x0009;else&#x000D;&#x000A;&#x0009;&#x0009;M_State.data_x(1) = 0;&#x000D;&#x000A;&#x0009;&#x0009;M_State.data_y(1) = Vsupply(1);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;function Run()&#x000D;&#x000A;    % compute outputs based on inputs&#x000D;&#x000A;    signal_power =10*log10( real(input.*conj(input)) /100+1e-20) + 30;&#x000D;&#x000A;    &#x000D;&#x000A;&#x0009;if length(M_State.data_x) &gt; 1&#x000D;&#x000A;&#x0009;&#x0009;if(signal_power &lt; M_State.data_x(1))&#x000D;&#x000A;&#x0009;&#x0009;  output = M_State.data_y(1)&#x000D;&#x000A;&#x0009;&#x0009;elseif (signal_power &gt; M_State.data_x(end))&#x000D;&#x000A;&#x0009;&#x0009;  output = M_State.data_y(end)&#x000D;&#x000A;&#x0009;&#x0009;else&#x000D;&#x000A;&#x0009;&#x0009;  output =  interp1(M_State.data_x,M_State.data_y,signal_power,&apos;linear&apos;,&apos;extrap&apos;);&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;else&#x000D;&#x000A;&#x0009;&#x0009;output = M_State.data_y(1);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end</DataEntry>
