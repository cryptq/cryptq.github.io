<DataEntry>OversamplingRatio</DataEntry>
<Description>oversample option</Description>
<Enum>FBMC_ChannelEstimator__OversampleOption@5G Advanced Modem Enums</Enum>
<Show><T>Bool</T><D>0</D></Show>
<Unit><T>Int</T><D>0</D></Unit>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="PTRS_Enable" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>enable or disable Phase-tracking reference signals transmission</Description>
<Enum>NR_HARQ_Controller__HARQ_Enable@5G Advanced Modem Enums</Enum>
<HideCondition>0 == PUSCH_Enable</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="PUCCH_AdditionalDMRS" Type="PartParam">
<DataEntry>[0]</DataEntry>
<Description>set additional DMRS for PUCCH format 3 and format 4.</Description>
<HideCondition>0==PUCCH_Enable || (PUCCH_Format ~= 3&amp;&amp;PUCCH_Format ~= 4)</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PUCCH_AllocatedSlots" Type="PartParam">
<DataEntry>[0:9]</DataEntry>
<Description>Allocated slot indices for PUCCH in each frame for all BWPs. The index starts from 0 to (N-1), where N is the number of slots per frame.</Description>
<HideCondition>0==PUCCH_Enable</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PUCCH_CSI2_Enabled" Type="PartParam">
<DataEntry>[0]</DataEntry>
<Description>enable or disable CSI part 2.</Description>
<HideCondition>0==PUCCH_Enable || (PUCCH_Format ~= 3&amp;&amp;PUCCH_Format ~= 4)</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PUCCH_CyclicShift" Type="PartParam">
<DataEntry>[0]</DataEntry>
<Description>m0 in the Sequence selection of PUCCH format 0 for each BWP.</Description>
<HideCondition>0==PUCCH_Enable || (PUCCH_Format ~= 0&amp;&amp;PUCCH_Format ~= 1)</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PUCCH_DMRS_N_ID0" Type="PartParam">
<DataEntry>[0]</DataEntry>
<Description>used for PUCCH DMRS initialization (0~65535). Given by the higher-layer parameters scramblingID0.</Description>
<HideCondition>0==PUCCH_Enable || PUCCH_Format ~= 2</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PUCCH_DMRS_PowerBoosting" Type="PartParam">
<DataEntry>[0]</DataEntry>
<Description>DMRS power boosting for each PUCCH in dB.</Description>
<HideCondition>0==PUCCH_Enable || 0==PUCCH_Format</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>14</D></Validate></Item>
<Item XName="PUCCH_Enable" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>enable or disable PDCCH and its DMRS transmission</Description>
<Enum>NR_DL_MuxOFDMSym__PDCCH_Enable@5G Advanced Modem Enums</Enum>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="PUCCH_Format" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>PUCCH Formats</Description>
<Enum>NR_HARQ_Controller__PUCCH_Format@5G Advanced Modem Enums</Enum>
<HideCondition>0==PUCCH_Enable</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="PUCCH_Format3_4_Modulation" Type="PartParam">
<DataEntry>[1]</DataEntry>
<Description>the modulation format for PUCCH Format 3/4 in each slot. (0: Pi/2 BPSK, 1: QPSK)</Description>
<HideCondition>0==PUCCH_Enable || (PUCCH_Format ~= 3&amp;&amp;PUCCH_Format ~= 4)</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PUCCH_GroupHopping" Type="PartParam">
<DataEntry>[0]</DataEntry>
<Description>group hopping mode (6.3.2.2.1 of 38.211) for each PUCCH. 0: Neither; 1: Enabled; 2: Disable</Description>
<HideCondition>0==PUCCH_Enable || PUCCH_Format ==2</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PUCCH_HoppingID" Type="PartParam">
<DataEntry>[0]</DataEntry>
<Description>hopping ID (nID in 6.3.2.2.1 of 38.211) for each PUCCH.</Description>
<HideCondition>0==PUCCH_Enable || PUCCH_Format ==2</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PUCCH_IntraSlotHopping" Type="PartParam">
<DataEntry>[0]</DataEntry>
<Description>enable or disable intra slot hopping for format 1/3/4.</Description>
<HideCondition>0==PUCCH_Enable || (PUCCH_Format ~= 1&amp;&amp;PUCCH_Format ~= 3&amp;&amp;PUCCH_Format ~= 4)</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PUCCH_NumAllocatedSlots" Type="PartParam">
<DataEntry>[10]</DataEntry>
<Description>Number of allocated slots for PUCCH in each frame for each BWP.The size of this parameter is equal to NumBWPs</Description>
<HideCondition>0==PUCCH_Enable</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PUCCH_NumOFDMSyms" Type="PartParam">
<DataEntry>[1]</DataEntry>
<Description>number of OFDM symbols for each PUCCH.</Description>
<HideCondition>0==PUCCH_Enable</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PUCCH_NumRBs" Type="PartParam">
<DataEntry>[1]</DataEntry>
<Description>number of resource blocks (RBs) for each PUCCH.</Description>
<HideCondition>0==PUCCH_Enable</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PUCCH_OCCIndex" Type="PartParam">
<DataEntry>[0]</DataEntry>
<Description>the OCC Index for PUCCH format 1/4 sequence generation.</Description>
<HideCondition>0==PUCCH_Enable || (PUCCH_Format ~=4&amp;&amp;PUCCH_Format ~= 1)</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PUCCH_OCCLength" Type="PartParam">
<DataEntry>[2]</DataEntry>
<Description>the OCC length for PUCCH format 4. It can be 2 or 4.</Description>
<HideCondition>0==PUCCH_Enable || PUCCH_Format ~= 4</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PUCCH_PowerBoosting" Type="PartParam">
<DataEntry>[0]</DataEntry>
<Description>power boosting for each PUCCH in dB.</Description>
<HideCondition>0==PUCCH_Enable</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>14</D></Validate></Item>
<Item XName="PUCCH_R_max_UCI" Type="PartParam">
<DataEntry>[0.5]</DataEntry>
<Description>the configured maximum PUCCH coding rate for format 3/4. 0 ~ 1</Description>
<HideCondition>0==PUCCH_Enable || (PUCCH_Format ~= 3&amp;&amp;PUCCH_Format ~= 4)</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>14</D></Validate></Item>
<Item XName="PUCCH_SR_Configuration" Type="PartParam">
<DataEntry>[0]</DataEntry>
<Description>SR Configuration for each PUCCH. 0: Negative; 1: Positive</Description>
<HideCondition>0==PUCCH_Enable || PUCCH_Format ~= 0</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PUCCH_SecondHopRB" Type="PartParam">
<DataEntry>[0]</DataEntry>
<Description>the index of the first resource blocks (RB)for the Second Hop allocated to each PUCCH format 1/3/4.</Description>
<HideCondition>0==PUCCH_Enable || (PUCCH_Format ~= 1&amp;&amp;PUCCH_Format ~= 3&amp;&amp;PUCCH_Format ~= 4)</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PUCCH_StartOFDMSym" Type="PartParam">
<DataEntry>[0]</DataEntry>
<Description>the index for the first OFDM symbol allocated to each PUCCH.</Description>
<HideCondition>0==PUCCH_Enable</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PUCCH_StartRB" Type="PartParam">
<DataEntry>[0]</DataEntry>
<Description>the index of the first resource blocks (RB) allocated to each PUCCH.</Description>
<HideCondition>0==PUCCH_Enable</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PUCCH_n_ID" Type="PartParam">
<DataEntry>[0]</DataEntry>
<Description>data-scrambling-Identity for each PUCCH. 0 ~ 1023 or CellID.</Description>
<HideCondition>0==PUCCH_Enable || (PUCCH_Format ~= 2&amp;&amp;PUCCH_Format ~= 3&amp;&amp;PUCCH_Format ~= 4)</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PUCCH_n_RNTI" Type="PartParam">
<DataEntry>[0]</DataEntry>
<Description>radio network temporary identifier for each PUCCH.</Description>
<HideCondition>0==PUCCH_Enable || (PUCCH_Format ~= 2&amp;&amp;PUCCH_Format ~= 3&amp;&amp;PUCCH_Format ~= 4)</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PUSCH_AllocatedSlots" Type="PartParam">
<DataEntry>AllocatedSlots</DataEntry>
<Description>Allocated slot indices for PUSCH in each frame for all BWPs. The index starts from 0 to (N-1), where N is the number of slots per frame.</Description>
<HideCondition>PUSCH_Enable==0</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PUSCH_BitInfoLength_CSI1" Type="PartParam">
<DataEntry>[10]</DataEntry>
