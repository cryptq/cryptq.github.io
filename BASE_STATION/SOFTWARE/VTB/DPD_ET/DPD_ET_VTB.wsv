<DataEntry>[10]</DataEntry>
<Description>Number of allocated slots for PUCCH in each frame for each BWP.The size of this parameter is equal to NumBWPs</Description>
<HideCondition>0==PUCCH_Enable</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PUCCH_NumOFDMSyms" Type="PartParam">
<DataEntry>[1]</DataEntry>
<Description>number of OFDM symbols for each PUCCH.</Description>
<HideCondition>0==PUCCH_Enable</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PUCCH_NumRBs" Type="PartParam">
<DataEntry>[1]</DataEntry>
<Description>number of resource blocks (RBs) for each PUCCH.</Description>
<HideCondition>0==PUCCH_Enable</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PUCCH_OCCIndex" Type="PartParam">
<DataEntry>[0]</DataEntry>
