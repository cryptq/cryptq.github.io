<ParamOrder><T>Array_BString</T><D>1;11;EVM_SignalType;FCarrier;Base_SamplingRate;OversamplingOption;LTE_Bandwidth;LTE_Modulation;WLAN11ac_Bandwidth;NR_Bandwidth;NR_Numerology;NR_Modulation;NR_UL_TransformPrecodingEnabled</D></ParamOrder>
<Item XName="Base_SamplingRate" Type="PartParam">
<DataEntry>IQ_SamplingRate</DataEntry>
