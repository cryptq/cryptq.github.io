<Text>if (CFREnable == 1)&#x000D;&#x000A;    if (CFR_Algorithm==0)&#x000D;&#x000A;&#x0009;    UseCFR1 = 0;&#x000D;&#x000A;&#x0009;&#x0009;UseCFR2 = 1;&#x000D;&#x000A;&#x0009;else &#x000D;&#x000A;&#x0009;&#x0009;UseCFR2 = 0;&#x000D;&#x000A;&#x0009;&#x0009;UseCFR1 = 1;&#x000D;&#x000A;&#x0009;end;&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;UseCFR1 = 1;&#x000D;&#x000A;&#x0009;UseCFR2 = 2;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;if SignalType==1&#x000D;&#x000A;&#x0009;UseCFR1 = 1;&#x000D;&#x000A;&#x0009;UseCFR2 = 1;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;UseFileReader = 1-(SignalType==0);&#x000D;&#x000A;LTE_DL_Enable = 1-(SignalType==1);&#x000D;&#x000A;LTE_UL_Enable = 1-(SignalType==2);&#x000D;&#x000A;WLAN_11ac_Enable = 1-(SignalType==3);&#x000D;&#x000A;NR_DL_Enable = 1-(SignalType==4);&#x000D;&#x000A;NR_UL_Enable = 1-(SignalType==5);&#x000D;&#x000A;MPDULength=0;&#x000D;&#x000A;if SignalType == 0 &#x000D;&#x000A;&#x0009;SamplingRate = IQ_SamplingRate;&#x000D;&#x000A;elseif SignalType == 1 || SignalType == 2&#x000D;&#x000A;&#x0009;LTE_BaseSamplingRateTable = [1.92, 3.84, 7.68, 15.36, 23.04, 30.72 ]*1e6;&#x000D;&#x000A;&#x0009;SamplingRate = LTE_BaseSamplingRateTable(LTE_Bandwidth + 1);&#x000D;&#x000A;elseif SignalType == 3&#x000D;&#x000A;&#x0009;WLAN11ac_BaseSamplingRateTable = [20, 40, 80, 160 ]*1e6;&#x000D;&#x000A;&#x0009;SamplingRate = WLAN11ac_BaseSamplingRateTable(WLAN11ac_Bandwidth + 1);&#x000D;&#x000A;&#x0009;if WLAN11ac_MCS == 0&#x000D;&#x000A;&#x0009;&#x0009;MPDULength = 512;&#x000D;&#x000A;&#x0009;elseif WLAN11ac_MCS &lt; 3&#x000D;&#x000A;&#x0009;&#x0009;MPDULength = 512*2;&#x000D;&#x000A;&#x0009;elseif WLAN11ac_MCS &lt; 5&#x000D;&#x000A;&#x0009;&#x0009;MPDULength = 512*4;&#x000D;&#x000A;&#x0009;elseif WLAN11ac_MCS &lt; 8&#x000D;&#x000A;&#x0009;&#x0009;MPDULength = 512*8;&#x000D;&#x000A;&#x0009;elseif WLAN11ac_MCS == 8&#x000D;&#x000A;&#x0009;&#x0009;MPDULength = 512*16;&#x0009;&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;elseif SignalType == 4 || SignalType == 5&#x000D;&#x000A;&#x0009;NR_BandwidthTable =[5e6,10e6,15e6,20e6,25e6,30e6,40e6,50e6,60e6,70e6,80e6,90e6,100e6,200e6,400e6];&#x000D;&#x000A;&#x0009;SamplingRate = 2.^ceil(log2(NR_BandwidthTable(NR_Bandwidth+1)/15e3))*15e3;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;SamplingRate = SamplingRate *2^(OversamplingRatio);&#x000D;&#x000A;&#x000D;&#x000A;NumRB = [6,15,25,50,75,100];&#x000D;&#x000A;LTE_NumRB = NumRB(LTE_Bandwidth+1);&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;% NR params&#x000D;&#x000A;if SignalType == 4&#x000D;&#x000A;&#x0009;if NR_Modulation ==0&#x000D;&#x000A;&#x0009;&#x0009;error(&apos;PI/2 BPSK is not supported by NR DL.&apos;);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if FCarrier &lt; 24e9&#x000D;&#x000A;NR_FrequencyRange = 0;&#x000D;&#x000A;else&#x000D;&#x000A;NR_FrequencyRange = 1;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;NumAllocatedSlots = 10*(2^NR_Numerology);&#x000D;&#x000A;AllocatedSlots = [0:NumAllocatedSlots-1];&#x000D;&#x000A;&#x000D;&#x000A;FR1NumRBsTable=[25,52,79,106,133,160,216,270,0,0,0,0,0;&#x000D;&#x000A;    11,24,38,51,65,78,106,133,162,189,217,245,273;&#x000D;&#x000A;    0,11,18,24,31,38,51,65,79,93,107,121,135];&#x000D;&#x000A;FR2NumRBsTable=[66,132,264,0;&#x000D;&#x000A;    32,66,132,264;&#x000D;&#x000A;    17,34,69,138];&#x000D;&#x000A;&#x000D;&#x000A;if(NR_FrequencyRange == 0)&#x000D;&#x000A;    NR_NumRBs = FR1NumRBsTable(NR_Numerology+1,NR_Bandwidth+1);&#x000D;&#x000A;else&#x000D;&#x000A;    if(NR_Bandwidth&lt;10)&#x000D;&#x000A;        NumRBsIdx = 1;&#x000D;&#x000A;    else&#x000D;&#x000A;        NumRBsIdx = NR_Bandwidth-10;&#x000D;&#x000A;    end&#x000D;&#x000A;    NR_NumRBs = FR2NumRBsTable(NR_Numerology-1,NumRBsIdx);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;</Text>
