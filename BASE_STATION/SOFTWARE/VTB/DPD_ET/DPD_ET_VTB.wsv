<HideCondition>0==PUCCH_Enable || (PUCCH_Format ~= 3&amp;&amp;PUCCH_Format ~= 4)</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>14</D></Validate></Item>
<Item XName="PUCCH_SR_Configuration" Type="PartParam">
<DataEntry>[0]</DataEntry>
<Description>SR Configuration for each PUCCH. 0: Negative; 1: Positive</Description>
<HideCondition>0==PUCCH_Enable || PUCCH_Format ~= 0</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PUCCH_SecondHopRB" Type="PartParam">
<DataEntry>[0]</DataEntry>
<Description>the index of the first resource blocks (RB)for the Second Hop allocated to each PUCCH format 1/3/4.</Description>
