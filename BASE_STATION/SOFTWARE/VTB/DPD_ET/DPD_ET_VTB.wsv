<Item XName="EquationSet" Type="PartParam">
<DataEntry />
<Description>Flags that we need a right-click &quot;Edit Equations&quot; menu</Description>
<DocSymbol />
<IsSettable><T>Bool</T><D>0</D></IsSettable>
<Range />
<RunTimeTunable><T>Bool</T><D>0</D></RunTimeTunable>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>4</D></Validate></Item>
<Item XName="EquationText" Type="PartParam">
<DataEntry>%%% This is a simple example for DPD_ModelExtractor&#x000D;&#x000A;%%% You can import your own IP here to customize the model extractor&#x000D;&#x000A;%%% The DPD model used in this example is memoryless&#x000D;&#x000A;%%% Input Ports:&#x000D;&#x000A;%%%&#x0009;&#x0009;&#x0009;PA_Out: the captured output data of the PA&#x000D;&#x000A;%%%&#x0009;&#x0009;&#x0009;PA_In:  the captured input data of the PA&#x000D;&#x000A;%%% Output Ports:&#x000D;&#x000A;%%%&#x0009;&#x0009;&#x0009;DPD_Coef: extracted DPD coefficients&#x000D;&#x000A;%%%&#x0009;&#x0009;&#x0009;Scaled_PA_Out: the PA output signal after power scaling&#x000D;&#x000A;%%%&#x0009;&#x0009;&#x0009;Shifted_PA_In: the PA input signal after timing adjustments&#x000D;&#x000A;%%%&#x0009;&#x0009;&#x0009;Scaled_PAOut_Piece: the scaled PA output signal used in model extraction&#x000D;&#x000A;%%%&#x0009;&#x0009;&#x0009;Shifted_PAIn_Piece: the PA input signal used in model extraction&#x000D;&#x000A;%%% Notes:&#x000D;&#x000A;%%% &#x0009;&#x0009;Only part(half in this example) of the PA input/output signal&#x000D;&#x000A;%%%         are used in model extraction&#x000D;&#x000A;%%% Parameters:&#x000D;&#x000A;%%%&#x0009;&#x0009;&#x0009;NonlinearOrder: the nonlinear order of the pre-distorter&#x000D;&#x000A;%%%&#x0009;&#x0009;&#x0009;NumOfInputSamples: the number of samples to do pre-distortion in each run&#x000D;&#x000A;&#x000D;&#x000A;%%% Get parameters&#x000D;&#x000A;N = NumOfInputSamples/2;&#x000D;&#x000A;n = NonlinearOrder;&#x000D;&#x000A;&#x000D;&#x000A;%%%%%%%%%%%%%%%%%%%%%%%%%&#x000D;&#x000A;%%% timing adjustments%%%&#x000D;&#x000A;%%%%%%%%%%%%%%%%%%%%%%%%%&#x000D;&#x000A;% The PA output and input timing should be well aligned before model extraction.&#x000D;&#x000A;% This example can only synchronize the signals in sample level.&#x000D;&#x000A;% It usually requires much more accurate synchronization in real world.&#x000D;&#x000A;% The signals can be synchronized at 1/128 sample level in DPD_ModelExtractor@DPD Models.&#x000D;&#x000A;% scale the PA out&#x000D;&#x000A;ScalePAOut =  PA_Out * max(abs(PA_In)) / max(abs(PA_Out));&#x000D;&#x000A;% use 1000 samples to estimate the delay&#x000D;&#x000A;PAOut_ForSync = ScalePAOut(1:1000); &#x000D;&#x000A;PAIn_ForSync = PA_In(1:1000);&#x000D;&#x000A;% get the delay in sample level&#x000D;&#x000A;Corr = ifft(fft(PAOut_ForSync).*conj(fft(PAIn_ForSync)));&#x000D;&#x000A;[CorrMax delay] = max(Corr); &#x000D;&#x000A;&#x000D;&#x000A;%%%%%%%%%%%%%%%%%%%%%&#x000D;&#x000A;%%% power scaling %%%&#x000D;&#x000A;%%%%%%%%%%%%%%%%%%%%%&#x000D;&#x000A;% The PA output signal is scaled in terms of mean power&#x000D;&#x000A;&#x000D;&#x000A;% sort the input signal&#x000D;&#x000A;[AbsPAIn_Sorted,idx] = sort(abs(PA_In)); &#x000D;&#x000A;PAIn_Sorted =  PA_In(idx);&#x000D;&#x000A;PAOut_Sorted = PA_Out(idx);&#x000D;&#x000A;% use the 80% small signal to calculate the factor&#x000D;&#x000A;Ns = floor(length(PA_In)*0.8);&#x000D;&#x000A;Factor = mean(abs(PAIn_Sorted(1:Ns)))/mean(abs(PAOut_Sorted(1:Ns)));&#x000D;&#x000A;PAOut_Scaled = PA_Out * Factor;&#x000D;&#x000A;&#x000D;&#x000A;%%%%%%%%%%%%%%%%%%%%%%%%&#x000D;&#x000A;%%% model extraction %%%&#x000D;&#x000A;%%%%%%%%%%%%%%%%%%%%%%%%&#x000D;&#x000A;% select samples for DPD model extraction&#x000D;&#x000A;% This example selects NumOfInputSamples/2 for model extraction&#x000D;&#x000A;&#x000D;&#x000A;% This example assumes the PA output is delayed relative to PA input&#x000D;&#x000A;PAIn_Piece = PA_In(1:NumOfInputSamples/2);&#x000D;&#x000A;PAOut_Piece= PAOut_Scaled(delay:NumOfInputSamples/2+delay-1);&#x000D;&#x000A;% Replace those very small samples which may cause exceptions&#x000D;&#x000A;% in the followed calculations&#x000D;&#x000A;zerosIdx = find(PAOut_Piece&lt;1e-100);&#x000D;&#x000A;PAOut_Piece(zerosIdx) = 1e-100;&#x000D;&#x000A;&#x000D;&#x000A;% Calculate the DPD models&#x000D;&#x000A;A = zeros(N,n);&#x000D;&#x000A;for k=1:n&#x000D;&#x000A;     A(:,k)=PAOut_Piece.*(conj(PAOut_Piece).*PAOut_Piece).^(n-k);&#x000D;&#x000A;end&#x000D;&#x000A;p_=((A&apos;*A)^(-1))*A&apos;*PAIn_Piece;&#x000D;&#x000A;&#x000D;&#x000A;%output&#x000D;&#x000A;DPD_Coef = p_;&#x000D;&#x000A;Scaled_PA_Out_Piece = PAOut_Piece;&#x000D;&#x000A;Shifted_PA_In_Piece = PAIn_Piece;&#x000D;&#x000A;Scaled_PA_Out = ones(NumOfInputSamples,1)*1e-100;&#x000D;&#x000A;Scaled_PA_Out(1:NumOfInputSamples-delay+1) = PAOut_Scaled(delay:NumOfInputSamples);&#x000D;&#x000A;Shifted_PA_In = PA_In;&#x000D;&#x000A;</DataEntry>
<Description>Equation Text to Parse, edited in the equation set</Description>
<DocSymbol />
<IsSettable><T>Bool</T><D>0</D></IsSettable>
<Range />
<RunTimeTunable><T>Bool</T><D>0</D></RunTimeTunable>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>4</D></Validate></Item>
