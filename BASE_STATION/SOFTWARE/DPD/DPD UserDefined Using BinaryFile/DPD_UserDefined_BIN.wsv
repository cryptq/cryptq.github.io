<Item XName="Equations" Type="Equation">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>%clear all&#x0009;%clear is no longer recommended at the top of an equation&#x000D;&#x000A;StartSample = 0;&#x000D;&#x000A;StopSample = NumOfCapturedSamples-1;&#x000D;&#x000A;if(EnableAutoDPD)&#x000D;&#x000A;   CurrentIteration_new = m_CurrentIteration;&#x000D;&#x000A;else&#x000D;&#x000A;   CurrentIteration_new = CurrentIteration;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;Step4_DPD_PAOutput_FileName = [&apos;Step4_DPD_PAOutputdata_Iter&apos; num2str(CurrentIteration_new) &apos;.bin&apos;];&#x000D;&#x000A;%Step4_DPD_PAOutput_Imag_FileName = [&apos;Step4_DPD_PAOutputdata_Imag_Iter&apos; num2str(CurrentIteration_new) &apos;.txt&apos;];&#x000D;&#x000A;&#x000D;&#x000A;Step2_PAInputdata_FileName = [&apos;Step2_PAInputdata_Iter1.bin&apos;];&#x000D;&#x000A;%Step2_PAInputdata_Real_FileName = [&apos;Step2_PAInputdata_Real_Iter1.txt&apos;];&#x000D;&#x000A;&#x000D;&#x000A;if EnableAutoDPD&#x000D;&#x000A;   Att_new = Att;&#x000D;&#x000A;else&#x000D;&#x000A;   Att_new = Att_manual;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;% The same file will be used in step 2 of next iteration&#x000D;&#x000A;Step2_PAOutput_FileName = [&apos;Step2_PAOutputdata_Iter&apos; num2str(CurrentIteration_new+1) &apos;.bin&apos;];&#x000D;&#x000A;%Step2_PAOutput_Imag_FileName = [&apos;Step2_PAOutputdata_Imag_Iter&apos; num2str(CurrentIteration_new+1) &apos;.txt&apos;];&#x000D;&#x000A;</Text>
<UnitUse><T>Int</T><D>2</D></UnitUse>
