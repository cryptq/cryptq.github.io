<Item XName="EquationACP" UserName="EquationACP" Type="Equation">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>ACP_Lower_wDPD = -999;&#x000D;&#x000A;ACP_Upper_wDPD = -999;&#x000D;&#x000A;ACP_Lower_woDPD = -999;&#x000D;&#x000A;ACP_Upper_woDPD = -999;&#x000D;&#x000A;ACP_Lower_Orig = -999;&#x000D;&#x000A;ACP_Upper_Orig = -999;&#x000D;&#x000A;ACP_Lower_wDPD_Iter2 = -999;&#x000D;&#x000A;ACP_Upper_wDPD_Iter2 = -999;&#x000D;&#x000A;ACP_Lower_wDPD_Iter3 = -999;&#x000D;&#x000A;ACP_Upper_wDPD_Iter3 = -999;&#x000D;&#x000A;ACP_Lower_woDPD_Step2 = -999;&#x000D;&#x000A;ACP_Upper_woDPD_Step2 = -999;&#x000D;&#x000A;using(&apos;SpectrumPlotComparison&apos;);&#x000D;&#x000A;if (exist(&apos;Origin_Sig_Power&apos;))&#x000D;&#x000A;power = dbm(sum(Origin_Sig_Power))&#x000D;&#x000A;end&#x000D;&#x000A;if(EnableAutoDPD)&#x000D;&#x000A;   CurrentIteration_new_acp = m_CurrentIteration;&#x000D;&#x000A;else&#x000D;&#x000A;   CurrentIteration_new_acp = CurrentIteration;&#x000D;&#x000A;end&#x000D;&#x000A;% ACP cal&#x000D;&#x000A;fre = FCarrier + RefOffset;&#x000D;&#x000A;acp_fstart = fre-RefBW/2;&#x000D;&#x000A;acp_fstop = fre+RefBW/2&#x000D;&#x000A;&#x000D;&#x000A;fre = FCarrier + LowerOffset;&#x000D;&#x000A;lower_fstart = fre-LowerBW/2;&#x000D;&#x000A;lower_fstop = fre+LowerBW/2;&#x000D;&#x000A;&#x000D;&#x000A;fre = FCarrier + UpperOffset;&#x000D;&#x000A;upper_fstart = fre-UpperBW/2;&#x000D;&#x000A;upper_fstop = fre+UpperBW/2;&#x000D;&#x000A;&#x000D;&#x000A;%ACP with DPD output&#x000D;&#x000A;if (exist(&apos;DPD_PAOutput_Power&apos;))&#x000D;&#x000A;indxes = find(DPD_PAOutput_Power_Freq &gt;= acp_fstart &amp; DPD_PAOutput_Power_Freq &lt;= acp_fstop);&#x000D;&#x000A;ACP_Ref_wDPD = dbm(sum(DPD_PAOutput_Power(indxes)))&#x000D;&#x000A;&#x000D;&#x000A;indxes = find(DPD_PAOutput_Power_Freq &gt;= lower_fstart &amp; DPD_PAOutput_Power_Freq &lt;= lower_fstop);&#x000D;&#x000A;ACP_Lower_wDPD=dbm(sum(DPD_PAOutput_Power(indxes)))&#x000D;&#x000A;&#x000D;&#x000A;indxes = find(DPD_PAOutput_Power_Freq &gt;= upper_fstart &amp; DPD_PAOutput_Power_Freq &lt;= upper_fstop);&#x000D;&#x000A;ACP_Upper_wDPD=dbm(sum(DPD_PAOutput_Power(indxes)))&#x000D;&#x000A;&#x000D;&#x000A;ACP_Lower_wDPD=ACP_Lower_wDPD-ACP_Ref_wDPD;&#x000D;&#x000A;ACP_Upper_wDPD=ACP_Upper_wDPD-ACP_Ref_wDPD;&#x000D;&#x000A;end&#x000D;&#x000A;%ACP w/o DPD output&#x000D;&#x000A;if (exist(&apos;NoDPD_PAOutput_Power&apos;))&#x000D;&#x000A;indxes = find(NoDPD_PAOutput_Power_Freq &gt;= acp_fstart &amp; NoDPD_PAOutput_Power_Freq &lt;= acp_fstop);&#x000D;&#x000A;ACP_Ref_woDPD = dbm(sum(NoDPD_PAOutput_Power(indxes)))&#x000D;&#x000A;&#x000D;&#x000A;indxes = find(NoDPD_PAOutput_Power_Freq &gt;= lower_fstart &amp; NoDPD_PAOutput_Power_Freq &lt;= lower_fstop);&#x000D;&#x000A;ACP_Lower_woDPD=dbm(sum(NoDPD_PAOutput_Power(indxes)))&#x000D;&#x000A;&#x000D;&#x000A;indxes = find(NoDPD_PAOutput_Power_Freq &gt;= upper_fstart &amp; NoDPD_PAOutput_Power_Freq &lt;= upper_fstop);&#x000D;&#x000A;ACP_Upper_woDPD=dbm(sum(NoDPD_PAOutput_Power(indxes)))&#x000D;&#x000A;&#x000D;&#x000A;ACP_Lower_woDPD=ACP_Lower_woDPD-ACP_Ref_woDPD;&#x000D;&#x000A;ACP_Upper_woDPD=ACP_Upper_woDPD-ACP_Ref_woDPD;&#x000D;&#x000A;end&#x000D;&#x000A;%ACP input&#x000D;&#x000A;if (exist(&apos;Origin_Sig_Power&apos;))&#x000D;&#x000A;indxes = find(Origin_Sig_Power_Freq &gt;= acp_fstart &amp; Origin_Sig_Power_Freq &lt;= acp_fstop);&#x000D;&#x000A;ACP_Ref_Orig = dbm(sum(Origin_Sig_Power(indxes)))&#x000D;&#x000A;&#x000D;&#x000A;indxes = find(Origin_Sig_Power_Freq &gt;= lower_fstart &amp; Origin_Sig_Power_Freq &lt;= lower_fstop);&#x000D;&#x000A;ACP_Lower_Orig=dbm(sum(Origin_Sig_Power(indxes)))&#x000D;&#x000A;&#x000D;&#x000A;indxes = find(Origin_Sig_Power_Freq &gt;= upper_fstart &amp; Origin_Sig_Power_Freq &lt;= upper_fstop);&#x000D;&#x000A;ACP_Upper_Orig=dbm(sum(Origin_Sig_Power(indxes)))&#x000D;&#x000A;&#x000D;&#x000A;ACP_Lower_Orig=ACP_Lower_Orig-ACP_Ref_Orig;&#x000D;&#x000A;ACP_Upper_Orig=ACP_Upper_Orig-ACP_Ref_Orig;&#x000D;&#x000A;end&#x000D;&#x000A;%ACP iter2 wDPD output&#x000D;&#x000A;if (CurrentIteration_new_acp&gt;=2)&#x000D;&#x000A;    if (exist(&apos;DPD_PAOutput_Iter2_Power&apos;))&#x000D;&#x000A;&#x0009;indxes = find(DPD_PAOutput_Iter2_Power_Freq &gt;= acp_fstart &amp; DPD_PAOutput_Iter2_Power_Freq &lt;= acp_fstop);&#x000D;&#x000A;&#x0009;ACP_Ref_wDPD_Iter2 = dbm(sum(DPD_PAOutput_Iter2_Power(indxes)))&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;indxes = find(DPD_PAOutput_Iter2_Power_Freq &gt;= lower_fstart &amp; DPD_PAOutput_Iter2_Power_Freq &lt;= lower_fstop);&#x000D;&#x000A;&#x0009;ACP_Lower_wDPD_Iter2=dbm(sum(DPD_PAOutput_Iter2_Power(indxes)))&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;indxes = find(DPD_PAOutput_Iter2_Power_Freq &gt;= upper_fstart &amp; DPD_PAOutput_Iter2_Power_Freq &lt;= upper_fstop);&#x000D;&#x000A;&#x0009;ACP_Upper_wDPD_Iter2=dbm(sum(DPD_PAOutput_Iter2_Power(indxes)))&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;ACP_Lower_wDPD_Iter2=ACP_Lower_wDPD_Iter2-ACP_Ref_wDPD_Iter2;&#x000D;&#x000A;&#x0009;ACP_Upper_wDPD_Iter2=ACP_Upper_wDPD_Iter2-ACP_Ref_wDPD_Iter2;&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;%ACP iter3 wDPD output&#x000D;&#x000A;if (CurrentIteration_new_acp&gt;=3)&#x000D;&#x000A;    if (exist(&apos;DPD_PAOutput_Iter3_Power&apos;))&#x000D;&#x000A;&#x0009;indxes = find(DPD_PAOutput_Iter3_Power_Freq &gt;= acp_fstart &amp; DPD_PAOutput_Iter3_Power_Freq &lt;= acp_fstop);&#x000D;&#x000A;&#x0009;ACP_Ref_wDPD_Iter3 = dbm(sum(DPD_PAOutput_Iter3_Power(indxes)))&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;indxes = find(DPD_PAOutput_Iter3_Power_Freq &gt;= lower_fstart &amp; DPD_PAOutput_Iter3_Power_Freq &lt;= lower_fstop);&#x000D;&#x000A;&#x0009;ACP_Lower_wDPD_Iter3=dbm(sum(DPD_PAOutput_Iter3_Power(indxes)))&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;indxes = find(DPD_PAOutput_Iter3_Power_Freq &gt;= upper_fstart &amp; DPD_PAOutput_Iter3_Power_Freq &lt;= upper_fstop);&#x000D;&#x000A;&#x0009;ACP_Upper_wDPD_Iter3=dbm(sum(DPD_PAOutput_Iter3_Power(indxes)))&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;ACP_Lower_wDPD_Iter3=ACP_Lower_wDPD_Iter3-ACP_Ref_wDPD_Iter3;&#x000D;&#x000A;&#x0009;ACP_Upper_wDPD_Iter3=ACP_Upper_wDPD_Iter3-ACP_Ref_wDPD_Iter3;&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;%ACP woDPD output&#x000D;&#x000A;if (DisplayStep2PAOut==1)&#x000D;&#x000A;    if (exist(&apos;Step2_PAOutput_Power&apos;))&#x000D;&#x000A;&#x0009;indxes = find(Step2_PAOutput_Power_Freq &gt;= acp_fstart &amp; Step2_PAOutput_Power_Freq &lt;= acp_fstop);&#x000D;&#x000A;&#x0009;ACP_Ref_woDPD_Step2 = dbm(sum(Step2_PAOutput_Power(indxes)))&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;indxes = find(Step2_PAOutput_Power_Freq &gt;= lower_fstart &amp; Step2_PAOutput_Power_Freq &lt;= lower_fstop);&#x000D;&#x000A;&#x0009;ACP_Lower_woDPD_Step2=dbm(sum(Step2_PAOutput_Power(indxes)))&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;indxes = find(Step2_PAOutput_Power_Freq &gt;= upper_fstart &amp; Step2_PAOutput_Power_Freq &lt;= upper_fstop);&#x000D;&#x000A;&#x0009;ACP_Upper_woDPD_Step2=dbm(sum(Step2_PAOutput_Power(indxes)))&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;ACP_Lower_woDPD_Step2=ACP_Lower_woDPD_Step2-ACP_Ref_woDPD_Step2;&#x000D;&#x000A;&#x0009;ACP_Upper_woDPD_Step2=ACP_Upper_woDPD_Step2-ACP_Ref_woDPD_Step2;&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end</Text>
<UnitUse><T>Int</T><D>2</D></UnitUse>
