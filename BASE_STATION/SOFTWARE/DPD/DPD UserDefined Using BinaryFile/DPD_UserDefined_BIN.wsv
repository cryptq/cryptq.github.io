<Item XName="EquationEVM" UserName="EquationEVM" Type="Equation">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>EVM_wDPD = -999;&#x000D;&#x000A;EVM_woDPD = -999;&#x000D;&#x000A;EVM_Orig = -999;&#x000D;&#x000A;EVM_wDPD_Iter2 = -999;&#x000D;&#x000A;EVM_wDPD_Iter3 =-999;&#x000D;&#x000A;EVM_woDPD_Step2 = -999;&#x000D;&#x000A;if(EnableAutoDPD)&#x000D;&#x000A;   CurrentIteration_new_evm = m_CurrentIteration;&#x000D;&#x000A;else&#x000D;&#x000A;   CurrentIteration_new_evm = CurrentIteration;&#x000D;&#x000A;end&#x000D;&#x000A;if_flag=0;&#x000D;&#x000A;if 1==EVM_SignalType&#x000D;&#x000A;    if_flag = hasvariable(&apos;SpectrumPlotComparison&apos;, &apos;E1__Generic&apos;);&#x000D;&#x000A;elseif 2==EVM_SignalType&#x000D;&#x000A;    if_flag = hasvariable(&apos;SpectrumPlotComparison&apos;, &apos;E1__LTE_DL_EVM&apos;);&#x000D;&#x000A;elseif 3==EVM_SignalType&#x000D;&#x000A;    if_flag = hasvariable(&apos;SpectrumPlotComparison&apos;, &apos;E1__LTE_UL_EVM&apos;);&#x000D;&#x000A;elseif 4==EVM_SignalType&#x000D;&#x000A;    if_flag = hasvariable(&apos;SpectrumPlotComparison&apos;, &apos;E1__WLAN_11ac_Avg_DataRCE_dB&apos;);&#x000D;&#x000A;elseif 5==EVM_SignalType&#x000D;&#x000A;    if_flag = hasvariable(&apos;SpectrumPlotComparison&apos;, &apos;E1__HSDPA_Avg_EVM_dB&apos;);&#x000D;&#x000A;else&#x000D;&#x000A;    if_flag = hasvariable(&apos;SpectrumPlotComparison&apos;, &apos;E1__HSUPA_Avg_EVM_dB&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;% EVM with DPD output&#x000D;&#x000A;if (EVM_SignalType&gt;0)&amp;(1==if_flag) &#x000D;&#x000A;&#x0009;if 1==EVM_SignalType&#x000D;&#x000A;&#x0009;&#x0009;EVM_wDPD =  (getvariable(&apos;SpectrumPlotComparison&apos;, &apos;E1__Generic&apos;));&#x000D;&#x000A;&#x0009;elseif 2==EVM_SignalType&#x000D;&#x000A;&#x0009;&#x0009;temp = getvariable(&apos;SpectrumPlotComparison&apos;, &apos;E1__LTE_DL_EVM&apos;);&#x000D;&#x000A;&#x0009;&#x0009;EVM_wDPD = temp(1);&#x000D;&#x000A;&#x0009;elseif 3==EVM_SignalType&#x000D;&#x000A;&#x0009;&#x0009;temp = getvariable(&apos;SpectrumPlotComparison&apos;, &apos;E1__LTE_UL_EVM&apos;);&#x000D;&#x000A;&#x0009;&#x0009;EVM_wDPD = temp(1);&#x000D;&#x000A;&#x0009;elseif 4==EVM_SignalType&#x000D;&#x000A;&#x0009;&#x0009;EVM_wDPD = getvariable(&apos;SpectrumPlotComparison&apos;, &apos;E1__WLAN_11ac_Avg_DataRCE_dB&apos;);&#x000D;&#x000A;&#x0009;elseif 5==EVM_SignalType&#x000D;&#x000A;&#x0009;&#x0009;EVM_wDPD = getvariable(&apos;SpectrumPlotComparison&apos;, &apos;E1__HSDPA_Avg_EVM_dB&apos;);&#x000D;&#x000A;&#x0009;else&#x000D;&#x000A;&#x0009;&#x0009;EVM_wDPD = getvariable(&apos;SpectrumPlotComparison&apos;, &apos;E1__HSUPA_Avg_EVM_dB&apos;);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;%EVM w/o DPD output&#x000D;&#x000A;&#x0009;if (PowerBackoff)&#x000D;&#x000A;&#x0009;&#x0009;if 1==EVM_SignalType&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;EVM_woDPD =  (getvariable(&apos;SpectrumPlotComparison&apos;, &apos;E2__Generic&apos;));&#x000D;&#x000A;&#x0009;&#x0009;elseif 2==EVM_SignalType&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;temp = getvariable(&apos;SpectrumPlotComparison&apos;, &apos;E2__LTE_DL_EVM&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;EVM_woDPD = temp(1);&#x000D;&#x000A;&#x0009;&#x0009;elseif 3==EVM_SignalType&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;temp = getvariable(&apos;SpectrumPlotComparison&apos;, &apos;E2__LTE_UL_EVM&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;EVM_woDPD = temp(1);&#x000D;&#x000A;&#x0009;&#x0009;elseif 4==EVM_SignalType&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;EVM_woDPD = getvariable(&apos;SpectrumPlotComparison&apos;, &apos;E2__WLAN_11ac_Avg_DataRCE_dB&apos;);&#x000D;&#x000A;&#x0009;&#x0009;elseif 5==EVM_SignalType&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;EVM_woDPD = getvariable(&apos;SpectrumPlotComparison&apos;, &apos;E2__HSDPA_Avg_EVM_dB&apos;);&#x000D;&#x000A;&#x0009;&#x0009;else&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;EVM_wDPD = getvariable(&apos;SpectrumPlotComparison&apos;, &apos;E1__HSUPA_Avg_EVM_dB&apos;);&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x0009;%EVM input&#x000D;&#x000A;&#x0009;if 1==EVM_SignalType&#x000D;&#x000A;&#x0009;&#x0009;EVM_Orig =  (getvariable(&apos;SpectrumPlotComparison&apos;, &apos;E3__Generic&apos;));&#x000D;&#x000A;&#x0009;elseif 2==EVM_SignalType&#x000D;&#x000A;&#x0009;&#x0009;temp = getvariable(&apos;SpectrumPlotComparison&apos;, &apos;E3__LTE_DL_EVM&apos;);&#x000D;&#x000A;&#x0009;&#x0009;EVM_Orig = temp(1);&#x000D;&#x000A;&#x0009;elseif 3==EVM_SignalType&#x000D;&#x000A;&#x0009;&#x0009;temp = getvariable(&apos;SpectrumPlotComparison&apos;, &apos;E3__LTE_UL_EVM&apos;);&#x000D;&#x000A;&#x0009;&#x0009;EVM_Orig = temp(1);&#x000D;&#x000A;&#x0009;elseif 4==EVM_SignalType&#x000D;&#x000A;&#x0009;&#x0009;EVM_Orig = getvariable(&apos;SpectrumPlotComparison&apos;, &apos;E3__WLAN_11ac_Avg_DataRCE_dB&apos;);&#x000D;&#x000A;&#x0009;elseif 5==EVM_SignalType&#x000D;&#x000A;&#x0009;&#x0009;EVM_Orig = getvariable(&apos;SpectrumPlotComparison&apos;, &apos;E3__HSDPA_Avg_EVM_dB&apos;);&#x000D;&#x000A;&#x0009;else&#x000D;&#x000A;&#x0009;&#x0009;EVM_Orig = getvariable(&apos;SpectrumPlotComparison&apos;, &apos;E3__HSUPA_Avg_EVM_dB&apos;);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;%EVM w/ DPD Iter2&#x000D;&#x000A;&#x0009;if (CurrentIteration_new_evm&gt;=2)&#x000D;&#x000A;&#x0009;&#x0009;if 1==EVM_SignalType&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;EVM_wDPD_Iter2 =  (getvariable(&apos;SpectrumPlotComparison&apos;, &apos;E4__Generic&apos;));&#x000D;&#x000A;&#x0009;&#x0009;elseif 2==EVM_SignalType&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;temp = getvariable(&apos;SpectrumPlotComparison&apos;, &apos;E4__LTE_DL_EVM&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;EVM_wDPD_Iter2 = temp(1);&#x000D;&#x000A;&#x0009;&#x0009;elseif 3==EVM_SignalType&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;temp = getvariable(&apos;SpectrumPlotComparison&apos;, &apos;E4__LTE_UL_EVM&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;EVM_wDPD_Iter2 = temp(1);&#x000D;&#x000A;&#x0009;&#x0009;elseif 4==EVM_SignalType&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;EVM_wDPD_Iter2 = getva