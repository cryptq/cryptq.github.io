<Selected><T>Bool</T><D>0</D></Selected>
<Text>StartSample = TimeStart * 1e-3 * SamplingRate;&#x000D;&#x000A;StopSample = TimeStop * 1e-3 * SamplingRate;&#x000D;&#x000A;&#x000D;&#x000A;UseFileReader = 1-(InputSignal==0);&#x000D;&#x000A;UseSSFileReader = 1-(InputSignal==1);&#x000D;&#x000A;UseVSASource = 1-(InputSignal==2);&#x000D;&#x000A;LTE_DL_Enable = 1-(InputSignal==3);&#x000D;&#x000A;LTE_UL_Enable = 1-(InputSignal==4);&#x000D;&#x000A;WLAN_11ac_Enable = 1-(InputSignal==5);&#x000D;&#x000A;%HSDPA_Enable = 1-(InputSignal==4);&#x000D;&#x000A;%HSUPA_Enable = 1-(InputSignal==5);&#x000D;&#x000A;&#x000D;&#x000A;NumRB = [6,15,25,50,75,100];&#x000D;&#x000A;LTE_NumRB = NumRB(Bandwidth+1);&#x000D;&#x000A;</Text>
