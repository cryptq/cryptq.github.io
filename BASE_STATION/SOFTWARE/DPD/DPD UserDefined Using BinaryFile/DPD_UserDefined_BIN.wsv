<Item XName="Equations" Type="Equation">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>%clear all&#x0009;%clear is no longer recommended at the top of an equation&#x000D;&#x000A;if(EnableAutoDPD)&#x000D;&#x000A;   CurrentIteration_new = m_CurrentIteration;&#x000D;&#x000A;else&#x000D;&#x000A;   CurrentIteration_new = CurrentIteration;&#x000D;&#x000A;end&#x000D;&#x000A;Step4_DPD_PAOutput_FileName_Iter2 = [&apos;Step4_DPD_PAOutputdata_Iter2.bin&apos;];&#x000D;&#x000A;%Step4_DPD_PAOutput_Imag_FileName_Iter2 = [&apos;Step4_DPD_PAOutputdata_Imag_Iter2.txt&apos;];&#x000D;&#x000A;&#x000D;&#x000A;Step5_NoDPD_PAOutput_FileName = [&apos;Step5_NoDPD_PAOutputdata_Iter1.bin&apos;];&#x000D;&#x000A;%Step5_NoDPD_PAOutputReal_FileName = [&apos;Step5_NoDPD_PAOutputdata_Real_Iter1.txt&apos;];&#x000D;&#x000A;&#x000D;&#x000A;Step2_PAInputdata_FileName = [&apos;Step2_PAInputdata_Iter1.bin&apos;];&#x000D;&#x000A;%Step2_PAInputdata_Real_FileName = [&apos;Step2_PAInputdata_Real_Iter1.txt&apos;];&#x000D;&#x000A;&#x000D;&#x000A;Step2_PAOutputdata_FileName = [&apos;Step2_PAOutputdata_Iter1.bin&apos;];&#x000D;&#x000A;%Step2_PAOutputdata_Real_FileName = [&apos;Step2_PAOutputdata_Real_Iter1.txt&apos;];&#x000D;&#x000A;&#x000D;&#x000A;Step4_DPD_PAOutput_FileName_Iter1 = [&apos;Step4_DPD_PAOutputdata_Iter1.bin&apos;];&#x000D;&#x000A;%Step4_DPD_PAOutput_Imag_FileName_Iter1 = [&apos;Step4_DPD_PAOutputdata_Imag_Iter1.txt&apos;];&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;Step4_DPD_PAOutput_FileName_Iter3 = [&apos;Step4_DPD_PAOutputdata_Iter3.bin&apos;];&#x000D;&#x000A;%Step4_DPD_PAOutput_Imag_FileName_Iter3 = [&apos;Step4_DPD_PAOutputdata_Imag_Iter3.txt&apos;];&#x000D;&#x000A;&#x000D;&#x000A;if CurrentIteration_new &gt;= 3&#x000D;&#x000A;&#x0009;Iter3_Enable = 0;&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;Iter3_Enable = 1;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if CurrentIteration_new &gt;= 2&#x000D;&#x000A;&#x0009;Iter2_Enable = 0;&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;Iter2_Enable = 1;&#x000D;&#x000A;end</Text>
