<Item XName="Equations" Type="Equation">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>%clear all&#x0009;%clear is no longer recommended at the top of an equation&#x000D;&#x000A;if(EnableAutoDPD)&#x000D;&#x000A;   CurrentIteration_new = m_CurrentIteration;&#x000D;&#x000A;else&#x000D;&#x000A;   CurrentIteration_new = CurrentIteration;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if (PowerBackoff == 1 || CurrentIteration_new==1)&#x000D;&#x000A;&#x0009;using(&apos;CreateDPDStimulus Analysis_Data&apos;)&#x000D;&#x000A;&#x0009;if (exist(&apos;StimulusSpectrum_Power&apos;))&#x000D;&#x000A;&#x0009;&#x0009;StimulusPower = dbm(sum(StimulusSpectrum_Power));&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;using(&apos;Apply_DPD_Analysis_Data&apos;)&#x000D;&#x000A;&#x0009;if (exist(&apos;AfterDPD_Spectrum_Power&apos;))&#x000D;&#x000A;&#x0009;&#x0009;StimulusPower = dbm(sum(AfterDPD_Spectrum_Power));&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;Step1_BBData_FileName = [&apos;Step1_BBData_Iter&apos; num2str(CurrentIteration_new) &apos;.bin&apos;];&#x000D;&#x000A;%Step1_BBData_Imag_FileName = [&apos;Step1_BBData_Imag_Iter&apos; num2str(CurrentIteration_new) &apos;.txt&apos;];&#x000D;&#x000A;&#x000D;&#x000A;filename_IQ = [&apos;Step2_PAInputdata_Iter&apos; num2str(CurrentIteration_new) &apos;.bin&apos;];&#x000D;&#x000A;%filename_I = [&apos;Step2_PAInputdata_Real_Iter&apos; num2str(CurrentIteration_new) &apos;.txt&apos;];&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;StartSample = TimeStart * 1e-3 * SamplingRate;&#x000D;&#x000A;StopSample = TimeStop * 1e-3 * SamplingRate;&#x000D;&#x000A;NumSampsStep1=floor(StopSample-StartSample+0.5);</Text>
<UnitUse><T>Int</T><D>2</D></UnitUse>
