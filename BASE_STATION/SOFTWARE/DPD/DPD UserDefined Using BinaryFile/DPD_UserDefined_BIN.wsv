<Text>EnableAutoDPD = 0;&#x000D;&#x000A;EnablePowerSweep = 0;&#x000D;&#x000A;NumIterations = 1;&#x000D;&#x000A;CurrentIteration = 1;&#x000D;&#x000A;&#x000D;&#x000A;FCarrier = 2140000000;&#x000D;&#x000A;SamplingRate = 80000000;&#x000D;&#x000A;InputSignal = 0;&#x000D;&#x000A;InputWaveform_I = &apos;11a_4x_20MHz.bin&apos;;&#x000D;&#x000A;InputWaveform_Q = &apos;11a_4x_20MHz.bin&apos;;&#x000D;&#x000A;Bandwidth = 5;&#x000D;&#x000A;OversamplingOption = 2;&#x000D;&#x000A;MappingType = 1;&#x000D;&#x000A;MCS = 8;&#x000D;&#x000A;LTE_CFREnable = 1;&#x000D;&#x000A;LTE_ClippingThreshold = 1.47E-05;&#x000D;&#x000A;LTE_EVMThreshold_QPSK = 0.1;&#x000D;&#x000A;LTE_EVMThreshold_16QAM = 0.1;&#x000D;&#x000A;LTE_EVMThreshold_64QAM = 0.1;&#x000D;&#x000A;OriginRFPower = -6;&#x000D;&#x000A;RFPower = -6;&#x000D;&#x000A;PathGainLoss = -1.1;&#x000D;&#x000A;PAPowerBackoff = 1.546;&#x000D;&#x000A;UseDefaultBackoff = 0;&#x000D;&#x000A;InstrumentType = 0;&#x000D;&#x000A;PrimAddress = &apos;10.116.93.216&apos;;&#x000D;&#x000A;InstrumentAddress = &apos;PXI18::15::0::INSTR&apos;;&#x000D;&#x000A;AnalyzerAddress = &apos;10.116.93.240&apos;;&#x000D;&#x000A;OutputConfig = 1;&#x000D;&#x000A;TimeStart = 0;&#x000D;&#x000A;TimeStop = 0.368;&#x000D;&#x000A;&#x000D;&#x000A;CaptureDataType = 1;&#x000D;&#x000A;SetupFile = &apos;11a_Capturing.setx&apos;;&#x000D;&#x000A;PAInputType = 1;&#x000D;&#x000A;VSAPause = 0;&#x000D;&#x000A;VSATrace = 1;&#x000D;&#x000A;VSAVersion = 1;&#x000D;&#x000A;NumOfCapturedSamples = 29440;&#x000D;&#x000A;CapturedTime = NumOfCapturedSamples/SamplingRate;&#x000D;&#x000A;&#x000D;&#x000A;ModelType = 0;&#x000D;&#x000A;ModelIdentificationAlgorithm = 0;&#x000D;&#x000A;NumOfInputSamples = 29440;&#x000D;&#x000A;MemoryOrder = 4;&#x000D;&#x000A;NonlinearOrder = 7;&#x000D;&#x000A;CrossTermOrder = 2;&#x000D;&#x000A;SampleLevelDPD = 0;&#x000D;&#x000A;NonlinearOrderSelection = 1;&#x000D;&#x000A;UseCustomPreDistorter = 0;&#x000D;&#x000A;UseCustomModelExtractor = 0;&#x000D;&#x000A;PowerBackoff = 0;&#x000D;&#x000A;&#x000D;&#x000A;DisplayStep2PAOut = 1;&#x000D;&#x000A;&#x000D;&#x000A;LUTSize = 64;&#x000D;&#x000A;LUTStep = 0.25;&#x000D;&#x000A;&#x000D;&#x000A;Spec_Mode = 0;&#x000D;&#x000A;Spec_Start = 0;&#x000D;&#x000A;Spec_SegTime = 0.0368;&#x000D;&#x000A;Spec_NumSegments = 10;&#x000D;&#x000A;Spec_Window = 1;&#x000D;&#x000A;Spec_ResBW = 1000;&#x000D;&#x000A;&#x000D;&#x000A;EVM_SignalType = 0;&#x000D;&#x000A;&#x000D;&#x000A;RefOffset = 0;&#x000D;&#x000A;RefBW = 16562500;&#x000D;&#x000A;LowerOffset = -20000000;&#x000D;&#x000A;LowerBW = 16562500;&#x000D;&#x000A;UpperOffset = 20000000;&#x000D;&#x000A;UpperBW = 16562500;&#x000D;&#x000A;&#x000D;&#x000A;SourceType = 0;&#x000D;&#x000A;&#x000D;&#x000A;SweepStart = -5;&#x000D;&#x000A;SweepStop = -3;&#x000D;&#x000A;SweepStep = 1;&#x000D;&#x000A;SweepList = [-6,-5];&#x000D;&#x000A;SweepType = 0;&#x000D;&#x000A;SweepParameter = 0;&#x000D;&#x000A;&#x000D;&#x000A;DPDVersion = &apos;2015.01&apos;;&#x000D;&#x000A;</Text>
