<Item XName="AutoRun" UserName="AutoRun" Type="Equation">
<AutoCalc><T>Bool</T><D>0</D></AutoCalc>
<Description>Use this equation to apply DPD automatically from step 1 to step 5</Description>
<Selected><T>Bool</T><D>0</D></Selected>
<Text>%%% This script is used to run the 5-steps DPD automatically&#x000D;&#x000A;%clear all&#x0009;%clear is no longer recommended at the top of an equation&#x000D;&#x000A;SetupUse = 0;&#x000D;&#x000A;NMSE_Threshold = -20;&#x000D;&#x000A;MaxRecapture = 3;&#x000D;&#x000A;Att = 20; %Att for Command Expert&#x000D;&#x000A;&#x000D;&#x000A;if (EnableAutoDPD == 1)&#x000D;&#x000A;&#x0009;Step1RFPower = OriginRFPower;&#x000D;&#x000A;    senduimessage Start;&#x000D;&#x000A;    ContinueOnError= 1;&#x000D;&#x000A;    TargetRFPower = OriginRFPower;&#x000D;&#x000A;    if (EnablePowerSweep)&#x000D;&#x000A;        NumSweeps = length(SweepList);&#x000D;&#x000A;    else&#x000D;&#x000A;        NumSweeps = 1;&#x000D;&#x000A;    end&#x000D;&#x000A;    SimStepsPerIter = 9; % used in process bar&#x000D;&#x000A;    NumSimSteps = SimStepsPerIter * NumIterations;&#x000D;&#x000A;    counter = 0;&#x000D;&#x000A;    Step4_sweepStop = 1;&#x000D;&#x000A;    Iter_Start = 1;&#x000D;&#x000A;    for SweepIdx=1:NumSweeps&#x000D;&#x000A;        if EnablePowerSweep &amp;&amp; 1==SweepParameter &amp;&amp; 0==counter&#x000D;&#x000A;            Step4_sweepStop = 2;&#x000D;&#x000A;        else&#x000D;&#x000A;            Step4_sweepStop = 1;&#x000D;&#x000A;        end&#x000D;&#x000A;&#x0009;&#x0009;&#x000D;&#x000A;        for Step4_sweepIdx=1:Step4_sweepStop&#x000D;&#x000A;            if EnablePowerSweep &amp;&amp; 1==SweepParameter % Step 4 sweep&#x000D;&#x000A;                counter=counter+1;&#x000D;&#x000A;            end&#x000D;&#x000A;            if (EnablePowerSweep &amp;&amp; counter~=1)&#x000D;&#x000A;                switch (SweepParameter)&#x000D;&#x000A;                    case 0 % Origin RF Power&#x000D;&#x000A;                        OriginRFPower = SweepList(SweepIdx);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;Step1RFPower = OriginRFPower;&#x000D;&#x000A;                        TargetRFPower = OriginRFPower;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;info_str = [&apos;Sweep PA input Power at &apos; num2str(OriginRFPower) &apos;dBm&apos;];&#x000D;&#x000A;                    case 1 % RF power after DPD&#x000D;&#x000A;                        TargetRFPower = SweepList(SweepIdx);&#x000D;&#x000A;                        info_str = [&apos;Sweep PA input Power w/ DPD at &apos; num2str(TargetRFPower) &apos;dBm&apos;];&#x000D;&#x000A;                    case 2 % Memory order&#x000D;&#x000A;                        MemoryOrder = SweepList(SweepIdx);&#x000D;&#x000A;                        info_str = [&apos;Sweep MemoryOrder at &apos; num2str(MemoryOrder)];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;Step1RFPower = OriginRFPower;&#x000D;&#x000A;                    otherwise % Nonlinear Order&#x000D;&#x000A;                        NonlinearOrder = SweepList(SweepIdx);&#x000D;&#x000A;                        info_str = [&apos;Sweep NonlinearOrder at &apos; num2str(NonlinearOrder)];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;Step1RFPower = OriginRFPower;&#x000D;&#x000A;                end&#x000D;&#x000A;            else&#x000D;&#x000A;                info_str = [&apos;Running &apos;];&#x000D;&#x000A;            end&#x000D;&#x000A;            info_str_prefix = info_str;&#x000D;&#x000A;            if EnablePowerSweep &amp;&amp; 1==SweepParameter&#x000D;&#x000A;                if 1==counter&#x000D;&#x000A;                    Iter_Start = 1;&#x000D;&#x000A;                else&#x000D;&#x000A;                    Iter_Start = NumIterations;&#x000D;&#x000A;                end&#x000D;&#x000A;            else&#x000D;&#x000A;                Iter_Start = 1;&#x000D;&#x000A;            end&#x000D;&#x000A;            for Iter=Iter_Start:NumIterations&#x000D;&#x000A;                m_CurrentIteration = Iter;&#x000D;&#x000A;                NMSE = -30;&#x000D;&#x000A;                if (NumIterations&gt;1)&#x000D;&#x000A;                    info_str = [info_str_prefix &apos; Itertaion &apos; num2str(m_CurrentIteration) &apos; (&apos; num2str(NumIterations) &apos; iterations in total)&apos;];&#x000D;&#x000A;                end&#x000D;&#x000A;                CaptureIdx = 1;&#x000D;&#x000A;                &#x000D;&#x000A;                if (1&gt;=counter || SweepParameter~=1)&#x000D;&#x000A;                    if Iter==1 || PowerBackoff==1 &#x000D;&#x000A;                        %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%&#x000D;&#x000A;                        %%% Step 1: Create DPD Stimulus %%%&#x000D;&#x000A;                        %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%&#x000D;&#x000A;                        if EnablePowerSweep &amp;&amp; 1==SweepParameter&#x000D;&#x000A;                            senduimessage([info_str, &apos; : Create DPD Stimulus&apos;], 100*(SimStepsPerIter*(m_CurrentIteration-1)+1)/(NumSimSteps+NumSweeps*5));&#x000D;&#x000A;                        else&#x000D;&#x000A;                            senduimessage([info_str, &apos; : Create DPD Stimulus&apos;], 100*(NumSimSteps*(SweepIdx-1)+SimStepsPerIter*(m_CurrentIteration-1)+1)/(NumSimSteps*NumSweeps));&#x000D;&#x000A;                        end&#x000D;&#x000A;&#x000D;&#x000A;                        if Iter == 1&#x000D;&#x000A;                            PowerAlignment = 1;&#x000D;&#x000A;                        end&#x000D;&#x000A;                        flag = runanalysis(&apos;CreateDPDStimulus Analysis&apos;, ContinueOnError);&#x000D;&#x000A;                        if (flag == 0)&#x000D;&#x000A;                            senduimessage(&apos;CreateDPDStimulus Analysis is terminated. See Simulation/Error Log for details.&apos;);&#x000D;&#x000A;                            return;&#x000D;&#x000A;                        end&#x000D;&#x000A;&#x000D;&#x000A;                        % Check the status of RF transmit signal&#x000D;&#x000A;                        if(0 == InstrumentType)&#x000D;&#x000A;                            status = f_QueryESGStatus(PrimAddress);&#x000D;&#x000A;                            if status == 0&#x000D;&#x000A;                                senduimessage(&apos;Automation process is terminated because the RF transmitt signal is not ready.&apos;);&#x000D;&#x000A;                                return;&#x000D;&#x000A;                            end;&#x000D;&#x000A;                        end&#x000D;&#x000A;                    end&#x000D;&#x000A;                    %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%&#x000D;&#x000A;                    %%% Step 2: Capture DUT Response %%%&#x000D;&#x000A;                    %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%&#x000D;&#x000A;                    %%%%%%%%%f_CaptureDUTResponse(PAInputType);&#x000D;&#x000A;                    while (CaptureIdx &lt;= MaxRecapture)&#x000D;&#x000A;                        if EnablePowerSweep &amp;&amp; 1==SweepParameter&#x000D;&#x000A;                            senduimessage([info_str, &apos; : Capture DUT Response&apos;], 100*(SimStepsPerIter*(m_CurrentIteration-1)+2)/(NumSimSteps+NumSweeps*5));&#x000D;&#x000A;                        else&#x000D;&#x000A;                            senduimessage([info_str, &apos; : Capture DUT Response&apos;], 100*(NumSimSteps*(SweepIdx-1)+SimStepsPerIter*(m_CurrentIteration-1)+2)/(NumSimSteps*NumSweeps));&#x000D;&#x000A;                        end&#x000D;&#x000A;                        if VSAVersion == 0 % ce&#x000D;&#x000A;                            %Do_AutoRange;&#x000D;&#x000A;                            Att = f_AutoRange(AnalyzerAddress, FCarrier, SamplingRate, CapturedTime);&#x000D;&#x000A;                        else               % VSA&#x000D;&#x000A;                            %Close VSA&#x000D;&#x000A;                            close89600vsa(1);&#x000D;&#x000A;                        end&#x000D;&#x000A;                        &#x000D;&#x000A;                        [flag, Att] = f_CaptureDUTResponse(PAInputType, VSAVersion, AnalyzerAddress, FCarrier, SamplingRate, CapturedTime, PowerBackoff, Iter, Att);&#x000D;&#x000A;                        flag = runanalysis(&apos;GetPACharacteristics Analysis&apos;, ContinueOnError);&#x000D;&#x000A;                        if (flag == 0)&#x000D;&#x000A;                            senduimessage(&apos;GetPACharacteristics Analysis is terminated. See Simulation/Error Log for details.&apos;);&#x000D;&#x000A;                            return;&#x000D;&#x000A;                        end&#x000D;&#x000A;                        &#x000D;&#x000A;                        using(&apos;GetPACharacteristics Analysis_Data&apos;);&#x000D;&#x000A;                        if (exist(&apos;PAIn_Spectrum_Power&apos;))&#x000D;&#x000A;                            PAInPower_Origin(SweepIdx) = dbm(sum(PAIn_Spectrum_Power));&#x000D;&#x000A;                        end&#x000D;&#x000A;                        if (exist(&apos;PAOut_Spectrum_Power&apos;))&#x000D;&#x000A;                            PAOutPower_Origin(SweepIdx) = dbm(sum(PAOut_Spectrum_Power));&#x000D;&#x000A;                        end&#x000D;&#x000A;                        &#x000D;&#x000A;                        %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%&#x000D;&#x000A;                        %%% Step 3: DUT Model Extraction %%%&#x000D;&#x000A;                        %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%&#x000D;&#x000A;                        if EnablePowerSweep &amp;&amp; 1==SweepParameter&#x000D;&#x000A;                            senduimessage([info_str, &apos; : DUT Model Extraction&apos;], 100*(SimStepsPerIter*(m_CurrentIteration-1)+3)/(NumSimSteps+NumSweeps*5));&#x000D;&#x000A;                        else&#x000D;&#x000A;                            senduimessage([info_str, &apos; : DUT Model Extraction&apos;], 100*(NumSimSteps*(SweepIdx-1)+SimStepsPerIter*(m_CurrentIteration-1)+3)/(NumSimSteps*NumSweeps));&#x000D;&#x000A;                        end&#x000D;&#x000A;                        flag = runanalysis(&apos;DUTModelExtraction Analysis&apos;, ContinueOnError);&#x000D;&#x000A;                        if (flag == 0)&#x000D;&#x000A;                            senduimessage(&apos;DUTModelExtraction Analysis is terminated. See Simulation/Error Log for details.&apos;);&#x000D;&#x000A;                            return;&#x000D;&#x000A;                        end&#x000D;&#x000A;                        NMSE = getvariable(&apos;DUTModelExtraction Analysis_Data&apos;, &apos;NMSE&apos;);&#x000D;&#x000A;                        NMSE_Sweep(SweepIdx) = NMSE;&#x000D;&#x000A;                        if NMSE &gt; NMSE_Threshold&#x000D;&#x000A;                            CaptureIdx = CaptureIdx + 1;&#x000D;&#x000A;                            %senduimessage(&apos;Capture Error&apos;);&#x000D;&#x000A;                            %pause(20);&#x000D;&#x000A;                        else&#x000D;&#x000A;                            break;&#x000D;&#x000A;                        end&#x000D;&#x000A;                        &#x000D;&#x000A;                    end&#x000D;&#x000A;                    NumCapture(SweepIdx) = CaptureIdx;&#x000D;&#x000A;                    %%%%%%%%%%%%%%%%%%%%%%%%%%%%&#x000D;&#x000A;                    %%% Step 4: DPD Response %%%&#x000D;&#x000A;                    %%%%%%%%%%%%%%%%%%%%%%%%%%%%&#x000D;&#x000A;                    %%% Step 4.1 Power Alignment&#x000D;&#x000A;                    if EnablePowerSweep &amp;&amp; 1==SweepParameter&#x000D;&#x000A;                        senduimessage([info_str, &apos; : Apply DPD&apos;], 100*(SimStepsPerIter*(m_CurrentIteration-1)+4)/(NumSimSteps+NumSweeps*5));&#x000D;&#x000A;                    else&#x000D;&#x000A;                        senduimessage([info_str, &apos; : Apply DPD&apos;], 100*(NumSimSteps*(SweepIdx-1)+SimStepsPerIter*(m_CurrentIteration-1)+4)/(NumSimSteps*NumSweeps));&#x000D;&#x000A;                    end&#x000D;&#x000A;                    using(&apos;DUTModelExtraction Analysis_Data&apos;);&#x000D;&#x000A;                    PowerAlignment = Gain;&#x000D;&#x000A;                    flag = runanalysis(&apos;PowerAlignment_Analysis&apos;, ContinueOnError);&#x000D;&#x000A;                end&#x000D;&#x000A;                &#x000D;&#x000A;                %%% Step 4.2: Apply DPD&#x000D;&#x000A;                using(&apos;PowerAlignment_Analysis_Data&apos;);&#x000D;&#x000A;                if Iter == 1&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;if (1&gt;=counter || SweepParameter ~= 1)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;if PowerBackoff == 1&#x000D;&#x000A;                            if UseDefaultBackoff == 1&#x000D;&#x000A;                                RFPower = AfterDPD_MeanPower - PathGainLoss;&#x000D;&#x000A;                            else&#x000D;&#x000A;                                RFPower = TargetRFPower - PAPowerBackoff;&#x000D;&#x000A;                            end&#x000D;&#x000A;                        else&#x000D;&#x000A;                            RFPower = OriginRFPower;&#x000D;&#x000A;                        end&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;else&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;RFPower = TargetRFPower;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;                    Step1RFPower = RFPower;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;else&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;if 1&lt;counter &amp;&amp; SweepParameter == 1&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;RFPower = TargetRFPower;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;                end&#x000D;&#x000A;                if EnablePowerSweep &amp;&amp; 1==SweepParameter &amp;&amp; 1==counter&#x000D;&#x000A;                    senduimessage([info_str, &apos; : Apply DPD&apos;], 100*(SimStepsPerIter*(m_CurrentIteration-1)+5)/(NumSimSteps+NumSweeps*5));&#x000D;&#x000A;                elseif  EnablePowerSweep &amp;&amp; 1==SweepParameter &amp;&amp; counter&gt;1&#x000D;&#x000A;                    senduimessage([info_str, &apos; : Apply DPD&apos;], 100*(NumSimSteps+5*(SweepIdx-1)+1)/(NumSimSteps+NumSweeps*5));&#x000D;&#x000A;                else&#x000D;&#x000A;                    senduimessage([info_str, &apos; : Apply DPD&apos;], 100*(NumSimSteps*(SweepIdx-1)+SimStepsPerIter*(m_CurrentIteration-1)+5)/(NumSimSteps*NumSweeps));&#x000D;&#x000A;                end&#x000D;&#x000A;                flag = runanalysis(&apos;Apply_DPD_Analysis&apos;, ContinueOnError);&#x000D;&#x000A;                if (flag == 0)&#x000D;&#x000A;                    senduimessage(&apos;Apply_DPD Analysis is terminated. See Simulation/Error Log for details.&apos;);&#x000D;&#x000A;                    return;&#x000D;&#x000A;                end&#x000D;&#x000A;                &#x000D;&#x000A;                % Check the status of RF transmit signal&#x000D;&#x000A;                if(0 == InstrumentType)&#x000D;&#x000A;                    status = f_QueryESGStatus(PrimAddress);&#x000D;&#x000A;                    if status == 0&#x000D;&#x000A;                        senduimessage(&apos;Automation process is terminated because the RF transmitt signal is not ready.&apos;);&#x000D;&#x000A;                        return;&#x000D;&#x000A;                    end;&#x000D;&#x000A;                end&#x000D;&#x000A;                %%% Step 4.3: Capture DPD-PA Output Waveform&#x000D;&#x000A;                if EnablePowerSweep &amp;&amp; 1==SweepParameter &amp;&amp; 1==counter&#x000D;&#x000A;                    senduimessage([info_str, &apos; : Capture DPD-PA Output Data&apos;], 100*(SimStepsPerIter*(m_CurrentIteration-1)+6)/(NumSimSteps+NumSweeps*5));&#x000D;&#x000A;                elseif  EnablePowerSweep &amp;&amp; 1==SweepParameter &amp;&amp; counter&gt;1&#x000D;&#x000A;                    senduimessage([info_str, &apos; : Capture DPD-PA Output Data&apos;], 100*(NumSimSteps+5*(SweepIdx-1)+2)/(NumSimSteps+NumSweeps*5));&#x000D;&#x000A;                else&#x000D;&#x000A;                    senduimessage([info_str, &apos; : Capture DPD-PA Output Data&apos;], 100*(NumSimSteps*(SweepIdx-1)+SimStepsPerIter*(m_CurrentIteration-1)+6)/(NumSimSteps*NumSweeps));&#x000D;&#x000A;                end&#x000D;&#x000A;                                &#x000D;&#x000A;                if VSAVersion == 0 % ce&#x000D;&#x000A;                    %Do_AutoRange;&#x000D;&#x000A;                    Att = f_AutoRange(AnalyzerAddress, FCarrier, SamplingRate, CapturedTime);&#x000D;&#x000A;                else&#x000D;&#x000A;                    close89600vsa(1);&#x000D;&#x000A;                end&#x000D;&#x000A;                flag = runanalysis(&apos;CaptureDPD-PAOutputData Analysis&apos;, ContinueOnError);&#x000D;&#x000A;                if (flag == 0)&#x000D;&#x000A;                    senduimessage(&apos;CaptureDPD-PAOutputData Analysis is terminated. See Simulation/Error Log for details.&apos;);&#x000D;&#x000A;                    return;&#x000D;&#x000A;                end&#x000D;&#x000A;                using(&apos;CaptureDPD-PAOutputData Analysis_Data&apos;);&#x000D;&#x000A;                PAInPower_wDPD(SweepIdx) = RFPower + PathGainLoss;&#x000D;&#x000A;                PAOutPower_wDPD_temp(SweepIdx) = dbm(sum(DPD_PASpectrum_Power));&#x000D;&#x000A;                if Iter==1&#x000D;&#x000A;                    PAOutPower_wDPD(SweepIdx)=PAOutPower_wDPD_temp(SweepIdx);&#x000D;&#x000A;                elseif Iter==2&#x000D;&#x000A;                    PAOutPower_wDPD_Iter2(SweepIdx)=PAOutPower_wDPD_temp(SweepIdx);&#x000D;&#x000A;                else&#x000D;&#x000A;                    PAOutPower_wDPD_Iter3(SweepIdx)=PAOutPower_wDPD_temp(SweepIdx);&#x000D;&#x000A;                end&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;flag = runanalysis(&apos;GetDPD-PACharacteristics Analysis&apos;, ContinueOnError);&#x000D;&#x000A;                if (flag == 0)&#x000D;&#x000A;                    senduimessage(&apos;GetDPD-PACharacteristics Analysis is terminated. See Simulation/Error Log for details.&apos;);&#x000D;&#x000A;                    return;&#x000D;&#x000A;                end&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;                %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%&#x000D;&#x000A;                %%% Step 5: Verify DPD Response %%%&#x000D;&#x000A;                %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%&#x000D;&#x000A;                %%% Step 5.1: Download Waveform (No DPD)&#x000D;&#x000A;                if PowerBackoff == 1&#x000D;&#x000A;                    if EnablePowerSweep &amp;&amp; 1==SweepParameter &amp;&amp; 1==counter&#x000D;&#x000A;                        senduimessage([info_str, &apos; : Download signal w/o DPD to ESG&apos;], 100*(SimStepsPerIter*(m_CurrentIteration-1)+7)/(NumSimSteps+NumSweeps*5));&#x000D;&#x000A;                    elseif  EnablePowerSweep &amp;&amp; 1==SweepParameter &amp;&amp; counter&gt;1&#x000D;&#x000A;                        senduimessage([info_str, &apos; : Download signal w/o DPD to ESG&apos;], 100*(NumSimSteps+5*(SweepIdx-1)+3)/(NumSimSteps+NumSweeps*5));&#x000D;&#x000A;                    else&#x000D;&#x000A;                        senduimessage([info_str, &apos; : Download signal w/o DPD to ESG&apos;], 100*(NumSimSteps*(SweepIdx-1)+SimStepsPerIter*(m_CurrentIteration-1)+7)/(NumSimSteps*NumSweeps));&#x000D;&#x000A;                    end&#x000D;&#x000A;&#x000D;&#x000A;                    flag = runanalysis(&apos;NoDPD_To_ESG_Analysis&apos;, ContinueOnError);&#x000D;&#x000A;                    if (flag == 0)&#x000D;&#x000A;                        senduimessage(&apos;NoDPD_To_ESG Analysis is terminated. See Simulation/Error Log for details.&apos;);&#x000D;&#x000A;                        return;&#x000D;&#x000A;                    end&#x000D;&#x000A;&#x000D;&#x000A;                    % Check the status of RF transmit signal&#x000D;&#x000A;                    if(0 == InstrumentType)&#x000D;&#x000A;                        status = f_QueryESGStatus(PrimAddress);&#x000D;&#x000A;                        if status == 0&#x000D;&#x000A;                            senduimessage(&apos;Automation process is terminated because the RF transmitt signal is not ready.&apos;);&#x000D;&#x000A;                            return;&#x000D;&#x000A;                        end;&#x000D;&#x000A;                    end&#x000D;&#x000A;&#x000D;&#x000A;                    %%% Step 5.2: Capture PA Output Waveform (No DPD)&#x000D;&#x000A;                    if EnablePowerSweep &amp;&amp; 1==SweepParameter &amp;&amp; 1==counter&#x000D;&#x000A;                        senduimessage([info_str, &apos; : Capture PA output signal w/o DPD&apos;], 100*(SimStepsPerIter*(m_CurrentIteration-1)+8)/(NumSimSteps+NumSweeps*5));&#x000D;&#x000A;                    elseif  EnablePowerSweep &amp;&amp; 1==SweepParameter &amp;&amp; counter&gt;1&#x000D;&#x000A;                        senduimessage([info_str, &apos; : Capture PA output signal w/o DPD&apos;], 100*(NumSimSteps+5*(SweepIdx-1)+4)/(NumSimSteps+NumSweeps*5));&#x000D;&#x000A;                    else&#x000D;&#x000A;                        senduimessage([info_str, &apos; : Capture PA output signal w/o DPD&apos;], 100*(NumSimSteps*(SweepIdx-1)+SimStepsPerIter*(m_CurrentIteration-1)+8)/(NumSimSteps*NumSweeps));&#x000D;&#x000A;                    end&#x000D;&#x000A;                    close89600vsa(1);&#x000D;&#x000A;&#x000D;&#x000A;                    if VSAVersion == 0 % ce&#x000D;&#x000A;                        %Do_AutoRange;&#x000D;&#x000A;                        Att = f_AutoRange(AnalyzerAddress, FCarrier, SamplingRate, CapturedTime);&#x000D;&#x000A;                    end&#x000D;&#x000A;                    flag = runanalysis(&apos;CaptureNoDPD-PAOutputData Analysis&apos;, ContinueOnError);&#x000D;&#x000A;                    if (flag == 0)&#x000D;&#x000A;                        senduimessage(&apos;CaptureNoDPD-PAOutputData Analysis is terminated. See Simulation/Error Log for details.&apos;);&#x000D;&#x000A;                        return;&#x000D;&#x000A;                    end&#x000D;&#x000A;                    using(&apos;CaptureNoDPD-PAOutputData Analysis_Data&apos;);&#x000D;&#x000A;                    PAInPower_woDPD(SweepIdx) = RFPower + PathGainLoss;&#x000D;&#x000A;                    PAOutPower_woDPD(SweepIdx) = dbm(sum(NoDPD_PASpectrum_Power));&#x000D;&#x000A;                end&#x000D;&#x000A;                %%% Step 5.3: Spectrum Comparison&#x000D;&#x000A;                if EnablePowerSweep &amp;&amp; 1==SweepParameter &amp;&amp; 1==counter&#x000D;&#x000A;                    senduimessage([info_str, &apos; : Verify DPD response&apos;], 100*(SimStepsPerIter*(m_CurrentIteration-1)+9)/(NumSimSteps+NumSweeps*5));&#x000D;&#x000A;                elseif  EnablePowerSweep &amp;&amp; 1==SweepParameter &amp;&amp; counter&gt;1&#x000D;&#x000A;                    senduimessage([info_str, &apos; : Verify DPD response&apos;], 100*(NumSimSteps+5*(SweepIdx-1)+5)/(NumSimSteps+NumSweeps*5));&#x000D;&#x000A;                else&#x000D;&#x000A;                    senduimessage([info_str, &apos; : Verify DPD response&apos;], 100*(NumSimSteps*(SweepIdx-1)+SimStepsPerIter*(m_CurrentIteration-1)+9)/(NumSimSteps*NumSweeps));&#x000D;&#x000A;                end&#x000D;&#x000A;                flag = runanalysis(&apos;SpectrumPlot Analysis&apos;, ContinueOnError);&#x000D;&#x000A;                if (flag == 0)&#x000D;&#x000A;                    senduimessage(&apos;SpectrumPlot Analysisis terminated. See Simulation/Error Log for details.&apos;);&#x000D;&#x000A;                    return;&#x000D;&#x000A;                end&#x000D;&#x000A;                using(&apos;SpectrumPlotComparison&apos;);&#x000D;&#x000A;                power = dbm(sum(Origin_Sig_Power));&#x000D;&#x000A;            end&#x000D;&#x000A;            %EVM cal&#x000D;&#x000A;            if_flag=0;&#x000D;&#x000A;            if 1==EVM_SignalType&#x000D;&#x000A;                if_flag = hasvariable( &apos;SpectrumPlotComparison&apos;, &apos;E1__Generic&apos;);&#x000D;&#x000A;            elseif 2==EVM_SignalType&#x000D;&#x000A;                if_flag = hasvariable( &apos;SpectrumPlotComparison&apos;, &apos;E1__LTE_DL_EVM&apos;);&#x000D;&#x000A;            elseif 3==EVM_SignalType&#x000D;&#x000A;                if_flag = hasvariable( &apos;SpectrumPlotComparison&apos;, &apos;E1__LTE_UL_EVM&apos;);&#x000D;&#x000A;            elseif 4==EVM_SignalType&#x000D;&#x000A;                if_flag = hasvariable( &apos;SpectrumPlotComparison&apos;, &apos;E1__WLAN_11ac_Avg_DataRCE_dB&apos;);&#x000D;&#x000A;            elseif 5==EVM_SignalType&#x000D;&#x000A;                if_flag = hasvariable( &apos;SpectrumPlotComparison&apos;, &apos;E1__HSDPA_Avg_EVM_dB&apos;);&#x000D;&#x000A;            else&#x000D;&#x000A;                if_flag = hasvariable( &apos;SpectrumPlotComparison&apos;, &apos;E1__HSUPA_Avg_EVM_dB&apos;);&#x000D;&#x000A;            end&#x000D;&#x000A;            if (EVM_SignalType&gt;0) &amp;&amp; (1==if_flag)&#x000D;&#x000A;                % EVM with DPD output&#x000D;&#x000A;                if 1==EVM_SignalType&#x000D;&#x000A;                    EVM_wDPD(SweepIdx) =  (getvariable(&apos;SpectrumPlotComparison&apos;, &apos;E1__Generic&apos;));&#x000D;&#x000A;                elseif 2==EVM_SignalType&#x000D;&#x000A;                    temp = getvariable(&apos;SpectrumPlotComparison&apos;, &apos;E1__LTE_DL_EVM&apos;);&#x000D;&#x000A;                    EVM_wDPD(SweepIdx) =  (temp(1));&#x000D;&#x000A;                elseif 3==EVM_SignalType&#x000D;&#x000A;                    temp = getvariable(&apos;SpectrumPlotComparison&apos;, &apos;E1__LTE_UL_EVM&apos;);&#x000D;&#x000A;                    EVM_wDPD(SweepIdx) =  (temp(1));&#x000D;&#x000A;                elseif 4==EVM_SignalType&#x000D;&#x000A;                    EVM_wDPD(SweepIdx) = getvariable(&apos;SpectrumPlotComparison&apos;, &apos;E1__WLAN_11ac_Avg_DataRCE_dB&apos;);&#x000D;&#x000A;                elseif 5==EVM_SignalType&#x000D;&#x000A;                    EVM_wDPD(SweepIdx) = getvariable(&apos;SpectrumPlotComparison&apos;, &apos;E1__HSDPA_Avg_EVM_dB&apos;);&#x000D;&#x000A;                else&#x000D;&#x000A;                    EVM_wDPD(SweepIdx) = getvariable(&apos;SpectrumPlotComparison&apos;, &apos;E1__HSUPA_Avg_EVM_dB&apos;);&#x000D;&#x000A;                end&#x000D;&#x000A;                %EVM w/o DPD output&#x000D;&#x000A;                if PowerBackoff == 1&#x000D;&#x000A;                    if 1==EVM_SignalType&#x000D;&#x000A;                        EVM_woDPD(SweepIdx) =  (getvariable(&apos;SpectrumPlotComparison&apos;, &apos;E2__Generic&apos;));&#x000D;&#x000A;                    elseif 2==EVM_SignalType&#x000D;&#x000A;                        temp = getvariable(&apos;SpectrumPlotComparison&apos;, &apos;E2__LTE_DL_EVM&apos;);&#x000D;&#x000A;                        EVM_woDPD(SweepIdx) =  (temp(1));&#x000D;&#x000A;                    elseif 3==EVM_SignalType&#x000D;&#x000A;                        temp = getvariable(&apos;SpectrumPlotComparison&apos;, &apos;E2__LTE_UL_EVM&apos;);&#x000D;&#x000A;                        EVM_woDPD(SweepIdx) =  (temp(1));&#x000D;&#x000A;                    elseif 4==EVM_SignalType&#x000D;&#x000A;                        EVM_woDPD(SweepIdx) = getvariable(&apos;SpectrumPlotComparison&apos;, &apos;E2__WLAN_11ac_Avg_DataRCE_dB&apos;);&#x000D;&#x000A;                    elseif 5==EVM_SignalType&#x000D;&#x000A;                        EVM_woDPD(SweepIdx) = getvariable(&apos;SpectrumPlotComparison&apos;, &apos;E2__HSDPA_Avg_EVM_dB&apos;);&#x000D;&#x000A;                    else&#x000D;&#x000A;                        EVM_wDPD(SweepIdx) = getvariable(&apos;SpectrumPlotComparison&apos;, &apos;E1__HSUPA_Avg_EVM_dB&apos;);&#x000D;&#x000A;                    end&#x000D;&#x000A;                end&#x000D;&#x000A;                %EVM input&#x000D;&#x000A;                if 1==EVM_SignalType&#x000D;&#x000A;                    EVM_Orig(SweepIdx) =  (getvariable(&apos;SpectrumPlotComparison&apos;, &apos;E3__Generic&apos;));&#x000D;&#x000A;                elseif 2==EVM_SignalType&#x000D;&#x000A;                    temp = getvariable(&apos;SpectrumPlotComparison&apos;, &apos;E3__LTE_DL_EVM&apos;);&#x000D;&#x000A;                    EVM_Orig(SweepIdx) =  (temp(1));&#x000D;&#x000A;                elseif 3==EVM_SignalType&#x000D;&#x000A;                    temp = getvariable(&apos;SpectrumPlotComparison&apos;, &apos;E3__LTE_UL_EVM&apos;);&#x000D;&#x000A;                    EVM_Orig(SweepIdx) =  (temp(1));&#x000D;&#x000A;                elseif 4==EVM_SignalType&#x000D;&#x000A;                    EVM_Orig(SweepIdx) = getvariable(&apos;SpectrumPlotComparison&apos;, &apos;E3__WLAN_11ac_Avg_DataRCE_dB&apos;);&#x000D;&#x000A;                elseif 5==EVM_SignalType&#x000D;&#x000A;                    EVM_Orig(SweepIdx) = getvariable(&apos;SpectrumPlotComparison&apos;, &apos;E3__HSDPA_Avg_EVM_dB&apos;);&#x000D;&#x000A;                else&#x000D;&#x000A;                    EVM_Orig(SweepIdx) = getvariable(&apos;SpectrumPlotComparison&apos;, &apos;E3__HSUPA_Avg_EVM_dB&apos;);&#x000D;&#x000A;                end&#x000D;&#x000A;                % Iter2&#x000D;&#x000A;                if (m_CurrentIteration&gt;=2)&#x000D;&#x000A;                    if 1==EVM_SignalType&#x000D;&#x000A;                        EVM_wDPD_Iter2(SweepIdx) =  (getvariable(&apos;SpectrumPlotComparison&apos;, &apos;E4__Generic&apos;));&#x000D;&#x000A;                    elseif 2==EVM_SignalType&#x000D;&#x000A;                        temp = getvariable(&apos;SpectrumPlotComparison&apos;, &apos;E4__LTE_DL_EVM&apos;);&#x000D;&#x000A;                        EVM_wDPD_Iter2(SweepIdx) =  (temp(1));&#x000D;&#x000A;                    elseif 3==EVM_SignalType&#x000D;&#x000A;                        temp = getvariable(&apos;SpectrumPlotComparison&apos;, &apos;E4__LTE_UL_EVM&apos;);&#x000D;&#x000A;                        EVM_wDPD_Iter2(SweepIdx) =  (temp(1));&#x000D;&#x000A;                    elseif 4==EVM_SignalType&#x000D;&#x000A;                        EVM_wDPD_Iter2(SweepIdx) = getvariable(&apos;SpectrumPlotComparison&apos;, &apos;E4__WLAN_11ac_Avg_DataRCE_dB&apos;);&#x000D;&#x000A;                    elseif 5==EVM_SignalType&#x000D;&#x000A;                        EVM_wDPD_Iter2(SweepIdx) = getvariable(&apos;SpectrumPlotComparison&apos;, &apos;E4__HSDPA_Avg_EVM_dB&apos;);&#x000D;&#x000A;                    else&#x000D;&#x000A;                        EVM_wDPD_Iter2(SweepIdx) = getvariable(&apos;SpectrumPlotComparison&apos;, &apos;E4__HSUPA_Avg_EVM_dB&apos;);&#x000D;&#x000A;                    end&#x000D;&#x000A;                end&#x000D;&#x000A;                % Iter3&#x000D;&#x000A;                if (m_CurrentIteration&gt;=3)&#x000D;&#x000A;                    if 1==EVM_SignalType&#x000D;&#x000A;                        EVM_wDPD_Iter3(SweepIdx) =  (getvariable(&apos;SpectrumPlotComparison&apos;, &apos;E5__Generic&apos;));&#x000D;&#x000A;                    elseif 2==EVM_SignalType&#x000D;&#x000A;                        temp = getvariable(&apos;SpectrumPlotComparison&apos;, &apos;E5__LTE_DL_EVM&apos;);&#x000D;&#x000A;                        EVM_wDPD_Iter3(SweepIdx) =  (temp(1));&#x000D;&#x000A;                    elseif 3==EVM_SignalType&#x000D;&#x000A;                        temp = getvariable(&apos;SpectrumPlotComparison&apos;, &apos;E5__LTE_UL_EVM&apos;);&#x000D;&#x000A;                        EVM_wDPD_Iter3(SweepIdx) =  (temp(1));&#x000D;&#x000A;                    elseif 4==EVM_SignalType&#x000D;&#x000A;                        EVM_wDPD_Iter3(SweepIdx) = getvariable(&apos;SpectrumPlotComparison&apos;, &apos;E5__WLAN_11ac_Avg_DataRCE_dB&apos;);&#x000D;&#x000A;                    elseif 5==EVM_SignalType&#x000D;&#x000A;                        EVM_wDPD_Iter3(SweepIdx) = getvariable(&apos;SpectrumPlotComparison&apos;, &apos;E5__HSDPA_Avg_EVM_dB&apos;);&#x000D;&#x000A;                    else&#x000D;&#x000A;                        EVM_wDPD_Iter3(SweepIdx) = getvariable(&apos;SpectrumPlotComparison&apos;, &apos;E5__HSUPA_Avg_EVM_dB&apos;);&#x000D;&#x000A;                    end&#x000D;&#x000A;                end&#x000D;&#x000A;                %EVM w/o DPD Step2&#x000D;&#x000A;                if (DisplayStep2PAOut==1)&#x000D;&#x000A;                    if 1==EVM_SignalType&#x000D;&#x000A;                        EVM_woDPD_Step2(SweepIdx) =  (getvariable(&apos;SpectrumPlotComparison&apos;, &apos;E6__Generic&apos;));&#x000D;&#x000A;                    elseif 2==EVM_SignalType&#x000D;&#x000A;                        temp = getvariable(&apos;SpectrumPlotComparison&apos;, &apos;E6__LTE_DL_EVM&apos;);&#x000D;&#x000A;                        EVM_woDPD_Step2(SweepIdx) =  (temp(1));&#x000D;&#x000A;                    elseif 3==EVM_SignalType&#x000D;&#x000A;                        temp = getvariable(&apos;SpectrumPlotComparison&apos;, &apos;E6__LTE_UL_EVM&apos;);&#x000D;&#x000A;                        EVM_woDPD_Step2(SweepIdx) =  (temp(1));&#x000D;&#x000A;                    elseif 4==EVM_SignalType&#x000D;&#x000A;                        EVM_woDPD_Step2(SweepIdx) = getvariable(&apos;SpectrumPlotComparison&apos;, &apos;E6__WLAN_11ac_Avg_DataRCE_dB&apos;);&#x000D;&#x000A;                    elseif 5==EVM_SignalType&#x000D;&#x000A;                        EVM_woDPD_Step2(SweepIdx) = getvariable(&apos;SpectrumPlotComparison&apos;, &apos;E6__HSDPA_Avg_EVM_dB&apos;);&#x000D;&#x000A;                    else&#x000D;&#x000A;                        EVM_woDPD_Step2(SweepIdx) = getvariable(&apos;SpectrumPlotComparison&apos;, &apos;E6__HSUPA_Avg_EVM_dB&apos;);&#x000D;&#x000A;                    end&#x000D;&#x000A;                end&#x000D;&#x000A;            end&#x000D;&#x000A;            % ACP cal&#x000D;&#x000A;            fre = FCarrier + RefOffset;&#x000D;&#x000A;            acp_fstart = fre-RefBW/2;&#x000D;&#x000A;            acp_fstop = fre+RefBW/2;&#x000D;&#x000A;            &#x000D;&#x000A;            fre = FCarrier + LowerOffset;&#x000D;&#x000A;            lower_fstart = fre-LowerBW/2;&#x000D;&#x000A;            lower_fstop = fre+LowerBW/2;&#x000D;&#x000A;            &#x000D;&#x000A;            fre = FCarrier + UpperOffset;&#x000D;&#x000A;            upper_fstart = fre-UpperBW/2;&#x000D;&#x000A;            upper_fstop = fre+UpperBW/2;&#x000D;&#x000A;            &#x000D;&#x000A;            %ACP with DPD output&#x000D;&#x000A;            indxes = find(DPD_PAOutput_Power_Freq &gt;= acp_fstart &amp; DPD_PAOutput_Power_Freq &lt;= acp_fstop);&#x000D;&#x000A;            Pow_Ref_wDPD(SweepIdx) = dbm(sum(DPD_PAOutput_Power(indxes)));&#x000D;&#x000A;            &#x000D;&#x000A;            indxes = find(DPD_PAOutput_Power_Freq &gt;= lower_fstart &amp; DPD_PAOutput_Power_Freq &lt;= lower_fstop);&#x000D;&#x000A;            Pow_Lower_wDPD(SweepIdx) = dbm(sum(DPD_PAOutput_Power(indxes)));&#x000D;&#x000A;            &#x000D;&#x000A;            indxes = find(DPD_PAOutput_Power_Freq &gt;= upper_fstart &amp; DPD_PAOutput_Power_Freq &lt;= upper_fstop);&#x000D;&#x000A;            Pow_Upper_wDPD(SweepIdx) = dbm(sum(DPD_PAOutput_Power(indxes)));&#x000D;&#x000A;            &#x000D;&#x000A;            ACP_Lower_wDPD(SweepIdx) = Pow_Lower_wDPD(SweepIdx) - Pow_Ref_wDPD(SweepIdx);&#x000D;&#x000A;            ACP_Upper_wDPD(SweepIdx) = Pow_Upper_wDPD(SweepIdx) - Pow_Ref_wDPD(SweepIdx);&#x000D;&#x000A;            &#x000D;&#x000A;            %ACP w/o DPD output&#x000D;&#x000A;            if PowerBackoff == 1&#x000D;&#x000A;                indxes = find(NoDPD_PAOutput_Power_Freq &gt;= acp_fstart &amp; NoDPD_PAOutput_Power_Freq &lt;= acp_fstop);&#x000D;&#x000A;                Pow_Ref_woDPD(SweepIdx) = dbm(sum(NoDPD_PAOutput_Power(indxes)));&#x000D;&#x000A;            &#x000D;&#x000A;                indxes = find(NoDPD_PAOutput_Power_Freq &gt;= lower_fstart &amp; NoDPD_PAOutput_Power_Freq &lt;= lower_fstop);&#x000D;&#x000A;                Pow_Lower_woDPD(SweepIdx) = dbm(sum(NoDPD_PAOutput_Power(indxes)));&#x000D;&#x000A;            &#x000D;&#x000A;                indxes = find(NoDPD_PAOutput_Power_Freq &gt;= upper_fstart &amp; NoDPD_PAOutput_Power_Freq &lt;= upper_fstop);&#x000D;&#x000A;                Pow_Upper_woDPD(SweepIdx) = dbm(sum(NoDPD_PAOutput_Power(indxes)));&#x000D;&#x000A;            &#x000D;&#x000A;                ACP_Lower_woDPD(SweepIdx) = Pow_Lower_woDPD(SweepIdx) - Pow_Ref_woDPD(SweepIdx);&#x000D;&#x000A;                ACP_Upper_woDPD(SweepIdx) = Pow_Upper_woDPD(SweepIdx) - Pow_Ref_woDPD(SweepIdx);&#x000D;&#x000A;            end&#x000D;&#x000A;            &#x000D;&#x000A;            %ACP input&#x000D;&#x000A;            indxes = find(Origin_Sig_Power_Freq &gt;= acp_fstart &amp; Origin_Sig_Power_Freq &lt;= acp_fstop);&#x000D;&#x000A;            Pow_Ref_Orig(SweepIdx) = dbm(sum(Origin_Sig_Power(indxes)));&#x000D;&#x000A;            &#x000D;&#x000A;            indxes = find(Origin_Sig_Power_Freq &gt;= lower_fstart &amp; Origin_Sig_Power_Freq &lt;= lower_fstop);&#x000D;&#x000A;            Pow_Lower_Orig(SweepIdx) = dbm(sum(Origin_Sig_Power(indxes)));&#x000D;&#x000A;            &#x000D;&#x000A;            indxes = find(Origin_Sig_Power_Freq &gt;= upper_fstart &amp; Origin_Sig_Power_Freq &lt;= upper_fstop);&#x000D;&#x000A;            Pow_Upper_Orig(SweepIdx) = dbm(sum(Origin_Sig_Power(indxes)));&#x000D;&#x000A;            &#x000D;&#x000A;            ACP_Lower_Orig(SweepIdx) = Pow_Lower_Orig(SweepIdx) - Pow_Ref_Orig(SweepIdx);&#x000D;&#x000A;            ACP_Upper_Orig(SweepIdx) = Pow_Upper_Orig(SweepIdx) - Pow_Ref_Orig(SweepIdx);&#x000D;&#x000A;            &#x000D;&#x000A;            %ACP iter2 wDPD output&#x000D;&#x000A;            if (m_CurrentIteration&gt;=2)&#x000D;&#x000A;                indxes = find(DPD_PAOutput_Iter2_Power_Freq &gt;= acp_fstart &amp; DPD_PAOutput_Iter2_Power_Freq &lt;= acp_fstop);&#x000D;&#x000A;                ACP_Ref_wDPD_Iter2(SweepIdx) = dbm(sum(DPD_PAOutput_Iter2_Power(indxes)));&#x000D;&#x000A;                &#x000D;&#x000A;                indxes = find(DPD_PAOutput_Iter2_Power_Freq &gt;= lower_fstart &amp; DPD_PAOutput_Iter2_Power_Freq &lt;= lower_fstop);&#x000D;&#x000A;                ACP_Lower_wDPD_Iter2(SweepIdx)= dbm(sum(DPD_PAOutput_Iter2_Power(indxes)));&#x000D;&#x000A;                &#x000D;&#x000A;                indxes = find(DPD_PAOutput_Iter2_Power_Freq &gt;= upper_fstart &amp; DPD_PAOutput_Iter2_Power_Freq &lt;= upper_fstop);&#x000D;&#x000A;                ACP_Upper_wDPD_Iter2(SweepIdx)= dbm(sum(DPD_PAOutput_Iter2_Power(indxes)));&#x000D;&#x000A;                &#x000D;&#x000A;                ACP_Lower_wDPD_Iter2(SweepIdx) = ACP_Lower_wDPD_Iter2(SweepIdx) - ACP_Ref_wDPD_Iter2(SweepIdx);&#x000D;&#x000A;                ACP_Upper_wDPD_Iter2(SweepIdx) = ACP_Upper_wDPD_Iter2(SweepIdx) - ACP_Ref_wDPD_Iter2(SweepIdx);&#x000D;&#x000A;            end&#x000D;&#x000A;            &#x000D;&#x000A;            %ACP iter3 wDPD output&#x000D;&#x000A;            if (m_CurrentIteration&gt;=3)&#x000D;&#x000A;                indxes = find(DPD_PAOutput_Iter3_Power_Freq &gt;= acp_fstart &amp; DPD_PAOutput_Iter3_Power_Freq &lt;= acp_fstop);&#x000D;&#x000A;                ACP_Ref_wDPD_Iter3(SweepIdx) = dbm(sum(DPD_PAOutput_Iter3_Power(indxes)));&#x000D;&#x000A;                &#x000D;&#x000A;                indxes = find(DPD_PAOutput_Iter3_Power_Freq &gt;= lower_fstart &amp; DPD_PAOutput_Iter3_Power_Freq &lt;= lower_fstop);&#x000D;&#x000A;                ACP_Lower_wDPD_Iter3(SweepIdx) = dbm(sum(DPD_PAOutput_Iter3_Power(indxes)));&#x000D;&#x000A;                &#x000D;&#x000A;                indxes = find(DPD_PAOutput_Iter3_Power_Freq &gt;= upper_fstart &amp; DPD_PAOutput_Iter3_Power_Freq &lt;= upper_fstop);&#x000D;&#x000A;                ACP_Upper_wDPD_Iter3(SweepIdx) = dbm(sum(DPD_PAOutput_Iter3_Power(indxes)));&#x000D;&#x000A;                &#x000D;&#x000A;                ACP_Lower_wDPD_Iter3(SweepIdx) = ACP_Lower_wDPD_Iter3(SweepIdx) - ACP_Ref_wDPD_Iter3(SweepIdx);&#x000D;&#x000A;                ACP_Upper_wDPD_Iter3(SweepIdx) = ACP_Upper_wDPD_Iter3(SweepIdx) - ACP_Ref_wDPD_Iter3(SweepIdx);&#x000D;&#x000A;            end&#x000D;&#x000A;            %ACP woDPD output&#x000D;&#x000A;            if (DisplayStep2PAOut==1)&#x000D;&#x000A;                indxes = find(Step2_PAOutput_Power_Freq &gt;= acp_fstart &amp; Step2_PAOutput_Power_Freq &lt;= acp_fstop);&#x000D;&#x000A;                ACP_Ref_woDPD_Step2(SweepIdx) = dbm(sum(Step2_PAOutput_Power(indxes)));&#x000D;&#x000A;                &#x000D;&#x000A;                indxes = find(Step2_PAOutput_Power_Freq &gt;= lower_fstart &amp; Step2_PAOutput_Power_Freq &lt;= lower_fstop);&#x000D;&#x000A;                ACP_Lower_woDPD_Step2(SweepIdx)= dbm(sum(Step2_PAOutput_Power(indxes)));&#x000D;&#x000A;                &#x000D;&#x000A;                indxes = find(Step2_PAOutput_Power_Freq &gt;= upper_fstart &amp; Step2_PAOutput_Power_Freq &lt;= upper_fstop);&#x000D;&#x000A;                ACP_Upper_woDPD_Step2(SweepIdx)= dbm(sum(Step2_PAOutput_Power(indxes)));&#x000D;&#x000A;                &#x000D;&#x000A;                ACP_Lower_woDPD_Step2(SweepIdx) = ACP_Lower_woDPD_Step2(SweepIdx) - ACP_Ref_woDPD_Step2(SweepIdx);&#x000D;&#x000A;                ACP_Upper_woDPD_Step2(SweepIdx) = ACP_Upper_woDPD_Step2(SweepIdx) - ACP_Ref_woDPD_Step2(SweepIdx);&#x000D;&#x000A;            end&#x000D;&#x000A;        end&#x000D;&#x000A;    end&#x000D;&#x000A;    &#x000D;&#x000A;    senduimessage Complete;&#x000D;&#x000A;    &#x000D;&#x000A;    if (EnablePowerSweep)&#x000D;&#x000A;        setindep(&apos;NMSE_Sweep&apos;, &apos;SweepList&apos;);&#x000D;&#x000A;        setindep(&apos;ACP_Lower_wDPD&apos;, &apos;SweepList&apos;);&#x000D;&#x000A;        setindep(&apos;ACP_Upper_wDPD&apos;, &apos;SweepList&apos;);&#x000D;&#x000A;        setindep(&apos;ACP_Lower_woDPD&apos;, &apos;SweepList&apos;);&#x000D;&#x000A;        setindep(&apos;ACP_Upper_woDPD&apos;, &apos;SweepList&apos;);&#x000D;&#x000A;        setindep(&apos;ACP_Lower_Orig&apos;, &apos;SweepList&apos;);&#x000D;&#x000A;        setindep(&apos;ACP_Upper_Orig&apos;, &apos;SweepList&apos;);&#x000D;&#x000A;    end&#x000D;&#x000A;end</Text>
