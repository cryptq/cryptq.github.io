<Item XName="f_CaptureDUTResponse" UserName="f_CaptureDUTResponse" Type="function">
<AutoCalc><T>Bool</T><D>0</D></AutoCalc>
<Selected><T>Bool</T><D>0</D></Selected>
<Text>function [flag, Att_new] = f_CaptureDUTResponse(type, VSAVersion, AnalyzerAddress, FCarrier, SamplingRate, CapturedTime, PowerBackoff, Iter, Att)&#x000D;&#x000A;    ContinueOnError=1;&#x000D;&#x000A;&#x0009;Att_new = Att;&#x000D;&#x000A;&#x0009;if type==1&#x000D;&#x000A;&#x0009;   &#x0009;%%% Step 2.1-1: Save Baseband Input&#x000D;&#x000A;&#x0009;&#x0009;flag = runanalysis(&apos;AdjustRFPower Analysis&apos;, ContinueOnError);&#x000D;&#x000A;&#x0009;&#x0009;if (flag == 0)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;senduimessage(&apos;AdjustRFPower Analysis is terminated. See Simulation/Error Log for details.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;return;&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;&#x0009;%%% Step 2.2: Capture PA Output Signal&#x000D;&#x000A;&#x0009;&#x0009;% Connect DUT with Spectrum Analyzer&#x000D;&#x000A;&#x0009;&#x0009;% Signal Generator --&gt; DUT --&gt; Spectrum Analyzer&#x000D;&#x000A;&#x0009;&#x0009;if PowerBackoff==1 || Iter==1&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;CaptureDataType = 1; % PA Output&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;flag = runanalysis(&apos;CaptureDUTResponse Analysis&apos;, ContinueOnError);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;if(flag == 0)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;senduimessage(&apos;CaptureDUTResponse Analysis is terminated. See Simulation/Error Log for details.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;return;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;else&#x000D;&#x000A;&#x0009;&#x0009;%%% Step 2.1-2: Capture RF Input&#x000D;&#x000A;&#x0009;&#x0009;% Connect Signal Generator directly with Spectrum Analyzer&#x000D;&#x000A;&#x0009;&#x0009;% Signal Generator --&gt; Spectrum Analyzer&#x000D;&#x000A;&#x0009;&#x0009;CaptureDataType = 0; % PA Input&#x000D;&#x000A;        %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%&#x000D;&#x000A;        %%%%%%%%%%%User Defined Codes To Control   %%%%%%%%%%%%%%%&#x000D;&#x000A;        %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% &#x000D;&#x000A;        % The following codes are to control N6705B DC power analyzer&#x000D;&#x000A;        % to output different voltages to control pin switch so that &#x000D;&#x000A;        % Signal Generator is directly connected with Spectrum Analyzer&#x000D;&#x000A;        &#x000D;&#x000A;        % Define DC power analyzer IP address&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;%dcIP=&apos;111.222.333.444&apos;;&#x000D;&#x000A;&#x0009;&#x0009;%dcSply=tcpip(dcIP, 5025);&#x000D;&#x000A;&#x0009;&#x0009;% Set output voltages&#x000D;&#x000A;&#x0009;&#x0009;%idxDC = 1;&#x000D;&#x000A;&#x0009;&#x0009;%dcBiases = [0.1; 3.0]; &#x000D;&#x000A;&#x0009;&#x0009;%fopen(dcSply);&#x000D;&#x000A;&#x0009;&#x0009;%dcCmdStr=[&apos;:VOLT &apos; num2str(dcBiases(idxDC)) &apos;,(@2)&apos;]; Instr_SendSCPICommands(dcSply, dcCmdStr); &#x000D;&#x000A;&#x0009;&#x0009;%idxDC = 2;&#x000D;&#x000A;&#x0009;&#x0009;%dcCmdStr=[&apos;:VOLT &apos; num2str(dcBiases(idxDC)) &apos;,(@3)&apos;]; Instr_SendSCPICommands(dcSply, dcCmdStr);&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;&#x0009;% Run the commands&#x000D;&#x000A;&#x0009;&#x0009;%fprintf(dcSply, &apos;:SYST:ERR?&apos;);&#x000D;&#x000A;&#x0009;&#x0009;%statusRes = fgets(dcSply);&#x000D;&#x000A;&#x0009;&#x0009;%fclose(dcSply);&#x000D;&#x000A;        %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%&#x000D;&#x000A;        %%%%%%%%%User Defined Code end%%%%%%%%%%%%%%%%%%%%%%%%%%%%&#x000D;&#x000A;        %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%&#x000D;&#x000A;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;flag = runanalysis(&apos;CaptureRFInput Analysis&apos;, ContinueOnError);&#x000D;&#x000A;&#x0009;&#x0009;if (flag == 0)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;senduimessage(&apos;CaptureRFInput Analysis is terminated. See Simulation/Error Log for details.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;return;&#x000D;&#x000A;&#x0009;&#x0009;end&#x0009;&#x0009;&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;&#x0009;%%% Step 2.2: Capture PA Output Signal&#x000D;&#x000A;&#x0009;&#x0009;% Connect DUT with Spectrum Analyzer&#x000D;&#x000A;&#x0009;&#x0009;% Signal Generator --&gt; DUT --&gt; Spectrum Analyzer&#x000D;&#x000A;&#x0009;&#x0009;if PowerBackoff==1 || Iter==1&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;CaptureDataType = 1; % PA Output&#x000D;&#x000A;&#x0009;        %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%&#x000D;&#x000A;&#x0009;        %%%%%%%%%%%User Defined Codes To Control   %%%%%%%%%%%%%%%&#x000D;&#x000A;&#x0009;        %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% &#x000D;&#x000A;&#x0009;        % The following codes are to control N6705B DC power analyzer&#x000D;&#x000A;&#x0009;        % to output different voltages to control pin switch so that &#x000D;&#x000A;&#x0009;        % Signal Generator --&gt; PA--&gt; Spectrum Analyzer&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;% Set output voltages&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;%idxDC = 2;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;%fopen(dcSply);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;%dcCmdStr=[&apos;:VOLT &apos; num2str(dcBiases(idxDC)) &apos;,(@2)&apos;]; Instr_SendSCPICommands(dcSply, dcCmdStr); &#x000D;&#x000A;&#x0009;&#x0009;&#x0009;%idxDC = 1;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;%dcCmdStr=[&apos;:VOLT &apos; num2str(dcBiases(idxDC)) &apos;,(@3)&apos;]; Instr_SendSCPICommands(dcSply, dcCmdStr);&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;% Run the commands&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;%fprintf(dcSply, &apos;:SYST:ERR?&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;%statusRes = fgets(dcSply);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;%fclose(dcSply);&#x000D;&#x000A;&#x0009;        %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%&#x000D;&#x000A;&#x0009;        %%%%%%User Defined Code end%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%&#x000D;&#x000A;&#x0009;        %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;if VSAVersion == 0 % ce&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;    %Do_AutoRange;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;Att_new = f_AutoRange(AnalyzerAddress, FCarrier, SamplingRate, CapturedTime);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;else&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;close89600vsa(1);&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;flag = runanalysis(&apos;CaptureDUTResponse Analysis&apos;, ContinueOnError);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;if (flag == 0)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;senduimessage(&apos;CaptureDUTResponse Analysis is terminated. See Simulation/Error Log for details.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;return;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;end&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end</Text>
