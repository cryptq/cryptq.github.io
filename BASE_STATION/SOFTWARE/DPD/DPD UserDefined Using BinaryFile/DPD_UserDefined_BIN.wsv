<Selected><T>Bool</T><D>0</D></Selected>
<Text>if(EnableAutoDPD)&#x000D;&#x000A;   CurrentIteration_new = m_CurrentIteration;&#x000D;&#x000A;else&#x000D;&#x000A;   CurrentIteration_new = CurrentIteration;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if (CurrentIteration_new == 1)&#x000D;&#x000A;&#x0009;DPD_Enable = 2;&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;DPD_Enable = 0;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;DPD_Coefficients_Real_FileName = [&apos;Step3_DPD_Coefficients_Real_Iter&apos; num2str(CurrentIteration_new-1) &apos;.txt&apos;];&#x000D;&#x000A;DPD_Coefficients_Imag_FileName = [&apos;Step3_DPD_Coefficients_Imag_Iter&apos; num2str(CurrentIteration_new-1) &apos;.txt&apos;];&#x000D;&#x000A;&#x000D;&#x000A;Step1_BBData_FileName = [&apos;Step1_BBData_Iter&apos; num2str(CurrentIteration_new) &apos;.bin&apos;];&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;LUT_Power_File = [&apos;Step3_DPD_LUT_Power_Iter&apos; num2str(CurrentIteration_new-1) &apos;.txt&apos;];&#x000D;&#x000A;LUT_Gain_File = [&apos;Step3_DPD_LUT_Gain_Iter&apos; num2str(CurrentIteration_new-1) &apos;.txt&apos;];&#x000D;&#x000A;LUT_Phase_File = [&apos;Step3_DPD_LUT_Phase_Iter&apos; num2str(CurrentIteration_new-1) &apos;.txt&apos;];&#x000D;&#x000A;&#x000D;&#x000A;StartSample = TimeStart * 1e-3 * SamplingRate;&#x000D;&#x000A;StopSample = TimeStop * 1e-3 * SamplingRate;&#x000D;&#x000A;StartSample = TimeStart * 1e-3 * SamplingRate;&#x000D;&#x000A;StopSample = TimeStop * 1e-3 * SamplingRate;&#x000D;&#x000A;NumSampsStep1=floor(StopSample-StartSample+0.5);&#x000D;&#x000A;&#x000D;&#x000A;if (CFREnable == 1)&#x000D;&#x000A;    if (CFR_Algorithm==0)&#x000D;&#x000A;&#x0009;    UseCFR1 = 0;&#x000D;&#x000A;&#x0009;&#x0009;UseCFR2 = 1;&#x000D;&#x000A;&#x0009;else &#x000D;&#x000A;&#x0009;&#x0009;UseCFR2 = 0;&#x000D;&#x000A;&#x0009;&#x0009;UseCFR1 = 1;&#x000D;&#x000A;&#x0009;end;&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;UseCFR1 = 1;&#x000D;&#x000A;&#x0009;UseCFR2 = 2;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;if InputSignal==3&#x000D;&#x000A;&#x0009;UseCFR1 = 1;&#x000D;&#x000A;&#x0009;UseCFR2 = 1;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if InstrumentType==1&#x000D;&#x000A;&#x0009;InitOptions = [&apos;QueryInstrStatus=false, Simulate=false, DriverSetup= DDS=false, Model=M9330A, Trace=false&apos;];&#x000D;&#x000A;elseif InstrumentType==2&#x000D;&#x000A;&#x0009;InitOptions = [&apos;QueryInstrStatus=false, Simulate=false, DriverSetup= DDS=false, Model=M9331A, Trace=false&apos;];&#x000D;&#x000A;elseif InstrumentType==3&#x000D;&#x000A;&#x0009;InitOptions = [&apos;QueryInstrStatus=false, Simulate=false, DriverSetup= DDS=false, Model=N6030A, Trace=false&apos;];&#x000D;&#x000A;elseif InstrumentType==4&#x000D;&#x000A;&#x0009;InitOptions = [&apos;QueryInstrStatus=false, Simulate=false, DriverSetup= DDS=false, Model=N6031A, Trace=false&apos;];&#x000D;&#x000A;elseif InstrumentType==5&#x000D;&#x000A;&#x0009;InitOptions = [&apos;QueryInstrStatus=false, Simulate=false, DriverSetup= DDS=false, Model=N6032A, Trace=false&apos;];&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;InitOptions = [&apos;QueryInstrStatus=false, Simulate=false, DriverSetup= DDS=false, Model=N6033A, Trace=false&apos;];&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if InstrumentType==0&#x000D;&#x000A;&#x0009;UseESG = 0;&#x000D;&#x000A;&#x0009;UsePXI = 1;&#x000D;&#x000A;&#x0009;UseM9381 = 1;&#x000D;&#x000A;elseif InstrumentType &lt; 7&#x000D;&#x000A;&#x0009;UseESG = 1;&#x000D;&#x000A;&#x0009;UsePXI = 0;&#x000D;&#x000A;&#x0009;UseM9381 = 1;&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;UseESG = 1;&#x000D;&#x000A;&#x0009;UsePXI = 1;&#x000D;&#x000A;&#x0009;UseM9381 = 0;&#x000D;&#x000A;end&#x000D;&#x000A;&#x0009;&#x000D;&#x000A;Step1_BBData_File1 = &apos;Step1_BBData_Iter1.bin&apos;;&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;if (CurrentIteration_new==1)&#x000D;&#x000A;    UseFileReader = 1-(InputSignal==0);&#x000D;&#x000A;    UseSSFileReader = 1-(InputSignal==1);&#x000D;&#x000A;    UseVSASource = 1-(InputSignal==2);&#x000D;&#x000A;    LTE_DL_Enable = 1-(InputSignal==3);&#x000D;&#x000A;    LTE_UL_Enable = 1-(InputSignal==4);&#x000D;&#x000A;    WLAN_11ac_Enable = 1-(InputSignal==5);&#x000D;&#x000A;    %HSDPA_Enable = 1-(InputSignal==4);&#x000D;&#x000A;    %HSUPA_Enable = 1-(InputSignal==5);&#x000D;&#x000A;&#x0009;ReadBB =1;&#x000D;&#x000A;else&#x000D;&#x000A;    UseFileReader = 1;&#x000D;&#x000A;    UseSSFileReader = 1;&#x000D;&#x000A;    UseVSASource = 1;&#x000D;&#x000A;    LTE_DL_Enable = 1;&#x000D;&#x000A;    LTE_UL_Enable = 1;&#x000D;&#x000A;    WLAN_11ac_Enable = 1;&#x000D;&#x000A;    %HSDPA_Enable = 1;&#x000D;&#x000A;    %HSUPA_Enable = 1;&#x000D;&#x000A;&#x0009;ReadBB =0;&#x000D;&#x000A;&#x0009;UseCFR1 =1;&#x000D;&#x000A;&#x0009;UseCFR2 =1;&#x000D;&#x000A;end;&#x000D;&#x000A;&#x000D;&#x000A;if DPD_Enable==2&#x000D;&#x000A;&#x0009;UseOrigin = 2;&#x000D;&#x000A;&#x0009;UseCustom = 1;&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;UseOrigin = UseCustomPreDistorter;&#x000D;&#x000A;&#x0009;UseCustom = 1-UseCustomPreDistorter;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if (EnableAutoDPD == 0)&#x000D;&#x000A;&#x0009;PowerAlignment = getvariable(&apos;DUTModelExtraction Analysis_Data&apos;,&apos;Gain&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if (EnableAutoDPD == 0)&#x000D;&#x000A;&#x0009;tempRFPower = OriginRFPower;&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;tempRFPower = Step1RFPower;&#x000D;&#x000A;end&#x000D;&#x000A;tempRFPower = 10^((tempRFPower -30)/10);&#x000D;&#x000A;&#x000D;&#x000A;NumRB = [6,15,25,50,75,100];&#x000D;&#x000A;LTE_NumRB = NumRB(Bandwidth+1);</Text>
