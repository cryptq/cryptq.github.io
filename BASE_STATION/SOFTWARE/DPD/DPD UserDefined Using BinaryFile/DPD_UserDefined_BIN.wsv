<Item XName="Equations" Type="Equation">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>%clear all&#x0009;%clear is no longer recommended at the top of an equation&#x000D;&#x000A;LengthOfPiece = floor(NumOfInputSamples / 2);&#x000D;&#x000A;if(EnableAutoDPD)&#x000D;&#x000A;   CurrentIteration_new = m_CurrentIteration;&#x000D;&#x000A;else&#x000D;&#x000A;   CurrentIteration_new = CurrentIteration;&#x000D;&#x000A;end&#x000D;&#x000A;if (ModelType == 0)&#x000D;&#x000A;&#x0009;if (NonlinearOrderSelection==0)&#x000D;&#x000A;&#x0009;&#x0009;if (UseCustomModelExtractor==1)&#x000D;&#x000A;&#x0009;&#x0009;    CoefLength = floor((NonlinearOrder+1)/2);&#x000D;&#x000A;&#x0009;&#x0009;else&#x000D;&#x000A;&#x0009;&#x0009;    CoefLength = (MemoryOrder+1)*floor((NonlinearOrder+1)/2);&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;else&#x000D;&#x000A;&#x0009;&#x0009;if (UseCustomModelExtractor==1)&#x000D;&#x000A;&#x0009;&#x0009;    CoefLength = NonlinearOrder;&#x000D;&#x000A;&#x0009;&#x0009;else&#x000D;&#x000A;&#x0009;&#x0009;    CoefLength = (MemoryOrder+1) * NonlinearOrder;&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;K = floor((NonlinearOrder+1)/2);&#x000D;&#x000A;&#x0009;CoefLength = K * (MemoryOrder + 1) + CrossTermOrder * K * (K-1) / 2;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;DPD_Coefficients_Real_FileName = [&apos;Step3_DPD_Coefficients_Real_Iter&apos; num2str(CurrentIteration_new) &apos;.txt&apos;];&#x000D;&#x000A;DPD_Coefficients_Imag_FileName = [&apos;Step3_DPD_Coefficients_Imag_Iter&apos; num2str(CurrentIteration_new) &apos;.txt&apos;];&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;Step1_BBData_FileName = [&apos;Step1_BBData_Iter1.bin&apos;];&#x000D;&#x000A;%Step1_BBData_Imag_FileName = [&apos;Step1_BBData_Imag_Iter1.txt&apos;];&#x000D;&#x000A;&#x000D;&#x000A;Step2_PAInputdata_FileName = [&apos;Step2_PAInputdata_Iter&apos; num2str(CurrentIteration_new) &apos;.bin&apos;];&#x000D;&#x000A;%Step2_PAInputdata_Real_FileName = [&apos;Step2_PAInputdata_Real_Iter&apos; num2str(CurrentIteration_new) &apos;.txt&apos;];&#x000D;&#x000A;Step2_PAOutputdata_FileName = [&apos;Step2_PAOutputdata_Iter&apos; num2str(CurrentIteration_new) &apos;.bin&apos;];&#x000D;&#x000A;%Step2_PAOutputdata_Real_FileName = [&apos;Step2_PAOutputdata_Real_Iter&apos; num2str(CurrentIteration_new) &apos;.txt&apos;];&#x000D;&#x000A;&#x000D;&#x000A;LUT_Power_File = [&apos;Step3_DPD_LUT_Power_Iter&apos; num2str(CurrentIteration_new) &apos;.txt&apos;];&#x000D;&#x000A;LUT_Gain_File = [&apos;Step3_DPD_LUT_Gain_Iter&apos; num2str(CurrentIteration_new) &apos;.txt&apos;];&#x000D;&#x000A;LUT_Phase_File = [&apos;Step3_DPD_LUT_Phase_Iter&apos; num2str(CurrentIteration_new) &apos;.txt&apos;];&#x000D;&#x000A;&#x000D;&#x000A;if (SampleLevelDPD==0)&#x000D;&#x000A;&#x0009;UseRepeat = 2;&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;UseRepeat = 0;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;StartSample = TimeStart * 1e-3 * SamplingRate;&#x000D;&#x000A;StopSample = TimeStop * 1e-3 * SamplingRate;&#x000D;&#x000A;NumSampsStep1=floor(StopSample-StartSample+0.5);</Text>
<UnitUse><T>Int</T><D>2</D></UnitUse>
