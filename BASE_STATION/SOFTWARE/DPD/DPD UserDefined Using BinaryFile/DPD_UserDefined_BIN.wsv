<Item XName="EquationText" Type="PartParam">
<DataEntry>Corr_cx = zeros(SearchLength, 1);&#x000D;&#x000A;nPA_out = zeros(NumOfInputSamples, 1);&#x000D;&#x000A;nBB_in = zeros(NumOfInputSamples, 1);&#x000D;&#x000A;&#x000D;&#x000A;Ref_BB=BB_in(1:WindowLength);&#x000D;&#x000A;Ref_PA=PA_out(1:WindowLength);&#x000D;&#x000A;&#x000D;&#x000A;for idx = 1:SearchLength&#x000D;&#x000A;&#x0009;% row * col&#x000D;&#x000A;&#x0009;Corr_cx(idx) = sum( Ref_PA(idx+(0:SearchLength-1)) .* conj(Ref_BB(1:SearchLength)) );&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;Corr = abs(Corr_cx);&#x000D;&#x000A;Index = find( Corr == (max(Corr)) );&#x000D;&#x000A;&#x000D;&#x000A;nBB_in=BB_in;&#x000D;&#x000A;nBB_in(NumOfInputSamples-Index+1:NumOfInputSamples)=0.0;&#x000D;&#x000A;&#x000D;&#x000A;nPA_out(1:NumOfInputSamples-Index)=PA_out(Index+1:NumOfInputSamples);&#x000D;&#x000A;nPA_out(NumOfInputSamples-Index+1:NumOfInputSamples)=0.0;&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;</DataEntry>
<Description>Equation Text to Parse, edited in the equation set</Description>
<DocSymbol />
<IsSettable><T>Bool</T><D>0</D></IsSettable>
<Range />
<RunTimeTunable><T>Bool</T><D>0</D></RunTimeTunable>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>4</D></Validate></Item>
