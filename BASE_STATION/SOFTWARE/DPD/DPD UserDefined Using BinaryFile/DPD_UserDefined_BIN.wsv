<Item XName="f_QueryESGStatus" UserName="f_QueryESGStatus" Type="function">
<AutoCalc><T>Bool</T><D>1</D></AutoCalc>
<Selected><T>Bool</T><D>0</D></Selected>
<Text>function status = f_QueryESGStatus(Address)&#x000D;&#x000A;% Query the RF output status of ESG/MSG. If yes, the RF signal is ready&#x000D;&#x000A;instIO = tcpip(Address, 5025);&#x000D;&#x000A;%instIO.Timeout = 0.5;&#x000D;&#x000A;queryCmd = [&apos;:OUTPut:STATe?&apos; char(10)];&#x000D;&#x000A;%queryCmd = &apos;*IDN?;&apos;;&#x000D;&#x000A;fopen(instIO);&#x000D;&#x000A;status = 0;&#x000D;&#x000A;cnt = 0;&#x000D;&#x000A;while (status == 0 &amp; cnt &lt; 20)&#x000D;&#x000A;&#x0009;pause(0.5);&#x000D;&#x000A;&#x0009;status = Instr_SCPIQuery(instIO, queryCmd);&#x000D;&#x000A;&#x0009;cnt = cnt + 1;&#x000D;&#x000A;end;&#x000D;&#x000A;pause(2);&#x000D;&#x000A;fclose(instIO);&#x000D;&#x000A;</Text>
