<Netlist>PA_Out,PAOutput?Connect37|PA_In,PAInput?Connect40|DPD_Coef,DPD_Coef?Connect69|Scaled_PA_Out,PAOut_ModelValidation?Connect55|Shifted_PA_In,PAIn_Ref?Connect29|Scaled_PA_Out_Piece,PAOut_ModelExtraction?Connect30|Shifted_PA_In_Piece,PAIn_ModelExtraction?Connect27</Netlist>
<ParentPartName>MATLAB_Script@Algorithm Design</ParentPartName>
<SectionNum><T>Int</T><D>0</D></SectionNum>
<ShortSymbol />
<SimOverride><T>Int</T><D>6</D></SimOverride>
<Symbol>AutoSymDF{MATLAB_SCRIPT_LOGO}</Symbol>
<Item XName="ModelsParamSet" Type="ModelsParamSet">
<Item XName="ModelSet_0" Type="ModelListEntry">
<Indentifier />
<ModelName>MATLAB_Script@Data Flow Models</ModelName>
<SymbolName>MathSymDF</SymbolName>
<Item XName="ParamSet" Type="ParamSet">
<Item XName="EquationBP" Type="PartParam">
<DataEntry>[]</DataEntry>
<Description>Equation Breakpoints</Description>
<DocSymbol />
<IsSettable><T>Bool</T><D>0</D></IsSettable>
<Range />
<RunTimeTunable><T>Bool</T><D>0</D></RunTimeTunable>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>5</D></Validate></Item>
