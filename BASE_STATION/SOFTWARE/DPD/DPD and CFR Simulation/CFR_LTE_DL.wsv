<PVPort><T>Array_Dbl64</T><D>1;4;;;M3RDmryyk24;Qoa9Jc8gb24</D></PVPort>
<Show><T>Bool</T><D>1</D></Show>
<ShowCmd><T>Int</T><D>1</D></ShowCmd>
<Window><T>Array_I64</T><D>1;4;;;96;m4</D></Window>
<ZOrder><T>Int</T><D>2</D></ZOrder></Item></Item></Item>
