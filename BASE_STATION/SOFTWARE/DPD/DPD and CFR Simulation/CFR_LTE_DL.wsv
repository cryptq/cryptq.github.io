<Item XName="AvoidPhaseDiscontinuity" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>whether to avoid the phase discontinuity between consecutive frames</Description>
<Enum>DPD_CFREnable@DPD Enums</Enum>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="Bandwidth" Type="PartParam">
<DataEntry>Bandwidth</DataEntry>
<Description>bandwidth</Description>
<Enum>LTE_DL_Src_Bandwidth@LTE 8.9 Enums</Enum>
<HideCondition>0==ShowSystemParameters</HideCondition>
<Unit><T>Int</T><D>0</D></Unit>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="CFREnable" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>whether enable CFR or not</Description>
<Enum>DPD_CFREnable@DPD Enums</Enum>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="CI_StartPos" Type="PartParam">
<DataEntry>-3</DataEntry>
<Description>the start position of cyclic interval (without oversampling), compared to the start position of CP (negative means ahead of CP)</Description>
<HideCondition>0==ShowSpectrumShapingParameters || SpectrumShapingType ~= 0</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>11</D></Validate></Item>
<Item XName="CellID_Group" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>the index of cell identity within the physical-layer cell-identity group</Description>
<HideCondition>0==ShowSystemParameters</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>11</D></Validate></Item>
<Item XName="CellID_Sector" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>the index of cell identity group</Description>
<HideCondition>0==ShowSystemParameters</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>11</D></Validate></Item>
<Item XName="ClippingThreshold" Type="PartParam">
<DataEntry>0.0000165</DataEntry>
<Description>clipping threshold used in CFR</Description>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="CyclicInterval" Type="PartParam">
<DataEntry>6</DataEntry>
<Description>the overlapped cyclic interval between two adjacent symbols in unit of chips (without oversampling), valid when SpectrumShapingType=TimeWindowing</Description>
<HideCondition>0==ShowSpectrumShapingParameters || SpectrumShapingType ~= 0</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>11</D></Validate></Item>
<Item XName="CyclicPrefix" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>type of cyclic prefix</Description>
<Enum>LTE_DL_Src_CyclicPrefix@LTE 8.9 Enums</Enum>
<HideCondition>0==ShowSystemParameters</HideCondition>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="DMRS_Ra" Type="PartParam">
<DataEntry>[0,0,0,0,0,0]</DataEntry>
<Description>UE specific power parameter for DMRS of each UE</Description>
<Validate><T>Int</T><D>14</D></Validate></Item>
<Item XName="DisplayMsg" Type="PartParam">
<DataEntry>1</DataEntry>
<Description>the messages displayed in Simulation Log window</Description>
<Enum>LTE_DL_Src_DisplayMsg@LTE 8.9 Enums</Enum>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="EVM_Threshold_16QAM" Type="PartParam">
<DataEntry>0.1</DataEntry>
<Description>EVM threshold for 16QAM used in CFR</Description>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="EVM_Threshold_64QAM" Type="PartParam">
<DataEntry>0.1</DataEntry>
<Description>EVM threshold for 64QAM used in CFR</Description>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="EVM_Threshold_QPSK" Type="PartParam">
<DataEntry>0.1</DataEntry>
<Description>EVM threshold for QPSK used in CFR</Description>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="FIR_FilterType" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>spectrum-shaping FIR filter type, valid when SpectrumShapingType=FIRFilter</Description>
<Enum>LTE_DL_Src_FIR_FilterType@LTE 8.9 Enums</Enum>
<HideCondition>0==ShowSpectrumShapingParameters || SpectrumShapingType  ~= 1</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="FIR_Taps" Type="PartParam">
<DataEntry>19</DataEntry>
<Description>number of FIR filter taps, valid when SpectrumShapingType=FIRFilter</Description>
<HideCondition>0==ShowSpectrumShapingParameters || SpectrumShapingType ~= 1</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>11</D></Validate></Item>
<Item XName="FIR_withInterp" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>whether spectrum-shaping FIR filter with interpolation operation or not, valid when SpectrumShapingType=FIRFilter</Description>
<Enum>LTE_DL_Src_FIR_withInterp@LTE 8.9 Enums</Enum>
<HideCondition>0==ShowSpectrumShapingParameters || SpectrumShapingType ~= 1</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
