<Item XName="NumFrames" Type="PartParam">
<DataEntry>1</DataEntry>
<Enum />
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>11</D></Validate></Item>
<Item XName="OtherUEs_MappingType" Type="PartParam">
<DataEntry>[0,0,0,0,0]</DataEntry>
