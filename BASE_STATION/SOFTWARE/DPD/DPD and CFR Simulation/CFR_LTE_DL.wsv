<Item XName="PeriodicInput" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>YES means input data are periodic, e.g. data read from an SDF file. Apply periodicity may help eliminate VSA demod discontinuity for such inputs.</Description>
<DocSymbol />
<Enum>VSA_89600B_Sink__PeriodicInput@Data Flow Enums</Enum>
<Range />
<RunTimeTunable><T>Bool</T><D>0</D></RunTimeTunable>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="RecordMode" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>YES enables VSA 89600B Recording mode; NO disables; Stop must be &gt; Start, ContinuousMode = NO</Description>
<DocSymbol />
<Enum>VSA_89600B_Sink__RecordMode@Data Flow Enums</Enum>
<HideCondition>ContinuousMode == 1</HideCondition>
<Range />
<RunTimeTunable><T>Bool</T><D>0</D></RunTimeTunable>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="RestoreHW" Type="PartParam">
