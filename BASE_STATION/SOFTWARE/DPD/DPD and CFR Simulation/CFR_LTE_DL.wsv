<HideCondition>0==ShowPowerParameters</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="PDCCH_Common_AggreLevel" Type="PartParam">
<DataEntry>[4]</DataEntry>
<Description>the aggregation levels of Common PDCCH search space for every subframe.  The allowable levels are 4 and 8.</Description>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PDCCH_Common_DCI_Formats" Type="PartParam">
<DataEntry>[-1, -1, -1, -1]</DataEntry>
<Description>the DCI Formats of the PDCCH candidates for every subframe (-1 means no DCI in corresponding candidate).</Description>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PDCCH_Ra" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>PDCCH-to-RS EPRE ratio in dB  in symbols with RS</Description>
<HideCondition>0==ShowPowerParameters</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="PDCCH_Rb" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>PDCCH-to-RS EPRE ratio in dB in symbols without RS</Description>
<HideCondition>0==ShowPowerParameters</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="PDCCH_SymsPerSF" Type="PartParam">
<DataEntry>[2,2,2,2,2,2,2,2,2,2]</DataEntry>
<Description>number of OFDM symbols of PDCCH for each subframe</Description>
<HideCondition>0==ShowControlChannelParameters</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PDCCH_UE_AggreLevel" Type="PartParam">
<DataEntry>[1]</DataEntry>
<Description>the aggregation levels of UE-specific PDCCH search space for every subframe. The allowable levels are 1, 2, 4 and 8.</Description>
<Validate><T>Int</T><D>13</D></Validate></Item>
