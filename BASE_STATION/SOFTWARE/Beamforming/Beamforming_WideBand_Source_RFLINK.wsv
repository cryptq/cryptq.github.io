<Item XName="Equations" Type="Equation">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>% ------------------------------------ System Configuration -------------------------------------&#x000D;&#x000A;fc = 28.5e9; % carrier frequency&#x000D;&#x000A;BaseSampleRate = 2e9; % sample rate for OFDM source without oversampling&#x000D;&#x000A;OversamplingRatio = 0; % oversampling ratio for OFDM source&#x000D;&#x000A;fs = BaseSampleRate*2^OversamplingRatio; % sampling rate with oversampling&#x000D;&#x000A;Power_dBm = 10; % signal power per each RF chain&#x000D;&#x000A;SNR = 50;       % signal to noise ratio at each RF chain&#x000D;&#x000A;NumOfRFChains = 4; % number of RF Chains in Tx&#x000D;&#x000A;Theta = [45; 75; 105; 135]/180*pi; % target theta for each RF chain&#x000D;&#x000A;Phi = [30; 330; 30; 330]/180*pi;  % target phi for each RF chain&#x000D;&#x000A;NumSamples = 4; % number of samples saved for plotting&#x000D;&#x000A;AntennaPatternType = 3; % 0-Omni directional antenna element, 1-3Sector directional antenna element, 2-Cosine Antenna 3-UserDefined antenna element pattern&#x000D;&#x000A;AntennaPatternFileType = 1; % 0-EMPro, 1-HFSS&#x000D;&#x000A;if AntennaPatternFileType == 1&#x000D;&#x000A;&#x0009;AntennaPatternFileName = &apos;HFSS_rE_Phi&amp;Theta_Re&amp;Im_ANT001.csv&apos;; %used when AntennaPatternType = 2; &#x000D;&#x000A;elseif AntennaPatternFileType == 0&#x000D;&#x000A;&#x0009;AntennaPatternFileName = &apos;EMPro_Pattern001.uan&apos;; %used when AntennaPatternType = 2; &#x000D;&#x000A;end&#x000D;&#x000A;AntArrayWindowType = 0; %flag to enable windowing in antenna array&#x000D;&#x000A;SideLobeLevel = -35;  %if AntArrayWindowType is true, the sidelobe level for Taylor window&#x000D;&#x000A;&#x000D;&#x000A;% --------------------------------- Antenna Array Configuration ----------------------------------&#x000D;&#x000A;%Note antenna array should be placed in yz plane&#x000D;&#x000A;NumOfAntx = 1; % number of antennas in x-axis direction in Tx, currently, only support NumOfAntx=1&#x000D;&#x000A;NumOfAnty = 8; % number of antennas in y-axis direction in Tx&#x000D;&#x000A;NumOfAntz = 8; % number of antennas in z-axis direction in Tx&#x000D;&#x000A;Nt = NumOfAntx * NumOfAnty * NumOfAntz; % overall antenna number in Tx&#x000D;&#x000A;BearingAngle = zeros(Nt,1); % LCS-&gt;GCS for antenna element pattern&#x000D;&#x000A;DowntiltAngle = zeros(Nt,1); % LCS-&gt;GCS for antenna element pattern&#x000D;&#x000A;SlantAngle = zeros(Nt,1); % LCS-&gt;GCS for antenna element pattern&#x000D;&#x000A;Ntrf = NumOfRFChains;&#x000D;&#x000A;% desired antenna spacing in x/y/z-axis direction in Tx&#x000D;&#x000A;Dx = 0.5; Dy = 0.5; Dz = 0.5;&#x000D;&#x000A;AntennaArrayMask = ones(Nt,Ntrf); % configure the connections between each RF chain and each antenna element in Tx&#x000D;&#x000A;&#x000D;&#x000A;% ------------------------------------- IMPAIRMENTS ANALYSIS -------------------------------------&#x000D;&#x000A;PA_Gain_Impairments = 0.01*0;                   % Impairments introduced by PA Gain&#x000D;&#x000A;PA_NoiseFigure_Impairments = 0.05*0;            % Impairments introduced by PA NoiseFigure&#x000D;&#x000A;PhaseShifterDistortion_Impairments = 0.03*0;    % Impairments introduced by PhaseShifterDistortion&#x000D;&#x000A;AntCoupleCoef_Impairments = 0.01*0;             % Impairments introduced by Coupling&#x000D;&#x000A;Dx_Impairments = 0.01*0;                        % Impairments introduced by antenna elements&apos; position in x-axis direction&#x000D;&#x000A;Dy_Impairments = 0.005*0;                       % Impairments introduced by antenna elements&apos; position in y-axis direction&#x000D;&#x000A;Dz_Impairments = 0.01*0;                        % Impairments introduced by antenna elements&apos; position in z-axis direction&#x000D;&#x000A;&#x000D;&#x000A;% ------------------------------------------------------------------------------------------------&#x000D;&#x000A;Dx_addnoise = Dx + sqrt(Dx_Impairments)*randn(1,1);&#x000D;&#x000A;Dy_addnoise = Dy + sqrt(Dy_Impairments)*randn(1,1);&#x000D;&#x000A;Dz_addnoise = Dz + sqrt(Dz_Impairments)*randn(1,1);&#x000D;&#x000A;PA_Gain = ones(Nt,1)+ sqrt(PA_Gain_Impairments)*randn(Nt,1);&#x000D;&#x000A;PA_NoiseFigure = zeros(Ntrf,1) + sqrt(PA_NoiseFigure_Impairments)*abs(randn(Ntrf,1));&#x000D;&#x000A;PhaseShifterDistortion = ones(Nt,Ntrf) + sqrt(PhaseShifterDistortion_Impairments)*(randn(Nt,Ntrf) + sqrt(-1)*randn(Nt,Ntrf))/sqrt(2); % antenna calibration error in Txs&#x000D;&#x000A;AntCoupleCoef = eye(Nt) + sqrt(AntCoupleCoef_Impairments)*(randn(Nt,Nt) + sqrt(-1)*randn(Nt,Nt))/sqrt(2); % antenna coupling matrix&#x000D;&#x000A;&#x000D;&#x000A;% ----------------------------------------------------------------------------------------------------&#x000D;&#x000A;%Derived theta and phi for EVM measuremnt which has best performance as the recevier beams are exactly pointed to transmit beams&#x000D;&#x000A;RxTheta = pi-Theta;&#x000D;&#x000A;RxPhi = mod(Phi+pi, 2*pi);&#x000D;&#x000A;&#x000D;&#x000A;% ------------------------------------ OFDM Source Configuration -------------------------------------&#x000D;&#x000A;OSR = 2^OversamplingRatio; % &#x000D;&#x000A;NumOfPreamble1Sym = 1; % number of OFDM symbols in Preamble 1 part&#x000D;&#x000A;NumOfDataSym = 16; % number of OFDM symbols in Data part&#x000D;&#x000A;Num_Subcarriers = 64; % number of total subcarriers&#x000D;&#x000A;GuardLowerSubcarriers =2;&#x000D;&#x000A;GuardUpperSubcarriers =1;&#x000D;&#x000A;NumOfDC_Subcarriers =1;&#x000D;&#x000A;NumOfStreams = NumOfRFChains; % number of streams is equal to RF chains for this release&#x000D;&#x000A;Ns = NumOfStreams;&#x000D;&#x000A;LenOfOFDMSym_woCP = Num_Subcarriers;&#x000D;&#x000A;LenOfCP = 0.25*Num_Subcarriers;&#x000D;&#x000A;LenOfOFDM = LenOfOFDMSym_woCP + LenOfCP;&#x000D;&#x000A;DataSymStartIndex = LenOfOFDM*NumOfPreamble1Sym*OSR*0;&#x000D;&#x000A;Preamble_NumOfCarriers = Num_Subcarriers - GuardLowerSubcarriers - GuardUpperSubcarriers;&#x000D;&#x000A;AvaliableNumOfCarriers = Num_Subcarriers - GuardLowerSubcarriers - GuardUpperSubcarriers- NumOfDC_Subcarriers;&#x000D;&#x000A;&#x000D;&#x000A;% ----------------------------------------- Pilot Generation for Data Part --------------------------------------&#x000D;&#x000A;Pilot_CarrierIndex =[(-Num_Subcarriers/2+GuardLowerSubcarriers):3:-1,1:3:Num_Subcarriers/2-1-GuardUpperSubcarriers];&#x000D;&#x000A;Pilot_NumOfCarriers = length(Pilot_CarrierIndex);&#x000D;&#x000A;rng(1);&#x000D;&#x000A;Pilot_Value_t = sign(randn(1,length(Pilot_CarrierIndex)));&#x000D;&#x000A;P_Matrix = hadamard(Ntrf);&#x000D;&#x000A;Pilots_Value_Block =zeros(Ntrf,length(Pilot_CarrierIndex)*NumOfDataSym);&#x000D;&#x000A;for i=1:Ntrf&#x000D;&#x000A;&#x0009;for k =1:NumOfDataSym/Ntrf&#x000D;&#x000A;&#x0009;&#x0009;for j=1:Ntrf&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;Pilots_Value_Block(i,(k-1)*length(Pilot_CarrierIndex)*Ntrf+(j-1)*length(Pilot_CarrierIndex)+1:(k-1)*length(Pilot_CarrierIndex)*Ntrf+j*length(Pilot_CarrierIndex)) = P_Matrix(i,j)*Pilot_Value_t;&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x0009;&#x0009;&#x000D;&#x000A;Pilots_Values1 = zeros(1,NumOfDataSym*length(Pilot_CarrierIndex)*Ntrf);&#x000D;&#x000A;Pilots_Values1 = reshape(Pilots_Value_Block.&apos;,1,NumOfDataSym*length(Pilot_CarrierIndex)*Ntrf);&#x000D;&#x000A;Pilot1_Seq = Pilots_Values1;&#x000D;&#x000A;% ----------------------------------------- Frequency Allocation for Data Part ------------------------------------&#x000D;&#x000A;Data_NumOfCarriers = Num_Subcarriers - GuardLowerSubcarriers - GuardUpperSubcarriers- NumOfDC_Subcarriers - Pilot_NumOfCarriers;&#x000D;&#x000A;AvaliableNumOfCarriers = Num_Subcarriers - GuardLowerSubcarriers - GuardUpperSubcarriers- NumOfDC_Subcarriers;&#x000D;&#x000A;Data_CarrierIndex_t = [(-Num_Subcarriers/2+GuardLowerSubcarriers+1):3:-1,2:3:Num_Subcarriers/2-1-GuardUpperSubcarriers,(-Num_Subcarriers/2+GuardLowerSubcarriers+2):3:-1,3:3:Num_Subcarriers/2-1-GuardUpperSubcarriers];&#x000D;&#x000A;Data_CarrierIndex = sort(Data_CarrierIndex_t);&#x000D;&#x000A;EVM_NumOfCarriers = Num_Subcarriers - GuardLowerSubcarriers - GuardUpperSubcarriers- NumOfDC_Subcarriers;&#x000D;&#x000A;EVM_CarrierIndex = [(-Num_Subcarriers/2+GuardLowerSubcarriers):-1,1:Num_Subcarriers/2-1-GuardUpperSubcarriers];&#x000D;&#x000A;% ------------------------------- FlexOFDM Source Modulation Configuration ----------------------------&#x000D;&#x000A;Data1_MappingType = 1; %for QPSK&#x000D;&#x000A;MappingTable = [1,2,4,6,8,0,3,5,7,9,10,11,12]; % number of bit per each symbol&#x000D;&#x000A;BitsPerSym = MappingTable(Data1_MappingType+1); % number of bits per symbol&#x000D;&#x000A;BitsPerFrame = BitsPerSym; % number of bits per frame&#x000D;&#x000A;BitRate = fs/OSR*BitsPerSym*NumOfStreams; % bit rate&#x000D;&#x000A;SymRate = BitRate/(BitsPerSym*NumOfStreams); % symbol rate&#x000D;&#x000A;BitsPerSampleTime = BitsPerSym * NumOfStreams; % bits number per sample time&#x000D;&#x000A;% -------------------- Generation of Frequency Signal for Preamble 1  ----------------------------------&#x000D;&#x000A;rng(2);&#x000D;&#x000A;Preamble1_Seq = (randn(1,Num_Subcarriers)+ 1i*randn(1,Num_Subcarriers))/sqrt(2);&#x000D;&#x000A;Preamble1_Seq = repmat(Preamble1_Seq,1,Ntrf); &#x000D;&#x000A;Preamble_CarrierIndex=[-Num_Subcarriers/2:Num_Subcarriers/2-1];&#x000D;&#x000A;rng(3);&#x000D;&#x000A;FreRefSig = (1-2*(randn(LenOfOFDMSym_woCP,1)&gt;0))+sqrt(-1)*(1-2*(randn(LenOfOFDMSym_woCP,1)&gt;0));&#x000D;&#x000A;FreRefSig_trans = FreRefSig.&apos;;&#x000D;&#x000A;&#x000D;&#x000A;%Set NDensity_dBm &#x000D;&#x000A;NDensity_dBm = Power_dBm - SNR - 10*log10(BaseSampleRate*AvaliableNumOfCarriers/Num_Subcarriers); % noise density&#x000D;&#x000A;%Note: as there is no fading channel for EVM measurement, no need to consider Ntrf for cross-channel gain in fading channel for SNR calculation.&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;</Text>
