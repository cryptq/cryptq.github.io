<Data><T>Double</T><D>8</D></Data></Item>
<Item XName="Data_CarrierIndex" Type="Variable">
<Data><T>Array_Dbl64</T><D>2;48;1;w0C;v0C;u0C;t0C;s0C;q0C;p0C;o0C;n0C;m0C;k0C;i0C;g0C;e0C;c0C;a0C;Y0C;W0C;O0C;K0C;G0C;80C;C;m}B;m}3;4;804;G04;K04;O04;W04;Y04;a04;c04;e04;g04;i04;k04;m04;n04;o04;p04;q04;s04;t04;u04;v04;w04</D></Data></Item>
