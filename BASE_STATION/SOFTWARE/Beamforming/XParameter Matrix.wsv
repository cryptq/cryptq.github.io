<Item XName="Eqns" Type="Equation">
<Text>% --------------------------------------------------------------------------&#x000D;&#x000A;% Spectrum Type (SpecType):&#x000D;&#x000A;%&#x0009;&#x0009;1 - Voltage Magnitude Spectrum (default = dBV)&#x000D;&#x000A;%&#x0009;&#x0009;2 - Voltage Magnitude-Squared Spectrum&#x000D;&#x000A;%&#x0009;&#x0009;3 - Voltage Angle Spectrum (default = degrees)&#x000D;&#x000A;%&#x0009;&#x0009;4 - Power Spectrum (default = dBm)&#x000D;&#x000A;%&#x000D;&#x000A;% Single Sided Spectrum (SingleSidedSpectrum):&#x000D;&#x000A;%&#x0009;&#x0009;true&#x0009;- Single-sided spectrum display (positive frequencies only)&#x000D;&#x000A;%&#x0009;&#x0009;false&#x0009;- Double-sided spectrum display (positive and negative frequencies)&#x000D;&#x000A;%&#x0009;&#x0009;NOTE: Single Sided Spectrum is ONLY relevant to real time domain signals (time &#x000D;&#x000A;%&#x0009;&#x0009;      domain signals are signals whose samples are collected vs time; see Time &#x000D;&#x000A;%&#x0009;&#x0009;      option for Data Collection in Sink part). For complex or untimed signals &#x000D;&#x000A;%&#x0009;&#x0009;      (untimed signals are signals whose samples are collected vs index; see Samples&#x000D;&#x000A;%&#x0009;&#x0009;      option for Data Collection in Sink part) it is ALWAYS assumed to be false.&#x000D;&#x000A;%&#x000D;&#x000A;% FFT Scaling Mode (FFTScalingMode):&#x000D;&#x000A;%&#x0009;&#x0009;1 - Divide by FFT length&#x000D;&#x000A;%&#x0009;&#x0009;    (gives results identical to SpectrumAnalyzer part)&#x000D;&#x000A;%&#x0009;&#x0009;2 - Scale by time step; useful when viewing the frequency response of filters&#x000D;&#x000A;%&#x0009;&#x0009;    (gives results identical to SystemVue 2007 when &apos;Scale FFT amplitude by dT (time step)&apos; is enabled&#x000D;&#x000A;%&#x0009;&#x0009;3 - Do not apply the FFT length or time step scale factors&#x000D;&#x000A;%&#x0009;&#x0009;    (gives results identical to SystemVue 2007 when &apos;Scale FFT amplitude by dT (time step)&apos; is not enabled&#x000D;&#x000A;%&#x0009;&#x0009;NOTE: FFT Scaling Mode is IGNORED for Power Spectrum and has no effect on Voltage Angle Spectrum&#x000D;&#x000A;% --------------------------------------------------------------------------&#x000D;&#x000A;&#x000D;&#x000A;% --------------------------------------------------------------------------&#x000D;&#x000A;% ENTER DESIRED GRAPH CHARACTERISTICS HERE&#x000D;&#x000A;SpecType = 4;&#x000D;&#x000A;FFTScalingMode = 1;&#x000D;&#x000A;SingleSidedSpectrum = true;&#x000D;&#x000A;&#x000D;&#x000A;RefR = 50;&#x0009;&#x0009;&#x0009;&#x0009;% reference resistance (used for Power Spectrum ONLY)&#x000D;&#x000A;% END CHANGES&#x000D;&#x000A;% --------------------------------------------------------------------------&#x000D;&#x000A;&#x000D;&#x000A;% Reset variables to their defaults if they are out of bounds&#x000D;&#x000A;&#x000D;&#x000A;if ( SpecType &lt; 1 || SpecType &gt; 4 )&#x000D;&#x000A;&#x0009;SpecType = 4;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if ( SingleSidedSpectrum ~= true &amp;&amp; SingleSidedSpectrum ~= false )&#x000D;&#x000A;&#x0009;SingleSidedSpectrum = true;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if ( FFTScalingMode &lt; 1 || FFTScalingMode &gt; 3 )&#x000D;&#x000A;&#x0009;FFTScalingMode = 1&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if ( RefR &lt;= 0 )&#x000D;&#x000A;&#x0009;RefR = 50;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;% FFScalingMode should always be 1 for Power Spectrum&#x000D;&#x000A;&#x000D;&#x000A;if ( SpecType == 4 )&#x000D;&#x000A;&#x0009;FFTScalingMode = 1;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;WaveOut = getvariable(&apos;DF3_Dataflow_LUTcorrect_Data&apos;, &apos;WaveOut&apos;);&#x000D;&#x000A;if length( findstr( getindep( WaveOut ), &apos;|&apos; ) )&#x000D;&#x000A;&#x0009;error( &apos;Swept data is not supported by Spectrum plots.&apos; );&#x000D;&#x000A;&#x0009;return;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;% For complex signal SingleSidedSpectrum should always be false&#x000D;&#x000A;&#x000D;&#x000A;if ( ~isreal( WaveOut ) &amp;&amp; SingleSidedSpectrum )&#x000D;&#x000A;&#x0009;SingleSidedSpectrum = false;&#x000D;&#x000A;&#x0009;warning( &apos;Double Sided Spectrum will be shown since input data is complex.&apos; );&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;nPoints = numel( WaveOut );&#x0009;&#x0009;&#x0009;% number of elements&#x000D;&#x000A;FFT_len = nPoints;&#x000D;&#x000A;IndepVar = getindepvalue( WaveOut );&#x0009;% get the independent variable&#x000D;&#x000A;&#x000D;&#x000A;delta_t = 1;&#x0009;&#x0009;&#x0009;% Default if indep has less than 2 points&#x000D;&#x000A;delta_f = 1;&#x0009;&#x0009;&#x0009;% Default if indep has less than 2 points&#x000D;&#x000A;&#x000D;&#x000A;if numel( IndepVar ) &gt; 1&#x000D;&#x000A;&#x0009;delta_t = IndepVar(2) - IndepVar(1);&#x000D;&#x000A;&#x0009;delta_f = 1 / ( nPoints * delta_t );&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if ( isequal( getdisplayunit( IndepVar ), &apos;&apos; ) )&#x000D;&#x000A;&#x0009;NumericData = true;&#x000D;&#x000A;&#x0009;if ( SingleSidedSpectrum )&#x000D;&#x000A;&#x0009;&#x0009;SingleSidedSpectrum = false;&#x000D;&#x000A;&#x0009;&#x0009;warning( &apos;Double Sided Spectrum will be shown since input data is numeric.&apos; );&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;NumericData = false;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;Index = (1:FFT_len) - floor( FFT_len / 2 ) - 1;&#x0009;&#x0009;% build spectrum independent vector&#x000D;&#x000A;&#x000D;&#x000A;if ( ~NumericData )&#x000D;&#x000A;&#x0009;Freq = Index * delta_f;&#x0009;&#x0009;% build spectrum independent vector for timed data&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;Spec = fft( WaveOut, FFT_len );&#x0009;&#x0009;&#x0009;% complex FFT&#x000D;&#x000A;Spec = fftshift( Spec );&#x0009;&#x0009;&#x0009;% center DC&#x000D;&#x000A;&#x000D;&#x000A;if ( FFTScalingMode == 1 )&#x000D;&#x000A;&#x0009;Spec = Spec / FFT_len;&#x000D;&#x000A;elseif ( FFTScalingMode == 2 )&#x000D;&#x000A;&#x0009;Spec = Spec * delta_t;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if ( SingleSidedSpectrum )&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;posrange = floor( FFT_len / 2 ) + 1:FFT_len;&#x000D;&#x000A;&#x0009;Freq = Freq( posrange );&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;if ( FFTScalingMode == 1 )&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;&#x0009;% Add conjugate of negative freq spectrum to positive&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;&#x0009;if ( mod( FFT_len, 2 ) == 0 )&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;Spec( posrange(2:end) ) = Spec( posrange(2:end) ) + conj( Spec( FFT_len - posrange(1:end-1) + 1 ) );&#x000D;&#x000A;&#x0009;&#x0009;else&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;Spec( posrange(2:end) ) = Spec( posrange(2:end) ) + conj( Spec( FFT_len - posrange(2:end) + 1 ) );&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;Spec = Spec( posrange );&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;% Perform carrier frequency adjustment if needed&#x000D;&#x000A;&#x000D;&#x000A;if ( ( hasvariable(&apos;DF3_Dataflow_LUTcorrect_Data&apos;,&apos;WaveOut_Fc&apos;) == 1 ) &amp;&amp; ~NumericData )&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;Fc = getvariable(&apos;DF3_Dataflow_LUTcorrect_Data&apos;,&apos;WaveOut_Fc&apos;);&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;if ( Fc &gt; 0 )&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;&#x0009;Freq = Freq + Fc;&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;&#x0009;% For power spectrum of complex envelope signals power needs to be &#x000D;&#x000A;&#x0009;&#x0009;% scaled by 0.5 (so divide voltage spectrum by sqrt(2.0)) to take &#x000D;&#x000A;&#x0009;&#x0009;% into account the mean power of the carrier (which is 0.5)&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;&#x0009;if ( SpecType == 4 )&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;Spec = Spec / sqrt(2);&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;&#x0009;% Apply folding if needed &#x000D;&#x000A;&#x000D;&#x000A;&#x0009;&#x0009;if ( ( Freq(1) &lt; 0 ) &amp;&amp; ( abs( Freq(1) ) &lt; ( Freq(2) - Freq(1) ) / 1.0e6 ) )&#x0009;% if we are negative but practically 0&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;Freq(1) = 0.0;&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;&#x0009;if ( Freq(1) &lt; 0 )&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;iFirstNegIndex = length( find( Freq &lt; 0 ) );&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;iFirstPosIndex = iFirstNegIndex + 1;&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;% if first negative freq is less than first positive freq (after negative freq &#x000D;&#x000A;&#x0009;&#x0009;&#x0009;% is folded) fold first negative frequency on top of first positive frequency&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;if ( Freq(iFirstPosIndex) &gt; -Freq(iFirstNegIndex) )&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;Spec(iFirstPosIndex) = Spec(iFirstPosIndex) + conj( Spec(iFirstNegIndex) );&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;iFirstNegIndex = iFirstNegIndex - 1;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;if ( iFirstNegIndex &gt; 0 )&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;% At this point we are guaranteed that Freq(iFirstPosIndex) &lt; -Freq(iFirstNegIndex) &lt; Freq(iFirstPosIndex+1)&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;FreqDiff1__ = -Freq(iFirstNegIndex) - Freq(iFirstPosIndex);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;FreqDiff2__ = Freq(iFirstPosIndex+1) + Freq(iFirstNegIndex);&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;if ( FreqDiff1__ &lt; FreqDiff2__ )&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;iFoldingIndex = iFirstPosIndex;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;else&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;iFoldingIndex = iFirstPosIndex+1;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;% Now apply folding&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;Spec( iFoldingIndex : iFoldingIndex+iFirstNegIndex-1 ) = Spec( iFoldingIndex : iFoldingIndex+iFirstNegIndex-1 ) + conj( Spec( iFirstNegIndex : -1 :1 ) );&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;Freq = Freq(iFirstPosIndex:end);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;Spec = Spec(iFirstPosIndex:end);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;Spec = Spec.&apos;;&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;% Use a floor for very small values&#x000D;&#x000A;&#x000D;&#x000A;iIndex = ( abs( Spec ) &lt;= 1e-20 );&#x000D;&#x000A;Spec( iIndex ) = 1e-20;&#x000D;&#x000A;&#x000D;&#x000A;if ( SpecType == 1 )&#x0009;&#x0009;% Voltage Magnitude Spectrum&#x000D;&#x000A;&#x0009;setdisplayunit( &apos;Spec&apos;, &apos;dBV&apos; );&#x000D;&#x000A;elseif ( SpecType == 2 )&#x0009;% Voltage Magnitude-Squared Spectrum&#x000D;&#x000A;&#x0009;Spec = Spec .* conj( Spec );&#x0009;&#x0009;% magnitude-squared&#x000D;&#x000A;elseif ( SpecType == 3 )&#x0009;% Voltage Angle Spectrum&#x000D;&#x000A;&#x0009;Spec = angle( Spec );&#x000D;&#x000A;&#x0009;setdisplayunit( &apos;Spec&apos;, &apos;deg&apos; );&#x000D;&#x000A;else&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;% Power Spectrum&#x000D;&#x000A;&#x0009;if ( SingleSidedSpectrum )&#x000D;&#x000A;&#x0009;&#x0009;Spec = Spec .* conj( Spec ) / ( 2 * RefR );&#x000D;&#x000A;&#x0009;&#x0009;Spec(1) = Spec(1) * 2;&#x0009;&#x0009;&#x0009;% DC&#x000D;&#x000A;&#x0009;else&#x000D;&#x000A;&#x0009;&#x0009;Spec = Spec .* conj( Spec ) / RefR;&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x0009;setdisplayunit( &apos;Spec&apos;, &apos;dBm&apos; );&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if ( NumericData )&#x000D;&#x000A;&#x0009;setindep( &apos;Spec&apos;, &apos;Index&apos; );&#x0009;&#x0009;% Set the independent variable&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;setdisplayunit( &apos;Freq&apos;, &apos;kHz&apos; );&#x0009;&#x0009;&#x0009;% Set units to kHz (Hz, kHz, MHz, GHz)&#x000D;&#x000A;&#x0009;setindep( &apos;Spec&apos;, &apos;Freq&apos; );&#x0009;&#x0009;&#x0009;% Set the independent variable&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;</Text>
