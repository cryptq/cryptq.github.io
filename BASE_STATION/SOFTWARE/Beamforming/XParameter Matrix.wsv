<Item XName="OutEquations" UserName="OutEquations" Type="Equation">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>% find the integrated channel power at input/output nodes&#x000D;&#x000A;using( &apos;System1_Data_Path1_PowerSweep&apos; );&#x000D;&#x000A;PowerOut= extractsweptdata( DCP, NodeNames, &apos;2&apos; );&#x000D;&#x000A;PowerIn = extractsweptdata( DCP, NodeNames, &apos;1&apos; );&#x000D;&#x000A;% &#x000D;&#x000A;% calculate the Gain &amp; GComp in dB and prep for plotting&#x000D;&#x000A;PowerGain = 10*log10(abs(PowerOut./PowerIn));&#x000D;&#x000A;GainComp = PowerGain(1)-PowerGain;&#x000D;&#x000A;setindep( &apos;PowerOut&apos;, &apos;VarEqn_RFSystem_power_Swp&apos; );&#x000D;&#x000A;setindep( &apos;PowerGain&apos;, &apos;VarEqn_RFSystem_power_Swp&apos; );&#x000D;&#x000A;setindep( &apos;GainComp&apos;, &apos;VarEqn_RFSystem_power_Swp&apos; );&#x000D;&#x000A;</Text>
<UnitUse><T>Int</T><D>2</D></UnitUse>
