<Item XName="PlotTimeDelayPattern" UserName="PlotTimeDelayPattern" Type="Equation">
<AutoCalc><T>Bool</T><D>0</D></AutoCalc>
<Selected><T>Bool</T><D>1</D></Selected>
<Text>using(&apos;DF2_Design2_Data&apos;);&#x000D;&#x000A;&#x000D;&#x000A;td_gain_fc = reshape(td_pattern_fc,phiSize,thetaSize);&#x000D;&#x000A;td_gain_fc = abs(td_gain_fc).^2*numAnts; %we just want to sum up the signal and compute power gain so *numAnts is to compensate combiner insertion loss&#x000D;&#x000A;td_gain_fc = max(10*log10(td_gain_fc),-30);&#x000D;&#x000A;td_graph_fc = graph_figure(&apos;TimeDelay_fc&apos;);&#x000D;&#x000A;td_graph_fc.add_spherical_data(PHI, THETA, td_gain_fc);&#x000D;&#x000A;&#x000D;&#x000A;td_gain_fmin = reshape(td_pattern_fmin,phiSize,thetaSize);&#x000D;&#x000A;td_gain_fmin = abs(td_gain_fmin).^2*numAnts; %we just want to sum up the signal and compute power gain so *numAnts is to compensate combiner insertion loss&#x000D;&#x000A;td_gain_fmin = max(10*log10(td_gain_fmin),-30);&#x000D;&#x000A;td_graph_fmin = graph_figure(&apos;TimeDelay_fmin&apos;);&#x000D;&#x000A;td_graph_fmin.add_spherical_data(PHI, THETA, td_gain_fmin);&#x000D;&#x000A;&#x000D;&#x000A;td_gain_fmax = reshape(td_pattern_fmax,phiSize,thetaSize);&#x000D;&#x000A;td_gain_fmax = abs(td_gain_fmax).^2*numAnts; %we just want to sum up the signal and compute power gain so *numAnts is to compensate combiner insertion loss&#x000D;&#x000A;td_gain_fmax = max(10*log10(td_gain_fmax),-30);&#x000D;&#x000A;td_graph_fmax = graph_figure(&apos;TimeDelay_fmax&apos;);&#x000D;&#x000A;td_graph_fmax.add_spherical_data(PHI, THETA, td_gain_fmax);</Text>
