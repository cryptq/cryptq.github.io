<Item XName="Equation1" UserName="Equation1" Type="Equation">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>Sample_Rate = 20e9;&#x000D;&#x000A;fc = 10e9;&#x000D;&#x000A;f_min = 8e9;&#x000D;&#x000A;f_max = 12e9;&#x000D;&#x000A;C = 299792458; % speef of light&#x000D;&#x000A;D = C / fc / 2; % distance between elements is 0.5 wavelength @ fc = 10e9&#x000D;&#x000A;numX = 4;&#x000D;&#x000A;numY = 4;&#x000D;&#x000A;numAnts = numX * numY;&#x000D;&#x000A;&#x000D;&#x000A;maxPhaseDiff = numX*0.5*2*pi + numY*0.5*2*pi;&#x000D;&#x000A;maxTimeDelay = maxPhaseDiff / (2*pi*fc);&#x000D;&#x000A;maxSampleDelay = ceil(maxTimeDelay / (1/Sample_Rate))+2;&#x000D;&#x000A;&#x000D;&#x000A;theta = [0 : pi/90 : pi/2];&#x000D;&#x000A;phi = [0 : pi/90 : 2*pi];&#x000D;&#x000A;[THETA,PHI]=meshgrid(theta,phi);&#x000D;&#x000A;thetaSize = numel(theta);&#x000D;&#x000A;phiSize = numel(phi);&#x000D;&#x000A;gridSize = numel( THETA );&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;beamTheta = 20;&#x000D;&#x000A;beamPhi = 0;</Text>
