<Item XName="PlotPhaseShiftPattern" UserName="PlotPhaseShiftPattern" Type="Equation">
<AutoCalc><T>Bool</T><D>0</D></AutoCalc>
<Selected><T>Bool</T><D>0</D></Selected>
<Text>using(&apos;DF1_Design1_Data&apos;);&#x000D;&#x000A;&#x000D;&#x000A;gain_fc = reshape(pattern_fc,phiSize,thetaSize);&#x000D;&#x000A;gain_fc = abs(gain_fc).^2*numAnts; %we just want to sum up the signal and compute power gain so *numAnts is to compensate combiner insertion loss&#x000D;&#x000A;gain_fc = max(10*log10(gain_fc),-30);&#x000D;&#x000A;graph_fc = graph_figure(&apos;PhaseShift_fc&apos;);&#x000D;&#x000A;graph_fc.add_spherical_data(PHI, THETA, gain_fc);&#x000D;&#x000A;&#x000D;&#x000A;gain_fmin = reshape(pattern_fmin,phiSize,thetaSize);&#x000D;&#x000A;gain_fmin = abs(gain_fmin).^2*numAnts; %we just want to sum up the signal and compute power gain so *numAnts is to compensate combiner insertion loss&#x000D;&#x000A;gain_fmin = max(10*log10(gain_fmin),-30);&#x000D;&#x000A;graph_fmin = graph_figure(&apos;PhaseShift_fmin&apos;);&#x000D;&#x000A;graph_fmin.add_spherical_data(PHI, THETA, gain_fmin);&#x000D;&#x000A;&#x000D;&#x000A;gain_fmax = reshape(pattern_fmax,phiSize,thetaSize);&#x000D;&#x000A;gain_fmax = abs(gain_fmax).^2*numAnts; %we just want to sum up the signal and compute power gain so *numAnts is to compensate combiner insertion loss&#x000D;&#x000A;gain_fmax = max(10*log10(gain_fmax),-30);&#x000D;&#x000A;graph_fmax = graph_figure(&apos;PhaseShift_fmax&apos;);&#x000D;&#x000A;graph_fmax.add_spherical_data(PHI, THETA, gain_fmax);</Text>
