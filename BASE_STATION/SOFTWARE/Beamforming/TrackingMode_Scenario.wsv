<Item XName="1_Top_Level_Equations" UserName="1_Top_Level_Equations" Type="Equation">
<AutoCalc><T>Bool</T><D>1</D></AutoCalc>
<Selected><T>Bool</T><D>0</D></Selected>
<Text>%--------------------------------&#x000D;&#x000A;% Sytem Architectural parameters&#x000D;&#x000A;%--------------------------------&#x000D;&#x000A;C=3e8   &#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;% velocity of light&#x000D;&#x000A;Fcarrier = 2e9   &#x0009;&#x0009;&#x0009;&#x0009;% carrier frequency&#x000D;&#x000A;PRI = 200e-6;                  &#x000D;&#x000A;fs = 4e6;   &#x0009;&#x0009;&#x0009;&#x0009;&#x0009;% sampling frequency&#x000D;&#x000A;PulseWidth=10e-6&#x000D;&#x000A;CPI_Num = 32; &#x0009;&#x0009;&#x0009;&#x0009;&#x0009;% Number of samples in one CPI(coherent processing interval), this is also the FFT Size&#x000D;&#x000A;Pf =1e-6      &#x0009;&#x0009;&#x0009;&#x0009;&#x0009;% Probability of false alarm&#x000D;&#x000A;&#x000D;&#x000A;%----------------------------------&#x000D;&#x000A;% System level derived parameters&#x000D;&#x000A;%----------------------------------&#x000D;&#x000A;PRF = 1 / PRI;&#x000D;&#x000A;BandWidth=fs/2;&#x000D;&#x000A;PRI_Sample_Num = PRI * fs; &#x0009;&#x0009;  % Number of samples in a PRI&#x0009;&#x0009;&#x0009;&#x0009;  &#x000D;&#x000A;range_max=C*PRI/2&#x0009;&#x0009;&#x0009;&#x0009;  % maximum unambiguous range &#x000D;&#x000A;fd_max=1/PRI/2;&#x0009;                  % maximum unambiguous Doppler frequency&#x000D;&#x000A;velocity_max=C*fd_max/2/Fcarrier  % maximum unambiguous velocity M/sec.   1M/s = 3.6 KM/hour&#x000D;&#x000A;wavelength = C/Fcarrier;&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;%------------------------------------------&#x000D;&#x000A;% Parameters to create variaous conditions&#x000D;&#x000A;%------------------------------------------&#x000D;&#x000A;SignalClutterRatio=tune(17);  &#x0009;&#x0009;&#x0009;% signal-to-clutter ratio (dB). Controlled by slider.&#x000D;&#x000A;SCR = SignalClutterRatio;&#x000D;&#x000A;PlatformVt=tune(0);&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;% Radar platform speed in the direction of North&#x000D;&#x000A;VT = PlatformVt;&#x000D;&#x000A;TargetVt=tune(117);&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;% Target speed in the direction towards North&#x000D;&#x000A;SNR = 0;  &#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;% signal-to-noise ratio (in dB), decides the jammer level&#x000D;&#x000A;rcs_index=tune(59)&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;% index to sweep rcs values read from the file.&#x000D;&#x000A;NoiseDensity=tune(-170)&#x0009;&#x0009;&#x0009;&#x0009;% Noise Density in dBm/Hz&#x000D;&#x000A;PhN=tune(-6)  &#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;% phase noise decrement from a base of [-50 -60 -70 -80]</Text>
<UnitUse><T>Int</T><D>2</D></UnitUse>
