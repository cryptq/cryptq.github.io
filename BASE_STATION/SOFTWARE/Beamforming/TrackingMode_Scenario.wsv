<Item XName="Scenario_Simulation" UserName="Scenario_Simulation" Type="Equation">
<AutoCalc><T>Bool</T><D>0</D></AutoCalc>
<Selected><T>Bool</T><D>0</D></Selected>
<Text>ph1=-74.660450; % longitude&#x000D;&#x000A;th1=40.397389;  % lattitude&#x000D;&#x000A;r1=0;&#x000D;&#x000A;RadarPosition = [ph1 th1 r1]&apos;;&#x000D;&#x000A;&#x000D;&#x000A;filepath=getworkspacedir;&#x000D;&#x000A;filepath=[filepath &apos;\Trajectory_positions_princeton.txt&apos;];&#x000D;&#x000A;&#x000D;&#x000A;fid = fopen(filepath);&#x000D;&#x000A;Target_File = fscanf(fid, &apos;%f&apos;,[3 inf]);&#x000D;&#x000A;Target_File=Target_File&apos;;&#x000D;&#x000A;fclose(fid);&#x000D;&#x000A;&#x000D;&#x000A;lati = Target_File(:,1);&#x000D;&#x000A;longi  = Target_File(:,2);&#x000D;&#x000A;alti  = Target_File(:,3);&#x000D;&#x000A;&#x000D;&#x000A;for i=1:12&#x000D;&#x000A;&#x0009;plane_position = i;&#x000D;&#x000A;&#x0009;TargetPosition = [longi(i) lati(i) alti(i)];      % LLA&#x000D;&#x000A;&#x0009;Set_range(i)=distanceLLA(RadarPosition(2),RadarPosition(1),RadarPosition(3),lati(i),longi(i),alti(i));&#x000D;&#x000A;&#x0009;runanalysis(&apos;Analysis1&apos;)&#x000D;&#x000A;&#x0009;setvariable(&apos;DataSet1&apos;,&apos;Set_range&apos;,Set_range(i));&#x000D;&#x000A;&#x0009;&#x000D;&#x000A;&#x0009;%plotting the Tx antenna beam pattern&#x000D;&#x000A;&#x0009;MyTxMag = reshape(getvariable(&apos;DataSet1&apos;,&apos;txmag&apos;),361,181);&#x000D;&#x000A;&#x0009;MyTxMag( find( MyTxMag &lt; -30 ) ) = -30;&#x000D;&#x000A;&#x0009;MyTxAz = reshape(getvariable(&apos;DataSet1&apos;,&apos;txazimuth&apos;),361,181);&#x000D;&#x000A;&#x0009;MyTxZe = reshape(getvariable(&apos;DataSet1&apos;,&apos;txzenith&apos;),361,181);&#x000D;&#x000A;&#x0009;graph=graph_figure(&apos;Tx Antenna Beam&apos;);&#x000D;&#x000A;&#x0009;graph.add_spherical_data(MyTxAz, MyTxZe, MyTxMag);&#x000D;&#x000A;&#x0009;&#x000D;&#x000A;&#x0009;%plotting the Rx antenna beam pattern&#x000D;&#x000A;&#x0009;MyRxMag1 = reshape(getvariable(&apos;DataSet1&apos;,&apos;rxmag&apos;),361,181);&#x000D;&#x000A;&#x0009;MyRxMag1( find( MyRxMag1 &lt; -30 ) ) = -30;&#x000D;&#x000A;&#x0009;MyRxAz1 = reshape(getvariable(&apos;DataSet1&apos;,&apos;rxazimuth&apos;),361,181);&#x000D;&#x000A;&#x0009;MyRxZe1 = reshape(getvariable(&apos;DataSet1&apos;,&apos;rxzenith&apos;),361,181);&#x000D;&#x000A;&#x0009;graph=graph_figure(&apos;Rx Antenna Beam&apos;);&#x000D;&#x000A;&#x0009;graph.add_spherical_data(MyRxAz1, MyRxZe1, MyRxMag1);&#x000D;&#x000A;&#x0009;&#x000D;&#x000A;&#x0009;&#x000D;&#x000A;&#x0009;%Post processing the CFAR data to plot&#x000D;&#x000A;&#x0009;using(&apos;DataSet1&apos;);&#x000D;&#x000A;&#x0009;rd_mtx = reshape( CFAR_Out, PRI_Sample_Num, CPI_Num );&#x000D;&#x000A;&#x0009;r_axis = [0:PRI_Sample_Num-1]/PRI_Sample_Num*range_max;&#x000D;&#x000A;&#x0009;v_axis = [[0:CPI_Num/2-1],[-CPI_Num/2:-1]] / (CPI_Num/2)*fd_max * C / 2 / Fcarrier;&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;[r, d] = find( rd_mtx == max(max(rd_mtx)) );&#x000D;&#x000A;&#x0009;%convert from matlab 1-start-index to 0-start-index&#x000D;&#x000A;&#x0009;r = r-1;&#x000D;&#x000A;&#x0009;d = d-1;&#x000D;&#x000A;&#x0009;range = r / PRI_Sample_Num * range_max;&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;%assume FFT_Size (CPI_Num) is an even number&#x000D;&#x000A;&#x0009;if d &gt;= CPI_Num/2&#x000D;&#x000A;&#x0009;&#x0009;d = -(CPI_Num - d);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x0009;fd = d / (CPI_Num/2) * fd_max;&#x000D;&#x000A;&#x0009;if fd &gt; 1 / (2*PRI)&#x000D;&#x000A;&#x0009;velocity = C * fd / 2 /Fcarrier - c / 2 / PRI /Fcarrier;&#x000D;&#x000A;&#x0009;else&#x000D;&#x000A;&#x0009;velocity = C * fd / 2 /Fcarrier;&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x0009;setvariable(&apos;DataSet1&apos;,&apos;Computed_range&apos;,range);&#x000D;&#x000A;&#x0009;&#x000D;&#x000A;&#x0009;%Plotting the Range Doppler plot&#x000D;&#x000A;&#x0009;graph = graph_figure(&apos;Range Doppler plot&apos;);&#x000D;&#x000A;&#x0009;graph.add_surface_data(v_axis, r_axis, rd_mtx);&#x000D;&#x000A;&#x0009;graph.set_label_x(&apos;Velocity (m/s)&apos;);&#x000D;&#x000A;&#x0009;graph.set_label_y(&apos;Range (m)&apos;);&#x000D;&#x000A;&#x0009;graph.set_label_z(&apos;Amplitude&apos;);&#x000D;&#x000A;end</Text>
<UnitUse><T>Int</T><D>2</D></UnitUse>
