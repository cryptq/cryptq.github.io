<Item XName="distanceLLA" UserName="distanceLLA" Type="function">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>function distance = distanceLLA(th1,ph1,r1,th2,ph2,r2)&#x000D;&#x000A;%th1=-74.64540481567;&#x000D;&#x000A;%ph1=40.64313558331;&#x000D;&#x000A;%th2=-74.521808624267;&#x000D;&#x000A;%ph2=40.64756405258;&#x000D;&#x000A;%r=0&#x000D;&#x000A;lla_coordinate1=[ph1 th1 r1]&#x000D;&#x000A;lla_coordinate2=[ph2 th2 r2]&#x000D;&#x000A;XYZ=lla2ecf(lla_coordinate1)&#x000D;&#x000A;x1=XYZ(1)&#x000D;&#x000A;y1=XYZ(2)&#x000D;&#x000A;z1=XYZ(3)&#x000D;&#x000A;XYZ=lla2ecf(lla_coordinate2)&#x000D;&#x000A;x2=XYZ(1)&#x000D;&#x000A;y2=XYZ(2)&#x000D;&#x000A;z2=XYZ(3)&#x000D;&#x000A;d=(x2-x1)^2+(y2-y1)^2+(z2-z1)^2&#x000D;&#x000A;distance=sqrt(d)&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;</Text>
<Item XName="BPMgr" Type="BPMgr">
<BPLines><T>Empty</T></BPLines>
