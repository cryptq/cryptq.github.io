<Item XName="Equations" Type="Equation">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>%% ---- VAR_Src&#x000D;&#x000A;PulseWidth=1e-6;&#x000D;&#x000A;BB_SamplingRate=2400e6;&#x000D;&#x000A;PRI=1e-5;&#x000D;&#x000A;f0=0;&#x000D;&#x000A;BandWidth=1000e6;&#x000D;&#x000A;&#x000D;&#x000A;%% ---- TX_VAR&#x000D;&#x000A;IF_Freq=1e9;&#x000D;&#x000A;RF_Freq=2.5e9;&#x000D;&#x000A;BB_UpSamplingRatio=1;&#x000D;&#x000A;IF_SamplingRate=BB_SamplingRate*BB_UpSamplingRatio;&#x000D;&#x000A;TStep=1/IF_SamplingRate;&#x000D;&#x000A;DAC_NBits=8;&#x000D;&#x000A;RF_Gain=50;&#x000D;&#x000A;IF_Gain=50;&#x000D;&#x000A;BB_SamplesPerPulse=PulseWidth*BB_SamplingRate;&#x000D;&#x000A;IF_SamplesPerPulse=PulseWidth*IF_SamplingRate;&#x000D;&#x000A;&#x000D;&#x000A;%% ---- Target_VAR&#x000D;&#x000A;Distance = 2e3;&#x000D;&#x000A;Vt = 100;&#x000D;&#x000A;RCS_Type=3;&#x000D;&#x000A;DurationTime=PRI;&#x000D;&#x000A;IncludeProp=1;&#x000D;&#x000A;&#x000D;&#x000A;%% ---- Clutter_VAR&#x000D;&#x000A;c = 3e8;&#x000D;&#x000A;WaveLen = c/RF_Freq;&#x000D;&#x000A;&#x000D;&#x000A;if floor(IncludeProp)&lt;1&#x000D;&#x000A;&#x0009;PropEffect = 1;&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;PropEffect = 8*pi*sqrt(pi)*(Distance^2)/WaveLen;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;Gain=RF_Gain*IF_Gain;&#x000D;&#x000A;P_Lin=Gain^2/2/50/(PropEffect^2);&#x000D;&#x000A;P_dBm=10*log10(P_Lin)+30;&#x000D;&#x000A;CSR=0;&#x000D;&#x000A;Pc_dBm=P_dBm+CSR;&#x000D;&#x000A;Pc_Lin=10^(Pc_dBm/10-3);&#x000D;&#x000A;Gain_Clutter=sqrt(Pc_Lin*2*50);</Text>
<UnitUse><T>Int</T><D>2</D></UnitUse>
