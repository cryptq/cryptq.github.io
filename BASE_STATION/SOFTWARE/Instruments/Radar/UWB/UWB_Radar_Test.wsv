<Item XName="Equations" Type="Equation">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>c = 3e8;&#x000D;&#x000A;WaveLen = c/RF_Freq;&#x000D;&#x000A;fd = 2*Vt/c;&#x000D;&#x000A;&#x000D;&#x000A;if RCS_Type&lt;1&#x000D;&#x000A;&#x0009;Type = 0;&#x000D;&#x000A;elseif RCS_Type&lt;3&#x000D;&#x000A;&#x0009;Type = 5;&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;Type = 8;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if RCS_Type&lt;1&#x000D;&#x000A;&#x0009;VA = RCS_VA;&#x000D;&#x000A;elseif RCS_Type&lt;3&#x000D;&#x000A;&#x0009;VA = RCS_VA*log(2);&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;VA = 2/RCS_VA;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if RCS_Type&lt;1&#x000D;&#x000A;&#x0009;VB = RCS_VB;&#x000D;&#x000A;elseif RCS_Type&lt;3&#x000D;&#x000A;&#x0009;VB = RCS_VB;&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;VB = 2;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if floor(IncludeProp)&lt;1&#x000D;&#x000A;&#x0009;PropEffect = 1;&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;PropEffect = 8*pi*sqrt(pi)*(Distance^2)/WaveLen;&#x000D;&#x000A;end&#x000D;&#x000A;</Text>
<UnitUse><T>Int</T><D>2</D></UnitUse>
