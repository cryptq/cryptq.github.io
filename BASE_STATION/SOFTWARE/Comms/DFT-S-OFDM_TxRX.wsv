<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>4</D></Validate></Item>
<Item XName="SlavePosition" Type="PartParam">
<DataEntry>1</DataEntry>
<Description>Current Slave&apos;s position (Range: 1 to 15)</Description>
