<Item XName="EquationText" Type="PartParam">
<DataEntry>for ii=1:1:SamplesPerOFDM/4&#x000D;&#x000A;    corr_v(ii)=input(ii+[0:2*SamplesPerOFDM-1])&apos; * Ref;&#x000D;&#x000A;end;&#x000D;&#x000A;&#x000D;&#x000A;index_tmp = find( abs(corr_v)==max(abs(corr_v)) );&#x000D;&#x000A;&#x000D;&#x000A;Index=index_tmp-1;&#x000D;&#x000A;&#x000D;&#x000A;corr_phase=input(index_tmp+[0:1*SamplesPerOFDM-1])&apos;*input(index_tmp+SamplesPerOFDM+[0:1*SamplesPerOFDM-1]);&#x000D;&#x000A;&#x000D;&#x000A;Phase=angle(corr_phase);&#x000D;&#x000A;&#x000D;&#x000A;Index = Index(:);&#x000D;&#x000A;Phase = Phase(:);&#x000D;&#x000A;corr_v = corr_v(:);</DataEntry>
<Description>Equation Text to Parse, edited in the equation set</Description>
<DocSymbol />
<IsSettable><T>Bool</T><D>0</D></IsSettable>
<Range />
<RunTimeTunable><T>Bool</T><D>0</D></RunTimeTunable>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>4</D></Validate></Item>
