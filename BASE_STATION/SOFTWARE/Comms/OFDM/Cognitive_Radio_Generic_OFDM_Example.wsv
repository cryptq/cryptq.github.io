<Text>MapTableQPSK=sqrt(1/2)*[-1-j,-1+j,1-j,1+j].&apos;;&#x000D;&#x000A;MapTable16QAM=sqrt(1/10)*[-3-3*j,-3-j,-3+3*j, -3+j, -1-3*j, -1-j, -1+3*j, -1+j, 3-3*j, 3-j, 3+3*j, 3+j, 1-3*j, 1-j, 1+3*j,1+j].&apos;;&#x000D;&#x000A;BitsPerSymSet = [2,4].&apos;;&#x000D;&#x000A;&#x000D;&#x000A;if ModulationRate==2&#x000D;&#x000A;&#x0009;MapTable = MapTableQPSK;&#x000D;&#x000A;&#x0009;BitsPerSym = 2;&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;MapTable = MapTable16QAM;&#x000D;&#x000A;&#x0009;BitsPerSym = 4;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;% roll-off factor 0.5, oversampling ratio is 16&#x000D;&#x000A;OSR = 16;&#x000D;&#x000A;RRC_OSR16 = [-6.30865829617757E-04,-6.15227248557509E-04,-5.42576017148793E-04,-4.14776599310719E-04,-2.38581643380679E-04,-2.53836114844986E-05,2.09443222572838E-04,4.47582264512090E-04,6.69134259212390E-04,8.54205561382071E-04,9.84608750059596E-04,1.04554242622093E-03,1.02710975518629E-03,9.25538798807465E-04,7.43982294787195E-04,4.92799805490162E-04,1.89259748885327E-04,-1.43359379964086E-04,-4.77243077730984E-04,-7.82017330332033E-04,-1.02710975518629E-03,-1.18433866887102E-03,-1.23054372643754E-03,-1.15005424670041E-03,-9.36787962897346E-04,-5.95784838879986E-04,-1.44007821625586E-04,3.89716104854211E-04,9.65687604159894E-04,1.53526991013267E-03,2.04370996700933E-03,2.43372079732041E-03,2.64963648439458E-03,2.64189661042649E-03,2.37157585197847E-03,1.81465030681864E-03,9.65687604159892E-04,-1.59335703530431E-04,-1.52134857203864E-03,-3.05783392803368E-03,-4.68393981448673E-03,-6.29509574580823E-03,-7.77108321395080E-03,-8.98141405533700E-03,-9.79177966610926E-03,-1.00712539315643E-02,-9.69986883311807E-03,-8.57613876785278E-03,-6.62409121098645E-03,-3.79936954367653E-03,-9.40090762471833E-05,4.46045178730132E-03,9.79177966610926E-03,1.57879261986381E-02,2.23000182926874E-02,2.91473770982950E-02,3.61243658100326E-02,4.30087568618803E-02,4.95712152149793E-02,5.55854222558319E-02,6.08383190620733E-02,6.51399316202922E-02,6.83322553645940E-