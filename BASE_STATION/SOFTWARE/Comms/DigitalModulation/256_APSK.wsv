<Item XName="Note1_Constellations_RingRatios" UserName="Note1_Constellations_RingRatios" Type="Notes">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>&lt;P&gt;&lt;STRONG&gt;&lt;FONT size=5&gt;Selected Constellation Mappings for DVB-S2X&lt;/FONT&gt;&lt;/STRONG&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P&gt;&lt;STRONG&gt;&lt;/STRONG&gt;&amp;nbsp;&lt;/P&gt;&#x000D;&#x000A;&lt;P&gt;&lt;EM&gt;Mappings taken from pages 17-32 of &lt;/EM&gt;&lt;FONT face=Arial-BoldMT&gt;&lt;FONT face=Arial-BoldMT&gt;&lt;EM&gt;&quot;DVB Document A83-2 Part II: S2-Extensions (DVB-S2X)&quot; - &lt;FONT face=Helvetica-Bold&gt;&lt;FONT face=Helvetica-Bold&gt;March 2014&lt;/P&gt;&lt;/FONT&gt;&lt;/FONT&gt;&lt;/EM&gt;&lt;/FONT&gt;&lt;/FONT&gt;&#x000D;&#x000A;&lt;P&gt;&amp;nbsp;&lt;/P&gt;&#x000D;&#x000A;&lt;P&gt;&lt;STRONG&gt;Phase offsets&lt;/STRONG&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P&gt;Note for all evenly spaced rings with &quot;n&quot; states per ring, the phase offset is an n/2 spacing so that there no states directly on either the I or Q axes.&amp;nbsp; For example, for a ring with 32 states, then offset by pi/32 = 180/32=5.625deg&lt;/P&gt;&#x000D;&#x000A;&lt;P&gt;&amp;nbsp;&lt;/P&gt;&#x000D;&#x000A;&lt;P&gt;&lt;STRONG&gt;Ring Ratios&lt;/STRONG&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P&gt;Most of the ring ratios are optimized for nonlinearities and performance with AWGN noise.&amp;nbsp; In some cases there are several sets of ring-ratios defined for various LDPC coding states.&amp;nbsp; The list below is not exhaustive, but if you see an array in blue font, then you can cut &amp;amp; paste that into the Ring Ratio definition on the Custom APSK modulator.&amp;nbsp; If using the 89600 VSA software, be sure to define the ring ratios under &quot;Custom APSK&quot; tab under the &quot;MeasSetup / DigitalDemod Properties...&quot; command.&lt;/P&gt;&#x000D;&#x000A;&lt;UL&gt;&#x000D;&#x000A;&lt;LI&gt;&lt;STRONG&gt;&lt;FONT face=Arial&gt;64 APSK constellations&lt;/FONT&gt;&lt;/STRONG&gt;&lt;/LI&gt;&#x000D;&#x000A;&lt;UL&gt;&#x000D;&#x000A;&lt;LI&gt;&lt;FONT face=Arial&gt;16+16+16+16&amp;nbsp; (ring ratios of 1.000, 1.880, 2.720, 3.950) &lt;/FONT&gt;&lt;/LI&gt;&#x000D;&#x000A;&lt;LI&gt;&lt;FONT face=Arial&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; --&amp;gt; &lt;FONT color=#0000ff&gt;[0.253; 0.456; 0.689; 1.000]&lt;/FONT&gt;&lt;/FONT&gt;&lt;/LI&gt;&#x000D;&#x000A;&lt;LI&gt;&lt;FONT face=Arial&gt;8+16+20+20&amp;nbsp;&amp;nbsp; &amp;nbsp;(ring ratios of 1.000, 2.200, 3.600(or3.500), 5.200(or5.000) )&lt;/FONT&gt;&lt;/LI&gt;&#x000D;&#x000A;&lt;LI&gt;&lt;FONT face=Arial&gt;4+12+20+28&amp;nbsp;&amp;nbsp; &amp;nbsp;(ring ratios of 1.000, 2.400, 4.300, 7.000)&amp;nbsp; &lt;/FONT&gt;&lt;/LI&gt;&#x000D;&#x000A;&lt;LI&gt;&lt;FONT face=Arial&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;--&amp;gt; &lt;FONT color=#0000ff&gt;[0.143; 0.343; 0.614; 1.000]&lt;/FONT&gt;&lt;/FONT&gt;&lt;/LI&gt;&lt;/UL&gt;&#x000D;&#x000A;&lt;LI&gt;&lt;STRONG&gt;&lt;FONT face=Arial&gt;128-APSK constellations&lt;/FONT&gt;&lt;/STRONG&gt;&lt;/LI&gt;&#x000D;&#x000A;&lt;UL&gt;&#x000D;&#x000A;&lt;LI&gt;&lt;FONT face=Arial&gt;16+16+16+16+16+48 (but very irregular spacings, cannot be done with custom-APSK mode)&lt;/FONT&gt;&lt;/LI&gt;&#x000D;&#x000A;&lt;LI&gt;&lt;FONT face=Arial&gt;ring ratios of (1.000, 1.715, 2.118, 2.681, 2.750, 3.3819).&amp;nbsp; &lt;/FONT&gt;&lt;/LI&gt;&#x000D;&#x000A;&lt;LI&gt;&lt;FONT face=Arial&gt;Note rings 4&amp;amp;5 are essentially interleaved&lt;/FONT&gt;&lt;/LI&gt;&lt;/UL&gt;&#x000D;&#x000A;&lt;LI&gt;&lt;FONT face=Arial&gt;&lt;STRONG&gt;256-APSK constellations &lt;/STRONG&gt;&lt;/FONT&gt;&lt;/LI&gt;&#x000D;&#x000A;&lt;UL&gt;&#x000D;&#x000A;&lt;LI&gt;&lt;FONT face=Arial&gt;8 rings of 32 states each, &lt;EM&gt;each offset by 5.625deg&lt;/EM&gt;&lt;/FONT&gt;&lt;/LI&gt;&#x000D;&#x000A;&lt;LI&gt;&lt;FONT face=Arial&gt;ring ratios for 4 different LDPC code identifiersare specified as follows:&lt;/FONT&gt;&lt;/LI&gt;&#x000D;&#x000A;&lt;LI&gt;&lt;FONT face=Arial&gt;&lt;EM&gt;LDPC code 116/180&lt;/EM&gt;: (1.000, 1.791, 2.405, 2.980, 3.569, 4.235, 5.078, 6.536)&lt;/FONT&gt;&lt;/LI&gt;&#x000D;&#x000A;&lt;LI&gt;&lt;FONT face=Arial&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;FONT color=#0000ff&gt;[0.153; 0.274; 0.368; 0.456; 0.546; 0.648; 0.777; 1.000]&lt;/FONT&gt;&lt;/FONT&gt;&lt;/LI&gt;&#x000D;&#x000A;&lt;LI&gt;&lt;FONT face=Arial&gt;&lt;EM&gt;LDPC code 124/180&lt;/EM&gt;: (1.000, 1.791, 2.405, 2.980, 3.569, 4.235, 5.078, 6.536)&lt;/FONT&gt;&lt;/LI&gt;&#x000D;&#x000A;&lt;LI&gt;&lt;FONT face=Arial&gt;&lt;EM&gt;LDPC code 128/180&lt;/EM&gt;: (1.000, 1.794, 2.409, 2.986, 3.579, 4.045, 4.600, 5.400)&lt;/FONT&gt;&lt;/LI&gt;&#x000D;&#x000A;&lt;LI&gt;&lt;FONT face=Arial&gt;&lt;EM&gt;LDPC code 135/180&lt;/EM&gt;: (1.000, 1.794, 2.409, 2.986, 3.579, 4.045, 4.500, 5.200)&lt;/FONT&gt;&lt;/LI&gt;&#x000D;&#x000A;&lt;LI&gt;&lt;FONT face=Arial&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;FONT color=#0000ff&gt;[0.192; 0.345; 0.463; 0.574; 0.688; 0.778; 0.865; 1.000]&lt;/FONT&gt;&lt;/FONT&gt;&lt;/LI&gt;&lt;/UL&gt;&lt;/UL&gt;&#x000D;&#x000A;&lt;P&gt;&lt;STRONG&gt;Other notes&lt;/STRONG&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;OL&gt;&#x000D;&#x000A;&lt;LI&gt;&lt;FONT face=Arial&gt;Payload frames are typically 16200, 32400, or 64800 bits long.&lt;/FONT&gt;&lt;/LI&gt;&#x000D;&#x000A;&lt;LI&gt;&lt;FONT face=Arial&gt;Filtering is comparable to DVB-S2 with the addition of these roll-off factors (alpha = 0.35, 0.25 and 0.20), the additional roll-offs&amp;nbsp;alpha = 0.15; 0.10 and 0.05 shall be implemented.&lt;/FONT&gt;&lt;/LI&gt;&lt;/OL&gt;&#x000D;&#x000A;&lt;P&gt;&amp;nbsp;&lt;/P&gt;&#x000D;&#x000A;&lt;P&gt;&lt;FONT face=TimesNewRomanPSMT&gt;&lt;FONT face=TimesNewRomanPSMT&gt;&lt;STRONG&gt;Typical TWTA amplifier characteristics&lt;/STRONG&gt;&lt;/FONT&gt;&lt;/FONT&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;UL&gt;&#x000D;&#x000A;&lt;LI&gt;&lt;FONT face=Arial&gt;Here are some GCOMP7 values&amp;nbsp; from the appendix of the DVB-S2X document that can be used to simulate a satellite transponder TWTA using the&amp;nbsp;compressing Amplifier model in dataflow simulations.&amp;nbsp; The values have been interpreted off a graph and re-normalized to provide the deviation from the small-signal (linear) gain required by the model.&amp;nbsp; Just add commas and surround with square brackets.&lt;/FONT&gt;&lt;/LI&gt;&#x000D;&#x000A;&lt;LI&gt;&lt;FONT face=Arial&gt;Power level below is #dB effectively backed off&amp;nbsp;from output Psat.&lt;/FONT&gt;&lt;/LI&gt;&#x000D;&#x000A;&lt;LI&gt;&lt;FONT face=Arial&gt;AM/AM - Gain Compression is in dB, delta gain compared to small signal dB(S21)&lt;/FONT&gt;&lt;/LI&gt;&#x000D;&#x000A;&lt;LI&gt;&lt;FONT face=Arial&gt;AM/PM - Delta Phase is not absolute phase, but deviation from phase(S21)&lt;/FONT&gt;&lt;/LI&gt;&lt;/UL&gt;&#x000D;&#x000A;&lt;P&gt;&lt;U&gt;Pwr&lt;/U&gt;&amp;nbsp; &lt;U&gt;GainCompress&lt;/U&gt;&amp;nbsp; &lt;U&gt;DeltaPhase&lt;/U&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;BLOCKQUOTE style=&quot;MARGIN-RIGHT: 0px&quot; dir=ltr&gt;&#x000D;&#x000A;&lt;P&gt;-20&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;0&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; 0 &lt;/P&gt;&#x000D;&#x000A;&lt;P&gt;-19&amp;nbsp;&amp;nbsp;&amp;nbsp; 0&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; 0&lt;/P&gt;&#x000D;&#x000A;&lt;P&gt;-18&amp;nbsp;&amp;nbsp;&amp;nbsp; 0&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; 0&lt;/P&gt;&#x000D;&#x000A;&lt;P&gt;-17&amp;nbsp;&amp;nbsp;&amp;nbsp; 0&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &amp;nbsp;0 &lt;/P&gt;&#x000D;&#x000A;&lt;P&gt;-16&amp;nbsp;&amp;nbsp;&amp;nbsp; 0&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; -0.1&lt;/P&gt;&#x000D;&#x000A;&lt;P&gt;-15&amp;nbsp;&amp;nbsp;&amp;nbsp; 0&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; -0.2&lt;/P&gt;&#x000D;&#x000A;&lt;P&gt;-14&amp;nbsp;&amp;nbsp;&amp;nbsp; 0&amp;nbsp;&amp;nbsp;&amp;nbsp; &amp;nbsp;-0.3&lt;/P&gt;&#x000D;&#x000A;&lt;P&gt;-13&amp;nbsp;&amp;nbsp;&amp;nbsp; 0&amp;nbsp;&amp;nbsp; &amp;nbsp; -0.37&lt;/P&gt;&#x000D;&#x000A;&lt;P&gt;-12&amp;nbsp;&amp;nbsp;&amp;nbsp; 0&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; -0.45&lt;/P&gt;&#x000D;&#x000A;&lt;P&gt;-11&amp;nbsp;&amp;nbsp;&amp;nbsp; 0&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; -0.6&lt;/P&gt;&#x000D;&#x000A;&lt;P&gt;-10&amp;nbsp;&amp;nbsp;&amp;nbsp; 0&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; -0.8&lt;/P&gt;&#x000D;&#x000A;&lt;P&gt;&amp;nbsp;-9&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; 0&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; -0.8&lt;/P&gt;&#x000D;&#x000A;&lt;P&gt;&amp;nbsp;-8&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; 0&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; -0.8&lt;/P&gt;&#x000D;&#x000A;&lt;P&gt;&amp;nbsp;-7&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; 0&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; -0.8&lt;/P&gt;&#x000D;&#x000A;&lt;P&gt;&amp;nbsp;-6&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; 0&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; -1.1&lt;/P&gt;&#x000D;&#x000A;&lt;P&gt;&amp;nbsp;-5&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; 0&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; -1.7&lt;/P&gt;&#x000D;&#x000A;&lt;P&gt;&amp;nbsp;-4&amp;nbsp;&amp;nbsp;&amp;nbsp;-0.1&amp;nbsp;&amp;nbsp; -2.3&lt;/P&gt;&#x000D;&#x000A;&lt;P&gt;&amp;nbsp;-3&amp;nbsp;&amp;nbsp;&amp;nbsp;-0.3&amp;nbsp;&amp;nbsp;&amp;nbsp;-2.6&lt;/P&gt;&#x000D;&#x000A;&lt;P&gt;&amp;nbsp;-2&amp;nbsp;&amp;nbsp;&amp;nbsp;-0.7&amp;nbsp;&amp;nbsp;&amp;nbsp;-4.5&lt;/P&gt;&#x000D;&#x000A;&lt;P&gt;&amp;nbsp;-1&amp;nbsp;&amp;nbsp;&amp;nbsp;-1.2&amp;nbsp;&amp;nbsp;&amp;nbsp;-6.1&lt;/P&gt;&#x000D;&#x000A;&lt;P&gt;&amp;nbsp; 0&amp;nbsp;&amp;nbsp;&amp;nbsp;-2.0&amp;nbsp;&amp;nbsp;&amp;nbsp;-7.7&lt;/P&gt;&#x000D;&#x000A;&lt;P&gt;&amp;nbsp; 1&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;-3.0&amp;nbsp; -7.6&lt;/P&gt;&#x000D;&#x000A;&lt;P&gt;&amp;nbsp; 2&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;-4.3&amp;nbsp;&amp;nbsp;-6.1&lt;/P&gt;&#x000D;&#x000A;&lt;P&gt;&amp;nbsp; 3&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;-5.7&amp;nbsp; -2.5&lt;/P&gt;&#x000D;&#x000A;&lt;P&gt;&amp;nbsp; 4&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;-7.1&amp;nbsp; -1.0&lt;/P&gt;&lt;/BLOCKQUOTE&gt;&#x000D;&#x000A;&lt;P&gt;&amp;nbsp;&lt;/P&gt;&#x000D;&#x000A;&lt;P&gt;&amp;nbsp;&lt;/P&gt;&#x000D;&#x000A;&lt;P&gt;&lt;FONT face=TimesNewRomanPSMT&gt;&lt;FONT face=TimesNewRomanPSMT&gt;&lt;STRONG&gt;Phase Noise masks for simulations&lt;/STRONG&gt;&lt;/FONT&gt;&lt;/FONT&gt;&lt;/P&gt;&lt;FONT face=TimesNewRomanPSMT&gt;&lt;FONT face=TimesNewRomanPSMT&gt;&lt;FONT face=Helvetica-Bold&gt;&lt;FONT face=Helvetica-Bold&gt;&#x000D;&#x000A;&lt;BLOCKQUOTE style=&quot;MARGIN-RIGHT: 0px&quot; dir=ltr&gt;&#x000D;&#x000A;&lt;P align=left&gt;&lt;STRONG&gt;frequency&amp;nbsp;&lt;/STRONG&gt;&lt;/FONT&gt;&lt;/FONT&gt;&lt;FONT face=SymbolMT&gt;&lt;FONT face=SymbolMT&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;FONT size=2&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/FONT&gt;&lt;/FONT&gt;&lt;/FONT&gt;&lt;B&gt;&lt;FONT face=Helvetica-Bold&gt;&lt;FONT face=Helvetica-Bold&gt;&lt;FONT size=2&gt;100Hz&amp;nbsp;&amp;nbsp; 1&amp;nbsp;kHz&amp;nbsp;&amp;nbsp; 10 kHz&amp;nbsp;&amp;nbsp; 100 kHz&amp;nbsp;&amp;nbsp;&amp;nbsp; 1 MHz&amp;nbsp;&amp;nbsp;&amp;nbsp; &amp;gt; 10 MHz&lt;/FONT&gt;&lt;/P&gt;&lt;/B&gt;&lt;/FONT&gt;&lt;/FONT&gt;&lt;FONT size=1 face=ArialMT&gt;&lt;FONT size=1 face=ArialMT&gt;&#x000D;&#x000A;&lt;P align=left&gt;typical, DTH broadcast&amp;nbsp;&amp;nbsp;-25&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; -50&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &amp;nbsp;-73&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; -93&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &amp;nbsp;-103&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &amp;nbsp;&amp;nbsp; -114&lt;/P&gt;&#x000D;&#x000A;&lt;P&gt;critical, Prof Services&amp;nbsp;&amp;nbsp;&amp;nbsp; &amp;nbsp;-62&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;-79&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; -89&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; -95&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; -106&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &amp;nbsp;&amp;nbsp; -116&lt;/P&gt;&lt;/BLOCKQUOTE&gt;&lt;/FONT&gt;&lt;/FONT&gt;&lt;/FONT&gt;&lt;/FONT&gt;</Text>
