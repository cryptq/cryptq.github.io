<Item XName="EQ_TWTA_AMPM" UserName="EQ_TWTA_AMPM" Type="Equation">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>% gain compression in triplets of data&#x000D;&#x000A;% Pin in dBm, Gain Compress (dB), Delta Phase (deg)&#x000D;&#x000A;TWTA_comp = ...&#x000D;&#x000A;[-20,0,0, ... &#x000D;&#x000A;-19,0,0, ...&#x000D;&#x000A;-18,0,0, ...&#x000D;&#x000A;-17,0,0, ...&#x000D;&#x000A;-16,0,-0.1, ...&#x000D;&#x000A;-15,0,-0.2, ...&#x000D;&#x000A;-14,0,-0.3, ...&#x000D;&#x000A;-13,0,-0.37, ...&#x000D;&#x000A;-12,0,-0.45, ...&#x000D;&#x000A;-11,0,-0.6, ...&#x000D;&#x000A;-10,0,-0.8, ...&#x000D;&#x000A; -9,0,-0.8, ...&#x000D;&#x000A; -8,0,-0.8, ...&#x000D;&#x000A; -7,0,-0.8, ...&#x000D;&#x000A; -6,0,-1.1, ...&#x000D;&#x000A; -5,0,-1.7, ...&#x000D;&#x000A; -4,-0.1,-2.3, ...&#x000D;&#x000A; -3,-0.3,-2.6, ...&#x000D;&#x000A; -2,-0.7,-4.5, ...&#x000D;&#x000A; -1,-1.2,-6.1, ...&#x000D;&#x000A;  0,-2.0,-7.7, ...&#x000D;&#x000A;  1,-3.0,-7.6, ...&#x000D;&#x000A;  2,-4.3,-6.1, ...&#x000D;&#x000A;  3,-5.7,-2.5, ...&#x000D;&#x000A;  4,-7.1,-1.0];&#x000D;&#x000A;</Text>
<UnitUse><T>Int</T><D>2</D></UnitUse>
<Item XName="BPMgr" Type="BPMgr">
<BPLines><T>Empty</T></BPLines>
<BPStates><T>Empty</T></BPStates></Item>
