<Item XName="FunctionBlock" Type="FunctionBlock" />
<Item XName="Page" Type="PageMgr">
<Item XName="Display0" Type="EquationDisp">
<DVport><T>Array_Dbl64</T><D>1;4;;;g524;s124</D></DVport>
<PVPort><T>Array_Dbl64</T><D>1;4;;;UzwrhNBo234;vpdFV{4z{24</D></PVPort>
<Show><T>Bool</T><D>0</D></Show>
<ShowCmd><T>Int</T><D>1</D></ShowCmd>
<Split><T>Double</T><D>0.3</D></Split>
<Split2><T>Double</T><D>0.3</D></Split2>
<Window><T>Array_I64</T><D>1;4;s1;d;nA;I3</D></Window>
<ZOrder><T>Int</T><D>3</D></ZOrder></Item></Item>
<Item XName="VarBlock" Type="VarBlock" /></Item>
<Item XName="Equation1" UserName="Equation1" Type="Equation">
<Selected><T>Bool</T><D>1</D></Selected>
<Text>SampPerSym = 16;&#x000D;&#x000A;DownSamplingPhase=tune(16);&#x000D;&#x000A;&#x000D;&#x000A;using(&apos;Design1_Data&apos;);&#x000D;&#x000A;&#x000D;&#x000A;freqaxis = S3_Power_Freq;&#x000D;&#x000A;&#x000D;&#x000A;Fc = 22e9;                           % Carrier frequency&#x000D;&#x000A;symrate = 35e6;                      % Symbol rate&#x000D;&#x000A;&#x000D;&#x000A;% Fc plus and minus SymbolRate/2.&#x000D;&#x000A;half = symrate / 2;&#x000D;&#x000A;ind_fc = find(freqaxis&gt;=(Fc - half) &amp; freqaxis&lt;=(Fc + half));&#x000D;&#x000A;&#x000D;&#x000A;% Integrate and convert to dBm.&#x000D;&#x000A;ModOutputPower = dbm(sum(S3_Power(ind_fc)));&#x000D;&#x000A;ModOutputPower = round(ModOutputPower * 1000) / 1000;&#x000D;&#x000A;&#x000D;&#x000A;% myBER = round(B2_BER * 1e3)/1e3;&#x000D;&#x000A;&#x000D;&#x000A;% Limit lines of spectral mask. &#x000D;&#x000A;% Source: Olsen and Heymann, &quot;Controlling Satellite Communications &#x000D;&#x000A;% System Unwanted Emissions in Congested RF Spectrum&quot;, October 2007.&#x000D;&#x000A;Peak = dbm(max(S3_Power)); % Use max power point for spectrum mask.&#x000D;&#x000A;y1st = Peak;&#x000D;&#x000A;y2nd = Peak - 30;&#x000D;&#x000A;y3rd = Peak - 60;&#x000D;&#x000A;y4th = Peak - 60;&#x000D;&#x000A;PwrMask = [y4th; y3rd; y2nd; y1st; y1st; y2nd; y3rd; y4th];&#x000D;&#x000A;PwrMask = 10.^(PwrMask*0.1) * 0.001; % Convert dBm to watts for plotting.&#x000D;&#x000A;PwrMask = real(PwrMask);             % Arrays are complex; convert to real.&#x000D;&#x000A;setdisplayunit(&apos;PwrMask&apos;, &apos;dBm&apos;);          % Set units to dBm.&#x000D;&#x000A;&#x000D;&#x000A;x1st = 0.5*symrate;&#x000D;&#x000A;x2nd = 1.4*symrate;&#x000D;&#x000A;x3rd = 3.0*symrate;&#x000D;&#x000A;x4th = 8.0*symrate;&#x000D;&#x000A;&#x000D;&#x000A;FreqMask = [-x4th; -x3rd; -x2nd; -x1st; x1st; x2nd; x3rd; x4th];&#x000D;&#x000A;FreqMask = FreqMask + Fc;            % Scale mask up by carrier frequency.&#x000D;&#x000A;setdisplayunit(&apos;FreqMask&apos;, &apos;GHz&apos;);         % Set units to GHz.&#x000D;&#x000A;setindep(&apos;PwrMask&apos;, &apos;FreqMask&apos;);     % Combine arrays to create the limit lines.&#x000D;&#x000A;</Text>
<UnitUse><T>Int</T><D>2</D></UnitUse>
