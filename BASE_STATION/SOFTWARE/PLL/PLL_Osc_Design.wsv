<Item XName="Eqns" Type="Equation">
<Text>y = getvariable(&apos;Equation4&apos;, &apos;a_SwpF1_dB&apos;);&#x000D;&#x000A;x = getvariable(&apos;Equation4&apos;, &apos;SwpF1_Hz&apos;);&#x000D;&#x000A;setindep(&apos;y&apos;, &apos;x&apos;);</Text>
<UnitUse><T>Int</T><D>2</D></UnitUse>
<Item XName="BPMgr" Type="BPMgr">
<BPLines><T>Empty</T></BPLines>
<BPStates><T>Empty</T></BPStates></Item>
<Item XName="EqnBlock" Type="EqnBlock">
<Lang><T>Int</T><D>1</D></Lang>
<UsingContext>Equation4;</UsingContext></Item>
<Item XName="Font" Type="Font">
<Name>Courier New</Name>
<Size><T>Double</T><D>125</D></Size></Item>
<Item XName="FunctionBlock" Type="FunctionBlock" /></Item></Item></Item>
<Item XName="Width" Type="Param">
<Data><T>Double</T><D>0.14319092039801</D></Data></Item></Item>
<Item XName="Equation2" UserName="Equation2" Type="Equation">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>F = BW/10;&#x000D;&#x000A;FNom=tune(10); % Nominal input test frequency.&#x000D;&#x000A;&#x000D;&#x000A;%****************************************************&#x000D;&#x000A;%***** DO NOT CHANGE ANY OF THE FOLLOWING LINES *****&#x000D;&#x000A;%****************************************************&#x000D;&#x000A;% The follow is setup automatically when Design1_Analysis is run.&#x000D;&#x000A;NSamplesPerBin = 7; % Number of frequency domain points used for evaluating fundamental and harmonics&#x000D;&#x000A;FFT_Window = 4;  % Spectrum analysis FFT window type&#x000D;&#x000A;FRes = SR/(NPts+1);&#x000D;&#x000A;FNomSpecTones = floor( FNom/FRes + 0.5);&#x000D;&#x000A;FTest = FNomSpecTones*FRes;  % Simulation source frequency&#x000D;&#x000A;&#x000D;&#x000A;using(&apos;FreqResp_Data&apos;);&#x000D;&#x000A;&#x000D;&#x000A;Spec_dB = 20*log10( abs(SpecOut));&#x000D;&#x000A;&#x000D;&#x000A;x = abs(SpecOut);&#x000D;&#x000A;x_size = size(x);&#x000D;&#x000A;f_step = SpecOut_Freq(2) - SpecOut_Freq(1);&#x000D;&#x000A;NSpecTones = x_size(1);&#x000D;&#x000A;NFNomSpecTones = floor(FTest/f_step + 0.5);&#x000D;&#x000A;&#x000D;&#x000A;ia = NFNomSpecTones+1;&#x000D;&#x000A;F1 = (ia-1)*f_step;&#x000D;&#x000A;&#x000D;&#x000A;if ( ia &lt; NSamplesPerBin/2  )&#x000D;&#x000A;&#x0009;error( &apos;Line 28: FNom is too close to 0 Hz for FFT analysis.  FNom should be increased slightly.&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;if ( ia &gt; NSpecTones-NSamplesPerBin/2  )&#x000D;&#x000A;&#x0009;error( &apos;FLine 31: Nom is too close to (SampleRate/2) Hz.  FNom should be decreased slightly.&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;% Output sinusoid v and dB for fundamental&#x000D;&#x000A;S1_v = sumHarmTones( x, ia, NSamplesPerBin, NSpecTones);&#x000D;&#x000A;S1_dB = 10*log10( S1_v);&#x000D;&#x000A;&#x000D;&#x000A;</Text>
<UnitUse><T>Int</T><D>2</D></UnitUse>
<Item XName="BPMgr" Type="BPMgr">
<BPLines><T>Empty</T></BPLines>
<BPStates><T>Empty</T></BPStates></Item>
<Item XName="EqnBlock" Type="EqnBlock">
<Lang><T>Int</T><D>1</D></Lang>
<UsingContext>FreqResp_Data;</UsingContext></Item>
