<Item XName="Equations" Type="Equation">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>A = 1 + 1/NormalizedZero^2 -  2*DampingFactor^2;&#x000D;&#x000A;wn = 2*pi*BW/sqrt(A +sqrt(A^2+1));&#x000D;&#x000A;a = NormalizedZero*wn;&#x000D;&#x000A;b = wn*(2*DampingFactor-1/NormalizedZero);&#x000D;&#x000A;K = wn^2/b;&#x000D;&#x000A;t1 = 1/a;&#x000D;&#x000A;t2 = 1/b;&#x000D;&#x000A;F1 = 1/t2/2/pi;&#x000D;&#x000A;GainA = K/ExternalGain;&#x000D;&#x000A;Gain2 = K*t1/t2/ExternalGain;&#x000D;&#x000A;Gain1 = GainA-Gain2;</Text>
<UnitUse><T>Int</T><D>2</D></UnitUse>
