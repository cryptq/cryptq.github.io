<Item XName="VarBlock" Type="VarBlock" /></Item>
<Item XName="Equation4" UserName="Equation4" Type="Equation">
<AutoCalc><T>Bool</T><D>1</D></AutoCalc>
<Selected><T>Bool</T><D>0</D></Selected>
<Text>% These values are used in the Sweep1 analysis.&#x000D;&#x000A;% Swept nominal test frequency start&#x000D;&#x000A;FNomStart = 0.001*SR/2; &#x000D;&#x000A;% Swept nominal test frequency start&#x000D;&#x000A;FNomStop = 0.9*SR/2; &#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;%***** DO NOT CHANGE ANY OF THE FOLLOWING LINES *****&#x000D;&#x000A;%****************************************************&#x000D;&#x000A;% The following is setup automatically when Sweep1 is run.&#x000D;&#x000A;SwpNSamplesPerBin = NSamplesPerBin; % Number of frequency domain points used for evaluating fundamental and harmonics&#x000D;&#x000A;&#x000D;&#x000A;using(&apos;Sweep1_Data&apos;);&#x000D;&#x000A;&#x000D;&#x000A;swpx = abs(SpecOut);&#x000D;&#x000A;swpx_size = size(swpx);&#x000D;&#x000A;swpf_step = SpecOut_Freq(2) - SpecOut_Freq(1);&#x000D;&#x000A;swpf_lastA = SpecOut_Freq(swpx_size);&#x000D;&#x000A;swpf_last = swpf_lastA(1);&#x000D;&#x000A;SwpNSpecTonesA = floor( swpf_last/swpf_step + 0.5);&#x000D;&#x000A;SwpNSpecTones = SwpNSpecTonesA(1)+1;&#x000D;&#x000A;&#x000D;&#x000A;NumSteps = swpx_size/SwpNSpecTones;&#x000D;&#x000A;n = 1:NumSteps(1);&#x000D;&#x000A;SwpF1_Hz = 0*n;&#x000D;&#x000A;a_SwpF1_dB = 0*n;&#x000D;&#x000A;&#x000D;&#x000A;x = 1:SwpNSpecTones;&#x000D;&#x000A;for i=1:NumSteps&#x000D;&#x000A;&#x0009;x = abs(SpecOut( ((i-1)*SwpNSpecTones+1) : (i*SwpNSpecTones) ));&#x000D;&#x000A;&#x0009;SwpF1 = Equation2_FNom_Swp_SpecOut_Freq( (i-1)*SwpNSpecTones+1);  % Simulation measurement frequency&#x000D;&#x000A;&#x0009;SwpF1_Hz(i) = SwpF1;  % Simulation measurement frequency&#x000D;&#x000A;&#x0009;SwpNumFSpecTones = floor(SwpF1/swpf_step + 0.5);&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;Sia = SwpNumFSpecTones+1;&#x000D;&#x000A;&#x0009;SS1_v2 = sumHarmTones( x, Sia, SwpNSamplesPerBin, SwpNSpecTones);&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;SwpS1_v = sumHarmTones( x, Sia, SwpNSamplesPerBin, SwpNSpecTones);&#x000D;&#x000A;&#x0009;a_SwpF1_dB(i) = 10*log10( SwpS1_v);&#x000D;&#x000A;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;</Text>
