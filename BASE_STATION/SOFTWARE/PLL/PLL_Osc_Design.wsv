<Item XName="Display0" Type="EquationDisp">
<DVport><T>Array_Dbl64</T><D>1;4;;;et14;Om14</D></DVport>
<PVPort><T>Array_Dbl64</T><D>1;4;;;GX25AKWNl24;{Hv7bVRlb24</D></PVPort>
<Show><T>Bool</T><D>1</D></Show>
