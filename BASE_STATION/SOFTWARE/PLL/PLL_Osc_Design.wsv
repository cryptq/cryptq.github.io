<Item XName="sumHarmTones" UserName="sumHarmTones" Type="function">
<AutoCalc><T>Bool</T><D>1</D></AutoCalc>
<Selected><T>Bool</T><D>0</D></Selected>
<Text>% This sheet contains functions used in sheets Equation2 and Equation4.&#x000D;&#x000A;&#x000D;&#x000A;% sum squared harmonic voltages&#x000D;&#x000A;function h_v2 = sumHarmTones( x, i, NBin2, NSTones)&#x000D;&#x000A;&#x0009;if (NBin2==1)&#x000D;&#x000A;&#x0009;&#x0009;h_v2 = x( i).*x( i);&#x000D;&#x000A;&#x0009;else&#x000D;&#x000A;&#x0009;&#x0009;ilo = i-floor((NBin2+1)/2);&#x000D;&#x000A;&#x0009;&#x0009;ihi = i+floor((NBin2+1)/2);&#x000D;&#x000A;&#x0009;&#x0009;if ( ilo &lt; 2 )&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;ilo = 2;&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;if ( ihi &gt; NSTones )&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;ihi = NSTones;&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;h_v2 = sum( x( ilo: 1: ihi).*x( ilo: 1: ihi) );&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;</Text>
