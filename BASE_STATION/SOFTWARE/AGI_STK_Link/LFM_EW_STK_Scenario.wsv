<Item XName="EmitterSetup" UserName="EmitterSetup" Type="Equation">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>fs=250e6; &#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;% Sampling rate of the system&#x000D;&#x000A;&#x000D;&#x000A;%********* LFM Sources Setup ****************&#x000D;&#x000A;% ******** Emitter1 *************************&#x000D;&#x000A;RF_Freq1 = 1.6e9;  &#x0009;&#x0009;&#x0009;&#x0009;&#x0009;% Radar Frequency in Hz&#x000D;&#x000A;Pulse_Width1 = 2e-6; &#x0009;&#x0009;&#x0009;&#x0009;% Radar LFM Pulse Width in sec&#x000D;&#x000A;PRI1 = 150e-6; &#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;% Radar LFM Pulse Repetion Interval in sec&#x000D;&#x000A;BandWidth1 = 25e6; &#x0009;&#x0009;&#x0009;&#x0009;&#x0009;% Radar LFM Waveform Bandwidth in Hz&#x000D;&#x000A;rise_time1 = 0.05e-6;&#x000D;&#x000A;fall_time1 = 0.05e-6; &#x000D;&#x000A;PWT1 = Pulse_Width1 + rise_time1 + fall_time1;&#x000D;&#x000A;ratio1 = PWT1 / Pulse_Width1;&#x000D;&#x000A;dist1 = 9.45e3;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;%distance to target in m&#x000D;&#x000A;vel1 = 100;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;%target velocity in m/s&#x000D;&#x000A;&#x000D;&#x000A;% ******** Emitter2 *************************&#x000D;&#x000A;RF_Freq2 = 1.4e9;  &#x0009;&#x0009;&#x0009;&#x0009;&#x0009;% Radar Frequency in Hz&#x000D;&#x000A;Pulse_Width2 = 5e-6; &#x0009;&#x0009;&#x0009;&#x0009;% Radar LFM Pulse Width in sec&#x000D;&#x000A;PRI2 = 100e-6; &#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;% Radar LFM Pulse Repetion Interval in sec&#x000D;&#x000A;BandWidth2 = 25e6; &#x0009;&#x0009;&#x0009;&#x0009;&#x0009;% Radar LFM Waveform Bandwidth in Hz&#x000D;&#x000A;rise_time2 = 0.05e-6;&#x000D;&#x000A;fall_time2 = 0.05e-6; &#x000D;&#x000A;PWT2 = Pulse_Width2 + rise_time2 + fall_time2;&#x000D;&#x000A;ratio2 = PWT2 / Pulse_Width2;&#x000D;&#x000A;dist2 = 9.85e3;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;%distance to target in m&#x000D;&#x000A;vel2 = 100;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;%target velocity in m/s&#x000D;&#x000A;&#x000D;&#x000A;% ******** Emitter3 *************************&#x000D;&#x000A;RF_Freq3 = 1.2e9;  &#x0009;&#x0009;&#x0009;&#x0009;&#x0009;% Radar Frequency in Hz&#x000D;&#x000A;Pulse_Width3 = 1e-6; &#x0009;&#x0009;&#x0009;&#x0009;% Radar LFM Pulse Width in sec&#x000D;&#x000A;PRI3 = 75e-6; &#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;% Radar LFM Pulse Repetion Interval in sec&#x000D;&#x000A;BandWidth3 = 25e6; &#x0009;&#x0009;&#x0009;&#x0009;&#x0009;% Radar LFM Waveform Bandwidth in Hz&#x000D;&#x000A;rise_time3 = 0.05e-6;&#x000D;&#x000A;fall_time3 = 0.05e-6; &#x000D;&#x000A;PWT3 = Pulse_Width3 + rise_time3 + fall_time3;&#x000D;&#x000A;ratio3 = PWT3 / Pulse_Width3;&#x000D;&#x000A;dist3 = 10e3;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;%distance to target in m&#x000D;&#x000A;vel3 = 100;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;%target velocity in m/s&#x000D;&#x000A;%********************************************&#x000D;&#x000A;ew_Idx = tune(1)&#x000D;&#x000A;RF_freq_ME = [RF_Freq1;RF_Freq2;RF_Freq3];&#x000D;&#x000A;PRI_ME     = [PRI1;PRI2;PRI3];&#x000D;&#x000A;PWT_ME     = [PWT1;PWT2;PWT3];&#x000D;&#x000A;rise_ME    = [rise_time1;rise_time2;rise_time3];&#x000D;&#x000A;fall_ME    = [fall_time1;fall_time2;fall_time3];&#x000D;&#x000A;BW_ME      = [BandWidth1;BandWidth2;BandWidth3];&#x000D;&#x000A;ratio_ME   = [ratio1;ratio2;ratio3];&#x000D;&#x000A;&#x000D;&#x000A;%STK Objects&#x000D;&#x000A;Radar1 = &apos;*/Facility/RADAR_STA1/Transmitter/Transmitter1&apos;;&#x000D;&#x000A;Radar2 = &apos;*/Facility/RADAR_STA2/Transmitter/Transmitter2&apos;;&#x000D;&#x000A;Ship = &apos;*/Ship/Ship1/Transmitter/Transmitter3&apos;;&#x000D;&#x000A;&#x000D;&#x000A;switch ew_Idx&#x000D;&#x000A;    case 1&#x000D;&#x000A;        FromObj = Radar1;&#x000D;&#x000A;    case 2&#x000D;&#x000A;        FromObj = Radar2;&#x000D;&#x000A;    case 3&#x000D;&#x000A;        FromObj = Ship;&#x000D;&#x000A;    otherwise&#x000D;&#x000A;        FromObj = Radar1;&#x000D;&#x000A;end</Text>
