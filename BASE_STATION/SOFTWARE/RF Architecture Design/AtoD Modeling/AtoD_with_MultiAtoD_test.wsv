<Item XName="Equation1" UserName="Equation1" Type="Equation">
<AutoCalc><T>Bool</T><D>1</D></AutoCalc>
<Selected><T>Bool</T><D>0</D></Selected>
<Text>SampleR=tune(100);&#x000D;&#x000A;NPts = 2^14;&#x000D;&#x000A;FNom=tune(13.4e+006); % Nominal AtoD input test frequency.&#x000D;&#x000A;dBFS = -1;  % Test frequency level in terms of dB from full scale.&#x000D;&#x000A;            % Negative value means the level will be less than full scale.&#x000D;&#x000A;&#x000D;&#x000A;InputSpan = 2;  % = 2*VRef&#x000D;&#x000A;&#x000D;&#x000A;RJrms=tune(0);&#x000D;&#x000A;INL=tune(0);&#x000D;&#x000A;DNL=tune(0);&#x000D;&#x000A;&#x000D;&#x000A;% Within the &apos;Design1 Analysis&apos; dialog, set the &apos;System Sample Rate&apos; and &apos;Number of Samples&apos;.&#x000D;&#x000A;&#x000D;&#x000A;RefR = 50;  % Reference resistance for evaluating power&#x000D;&#x000A;NSamplesPerBin = 15; % Number of frequency domain points used for evaluating fundamental and harmonics&#x000D;&#x000A;FFT_Window = 4;  % Spectrum analysis FFT window type&#x000D;&#x000A;% The follow is setup automatically when Design1_Analysis is run.&#x000D;&#x000A;RefLevel = InputSpan/2;&#x000D;&#x000A;SR = SampleR*1.0e6;&#x000D;&#x000A;NSamples = NPts; % number of simulation samples per spectrum FFT&#x000D;&#x000A;FRes = SR/(NPts+1);&#x000D;&#x000A;FNomSpecTones = floor( FNom/FRes + 0.5);&#x000D;&#x000A;FTest = FNomSpecTones*FRes;  % Simulation source frequency&#x000D;&#x000A;NyquistZone = ceil( FTest/(SR/2))-1;&#x000D;&#x000A;FLevel = RefLevel * 10^( dBFS/20);&#x000D;&#x000A;FPower_W = (FLevel)^2/(2*RefR);&#x000D;&#x000A;FPower_dBm = 10*log10( FPower_W) + 30;  % Simulation source power level&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;</Text>
<UnitUse><T>Int</T><D>2</D></UnitUse>
