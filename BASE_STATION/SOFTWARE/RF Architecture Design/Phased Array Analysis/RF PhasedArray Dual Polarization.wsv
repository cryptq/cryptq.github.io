<Unit><T>Int</T><D>8000</D></Unit>
<Validate><T>Int</T><D>14</D></Validate></Item>
<Item XName="ElementRotationAroundY" Type="PartParam">
<DataEntry>[0]</DataEntry>
<Default><T>Bool</T><D>1</D></Default>
<Description>Rotation angle around y&apos; axis after the first rotation (also known as Pitch or Downtilt angle), observed from positive y&apos;, measured from positive z(z&apos;) axis counterclockwise</Description>
<HideCondition>(ElementPatternType &lt; 2) | (ElementPatternType &gt; 3) | (RotateElement &lt; 1)</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Unit><T>Int</T><D>8000</D></Unit>
<Validate><T>Int</T><D>14</D></Validate></Item>
<Item XName="ElementRotationAroundZ" Type="PartParam">
<DataEntry>[0]</DataEntry>
<Default><T>Bool</T><D>1</D></Default>
