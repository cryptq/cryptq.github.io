<Text>% If the 3D plot is no longer responding, then delete it and re-run this script&#x000D;&#x000A;&#x000D;&#x000A;using(&apos;PhasedArray_Data1&apos;);&#x000D;&#x000A;&#x000D;&#x000A;graph1=graph_figure(&apos;BeamPattern&apos;);&#x000D;&#x000A;graph1.add_spherical_data( ArrayMeas_Directivity_PhiGrid , ArrayMeas_Directivity_ThetaGrid, max(10*log10(ArrayMeas_Directivity_Pattern),-30) );&#x000D;&#x000A;&#x000D;&#x000A;graph2=graph_figure(&apos;BeamPatternPol1&apos;);&#x000D;&#x000A;graph2.add_spherical_data( ArrayMeas_Directivity_PhiGrid , ArrayMeas_Directivity_ThetaGrid, max(10*log10(ArrayMeas_Polarization1_Pattern),-30) );&#x000D;&#x000A;graph2.set_title(ArrayMeas_Polarization1);&#x000D;&#x000A;&#x000D;&#x000A;graph3=graph_figure(&apos;BeamPatternPol2&apos;);&#x000D;&#x000A;graph3.add_spherical_data( ArrayMeas_Directivity_PhiGrid , ArrayMeas_Directivity_ThetaGrid, max(10*log10(ArrayMeas_Polarization2_Pattern),-30) );&#x000D;&#x000A;graph3.set_title(ArrayMeas_Polarization2);</Text>
