<Context>&lt; Post Processed &gt;</Context>
<Label>ArrayMeas_Directivity_Pattern_U_Cut</Label>
<Meas>ArrayMeas_Directivity_Pattern</Meas>
<PPVar>Directivity_Pattern_U_Cut</PPVar>
<PlotType />
<PosX><T>Double</T><D>0</D></PosX>
<PosY><T>Double</T><D>0</D></PosY>
<SeriesType><T>Int</T><D>7</D></SeriesType>
<SymbolShape><T>Int</T><D>2</D></SymbolShape>
<ZOrder><T>Int</T><D>9000</D></ZOrder>
<Item XName="Eqns" Type="Equation">
<Text>CutValue = 0;&#x000A;using(&apos;PhasedArray1_TxDesign_Data&apos;);&#x000A;&#x000A;if(CutValue &lt; -1 || 1 &lt; CutValue)&#x000A;&#x0009;error(&apos;U cut value should be in range [-1, 1]&apos;);&#x000A;end&#x000A;&#x000A;range=ArrayMeas_Directivity_ThetaGrid(1,end) - ArrayMeas_Directivity_ThetaGrid(1,1);&#x000A;if(abs(range - pi) &lt;= 1.0e-9)&#x000A;&#x0009;resolution=ArrayMeas_Directivity_ThetaGrid(1,2) - ArrayMeas_Directivity_ThetaGrid(1,1);&#x000A;&#x0009;endIndex = int32(floor(pi/(resolution*2) + 1));&#x000A;else&#x000A;&#x0009;[phiNum, thetaNum] = size(ArrayMeas_Directivity_ThetaGrid);&#x000A;&#x0009;endIndex = thetaNum;&#x000A;end&#x000A;&#x000A;U=sin(ArrayMeas_Directivity_ThetaGrid(:, 1:endIndex)).*cos(ArrayMeas_Directivity_PhiGrid(:, 1:endIndex));&#x000A;V=sin(ArrayMeas_Directivity_ThetaGrid(:, 1:endIndex)).*sin(ArrayMeas_Directivity_PhiGrid(:, 1:endIndex));&#x000A;Directivity_Pattern=10*log10(ArrayMeas_Directivity_Pattern(:, 1:endIndex));&#x000A;DirectivityMin = min( Directivity_Pattern(:) );&#x000A;&#x000A;Vmax = sqrt( 1 - CutValue^2 );      % Find the max value for V based on the U cut value&#x000A;N = floor( Vmax / 0.01 );           % Floor it to the nearest 1/100&#x000A;vq = (-N:N)*0.01;                   % Create vector of V values between -Vmax and Vmax spaced at 0.01&#x000A;uq = ones( 1, 2*N+1)*CutValue;      % Create vector of U values at constant cut value same length as V&#x000A;&#x000A;% Replace +1, -1 with something slightly smaller in absolute value to avoid getting NaN from griddata.&#x000A;if ( abs( vq(1) + 1 ) &lt; 1.0e-6 )&#x000A;      vq(1) = -1 + 1e-6;&#x000A;end&#x000A;&#x000A;if ( abs( vq(end) - 1 ) &lt; 1.0e-6 )&#x000A;      vq(end) = 1 - 1e-6;&#x000A;end&#x000A;&#x000A;% Get interpolated data&#x000A;Directivity_Pattern_U_Cut = griddata(double(U), double(V), double(Directivity_Pattern), uq, vq);&#x000A;Directivity_Pattern_U_Cut(isnan(Directivity_Pattern_U_Cut)) = DirectivityMin;&#x000A;&#x000A;vq = (-100:100)*0.01;   % Extend the V vector to the range [-1,1]&#x000A;&#x000A;% Fill in missing values with DirectivityMin&#x000A;Directivity_Pattern_U_Cut = [ ones(1,100-N)*DirectivityMin, Directivity_Pattern_U_Cut, ones(1,100-N)*DirectivityMin ];&#x000A;&#x000A;setindep(&apos;Directivity_Pattern_U_Cut&apos;, &apos;vq&apos;);</Text>
