<Item XName="~Eqns" Type="Equation">
<Text>% ONLY update GraphDynamicRange variable below.&#x000A;% DO NOT make any other edits.&#x000A;&#x000A;GraphDynamicRange = 60; % in dB&#x000A;&#x000A;&#x000A;using(&apos;PhasedArray1_TxDesign_Data&apos;);&#x000A;DirectivityMax = max( ArrayMeas_Directivity_Pattern(:) );&#x000A;GraphMinLevel_dB = 10*log10( DirectivityMax ) - GraphDynamicRange;&#x000A;graph=graph_figure(&apos;UV_Plot&apos;);&#x000A;&#x000A;range=ArrayMeas_Directivity_ThetaGrid(1,end) - ArrayMeas_Directivity_ThetaGrid(1,1);&#x000A;if(range == pi)&#x000A;&#x0009;resolution=ArrayMeas_Directivity_ThetaGrid(1,2) - ArrayMeas_Directivity_ThetaGrid(1,1);&#x000A;&#x0009;endIndex = int32(floor(pi/(resolution*2) + 1));&#x000A;else&#x000A;&#x0009;[phiNum, thetaNum] = size(ArrayMeas_Directivity_ThetaGrid);&#x000A;&#x0009;endIndex = thetaNum;&#x000A;end&#x000A;&#x000A;U=sin(ArrayMeas_Directivity_ThetaGrid(:, 1:endIndex)).*cos(ArrayMeas_Directivity_PhiGrid(:, 1:endIndex));&#x000A;V=sin(ArrayMeas_Directivity_ThetaGrid(:, 1:endIndex)).*sin(ArrayMeas_Directivity_PhiGrid(:, 1:endIndex));&#x000A;graph.add_surface_data(U, V, max(10*log10(ArrayMeas_Directivity_Pattern(:, 1:endIndex)), GraphMinLevel_dB) );&#x000A;graph.set_label_x(&apos;U&apos;);&#x000A;graph.set_label_y(&apos;V&apos;);</Text>
