<Item XName="PlotTxPatterns" UserName="PlotTxPatterns" Type="Equation">
<AutoCalc><T>Bool</T><D>1</D></AutoCalc>
<Selected><T>Bool</T><D>0</D></Selected>
<Text>% If the 3D plot is no longer responding, then delete it and re-run this script&#x000D;&#x000A;&#x000D;&#x000A;using(&apos;PhasedArrayTxData&apos;);&#x000D;&#x000A;&#x000D;&#x000A;graph1=graph_figure(&apos;BeamPattern&apos;);&#x000D;&#x000A;graph1.add_spherical_data( ArrayMeas_Directivity_PhiGrid , ArrayMeas_Directivity_ThetaGrid, max(10*log10(ArrayMeas_Directivity_Pattern),-30) );&#x000D;&#x000A;&#x000D;&#x000A;graph2=graph_figure(&apos;BeamPolarization1Pattern&apos;);&#x000D;&#x000A;graph2.add_spherical_data( ArrayMeas_Directivity_PhiGrid , ArrayMeas_Directivity_ThetaGrid, max(10*log10(ArrayMeas_Polarization1_Pattern),-30) );&#x000D;&#x000A;graph2.set_title(ArrayMeas_Polarization1);&#x000D;&#x000A;&#x000D;&#x000A;graph3=graph_figure(&apos;BeamPolarization2Pattern&apos;);&#x000D;&#x000A;graph3.add_spherical_data( ArrayMeas_Directivity_PhiGrid , ArrayMeas_Directivity_ThetaGrid, max(10*log10(ArrayMeas_Polarization2_Pattern),-30) );&#x000D;&#x000A;graph3.set_title(ArrayMeas_Polarization2);&#x000D;&#x000A;&#x000D;&#x000A;patternPeakTx = max(max(ArrayMeas_Directivity_Pattern));&#x000D;&#x000A;polarization1PeakTx = max(max(ArrayMeas_Polarization1_Pattern));&#x000D;&#x000A;polarization2PeakTx = max(max(ArrayMeas_Polarization2_Pattern));&#x000D;&#x000A;&#x000D;&#x000A;if ( patternPeakTx &gt; 0 )&#x000D;&#x000A;&#x0009;patternPeakTx = 10*log10(patternPeakTx);&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;patternPeakTx = -600;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if ( polarization1PeakTx &gt; 0 )&#x000D;&#x000A;&#x0009;polarization1PeakTx = 10*log10(polarization1PeakTx);&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;polarization1PeakTx = -600;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if ( polarization2PeakTx &gt; 0 )&#x000D;&#x000A;&#x0009;polarization2PeakTx = 10*log10(polarization2PeakTx);&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;polarization2PeakTx = -600;&#x000D;&#x000A;end</Text>
