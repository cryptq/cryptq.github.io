<Item XName="PlotTxPatternsDF" UserName="PlotTxPatternsDF" Type="Equation">
<AutoCalc><T>Bool</T><D>1</D></AutoCalc>
<Selected><T>Bool</T><D>0</D></Selected>
<Text>% If the 3D plot is no longer responding, then delete it and re-run this script&#x000D;&#x000A;&#x000D;&#x000A;using(&apos;DF1_TxDesignDF_Data&apos;);&#x000D;&#x000A;&#x000D;&#x000A;calcPhi = squeeze(Phi);&#x000D;&#x000A;calcTheta = squeeze(Theta);&#x000D;&#x000A;calcGain = max(squeeze(Gain),-30);&#x000D;&#x000A;calcPolGain1 = max(squeeze(PolGain1),-30);&#x000D;&#x000A;calcPolGain2 = max(squeeze(PolGain2),-30);&#x000D;&#x000A;&#x000D;&#x000A;graph1DF=graph_figure(&apos;BeamPatternDF&apos;);&#x000D;&#x000A;graph1DF.add_spherical_data( calcPhi , calcTheta, calcGain );&#x000D;&#x000A;&#x000D;&#x000A;graph2DF=graph_figure(&apos;BeamPolarization1PatternDF&apos;);&#x000D;&#x000A;graph2DF.add_spherical_data( calcPhi , calcTheta, calcPolGain1 );&#x000D;&#x000A;graph2DF.set_title(RenderBeamWithImpairments_Polarization1);&#x000D;&#x000A;&#x000D;&#x000A;graph3DF=graph_figure(&apos;BeamPolarization2PatternDF&apos;);&#x000D;&#x000A;graph3DF.add_spherical_data( calcPhi , calcTheta, calcPolGain2 );&#x000D;&#x000A;graph3DF.set_title(RenderBeamWithImpairments_Polarization2);&#x000D;&#x000A;&#x000D;&#x000A;patternPeakTxDF = max(max(calcGain));&#x000D;&#x000A;polarization1PeakTxDF = max(max(calcPolGain1));&#x000D;&#x000A;polarization2PeakTxDF = max(max(calcPolGain2));&#x000D;&#x000A;</Text>
