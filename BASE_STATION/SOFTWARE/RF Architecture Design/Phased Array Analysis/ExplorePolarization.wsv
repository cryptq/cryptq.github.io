<Item XName="Constants" UserName="Constants" Type="Equation">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>Fsignal = 10;&#x0009;% Frequency of the CW signal in GHz&#x000D;&#x000A;Farray  = 10;   % Freq for the absolute spacing of the array elements, GHz&#x000D;&#x000A;&#x000D;&#x000A;NumAntsPerLocation = 1;&#x000D;&#x000A;NumElementsX = 8;&#x000D;&#x000A;NumElementsY = 8;&#x000D;&#x000A;NumSignalsX = NumElementsX;&#x000D;&#x000A;NumSignalsY = NumElementsY;&#x000D;&#x000A;&#x000D;&#x000A;SpeedOfLight = 299792458; % meter/sec&#x000D;&#x000A;HalfWavelength = 0.5*SpeedOfLight/(Farray * 1e9);&#x000D;&#x000A;&#x000D;&#x000A;%These eqquations are used for the RX case, which is not applicable for TX&#x000D;&#x000A;RxPwrDensity_dBm = -50;&#x0009; % dBm&#x000D;&#x000A;RxPwrIn_Watts = 10^( ( RxPwrDensity_dBm - 30 ) / 10 ) * (2*HalfWavelength)^2 / ( 4 * pi );&#x000D;&#x000A;RxPwrIn_dBm = dbm( RxPwrIn_Watts);&#x000D;&#x000A;&#x000D;&#x000A;%PhiCutAngle = 0;&#x000D;&#x000A;beamTheta = tune(10); %deg&#x000D;&#x000A;beamPhi = tune(0); %deg&#x000D;&#x000A;&#x000D;&#x000A;%&#x000D;&#x000A;EthetaMag = tune(1);&#x000D;&#x000A;EthetaPhase = tune(90);&#x000D;&#x000A;EphiMag  = tune(1);&#x000D;&#x000A;EphiPhase =tune(0);&#x000D;&#x000A;&#x000D;&#x000A;polarizationOption=tune(1); %Polarization decomposition&#x000D;&#x000A;&#x000D;&#x000A;%Etheta = EthetaReal + j*EthetaImag;&#x000D;&#x000A;%Ephi = EphiReal + j*EphiImag;&#x000D;&#x000A;&#x000D;&#x000A;Etheta = EthetaMag*exp(j*EthetaPhase*pi/180);&#x000D;&#x000A;Ephi   = EphiMag*exp(j*EphiPhase*pi/180);&#x000D;&#x000A;&#x000D;&#x000A;%Incident wave polarization specification&#x000D;&#x000A;IEthetaMag = tune(1);&#x000D;&#x000A;IEthetaPhase = tune(-90);&#x000D;&#x000A;IEphiMag = tune(1);&#x000D;&#x000A;IEphiPhase = tune(0);&#x000D;&#x000A;IEtheta = IEthetaMag*exp(j*IEthetaPhase*pi/180);&#x000D;&#x000A;IEphi = IEphiMag*exp(j*IEphiPhase*pi/180);&#x000D;&#x000A;&#x000D;&#x000A;% Dual polarization array, NumAntsPerLocation = 1&#x000D;&#x000A;%  8 x 16&#x000D;&#x000A;%  | - | - | - | - | - | - | - | -&#x000D;&#x000A;%  | - | - | - | - | - | - | - | -&#x000D;&#x000A;%  | - | - | - | - | - | - | - | -&#x000D;&#x000A;%  | - | - | - | - | - | - | - | -&#x000D;&#x000A;%  | - | - | - | - | - | - | - | -&#x000D;&#x000A;%  | - | - | - | - | - | - | - | -&#x000D;&#x000A;%  | - | - | - | - | - | - | - | -&#x000D;&#x000A;%  | - | - | - | - | - | - | - | -&#x000D;&#x000A;%NumElementsX = 16;&#x000D;&#x000A;%NumSignalsX = NumElementsX;&#x000D;&#x000A;%Etheta = [1, 0];&#x000D;&#x000A;%Ephi = [0, 1];&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;% Dual polarization array, NumAntsPerLocation = 1&#x000D;&#x000A;%  16 x 8&#x000D;&#x000A;%  | | | | | | | |&#x000D;&#x000A;%  - - - - - - - -&#x000D;&#x000A;%  | | | | | | | |&#x000D;&#x000A;%  - - - - - - - -&#x000D;&#x000A;%  | | | | | | | |&#x000D;&#x000A;%  - - - - - - - -&#x000D;&#x000A;%  | | | | | | | |&#x000D;&#x000A;%  - - - - - - - -&#x000D;&#x000A;%  | | | | | | | |&#x000D;&#x000A;%  - - - - - - - -&#x000D;&#x000A;%  | | | | | | | |&#x000D;&#x000A;%  - - - - - - - -&#x000D;&#x000A;%  | | | | | | | |&#x000D;&#x000A;%  - - - - - - - -&#x000D;&#x000A;%  | | | | | | | |&#x000D;&#x000A;%  - - - - - - - -&#x000D;&#x000A;%NumElementsY = 16;&#x000D;&#x000A;%NumSignalsY = NumElementsY;&#x000D;&#x000A;%Etheta = [1; 0];&#x000D;&#x000A;%Ephi = [0; 1];&#x000D;&#x000A;&#x000D;&#x000A;% Dual polarization array, NumAntsPerLocation = 2&#x000D;&#x000A;%  8 x 8&#x000D;&#x000A;%  + + + + + + + +&#x000D;&#x000A;%  + + + + + + + +&#x000D;&#x000A;%  + + + + + + + +&#x000D;&#x000A;%  + + + + + + + +&#x000D;&#x000A;%  + + + + + + + +&#x000D;&#x000A;%  + + + + + + + +&#x000D;&#x000A;%  + + + + + + + +&#x000D;&#x000A;%  + + + + + + + +&#x000D;&#x000A;%NumAntsPerLocation = 2&#x000D;&#x000A;%NumSignalsY = 2*NumElementsY;&#x000D;&#x000A;%Etheta = [1; 0];&#x000D;&#x000A;%Ephi = [0; 1];&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;</Text>
