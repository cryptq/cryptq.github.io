<Text>using(&apos;DesignIdealAnalysis&apos;);&#x000D;&#x000A;graph1=graph_figure(&apos;Ideal&apos;);&#x000D;&#x000A;graph1.add_spherical_data( ArrayMeas_Directivity_PhiGrid , ArrayMeas_Directivity_ThetaGrid, max(10*log10(ArrayMeas_Directivity_Pattern),-30) );&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;using(&apos;DesignQuantAnalysis&apos;);&#x000D;&#x000A;graph2=graph_figure(&apos;Quant&apos;);&#x000D;&#x000A;graph2.add_spherical_data( ArrayMeas_Directivity_PhiGrid , ArrayMeas_Directivity_ThetaGrid, max(10*log10(ArrayMeas_Directivity_Pattern),-30) );&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;using(&apos;DesignQuantSParamsAnalysis&apos;);&#x000D;&#x000A;graph3=graph_figure(&apos;QuantSParams&apos;);&#x000D;&#x000A;graph3.add_spherical_data( ArrayMeas_Directivity_PhiGrid , ArrayMeas_Directivity_ThetaGrid, max(10*log10(ArrayMeas_Directivity_Pattern),-30) );&#x000D;&#x000A;&#x000D;&#x000A;using(&apos;DesignQuantSParamsNLAnalysis&apos;);&#x000D;&#x000A;graph4=graph_figure(&apos;QuantSParamsNL&apos;);&#x000D;&#x000A;graph4.add_spherical_data( ArrayMeas_Directivity_PhiGrid , ArrayMeas_Directivity_ThetaGrid, max(10*log10(ArrayMeas_Directivity_Pattern),-30) );&#x000D;&#x000A;</Text>
