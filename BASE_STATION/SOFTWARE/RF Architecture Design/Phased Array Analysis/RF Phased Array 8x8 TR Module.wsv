<Param>WorkspaceVariables\VarBlock\beamPhi</Param></Item>
<Item XName="Tune4" Type="TuneParam">
<Param>WorkspaceVariables\VarBlock\beamTheta</Param></Item>
<Item XName="Tune5" Type="TuneParam">
<Param>WorkspaceVariables\VarBlock\NumEl</Param></Item></Item>
<Item XName="Variables" Type="SerItem" />
