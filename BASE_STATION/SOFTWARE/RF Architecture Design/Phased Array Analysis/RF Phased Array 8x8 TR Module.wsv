<Label />
<Meas>directivityCutSweep</Meas>
<MeasFormat />
<MeasGroup />
<MeasSource><T>Int</T><D>0</D></MeasSource>
<OnRight><T>Bool</T><D>0</D></OnRight>
<PPVar>directivityCutSweep</PPVar>
<PlotType />
<PosX><T>Double</T><D>0</D></PosX>
<PosY><T>Double</T><D>0</D></PosY>
<SeriesType><T>Int</T><D>7</D></SeriesType>
<SymbolShape><T>Int</T><D>2</D></SymbolShape>
<UserHide><T>Bool</T><D>0</D></UserHide>
<ZOrder><T>Int</T><D>9000</D></ZOrder>
<Item XName="Eqns" Type="Equation">
<Text>using(&apos;Sweep1_Data&apos;);&#x000D;&#x000A;% &lt;Enter your &apos;MATLAB Script&apos; equations here&gt;&#x000D;&#x000A;&#x000D;&#x000A;phi=PhiCutAngle;&#x000D;&#x000A;theta_points = [90:-1:1, 0:90]*pi/180;&#x000D;&#x000A;theta_angles = [-90:90]*pi/180;&#x000D;&#x000A;phi_points = [(phi+180)*pi/180*ones(1,90), phi*pi/180*ones(1,91)];&#x000D;&#x000A;&#x000D;&#x000A;numSweeps = length(Settings_FRxTx_Swp);&#x000D;&#x000A;dims = size(ArrayMeas_Directivity_Pattern);&#x000D;&#x000A;numRows = dims(1) / numSweeps;&#x000D;&#x000A;&#x000D;&#x000A;directivityCutSweep = [];&#x000D;&#x000A;thetaSweepIndep = [];&#x000D;&#x000A;freqSweepIndep = [];&#x000D;&#x000A;&#x000D;&#x000A;for k=1:numSweeps&#x000D;&#x000A;&#x0009;thetaGrid = double(ArrayMeas_Directivity_ThetaGrid((k-1)*numRows+1 : k*numRows,:));&#x000D;&#x000A;&#x0009;phiGrid = double(ArrayMeas_Directivity_PhiGrid((k-1)*numRows+1 : k*numRows,:));&#x000D;&#x000A;&#x0009;directivityGrid = double(ArrayMeas_Directivity_Pattern((k-1)*numRows+1 : k*numRows,:));&#x000D;&#x000A;&#x0009;phiCut=interp2(thetaGrid, phiGrid, directivityGrid, theta_points, phi_points );&#x000D;&#x000A;&#x0009;directivityCutSweep = [directivityCutSweep phiCut];&#x000D;&#x000A;&#x0009;thetaSweepIndep = [thetaSweepIndep theta_angles];&#x000D;&#x000A;&#x0009;freqSweepIndep = [freqSweepIndep ones(1,181)*Settings_FRxTx_Swp(k)]&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;setdisplayunit(directivityCutSweep,&apos;dB&apos;);&#x000D;&#x000A;setdisplayunit(thetaSweepIndep, &apos;deg&apos;);&#x000D;&#x000A;setindep(directivityCutSweep, &apos;thetaSweepIndep&apos;, &apos;freqSweepIndep&apos;);</Text>
<Item XName="BPMgr" Type="BPMgr">
<BPLines><T>Empty</T></BPLines>
