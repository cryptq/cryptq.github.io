<Creator>Settings</Creator>
<Data><T>Double</T><D>1</D></Data>
<Tunable><T>Bool</T><D>1</D></Tunable></Item>
<Item XName="FRxTx" Type="Variable">
<Creator>Settings</Creator>
<Data><T>Double</T><D>10</D></Data>
<Tunable><T>Bool</T><D>1</D></Tunable></Item>
<Item XName="FreqDependentAntEfficiency" Type="Variable">
<Creator>Settings</Creator>
