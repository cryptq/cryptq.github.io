<Item XName="Equation2" UserName="Equation2" Type="Equation">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>MeasName = cell(5, 1);&#x000D;&#x000A;%MeasName = [{&apos;DirectivityAtThetaPhi_dB&apos;};{&apos;MainLobePhi_deg&apos;};{&apos;MainLobePhiBeamwidth_deg&apos;};{&apos;MainLobeTheta_deg&apos;};{&apos;MainLobeThetaBeamwidth_deg&apos;};{&apos;SideLobeRatioToMaxLobe&apos;}];&#x000D;&#x000A;MeasName = [{&apos;DirectivityAtThetaPhi_dB&apos;};{&apos;MainLobePhi_deg&apos;};{&apos;MainLobePhiBeamwidth_deg&apos;};{&apos;MainLobeTheta_deg&apos;};{&apos;MainLobeThetaBeamwidth_deg&apos;}];&#x000D;&#x000A;&#x000D;&#x000A;using(&apos;PhasedArrayTxData&apos;);&#x000D;&#x000A;SampleMeasurements = zeros(5,1);&#x000D;&#x000A;SampleMeasurements(1) = 10*log10(ArrayMeas_DirectivityAtThetaPhi);&#x000D;&#x000A;SampleMeasurements(2) = BeamMeas_MainLobePhi * 180/pi;&#x000D;&#x000A;SampleMeasurements(3) = BeamMeas_MainLobePhiBeamwidth * 180/pi;&#x000D;&#x000A;SampleMeasurements(4) = BeamMeas_MainLobeTheta * 180/pi;&#x000D;&#x000A;SampleMeasurements(5) = BeamMeas_MainLobeThetaBeamwidth * 180/pi;&#x000D;&#x000A;&#x000D;&#x000A;using(&apos;PhasedArrayTxActiveLoading&apos;);&#x000D;&#x000A;SampleMeasurementsWithCoupling = zeros(5,1);&#x000D;&#x000A;SampleMeasurementsWithCoupling(1) = 10*log10(ArrayMeas_DirectivityAtThetaPhi);&#x000D;&#x000A;SampleMeasurementsWithCoupling(2) = BeamMeas_MainLobePhi * 180/pi;&#x000D;&#x000A;SampleMeasurementsWithCoupling(3) = BeamMeas_MainLobePhiBeamwidth * 180/pi;&#x000D;&#x000A;SampleMeasurementsWithCoupling(4) = BeamMeas_MainLobeTheta * 180/pi;&#x000D;&#x000A;SampleMeasurementsWithCoupling(5) = BeamMeas_MainLobeThetaBeamwidth * 180/pi;&#x000D;&#x000A;&#x000D;&#x000A;setindep(SampleMeasurements,&apos;MeasName&apos;);&#x000D;&#x000A;setindep(SampleMeasurementsWithCoupling,&apos;MeasName&apos;);</Text>
