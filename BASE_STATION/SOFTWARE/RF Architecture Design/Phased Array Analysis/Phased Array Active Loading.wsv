<Item XName="Equation1" UserName="Equation1" Type="Equation">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>LIGHT_SPEED = 299792458; % m/s&#x000D;&#x000A;NRows = 8;&#x000D;&#x000A;NCols = 8;&#x000D;&#x000A;Freq = 5400e6;&#x000D;&#x000A;dX = 0.5;&#x0009;% in wavelengths&#x000D;&#x000A;dY = 0.5;&#x0009;% in wavelengths&#x000D;&#x000A;&#x000D;&#x000A;dX_in_m = dX * LIGHT_SPEED / Freq;&#x000D;&#x000A;dY_in_m = dY * LIGHT_SPEED / Freq;&#x000D;&#x000A;&#x000D;&#x000A;numAnts = NRows*NCols;&#x000D;&#x000A;CouplingMx = zeros(numAnts, numAnts);&#x000D;&#x000A;&#x000D;&#x000A;dB_per_m = -200;&#x000D;&#x000A;deg_per_m = 5;&#x000D;&#x000A;&#x000D;&#x000A;for iIdx = 1:numAnts&#x000D;&#x000A;&#x0009;CouplingMx(iIdx, iIdx) = 1;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;for iIdx = 2:numAnts&#x000D;&#x000A;&#x0009;iRow = rem( (iIdx-1), NRows ) + 1;&#x000D;&#x000A;&#x0009;iCol = floor( (iIdx-1) / NRows ) + 1;&#x000D;&#x000A;&#x0009;iX = (iRow - 1) * dX_in_m;&#x000D;&#x000A;&#x0009;iY = (iCol - 1) * dY_in_m;&#x000D;&#x000A;&#x0009;for jIdx = 1:iIdx-1&#x000D;&#x000A;&#x0009;&#x0009;jRow = rem( (jIdx-1), NRows ) + 1;&#x000D;&#x000A;&#x0009;&#x0009;jCol = floor( (jIdx-1) / NRows ) + 1;&#x000D;&#x000A;&#x0009;&#x0009;jX = (jRow - 1) * dX_in_m;&#x000D;&#x000A;&#x0009;&#x0009;jY = (jCol - 1) * dY_in_m;&#x000D;&#x000A;&#x0009;&#x0009;deltaX = iX - jX;&#x000D;&#x000A;&#x0009;&#x0009;deltaY = iY - jY;&#x000D;&#x000A;&#x0009;&#x0009;dist = sqrt( deltaX * deltaX + deltaY * deltaY );&#x000D;&#x000A;&#x0009;&#x0009;CouplingMx(iIdx, jIdx) = 10^(dB_per_m * dist/10) * exp(j*deg_per_m * dist * pi/180);&#x000D;&#x000A;&#x0009;&#x0009;CouplingMx(jIdx, iIdx) = CouplingMx(iIdx, jIdx);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x000D;&#x000A;</Text>
