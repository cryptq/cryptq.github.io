<Item XName="GlobalEqns" Attrib="14" Type="Equation">
<Text>FREQ=1e6;&#x000D;&#x000A;TIME=0.0;&#x000D;&#x000A;TEMPERATURE=16.85;&#x000D;&#x000A;Start_Time=0;&#x000D;&#x000A;setdisplayunit(Start_Time, &apos;s&apos;);&#x000D;&#x000A;Stop_Time=1;&#x000D;&#x000A;setdisplayunit(Stop_Time, &apos;s&apos;);&#x000D;&#x000A;Time_Spacing=.001;&#x000D;&#x000A;setdisplayunit(Time_Spacing, &apos;s&apos;);&#x000D;&#x000A;Num_Samples=1001;&#x000D;&#x000A;Sample_Rate=1000;&#x000D;&#x000A;setdisplayunit(Sample_Rate, &apos;Hz&apos;);&#x000D;&#x000A;Freq_Resolution=1;&#x000D;&#x000A;setdisplayunit(Freq_Resolution, &apos;Hz&apos;);&#x000D;&#x000A;Data_Persistence=0;&#x000D;&#x000A;Start_Time_SC=0;&#x000D;&#x000A;setdisplayunit(Start_Time_SC, &apos;s&apos;);&#x000D;&#x000A;Stop_Time_SC=1;&#x000D;&#x000A;setdisplayunit(Stop_Time_SC, &apos;s&apos;);&#x000D;&#x000A;Num_Samples_SC=1001;&#x000D;&#x000A;</Text>
<Item XName="BPMgr" Type="BPMgr">
<BPLines><T>Empty</T></BPLines>
<BPStates><T>Empty</T></BPStates></Item>
<Item XName="EqnBlock" Type="EqnBlock">
<Lang><T>Int</T><D>1</D></Lang></Item>
<Item XName="Font" Type="Font">
<Name>Courier New</Name>
<Size><T>Double</T><D>125</D></Size></Item>
<Item XName="FunctionBlock" Type="FunctionBlock" />
<Item XName="VarBlock" Type="VarBlock" /></Item>
<Item XName="Page" Type="PageMgr" />
<Item XName="ProcessTxData" UserName="ProcessTxData" Type="Equation">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>using( &apos;PhasedArrayTx_Data&apos; );&#x000D;&#x000A;&#x000D;&#x000A;% Make the input power array the same size as the other output arrays&#x000D;&#x000A;Signal_ArrayIn_Power = ones( 64, 1) * NodeInfo_Signal_Power_01_TxIn_Output;&#x000D;&#x000A;&#x000D;&#x000A;% Build a matrix of all the power output data&#x000D;&#x000A;ArrayPowerOut = [ Signal_ArrayIn_Power; NodeInfo_Signal_Power_02_ArraySplit64_Output; NodeInfo_Signal_Power_03_PhaseShifter_Output; NodeInfo_Signal_Power_04_ArrayAttn_Output; NodeInfo_Signal_Power_05_RFAmp_RFAmpHO_Output ];&#x000D;&#x000A;&#x000D;&#x000A;% Extract the column of data for the selected element&#x000D;&#x000A;PowerOut = ArrayPowerOut(:,Element);&#x000D;&#x000A;setdisplayunit(&apos;PowerOut&apos;, &apos;dBm&apos; );&#x000D;&#x000A;&#x000D;&#x000A;% Build the path gain&#x000D;&#x000A;StageCount = 5;&#x000D;&#x000A;Gain = size(StageCount);&#x000D;&#x000A;Gain(1) = 1;&#x000D;&#x000A;&#x000D;&#x000A;for i = 2:StageCount&#x000D;&#x000A;&#x0009;Gain(i) = PowerOut(i) / PowerOut(i-1);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;Gain = Gain&apos;;&#x000D;&#x000A;&#x000D;&#x000A;setdisplayunit( &apos;Gain&apos;, &apos;dB&apos; );&#x000D;&#x000A;&#x000D;&#x000A;% Create the independent variables for the path&#x000D;&#x000A;PathIndep = cell(StageCount, 1);&#x000D;&#x000A;PathIndep = [{&apos;TxIn&apos;};{&apos;ArraySplit64&apos;};{&apos;PhaseShifter&apos;};{&apos;ArrayAttn&apos;};{&apos;RFAmp&apos;}];&#x000D;&#x000A;&#x000D;&#x000A;setindep( &apos;Gain&apos;, &apos;PathIndep&apos; );&#x000D;&#x000A;setindep( &apos;PowerOut&apos;, &apos;PathIndep&apos; );</Text>
<Item XName="BPMgr" Type="BPMgr">
<BPLines><T>Empty</T></BPLines>
<BPStates><T>Empty</T></BPStates></Item>
<Item XName="EqnBlock" Type="EqnBlock">
<Lang><T>Int</T><D>1</D></Lang>
<UsingContext>PhasedArrayTx_Data;</UsingContext></Item>
<Item XName="Font" Type="Font">
<Name>Courier New</Name>
<Size><T>Double</T><D>125</D></Size></Item>
<Item XName="FunctionBlock" Type="FunctionBlock" />
<Item XName="Page" Type="PageMgr">
<Item XName="Display0" Type="EquationDisp">
<DVport><T>Array_Dbl64</T><D>1;4;;;UG24;w224</D></DVport>
<PVPort><T>Array_Dbl64</T><D>1;4;;;bBNkRvQaC34;ALgKfIXP034</D></PVPort>
<Show><T>Bool</T><D>0</D></Show>
<ShowCmd><T>Int</T><D>1</D></ShowCmd>
<Split><T>Double</T><D>0.3</D></Split>
<Split2><T>Double</T><D>0.3</D></Split2>
<Window><T>Array_I64</T><D>1;4;J;o2;W8;OA</D></Window>
<ZOrder><T>Int</T><D>6</D></ZOrder></Item></Item>
<Item XName="VarBlock" Type="VarBlock" /></Item>
<Item XName="ReadMe" UserName="ReadMe" Type="Notes">
<Description>Example text with pretty printing</Description>
<LibName>Eagleware</LibName>
<Selected><T>Bool</T><D>0</D></Selected>
<Text>&lt;P class=MsoTitle style=&quot;BORDER-TOP: medium none; BORDER-RIGHT: medium none; BORDER-BOTTOM: windowtext 0.75pt solid; PADDING-BOTTOM: 1pt; PADDING-TOP: 0in; PADDING-LEFT: 0in; MARGIN: 0in 0in 0pt; BORDER-LEFT: medium none; PADDING-RIGHT: 0in&quot; align=center&gt;&lt;STRONG&gt;&lt;FONT size=5 face=Arial&gt;Phased Array&amp;nbsp;TX with Frequency Variation&amp;nbsp;&lt;/FONT&gt;&lt;/STRONG&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: center; MARGIN: 0in 0in 0pt&quot; align=center&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: Arial; mso-bidi-font-size: 12.0pt&quot;&gt;Keysight Technologies SystemVue Example Workspace&lt;/SPAN&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; mso-bidi-font-size: 12.0pt&quot;&gt;&lt;?xml:namespace prefix = &quot;o&quot; ns = &quot;urn:schemas-microsoft-com:office:office&quot; /&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: center; MARGIN: 0in 0in 0pt&quot; align=center&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; mso-bidi-font-size: 12.0pt&quot;&gt;&amp;nbsp;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoBodyText style=&quot;MARGIN: 0in 0in 0pt&quot;&gt;&lt;FONT size=2&gt;This workspace adds a bandpass filter to the phased array TX chain, in order to demonstrate how RFLINK renders Spectrasys array designs with frequency response.&lt;/FONT&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoBodyText style=&quot;MARGIN: 0in 0in 0pt&quot;&gt;&lt;FONT size=2&gt;&lt;/FONT&gt;&amp;nbsp;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoBodyText style=&quot;MARGIN: 0in 0in 0pt&quot;&gt;&lt;FONT size=2&gt;Please note that due to the large amount of data produced by the simulations the workspace has been saved without some of the simulation datasets&amp;nbsp;so som graphs may show no results.&lt;/FONT&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoBodyText style=&quot;MARGIN: 0in 0in 0pt&quot;&gt;&lt;FONT size=2&gt;&lt;/FONT&gt;&lt;FONT size=2&gt;&lt;/FONT&gt;&amp;nbsp;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoBodyText style=&quot;MARGIN: 0in 0in 0pt&quot;&gt;&lt;FONT size=2&gt;&lt;STRONG&gt;About this workspace:&lt;/STRONG&gt;&lt;/FONT&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoBodyText style=&quot;MARGIN: 0in 0in 0pt&quot;&gt;&lt;FONT size=2&gt;&lt;/FONT&gt;&amp;nbsp;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoBodyText style=&quot;MARGIN: 0in 0in 0pt&quot;&gt;&lt;FONT size=2&gt;In&amp;nbsp;Folder #1,&amp;nbsp;the RF TX array is designed using the Phased Array analysis.&amp;nbsp; (You may need to right-click on the &quot;PlotPattern&quot; to update the 3D plot)&lt;/FONT&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoBodyText style=&quot;MARGIN: 0in 0in 0pt&quot;&gt;&lt;FONT size=2&gt;&lt;/FONT&gt;&amp;nbsp;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoBodyText style=&quot;MARGIN: 0in 0in 0pt&quot;&gt;&lt;FONT size=2&gt;In Folder #2 and 3, the RF array is brought to the dataflow level using RFLINK, and evaluated two different ways in the dataflow simulator.&lt;/FONT&gt;&lt;/P&gt;&lt;FONT size=2&gt;&lt;/FONT&gt;&lt;FONT size=2 face=Arial&gt;&#x000D;&#x000A;&lt;UL&gt;&#x000D;&#x000A;&lt;LI&gt;&#x000D;&#x000A;&lt;DIV class=MsoBodyText style=&quot;MARGIN: 0in 0in 0pt&quot;&gt;FOLDER #2 - A CW tone is swept in Dataflow, and the frequency response is plotted from one of the 64 array outputs.&amp;nbsp; Simple, but&amp;nbsp;plotting swept data&amp;nbsp;can involve more post-processing.&lt;/FONT&gt;&lt;/DIV&gt;&lt;/LI&gt;&#x000D;&#x000A;&lt;LI&gt;&#x000D;&#x000A;&lt;DIV class=MsoBodyText style=&quot;MARGIN: 0in 0in 0pt&quot;&gt;&lt;FONT size=2 face=Arial&gt;FOLDER #3 - An &quot;Envelope Impulse&quot; pings the RFLINK network, and the spectrum analyzer at the output&amp;nbsp;displays the magnitude of the Impulse Response.&amp;nbsp; Single analysis (not swept).&amp;nbsp; Arguably easier to plot.&lt;/FONT&gt;&lt;/DIV&gt;&lt;/LI&gt;&lt;/UL&gt;&#x000D;&#x000A;&lt;P class=MsoBodyText style=&quot;MARGIN: 0in 0in 0pt&quot;&gt;&lt;FONT size=2&gt;&lt;STRONG&gt;Additional Notes&lt;/STRONG&gt;&lt;/FONT&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;OL&gt;&#x000D;&#x000A;&lt;LI&gt;&#x000D;&#x000A;&lt;DIV class=MsoBodyText style=&quot;MARGIN: 0in 0in 0pt&quot;&gt;&lt;FONT size=2 face=Arial&gt;Frequency response method #2 assumes that original input spectrum is flat (perfect impulse) across the bandwidth.&amp;nbsp; In a real measurement you would need to ratio the input and output&amp;nbsp;spectrums to infer the&amp;nbsp;frequency response.&amp;nbsp; Or, use a network analyzer.&amp;nbsp; Flatness calibrations are common for wideband AWG and up/downconverters.&lt;/FONT&gt;&lt;/DIV&gt;&lt;/LI&gt;&#x000D;&#x000A;&lt;LI&gt;&#x000D;&#x000A;&lt;DIV class=MsoBodyText style=&quot;MARGIN: 0in 0in 0pt&quot;&gt;&lt;FONT size=2 face=Arial&gt;Since there are no statistical variations between the array elements, all 64 array paths are going to be similar, except for the windowing and phase shift between elements.&amp;nbsp; (The active beamforming components, such as the windowing and gain/phase states, are not frequency-dependent.&amp;nbsp; If you want to reflect additional sources of ripple/response, you need to explicitly add .s2p data files or other components to the TX path to see these imperfections.)&amp;nbsp; &lt;/FONT&gt;&lt;/DIV&gt;&lt;/LI&gt;&lt;/OL&gt;&#x000D;&#x000A;&lt;P class=MsoBodyText style=&quot;MARGIN: 0in 0in 0pt&quot;&gt;&lt;FONT size=2&gt;&lt;/FONT&gt;&amp;nbsp;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoBodyText style=&quot;MARGIN: 0in 0in 0pt&quot;&gt;&lt;FONT size=2&gt;&lt;/FONT&gt;&amp;nbsp;&lt;/P&gt;</Text>
<Item XName="Page" Type="PageMgr">
<Item XName="Display0" Type="NotesDisp">
<DVport><T>Array_Dbl64</T><D>1;4;;;Rt14;a14</D></DVport>
<PVPort><T>Array_Dbl64</T><D>1;4;;;X25AKea7l24;dvTctPUZQ24</D></PVPort>
<Show><T>Bool</T><D>1</D></Show>
<ShowCmd><T>Int</T><D>1</D></ShowCmd>
<Window><T>Array_I64</T><D>1;4;;;B6;B3</D></Window>
<ZOrder><T>Int</T><D>1</D></ZOrder></Item></Item></Item>
<Item XName="SetupTx" UserName="SetupTx" Type="Equation">
<Selected><T>Bool</T><D>1</D></Selected>
<Text>Pin = tune(-20); &#x0009;% dBm&#x000D;&#x000A;Fin = tune(1000); &#x0009;% MHz&#x000D;&#x000A;Element = tune(1);&#x0009;% Element to pick&#x000D;&#x000A;&#x000D;&#x000A;SpeedOfLight = 299792458; % m / s&#x000D;&#x000A;ElemDistance = SpeedOfLight/(1000*1e6)/2; % m&#x000D;&#x000A;&#x000D;&#x000A;Fcenter = 1000;&#x0009;&#x0009;% Filter Center Frequency&#x000D;&#x000A;Flo = Fcenter - 2;&#x000D;&#x000A;Fhi = Fcenter + 2;</Text>
<Item XName="BPMgr" Type="BPMgr">
<BPLines><T>Empty</T></BPLines>
<BPStates><T>Empty</T></BPStates></Item>
<Item XName="EqnBlock" Type="EqnBlock">
<Lang><T>Int</T><D>1</D></Lang></Item>
<Item XName="Font" Type="Font">
<Name>Courier New</Name>
<Size><T>Double</T><D>125</D></Size></Item>
<Item XName="FunctionBlock" Type="FunctionBlock" />
<Item XName="Page" Type="PageMgr">
<Item XName="Display0" Type="EquationDisp">
<DVport><T>Array_Dbl64</T><D>1;4;;;m024;yo14</D></DVport>
<PVPort><T>Array_Dbl64</T><D>1;4;;;}Hv7bVC4z24;oa9JcCaSm24</D></PVPort>
<Show><T>Bool</T><D>0</D></Show>
<ShowCmd><T>Int</T><D>1</D></ShowCmd>
<Split><T>Double</T><D>0.3</D></Split>
<Split2><T>Double</T><D>0.3</D></Split2>
<Window><T>Array_I64</T><D>1;4;B6;n6;PC;qA</D></Window>
<ZOrder><T>Int</T><D>6</D></ZOrder></Item></Item>
<Item XName="VarBlock" Type="VarBlock" /></Item>
<Item XName="TuneList" Type="TuneList">
<Item XName="Tune0" Type="TuneParam">
<Param>WorkspaceVariables\VarBlock\Element</Param></Item>
<Item XName="Tune1" Type="TuneParam">
<Param>WorkspaceVariables\VarBlock\Fin</Param></Item>
<Item XName="Tune2" Type="TuneParam">
<Param>WorkspaceVariables\VarBlock\Pin</Param></Item></Item>
<Item XName="Variables" Type="SerItem" />
<Item XName="WorkspaceVariables" Attrib="14" Type="Equation">
<AutoCalc><T>Bool</T><D>0</D></AutoCalc>
<Selected><T>Bool</T><D>0</D></Selected>
<UnitUse><T>Int</T><D>2</D></UnitUse>
<Item XName="BPMgr" Type="BPMgr">
<BPLines><T>Empty</T></BPLines>
<BPStates><T>Empty</T></BPStates></Item>
<Item XName="EqnBlock" Type="EqnBlock">
<Lang><T>Int</T><D>1</D></Lang></Item>
<Item XName="Font" Type="Font">
<Name>Courier New</Name>
<Size><T>Double</T><D>125</D></Size></Item>
<Item XName="FunctionBlock" Type="FunctionBlock" />
<Item XName="VarBlock" Type="VarBlock">
<Item XName="ElemDistance" Type="Variable">
<Creator>SetupTx</Creator>
<Data><T>Double</T><D>0.149896229</D></Data></Item>
<Item XName="Element" Type="Variable">
<Creator>SetupTx</Creator>
<Data><T>Double</T><D>1</D></Data>
<Tunable><T>Bool</T><D>1</D></Tunable></Item>
<Item XName="Fcenter" Type="Variable">
<Creator>SetupTx</Creator>
<Data><T>Double</T><D>1000</D></Data></Item>
<Item XName="Fhi" Type="Variable">
<Creator>SetupTx</Creator>
<Data><T>Double</T><D>1002</D></Data></Item>
<Item XName="Fin" Type="Variable">
<Creator>SetupTx</Creator>
<Data><T>Double</T><D>1000</D></Data>
<Tunable><T>Bool</T><D>1</D></Tunable></Item>
<Item XName="Flo" Type="Variable">
<Creator>SetupTx</Creator>
<Data><T>Double</T><D>998</D></Data></Item>
<Item XName="Pin" Type="Variable">
<Creator>SetupTx</Creator>
<Data><T>Double</T><D>-20</D></Data>
<Tunable><T>Bool</T><D>1</D></Tunable></Item>
<Item XName="SpeedOfLight" Type="Variable">
<Creator>SetupTx</Creator>
<Data><T>Double</T><D>299792458</D></Data></Item></Item></Item></Item>
