<Item XName="PhasedArray1" UserName="PhasedArray1" Type="PhasedArrayAnalysis">
<Approximation><T>Bool</T><D>0</D></Approximation>
<ArrayMeasurement><T>Bool</T><D>1</D></ArrayMeasurement>
<AutoRecalc><T>Bool</T><D>0</D></AutoRecalc>
<BeamMeasurement><T>Bool</T><D>1</D></BeamMeasurement>
<CalcIntermodsAndHarmonics><T>Bool</T><D>1</D></CalcIntermodsAndHarmonics>
<CalcMaxTxRadiationIntensity><T>Bool</T><D>1</D></CalcMaxTxRadiationIntensity>
<CalcOddIntermodOrdersOnly><T>Bool</T><D>0</D></CalcOddIntermodOrdersOnly>
<EnableFreqSweep><T>Bool</T><D>0</D></EnableFreqSweep>
<MainLobeDirection><T>Bool</T><D>0</D></MainLobeDirection>
<MergeRFParts><T>Bool</T><D>1</D></MergeRFParts>
<NeedRun><T>Bool</T><D>0</D></NeedRun>
<PathMeasurement><T>Bool</T><D>1</D></PathMeasurement>
<PhasedArrayAnalysisRepeatableRandomSequences><T>Bool</T><D>0</D></PhasedArrayAnalysisRepeatableRandomSequences>
<PhiCut><T>Bool</T><D>0</D></PhiCut>
