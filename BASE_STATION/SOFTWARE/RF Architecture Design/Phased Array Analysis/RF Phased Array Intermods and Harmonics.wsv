<Text>% If the 3D plot is no longer responding, then delete it and &#x000D;&#x000A;% re-run this script&#x000D;&#x000A;%&#x000D;&#x000A;using(&apos;PhasedArray1_TxDesign_Data&apos;);&#x000D;&#x000A;%&#x000D;&#x000A;graph1=graph_figure(&apos;ArrayMeas_Directivity_Pattern&apos;);&#x000D;&#x000A;graph1.add_spherical_data( ArrayMeas_Directivity_PhiGrid , ArrayMeas_Directivity_ThetaGrid, max(10*log10(ArrayMeas_Directivity_Pattern),-30) );&#x000D;&#x000A;&#x000D;&#x000A;graph2=graph_figure(&apos;EIRP_Pattern_1e10Hz&apos;);&#x000D;&#x000A;graph2.add_spherical_data( Spectrum_EIRP_PhiGrid , Spectrum_EIRP_ThetaGrid, max(10*log10(Spectrum_EIRP_Pattern_1e10Hz)+30,0) );&#x000D;&#x000A;&#x000D;&#x000A;graph3=graph_figure(&apos;EIRP_Pattern_1p1e10Hz&apos;);&#x000D;&#x000A;graph3.add_spherical_data( Spectrum_EIRP_PhiGrid ,Spectrum_EIRP_ThetaGrid, max(10*log10(Spectrum_EIRP_Pattern_1p1e10Hz)+30,0) );&#x000D;&#x000A;&#x000D;&#x000A;graph4=graph_figure(&apos;EIRP_Pattern_1p2e10Hz&apos;);&#x000D;&#x000A;graph4.add_spherical_data( Spectrum_EIRP_PhiGrid , Spectrum_EIRP_ThetaGrid, max(10*log10(Spectrum_EIRP_Pattern_1p2e10Hz)+30,-30) );&#x000D;&#x000A;&#x000D;&#x000A;graph5=graph_figure(&apos;EIRP_Pattern_9e09Hz&apos;);&#x000D;&#x000A;graph5.add_spherical_data( Spectrum_EIRP_PhiGrid , Spectrum_EIRP_ThetaGrid, max(10*log10(Spectrum_EIRP_Pattern_9e09Hz)+30,-30) );&#x000D;&#x000A;&#x000D;&#x000A;graph6=graph_figure(&apos;EIRP_Pattern_1e09Hz&apos;);&#x000D;&#x000A;graph6.add_spherical_data( Spectrum_EIRP_PhiGrid , Spectrum_EIRP_ThetaGrid, max(10*log10(Spectrum_EIRP_Pattern_1e09Hz)+30,-30) );&#x000D;&#x000A;&#x000D;&#x000A;graph7=graph_figure(&apos;EIRP_Pattern_2e10Hz&apos;);&#x000D;&#x000A;graph7.add_spherical_data( Spectrum_EIRP_PhiGrid , Spectrum_EIRP_ThetaGrid, max(10*log10(Spectrum_EIRP_Pattern_2e10Hz)+30,-30) );&#x000D;&#x000A;&#x000D;&#x000A;graph8=graph_figure(&apos;EIRP_Pattern_2p1e10Hz&apos;);&#x000D;&#x000A;graph8.add_spherical_data( Spectrum_EIRP_PhiGrid , Spectrum_EIRP_ThetaGrid, max(10*log10(Spectrum_EIRP_Pattern_2p1e10Hz)+30,-30) );&#x000D;&#x000A;&#x000D;&#x000A;graph9=graph_figure(&apos;EIRP_Pattern_2p2e10Hz&apos;);&#x000D;&#x000A;graph9.add_spherical_data( Spectrum_EIRP_PhiGrid , Spectrum_EIRP_ThetaGrid, max(10*log10(Spectrum_EIRP_Pattern_2p2e10Hz)+30,-30) );&#x000D;&#x000A;</Text>
