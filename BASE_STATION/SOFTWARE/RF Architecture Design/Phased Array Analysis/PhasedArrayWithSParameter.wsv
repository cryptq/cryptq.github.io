<Text>using(&apos;SparamPhaseShifterRefData&apos;)&#x000D;&#x000A;txBeamRef = graph_figure(&apos;Tx Beam Ref&apos;);&#x000D;&#x000A;txBeamRef.add_spherical_data(ArrayMeas_Directivity_PhiGrid, ArrayMeas_Directivity_ThetaGrid, max(10*log10(ArrayMeas_Directivity_Pattern), -30));&#x000D;&#x000A;&#x000D;&#x000A;using(&apos;SparamPhaseShifterData&apos;)&#x000D;&#x000A;txBeam = graph_figure(&apos;Tx Beam&apos;);&#x000D;&#x000A;txBeam.add_spherical_data(ArrayMeas_Directivity_PhiGrid, ArrayMeas_Directivity_ThetaGrid, max(10*log10(ArrayMeas_Directivity_Pattern), -30));&#x000D;&#x000A;</Text>
