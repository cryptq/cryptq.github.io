<Item XName="TxConfigure" UserName="TxConfigure" Type="Equation">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>thetas = [20 20 20 50 70] % deg&#x000D;&#x000A;phis = [30 60 90 90 120]; % deg&#x000D;&#x000A;antDist_meter = 3.0*10^8/15e9/2; % Use 15GHz for antenna element distance&#x000D;&#x000A;&#x000D;&#x000A;Fc_GHz = tune(10); &#x000D;&#x000A;pick = tune(1);&#x000D;&#x000A;theta = thetas(pick);&#x000D;&#x000A;phi = phis(pick);&#x000D;&#x000A;&#x000D;&#x000A;PhaseShift4x4At10GHz_2030 = [&#x0009;&#x000D;&#x000A;0&#x0009;&#x000D;&#x000A;-20.54&#x0009;&#x000D;&#x000A;-41.07&#x0009;&#x000D;&#x000A;-61.61&#x0009;&#x000D;&#x000A;-35.57&#x0009;&#x000D;&#x000A;-56.1&#x0009;&#x000D;&#x000A;-76.64&#x0009;&#x000D;&#x000A;-97.17&#x0009;&#x000D;&#x000A;-71.14&#x0009;&#x000D;&#x000A;-91.67&#x0009;&#x000D;&#x000A;-112.21&#x0009;&#x000D;&#x000A;-132.74&#x0009;&#x000D;&#x000A;-106.71&#x0009;&#x000D;&#x000A;-127.24&#x0009;&#x000D;&#x000A;-147.78&#x0009;&#x000D;&#x000A;-168.31&#x0009;&#x000D;&#x000A;];&#x000D;&#x000A;&#x000D;&#x000A;PhaseShift4x4At10GHz_2060 = [&#x0009;&#x000D;&#x000A;0&#x0009;&#x000D;&#x000A;-35.57&#x0009;&#x000D;&#x000A;-71.14&#x0009;&#x000D;&#x000A;-106.71&#x0009;&#x000D;&#x000A;-20.54&#x0009;&#x000D;&#x000A;-56.1&#x0009;&#x000D;&#x000A;-91.67&#x0009;&#x000D;&#x000A;-127.24&#x0009;&#x000D;&#x000A;-41.07&#x0009;&#x000D;&#x000A;-76.64&#x0009;&#x000D;&#x000A;-112.21&#x0009;&#x000D;&#x000A;-147.78&#x0009;&#x000D;&#x000A;-61.61&#x0009;&#x000D;&#x000A;-97.17&#x0009;&#x000D;&#x000A;-132.74&#x0009;&#x000D;&#x000A;-168.31&#x0009;&#x000D;&#x000A;];&#x000D;&#x000A;&#x000D;&#x000A;PhaseShift4x4At10GHz_2090 = [&#x0009;&#x000D;&#x000A;0&#x0009;&#x000D;&#x000A;-41.07&#x0009;&#x000D;&#x000A;-82.14&#x0009;&#x000D;&#x000A;-123.21&#x0009;&#x000D;&#x000A;-2.51e-15&#x0009;&#x000D;&#x000A;-41.07&#x0009;&#x000D;&#x000A;-82.14&#x0009;&#x000D;&#x000A;-123.21&#x0009;&#x000D;&#x000A;-5.03e-15&#x0009;&#x000D;&#x000A;-41.07&#x0009;&#x000D;&#x000A;-82.14&#x0009;&#x000D;&#x000A;-123.21&#x0009;&#x000D;&#x000A;-7.54e-15&#x0009;&#x000D;&#x000A;-41.07&#x0009;&#x000D;&#x000A;-82.14&#x0009;&#x000D;&#x000A;-123.21&#x0009;&#x000D;&#x000A;];&#x000D;&#x000A;&#x000D;&#x000A;PhaseShift4x4At10GHz_5090 = [&#x0009;&#x000D;&#x000A;0&#x0009;&#x000D;&#x000A;-91.99&#x0009;&#x000D;&#x000A;-183.98&#x0009;&#x000D;&#x000A;-275.97&#x0009;&#x000D;&#x000A;-5.63e-15&#x0009;&#x000D;&#x000A;-91.99&#x0009;&#x000D;&#x000A;-183.98&#x0009;&#x000D;&#x000A;-275.97&#x0009;&#x000D;&#x000A;-11.3e-15&#x0009;&#x000D;&#x000A;-91.99&#x0009;&#x000D;&#x000A;-183.98&#x0009;&#x000D;&#x000A;-275.97&#x0009;&#x000D;&#x000A;-16.9e-15&#x0009;&#x000D;&#x000A;-91.99&#x0009;&#x000D;&#x000A;-183.98&#x0009;&#x000D;&#x000A;-275.97&#x0009;&#x000D;&#x000A;];&#x000D;&#x000A;&#x000D;&#x000A;PhaseShift4x4At10GHz_70120 = [&#x0009;&#x000D;&#x000A;0&#x0009;&#x000D;&#x000A;-97.72&#x0009;&#x000D;&#x000A;-195.45&#x0009;&#x000D;&#x000A;-293.17&#x0009;&#x000D;&#x000A;56.42&#x0009;&#x000D;&#x000A;-41.3&#x0009;&#x000D;&#x000A;-139.03&#x0009;&#x000D;&#x000A;-236.75&#x0009;&#x000D;&#x000A;112.84&#x0009;&#x000D;&#x000A;15.12&#x0009;&#x000D;&#x000A;-82.61&#x0009;&#x000D;&#x000A;-180.33&#x0009;&#x000D;&#x000A;169.26&#x0009;&#x000D;&#x000A;71.54&#x0009;&#x000D;&#x000A;-26.18&#x0009;&#x000D;&#x000A;-123.91&#x0009;&#x000D;&#x000A;];&#x000D;&#x000A;&#x000D;&#x000A;PhaseShiftsChoices = [PhaseShift4x4At10GHz_2030&apos;; PhaseShift4x4At10GHz_2060&apos;; PhaseShift4x4At10GHz_2090&apos;; PhaseShift4x4At10GHz_5090&apos;; PhaseShift4x4At10GHz_70120&apos;];&#x000D;&#x000A;PhaseShifts = PhaseShiftsChoices(pick, :);&#x000D;&#x000A;clear PhaseShift4x4At10GHz_2030 PhaseShift4x4At10GHz_2060 PhaseShift4x4At10GHz_2090 PhaseShift4x4At10GHz_5090 PhaseShift4x4At10GHz_70120&#x000D;&#x000A;clear PhaseShiftsChoices thetas phis&#x000D;&#x000A;</Text>
