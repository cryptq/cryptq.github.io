<Item XName="PlotRxPatterns" UserName="PlotRxPatterns" Type="Equation">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>using(&apos;SParam16to1CombinerRefData&apos;);&#x000D;&#x000A;&#x000D;&#x000A;rxBeamRef=graph_figure(&apos;Rx Beam Ref&apos;);&#x000D;&#x000A;rxBeamRef.add_spherical_data( ArrayMeas_Directivity_PhiGrid , ArrayMeas_Directivity_ThetaGrid, max(10*log10(ArrayMeas_Directivity_Pattern),-30) );&#x000D;&#x000A;&#x000D;&#x000A;using(&apos;SParam16to1CombinerData&apos;);&#x000D;&#x000A;&#x000D;&#x000A;rxBeam=graph_figure(&apos;Rx Beam&apos;);&#x000D;&#x000A;rxBeam.add_spherical_data( ArrayMeas_Directivity_PhiGrid , ArrayMeas_Directivity_ThetaGrid, max(10*log10(ArrayMeas_Directivity_Pattern),-30) );&#x000D;&#x000A;&#x000D;&#x000A;</Text>
