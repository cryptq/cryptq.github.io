<Description>Distance unit</Description>
<Enum>DistanceUnit</Enum>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="DistanceX" Type="PartParam">
<DataEntry>Lambda_m/2</DataEntry>
<Description>Distance between antenna elements on X axis</Description>
<HideCondition>~(Configuration == 2 | Configuration == 4 | Configuration == 5) | (DistanceUnit &gt; 0)</HideCondition>
<Unit><T>Int</T><D>6004</D></Unit>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="DistanceX_in_Wavelengths" Type="PartParam">
<DataEntry>0.5</DataEntry>
<Description>Distance between antenna elements on X axis in wavelengths</Description>
<HideCondition>~(Configuration == 2 | Configuration == 4 | Configuration == 5) | (DistanceUnit &lt; 1)</HideCondition>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="DistanceY" Type="PartParam">
<DataEntry>Lambda_m/2</DataEntry>
<Description>Distance between antenna elements on Y axis</Description>
<HideCondition>~(Configuration == 1 | Configuration == 2 | Configuration == 4 | Configuration == 5) | (DistanceUnit &gt; 0)</HideCondition>
<Unit><T>Int</T><D>6004</D></Unit>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="DistanceY_in_Wavelengths" Type="PartParam">
<DataEntry>0.5</DataEntry>
<Description>Distance between antenna elements on Y axis in wavelengths</Description>
<HideCondition>~(Configuration == 1 | Configuration == 2 | Configuration == 4 | Configuration == 5 ) | (DistanceUnit &lt; 1)</HideCondition>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="ElementFailure" Type="PartParam">
<DataEntry>0</DataEntry>
<Default><T>Bool</T><D>1</D></Default>
<Description>Element failure</Description>
<Enum>ElementFailure</Enum>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="ElementPatternFileMap" Type="PartParam">
<DataEntry>[1]</DataEntry>
<Default><T>Bool</T><D>1</D></Default>
<Description>Element pattern file mapping matrix</Description>
<HideCondition>(ElementPatternType &lt; 3) | (ElementPatternType &gt; 3) | (ElementPatternFileMapOption &lt; 2)</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="ElementPatternFileMapOption" Type="PartParam">
<DataEntry>1</DataEntry>
<Default><T>Bool</T><D>1</D></Default>
<Description>Element pattern file to antenna mapping</Description>
<Enum>ElementPatternFileMappingType</Enum>
<HideCondition>(ElementPatternType &lt; 3) | (ElementPatternType &gt; 3)</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="ElementPatternFileName" Type="PartParam">
<DataEntry />
<Default><T>Bool</T><D>1</D></Default>
<Description>Antenna Pattern Filename (if there are multiple files, select the first one)</Description>
<HideCondition>(ElementPatternType &lt; 3) | (ElementPatternType &gt; 3)</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>10</D></Validate></Item>
<Item XName="ElementPatternFileType" Type="PartParam">
<DataEntry>0</DataEntry>
<Default><T>Bool</T><D>1</D></Default>
<Description>Antenna pattern file format (EMPro or HFSS)</Description>
<Enum>ElementPatternFileType</Enum>
<HideCondition>(ElementPatternType &lt; 3) | (ElementPatternType &gt; 3)</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="ElementPatternType" Type="PartParam">
<DataEntry>0</DataEntry>
<Default><T>Bool</T><D>1</D></Default>
<Description>Antenna Element Radiation Pattern</Description>
<Enum>ElementPatternType</Enum>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="ElementRotationAroundX" Type="PartParam">
<DataEntry>[0]</DataEntry>
<Default><T>Bool</T><D>1</D></Default>
<Description>Rotation angle around x&apos;&apos; axis after the second rotation (also known as Roll or Slant angle), observed from positive x&apos;&apos;, measured from positive y&apos;&apos; axis counterclockwise</Description>
<HideCondition>(ElementPatternType &lt; 2) | (ElementPatternType &gt; 3) | (RotateElement &lt; 1)</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Unit><T>Int</T><D>40769</D></Unit>
<Validate><T>Int</T><D>14</D></Validate></Item>
<Item XName="ElementRotationAroundY" Type="PartParam">
<DataEntry>[0]</DataEntry>
<Default><T>Bool</T><D>1</D></Default>
<Description>Rotation angle around y&apos; axis after the first rotation (also known as Pitch or Downtilt angle), observed from positive y&apos;, measured from positive z(z&apos;) axis counterclockwise</Description>
<HideCondition>(ElementPatternType &lt; 2) | (ElementPatternType &gt; 3) | (RotateElement &lt; 1)</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Unit><T>Int</T><D>40769</D></Unit>
<Validate><T>Int</T><D>14</D></Validate></Item>
<Item XName="ElementRotationAroundZ" Type="PartParam">
<DataEntry>[0]</DataEntry>
<Default><T>Bool</T><D>1</D></Default>
<Description>Rotation angle around z axis (also known as Yaw or Bearing angle), observed from positive z, measured from positive x axis counterclockwise</Description>
<HideCondition>(ElementPatternType &lt; 2) | (ElementPatternType &gt; 3) | (RotateElement &lt; 1)</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Unit><T>Int</T><D>40769</D></Unit>
<Validate><T>Int</T><D>14</D></Validate></Item>
<Item XName="Ephi" Type="PartParam">
<DataEntry>[0]</DataEntry>
<Default><T>Bool</T><D>1</D></Default>
<Description>Phi component of the E-field</Description>
<HideCondition>(ElementPatternType &gt; 2)</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>15</D></Validate></Item>
<Item XName="Etheta" Type="PartParam">
<DataEntry>[1]</DataEntry>
<Default><T>Bool</T><D>1</D></Default>
<Description>Theta component of the E-field</Description>
<HideCondition>(ElementPatternType &gt; 2)</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>15</D></Validate></Item>
<Item XName="FileName" Type="PartParam">
<DataEntry />
<Default><T>Bool</T><D>1</D></Default>
<Description>S-Parameter filename</Description>
<HideCondition>(ActiveLoading &lt; 2) | (ActiveLoading &gt; 2)</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>10</D></Validate></Item>
<Item XName="Freq" Type="PartParam">
<DataEntry>1000</DataEntry>
<Description>Frequency</Description>
<HideCondition>(RxTx == 2)</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Unit><T>Int</T><D>1003</D></Unit>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="IncidentEphi" Type="PartParam">
<DataEntry>0</DataEntry>
<Default><T>Bool</T><D>1</D></Default>
<Description>Phi component of the E-field of the incoming wave</Description>
<HideCondition>(RxTx == 2) | (PolarizationMismatch == 0)</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>12</D></Validate></Item>
<Item XName="IncidentEtheta" Type="PartParam">
<DataEntry>1</DataEntry>
<Default><T>Bool</T><D>1</D></Default>
<Description>Theta component of the E-field of the incoming wave</Description>
<HideCondition>(RxTx == 2) | (PolarizationMismatch == 0)</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>12</D></Validate></Item>
<Item XName="InitialAngles" Type="PartParam">
<DataEntry>[0, 0, 0, 0]</DataEntry>
<Description>Initial angles of each circle</Description>
<HideCondition>(Configuration &lt; 3) | (Configuration &gt; 3)</HideCondition>
<Unit><T>Int</T><D>8001</D></Unit>
<Validate><T>Int</T><D>14</D></Validate></Item>
<Item XName="LocationX" Type="PartParam">
<DataEntry>[0, 0, 0, 0, 0, 0, 0, 0]</DataEntry>
<Description>X coordinate of antenna elements</Description>
<HideCondition>(Configuration &gt; 0) | (DistanceUnit &gt; 0)</HideCondition>
<Unit><T>Int</T><D>6004</D></Unit>
<Validate><T>Int</T><D>14</D></Validate></Item>
<Item XName="LocationX_in_Wavelengths" Type="PartParam">
<DataEntry>[0, 0, 0, 0, 0, 0, 0, 0]</DataEntry>
<Description>X coordinate of antenna elements in wavelengths</Description>
<HideCondition>Configuration &gt; 0 | (DistanceUnit &lt; 1)</HideCondition>
<Validate><T>Int</T><D>14</D></Validate></Item>
<Item XName="LocationY" Type="PartParam">
<DataEntry>[0, 0.5, 1, 1.5, 2, 2.5, 3, 3.5]</DataEntry>
<Description>Y coordinate of antenna elements</Description>
<HideCondition>(Configuration &gt; 0) | (DistanceUnit &gt; 0)</HideCondition>
<Unit><T>Int</T><D>6004</D></Unit>
<Validate><T>Int</T><D>14</D></Validate></Item>
<Item XName="LocationY_in_Wavelengths" Type="PartParam">
<DataEntry>[0, 0.5, 1, 1.5, 2, 2.5, 3, 3.5]</DataEntry>
<Description>Y coordinate of antenna elements in wavelengths</Description>
<HideCondition>Configuration &gt; 0 | (DistanceUnit &lt; 1)</HideCondition>
<Validate><T>Int</T><D>14</D></Validate></Item>
<Item XName="LocationZ" Type="PartParam">
<DataEntry>[0, 0, 0, 0, 0, 0, 0, 0]</DataEntry>
<Description>Z coordinate of antenna elements</Description>
<HideCondition>(Configuration &gt; 0) | (DistanceUnit &gt; 0)</HideCondition>
<Unit><T>Int</T><D>6004</D></Unit>
<Validate><T>Int</T><D>14</D></Validate></Item>
<Item XName="LocationZ_in_Wavelengths" Type="PartParam">
<DataEntry>[0, 0, 0, 0, 0, 0, 0, 0]</DataEntry>
<Description>Z coordinate of antenna elements in wavelengths</Description>
<HideCondition>Configuration &gt; 0 | (DistanceUnit &lt; 1)</HideCondition>
<Validate><T>Int</T><D>14</D></Validate></Item>
<Item XName="NumAntennasPerLocation" Type="PartParam">
<DataEntry>1</DataEntry>
<Default><T>Bool</T><D>1</D></Default>
<Description>Number of antenna elements at the same location (for dual polarization modeling)</Description>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>3</D></Validate></Item>
<Item XName="NumElements" Type="PartParam">
<DataEntry>[1, 4, 8, 16]</DataEntry>
<Default><T>Bool</T><D>1</D></Default>
<Description>Number of elements in each circle</Description>
<HideCondition>(Configuration &lt; 3) | (Configuration &gt; 3)</HideCondition>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="NumElementsBottomRow" Type="PartParam">
<DataEntry>5</DataEntry>
<Default><T>Bool</T><D>1</D></Default>
<Description>Number of antennas on bottom row</Description>
<HideCondition>~(Configuration == 5)</HideCondition>
<Validate><T>Int</T><D>3</D></Validate></Item>
<Item XName="NumElementsMiddleRow" Type="PartParam">
<DataEntry>9</DataEntry>
<Default><T>Bool</T><D>1</D></Default>
<Description>Number of antennas on mid row</Description>
<HideCondition>~(Configuration == 5)</HideCondition>
<Validate><T>Int</T><D>3</D></Validate></Item>
<Item XName="NumElementsX" Type="PartParam">
<DataEntry>8</DataEntry>
<Description>Number of antennas on X axis</Description>
<HideCondition>~(Configuration == 2 | Configuration == 4)</HideCondition>
<Validate><T>Int</T><D>3</D></Validate></Item>
<Item XName="NumElementsY" Type="PartParam">
<DataEntry>8</DataEntry>
<Description>Number of antennas on Y axis</Description>
<HideCondition>~(Configuration == 1 | Configuration == 2 | Configuration == 4)</HideCondition>
<Validate><T>Int</T><D>3</D></Validate></Item>
<Item XName="PORT" Type="PartParam">
<DataEntry>1</DataEntry>
<Description>Port Number</Description>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>3</D></Validate></Item>
