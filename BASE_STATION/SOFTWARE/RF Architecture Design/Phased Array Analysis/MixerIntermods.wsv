<HideCondition>(ElementPatternType &lt; 4)</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>15</D></Validate></Item>
<Item XName="PatternDataPhiGrid" Type="PartParam">
<DataEntry>[0]</DataEntry>
<Default><T>Bool</T><D>1</D></Default>
<Description>Phi grid in M x N matrix. M is the number of phi angles and N is the number of theta angles.</Description>
<HideCondition>(ElementPatternType &lt; 4)</HideCondition>
