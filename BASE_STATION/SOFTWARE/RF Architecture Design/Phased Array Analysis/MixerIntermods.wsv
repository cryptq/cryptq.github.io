<DataEntry>0</DataEntry>
<Default><T>Bool</T><D>1</D></Default>
<Description>Phi angle of the beam pointing direction used to compute active reflection from element pattern</Description>
<HideCondition>(ActiveLoading &lt; 5) | (ActiveLoading &gt; 5)</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Unit><T>Int</T><D>40769</D></Unit>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="PhiGrid" Type="PartParam">
<DataEntry />
