<Item XName="Display0" Type="EquationDisp">
<DVport><T>Array_Dbl64</T><D>1;4;;;8A24;ex14</D></DVport>
<PVPort><T>Array_Dbl64</T><D>1;4;;;}{zxtlFg634;X37ERuWzt24</D></PVPort>
<Show><T>Bool</T><D>0</D></Show>
<ShowCmd><T>Int</T><D>1</D></ShowCmd>
<Split><T>Double</T><D>0.3</D></Split>
<Split2><T>Double</T><D>0.3</D></Split2>
<Window><T>Array_I64</T><D>1;4;94;V6;LJ;FE</D></Window>
<ZOrder><T>Int</T><D>4</D></ZOrder></Item></Item>
<Item XName="VarBlock" Type="VarBlock" /></Item>
<Item XName="ReadMe" UserName="ReadMe" Type="Notes">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>&lt;P class=MsoTitle style=&quot;BORDER-TOP: medium none; BORDER-RIGHT: medium none; BORDER-BOTTOM: windowtext 0.75pt solid; PADDING-BOTTOM: 1pt; PADDING-TOP: 0in; PADDING-LEFT: 0in; MARGIN: 0in 0in 0pt; BORDER-LEFT: medium none; PADDING-RIGHT: 0in&quot; align=center&gt;&lt;STRONG&gt;&lt;FONT size=5 face=Arial&gt;Comparing Phased Array Analysis &lt;BR&gt;vs. Spectrasys (brute force)&lt;/FONT&gt;&lt;/STRONG&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: center; MARGIN: 0in 0in 0pt&quot; align=center&gt;&lt;EM&gt;&lt;FONT size=3&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: Arial; mso-bidi-font-size: 12.0pt&quot;&gt;Keysight Technologies SystemVue Workspace&lt;/SPAN&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; mso-bidi-font-size: 12.0pt&quot;&gt;&lt;?xml:namespace prefix = &quot;o&quot; ns = &quot;urn:schemas-microsoft-com:office:office&quot; /&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/EM&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: center; MARGIN: 0in 0in 0pt&quot; align=center&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; mso-bidi-font-size: 12.0pt&quot;&gt;&lt;EM&gt;&amp;nbsp;&lt;o:p&gt;&lt;/o:p&gt;&lt;/EM&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoBodyText style=&quot;MARGIN: 0in 0in 0pt&quot; align=center&gt;&lt;EM&gt;&lt;FONT size=2&gt;&lt;/FONT&gt;&lt;/EM&gt;&#x000D;&#x000A;&lt;P class=MsoBodyText style=&quot;MARGIN: 0in 0in 0pt&quot; align=center&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: Arial; mso-bidi-font-size: 12.0pt&quot;&gt;&lt;STRONG&gt;&lt;EM&gt;&lt;FONT size=2&gt;&lt;/FONT&gt;&lt;/EM&gt;&lt;/STRONG&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P&gt;&lt;EM&gt;&lt;FONT size=2&gt;&lt;/FONT&gt;&lt;/EM&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoBodyText style=&quot;MARGIN: 0in 0in 0pt&quot;&gt;&lt;FONT size=2&gt;This workspace contrasts&amp;nbsp;a full Spectrasys analysis of a 4x4 TX array vs. a more streamlined Phased Array analysis.&amp;nbsp; By comparing the two results side-by-side, you can gain confidence in the accuracy and convenience of the Phased Array analysis results,&amp;nbsp;vs. the difficulty of drawing and solving large networks&amp;nbsp;in Spectrasys.&amp;nbsp; &lt;/FONT&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;UL&gt;&#x000D;&#x000A;&lt;LI&gt;&#x000D;&#x000A;&lt;DIV class=MsoBodyText style=&quot;MARGIN: 0in 0in 0pt&quot;&gt;&lt;FONT size=2 face=Arial&gt;In &lt;U&gt;Folder #1&lt;/U&gt;, you draw and manually implement a 16-element array, complete with manual gain/phase states in Spectrasys.&amp;nbsp; Because Spectrasys has no native post-processing functions for beam measurements and array functions, many of these calculations are shown manually. (This requires a W1719 license)&lt;/FONT&gt;&lt;/DIV&gt;&lt;/LI&gt;&#x000D;&#x000A;&lt;LI&gt;&#x000D;&#x000A;&lt;DIV class=MsoBodyText style=&quot;MARGIN: 0in 0in 0pt&quot;&gt;&lt;FONT size=2 face=Arial&gt;In &lt;U&gt;Folder #2&lt;/U&gt;, you use the Phased Array controller, and the special phased array parts.&amp;nbsp; The design problem, the simulaiton setup, and the post-processing are all much simpler. (This requires both W1719 and W1720 licenses)&lt;/FONT&gt;&lt;/DIV&gt;&lt;/LI&gt;&lt;/UL&gt;&#x000D;&#x000A;&lt;P class=MsoBodyText style=&quot;MARGIN: 0in 0in 0pt&quot;&gt;&lt;FONT size=2&gt;&lt;STRONG&gt;For you to try:&lt;/STRONG&gt; &lt;/FONT&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;UL&gt;&#x000D;&#x000A;&lt;LI&gt;&#x000D;&#x000A;&lt;DIV class=MsoBodyText style=&quot;MARGIN: 0in 0in 0pt&quot;&gt;&lt;FONT size=2 face=Arial&gt;Run the simulations, and and run the scripts called &quot;PlotPattern1&quot; and &quot;PlotPattern2&quot; to refresh the 3D plots.&lt;/FONT&gt;&lt;/DIV&gt;&lt;/LI&gt;&#x000D;&#x000A;&lt;LI&gt;&#x000D;&#x000A;&lt;DIV class=MsoBodyText style=&quot;MARGIN: 0in 0in 0pt&quot;&gt;&lt;FONT size=2 face=Arial&gt;Explore&amp;nbsp;the numeric results, such as Channel Power (DCP), Gain, Cumulative Noise Figure (CNF), and&amp;nbsp;EOIP3&lt;/FONT&gt;&lt;/DIV&gt;&lt;/LI&gt;&#x000D;&#x000A;&lt;UL&gt;&#x000D;&#x000A;&lt;LI&gt;&#x000D;&#x000A;&lt;DIV class=MsoBodyText style=&quot;MARGIN: 0in 0in 0pt&quot;&gt;&lt;FONT size=2 face=Arial&gt;do you see any differences?&amp;nbsp; can you explain them?&lt;/FONT&gt;&lt;/DIV&gt;&lt;/LI&gt;&#x000D;&#x000A;&lt;LI&gt;&#x000D;&#x000A;&lt;DIV class=MsoBodyText style=&quot;MARGIN: 0in 0in 0pt&quot;&gt;&lt;FONT size=2 face=Arial&gt;do you have confidence for a larger problem?&lt;/FONT&gt;&lt;/DIV&gt;&lt;/LI&gt;&lt;/UL&gt;&#x000D;&#x000A;&lt;LI&gt;&#x000D;&#x000A;&lt;DIV class=MsoBodyText style=&quot;MARGIN: 0in 0in 0pt&quot;&gt;&lt;FONT size=2 face=Arial&gt;Now, consider making some basic changes such as the parameters&amp;nbsp;suggested below&lt;/FONT&gt;&lt;/DIV&gt;&lt;/LI&gt;&#x000D;&#x000A;&lt;UL&gt;&#x000D;&#x000A;&lt;LI&gt;&#x000D;&#x000A;&lt;DIV class=MsoBodyText style=&quot;MARGIN: 0in 0in 0pt&quot;&gt;&lt;FONT size=2 face=Arial&gt;change from 4x4 to 8x8 array (64 elements)&lt;/FONT&gt;&lt;/DIV&gt;&lt;/LI&gt;&#x000D;&#x000A;&lt;LI&gt;&#x000D;&#x000A;&lt;DIV class=MsoBodyText style=&quot;MARGIN: 0in 0in 0pt&quot;&gt;&lt;FONT size=2 face=Arial&gt;change the beamforming angle (PHI &amp;amp; THETA)&lt;/FONT&gt;&lt;/DIV&gt;&lt;/LI&gt;&#x000D;&#x000A;&lt;LI&gt;&#x000D;&#x000A;&lt;DIV class=MsoBodyText style=&quot;MARGIN: 0in 0in 0pt&quot;&gt;&lt;FONT size=2 face=Arial&gt;change the gain parameter on the TX PA.&lt;/FONT&gt;&lt;/DIV&gt;&lt;/LI&gt;&lt;/UL&gt;&#x000D;&#x000A;&lt;LI&gt;&#x000D;&#x000A;&lt;DIV class=MsoBodyText style=&quot;MARGIN: 0in 0in 0pt&quot;&gt;&lt;FONT size=2 face=Arial&gt;QUESTIONS to consider:&lt;/FONT&gt;&lt;/DIV&gt;&lt;/LI&gt;&#x000D;&#x000A;&lt;UL&gt;&#x000D;&#x000A;&lt;LI&gt;&#x000D;&#x000A;&lt;DIV class=MsoBodyText style=&quot;MARGIN: 0in 0in 0pt&quot;&gt;&lt;FONT size=2 face=Arial&gt;To make these changes,&amp;nbsp;how many places you need to touch?&amp;nbsp; &lt;/FONT&gt;&lt;/DIV&gt;&lt;/LI&gt;&#x000D;&#x000A;&lt;LI&gt;&#x000D;&#x000A;&lt;DIV class=MsoBodyText style=&quot;MARGIN: 0in 0in 0pt&quot;&gt;&lt;FONT size=2 face=Arial&gt;How much time does it take to make the changes?&amp;nbsp; Did you do it right?&lt;/FONT&gt;&lt;/DIV&gt;&lt;/LI&gt;&#x000D;&#x000A;&lt;LI&gt;&#x000D;&#x000A;&lt;DIV class=MsoBodyText style=&quot;MARGIN: 0in 0in 0pt&quot;&gt;&lt;FONT size=2 face=Arial&gt;How much simulation time and RAM does it take?&amp;nbsp; &lt;/FONT&gt;&lt;/DIV&gt;&lt;/LI&gt;&#x000D;&#x000A;&lt;LI&gt;&#x000D;&#x000A;&lt;DIV class=MsoBodyText style=&quot;MARGIN: 0in 0in 0pt&quot;&gt;&lt;FONT size=2 face=Arial&gt;Would the topology change break your existing RFLINK, to Dataflow?&lt;/FONT&gt;&lt;/DIV&gt;&lt;/LI&gt;&lt;/UL&gt;&lt;/UL&gt;&#x000D;&#x000A;&lt;P class=MsoBodyText style=&quot;MARGIN: 0in 0in 0pt&quot;&gt;&lt;FONT size=2&gt;To consider RFLINK and Dataflow beamforming, please look at additional&amp;nbsp;examples in the&amp;nbsp;\Examples\Beamforming\ directory, including &quot;Discovering_Beamforming.wsv&quot;.&lt;/FONT&gt;&lt;/P&gt;</Text>
<Item XName="Page" Type="PageMgr">
<Item XName="Display0" Type="NotesDisp">
<DVport><T>Array_Dbl64</T><D>1;4;;;mB24;Gm14</D></DVport>
<PVPort><T>Array_Dbl64</T><D>1;4;;;pbBNkRcF034;wqfJdEZ1Z24</D></PVPort>
<Show><T>Bool</T><D>1</D></Show>
<ShowCmd><T>Int</T><D>1</D></ShowCmd>
<Window><T>Array_I64</T><D>1;4;;;CE;l4</D></Window>
<ZOrder><T>Int</T><D>0</D></ZOrder></Item></Item></Item>
<Item XName="Settings" UserName="Settings" Type="Equation">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>gain=20;&#x000D;&#x000A;nf=3;&#x000D;&#x000A;taperOption = 0; %0:none, 10:taylor&#x000D;&#x000A;&#x000D;&#x000A;taperNone = zeros(16,1);&#x000D;&#x000A;phaseTheta0Phi0 = zeros(16,1);&#x000D;&#x000A;&#x000D;&#x000A;taperTaylor20dB = [&#x000D;&#x000A;&#x0009;0.1603&#x000D;&#x000A;     0.4003&#x000D;&#x000A;     0.4003&#x000D;&#x000A;     0.1603&#x000D;&#x000A;     0.4003&#x000D;&#x000A;     1.0000&#x000D;&#x000A;     1.0000&#x000D;&#x000A;     0.4003&#x000D;&#x000A;     0.4003&#x000D;&#x000A;     1.0000&#x000D;&#x000A;     1.0000&#x000D;&#x000A;     0.4003&#x000D;&#x000A;     0.1603&#x000D;&#x000A;     0.4003&#x000D;&#x000A;     0.4003&#x000D;&#x000A;     0.1603&#x000D;&#x000A;];&#x000D;&#x000A;&#x000D;&#x000A;phaseTheta30Phi60=[&#x000D;&#x000A;     0&#x000D;&#x000A;    -1.3603&#x000D;&#x000A;    -2.7207&#x000D;&#x000A;    -4.0810&#x000D;&#x000A;    -0.7854&#x000D;&#x000A;    -2.1457&#x000D;&#x000A;    -3.5061&#x000D;&#x000A;    -4.8664&#x000D;&#x000A;    -1.5708&#x000D;&#x000A;    -2.9311&#x000D;&#x000A;    -4.2915&#x000D;&#x000A;    -5.6518&#x000D;&#x000A;    -2.3562&#x000D;&#x000A;    -3.7165&#x000D;&#x000A;    -5.0769&#x000D;&#x000A;    -6.4372&#x000D;&#x000A;];&#x000D;&#x000A;&#x000D;&#x000A;if taperOption == 10&#x000D;&#x000A;&#x0009;taper = 10*log10(taperTaylor20dB);&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;taper = taperNone;&#x000D;&#x000A;end&#x000D;&#x000A;phase = -phaseTheta30Phi60/pi*180;</Text>
<UnitUse><T>Int</T><D>2</D></UnitUse>
