<Size><T>Double</T><D>125</D></Size></Item>
<Item XName="FunctionBlock" Type="FunctionBlock" />
<Item XName="VarBlock" Type="VarBlock" /></Item>
<Item XName="Page" Type="PageMgr" />
<Item XName="ProcessTxData" UserName="ProcessTxData" Type="Equation">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>using( &apos;PhasedArrayTx_PhasedArrayTxSch_Data&apos; );&#x000D;&#x000A;&#x000D;&#x000A;% Make the input power array the same size as the other output arrays&#x000D;&#x000A;Signal_ArrayIn_Power = ones( 64, 1) * NodeInfo_Signal_Power_01_TxIn_Output;&#x000D;&#x000A;&#x000D;&#x000A;% Build a matrix of all the power output data&#x000D;&#x000A;ArrayPowerOut = [ Signal_ArrayIn_Power&apos;; NodeInfo_Signal_Power_02_ArraySplit64_Output&apos;; NodeInfo_Signal_Power_03_PhaseShifter_Output&apos;; NodeInfo_Signal_Power_04_ArrayAttn_Output&apos;; NodeInfo_Signal_Power_05_RFAmp_RFAmp_RFAmpHO_Output&apos; ];&#x000D;&#x000A;&#x000D;&#x000A;% Extract the column of data for the selected element&#x000D;&#x000A;PowerOut = ArrayPowerOut(:,Element);&#x000D;&#x000A;setdisplayunit(&apos;PowerOut&apos;, &apos;dBm&apos; );&#x000D;&#x000A;&#x000D;&#x000A;% Build the path gain&#x000D;&#x000A;StageCount = 5;&#x000D;&#x000A;Gain = [];&#x000D;&#x000A;Gain(1) = 1;&#x000D;&#x000A;&#x000D;&#x000A;for i = 2:StageCount&#x000D;&#x000A;&#x0009;Gain(i) = PowerOut(i) / PowerOut(i-1);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;Gain = Gain&apos;;&#x000D;&#x000A;&#x000D;&#x000A;setdisplayunit( &apos;Gain&apos;, &apos;dB&apos; );&#x000D;&#x000A;&#x000D;&#x000A;% Create the independent variables for the path&#x000D;&#x000A;PathIndep = cell(StageCount, 1);&#x000D;&#x000A;PathIndep = [{&apos;TxIn&apos;};{&apos;ArraySplit64&apos;};{&apos;PhaseShifter&apos;};{&apos;ArrayAttn&apos;};{&apos;RFAmp&apos;}];&#x000D;&#x000A;&#x000D;&#x000A;setindep( &apos;Gain&apos;, &apos;PathIndep&apos; );&#x000D;&#x000A;setindep( &apos;PowerOut&apos;, &apos;PathIndep&apos; );</Text>
