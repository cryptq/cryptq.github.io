<Item XName="PlotPattern2" UserName="PlotPattern2" Type="Equation">
<AutoCalc><T>Bool</T><D>0</D></AutoCalc>
<Selected><T>Bool</T><D>0</D></Selected>
<Text>%runanalysis(&apos;DFTx&apos;);&#x000D;&#x000A;using(&apos;DFTx_DFTxSch_Data&apos;);&#x000D;&#x000A;gain = squeeze(gain);&#x000D;&#x000A;zenith = squeeze(zenith);&#x000D;&#x000A;azimuth = squeeze(azimuth);&#x000D;&#x000A;graph2=graph_figure(&apos;BeamCtrlFromRF&apos;);&#x000D;&#x000A;graph2.add_spherical_data(azimuth,zenith,max(gain,-30));</Text>
