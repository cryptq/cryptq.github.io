<!DOCTYPE GENESYSV1.00>

<Item Type="WorkspaceData">
<ClientWnd><T>Array_Int</T><D>1;4;0;0;1145;618</D></ClientWnd>
<IsOpen><T>Bool</T><D>1</D></IsOpen>
<Time>2019:234:12:18</Time>
<ToolbarSize><T>Int</T><D>25</D></ToolbarSize>
<Ver><T>Double</T><D>2013.01</D></Ver>
<Version>1.21</Version>
<Item XName="ACPR_DB" UserName="ACPR_DB" Type="function">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>function out = ACPR_DB( Spectrum, Freq, FCenter, MainChannelBW, AdjChannelIdx )&#x000D;&#x000A;&#x0009;%&#x000D;&#x000A;&#x0009;% first,  sum the linear powers (watts) from the Sink in the Main channel&#x000D;&#x000A;&#x0009;Flow = FCenter - MainChannelBW/2;&#x000D;&#x000A;&#x0009;Fhigh = FCenter + MainChannelBW/2;&#x000D;&#x000A;&#x0009;FlowIdx = find( Freq &gt;= Flow, 1, &apos;first&apos; );&#x000D;&#x000A;&#x0009;FhighIdx = find( Freq &gt;= Fhigh, 1, &apos;first&apos; );&#x000D;&#x000A;&#x0009;MainChannelPwr = sum( Spectrum(FlowIdx:FhighIdx) );&#x000D;&#x000A;&#x0009;%&#x000D;&#x000A;&#x0009;% now adjust the freqs up/down, and re-sum for the adjacent channel&#x000D;&#x000A;&#x0009;Flow = Flow + AdjChannelIdx * MainChannelBW;&#x000D;&#x000A;&#x0009;Fhigh = Fhigh + AdjChannelIdx * MainChannelBW;&#x000D;&#x000A;&#x0009;FlowIdx = find( Freq &gt;= Flow, 1, &apos;first&apos; );&#x000D;&#x000A;&#x0009;FhighIdx = find( Freq &gt;= Fhigh, 1, &apos;first&apos; );&#x000D;&#x000A;&#x0009;AdjChannelPwr = sum( Spectrum(FlowIdx:FhighIdx) );&#x000D;&#x000A;&#x0009;%&#x000D;&#x000A;&#x0009;% finally, ratio the linear powers (watts), and convert to DB&#x000D;&#x000A;&#x0009;out = 10*log10(abs(AdjChannelPwr / MainChannelPwr));&#x000D;&#x000A;end</Text>
