<Selected><T>Bool</T><D>0</D></Selected>
<Text>% Do NOT change anything on this page&#x000D;&#x000A;&#x000D;&#x000A;ModType = Modulation;&#x000D;&#x000A;&#x000D;&#x000A;if ( ModType == 10 )&#x000D;&#x000A;&#x0009;ModType = 9;&#x000D;&#x000A;elseif ( ModType == 11 )&#x000D;&#x000A;&#x0009;ModType = 10;&#x000D;&#x000A;elseif ( ModType == 16 )&#x000D;&#x000A;&#x0009;ModType = 11;&#x000D;&#x000A;elseif( ModType == 17 )&#x000D;&#x000A;&#x0009;ModType = 12;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;BitRate = SymbolRate * BitsPerSymbol( ModType + 1 );&#x000D;&#x000A;&#x000D;&#x000A;I_Offset = real( IQ_Offset );&#x000D;&#x000A;Q_Offset = imag( IQ_Offset );&#x000D;&#x000A;&#x000D;&#x000A;GainTrim=8.1+RFpower; % adjusts the approximate power level</Text>
