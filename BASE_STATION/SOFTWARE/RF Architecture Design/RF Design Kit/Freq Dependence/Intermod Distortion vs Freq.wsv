<Item XName="3DGraphCompression" UserName="3DGraphCompression" Type="Equation">
<AutoCalc><T>Bool</T><D>0</D></AutoCalc>
<Selected><T>Bool</T><D>0</D></Selected>
<Text>% Specify the swept compression curve dataset&#x000D;&#x000A;using(&apos;System2_Sch1_Data_Path1_Sweep1&apos;)&#x000D;&#x000A;&#x000D;&#x000A;% One of the purposes of this equation block is to re-interpolate the data&#x000D;&#x000A;% since each frequency of the sweep may have a different number of points&#x000D;&#x000A;&#x000D;&#x000A;nodenames    = cell2mat(NodeNames);&#x000D;&#x000A;idx_at_node2 = find( nodenames == &apos;2&apos; );&#x000D;&#x000A;&#x000D;&#x000A;dcp_dep      = DCP;&#x000D;&#x000A;dcp_dep      = DCP( idx_at_node2 );&#x000D;&#x000A;&#x000D;&#x000A;FinIndep   = Equation_Fin_Swp_NodeNames&#x000D;&#x000A;FinIndep   = FinIndep(idx_at_node2);&#x000D;&#x000A;&#x000D;&#x000A;powerindep   = SwpPwr_Swp;&#x000D;&#x000A;%(idx_at_node2);&#x000D;&#x000A;F_indep      = unique( FinIndep );&#x000D;&#x000A;P_indep      = unique( powerindep );&#x000D;&#x000A;F_idx        = zeros( 2, numel( P_indep ) );&#x000D;&#x000A;result       = zeros( numel( F_indep ), numel( P_indep ) );&#x000D;&#x000A;for F_grr = 1 : numel( F_indep )&#x000D;&#x000A;  idx  = find( FinIndep == F_indep( F_grr ) );&#x000D;&#x000A;  fidx = [ min(idx); max(idx) ];&#x000D;&#x000A;  tmp  = interp1( powerindep( fidx(1):fidx(2) ), dcp_dep( fidx(1):fidx(2) ), P_indep, &apos;linear&apos;,&apos;extrap&apos;);&#x000D;&#x000A;  result( F_grr, :) = tmp(:)&apos;;&#x000D;&#x000A;end&#x000D;&#x000A;indep_F = repmat( F_indep(:)  , [1,numel(P_indep)] )&#x000D;&#x000A;indep_P = repmat( P_indep(:)&apos; , [numel(F_indep),1] )&#x000D;&#x000A;&#x000D;&#x000A;setdisplayunit( indep_P, &apos;&apos; )&#x000D;&#x000A;&#x000D;&#x000A;fig_dcp3d = graph_figure(&apos;Compression_vs_Freq&apos;);&#x000D;&#x000A;fig_dcp3d.add_mesh_data( dbm(indep_P), indep_F, dbm(result),&apos;PowerOut&apos; );&#x000D;&#x000A;fig_dcp3d.set_label_x(&apos;Power In (dBm)&apos;);&#x000D;&#x000A;fig_dcp3d.set_label_y(&apos;Freq (MHz)&apos;);&#x000D;&#x000A;fig_dcp3d.set_label_z(&apos;Power Out (dBm)&apos;);&#x000D;&#x000A;</Text>
