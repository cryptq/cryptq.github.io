<Item XName="EQs_output" UserName="EQs_output" Type="Equation">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>using(&apos;LTE_UL_Tx_Measurements_0&apos;);&#x000D;&#x000A;&#x000D;&#x000A;Zref         = 50;&#x000D;&#x000A;&#x000D;&#x000A;Vout         = abs(RFout);&#x000D;&#x000A;Pout_watts   = Vout.^2/(2*Zref);&#x000D;&#x000A;Pout_rms     = mean(Pout_watts);&#x000D;&#x000A;Pout_rms_dbm = 10*log10(Pout_rms) + 30;&#x000D;&#x000A;Pout_dbm     = 10*log10(Pout_watts) + 30;&#x000D;&#x000A;Pout_crestfc = 10*log10(max(Pout_watts)) + 30 - Pout_rms_dbm;&#x000D;&#x000A;&#x000D;&#x000A;Vin          = abs(RFin);&#x000D;&#x000A;Pin_watts    = Vin.^2/(2*Zref);&#x000D;&#x000A;Pin_rms      = mean(Pin_watts);&#x000D;&#x000A;Pin_rms_dbm  = 10*log10(Pin_rms) + 30;&#x000D;&#x000A;Pin_dbm      = 10*log10(Pin_watts) + 30;&#x000D;&#x000A;Pin_crestfc  = 10*log10(max(Pin_watts)) + 30 - Pin_rms_dbm;&#x000D;&#x000A;&#x000D;&#x000A;Gain_nominal = Pout_rms_dbm - Pin_rms_dbm;&#x000D;&#x000A;AMtoAM        = (Pout_dbm-Gain_nominal) - Pin_dbm;&#x000D;&#x000A;setindep(&apos;AMtoAM&apos;, &apos;Pin_dbm&apos;);&#x000D;&#x000A;&#x000D;&#x000A;Phase_time   = angle(RFout./RFin);&#x000D;&#x000A;Phase_nominal= mean(Phase_time);&#x000D;&#x000A;AMtoPM        = Phase_time - Phase_nominal;&#x000D;&#x000A;setindep(&apos;AMtoPM&apos;, &apos;Pin_dbm&apos;);&#x000D;&#x000A;</Text>
<UnitUse><T>Int</T><D>2</D></UnitUse>
