<Item XName="Equation" UserName="Equation" Type="Equation">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>LOInjection=tune(0);&#x000D;&#x000A;&#x000D;&#x000A;% LO Low Side Injection 7375 to 8625 MHz&#x000D;&#x000A;% LO High Side Injection 11375 to 12625&#x000D;&#x000A;FLO_Lo = 7375;&#x000D;&#x000A;FLO=tune(8000);&#x000D;&#x000A;FLO_Hi = 8625;&#x000D;&#x000A;&#x000D;&#x000A;if ( 1 == LOInjection ) &#x000D;&#x000A;  FLO_Lo = 11375;&#x000D;&#x000A;FLO=tune(12000)&#x000D;&#x000A;  FLO_Hi = 12625;&#x000D;&#x000A;end</Text>
