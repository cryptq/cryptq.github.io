<Item XName="Equations" Type="Equation">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>% OversamplingOption&#x000D;&#x000A;OversamplingOption = 1;&#x000D;&#x000A;&#x000D;&#x000A;% FCarrier&#x000D;&#x000A;FCarrier = 2e9;&#x000D;&#x000A;&#x000D;&#x000A;% Transmit Power&#x000D;&#x000A;RS_EPRE = -25;&#x000D;&#x000A;&#x000D;&#x000A;NDensity = 10^((RS_EPRE-10*log10(15e3)-SNR)/10)/1000.0;&#x000D;&#x000A;&#x000D;&#x000A;% Rx algorithm (for EPA 5Hz)&#x000D;&#x000A;ChannelModelType = 6;&#x000D;&#x000A;Doppler = 5;&#x000D;&#x000A;Velocity = 3.6*3e8*Doppler/FCarrier;&#x000D;&#x000A;Tmax = 2.51e-6;&#x000D;&#x000A;Fmax = 2*Doppler;&#x000D;&#x000A;TC_Iteration = 6;&#x000D;&#x000A;DemapperType = 1;&#x000D;&#x000A;DemapperMaxLevel = 1.0;&#x000D;&#x000A;&#x000D;&#x000A;% Sampling Rate &#x000D;&#x000A;SamplingTable = [1.92 3.84 7.68 15.36 23.04 30.72];&#x000D;&#x000A;SamplingFreq = 1e6*SamplingTable(Bandwidth+1);&#x000D;&#x000A;SamplingRate = SamplingFreq*(2^OversamplingOption);&#x000D;&#x000A;SampsPerFrame = 10*0.001*SamplingRate;&#x000D;&#x000A;SampsPerSF = 0.001*SamplingRate;&#x000D;&#x000A;&#x000D;&#x000A;HARQ_Enable = 0;</Text>
