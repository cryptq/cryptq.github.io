<HideCondition>0==ShowSystemParameters || 0==UserDefinedAntMappingMatrix</HideCondition>
<Validate><T>Int</T><D>15</D></Validate></Item>
<Item XName="CRS_NumAntPorts" Type="PartParam">
<DataEntry>1</DataEntry>
