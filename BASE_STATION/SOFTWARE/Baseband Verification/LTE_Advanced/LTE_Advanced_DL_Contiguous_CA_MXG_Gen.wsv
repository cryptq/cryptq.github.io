<Item XName="Equations" Type="Equation">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>RB_Alloc = [0,100];&#x000D;&#x000A;&#x000D;&#x000A;NumOfTxAntennas = 2^NumTxAnts;&#x000D;&#x000A;OVSR=UpsamplingRatio;&#x000D;&#x000A;SamplingTable=[1.92 3.84 7.68 15.36 23.04 30.72];&#x000D;&#x000A;SamplingFreq=1e6*SamplingTable(Bandwidth+1);&#x000D;&#x000A;SamplingRate=SamplingFreq*OVSR;&#x000D;&#x000A;SampsPerFrame=10*0.001*SamplingRate;&#x000D;&#x000A;SampsPerSF=0.001*SamplingRate;&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;FCarrier1 = FCarrier-10e6-50e3;&#x000D;&#x000A;FCarrier2 = FCarrier+10e6+50e3;&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;</Text>
