<HideCondition>0==ShowOtherUEs_Parameters</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="UEs_CDD_Mode" Type="PartParam">
<DataEntry>[1,1,1,1,1,1]</DataEntry>
<Description>CDD Mode for each UE, 1 for Zero-Delay, 0 for Large-Delay</Description>
<HideCondition>0==ShowMIMO_Parameters</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="UEs_CdBlk_Index" Type="PartParam">
<DataEntry>[0,0,0,0,0,0]</DataEntry>
<Description>codebook index for precoding for each UE</Description>
<HideCondition>0==ShowMIMO_Parameters</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="UEs_MIMO_Mode" Type="PartParam">
<DataEntry>[0,0,0,0,0,0]</DataEntry>
<Description>MIMO Mode for each UE, 1 for TD, 0 for SM</Description>
<HideCondition>0==ShowMIMO_Parameters</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="UEs_NumOfCWs" Type="PartParam">
<DataEntry>[2,2,2,2,2,2]</DataEntry>
<Description>number of code words for each UE</Description>
<HideCondition>0==ShowMIMO_Parameters</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="UEs_NumOfLayers" Type="PartParam">
<DataEntry>[2,2,2,2,2,2]</DataEntry>
<Description>number of layers for each UE</Description>
<HideCondition>0==ShowMIMO_Parameters</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="UEs_Pa" Type="PartParam">
