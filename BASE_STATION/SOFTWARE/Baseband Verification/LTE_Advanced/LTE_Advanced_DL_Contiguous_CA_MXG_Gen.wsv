<Unit><T>Int</T><D>7003</D></Unit>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="UseE4438Cs" Type="PartParam">
<DataEntry>1</DataEntry>
<Description>YES = E4438C&apos;s are used; NO = MXG&apos;s are used</Description>
