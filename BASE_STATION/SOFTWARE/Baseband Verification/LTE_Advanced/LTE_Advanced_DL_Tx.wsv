<HideCondition>0==ShowPowerParameters</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>14</D></Validate></Item>
<Item XName="UEs_SpecificRS" Type="PartParam">
<DataEntry>[0,0,0,0,0,0]</DataEntry>
