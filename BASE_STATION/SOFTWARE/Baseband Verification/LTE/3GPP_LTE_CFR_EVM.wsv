<HideCondition>0==ShowSystemParameters</HideCondition>
<Unit><T>Int</T><D>0</D></Unit>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="DMRS_Ra" Type="PartParam">
<DataEntry>[0,0,0,0,0,0]</DataEntry>
<Description>UE specific power parameter for DMRS of each UE</Description>
<Validate><T>Int</T><D>14</D></Validate></Item>
<Item XName="DemapperMaxLevel" Type="PartParam">
<DataEntry>100.0</DataEntry>
<Description>the maximum level for soft demapping output when DemapperType is Soft or CSI</Description>
<HideCondition>0==ShowRxAlgorithmParameters || DemapperType == 0</HideCondition>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="DemapperType" Type="PartParam">
<DataEntry>1</DataEntry>
<Description>symbol demodulation type</Description>
<Enum>LTE_DL_Receiver_DemapperType@LTE 8.9 Enums</Enum>
<HideCondition>0==ShowRxAlgorithmParameters</HideCondition>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="Fmax" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>the maximum doppler frequency. (used by 2D-MMSE channel estimator in PDSCH)</Description>
<HideCondition>0==ShowRxAlgorithmParameters || ChEstimatorMode ~= 1</HideCondition>
<Unit><T>Int</T><D>1001</D></Unit>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="FrameMode" Type="PartParam">
