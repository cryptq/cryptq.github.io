<Item XName="EquationText" Type="PartParam">
<DataEntry>in1=zeros(600,1);&#x000D;&#x000A;in1(1:300)=input(3797:4096);&#x000D;&#x000A;in1(301:600)=input(2:301);&#x000D;&#x000A;error=in1-in2;&#x000D;&#x000A;&#x000D;&#x000A;rms_err=abs(error);&#x000D;&#x000A;out2=rms_err;&#x000D;&#x000A;&#x000D;&#x000A;index=rms_err&gt;EVM_Th;&#x000D;&#x000A;theta=angle(error(index));&#x000D;&#x000A;x=EVM_Th*cos(theta);&#x000D;&#x000A;y=EVM_Th*sin(theta);&#x000D;&#x000A;&#x000D;&#x000A;in1(index)=in2(index)+x+1i*y;&#x000D;&#x000A;&#x000D;&#x000A;output = zeros(4096,1);&#x000D;&#x000A;output(2:301)=in1(301:600);&#x000D;&#x000A;output(3797:4096)=in1(1:300);&#x000D;&#x000A;output(1)=0;&#x000D;&#x000A;output(300:400)=input(300:400)*0.1;&#x000D;&#x000A;output(3696:3796)=input(3696:3796)*0.05;&#x000D;&#x000A;output(401:600)=input(401:600)*0.05;&#x000D;&#x000A;output(3497:3696)=input(3497:3696)*0.05;&#x000D;&#x000A;output(601:3496)=input(601:3496)*0.01;&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;</DataEntry>
