<Item XName="Equations" Type="Equation">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>%maximum number of UE supported in ADS for DL and UL&#x000D;&#x000A;G_MAX_NUM_UES = 6;&#x000D;&#x000A;&#x000D;&#x000A;%number of subframes in one radio frame&#x000D;&#x000A;G_NUM_SUBFRAMES = 10;&#x000D;&#x000A;&#x000D;&#x000A;%number of SCs per RB&#x000D;&#x000A;G_NUM_SCS_PER_RB = 12;&#x000D;&#x000A;&#x000D;&#x000A;%number of slots per subframe&#x000D;&#x000A;G_NUM_SLOTS_PER_SUBFRAME = 2;&#x000D;&#x000A;&#x000D;&#x000A;%number of slots per frame&#x000D;&#x000A;G_NUM_SLOTS_PER_FRAME = G_NUM_SUBFRAMES * G_NUM_SLOTS_PER_SUBFRAME;&#x000D;&#x000A;&#x000D;&#x000A;% The number of RSs occupied per RB; Varied per number of antennas&#x000D;&#x000A;G_NUM_RSS_PER_RB = [4, 8, 12];&#x000D;&#x000A;&#x000D;&#x000A;% The number of OFDM symbols occupied per RB; Varied per CyclicPrefix&#x000D;&#x000A;G_NUM_SYMBOLS_PER_SLOT = [7, 6];&#x000D;&#x000A;&#x000D;&#x000A;%bandwidth index (0-5): 1.4 MHz, 3 MHz, 5 MHz, 10 MHz, 15 MHz, 20 MHz&#x000D;&#x000A;G_NUM_RBS_PER_SYMBOL = [6, 15, 25, 50, 75, 100];&#x000D;&#x000A;&#x000D;&#x000A;%Modulation oders&#x000D;&#x000A;G_MODULATION_ORDER = [2, 4, 6];&#x000D;&#x000A;&#x000D;&#x000A;%bandwidth index (0-5): 1.4 MHz, 3 MHz, 5 MHz, 10 MHz, 15 MHz, 20 MHz&#x000D;&#x000A;G_NUM_RBS_PER_SYMBOL = [6, 15, 25, 50, 75, 100];&#x000D;&#x000A;&#x000D;&#x000A;%list the status of each subframe with 7 TDD configurations&#x000D;&#x000A;%0: uplink subframe; 1: downlink subframe; 2: special subframe&#x000D;&#x000A;G_TDD_CONFIG_TABLE = ...&#x000D;&#x000A;   [1, 2, 0, 0, 0, 1, 2, 0, 0, 0;...&#x000D;&#x000A;&#x0009;1, 2, 0, 0, 1, 1, 2, 0, 0, 1;...&#x000D;&#x000A;&#x0009;1, 2, 0, 1, 1, 1, 2, 0, 1, 1;...&#x000D;&#x000A;&#x0009;1, 2, 0, 0, 0, 1, 1, 1, 1, 1;...&#x000D;&#x000A;&#x0009;1, 2, 0, 0, 1, 1, 1, 1, 1, 1;...&#x000D;&#x000A;&#x0009;1, 2, 0, 1, 1, 1, 1, 1, 1, 1;...&#x000D;&#x000A;&#x0009;1, 2, 0, 0, 0, 1, 2, 0, 0, 1];&#x000D;&#x000A;&#x000D;&#x000A;% Define the number of BCH encoded bits&#x000D;&#x000A;numBCH_CodedBits = [1920, 1728];&#x000D;&#x000A;BCH_PerFrame = numBCH_CodedBits(CyclicPrefix+1)/8;&#x000D;&#x000A;BCH_Bits = [BCH_PerFrame; 0; 0; 0; 0; 0; 0; 0; 0; 0];&#x000D;&#x000A;% Define the index for the transmit antenna ports&#x000D;&#x000A;% m_numTxAntsIdx=0 --&gt; p=1&#x000D;&#x000A;% m_numTxAntsIdx=1 --&gt; p=2&#x000D;&#x000A;% m_numTxAntsIdx=2 --&gt; p=4&#x000D;&#x000A;m_numTxAntsIdx = 0;&#x000D;&#x000A;&#x000D;&#x000A;% define Pre_Oversamp&#x000D;&#x000A;if (FIR_withInterp==1 &amp;&amp; SpectrumShapingType==1 )&#x000D;&#x000A;&#x0009;Pre_Oversamp = 0;&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;Pre_Oversamp = OversamplingOption;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;% define Equal-Ripple FIR taps&#x000D;&#x000A;if (1 == SpectrumShapingType &amp;&amp; 2 == FIR_FilterType)&#x000D;&#x000A;&#x0009;Equal_Ripple_FIR_Switch = 0;&#x000D;&#x000A;   Others_Filters_Switch = 1;&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;Equal_Ripple_FIR_Switch = 1;&#x000D;&#x000A;&#x0009;Others_Filters_Switch = 0;&#x000D;&#x000A;end&#x000D;&#x000A;if (0 == OversamplingOption)&#x000D;&#x000A;&#x0009;EquiRippleFIR_Taps = [-0.00133995, 0.00179237, -0.000388626, -0.0045219, 0.0124097, -0.0192687, 0.0179405, -0.000881743, -0.03551, 0.0872926, -0.142549, 0.185118, 0.798874, 0.185118, -0.142549, 0.0872926, -0.03551, -0.000881743, 0.0179405, -0.0192687, 0.0124097, -0.0045219, -0.000388626, 0.00179237, -0.00133995];&#x000D;&#x000A;elseif (1 == OversamplingOption)&#x000D;&#x000A;&#x0009;EquiRippleFIR_Taps = [-0.000736485, -0.000744425, 0.000985696, 0.00182923, 4.75238e-005, -0.0033443, -0.0025326, 0.003241, 0.00654716, -4.79279e-005, -0.0097707, -0.00729618, 0.0088442, 0.0170782, -3.63519e-005, -0.0245888, -0.0182336, 0.0221862, 0.0439627, -5.35027e-005, -0.0712419, -0.0602354, 0.0921917, 0.301572, 0.399945, 0.301572, 0.0921917, -0.0602354, -0.0712419, -5.35027e-005, 0.0439627, 0.0221862, -0.0182336, -0.0245888, -3.63519e-005, 0.0170782, 0.0088442, -0.00729618, -0.0097707, -4.79279e-005, 0.00654716, 0.003241, -0.0025326, -0.0033443, 4.75238e-005, 0.00182923, 0.000985696, -0.000744425, -0.000736485];&#x000D;&#x000A;elseif (2 == OversamplingOption)&#x000D;&#x000A;&#x0009;EquiRippleFIR_Taps = [-0.000573215, -0.000464962, -0.000264084, -3.7957e-005, 0.00047979, 0.000792204, 0.000993825, 0.000648356, 2.44817e-005, -0.000930314, -0.00162301, -0.00188626, -0.00126741, -1.40242e-005, 0.00165684, 0.00292301, 0.00328529, 0.00221662, 5.52795e-006, -0.00276666, -0.00488182, -0.00539576, -0.00363573, 1.27846e-006, 0.00442788, 0.0078043, 0.00855902, 0.00576461, -6.86593e-006, -0.0069563, -0.0122865, -0.013475, -0.00911778, 1.10125e-005, 0.011099, 0.0198143, 0.0219916, 0.0151373, -1.40445e-005, -0.0192734, -0.0356166, -0.0412873, -0.030118, 1.60907e-005, 0.0460958, 0.100059, 0.150794, 0.1869, 0.199984, 0.1869, 0.150794, 0.100059, 0.0460958, 1.60907e-005, -0.030118, -0.0412873, -0.0356166, -0.0192734, -1.40445e-005, 0.0151373, 0.0219916, 0.0198143, 0.011099, 1.10125e-005, -0.00911778, -0.013475, -0.0122865, -0.0069563, -6.86593e-006, 0.00576461, 0.00855902, 0.0078043, 0.00442788, 1.27846e-006, -0.00363573, -0.00539576, -0.00488182, -0.00276666, 5.52795e-006, 0.00221662, 0.00328529, 0.00292301, 0.00165684, -1.40242e-005, -0.00126741, -0.00188626, -0.00162301, -0.000930314, 2.44817e-005, 0.000648356, 0.000993825, 0.000792204, 0.00047979, -3.7957e-005, -0.000264084, -0.000464962, -0.000573215];&#x000D;&#x000A;else % 8x&#x000D;&#x000A;&#x0009;EquiRippleFIR_Taps = [-0.000497319, -0.000197557, -0.000206946, -0.000193082, -0.000153049, -8.67427e-005, 2.62733e-006, 0.000108403, 0.000220757, 0.000327429, 0.000414893, 0.000469796, 0.000480571, 0.000439112, 0.000342209, 0.000192632, -2.60557e-007, -0.000220796, -0.000447886, -0.000656936, -0.000822099, -0.000919228, -0.000928654, -0.000838082, -0.0006448, -0.000357441, 3.89214e-006, 0.00040839, 0.000817142, 0.00118624, 0.00147108, 0.00163085, 0.00163433, 0.00146416, 0.00111977, 0.000618389, -1.50141e-006, -0.000687146, -0.00137156, -0.00198165, -0.0024448, -0.00269669, -0.00268938, -0.00239772, -0.00182454, -0.00100276, 4.9968e-006, 0.00111042, 0.00220635, 0.00317645, 0.00390665, 0.00429743, 0.00427557, 0.00380438, 0.00289067, 0.0015884, -2.97245e-006, -0.00174449, -0.00346872, -0.00499434, -0.00614373, -0.00676143, -0.00673239, -0.00599736, -0.00456404, -0.00251242, 6.23847e-006, 0.00277829, 0.00554329, 0.00801548, 0.00990937, 0.010969, 0.0109946, 0.00986895, 0.00757621, 0.00421402, -3.88455e-006, -0.00475547, -0.00962828, -0.0141469, -0.0178076, -0.0201185, -0.0206407, -0.0190284, -0.0150639, -0.00868347, 6.94179e-006, 0.0107289, 0.0230426, 0.0363701, 0.0500316, 0.0632891, 0.0753973, 0.0856555, 0.0934576, 0.098336, 0.0999957, 0.098336, 0.0934576, 0.0856555, 0.0753973, 0.0632891, 0.0500316, 0.0363701, 0.0230426, 0.0107289, 6.94179e-006, -0.00868347, -0.0150639, -0.0190284, -0.0206407, -0.0201185, -0.0178076, -0.0141469, -0.00962828, -0.00475547, -3.88455e-006, 0.00421402, 0.00757621, 0.00986895, 0.0109946, 0.010969, 0.00990937, 0.00801548, 0.00554329, 0.00277829, 6.23847e-006, -0.00251242, -0.00456404, -0.00599736, -0.00673239, -0.00676143, -0.00614373, -0.00499434, -0.00346872, -0.00174449, -2.97245e-006, 0.0015884, 0.00289067, 0.00380438, 0.00427557, 0.00429743, 0.00390665, 0.00317645, 0.00220635, 0.00111042, 4.9968e-006, -0.00100276, -0.00182454, -0.00239772, -0.00268938, -0.00269669, -0.0024448, -0.00198165, -0.00137156, -0.000687146, -1.50141e-006, 0.000618389, 0.00111977, 0.00146416, 0.00163433, 0.00163085, 0.00147108, 0.00118624, 0.000817142, 0.00040839, 3.89214e-006, -0.000357441, -0.0006448, -0.000838082, -0.000928654, -0.000919228, -0.000822099, -0.000656936, -0.000447886, -0.000220796, -2.60557e-007, 0.000192632, 0.000342209, 0.000439112, 0.000480571, 0.000469796, 0.000414893, 0.000327429, 0.000220757, 0.000108403, 2.62733e-006, -8.67427e-005, -0.000153049, -0.000193082, -0.000206946, -0.000197557, -0.000497319];&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;% Define VAR Modulation&#x000D;&#x000A;QPSK_Table = [1+j, 1-j, -1+j, -1-j];&#x000D;&#x000A;QPSK = QPSK_Table*1/sqrt(2.0);&#x000D;&#x000A;QAM16_Factor = 1.0/sqrt(10.0);&#x000D;&#x000A;QAM16_Table = ...&#x000D;&#x000A;&#x0009;[1+j,  1+j*3,  3+j*1,  3+j*3,  1-j,    1-j*3,  3-j,    3-j*3,...&#x000D;&#x000A;&#x0009;-1+j, -1+j*3, -3+j*1, -3+j*3, -1-j*1, -1-j*3, -3-j*1, -3-j*3];&#x000D;&#x000A;QAM16 = QAM16_Table*QAM16_Factor;&#x000D;&#x000A;QAM64_Factor = 1.0/sqrt(42.0);&#x000D;&#x000A;QAM64_Table = ...&#x000D;&#x000A;&#x0009;[3+j*3,    3+j,  1+j*3,  1+j*1,  3+j*5,  3+j*7,  1+j*5,  1+j*7,...&#x000D;&#x000A;&#x0009; 5+j*3,  5+j*1,  7+j*3,  7+j*1,  5+j*5,  5+j*7,  7+j*5,  7+j*7,...&#x000D;&#x000A;&#x0009; 3-j*3,  3-j*1,  1-j*3,  1-j*1,  3-j*5,  3-j*7,  1-j*5,  1-j*7,...&#x000D;&#x000A;&#x0009; 5-j*3,  5-j*1,  7-j*3,  7-j*1,  5-j*5,  5-j*7,  7-j*5,  7-j*7,...&#x000D;&#x000A;&#x0009;-3+j*3, -3+j*1, -1+j*3, -1+j*1, -3+j*5, -3+j*7, -1+j*5, -1+j*7,...&#x000D;&#x000A;&#x0009;-5+j*3,   -5+j, -7+j*3,   -7+j, -5+j*5, -5+j*7, -7+j*5, -7+j*7,...&#x000D;&#x000A;&#x0009;-3-j*3, -3-j*1, -1-j*3,   -1-j, -3-j*5, -3-j*7, -1-j*5, -1-j*7,...&#x000D;&#x000A;&#x0009;-5-j*3,   -5-j, -7-j*3,   -7-j, -5-j*5, -5-j*7, -7-j*5, -7-j*7];&#x000D;&#x000A;QAM64 = QAM64_Table*QAM64_Factor;&#x000D;&#x000A;QPSK_Extended_Table = [1+j, 1-j, -1+j, -1-j, 0, 0, 0, 0, 0, 0, 0];&#x000D;&#x000A;QPSK_Extended = QPSK_Extended_Table*1/sqrt(2.0);&#x000D;&#x000A;&#x000D;&#x000A;if (0 == OtherUEs_MappingType(1))&#x000D;&#x000A;&#x0009;UE2_MapperBits = 2;&#x000D;&#x000A;&#x0009;UE2_Mapper = QPSK;&#x000D;&#x000A;elseif (1 == OtherUEs_MappingType(1))&#x000D;&#x000A;&#x0009;UE2_MapperBits = 4;&#x000D;&#x000A;&#x0009;UE2_Mapper = QAM16;&#x000D;&#x000A;else &#x000D;&#x000A;&#x0009;UE2_MapperBits = 6;&#x000D;&#x000A;&#x0009;UE2_Mapper = QAM64;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if (0 == OtherUEs_MappingType(2))&#x000D;&#x000A;&#x0009;UE3_MapperBits = 2;&#x000D;&#x000A;&#x0009;UE3_Mapper = QPSK;&#x000D;&#x000A;elseif (1 == OtherUEs_MappingType(2))&#x000D;&#x000A;&#x0009;UE3_MapperBits = 4;&#x000D;&#x000A;&#x0009;UE3_Mapper = QAM16;&#x000D;&#x000A;else &#x000D;&#x000A;&#x0009;UE3_MapperBits = 6;&#x000D;&#x000A;&#x0009;UE3_Mapper = QAM64;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if (0 == OtherUEs_MappingType(3))&#x000D;&#x000A;&#x0009;UE4_MapperBits = 2;&#x000D;&#x000A;&#x0009;UE4_Mapper = QPSK;&#x000D;&#x000A;elseif (1 == OtherUEs_MappingType(3))&#x000D;&#x000A;&#x0009;UE4_MapperBits = 4;&#x000D;&#x000A;&#x0009;UE4_Mapper = QAM16;&#x000D;&#x000A;else &#x000D;&#x000A;&#x0009;UE4_MapperBits = 6;&#x000D;&#x000A;&#x0009;UE4_Mapper = QAM64;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if (0 == OtherUEs_MappingType(4))&#x000D;&#x000A;&#x0009;UE5_MapperBits = 2;&#x000D;&#x000A;&#x0009;UE5_Mapper = QPSK;&#x000D;&#x000A;elseif (1 == OtherUEs_MappingType(4))&#x000D;&#x000A;&#x0009;UE5_MapperBits = 4;&#x000D;&#x000A;&#x0009;UE5_Mapper = QAM16;&#x000D;&#x000A;else &#x000D;&#x000A;&#x0009;UE5_MapperBits = 6;&#x000D;&#x000A;&#x0009;UE5_Mapper = QAM64;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if (0 == OtherUEs_MappingType(5))&#x000D;&#x000A;&#x0009;UE6_MapperBits = 2;&#x000D;&#x000A;&#x0009;UE6_Mapper = QPSK;&#x000D;&#x000A;elseif (1 == OtherUEs_MappingType(5))&#x000D;&#x000A;&#x0009;UE6_MapperBits = 4;&#x000D;&#x000A;&#x0009;UE6_Mapper = QAM16;&#x000D;&#x000A;else &#x000D;&#x000A;&#x0009;UE6_MapperBits = 6;&#x000D;&#x000A;&#x0009;UE6_Mapper = QAM64;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;% Input Parameter Check&#x000D;&#x000A;% Check FrameMode&#x000D;&#x000A;if (FrameMode &lt; 0 || FrameMode &gt; 1)&#x000D;&#x000A;&#x0009;error(&apos;FrameMode should be chosen from {FDD, TDD}!&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;% Check TDD_Config&#x000D;&#x000A;if (TDD_Config &lt; 0 || TDD_Config &gt; 6)&#x000D;&#x000A;&#x0009;error(&apos;TDD_Config should be chosen from {Config 0, Config 1, Config 2, Config 3, Config 4, Config 5, Config 6}!&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;% Check SpecialSF_Config&#x000D;&#x000A;if (1 == CyclicPrefix)     %for Extended CP&#x000D;&#x000A;&#x0009;if (SpecialSF_Config &lt; 0 || SpecialSF_Config &gt; 6)&#x000D;&#x000A;&#x0009;&#x0009;error(&apos;TDD_Config should be chosen from {Config 0, Config 1, Config 2, Config 3, Config 4, Config 5, Config 6}!&apos;);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;else                      % for normal CP&#x000D;&#x000A;&#x0009;if (SpecialSF_Config &lt; 0 || SpecialSF_Config &gt; 8)&#x000D;&#x000A;&#x0009;&#x0009;error(&apos;TDD_Config should be chosen from {Config 0, Config 1, Config 2, Config 3, Config 4, Config 5, Config 6, Config 7, Config 8}!&apos;);&#x000D;&#x000A;&#x0009;end                    &#x000D;&#x000A;end&#x000D;&#x000A;  &#x000D;&#x000A;% Check Bandwidth&#x000D;&#x000A;if (Bandwidth &lt; 0 || Bandwidth &gt; 5)&#x000D;&#x000A;&#x0009;error(&apos;Bandwidth should be chosen from {BW 1.4 MHz, BW 3 MHz, BW 5 MHz, BW 10 MHz, BW 15 MHz, BW 20 MHz}!&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;% Check OversamplingOption&#x000D;&#x000A;if (OversamplingOption &lt; 0 || OversamplingOption &gt; 3)&#x000D;&#x000A;&#x0009;error(&apos;OversamplingOption should be chosen from {Ratio 1, Ratio 2, Ratio 4, Ratio 8}!&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;% Check CyclicPrefix&#x000D;&#x000A;if (CyclicPrefix &lt; 0 || CyclicPrefix &gt; 1)&#x000D;&#x000A;&#x0009;error(&apos;CyclicPrefix should be chosen from {Normal, Extended}!&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;% Check CellID_Sector&#x000D;&#x000A;if (CellID_Sector &lt; 0 || CellID_Sector &gt; 2)&#x000D;&#x000A;&#x0009;error(&apos;CellID_Sector should be in range [0:2]!&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;% Check CellID_Group&#x000D;&#x000A;if (CellID_Group &lt; 0 || CellID_Group &gt; 167)&#x000D;&#x000A;&#x0009;error(&apos;CellID_Group should be in range [0:167]!&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;% Check RB_MappingType&#x000D;&#x000A;if (RB_MappingType &lt; 0 || RB_MappingType &gt; 0)&#x000D;&#x000A;&#x0009;%error(&apos;RB_MappingType should be chosen from {Localized, Distributed}!&apos;);&#x000D;&#x000A;&#x0009;error(&apos;RB_MappingType should be chosen from {Localized} in this release!&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;% Check UE1_Config&#x000D;&#x000A;if (UE1_Config &lt; 0 || UE1_Config &gt; 2)&#x000D;&#x000A;&#x0009;error(&apos;UE1_Config should be chosen from {MCS index, Transport block size, Code rate}!&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;% Check UE1_Payload&#x000D;&#x000A;%int UE1_NumOfCWs;&#x000D;&#x000A;if (0 ~= m_numTxAntsIdx)&#x000D;&#x000A;&#x0009;UE1_NumOfCWs = UEs_NumOfCWs(1);&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;UE1_NumOfCWs = 1;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;% The size of UE1_Payload could be 1, 2, 10 or 20&#x000D;&#x000A;if 2 == UE1_NumOfCWs &amp;&amp; 2*G_NUM_SUBFRAMES ~= size(UE1_Payload,1)*size(UE1_Payload,2) &amp;&amp; 2*1 ~= size(UE1_Payload,1)*size(UE1_Payload,2) ...&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&amp;&amp; G_NUM_SUBFRAMES ~= size(UE1_Payload,1)*size(UE1_Payload,2) &amp;&amp; 1 ~= size(UE1_Payload,1)*size(UE1_Payload,2)&#x000D;&#x000A;    error(&apos;Whit two code words, the size of UE1_Payload should be 1x1, 1x2, 10x1 or 10x2.&apos;);&#x000D;&#x000A;elseif 1 == UE1_NumOfCWs &amp;&amp; G_NUM_SUBFRAMES ~= size(UE1_Payload,1)*size(UE1_Payload,2) &amp;&amp; 1 ~= size(UE1_Payload,1)*size(UE1_Payload,2)&#x000D;&#x000A;&#x0009;error(&apos;The size of UE1_Payload should be 1x1 or 10x1.&apos;);&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;switch UE1_Config&#x000D;&#x000A;&#x0009;&#x0009;case 0, %MCS index&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;for n = 1:size(UE1_Payload,1)*size(UE1_Payload,2)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;if (UE1_Payload(n) &lt; -1 || UE1_Payload(n) &gt; 28) %MCS = 29, 30, 31 are not supported&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;error(&apos;When UE1_Config is set to MCS index, the integer value in UE1_Payload should be in range [-1:28) (-1 means no block is allocated)!&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;case 1, %Transport block size&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;% Transport block size = 0 means no data allocated&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;for n = 1:size(UE1_Payload,1)*size(UE1_Payload,2)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;if (UE1_Payload(n) &lt; 0 )% || UE1_Payload(i) &gt; 4)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;error(&apos;When UE1_Config is set to Transport block size, the integer value in UE1_Payload should be in range [0:inf) (0 means no block is allocated)!&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;case 2, %Code rate&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;%TODO: Code rate range?&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;for n = 1:size(UE1_Payload,1)*size(UE1_Payload,2)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;if (UE1_Payload(n) &lt; 0  || UE1_Payload(n) &gt; 10.0)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;error(&apos;When UE1_Config is set to \&quot;Code rate\&quot;, the float value in UE1_Payload should be in range [0:10] (0 means no block is allocated)!&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;% Check UE1_MappingType&#x000D;&#x000A;% The size of UE1_MappingType could be 1, 2, 10 or 20&#x000D;&#x000A;if 2 == UE1_NumOfCWs &amp;&amp; 2*G_NUM_SUBFRAMES ~= size(UE1_MappingType,1)*size(UE1_MappingType,2) &amp;&amp; 2*1 ~= size(UE1_MappingType,1)*size(UE1_MappingType,2) ...&#x000D;&#x000A;                            &amp;&amp; G_NUM_SUBFRAMES ~= size(UE1_MappingType,1)*size(UE1_MappingType,2) &amp;&amp; 1 ~= size(UE1_MappingType,1)*size(UE1_MappingType,2)&#x000D;&#x000A;&#x0009;error(&apos;Whit two code words, the size of UE1_MappingType should be 1x1, 1x2, 10x1 or 10x2.&apos;);&#x000D;&#x000A;elseif 1 == UE1_NumOfCWs &amp;&amp; G_NUM_SUBFRAMES ~= size(UE1_MappingType,1)*size(UE1_MappingType,2) &amp;&amp; 1 ~= size(UE1_MappingType,1)*size(UE1_MappingType,2)&#x000D;&#x000A;&#x0009;error(&apos;The size of UE1_MappingType should be 1x1 or 10x1.&apos;);&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;for n = 1:size(UE1_MappingType,1)*size(UE1_MappingType,2)&#x000D;&#x000A;&#x0009;&#x0009;if  (UE1_MappingType(n) &lt; 0 || UE1_MappingType(n) &gt; 2)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;error(&apos;The integer value in UE1_MappingType should be in range [0:2].&apos;);&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;%Need to allow different input sizes&#x000D;&#x000A;UEs_RB_Alloc{1} = UE1_RB_Alloc;&#x000D;&#x000A;UEs_RB_Alloc{2} = UE2_RB_Alloc;&#x000D;&#x000A;UEs_RB_Alloc{3} = UE3_RB_Alloc;&#x000D;&#x000A;UEs_RB_Alloc{4} = UE4_RB_Alloc;&#x000D;&#x000A;UEs_RB_Alloc{5} = UE5_RB_Alloc;&#x000D;&#x000A;UEs_RB_Alloc{6} = UE6_RB_Alloc;&#x000D;&#x000A;&#x000D;&#x000A;% get PRB bitmaps for six UEs from the input parameter RB_AllocType, UEx_RB_Alloc&#x000D;&#x000A;% call function: [UEs_RB_AllocOutVVV, RB_NumVV]&#x0009;= LTE_getUEsAlloc(link,&#x0009;frameMode,...&#x000D;&#x000A;%&#x0009;&#x0009;&#x0009;&#x0009;  TDD_Config, type,&#x0009;UEs_RB_AllocInVV)&#x000D;&#x000A;% the output is&#x0009;the&#x0009;RB list&#x0009;for&#x0009;each subframe for each UE&#x000D;&#x000A;[UEs_RB_AllocOut] =&#x0009;LTE_getUEsAlloc(0, FrameMode, TDD_Config, RB_AllocType,&#x0009;UEs_RB_Alloc);&#x000D;&#x000A;&#x000D;&#x000A;%check whther the RB allocation&#x0009;for&#x0009;all&#x0009;six&#x0009;UEs&#x0009;in each&#x0009;subframe is&#x0009;valid&#x000D;&#x000A;[errorFlag,&#x0009;msg] = LTE_checkUEsAlloc(RB_AllocType, G_NUM_RBS_PER_SYMBOL(Bandwidth+1), UEs_RB_AllocOut, 0);&#x000D;&#x000A;if (0 ~= errorFlag)&#x000D;&#x000A;&#x0009;error(msg);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;% Check&#x0009;OtherUEs_MappingType&#x000D;&#x000A;% The size of OtherUEs_MappingType could be&#x0009;fixed to 5 or 10 (for two codewords)&#x000D;&#x000A;if G_MAX_NUM_UES - 1 ~=&#x0009;size(OtherUEs_MappingType,1)*size(OtherUEs_MappingType,2) &amp;&amp; 2*(G_MAX_NUM_UES-1) ~=&#x0009;size(OtherUEs_MappingType,1)*size(OtherUEs_MappingType,2)&#x000D;&#x000A;&#x0009;error(&apos;The size of OtherUEs_MappingType should be 5x1 or 5x2.&apos;);&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;for n = 1:size(OtherUEs_MappingType,1)*size(OtherUEs_MappingType,2)&#x000D;&#x000A;&#x0009;&#x0009;if&#x0009;(OtherUEs_MappingType(n) &lt; 0 || OtherUEs_MappingType(n) &gt; 2)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;error(&apos;The integer value in OtherUEs_MappingType should be in range [0:2].&apos;);&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;% Check&#x0009;UE1_RV_Idx&#x000D;&#x000A;for n = 1:size(UE1_RV_Sequence, 1) * size(UE1_RV_Sequence, 2)&#x000D;&#x000A;&#x0009;if&#x0009;(UE1_RV_Sequence(n)&#x0009;&lt; 0&#x0009;|| UE1_RV_Sequence(n) &gt;&#x0009;3)&#x000D;&#x000A;&#x0009;&#x0009;error(&apos;The integer value in UE1_RV_Sequence should be&#x0009;in range [0:3].&apos;);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;% Check&#x0009;UE1_n_RNTI&#x000D;&#x000A;if&#x0009;(UE1_n_RNTI&#x0009;&lt; 0&#x0009;|| UE1_n_RNTI &gt;&#x0009;2e16 - 1)&#x000D;&#x000A;&#x0009;error(&apos;The UE1_n_RNTI should be&#x0009;in range [0:2e16-1].&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;% Check&#x0009;UE1_Category&#x000D;&#x000A;if&#x0009;(UE1_Category &lt; 0 || UE1_Category &gt; 4)&#x000D;&#x000A;&#x0009;error(&apos;The UE1_Category should be in&#x0009;range [0:4].&apos;);&#x000D;&#x000A;end&#x0009; &#x000D;&#x000A;&#x000D;&#x000A;% Check PDCCH_SymsPerSF&#x000D;&#x000A;%0:&#x0009;uplink subframe; 1:&#x0009;downlink subframe; 2: special subframe&#x000D;&#x000A;%TDD mode mask&#x000D;&#x000A;mask = ones(G_NUM_SUBFRAMES, 1);%deault&#x0009;for&#x0009;FDD&#x000D;&#x000A;mask = G_TDD_CONFIG_TABLE(TDD_Config+1,:);&#x000D;&#x000A;&#x000D;&#x000A;if size(PDCCH_SymsPerSF,1)*size(PDCCH_SymsPerSF,2) ~= 10 &amp;&amp;&#x0009;size(PDCCH_SymsPerSF,1)*size(PDCCH_SymsPerSF,2)&#x0009;~= 1&#x000D;&#x000A;&#x0009;error(&apos;The size of PDCCH_SymsPerSF should be equal to 1 or 10.&apos;);&#x000D;&#x000A;elseif (0 == FrameMode) % for FDD Mode&#x000D;&#x000A;&#x0009;for&#x0009;n =&#x0009;1:G_NUM_SUBFRAMES&#x000D;&#x000A;&#x0009;pdcch_Syms = PDCCH_SymsPerSF(mod(n,size(PDCCH_SymsPerSF,1)*size(PDCCH_SymsPerSF,2))+1);&#x000D;&#x000A;&#x0009;&#x0009;if (G_NUM_RBS_PER_SYMBOL(Bandwidth+1) &gt;&#x0009;10)&#x0009;%when NumRBs &gt; 10&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;if (pdcch_Syms &lt; 0 || pdcch_Syms &gt; 3)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;error(&apos;The element of PDCCH_SymsPerSF in donwlink subframes should be in range of [0,3].&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;end&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;else %when NumRBs &lt; 10&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;if ( pdcch_Syms ~= 0 &amp;&amp; pdcch_Syms ~= 2 &amp;&amp; pdcch_Syms ~= 3 &amp;&amp; pdcch_Syms ~= 4)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;error(&apos;The element of PDCCH_SymsPerSF in donwlink subframes should be chosen from {0, 2, 3, 4} for number of RBs no large than 10.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;end&#x0009;&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;else % for TDD Mode&#x000D;&#x000A;&#x0009;for&#x0009;n =&#x0009;1:G_NUM_SUBFRAMES&#x000D;&#x000A;&#x0009;&#x0009;pdcch_Syms = PDCCH_SymsPerSF(mod(n,size(PDCCH_SymsPerSF,1)*size(PDCCH_SymsPerSF,2))+1) * (mask(n) ~= 0);&#x000D;&#x000A;&#x0009;&#x0009;if (G_NUM_RBS_PER_SYMBOL(Bandwidth+1) &gt;&#x0009;10)&#x0009;%when NumRBs &gt; 10&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;if(1 ==&#x0009;n-1&#x0009;|| 6 ==&#x0009;n-1)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;if (pdcch_Syms &lt;&#x0009;0 || pdcch_Syms &gt; 2)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;error(&apos;The element of PDCCH_SymsPerSF in donwlink subframes should be in range of [0,2].&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;end&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;else&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;if( pdcch_Syms &lt; 0 || pdcch_Syms &gt; 3)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;error(&apos;When TDD mode, the element of PDCCH_SymsPerSF for subFrames other than 1 or 6 should be in range of [0,3].&apos; );&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;end&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;else %when NumRBs &lt; 10&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;if(1 ==&#x0009;n-1&#x0009;|| 6 ==&#x0009;n-1)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;if (pdcch_Syms ~= 0 &amp;&amp; pdcch_Syms ~= 2)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;error(&apos;When TDD mode, the element of PDCCH_SymsPerSF for subFrames 1 or 6 should be chosen from {0, 2}.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;end&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;else&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;if( pdcch_Syms ~= 0 &amp;&amp;  pdcch_Syms ~= 2&#x0009;&amp;&amp; pdcch_Syms ~= 3 &amp;&amp; pdcch_Syms ~= 4)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;error(&apos;When TDD mode, the element of PDCCH_SymsPerSF for subFrames other than 1 or 6 should be chosen from {0, 2, 3, 4} for number of RBs no large than 10.&apos; );&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;end&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;% Check&#x0009;PDCCH_UE_AggreLevel&#x0009;and&#x0009;set&#x0009;the&#x0009;number of PDCCH&#x0009;candidates for one frame for UE-specific type**** a3&#x000D;&#x000A;% The size of PDCCH_UE_AggreLevel could&#x0009;be 1 or&#x0009;10&#x000D;&#x000A;% Type 1: size=1, all the subframes&#x0009;share the same PDCCH_UE_AggreLevel&#x000D;&#x000A;% Type 2: size=10, each&#x0009;subframe has its own PDCCH_UE_AggreLevel&#x000D;&#x000A;&#x000D;&#x000A;vectorSize = size(PDCCH_UE_AggreLevel,1)* size(PDCCH_UE_AggreLevel,2);&#x000D;&#x000A;if (1 ~= vectorSize&#x0009;&amp;&amp; 10 ~= vectorSize)&#x000D;&#x000A;&#x0009;error(&apos;PDCCH_UE_AggreLevel should have ten elements(one&#x0009;per&#x0009;subframe) or have only one element!&apos;);&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;for&#x0009;n =&#x0009;1:vectorSize&#x000D;&#x000A;&#x0009;&#x0009;if (PDCCH_UE_AggreLevel(n) ~= 1&#x0009;&amp;&amp; PDCCH_UE_AggreLevel(n) ~= 2 &amp;&amp; PDCCH_UE_AggreLevel(n) ~=&#x0009;4 &amp;&amp; PDCCH_UE_AggreLevel(n) ~= 8)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;error(&apos;The integer value in PDCCH_UE_AggreLevel should be&#x0009;{1,&#x0009;2, 4, 8}.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;% Check&#x0009;PDCCH_Common_AggreLevel&#x0009;and&#x0009;set&#x0009;the&#x0009;number of PDCCH&#x0009;candidates for one frame for common&#x0009;type*****  a4&#x000D;&#x000A;% The size of PDCCH_Common_AggreLevel could&#x0009;be 1 or&#x0009;10&#x000D;&#x000A;% Type 1: size=1, all the subframes&#x0009;share the same PDCCH_Common_AggreLevel&#x000D;&#x000A;% Type 2: size=10, each&#x0009;subframe has its own PDCCH_Common_AggreLevel&#x000D;&#x000A;&#x000D;&#x000A;vectorSize = size(PDCCH_Common_AggreLevel,1)* size(PDCCH_Common_AggreLevel,2);&#x000D;&#x000A;if (1 ~= vectorSize&#x0009;&amp;&amp; 10 ~= vectorSize)&#x000D;&#x000A;&#x0009;error(&apos;PDCCH_Common_AggreLevel should have ten elements(one&#x0009;per&#x0009;subframe) or have only one element!&apos;);&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;for&#x0009;n =&#x0009;1:vectorSize&#x000D;&#x000A;&#x0009;&#x0009;if (PDCCH_Common_AggreLevel(n) ~= 4&#x0009;&amp;&amp; PDCCH_Common_AggreLevel(n) ~= 8)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;error(&apos;The integer value in&#x0009;PDCCH_Common_AggreLevel&#x0009;should be {4, 8}.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;% Check&#x0009;PDCCH_UE_DCI_Formats  ****a5&#x000D;&#x000A;&#x0009;% The size of DCI_Formats could&#x0009;be 6 or&#x0009;10*6&#x000D;&#x000A;&#x0009;% Type 1: size=6, all the subframes&#x0009;share the same DCI formats for the UE-specific PDCCHs&#x000D;&#x000A;&#x0009;% Type 2: size=10*6, each subframe has its own DCI formats,&#x0009;the&#x0009;DCIs in&#x0009;one&#x0009;subframe share the same&#x0009;DCI&#x0009;format&#x000D;&#x000A;&#x0009;% Note that:  -1 means no more DCIs&#x0009;are&#x0009;allcoated in thie subframe&#x000D;&#x000A;&#x0009;% Note that:  for Aggregation level&#x0009;=4 or 8, only 2&#x0009;candidates available, so the last 4&#x0009;will be&#x0009;discarded&#x000D;&#x000A;&#x000D;&#x000A;vectorSize = size(PDCCH_UE_DCI_Formats,1)* size(PDCCH_UE_DCI_Formats,2);&#x000D;&#x000A;if (6 ~= vectorSize&#x0009;&amp;&amp; 60 ~= vectorSize)&#x000D;&#x000A;&#x0009;error(&apos;PDCCH_UE_DCI_Formats&#x0009;should have&#x0009;6x10 elements(6&#x0009;per&#x0009;subframe) or have only 6 elements!&apos;);&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;for n = 1:vectorSize&#x000D;&#x000A;&#x0009;&#x0009;if (0 &lt; m_numTxAntsIdx)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;if&#x0009;(PDCCH_UE_DCI_Formats(n) &lt; -1 || PDCCH_UE_DCI_Formats(n) &gt; 7)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;error(&apos;The integer value in&#x0009;PDCCH_UE_DCI_Formats should&#x0009;be in range&#x0009;[-1:7].&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;elseif(&#x0009;PDCCH_UE_DCI_Formats(n)&#x0009;== 4)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;error(&apos;The PDCCH_UE_DCI_Formats&#x0009;1C is not supported.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;else&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;if&#x0009;(PDCCH_UE_DCI_Formats(n) &lt; -1 || PDCCH_UE_DCI_Formats(n) &gt; 2)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;error(&apos;The integer value in&#x0009;PDCCH_UE_DCI_Formats should&#x0009;be in range&#x0009;[-1:2] when&#x0009;NumTxAnts is Tx1.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;% Check&#x0009;PDCCH_Common_DCI_Formats  *****a6&#x000D;&#x000A;&#x0009;% The size of DCI_Formats could&#x0009;be 4 or&#x0009;10*4&#x000D;&#x000A;&#x0009;% Type 1: size=4, all the subframes&#x0009;share the same DCI formats for the UE-specific PDCCHs&#x000D;&#x000A;&#x0009;% Type 2: size=10*4, each subframe has its own DCI formats,&#x0009;the&#x0009;DCIs in&#x0009;one&#x0009;subframe share the same&#x0009;DCI&#x0009;format&#x000D;&#x000A;&#x0009;% Note that:  -1 means no more DCIs&#x0009;are&#x0009;allcoated in thie subframe&#x000D;&#x000A;&#x0009;% Note that:  for Aggregation level&#x0009;=8,&#x0009;only 2 candidates available, so&#x0009;the&#x0009;last 4 will&#x0009;be discarded&#x000D;&#x000A;vectorSize = size(PDCCH_Common_DCI_Formats,1)* size(PDCCH_Common_DCI_Formats,2);&#x000D;&#x000A;if(4 ~=&#x0009;vectorSize &amp;&amp; 40 ~=&#x0009;vectorSize)&#x000D;&#x000A;&#x0009;error(&apos;PDCCH_Common_DCI_Formats&#x0009;should have&#x0009;4x10 elements(4&#x0009;per&#x0009;subframe) or have only 4 elements!&apos;);&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;for&#x0009;n =&#x0009;1:vectorSize&#x000D;&#x000A;&#x0009;&#x0009;if (0 &lt;&#x0009;m_numTxAntsIdx)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;if&#x0009;(PDCCH_Common_DCI_Formats(n) &lt; -1 || PDCCH_Common_DCI_Formats(n) &gt; 7)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;error(&apos;The integer value in&#x0009;PDCCH_Common_DCI_Formats should&#x0009;be in range&#x0009;[-1:7].&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;elseif(&#x0009;PDCCH_Common_DCI_Formats(n)&#x0009;== 4)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;error(&apos;The PDCCH_Common_DCI_Formats&#x0009;1C is not supported.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;else&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;if (PDCCH_Common_DCI_Formats(n)&#x0009;&lt; -1 ||&#x0009;PDCCH_Common_DCI_Formats(n)&#x0009;&gt; 2)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;error(&apos;The integer value in&#x0009;PDCCH_Common_DCI_Formats should&#x0009;be in range&#x0009;[-1:2] when&#x0009;NumTxAnts is Tx1.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;% Check&#x0009;HI&#x000D;&#x000A;if(0 == CyclicPrefix)&#x000D;&#x000A;&#x0009;m_NumPHICHs&#x0009;= 8;&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;m_NumPHICHs&#x0009;= 4;&#x0009;   &#x000D;&#x000A;end&#x0009;&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;m_HISize_F = size(HI,1)*size(HI,2);&#x000D;&#x000A;if(1 ~=&#x0009;m_HISize_F &amp;&amp; G_NUM_SUBFRAMES ~= m_HISize_F&#x0009;&amp;&amp; m_NumPHICHs ~= m_HISize_F &amp;&amp;&#x0009;m_NumPHICHs&#x0009;* G_NUM_SUBFRAMES ~= m_HISize_F)&#x000D;&#x000A;&#x0009;error(&apos;The size of HI should be&#x0009;1 or 10&#x0009;or NumOfPHICHs_per_PHICH_group or 10xNumOfPHICHs_per_PHICH_group.&apos;);&#x0009; &#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;for&#x0009;n =&#x0009;1:m_HISize_F&#x000D;&#x000A;&#x0009;&#x0009;if(HI(n) &lt; -1 || HI(n) &gt; 1)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;error(&apos;The elements&#x0009;of HI should be&#x0009;in range [-1:1].&apos;);&#x000D;&#x000A;&#x0009;&#x0009;end&#x0009;&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;%check BCH_BlockSize&#x000D;&#x000A;%if ( BCH_BlockSize &lt; 1 )&#x000D;&#x000A;%&#x0009;error(&apos;The parameter BCH_BlockSize should be in&#x0009;range [1:inf).&apos;);&#x000D;&#x000A;%end&#x000D;&#x000A;&#x000D;&#x000A;% Check&#x0009;PHICH_Duration&#x000D;&#x000A;if&#x0009;(PHICH_Duration&#x0009;&lt; 0&#x0009;|| PHICH_Duration &gt;&#x0009;1)&#x000D;&#x000A;&#x0009;error(&apos;The PHICH_Duration should be&#x0009;chosen from&#x0009;{Normal_Duration, Extended_Duration}.&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;% Check&#x0009;PHICH_Ng&#x000D;&#x000A;if&#x0009;(PHICH_Ng &lt;&#x0009;0 || PHICH_Ng &gt;&#x0009;3)&#x000D;&#x000A;&#x0009;error(&apos;The PHICH_Ng should be chosen from {Ng 1/6, Ng 1/2, Ng 1, Ng&#x0009;2}.&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;% Check&#x0009;IdleInterval&#x000D;&#x000A;%if&#x0009;(IdleInterval &lt;&#x0009;0)&#x000D;&#x000A;%&#x0009;error(&apos;The value of IdleInterval should not be negative.&apos;);&#x000D;&#x000A;%end&#x000D;&#x000A;&#x000D;&#x000A;% Check&#x0009;SpectrumShapingType&#x000D;&#x000A;if&#x0009;(SpectrumShapingType &lt; 0 ||&#x0009;SpectrumShapingType&#x0009;&gt; 3)&#x000D;&#x000A;&#x0009;error(&apos;The SpectrumShapingType should be chosen&#x0009;from {TimeWindowing, FIRFilter}.&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;% Check&#x0009;WindowType&#x000D;&#x000A;if ( 0 == SpectrumShapingType) %TimeWindowing&#x000D;&#x000A;&#x0009;if&#x0009;(WindowType&#x0009;&lt; 0&#x0009;|| WindowType &gt;&#x0009;1)&#x000D;&#x000A;&#x0009;&#x0009;error(&apos;The WindowType should be chosen from&#x0009;{Tukey,&#x0009;Raised cosine}.&apos;);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;% Check&#x0009;CyclicInterval&#x000D;&#x000A;if ( 0 == SpectrumShapingType) %TimeWindowing&#x000D;&#x000A;&#x0009;if&#x0009;(CyclicInterval&#x0009;&lt; 0&#x0009;|| CyclicInterval &gt;&#x0009;96)&#x000D;&#x000A;&#x0009;&#x0009;error(&apos;The CyclicInterval should be&#x0009;in range [0:96].&apos;);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;% Check&#x0009;CI_StartPos&#x000D;&#x000A;if&#x0009;(-96 &gt; CI_StartPos || 0&#x0009;&lt; CI_StartPos)&#x000D;&#x000A;&#x0009;error(&apos;\nCI_StartPos should be in range [-96:0]!&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;% Check&#x0009;FIR_Taps&#x000D;&#x000A;if (1 == SpectrumShapingType) %FIRFilter&#x000D;&#x000A;&#x0009;if&#x0009;(FIR_Taps &lt;&#x0009;1 || FIR_Taps &gt;&#x0009;1024)&#x000D;&#x000A;&#x0009;&#x0009;error(&apos;The FIR_Taps should be in range [1:1024].&apos;);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;% Check&#x0009;FIR_withInterp&#x000D;&#x000A;if (1 == SpectrumShapingType) %FIRFilter&#x000D;&#x000A;&#x0009;if&#x0009;(FIR_withInterp&#x0009;&lt; 0&#x0009;|| FIR_withInterp &gt;&#x0009;1)&#x000D;&#x000A;&#x0009;&#x0009;error(&apos;The FIR_withInterp should be&#x0009;chosen from&#x0009;{NO, YES}.&apos;);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;% Check&#x0009;FIR_FilterType&#x000D;&#x000A;if (1 == SpectrumShapingType) %FIRFilter&#x000D;&#x000A;&#x0009;if&#x0009;(FIR_FilterType &lt; 0&#x0009;|| FIR_FilterType &gt;&#x0009;2)&#x000D;&#x000A;&#x0009;&#x0009;error(&apos;The FIR_FilterType should be&#x0009;chosen from&#x0009;{RRC, Ideal&#x0009;Lowpass, EquiRipple}.&apos;);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;% Check&#x0009;RRC_Alpha&#x000D;&#x000A;if (1 == SpectrumShapingType) %FIRFilter&#x000D;&#x000A;&#x0009;if&#x0009;(RRC_Alpha &lt; 0.0 ||&#x0009;RRC_Alpha &gt;&#x0009;1.0)&#x000D;&#x000A;&#x0009;&#x0009;error(&apos;The RRC_Alpha should be in range&#x0009;[0:1.0].&apos;);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;% Check&#x0009;RS_EPRE&#x000D;&#x000A;% Check&#x0009;PCFICH_Ra&#x000D;&#x000A;% Check&#x0009;PHICH_Ra&#x000D;&#x000A;% Check&#x0009;PHICH_Rb&#x000D;&#x000A;% Check&#x0009;PBCH_Ra&#x000D;&#x000A;% Check&#x0009;PBCH_Rb&#x000D;&#x000A;% Check&#x0009;PDCCH_Ra&#x000D;&#x000A;% Check&#x0009;PDCCH_Rb&#x000D;&#x000A;% Check  PDSCH_PowerRatio&#x000D;&#x000A;if (PDSCH_PowerRatio &lt; 0 || PDSCH_PowerRatio &gt; 4)&#x000D;&#x000A;   error(&apos;PDSCH_PowerRatio should be in range [0:4].&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;% Check&#x0009;UEs_Pa&#x000D;&#x000A;% The size of UEs_Pa could be fixed&#x0009;to 6&#x000D;&#x000A;if (G_MAX_NUM_UES ~= size(UEs_Pa,1)*size(UEs_Pa,2))&#x000D;&#x000A;&#x0009;error(&apos;The size of UEs_Pa should be&#x0009;6.&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;% Check UE1_NumHARQ&#x000D;&#x000A;if (1 == UE1_HARQ_Enable)&#x000D;&#x000A;&#x0009;if (UE1_NumHARQ &lt; 4 || UE1_NumHARQ &gt; 14)&#x000D;&#x000A;&#x0009;&#x0009;error(&apos;UE1_NumHARQ should be in range [4:14]!&apos;);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;% Check UE1_MaxHARQTrans&#x000D;&#x000A;if (1 == UE1_HARQ_Enable)&#x000D;&#x000A;&#x0009;if (UE1_MaxHARQTrans &lt; 1 || UE1_MaxHARQTrans &gt; 8)&#x000D;&#x000A;&#x0009;&#x0009;error(&apos;UE1_MaxHARQTrans should be in range [1:8]!&apos;);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;% Check&#x0009;PSS_Rb&#x000D;&#x000A;% Check&#x0009;SSS_Rb&#x000D;&#x000A;</Text>
<UnitUse><T>Int</T><D>2</D></UnitUse>
