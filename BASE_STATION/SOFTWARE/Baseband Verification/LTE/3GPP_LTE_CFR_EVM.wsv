<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="PBCH_Rb" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>PBCH-to-RS EPRE ratio in dB in symbols without RS</Description>
<HideCondition>0==ShowPowerParameters</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="PCFICH_Rb" Type="PartParam">
<DataEntry>0</DataEntry>
