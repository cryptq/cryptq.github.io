<HideCondition>0==MBSFN_Enable</HideCondition>
<Validate><T>Int</T><D>14</D></Validate></Item>
<Item XName="MBSFN_AreaID" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>MBSFN Area ID used for scrambling MBSFN RS and PMCH</Description>
<HideCondition>0==MBSFN_Enable</HideCondition>
<Validate><T>Int</T><D>11</D></Validate></Item>
<Item XName="MBSFN_Enable" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>whether MBSFN is enabled or not</Description>
<Enum>LTE_HARQ_Controller__MBSFN_Enable@LTE 8.9 Enums</Enum>
<Validate><T>Int</T><D>16</D></Validate></Item>
