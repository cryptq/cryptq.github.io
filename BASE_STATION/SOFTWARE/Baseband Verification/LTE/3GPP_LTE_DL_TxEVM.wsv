<HideCondition>0==MBSFN_Enable</HideCondition>
<Validate><T>Int</T><D>11</D></Validate></Item>
<Item XName="MBSFN_FrameAllocPeriod" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>number of repetition period of radio-frames that contain MBSFN</Description>
<Enum>LTE_DL_Src_MBSFN_FrameAllocPeriod@LTE 8.9 Enums</Enum>
<HideCondition>0==MBSFN_Enable</HideCondition>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="MBSFN_MCSIndex" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>the MCS index of MCH</Description>
<HideCondition>0==MBSFN_Enable</HideCondition>
<Validate><T>Int</T><D>11</D></Validate></Item>
<Item XName="MBSFN_RS_Ra" Type="PartParam">
<DataEntry>0</DataEntry>
