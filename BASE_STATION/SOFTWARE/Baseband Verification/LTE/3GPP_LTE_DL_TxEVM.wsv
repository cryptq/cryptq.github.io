<Enum>LTE_DL_MIMO_2Ant_Src_FrameMode@LTE 8.9 Enums</Enum>
<HideCondition>0==ShowSystemParameters</HideCondition>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="FrameNum" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>frame number</Description>
<HideCondition>0==PRS_Enable &amp;&amp; 0==MBSFN_Enable</HideCondition>
<Validate><T>Int</T><D>11</D></Validate></Item>
<Item XName="HI" Type="PartParam">
<DataEntry>[1,-1,-1,-1,-1,-1,-1,-1]</DataEntry>
<Description>physical hybrid-ARQ ACK/NAK indicators</Description>
<HideCondition>0==ShowControlChannelParameters || sum(PDCCH_SymsPerSF) == 0</HideCondition>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="MBSFN_AllocBitmap" Type="PartParam">
<DataEntry>[1,1,1,1,1,1]</DataEntry>
<Description>6 bits length bitmap for MBSFN allocation in subframes</Description>
<HideCondition>0==MBSFN_Enable</HideCondition>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="MBSFN_AntMappingMatrix" Type="PartParam">
<DataEntry>[1,1]</DataEntry>
