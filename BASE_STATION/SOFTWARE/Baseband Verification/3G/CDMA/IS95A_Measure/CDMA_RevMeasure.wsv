<Text>y = getvariable(&apos;DataProcessing&apos;, &apos;CDF_ToMean&apos;);&#x000D;&#x000A;x = getvariable(&apos;DataProcessing&apos;, &apos;CDF_ToMean_index&apos;);&#x000D;&#x000A;setindep(&apos;y&apos;, &apos;x&apos;);</Text>
