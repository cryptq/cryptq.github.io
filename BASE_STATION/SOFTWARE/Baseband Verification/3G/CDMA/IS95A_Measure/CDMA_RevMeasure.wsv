<Item XName="DataProcessing" UserName="DataProcessing" Type="Equation">
<AutoCalc><T>Bool</T><D>1</D></AutoCalc>
<Selected><T>Bool</T><D>0</D></Selected>
<Text>Start=100;&#x000D;&#x000A;End=150;&#x000D;&#x000A;&#x000D;&#x000A;spec_mw=getvariable(&apos;Design1_Data&apos;,&apos;Spreaded_Spec_Power&apos;)*1000;&#x000D;&#x000A;Mega_Hertz=getvariable(&apos;Design1_Data&apos;,&apos;Spreaded_Spec_Power_Freq&apos;)/1e6;&#x000D;&#x000A;resbw=Mega_Hertz(2)-Mega_Hertz(1);&#x000D;&#x000A;Fwidth=round(0.03/resbw);&#x000D;&#x000A;FcenterLower=find(Mega_Hertz==825-1.23/2);&#x000D;&#x000A;FcenterHigher=find(Mega_Hertz==825+1.23/2);&#x000D;&#x000A;Fad_lower=find(Mega_Hertz==825-0.15-1.26/2);&#x000D;&#x000A;adjacent_power_spec = spec_mw(Fad_lower:(Fad_lower+Fwidth));&#x000D;&#x000A;adjacent_power=10*log10(sum(adjacent_power_spec));&#x000D;&#x000A;center_power_spec=spec_mw(FcenterLower:FcenterHigher);&#x000D;&#x000A;center_power = 10*log10(sum(center_power_spec)*0.03/1.23);&#x000D;&#x000A;ACPR= center_power-adjacent_power;&#x000D;&#x000A;&#x000D;&#x000A;T3=getvariable(&apos;Design1_Data&apos;,&apos;SpeardedSingal&apos;);&#x000D;&#x000A;PeakdB = max( db(T3) );&#x000D;&#x000A;MeandB = mean(db(T3));&#x000D;&#x000A;Data_GT_Mean=(db(T3)&gt;= MeandB).*db(T3)+(db(T3)&lt;MeandB).*MeandB;&#x000D;&#x000A;PeakToMean=abs(PeakdB-MeandB);&#x000D;&#x000A;MindB=min(db(T3));&#x000D;&#x000A;[CDF,CDF_index]=CDMA_cdf(db(T3),50,-30,PeakdB);&#x000D;&#x000A;[PDF,PDF_index]=CDMA_pdf(db(T3),50,-30,PeakdB);&#x000D;&#x000A;CCDF=100*(1.0-CDF);&#x000D;&#x000A;[CDF_GT_Mean,CDF_ToMean_index]=CDMA_cdf(Data_GT_Mean,50,MeandB,PeakdB);&#x000D;&#x000A;CDF_ToMean=100*(1.0-CDF_GT_Mean);</Text>
<UnitUse><T>Int</T><D>2</D></UnitUse>
