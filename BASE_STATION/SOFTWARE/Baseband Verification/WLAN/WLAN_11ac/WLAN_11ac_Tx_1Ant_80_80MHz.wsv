<ModelName>WLAN_11ac_Source</ModelName>
<SymbolName>SYM_WLAN_11ac_Source@WLAN 11ac Symbols</SymbolName>
<Item XName="ParamSet" Type="ParamSet">
<Item XName="AggregatedMPDU" Type="PartParam">
<DataEntry>AggregatedMPDU</DataEntry>
<Description>AggregatedMPDU for each user, 0: Non-AggregatedMPDU and 1: AggregatedMPDU</Description>
<Unit><T>Int</T><D>0</D></Unit>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="Bandwidth" Type="PartParam">
<DataEntry>Bandwidth</DataEntry>
<Description>Bandwidth</Description>
<Enum>WLAN_11ac_Source_Bandwidth@WLAN 11ac Enums</Enum>
<Unit><T>Int</T><D>0</D></Unit>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="CodingType" Type="PartParam">
<DataEntry>CodingType</DataEntry>
<Description>coding type for each user, 0: BCC and 1: LDPC</Description>
<Unit><T>Int</T><D>0</D></Unit>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="IdleInterval" Type="PartParam">
<DataEntry>IdleInterval</DataEntry>
<Description>Idle interval between two frame packet</Description>
<Unit><T>Int</T><D>7004</D></Unit>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="MCS" Type="PartParam">
<DataEntry>MCS</DataEntry>
<Description>Modulation coding scheme for each data stream, in range [0:9]</Description>
<Enum />
<Unit><T>Int</T><D>0</D></Unit>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="N_SS" Type="PartParam">
<DataEntry>1</DataEntry>
<Description>number of spatial streams for each user, range[1:8] for single active user and [1:4] for multi-active users</Description>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="NumMPDUPerUser" Type="PartParam">
<DataEntry>NumMPDUPerUser</DataEntry>
<Description>number of MPDU per user, range[0:8]</Description>
<Unit><T>Int</T><D>0</D></Unit>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="NumTx" Type="PartParam">
<DataEntry>NumTx</DataEntry>
<Description>The number of transmit antennas</Description>
<Unit><T>Int</T><D>0</D></Unit>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="NumUsers" Type="PartParam">
<DataEntry>1</DataEntry>
<Description>number of users</Description>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>11</D></Validate></Item>
<Item XName="OversampleRatio" Type="PartParam">
<DataEntry>OversampleRatio</DataEntry>
<Description>Oversample ratio, could be 1x, 2x, 4x and 8x</Description>
<Enum>WLAN_11ac_Source_OversampleRatio@WLAN 11ac Enums</Enum>
<Unit><T>Int</T><D>0</D></Unit>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="ReInitialize" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>whether reset the initial state of the scrambler each burst by or not</Description>
<Enum>WLAN_11ac_Source_ReInitialize@WLAN 11ac Enums</Enum>
<HideCondition>1</HideCondition>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="STBC" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>whether STBC is used or not</Description>
<Enum>WLAN_11ac_Source_STBC@WLAN 11ac Enums</Enum>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="ScrambleSeed" Type="PartParam">
<DataEntry>[1, 0, 1, 1, 1, 0, 1]</DataEntry>
<Description>initial state of scrambler(should not be all 0)</Description>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="ShortGI" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>whether short guard interval is used or not</Description>
<Enum>WLAN_11ac_Source_ShortGI@WLAN 11ac Enums</Enum>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="SpatialMappingMatrix" Type="PartParam">
<DataEntry>[1]</DataEntry>
<Description>user definned spatial mapping matrix</Description>
<Enum />
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>15</D></Validate></Item>
<Item XName="SpatialMappingScheme" Type="PartParam">
