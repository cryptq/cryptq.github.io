 3 * (sheet 2 of 2)       &#x000D;&#x000A;T(159 , 158) = 1 ; T(176 , 175) = 1 ; T(192 , 191) = 1 ; T(208 , 207) = 1 ; T(226 , 224) = 1 ; T(241 , 240) = 1 ; T(258 , 257) = 1 ;&#x000D;&#x000A;T(159 , 159) = 1 ; T(176 , 176) = 1 ; T(192 , 192) = 1 ; T(208 , 208) = 1 ; T(225 , 225) = 1 ; T(241 , 241) = 1 ; T(258 , 258) = 1 ;&#x000D;&#x000A;T(160 , 159) = 1 ; T(179 , 176) = 1 ; T(193 , 192) = 1 ; T(209 , 208) = 1 ; T(226 , 225) = 1 ; T(242 , 241) = 1 ; T(271 , 258) = 1 ;&#x000D;&#x000A;T(160 , 160) = 1 ; T(177 , 177) = 1 ; T(193 , 193) = 1 ; T(209 , 209) = 1 ; T(226 , 226) = 1 ; T(242 , 242) = 1 ; T(259 , 259) = 1 ;&#x000D;&#x000A;T(161 , 160) = 1 ; T(178 , 177) = 1 ; T(194 , 193) = 1 ; T(210 , 209) = 1 ; T(229 , 226) = 1 ; T(243 , 242) = 1 ; T(260 , 259) = 1 ;&#x000D;&#x000A;T(161 , 161) = 1 ; T(178 , 178) = 1 ; T(194 , 194) = 1 ; T(210 , 210) = 1 ; T(256 , 226) = 1 ; T(243 , 243) = 1 ; T(260 , 260) = 1 ;&#x000D;&#x000A;T(162 , 161) = 1 ; T(183 , 178) = 1 ; T(195 , 194) = 1 ; T(211 , 210) = 1 ; T(227 , 227) = 1 ; T(244 , 243) = 1 ; T(261 , 260) = 1 ;&#x000D;&#x000A;T(162 , 162) = 1 ; T(179 , 179) = 1 ; T(195 , 195) = 1 ; T(211 , 211) = 1 ; T(228 , 227) = 1 ; T(244 , 244) = 1 ; T(261 , 261) = 1 ;&#x000D;&#x000A;T(163 , 162) = 1 ; T(180 , 179) = 1 ; T(196 , 195) = 1 ; T(212 , 211) = 1 ; T(228 , 228) = 1 ; T(245 , 244) = 1 ; T(262 , 261) = 1 ;&#x000D;&#x000A;T(163 , 163) = 1 ; T(180 , 180) = 1 ; T(196 , 196) = 1 ; T(212 , 212) = 1 ; T(229 , 228) = 1 ; T(245 , 245) = 1 ; T(262 , 262) = 1 ;&#x000D;&#x000A;T(164 , 163) = 1 ; T(181 , 180) = 1 ; T(217 , 196) = 1 ; T(213 , 212) = 1 ; T(229 , 229) = 1 ; T(246 , 245) = 1 ; T(263 , 262) = 1 ;&#x000D;&#x000A;T(164 , 164) = 1 ; T(181 , 181) = 1 ; T(262 , 196) = 1 ; T(213 , 213) = 1 ; T(230 , 229) = 1 ; T(246 , 246) = 1 ; T(263 , 263) = 1 ;&#x000D;&#x000A;T(165 , 164) = 1 ; T(182 , 181) = 1 ; T(197 , 197) = 1 ; T(214 , 213) = 1 ; T(230 , 230) = 1 ; T(247 , 246) = 1 ; T(264 , 263) = 1 ;&#x000D;&#x000A;T(165 , 165) = 1 ; T(182 , 182) = 