1 ; T(272 , 270) = 1 ;&#x000D;&#x000A;T(172 , 172) = 1 ; T(189 , 188) = 1 ; T(204 , 204) = 1 ; T(221 , 221) = 1 ; T(237 , 237) = 1 ; T(254 , 254) = 1 ; T(271 , 271) = 1 ;&#x000D;&#x000A;T(173 , 172) = 1 ; T(255 , 188) = 1 ; T(205 , 204) = 1 ; T(222 , 221) = 1 ; T(238 , 237) = 1 ; T(259 , 254) = 1 ; T(272 , 272) = 1 ;&#x000D;&#x000A;T(173 , 173) = 1 ; T(189 , 189) = 1 ; T(205 , 205) = 1 ; T(222 , 222) = 1 ; T(238 , 238) = 1 ; T(255 , 255) = 1 ; T(273 , 272) = 1 ;&#x000D;&#x000A;T(174 , 173) = 1 ; T(190 , 189) = 1 ; T(206 , 205) = 1 ; T(223 , 222) = 1 ; T(239 , 238) = 1 ; T(256 , 255) = 1 ; T(273 , 273) = 1 ;&#x000D;&#x000A;T(174 , 174) = 1 ; T(190 , 190) = 1 ; T(206 , 206) = 1 ; T(223 , 223) = 1 ; T(239 , 239) = 1 ; T(256 , 256) = 1 ;         &#x000D;&#x000A;T(175 , 174) = 1 ; T(196 , 190) = 1 ; T(207 , 206) = 1 ; T(224 , 223) = 1 ; T(240 , 239) = 1 ; T(257 , 256) = 1 ;         &#x000D;&#x000A;T(175 , 175) = 1 ; T(191 , 191) = 1 ; T(207 , 207) = 1 ; T(224 , 224) = 1 ; T(240 , 240) = 1 ; T(257 , 257) = 1 ;         &#x000D;&#x000A;&#x000D;&#x000A;B = zeros(273,1);&#x000D;&#x000A;%Table 6.2-9. LDPC Submatrix B for Subframe 3 *&#x000D;&#x000A;B(  3,1) = 1 ;&#x000D;&#x000A;B( 20,1) = 1 ;&#x000D;&#x000A;B( 71,1) = 1 ;&#x000D;&#x000A;B( 76,1) = 1 ;&#x000D;&#x000A;B(124,1) = 1 ;&#x000D;&#x000A;B(137,1) = 1 ;&#x000D;&#x000A;B(155,1) = 1 ;&#x000D;&#x000A;B(195,1) = 1 ;&#x000D;&#x000A;B(222,1) = 1 ;&#x000D;&#x000A;B(253,1) = 1 ;&#x000D;&#x000A;&#x000D;&#x000A;C=zeros(1,274);&#x000D;&#x000A;%Table 6.2-10. LDPC Submatrix C for Subframe 3 *&#x000D;&#x000A;C(1 , 23) = 1 ;&#x000D;&#x000A;C(1 , 86) = 1 ;&#x000D;&#x000A;C(1 ,177) = 1 ;&#x000D;&#x000A;C(1 ,227) = 1 ;&#x000D;&#x000A;&#x000D;&#x000A;D=1;&#x000D;&#x000A;&#x000D;&#x000A;E=zeros(1,273);&#x000D;&#x000A;% Table 6.2-12. LDPC Submatrix E for Subframe 3 *&#x000D;&#x000A;E(1 , 271) = 1 ;&#x000D;&#x000A;E(1 , 273) = 1 ;&#x000D;&#x000A;&#x000D;&#x000A;inv_T = T^(-1);&#x000D;&#x000A;phi=-E*inv_T*B+D;&#x000D;&#x000A;phi=1/phi;&#x000D;&#x000A;&#x000D;&#x000A;sufrm3_p1 =-phi*(-E*inv_T*A+C);&#x000D;&#x000A;</Text>
