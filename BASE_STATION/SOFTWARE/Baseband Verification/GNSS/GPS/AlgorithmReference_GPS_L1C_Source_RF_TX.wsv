<Item XName="Text" Type="Param">
<DataEntry>A frame is divided into three subframes (9, 576 and 250 bits per each subframes, respectively.</DataEntry>
<TextParam><T>Bool</T><D>1</D></TextParam></Item></Item>
<Item XName="Annotate1" Type="TextA">
<BorderColor><T>Int</T><D>8388608</D></BorderColor>
<BorderStyle><T>Int</T><D>0</D></BorderStyle>
<BorderWeight><T>Int</T><D>3</D></BorderWeight>
<Color><T>Int</T><D>65535</D></Color>
<Filled><T>Bool</T><D>1</D></Filled>
<Height><T>Double</T><D>7500</D></Height>
<HorizMargin><T>Int</T><D>50</D></HorizMargin>
<Justification><T>Int</T><D>4</D></Justification>
