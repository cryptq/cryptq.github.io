<Item XName="EquationText" Type="PartParam">
<DataEntry>for i=1:1:8&#x000D;&#x000A;    reg(i) = input(8-i+1);&#x000D;&#x000A;end;&#x000D;&#x000A;for i=1:1:51&#x000D;&#x000A;&#x0009;prbs = xor(reg(8), reg(7));&#x000D;&#x000A;    prbs = xor(prbs, reg(6));&#x000D;&#x000A;    prbs = xor(prbs, reg(5));&#x000D;&#x000A;    prbs = xor(prbs, reg(4));&#x000D;&#x000A;    prbs = xor(prbs, reg(1));&#x000D;&#x000A;    output(i)=reg(8);&#x000D;&#x000A;&#x0009;for j=8:-1:2&#x000D;&#x000A;&#x0009;&#x0009;reg(j) = reg(j-1);&#x000D;&#x000A;    end&#x000D;&#x000A;    reg(1) = prbs;&#x000D;&#x000A;end&#x000D;&#x000A;output = output(:);&#x000D;&#x000A;</DataEntry>
