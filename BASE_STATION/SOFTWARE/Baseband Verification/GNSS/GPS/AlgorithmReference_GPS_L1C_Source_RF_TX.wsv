212154251101666336712060460023165576452512672467657511&apos;, ...&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&apos;66366266574212557744700552456412614613126404473630372707022131671535371100015274&apos;, ...&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&apos;36013370702414052703073274455111071117210605707155213236617472655557275446211741&apos;, ...&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&apos;56126513774504054131243703043446026056111123033714731665600312073526510233153071&apos;, ...&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&apos;12644611731332257743135470742405655473770247650623762624502074531557315240072103&apos;, ...&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&apos;31515520076724126570231224235772141717727117163673007652655073606664036375451466&apos;, ...&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&apos;21217162142522321425672230662160735001401106123570241717467750525423674050127166&apos;, ...&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&apos;65261523176043410524315016512002117520060205536045013674035054625355753674607443&apos;, ...&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&apos;45334053231110252232007630366020111364621230106660334674671650347343740042031025&apos;, ...&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&apos;14722113273441312161322634527330753666004677154117106067272741012660150346130177&apos;, ...&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&apos;23376333707746745415642500652013205125047604213260335767615463654121345400263601&apos;, ...&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&apos;26011074403616657663646543471220130723402345322543565362756051202703124204312772&apos;, ...&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&apos;63505724324511401421530713536756624004030600700343754654402601301026433475445530&apos;, ...&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&apos;31141430577564601135021756703424207137575401106156564102215264622222764422137620&apos;, ...&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&apos;063760247741074511741370134074142636346213253020&apos;];&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;&#x0009;LS_bits(1)=0;&#x000D;&#x000A;&#x0009;&#x0009;LS_bits(2)=1;&#x000D;&#x000A;&#x0009;&#x0009;idx=2;&#x000D;&#x000A;&#x0009;&#x0009;for ii=2:1:3408&#x000D;&#x000A;    &#x0009;&#x0009;&#x0009;v=LS(ii);&#x000D;&#x000A;    &#x0009;&#x0009;&#x0009;v = hex2dec(v);&#x000D;&#x000A;    &#x0009;&#x0009;&#x0009;if (v==0)&#x000D;&#x000A;        &#x0009;&#x0009;&#x0009;&#x0009;LS_bits(idx+1)=0;&#x000D;&#x000A;        &#x0009;&#x0009;&#x0009;&#x0009;LS_bits(idx+2)=0;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;LS_bits(idx+3)=0;&#x000D;&#x000A;    &#x0009;&#x0009;&#x0009;elseif (v==1)&#x000D;&#x000A;        &#x0009;&#x0009;&#x0009;&#x0009;LS_bits(idx+1)=0;&#x000D;&#x000A;        &#x0009;&#x0009;&#x0009;&#x0009;LS_bits(idx+2)=0;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;LS_bits(idx+3)=1;&#x000D;&#x000A;    &#x0009;&#x0009;&#x0009;elseif (v==2)&#x000D;&#x000A;        &#x0009;&#x0009;&#x0009;&#x0009;LS_bits(idx+1)=0;&#x000D;&#x000A;        &#x0009;&#x0009;&#x0009;&#x0009;LS_bits(idx+2)=1;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;LS_bits(idx+3)=0;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;elseif (v==3)&#x000D;&#x000A;        &#x0009;&#x0009;&#x0009;&#x0009;LS_bits(idx+1)=0;&#x000D;&#x000A;        &#x0009;&#x0009;&#x0009;&#x0009;LS_bits(idx+2)=1;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;LS_bits(idx+3)=1;&#x000D;&#x000A;    &#x0009;&#x0009;&#x0009;elseif (v==4)&#x000D;&#x000A;        &#x0009;&#x0009;&#x0009;&#x0009;LS_bits(idx+1)=1;&#x000D;&#x000A;        &#x0009;&#x0009;&#x0009;&#x0009;LS_bits(idx+2)=0;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;LS_bits(idx+3)=0;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;elseif (v==5)&#x000D;&#x000A;        &#x0009;&#x0009;&#x0009;&#x0009;LS_bits(idx+1)=1;&#x000D;&#x000A;        &#x0009;&#x0009;&#x0009;&#x0009;LS_bits(idx+2)=0;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;LS_bits(idx+3)=1;&#x000D;&#x000A;    &#x0009;&#x0009;&#x0009;elseif (v==6)&#x000D;&#x000A;        &#x0009;&#x0009;&#x0009;&#x0009;LS_bits(idx+1)=1;&#x000D;&#x000A;        &#x0009;&#x0009;&#x0009;&#x0009;LS_bits(idx+2)=1;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;LS_bits(idx+3)=0;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;else&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;LS_bits(idx+1)=1;&#x000D;&#x000A;        &#x0009;&#x0009;&#x0009;&#x0009;LS_bits(idx+2)=1;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;LS_bits(idx+3)=1;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;    &#x0009;idx =idx+3;&#x000D;&#x000A;end</Text>
