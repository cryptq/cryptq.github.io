0D;&#x000A;    &#x0009;v = hex2dec(v);&#x000D;&#x000A;    &#x0009;if (v==0)&#x000D;&#x000A;        &#x0009;&#x0009;mij_bits(idx+1)=0;&#x000D;&#x000A;        &#x0009;&#x0009;mij_bits(idx+2)=0;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;mij_bits(idx+3)=0;&#x000D;&#x000A;    &#x0009;elseif (v==1)&#x000D;&#x000A;        &#x0009;&#x0009;mij_bits(idx+1)=0;&#x000D;&#x000A;        &#x0009;&#x0009;mij_bits(idx+2)=0;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;mij_bits(idx+3)=1;&#x000D;&#x000A;    &#x0009;elseif (v==2)&#x000D;&#x000A;        &#x0009;&#x0009;mij_bits(idx+1)=0;&#x000D;&#x000A;        &#x0009;&#x0009;mij_bits(idx+2)=1;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;mij_bits(idx+3)=0;&#x000D;&#x000A;&#x0009;&#x0009;elseif (v==3)&#x000D;&#x000A;        &#x0009;&#x0009;mij_bits(idx+1)=0;&#x000D;&#x000A;        &#x0009;&#x0009;mij_bits(idx+2)=1;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;mij_bits(idx+3)=1;&#x000D;&#x000A;    &#x0009;elseif (v==4)&#x000D;&#x000A;        &#x0009;&#x0009;mij_bits(idx+1)=1;&#x000D;&#x000A;        &#x0009;&#x0009;mij_bits(idx+2)=0;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;mij_bits(idx+3)=0;&#x000D;&#x000A;&#x0009;&#x0009;elseif (v==5)&#x000D;&#x000A;        &#x0009;&#x0009;mij_bits(idx+1)=1;&#x000D;&#x000A;        &#x0009;&#x0009;mij_bits(idx+2)=0;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;mij_bits(idx+3)=1;&#x000D;&#x000A;    &#x0009;elseif (v==6)&#x000D;&#x000A;        &#x0009;&#x0009;mij_bits(idx+1)=1;&#x000D;&#x000A;        &#x0009;&#x0009;mij_bits(idx+2)=1;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;mij_bits(idx+3)=0;&#x000D;&#x000A;&#x0009;&#x0009;else&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;mij_bits(idx+1)=1;&#x000D;&#x000A;        &#x0009;&#x0009;mij_bits(idx+2)=1;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;mij_bits(idx+3)=1;&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;        idx =idx+3;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;mij=mij_bits(1:11);&#x000D;&#x000A;FeedbackTaps = 