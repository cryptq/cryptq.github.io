<Item XName="Equations" Type="Equation">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>L2CL_Poly_Init=[...                  &#x000D;&#x000A;                                 &apos;624145772&apos;;...&#x000D;&#x000A;               &apos;506610362&apos;;...&#x000D;&#x000A;               &apos;220360016&apos;;...&#x000D;&#x000A;               &apos;710406104&apos;;...&#x000D;&#x000A;               &apos;001143345&apos;;...&#x000D;&#x000A;               &apos;053023326&apos;;...&#x000D;&#x000A;               &apos;652521276&apos;;...&#x000D;&#x000A;               &apos;206124777&apos;;...&#x000D;&#x000A;               &apos;015563374&apos;;...&#x000D;&#x000A;               &apos;561522076&apos;;...&#x000D;&#x000A;               &apos;023163525&apos;;...&#x000D;&#x000A;               &apos;117776450&apos;;...&#x000D;&#x000A;               &apos;606516355&apos;;...&#x000D;&#x000A;               &apos;003037343&apos;;...&#x000D;&#x000A;               &apos;046515565&apos;;...&#x000D;&#x000A;               &apos;671511621&apos;;...&#x000D;&#x000A;               &apos;605402220&apos;;...&#x000D;&#x000A;               &apos;002576207&apos;;...&#x000D;&#x000A;               &apos;525163451&apos;;...&#x000D;&#x000A;               &apos;266527765&apos;;...&#x000D;&#x000A;               &apos;006760703&apos;;...&#x000D;&#x000A;               &apos;501474556&apos;;...&#x000D;&#x000A;               &apos;743747443&apos;;...&#x000D;&#x000A;               &apos;615534726&apos;;...&#x000D;&#x000A;               &apos;763621420&apos;;...&#x000D;&#x000A;               &apos;720727474&apos;;...&#x000D;&#x000A;               &apos;700521043&apos;;...&#x000D;&#x000A;               &apos;222567263&apos;;...&#x000D;&#x000A;               &apos;132765304&apos;;...&#x000D;&#x000A;               &apos;746332245&apos;;...&#x000D;&#x000A;               &apos;102300466&apos;;...&#x000D;&#x000A;               &apos;255231716&apos;;...&#x000D;&#x000A;               &apos;437661701&apos;;...&#x000D;&#x000A;               &apos;717047302&apos;;...&#x000D;&#x000A;               &apos;222614207&apos;;...&#x000D;&#x000A;               &apos;561123307&apos;;...&#x000D;&#x000A;               &apos;240713073&apos;]       &#x000D;&#x000A;k = GPS_PRN_Signal_No;&#x000D;&#x000A;idx=0;&#x000D;&#x000A;&#x000D;&#x000A;for ii=1:1:9&#x000D;&#x000A;    &#x0009;v=L2CL_Poly_Init(k,ii);&#x000D;&#x000A;    &#x0009;v = hex2dec(v);&#x000D;&#x000A;    &#x0009;if (v==0)&#x000D;&#x000A;        &#x0009;&#x0009;mij(idx+1)=0;&#x000D;&#x000A;        &#x0009;&#x0009;mij(idx+2)=0;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;mij(idx+3)=0;&#x000D;&#x000A;    &#x0009;elseif (v==1)&#x000D;&#x000A;        &#x0009;&#x0009;mij(idx+1)=0;&#x000D;&#x000A;        &#x0009;&#x0009;mij(idx+2)=0;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;mij(idx+3)=1;&#x000D;&#x000A;    &#x0009;elseif (v==2)&#x000D;&#x000A;        &#x0009;&#x0009;mij(idx+1)=0;&#x000D;&#x000A;        &#x0009;&#x0009;mij(idx+2)=1;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;mij(idx+3)=0;&#x000D;&#x000A;&#x0009;&#x0009;elseif (v==3)&#x000D;&#x000A;        &#x0009;&#x0009;mij(idx+1)=0;&#x000D;&#x000A;        &#x0009;&#x0009;mij(idx+2)=1;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;mij(idx+3)=1;&#x000D;&#x000A;    &#x0009;elseif (v==4)&#x000D;&#x000A;        &#x0009;&#x0009;mij(idx+1)=1;&#x000D;&#x000A;        &#x0009;&#x0009;mij(idx+2)=0;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;mij(idx+3)=0;&#x000D;&#x000A;&#x0009;&#x0009;elseif (v==5)&#x000D;&#x000A;        &#x0009;&#x0009;mij(idx+1)=1;&#x000D;&#x000A;        &#x0009;&#x0009;mij(idx+2)=0;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;mij(idx+3)=1;&#x000D;&#x000A;    &#x0009;elseif (v==6)&#x000D;&#x000A;        &#x0009;&#x0009;mij(idx+1)=1;&#x000D;&#x000A;        &#x0009;&#x0009;mij(idx+2)=1;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;mij(idx+3)=0;&#x000D;&#x000A;&#x0009;&#x0009;else&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;mij(idx+1)=1;&#x000D;&#x000A;        &#x0009;&#x0009;mij(idx+2)=1;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;mij(idx+3)=1;&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;        idx =idx+3;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;L2CL_InitialState =28- find(mij ==1)&#x000D;&#x000A;</Text>
