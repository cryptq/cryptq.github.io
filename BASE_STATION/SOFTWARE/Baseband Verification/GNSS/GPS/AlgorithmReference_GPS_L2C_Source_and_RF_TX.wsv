<Item XName="Equations" Type="Equation">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>L2CM_Poly_Init=[...                  &#x000D;&#x000A;                  &apos;742417664&apos;;...    &#x000D;&#x000A;                  &apos;756014035&apos;;...    &#x000D;&#x000A;                  &apos;002747144&apos;;...    &#x000D;&#x000A;                  &apos;066265724&apos;;...    &#x000D;&#x000A;                  &apos;601403471&apos;;...    &#x000D;&#x000A;                  &apos;703232733&apos;;...    &#x000D;&#x000A;                  &apos;124510070&apos;;...    &#x000D;&#x000A;                  &apos;617316361&apos;;...    &#x000D;&#x000A;                  &apos;047541621&apos;;...    &#x000D;&#x000A;                  &apos;733031046&apos;;...    &#x000D;&#x000A;                  &apos;713512145&apos;;...    &#x000D;&#x000A;                  &apos;024437606&apos;;...    &#x000D;&#x000A;                  &apos;021264003&apos;;...    &#x000D;&#x000A;                  &apos;230655351&apos;;...    &#x000D;&#x000A;                  &apos;001314400&apos;;...    &#x000D;&#x000A;                  &apos;222021506&apos;;...    &#x000D;&#x000A;                  &apos;540264026&apos;;...    &#x000D;&#x000A;                  &apos;205521705&apos;;...    &#x000D;&#x000A;                  &apos;064022144&apos;;...    &#x000D;&#x000A;                  &apos;120161274&apos;;...    &#x000D;&#x000A;                  &apos;044023533&apos;;...    &#x000D;&#x000A;                  &apos;724744327&apos;;...    &#x000D;&#x000A;                  &apos;045743577&apos;;...    &#x000D;&#x000A;                  &apos;741201660&apos;;...    &#x000D;&#x000A;                  &apos;700274134&apos;;...    &#x000D;&#x000A;                  &apos;010247261&apos;;...    &#x000D;&#x000A;                  &apos;713433445&apos;;...    &#x000D;&#x000A;                  &apos;737324162&apos;;...    &#x000D;&#x000A;                  &apos;311627434&apos;;...    &#x000D;&#x000A;                  &apos;710452007&apos;;...    &#x000D;&#x000A;                  &apos;722462133&apos;;...    &#x000D;&#x000A;                  &apos;050172213&apos;;...    &#x000D;&#x000A;                  &apos;500653703&apos;;...    &#x000D;&#x000A;                  &apos;755077436&apos;;...    &#x000D;&#x000A;                  &apos;136717361&apos;;...    &#x000D;&#x000A;                  &apos;756675453&apos;;...    &#x000D;&#x000A;                  &apos;435506112&apos;]       &#x000D;&#x000A;k = GPS_PRN_Signal_No;&#x000D;&#x000A;idx=0;&#x000D;&#x000A;&#x000D;&#x000A;for ii=1:1:9&#x000D;&#x000A;    &#x0009;v=L2CM_Poly_Init(k,ii);&#x000D;&#x000A;    &#x0009;v = hex2dec(v);&#x000D;&#x000A;    &#x0009;if (v==0)&#x000D;&#x000A;        &#x0009;&#x0009;mij(idx+1)=0;&#x000D;&#x000A;        &#x0009;&#x0009;mij(idx+2)=0;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;mij(idx+3)=0;&#x000D;&#x000A;    &#x0009;elseif (v==1)&#x000D;&#x000A;        &#x0009;&#x0009;mij(idx+1)=0;&#x000D;&#x000A;        &#x0009;&#x0009;mij(idx+2)=0;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;mij(idx+3)=1;&#x000D;&#x000A;    &#x0009;elseif (v==2)&#x000D;&#x000A;        &#x0009;&#x0009;mij(idx+1)=0;&#x000D;&#x000A;        &#x0009;&#x0009;mij(idx+2)=1;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;mij(idx+3)=0;&#x000D;&#x000A;&#x0009;&#x0009;elseif (v==3)&#x000D;&#x000A;        &#x0009;&#x0009;mij(idx+1)=0;&#x000D;&#x000A;        &#x0009;&#x0009;mij(idx+2)=1;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;mij(idx+3)=1;&#x000D;&#x000A;    &#x0009;elseif (v==4)&#x000D;&#x000A;        &#x0009;&#x0009;mij(idx+1)=1;&#x000D;&#x000A;        &#x0009;&#x0009;mij(idx+2)=0;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;mij(idx+3)=0;&#x000D;&#x000A;&#x0009;&#x0009;elseif (v==5)&#x000D;&#x000A;        &#x0009;&#x0009;mij(idx+1)=1;&#x000D;&#x000A;        &#x0009;&#x0009;mij(idx+2)=0;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;mij(idx+3)=1;&#x000D;&#x000A;    &#x0009;elseif (v==6)&#x000D;&#x000A;        &#x0009;&#x0009;mij(idx+1)=1;&#x000D;&#x000A;        &#x0009;&#x0009;mij(idx+2)=1;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;mij(idx+3)=0;&#x000D;&#x000A;&#x0009;&#x0009;else&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;mij(idx+1)=1;&#x000D;&#x000A;        &#x0009;&#x0009;mij(idx+2)=1;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;mij(idx+3)=1;&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;        idx =idx+3;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;L2CM_InitialState =28- find(mij ==1)&#x000D;&#x000A;</Text>
