<Item XName="TestConfiguration" UserName="TestConfiguration" Type="Equation">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>% Band number 1&#x000D;&#x000A;% 2110MHz - 2170MHz&#x000D;&#x000A;F_BWlow = 2110e6;&#x000D;&#x000A;F_BWhigh = 2170e6;&#x000D;&#x000A;F_BWmid = 2140e6;&#x000D;&#x000A;&#x000D;&#x000A;% TC3a&#x000D;&#x000A;% Bandwidth of LTE signals&#x000D;&#x000A;BW_LTE_Index = 2; % 2 for 5MHz&#x000D;&#x000A;BW_LTE = 5e6;&#x000D;&#x000A;F_offset_LTE = BW_LTE/2; % for BC1, Foffset is BW/2+200KHz for 1.4Mhz and 3Mhz&#x000D;&#x000A;BW_LTE_Index1 = BW_LTE_Index;&#x000D;&#x000A;BW_LTE_Index2 = BW_LTE_Index;&#x000D;&#x000A;BW_LTE_Index3 = BW_LTE_Index;&#x000D;&#x000A;BW_LTE_Index4 = BW_LTE_Index;&#x000D;&#x000A;BW_LTE_Index5 = BW_LTE_Index;&#x000D;&#x000A;BW_LTE1 = BW_LTE;&#x000D;&#x000A;BW_LTE2 = BW_LTE;&#x000D;&#x000A;BW_LTE3 = BW_LTE;&#x000D;&#x000A;BW_LTE4 = BW_LTE;&#x000D;&#x000A;BW_LTE5 = BW_LTE;&#x000D;&#x000A;&#x000D;&#x000A;% Fc of LTE signals&#x000D;&#x000A;Fc_LTE1 = F_BWhigh - F_offset_LTE;&#x000D;&#x000A;Fc_LTE2 = Fc_LTE1 - (BW_LTE1+BW_LTE2)/2;&#x000D;&#x000A;Fc_LTE3 = Fc_LTE2 - (BW_LTE2+BW_LTE3)/2;;&#x000D;&#x000A;Fc_LTE4 = Fc_LTE3 - (BW_LTE3+BW_LTE4)/2;;&#x000D;&#x000A;Fc_LTE5 = Fc_LTE4 - (BW_LTE4+BW_LTE5)/2;;&#x000D;&#x000A;&#x000D;&#x000A;% Bandwidth of WCDMA signals&#x000D;&#x000A;BW_WCDMA = 5e6;&#x000D;&#x000A;F_offset_WCDMA = 2.5e6;&#x000D;&#x000A;&#x000D;&#x000A;% Fc of WCDMA signals&#x000D;&#x000A;ChannelSpacing_WCDMA = 5e6;&#x000D;&#x000A;Fc_WCDMA1 = F_BWlow + F_offset_WCDMA + 100e3; % channel raster of UTRA is 200KHz&#x000D;&#x000A;Fc_WCDMA2 = Fc_WCDMA1 + ChannelSpacing_WCDMA;&#x000D;&#x000A;Fc_WCDMA3 = Fc_WCDMA1 + 2*ChannelSpacing_WCDMA;&#x000D;&#x000A;Fc_WCDMA4 = Fc_WCDMA1 + 3*ChannelSpacing_WCDMA;&#x000D;&#x000A;Fc_WCDMA5 = Fc_WCDMA1 + 4*ChannelSpacing_WCDMA;&#x000D;&#x000A;Fc_WCDMA6 = Fc_WCDMA1 + 5*ChannelSpacing_WCDMA;&#x000D;&#x000A;&#x000D;&#x000A;% SamplingRate of LTE signals&#x000D;&#x000A;LTE_OversamplingOption = 1; &#x000D;&#x000A;SR_LTE = 15.36e6;&#x000D;&#x000A;SR_LTE1 = SR_LTE;&#x000D;&#x000A;SR_LTE2 = SR_LTE;&#x000D;&#x000A;SR_LTE3 = SR_LTE;&#x000D;&#x000A;SR_LTE4 = SR_LTE;&#x000D;&#x000A;SR_LTE5 = SR_LTE;&#x000D;&#x000A;&#x000D;&#x000A;% SamplingRate of WCDMA signals&#x000D;&#x000A;SamplesPerChip = 16;&#x000D;&#x000A;SR_WCDMA = 3.84e6*SamplesPerChip;&#x000D;&#x000A;SR_WCDMA1 = SR_WCDMA;&#x000D;&#x000A;SR_WCDMA2 = SR_WCDMA;&#x000D;&#x000A;SR_WCDMA3 = SR_WCDMA;&#x000D;&#x000A;SR_WCDMA4 = SR_WCDMA;&#x000D;&#x000A;SR_WCDMA5 = SR_WCDMA;&#x000D;&#x000A;SR_WCDMA6 = SR_WCDMA;&#x000D;&#x000A;&#x000D;&#x000A;% signal combiner setting&#x000D;&#x000A;SampleRates = [ SR_WCDMA1 SR_WCDMA2 SR_WCDMA3 SR_WCDMA4 SR_WCDMA5 SR_WCDMA6 SR_LTE1 SR_LTE2 SR_LTE3 SR_LTE4 SR_LTE5];&#x000D;&#x000A;Fcs = [ Fc_WCDMA1 Fc_WCDMA2 Fc_WCDMA3 Fc_WCDMA4 Fc_WCDMA5 Fc_WCDMA6 Fc_LTE1 Fc_LTE2 Fc_LTE3 Fc_LTE4 Fc_LTE5];&#x000D;&#x000A;Bandwidths = [ BW_WCDMA BW_WCDMA BW_WCDMA BW_WCDMA BW_WCDMA BW_WCDMA BW_LTE BW_LTE BW_LTE BW_LTE BW_LTE];&#x000D;&#x000A;&#x000D;&#x000A;% Power of LTE signals&#x000D;&#x000A;Power_LTE = 24; %dBm&#x000D;&#x000A;Power_LTE1 = Power_LTE;&#x000D;&#x000A;Power_LTE2 = Power_LTE;&#x000D;&#x000A;Power_LTE3 = Power_LTE;&#x000D;&#x000A;Power_LTE4 = Power_LTE;&#x000D;&#x000A;Power_LTE5 = Power_LTE;&#x000D;&#x000A;NumOfRBs_Table = [6,15,25,50,75,100];&#x000D;&#x000A;NumOfRBs1 = NumOfRBs_Table(BW_LTE_Index1+1);&#x000D;&#x000A;NumOfRBs2 = NumOfRBs_Table(BW_LTE_Index2+1);&#x000D;&#x000A;NumOfRBs3 = NumOfRBs_Table(BW_LTE_Index3+1);&#x000D;&#x000A;NumOfRBs4 = NumOfRBs_Table(BW_LTE_Index4+1);&#x000D;&#x000A;NumOfRBs5 = NumOfRBs_Table(BW_LTE_Index5+1);&#x000D;&#x000A;RS_EPRE_LTE1 = Power_LTE1 - 10*log10(12*NumOfRBs1);&#x000D;&#x000A;RS_EPRE_LTE2 = Power_LTE2 - 10*log10(12*NumOfRBs2);&#x000D;&#x000A;RS_EPRE_LTE3 = Power_LTE3 - 10*log10(12*NumOfRBs3);&#x000D;&#x000A;RS_EPRE_LTE4 = Power_LTE4 - 10*log10(12*NumOfRBs4);&#x000D;&#x000A;RS_EPRE_LTE5 = Power_LTE5 - 10*log10(12*NumOfRBs5);&#x000D;&#x000A;&#x000D;&#x000A;% Power of WCDMA signals&#x000D;&#x000A;Power_WCDMA = 24; %dBm&#x000D;&#x000A;Power_WCDMA_W = 10^((Power_WCDMA-30)/10);&#x000D;&#x000A;Power_WCDMA1 = Power_WCDMA_W;&#x000D;&#x000A;Power_WCDMA2 = Power_WCDMA_W;&#x000D;&#x000A;Power_WCDMA3 = Power_WCDMA_W;&#x000D;&#x000A;Power_WCDMA4 = Power_WCDMA_W;&#x000D;&#x000A;Power_WCDMA5 = Power_WCDMA_W;&#x000D;&#x000A;Power_WCDMA6 = Power_WCDMA_W;&#x000D;&#x000A;&#x000D;&#x000A;</Text>
