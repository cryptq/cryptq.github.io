<Item XName="Page" Type="PageMgr" />
<Item XName="PowerCalculation" UserName="PowerCalculation" Type="Equation">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>using(&apos;Design1_Data&apos;);&#x000D;&#x000A;&#x000D;&#x000A;% Measure the power of a LTE carrier&#x000D;&#x000A;% In this example, there are 5 LTE carriers&#x000D;&#x000A;% See more details in Equation &apos;TestConfiguration&apos;&#x000D;&#x000A;% Select MeasLTECarrierIndex from 1 ~ 5&#x000D;&#x000A;MeasLTECarrierIndex = 1;&#x000D;&#x000A;&#x000D;&#x000A;Fc_LTE_Table = [Fc_LTE1 Fc_LTE2 Fc_LTE3 Fc_LTE4 Fc_LTE5];&#x000D;&#x000A;BW_LTE_Table = [BW_LTE1 BW_LTE2 BW_LTE3 BW_LTE4 BW_LTE5];&#x000D;&#x000A;FreqStart_LTE = Fc_LTE_Table(MeasLTECarrierIndex) - BW_LTE_Table(MeasLTECarrierIndex)/2;&#x000D;&#x000A;FreqStop_LTE = Fc_LTE_Table(MeasLTECarrierIndex) + BW_LTE_Table(MeasLTECarrierIndex)/2;&#x000D;&#x000A;StartIndex_LTE = find(MSR_spec_Power_Freq == FreqStart_LTE);&#x000D;&#x000A;StopIndex_LTE = find(MSR_spec_Power_Freq == FreqStop_LTE);&#x000D;&#x000A;MeasPower_LTE = sum(MSR_spec_Power(StartIndex_LTE:StopIndex_LTE));&#x000D;&#x000A;MeasPower_dBm_LTE = 10*log10(MeasPower_LTE*1000);&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;% Measure the powr of a WCDMA carrier&#x000D;&#x000A;% In this example, there are 6 WCDMA carriers&#x000D;&#x000A;% See more details in Equation &apos;TestConfiguration&apos;&#x000D;&#x000A;% Select MeasWCDMACarrierIndex from 1 ~ 6&#x000D;&#x000A;MeasWCDMACarrierIndex = 1;&#x000D;&#x000A;&#x000D;&#x000A;Fc_WCDMA_Table = [Fc_WCDMA1 Fc_WCDMA2 Fc_WCDMA3 Fc_WCDMA4 Fc_WCDMA5 Fc_WCDMA6];&#x000D;&#x000A;FreqStart_WCDMA = Fc_WCDMA_Table(MeasWCDMACarrierIndex) - BW_WCDMA/2;&#x000D;&#x000A;FreqStop_WCDMA = Fc_WCDMA_Table(MeasWCDMACarrierIndex) + BW_WCDMA/2;&#x000D;&#x000A;StartIndex_WCDMA = find(MSR_spec_Power_Freq == FreqStart_WCDMA);&#x000D;&#x000A;StopIndex_WCDMA = find(MSR_spec_Power_Freq == FreqStop_WCDMA);&#x000D;&#x000A;MeasPower_WCDMA = sum(MSR_spec_Power(StartIndex_WCDMA:StopIndex_WCDMA));&#x000D;&#x000A;MeasPower_dBm_WCDMA = 10*log10(MeasPower_WCDMA*1000);&#x000D;&#x000A;</Text>
<UnitUse><T>Int</T><D>2</D></UnitUse>
