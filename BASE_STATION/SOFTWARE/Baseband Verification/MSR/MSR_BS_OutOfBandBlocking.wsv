<Item XName="TestConfiguration" UserName="TestConfiguration" Type="Equation">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>% Band number 11, 10&#x000D;&#x000A;F_Block1_BWlow = 1427.9e6;&#x000D;&#x000A;F_Block1_BWhigh = 1447.9e6;&#x000D;&#x000A;F_Block2_BWlow = 1710e6;&#x000D;&#x000A;F_Block2_BWhigh = 1770e6;&#x000D;&#x000A;F_BWmid = (F_Block2_BWhigh + F_Block1_BWlow)/2;&#x000D;&#x000A;&#x000D;&#x000A;% NTC3a&#x000D;&#x000A;&#x000D;&#x000A;% WCDMA signal in Band 11&#x000D;&#x000A;BW_WCDMA = 5e6;&#x000D;&#x000A;Foffset_WCDMA = 2.5e6;&#x000D;&#x000A;Fc_WCDMA1 = F_Block1_BWlow + Foffset_WCDMA;&#x000D;&#x000A;SamplesPerChip_WCDMA1 = 16;&#x000D;&#x000A;SR_WCDMA1 = 3.84e6*SamplesPerChip_WCDMA1;&#x000D;&#x000A;Power_WCDMA_dBm1 = -115 + 6; %dBm&#x000D;&#x000A;Power_WCDMA1 = 10^((Power_WCDMA_dBm1-30)/10);&#x000D;&#x000A;WCDMA_FilterLength1 = 16;&#x000D;&#x000A;TStep=1/SR_WCDMA1;&#x000D;&#x000A;SourceDelay=(1326+2*floor(WCDMA_FilterLength1*SamplesPerChip_WCDMA1/2)+1)*TStep;&#x000D;&#x000A;&#x000D;&#x000A;WCDMA_GainIndex = 11;&#x000D;&#x000A;WCDMA_RefCh=0;&#x000D;&#x000A;if (WCDMA_RefCh &lt; 5)&#x000D;&#x000A;&#x0009;WCDMA_Cali_Gain = 1.0/sqrt(1.0+(WCDMA_GainIndex/15.0)^2);&#x000D;&#x000A;elseif (WCDMA_RefCh == 5)&#x000D;&#x000A;&#x0009;WCDMA_Cali_Gain = 1.0/sqrt(2.0+(WCDMA_GainIndex/15.0)^2);&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;WCDMA_Cali_Gain = 1.0/sqrt(6.0+(WCDMA_GainIndex/15.0)^2);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;% LTE Signal in Band 10&#x000D;&#x000A;LTE_BW_Index = 2; % 2 for 5MHz&#x000D;&#x000A;BW_LTE = 5e6;&#x000D;&#x000A;Foffset_LTE1 = 2.5e6;&#x000D;&#x000A;Fc_LTE1 = F_Block2_BWhigh - Foffset_LTE1;&#x000D;&#x000A;LTE_OversamplingOption1 = 1; &#x000D;&#x000A;SR_LTE1 = 15.36e6;&#x000D;&#x000A;LTE_Power_dBm1 = -100.8 + 6; %dBm&#x000D;&#x000A;NumOfRBs_Table = [6,15,25,50,75,100];&#x000D;&#x000A;NumOfRBs = NumOfRBs_Table(LTE_BW_Index+1);&#x000D;&#x000A;Power_LTE1 = 10^(LTE_Power_dBm1/10) / 1000;&#x000D;&#x000A;LTE_RBAlloc = [0,NumOfRBs];&#x000D;&#x000A;LTE_PayloadConfig = 1;&#x000D;&#x000A;LTE_Payload = [2216];&#x000D;&#x000A;LTE_MappingType = [0];&#x000D;&#x000A;&#x000D;&#x000A;CarrierSpacing = 5e6;&#x000D;&#x000A;&#x000D;&#x000A;% LTE signal in Band 11&#x000D;&#x000A;Fc_LTE2 = Fc_WCDMA1 + CarrierSpacing;&#x000D;&#x000A;LTE_OversamplingOption2 = 1; &#x000D;&#x000A;SR_LTE2 = 15.36e6;&#x000D;&#x000A;LTE_Power_dBm2 = -100.8 + 6; %dBm&#x000D;&#x000A;Power_LTE2 = 10^(LTE_Power_dBm1/10) / 1000;&#x000D;&#x000A;&#x000D;&#x000A;% WCDMA signal in Band 10&#x000D;&#x000A;Fc_WCDMA2 = Fc_LTE1 - CarrierSpacing - 100e3;&#x000D;&#x000A;SamplesPerChip_WCDMA2 = 16;&#x000D;&#x000A;SR_WCDMA2 = 3.84e6*SamplesPerChip_WCDMA2;&#x000D;&#x000A;Power_WCDMA_dBm2 = -115 + 6; %dBm&#x000D;&#x000A;Power_WCDMA2 = 10^((Power_WCDMA_dBm2-30)/10);&#x000D;&#x000A;WCDMA_FilterLength2 = 16;&#x000D;&#x000A;&#x000D;&#x000A;% CW interfering signal&#x000D;&#x000A;FcStart_CW = F_Block2_BWhigh + 20e6;&#x000D;&#x000A;FreqOffsetStep=tune(2); % step size is 1MHz&#x000D;&#x000A;Fc_CW = FcStart_CW + FreqOffsetStep*1e6;&#x000D;&#x000A;Power_CW_dBm = -15;&#x000D;&#x000A;Power_CW = 10^((Power_CW_dBm-30)/10);&#x000D;&#x000A;SR_CW = 1e6;&#x000D;&#x000A;&#x000D;&#x000A;SampleRates = [SR_WCDMA1 SR_WCDMA2 SR_LTE1 SR_LTE2 SR_CW];&#x000D;&#x000A;Fcs = [Fc_WCDMA1 Fc_WCDMA2 Fc_LTE1 Fc_LTE2 Fc_CW];&#x000D;&#x000A;Bandwidths = [BW_WCDMA BW_WCDMA BW_LTE BW_LTE SR_CW];&#x000D;&#x000A;OutputSampleRate = 6.144e8;&#x000D;&#x000A;&#x000D;&#x000A;% measurements&#x000D;&#x000A;LTE_SubframeStop = 20;&#x000D;&#x000A;WCDMA_FrameNum = 2;&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;</Text>
<UnitUse><T>Int</T><D>2</D></UnitUse>
