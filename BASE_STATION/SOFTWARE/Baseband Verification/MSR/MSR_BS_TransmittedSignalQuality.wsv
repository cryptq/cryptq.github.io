69, 0.199984, 0.1869, 0.150794, 0.100059, 0.0460958, 1.60907e-005, -0.030118, -0.0412873, -0.0356166, -0.0192734, -1.40445e-005, 0.0151373, 0.0219916, 0.0198143, 0.011099, 1.10125e-005, -0.00911778, -0.013475, -0.0122865, -0.0069563, -6.86593e-006, 0.00576461, 0.00855902, 0.0078043, 0.00442788, 1.27846e-006, -0.00363573, -0.00539576, -0.00488182, -0.00276666, 5.52795e-006, 0.00221662, 0.00328529, 0.00292301, 0.00165684, -1.40242e-005, -0.00126741, -0.00188626, -0.00162301, -0.000930314, 2.44817e-005, 0.000648356, 0.000993825, 0.000792204, 0.00047979, -3.7957e-005, -0.000264084, -0.000464962, -0.000573215];&#x000D;&#x000A;else % 8x&#x000D;&#x000A;&#x0009;EquiRippleFIR_Taps = [-0.000497319, -0.000197557, -0.000206946, -0.000193082, -0.000153049, -8.67427e-005, 2.62733e-006, 0.000108403, 0.000220757, 0.000327429, 0.000414893, 0.000469796, 0.000480571, 0.000439112, 0.000342209, 0.000192632, -2.60557e-007, -0.000220796, -0.000447886, -0.000656936, -0.000822099, -0.000919228, -0.000928654, -0.000838082, -0.0006448, -0.000357441, 3.89214e-006, 0.00040839, 0.000817142, 0.00118624, 0.00147108, 0.00163085, 0.00163433, 0.00146416, 0.00111977, 0.000618389, -1.50141e-006, -0.000687146, -0.00137156, -0.00198165, -0.0024448, -0.00269669, -0.00268938, -0.00239772, -0.00182454, -0.00100276, 4.9968e-006, 0.00111042, 0.00220635, 0.00317645, 0.00390665, 0.00429743, 0.00427557, 0.00380438, 0.00289067, 0.0015884, -2.97245e-006, -0.00174449, -0.00346872, -0.00499434, -0.00614373, -0.00676143, -0.00673239, -0.00599736, -0.00456404, -0.00251242, 6.23847e-006, 0.00277829, 0.00554329, 0.00801548, 0.00990937, 0.010969, 0.0109946, 0.00986895, 0.00757621, 0.00421402, -3.88455e-006, -0.00475547, -0.00962828, -0.0141469, -0.0178076, -0.0201185, -0.0206407, -0.0190284, -0.0150639, -0.00868347, 6.94179e-006, 0.0107289, 0.0230426, 0.0363701, 0.0500316, 0.0632891, 0.0753973, 0.0856555, 0.0934576, 0.098336, 0.0999957, 0.098336, 0.0934576, 0.0856555, 0.0753973, 0.0632891, 0.0500316, 0.0363701, 0.0230426, 0.0107289, 6.94179e-006, -0.00868347, -0.0150639, -0.0190284, -0.0206407, -0.0201185, -0.0178076, -0.0141469, -0.00962828, -0.00475547, -3.88455e-006, 0.00421402, 0.00757621, 0.00986895, 0.0109946, 0.010969, 0.00990937, 0.00801548, 0.00554329, 0.00277829, 6.23847e-006, -0.00251242, -0.00456404, -0.00599736, -0.00673239, -0.00676143, -0.00614373, -0.00499434, -0.00346872, -0.00174449, -2.97245e-006, 0.0015884, 0.00289067, 0.00380438, 0.00427557, 0.00429743, 0.00390665, 0.00317645, 0.00220635, 0.00111042, 4.9968e-006, -0.00100276, -0.00182454, -0.00239772, -0.00268938, -0.00269669, -0.0024448, -0.00198165, -0.00137156, -0.000687146, -1.50141e-006, 0.000618389, 0.00111977, 0.00146416, 0.00163433, 0.00163085, 0.00147108, 0.00118624, 0.000817142, 0.00040839, 3.89214e-006, -0.000357441, -0.0006448, -0.000838082, -0.000928654, -0.000919228, -0.000822099, -0.000656936, -0.000447886, -0.000220796, -2.60557e-007, 0.000192632, 0.000342209, 0.000439112, 0.000480571, 0.000469796, 0.000414893, 0.000327429, 0.000220757, 0.000108403, 2.62733e-006, -8.67427e-005, -0.000153049, -0.000193082, -0.000206946, -0.000197557, -0.000497319];&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;% Define VAR Modulation&#x000D;&#x000A;QPSK_Table = [1+j, 1-j, -1+j, -1-j];&#x000D;&#x000A;QPSK = QPSK_Table*1/sqrt(2.0);&#x000D;&#x000A;QAM16_Factor = 1.0/sqrt(10.0);&#x000D;&#x000A;QAM16_Table = ...&#x000D;&#x000A;&#x0009;[1+j,  1+j*3,  3+j*1,  3+j*3,  1-j,    1-j*3,  3-j,    3-j*3,...&#x000D;&#x000A;&#x0009;-1+j, -1+j*3, -3+j*1, -3+j*3, -1-j*1, -1-j*3, -3-j*1, -3-j*3];&#x000D;&#x000A;QAM16 = QAM16_Table*QAM16_Factor;&#x000D;&#x000A;QAM64_Factor = 1.0/sqrt(42.0);&#x000D;&#x000A;QAM64_Table = ...&#x000D;&#x000A;&#x0009;[3+j*3,    3+j,  1+j*3,  1+j*1,  3+j*5,  3+j*7,  1+j*5,  1+j*7,...&#x000D;&#x000A;&#x0009; 5+j*3,  5+j*1,  7+j*3,  7+j*1,  5+j*5,  5+j*7,  7+j*5,  7+j*7,...&#x000D;&#x000A;&#x0009; 3-j*3,  3-j*1,  1-j*3,  1-j*1,  3-j*5,  3-j*7,  1-j*5,  1-j*7,...&#x000D;&#x000A;&#x0009; 5-j*3,  5-j*1,  7-j*3,  7-j*1,  5-j*5,  5-j*7,  7-j*5,  7-j*7,...&#x000D;&#x000A;&#x0009;-3+j*3, -3+j*1, -1+j*3, -1+j*1, -3+j*5, -3+j*7, -1+j*5, -1+j*7,...&#x000D;&#x000A;&#x0009;-5+j*3,   -5+j, -7+j*3,   -7+j, -5+j*5, -5+j*7, -7+j*5, -7+j*7,...&#x000D;&#x000A;&#x0009;-3-j*3, -3-j*1, -1-j*3,   -1-j, -3-j*5, -3-j*7, -1-j*5, -1-j*7,...&#x000D;&#x000A;&#x0009;-5-j*3,   -5-j, -7-j*3,   -7-j, -5-j*5, -5-j*7, -7-j*5, -7-j*7];&#x000D;&#x000A;QAM64 = QAM64_Table*QAM64_Factor;&#x000D;&#x000A;QPSK_Extended_Table = [1+j, 1-j, -1+j, -1-j, 0, 0, 0, 0, 0, 0, 0];&#x000D;&#x000A;QPSK_Extended = QPSK_Extended_Table*1/sqrt(2.0);&#x000D;&#x000A;&#x000D;&#x000A;if (0 == OtherUEs_MappingType(1))&#x000D;&#x000A;&#x0009;UE2_MapperBits = 2;&#x000D;&#x000A;&#x0009;UE2_Mapper = QPSK;&#x000D;&#x000A;elseif (1 == OtherUEs_MappingType(1))&#x000D;&#x000A;&#x0009;UE2_MapperBits = 4;&#x000D;&#x000A;&#x0009;UE2_Mapper = QAM16;&#x000D;&#x000A;else &#x000D;&#x000A;&#x0009;UE2_MapperBits = 6;&#x000D;&#x000A;&#x0009;UE2_Mapper = QAM64;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if (0 == OtherUEs_MappingType(2))&#x000D;&#x000A;&#x0009;UE3_MapperBits = 2;&#x000D;&#x000A;&#x0009;UE3_Mapper = QPSK;&#x000D;&#x000A;elseif (1 == OtherUEs_MappingType(2))&#x000D;&#x000A;&#x0009;UE3_MapperBits = 4;&#x000D;&#x000A;&#x0009;UE3_Mapper = QAM16;&#x000D;&#x000A;else &#x000D;&#x000A;&#x0009;UE3_MapperBits = 6;&#x000D;&#x000A;&#x0009;UE3_Mapper = QAM64;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if (0 == OtherUEs_MappingType(3))&#x000D;&#x000A;&#x0009;UE4_MapperBits = 2;&#x000D;&#x000A;&#x0009;UE4_Mapper = QPSK;&#x000D;&#x000A;elseif (1 == OtherUEs_MappingType(3))&#x000D;&#x000A;&#x0009;UE4_MapperBits = 4;&#x000D;&#x000A;&#x0009;UE4_Mapper = QAM16;&#x000D;&#x000A;else &#x000D;&#x000A;&#x0009;UE4_MapperBits = 6;&#x000D;&#x000A;&#x0009;UE4_Mapper = QAM64;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if (0 == OtherUEs_MappingType(4))&#x000D;&#x000A;&#x0009;UE5_MapperBits = 2;&#x000D;&#x000A;&#x0009;UE5_Mapper = QPSK;&#x000D;&#x000A;elseif (1 == OtherUEs_MappingType(4))&#x000D;&#x000A;&#x0009;UE5_MapperBits = 4;&#x000D;&#x000A;&#x0009;UE5_Mapper = QAM16;&#x000D;&#x000A;else &#x000D;&#x000A;&#x0009;UE5_MapperBits = 6;&#x000D;&#x000A;&#x0009;UE5_Mapper = QAM64;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if (0 == OtherUEs_MappingType(5))&#x000D;&#x000A;&#x0009;UE6_MapperBits = 2;&#x000D;&#x000A;&#x0009;UE6_Mapper = QPSK;&#x000D;&#x000A;elseif (1 == OtherUEs_MappingType(5))&#x000D;&#x000A;&#x0009;UE6_MapperBits = 4;&#x000D;&#x000A;&#x0009;UE6_Mapper = QAM16;&#x000D;&#x000A;else &#x000D;&#x000A;&#x0009;UE6_MapperBits = 6;&#x000D;&#x000A;&#x0009;UE6_Mapper = QAM64;&#x000D;&#x000A;end</Text>
