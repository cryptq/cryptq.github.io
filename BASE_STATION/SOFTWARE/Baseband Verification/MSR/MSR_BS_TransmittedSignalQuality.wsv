<Item XName="TestConfiguration" UserName="TestConfiguration" Type="Equation">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>% NTC3a&#x000D;&#x000A;% Band number 1 and 7&#x000D;&#x000A;F_Block1_BWlow = 2110e6;&#x000D;&#x000A;F_Block1_BWhigh = 2170e6;&#x000D;&#x000A;F_Block2_BWlow = 2620e6;&#x000D;&#x000A;F_Block2_BWhigh = 2690e6;&#x000D;&#x000A;F_BWmid = (F_Block2_BWhigh + F_Block1_BWlow)/2;&#x000D;&#x000A;&#x000D;&#x000A;% WCDMA Configuration&#x000D;&#x000A;BW_WCDMA = 5e6;&#x000D;&#x000A;Foffset_WCDMA = 2.5e6;&#x000D;&#x000A;Fc_WCDMA = F_Block1_BWhigh - Foffset_WCDMA - 100e3;&#x000D;&#x000A;SamplesPerChip_WCDMA = 16;&#x000D;&#x000A;SR_WCDMA = 3.84e6*SamplesPerChip_WCDMA;&#x000D;&#x000A;Power_WCDMA_dBm = 24; %dBm&#x000D;&#x000A;Power_WCDMA = 10^((Power_WCDMA_dBm-30)/10);&#x000D;&#x000A;TStep = 1/SR_WCDMA;&#x000D;&#x000A;&#x000D;&#x000A;% LTE Configuration&#x000D;&#x000A;BW_LTE_Index = 2; % 2 for 5MHz&#x000D;&#x000A;BW_LTE = 5e6;&#x000D;&#x000A;Foffset_LTE = 2.5e6;&#x000D;&#x000A;Fc_LTE = F_Block2_BWhigh - Foffset_LTE;&#x000D;&#x000A;LTE_OversamplingOption = 1; &#x000D;&#x000A;SR_LTE = 15.36e6;&#x000D;&#x000A;Power_LTE = 24; %dBm&#x000D;&#x000A;NumOfRBs_Table = [6,15,25,50,75,100];&#x000D;&#x000A;NumOfRBs = NumOfRBs_Table(BW_LTE_Index+1);&#x000D;&#x000A;RS_EPRE_LTE = Power_LTE - 10*log10(12*NumOfRBs);&#x000D;&#x000A;&#x000D;&#x000A;% Signal Combiner setting&#x000D;&#x000A;SampleRates = [SR_WCDMA SR_LTE];&#x000D;&#x000A;Fcs = [Fc_WCDMA Fc_LTE];&#x000D;&#x000A;Bandwidths = [BW_WCDMA BW_LTE ];&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;</Text>
