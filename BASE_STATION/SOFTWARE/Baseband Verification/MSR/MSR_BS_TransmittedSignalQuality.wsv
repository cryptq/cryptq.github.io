ied per RB; Varied per CyclicPrefix&#x000D;&#x000A;G_NUM_SYMBOLS_PER_SLOT = [7, 6];&#x000D;&#x000A;&#x000D;&#x000A;%bandwidth index (0-5): 1.4 MHz, 3 MHz, 5 MHz, 10 MHz, 15 MHz, 20 MHz&#x000D;&#x000A;G_NUM_RBS_PER_SYMBOL = [6, 15, 25, 50, 75, 100];&#x000D;&#x000A;&#x000D;&#x000A;%Modulation oders&#x000D;&#x000A;G_MODULATION_ORDER = [2, 4, 6];&#x000D;&#x000A;&#x000D;&#x000A;%bandwidth index (0-5): 1.4 MHz, 3 MHz, 5 MHz, 10 MHz, 15 MHz, 20 MHz&#x000D;&#x000A;G_NUM_RBS_PER_SYMBOL = [6, 15, 25, 50, 75, 100];&#x000D;&#x000A;&#x000D;&#x000A;%list the status of each subframe with 7 TDD configurations&#x000D;&#x000A;%0: uplink subframe; 1: downlink subframe; 2: special subframe&#x000D;&#x000A;G_TDD_CONFIG_TABLE = ...&#x000D;&#x000A;   [1, 2, 0, 0, 0, 1, 2, 0, 0, 0;...&#x000D;&#x000A;&#x0009;1, 2, 0, 0, 1, 1, 2, 0, 0, 1;...&#x000D;&#x000A;&#x0009;1, 2, 0, 1, 1, 1, 2, 0, 1, 1;...&#x000D;&#x000A;&#x0009;1, 2, 0, 0, 0, 1, 1, 1, 1, 1;...&#x000D;&#x000A;&#x0009;1, 2, 0, 0, 1, 1, 1, 1, 1, 1;...&#x000D;&#x000A;&#x0009;1, 2, 0, 1, 1, 1, 1, 1, 1, 1;...&#x000D;&#x000A;&#x0009;1, 2, 0, 0, 0, 1, 2, 0, 0, 1];&#x000D;&#x000A;&#x000D;&#x000A;% Define the number of BCH encoded bits&#x000D;&#x000A;numBCH_CodedBits = [1920, 1728];&#x000D;&#x000A;BCH_PerFrame = numBCH_CodedBits(CyclicPrefix+1)/8;&#x000D;&#x000A;BCH_Bits = [BCH_PerFrame; 0; 0; 0; 0; 0; 0; 0; 0; 0];&#x000D;&#x000A;% Define the index for the transmit antenna ports&#x000D;&#x000A;% m_numTxAntsIdx=0 --&gt; p=1&#x000D;&#x000A;% m_numTxAntsIdx=1 --&gt; p=2&#x000D;&#x000A;% m_numTxAntsIdx=2 --&gt; p=4&#x000D;&#x000A;m_numTxAntsIdx = 0;&#x000D;&#x000A;&#x000D;&#x000A;% define Pre_Oversamp&#x000D;&#x000A;if (FIR_withInterp==1 &amp;&amp; SpectrumShapingType==1 )&#x000D;&#x000A;&#x0009;Pre_Oversamp = 0;&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;Pre_Oversamp = OversamplingOption;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;% define Equal-Ripple FIR taps&#x000D;&#x000A;if (1 == SpectrumShapingType &amp;&amp; 2 == FIR_FilterType)&#x00