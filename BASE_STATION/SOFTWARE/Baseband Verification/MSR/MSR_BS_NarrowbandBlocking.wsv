<Selected><T>Bool</T><D>0</D></Selected>
<Text>% Band number 8&#x000D;&#x000A;% 880MHz - 915MHz&#x000D;&#x000A;F_BWlow = 880e6;&#x000D;&#x000A;F_BWhigh = 915e6;&#x000D;&#x000A;F_BWmid = (F_BWhigh + F_BWlow)/2;&#x000D;&#x000A;&#x000D;&#x000A;% TC5b&#x000D;&#x000A;% GSM Configuration&#x000D;&#x000A;BW_GSM = 200e3;&#x000D;&#x000A;Foffset_GSM = 200e3;&#x000D;&#x000A;Fc_GSM = F_BWlow + Foffset_GSM;&#x000D;&#x000A;GSM_TSC = 6;&#x000D;&#x000A;GSM_ChannelType = 17;&#x000D;&#x000A;GSM_Ps = -98 + 3;&#x000D;&#x000A;GSM_BitsPerSlotTable = [260,1200,600,72,209,257,329,385,956,1244,940,1132,1228,209,257,329,385,487,631,946,1138,1234,1594,623,1228,2248];&#x000D;&#x000A;GSM_BitsPerSlot = GSM_BitsPerSlotTable(GSM_ChannelType+1);&#x000D;&#x000A;if GSM_ChannelType == 1&#x000D;&#x000A;&#x0009;GSM_BitsDelayed = 1440;&#x000D;&#x000A;elseif GSM_ChannelType == 2&#x000D;&#x000A;&#x0009;GSM_BitsDelayed = 720;&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;GSM_BitsDelayed = GSM_BitsPerSlot *2;&#x000D;&#x000A;end&#x000D;&#x000A;if (GSM_ChannelType &lt; 8 || (GSM_ChannelType &gt; 12 &amp;&amp; GSM_ChannelType &lt; 17)) % GMSK&#x000D;&#x000A;&#x0009;GSM_ModType = 0;&#x000D;&#x000A;elseif(GSM_ChannelType ==22)&#x0009;%16QAM&#x000D;&#x000A;&#x0009;GSM_ModType = 2;&#x000D;&#x000A;elseif(GSM_ChannelType ==23)&#x0009;%HSR QPSK&#x000D;&#x000A;&#x0009;GSM_ModType = 4;&#x000D;&#x000A;elseif(GSM_ChannelType ==24)&#x0009;%HSR 16-QAM&#x000D;&#x000A;&#x0009;GSM_ModType = 5;&#x000D;&#x000A;elseif(GSM_ChannelType ==25)&#x0009;%HSR 32-QAM&#x000D;&#x000A;&#x0009;GSM_ModType = 6;&#x000D;&#x000A;else % 8PSK&#x000D;&#x000A;&#x0009;GSM_ModType = 1;&#x000D;&#x000A;end&#x000D;&#x000A;if GSM_ModType &lt; 4&#x000D;&#x000A;&#x0009;GSM_BaseRate = 270833.333333333;&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;GSM_BaseRate = 325000;&#x000D;&#x000A;end&#x000D;&#x000A;GSM_SamplesPerSymbOption = 2;&#x000D;&#x000A;GSM_SamplesPerSymb = 2^(GSM_SamplesPerSymbOption+2);&#x000D;&#x000A;SR_GSM = GSM_BaseRate * GSM_SamplesPerSymb * 3;&#x000D;&#x000A;SR_GSM = 13e6;&#x000D;&#x000A;GSM_EqAlgrithm = 1;&#x000D;&#x000A;switch GSM_ModType&#x000D;&#x000A;&#x0009;case 0&#x000D;&#x000A;&#x0009;&#x0009;PartitionArray =[2,2,2,2,2];&#x000D;&#x000A;&#x0009;case 1&#x000D;&#x000A;&#x0009;&#x0009;PartitionArray= [8,4,2,2,1];&#x000D;&#x000A;&#x0009;case 2&#x000D;&#x000A;&#x0009;&#x0009;PartitionArray= [16,8,4,2,1];&#x000D;&#x000A;&#x0009;case 3&#x000D;&#x000A;&#x0009;&#x0009;PartitionArray= [32,16,8,4,2];&#x000D;&#x000A;&#x0009;case 4&#x000D;&#x000A;&#x0009;&#x0009;PartitionArray= [4,4,4,4,4];&#x000D;&#x000A;&#x0009;case 5&#x000D;&#x000A;&#x0009;&#x0009;PartitionArray= [16,8,4,2,1];&#x000D;&#x000A;&#x0009;case 6&#x000D;&#x000A;&#x0009;&#x0009;PartitionArray= [32,16,8,4,2];&#x0009;&#x000D;&#x000A;&#x0009;otherwise&#x000D;&#x000A;&#x0009;&#x0009;PartitionArray =[2,2,2,2,2];&#x0009;&#x000D;&#x000A;end&#x000D;&#x000A;GSM_SignalPower_dBm = 20;&#x000D;&#x000A;Power_GSM = 10^(GSM_SignalPower_dBm/10) / 1000;&#x000D;&#x000A;&#x000D;&#x000A;% LTE Configuration&#x000D;&#x000A;LTE_BW_Index = 2; % 2 for 5MHz&#x000D;&#x000A;BW_LTE = 5e6;&#x000D;&#x000A;Foffset_LTE = 2.5e6;&#x000D;&#x000A;Fc_LTE = F_BWhigh - Foffset_LTE;&#x000D;&#x000A;LTE_OversamplingOption = 1; &#x000D;&#x000A;SR_LTE = 15.36e6;&#x000D;&#x000A;LTE_Power_dBm = -101.5 + 6; %dBm&#x000D;&#x000A;NumOfRBs_Table = [6,15,25,50,75,100];&#x000D;&#x000A;NumOfRBs = NumOfRBs_Table(LTE_BW_Index+1);&#x000D;&#x000A;Power_LTE = 10^(LTE_Power_dBm/10) / 1000;&#x000D;&#x000A;LTE_RBAlloc = [0,25];&#x000D;&#x000A;LTE_PayloadConfig = 1;&#x000D;&#x000A;LTE_Payload = [2216];&#x000D;&#x000A;LTE_MappingType = [0];&#x000D;&#x000A;&#x000D;&#x000A;% Interfereer&#x000D;&#x000A;Fc_Interferer = F_BWhigh + 1.5e6;&#x000D;&#x000A;BW_Interferer = 3e6;&#x000D;&#x000A;Interferer_OversamplingOption = 1; &#x000D;&#x000A;SR_Interferer = 7.68e6;&#x000D;&#x000A;m=tune(1); % RBIndex specifies the index of the interferer RB&#x000D;&#x000A;Interferer_RBAlloc = [m,1];&#x000D;&#x000A;Interferer_MappingType = [0];&#x000D;&#x000A;Interferer_Power_dBm = -49;&#x000D;&#x000A;Power_Interferer = 10^(Interferer_Power_dBm/10) / 1000;&#x000D;&#x000A;&#x000D;&#x000A;SampleRates = [SR_GSM SR_LTE SR_Interferer];&#x000D;&#x000A;Fcs = [Fc_GSM Fc_LTE Fc_Interferer];&#x000D;&#x000A;Bandwidths = [BW_GSM BW_LTE BW_Interferer];&#x000D;&#x000A;OutputSampleRate = 92.16e6;&#x000D;&#x000A;&#x000D;&#x000A;% Performance measurement&#x000D;&#x000A;LTE_SubframeStop = 100;&#x000D;&#x000A;GSM_BlockNum = 10;&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;</Text>
<UnitUse><T>Int</T><D>2</D></UnitUse>
