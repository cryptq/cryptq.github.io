<Item XName="Equations" Type="Equation">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>TimeStep=1/(3840000*SamplesPerChip);&#x000D;&#x000A;&#x000D;&#x000A;FilterLength = 16;&#x000D;&#x000A;L = floor(FilterLength/2);&#x000D;&#x000A;Alpha = 0.22;&#x000D;&#x000A;SampPerSym = SamplesPerChip;&#x000D;&#x000A;FilterType = &apos;sqrt&apos;;&#x000D;&#x000A;Window = &apos;rectangular&apos;;&#x000D;&#x000A;RRC_Coe = WCDMA_firrcos(L,Alpha,SampPerSym,FilterType,Window);</Text>
<UnitUse><T>Int</T><D>2</D></UnitUse>
