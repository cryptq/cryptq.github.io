<Selected><T>Bool</T><D>0</D></Selected>
<Text>% Band number 12 and 14&#x000D;&#x000A;F_Block1_BWlow = 729e6;&#x000D;&#x000A;F_Block1_BWhigh = 746e6;&#x000D;&#x000A;F_Block2_BWlow = 758e6;&#x000D;&#x000A;F_Block2_BWhigh = 768e6;&#x000D;&#x000A;F_BWmid = (F_Block2_BWhigh + F_Block1_BWlow)/2;&#x000D;&#x000A;&#x000D;&#x000A;%NTC3a&#x000D;&#x000A;&#x000D;&#x000A;% WCDMA Configuration&#x000D;&#x000A;BW_WCDMA = 5e6;&#x000D;&#x000A;Foffset_WCDMA = 2.5e6;&#x000D;&#x000A;Fc_WCDMA = F_Block1_BWhigh - Foffset_WCDMA - 100e3; % the channel raster of UTRA is 200KHz&#x000D;&#x000A;SamplesPerChip_WCDMA = 16;&#x000D;&#x000A;SR_WCDMA = 3.84e6*SamplesPerChip_WCDMA;&#x000D;&#x000A;Power_WCDMA_dBm = 24; %dBm&#x000D;&#x000A;Power_WCDMA = 10^((Power_WCDMA_dBm-30)/10);&#x000D;&#x000A;&#x000D;&#x000A;% LTE Configuration&#x000D;&#x000A;BW_LTE_Index = 2; % 2 for 5MHz&#x000D;&#x000A;BW_LTE = 5e6;&#x000D;&#x000A;Foffset_LTE = 2.5e6;&#x000D;&#x000A;Fc_LTE = F_Block2_BWhigh - Foffset_LTE;&#x000D;&#x000A;LTE_OversamplingOption = 1; &#x000D;&#x000A;SR_LTE = 15.36e6;&#x000D;&#x000A;Power_LTE = 24; %dBm&#x000D;&#x000A;NumOfRBs_Table = [6,15,25,50,75,100];&#x000D;&#x000A;NumOfRBs = NumOfRBs_Table(BW_LTE_Index+1);&#x000D;&#x000A;RS_EPRE_LTE = Power_LTE - 10*log10(12*NumOfRBs);&#x000D;&#x000A;&#x000D;&#x000A;SampleRates = [SR_WCDMA SR_LTE];&#x000D;&#x000A;Fcs = [Fc_WCDMA Fc_LTE];&#x000D;&#x000A;Bandwidths = [BW_WCDMA BW_LTE ];&#x000D;&#x000A;&#x000D;&#x000A;Fc_AdjacentCh1 = F_Block1_BWhigh + 2.5e6;&#x000D;&#x000A;Fc_AdjacentCh2 = F_Block1_BWhigh + 7.5e6;&#x000D;&#x000A;&#x000D;&#x000A;Fc_WCDMA_L1 = Fc_WCDMA - 5e6&#x000D;&#x000A;Fc_WCDMA_L2 = Fc_WCDMA - 10e6;&#x000D;&#x000A;&#x000D;&#x000A;Fc_LTE_U1 = Fc_LTE + 5e6;&#x000D;&#x000A;Fc_LTE_U2 = Fc_LTE + 10e6;&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;</Text>
