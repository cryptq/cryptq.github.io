<Item XName="CalculateACLR" UserName="CalculateACLR" Type="Equation">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>using(&apos;Design1_Data&apos;);&#x000D;&#x000A;% The ref BW is 4.5MHz for a 5MHz LTE channel&#x000D;&#x000A;Fc_LTE_Start = Fc_LTE - 2.25e6;&#x000D;&#x000A;Fc_LTE_Stop = Fc_LTE + 2.25e6;&#x000D;&#x000A;StartIndex_LTE = find(MSR_spec_Power_Freq == Fc_LTE_Start);&#x000D;&#x000A;StopIndex_LTE = find(MSR_spec_Power_Freq == Fc_LTE_Stop);&#x000D;&#x000A;MeasPower_LTE = sum(MSR_spec_Power(StartIndex_LTE:StopIndex_LTE));&#x000D;&#x000A;MeasPower_LTE_dBm = 10*log10(MeasPower_LTE*1000);&#x000D;&#x000A;&#x000D;&#x000A;% WCDMA&#x000D;&#x000A;Fc_WCDMA_Start = Fc_WCDMA - 2.5e6;&#x000D;&#x000A;Fc_WCDMA_Stop = Fc_WCDMA + 2.5e6;&#x000D;&#x000A;StartIndex_WCDMA = find(FilteredCarrier1_spec_Power_Freq == Fc_WCDMA_Start);&#x000D;&#x000A;StopIndex_WCDMA = find(FilteredCarrier1_spec_Power_Freq == Fc_WCDMA_Stop);&#x000D;&#x000A;MeasPower_WCDMA = sum(FilteredCarrier1_spec_Power(StartIndex_WCDMA:StopIndex_WCDMA));&#x000D;&#x000A;MeasPower_WCDMA_dBm = 10*log10(MeasPower_WCDMA*1000);&#x000D;&#x000A;&#x000D;&#x000A;% LTE upper 1&#x000D;&#x000A;Fc_LTE_U1_Start = Fc_LTE_U1 - 2.5e6;&#x000D;&#x000A;Fc_LTE_U1_Stop = Fc_LTE_U1 + 2.5e6;;&#x000D;&#x000A;StartIndex_LTEU1 = find(Fc_LTE_U1_spec_Power_Freq == Fc_LTE_U1_Start);&#x000D;&#x000A;StopIndex_LTEU1 = find(Fc_LTE_U1_spec_Power_Freq == Fc_LTE_U1_Stop);&#x000D;&#x000A;MeasPower_LTEU1 = sum(Fc_LTE_U1_spec_Power(StartIndex_LTEU1:StopIndex_LTEU1));&#x000D;&#x000A;MeasPower_LTEU1_dBm = 10*log10(MeasPower_LTEU1*1000);&#x000D;&#x000A;&#x000D;&#x000A;% LTE upper 2&#x000D;&#x000A;Fc_LTE_U2_Start = Fc_LTE_U2 - 2.5e6;&#x000D;&#x000A;Fc_LTE_U2_Stop = Fc_LTE_U2 + 2.5e6;;&#x000D;&#x000A;StartIndex_LTEU2 = find(Fc_LTE_U2_spec_Power_Freq == Fc_LTE_U2_Start);&#x000D;&#x000A;StopIndex_LTEU2 = find(Fc_LTE_U2_spec_Power_Freq == Fc_LTE_U2_Stop);&#x000D;&#x000A;MeasPower_LTEU2 = sum(Fc_LTE_U2_spec_Power(StartIndex_LTEU2:StopIndex_LTEU2));&#x000D;&#x000A;MeasPower_LTEU2_dBm = 10*log10(MeasPower_LTEU2*1000);&#x000D;&#x000A;&#x000D;&#x000A;% WCDMA Lower 1&#x000D;&#x000A;Fc_WCDMA_L1_Start = Fc_WCDMA_L1 - 2.5e6;&#x000D;&#x000A;Fc_WCDMA_L1_Stop = Fc_WCDMA_L1 + 2.5e6;&#x000D;&#x000A;StartIndex_WCDMAL1 = find(Fc_WCDMA_L1_spec_Power_Freq == Fc_WCDMA_L1_Start);&#x000D;&#x000A;StopIndex_WCDMAL1 = find(Fc_WCDMA_L1_spec_Power_Freq == Fc_WCDMA_L1_Stop);&#x000D;&#x000A;MeasPower_WCDMAL1 = sum(Fc_WCDMA_L1_spec_Power(StartIndex_WCDMAL1:StopIndex_WCDMAL1));&#x000D;&#x000A;MeasPower_WCDMAL1_dBm = 10*log10(MeasPower_WCDMAL1*1000);&#x000D;&#x000A;&#x000D;&#x000A;% WCDMA Lower 2&#x000D;&#x000A;Fc_WCDMA_L2_Start = Fc_WCDMA_L2 - 2.5e6;&#x000D;&#x000A;Fc_WCDMA_L2_Stop = Fc_WCDMA_L2 + 2.5e6;&#x000D;&#x000A;StartIndex_WCDMAL2 = find(Fc_WCDMA_L2_spec_Power_Freq == Fc_WCDMA_L2_Start);&#x000D;&#x000A;StopIndex_WCDMAL2 = find(Fc_WCDMA_L2_spec_Power_Freq == Fc_WCDMA_L2_Stop);&#x000D;&#x000A;MeasPower_WCDMAL2 = sum(Fc_WCDMA_L2_spec_Power(StartIndex_WCDMAL2:StopIndex_WCDMAL2));&#x000D;&#x000A;MeasPower_WCDMAL2_dBm = 10*log10(MeasPower_WCDMAL2*1000);&#x000D;&#x000A;&#x000D;&#x000A;% Adjacent Channel 1&#x000D;&#x000A;Fc_Ch1_Start = Fc_AdjacentCh1 - 2.5e6;&#x000D;&#x000A;Fc_Ch1_Stop = Fc_AdjacentCh1 + 2.5e6;&#x000D;&#x000A;StartIndex_Ch1 = find(AdjacentCh1_spec_Power_Freq == Fc_Ch1_Start);&#x000D;&#x000A;StopIndex_Ch1 = find(AdjacentCh1_spec_Power_Freq == Fc_Ch1_Stop);&#x000D;&#x000A;MeasPower_Ch1 = sum(AdjacentCh1_spec_Power(StartIndex_Ch1:StopIndex_Ch1));&#x000D;&#x000A;MeasPower_Ch1_dBm = 10*log10(MeasPower_Ch1*1000);&#x000D;&#x000A;&#x000D;&#x000A;% Adjacent Channel 2&#x000D;&#x000A;Fc_Ch2_Start = Fc_AdjacentCh2 - 2.5e6;&#x000D;&#x000A;Fc_Ch2_Stop = Fc_AdjacentCh2 + 2.5e6;&#x000D;&#x000A;StartIndex_Ch2 = find(AdjacentCh2_spec_Power_Freq == Fc_Ch2_Start);&#x000D;&#x000A;StopIndex_Ch2 = find(AdjacentCh2_spec_Power_Freq == Fc_Ch2_Stop);&#x000D;&#x000A;MeasPower_Ch2 = sum(AdjacentCh2_spec_Power(StartIndex_Ch2:StopIndex_Ch2));&#x000D;&#x000A;MeasPower_Ch2_dBm = 10*log10(MeasPower_Ch2*1000);&#x000D;&#x000A;&#x000D;&#x000A;% ACLR&#x000D;&#x000A;CACLR_1 = MeasPower_WCDMA_dBm + MeasPower_LTE_dBm - MeasPower_Ch1_dBm;&#x000D;&#x000A;CACLR_2 = MeasPower_WCDMA_dBm + MeasPower_LTE_dBm - MeasPower_Ch2_dBm;&#x000D;&#x000A;ACLR_WCDMA_L1 = MeasPower_WCDMA_dBm - MeasPower_WCDMAL1_dBm;&#x000D;&#x000A;ACLR_WCDMA_L2 = MeasPower_WCDMA_dBm - MeasPower_WCDMAL2_dBm;&#x000D;&#x000A;ACLR_LTE_U1 = MeasPower_LTE_dBm - MeasPower_LTEU1_dBm;&#x000D;&#x000A;ACLR_LTE_U2 = MeasPower_LTE_dBm - MeasPower_LTEU2_dBm;</Text>
