<Item XName="TestConfiguration" UserName="TestConfiguration" Type="Equation">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>% Band number 8&#x000D;&#x000A;% 880MHz - 915MHz&#x000D;&#x000A;F_BWlow = 880e6;&#x000D;&#x000A;F_BWhigh = 915e6;&#x000D;&#x000A;F_BWmid = (F_BWhigh + F_BWlow)/2;&#x000D;&#x000A;&#x000D;&#x000A;% TC5a&#x000D;&#x000A;% GSM Configuration&#x000D;&#x000A;BW_GSM = 200e3;&#x000D;&#x000A;Foffset_GSM = 200e3;&#x000D;&#x000A;Fc_GSM = F_BWlow + Foffset_GSM;&#x000D;&#x000A;GSM_TSC = 6;&#x000D;&#x000A;GSM_ChannelType = 17;&#x000D;&#x000A;GSM_Ps = -98 + 3;&#x000D;&#x000A;GSM_BitsPerSlotTable = [260,1200,600,72,209,257,329,385,956,1244,940,1132,1228,209,257,329,385,487,631,946,1138,1234,1594,623,1228,2248];&#x000D;&#x000A;GSM_BitsPerSlot = GSM_BitsPerSlotTable(GSM_ChannelType+1);&#x000D;&#x000A;if GSM_ChannelType == 1&#x000D;&#x000A;&#x0009;GSM_BitsDelayed = 1440;&#x000D;&#x000A;elseif GSM_ChannelType == 2&#x000D;&#x000A;&#x0009;GSM_BitsDelayed = 720;&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;GSM_BitsDelayed = GSM_BitsPerSlot *2;&#x000D;&#x000A;end&#x000D;&#x000A;if (GSM_ChannelType &lt; 8 || (GSM_ChannelType &gt; 12 &amp;&amp; GSM_ChannelType &lt; 17)) % GMSK&#x000D;&#x000A;&#x0009;GSM_ModType = 0;&#x000D;&#x000A;elseif(GSM_ChannelType ==22)&#x0009;%16QAM&#x000D;&#x000A;&#x0009;GSM_ModType = 2;&#x000D;&#x000A;elseif(GSM_ChannelType ==23)&#x0009;%HSR QPSK&#x000D;&#x000A;&#x0009;GSM_ModType = 4;&#x000D;&#x000A;elseif(GSM_ChannelType ==24)&#x0009;%HSR 16-QAM&#x000D;&#x000A;&#x0009;GSM_ModType = 5;&#x000D;&#x000A;elseif(GSM_ChannelType ==25)&#x0009;%HSR 32-QAM&#x000D;&#x000A;&#x0009;GSM_ModType = 6;&#x000D;&#x000A;else % 8PSK&#x000D;&#x000A;&#x0009;GSM_ModType = 1;&#x000D;&#x000A;end&#x000D;&#x000A;if GSM_ModType &lt; 4&#x000D;&#x000A;&#x0009;GSM_BaseRate = 270833.333333333;&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;GSM_BaseRate = 325000;&#x000D;&#x000A;end&#x000D;&#x000A;GSM_SamplesPerSymbOption = 2;&#x000D;&#x000A;GSM_SamplesPerSymb = 2^(GSM_SamplesPerSymbOption+2);&#x000D;&#x000A;SR_GSM = floor(GSM_BaseRate * GSM_SamplesPerSymb * 3);&#x000D;&#x000A;SR_GSM = 13e6;&#x000D;&#x000A;GSM_EqAlgrithm = 1;&#x000D;&#x000A;switch GSM_ModType&#x000D;&#x000A;&#x0009;case 0&#x000D;&#x000A;&#x0009;&#x0009;PartitionArray =[2,2,2,2,2];&#x000D;&#x000A;&#x0009;case 1&#x000D;&#x000A;&#x0009;&#x0009;PartitionArray= [8,4,2,2,1];&#x000D;&#x000A;&#x0009;case 2&#x000D;&#x000A;&#x0009;&#x0009;PartitionArray= [16,8,4,2,1];&#x000D;&#x000A;&#x0009;case 3&#x000D;&#x000A;&#x0009;&#x0009;PartitionArray= [32,16,8,4,2];&#x000D;&#x000A;&#x0009;case 4&#x000D;&#x000A;&#x0009;&#x0009;PartitionArray= [4,4,4,4,4];&#x000D;&#x000A;&#x0009;case 5&#x000D;&#x000A;&#x0009;&#x0009;PartitionArray= [16,8,4,2,1];&#x000D;&#x000A;&#x0009;case 6&#x000D;&#x000A;&#x0009;&#x0009;PartitionArray= [32,16,8,4,2];&#x0009;&#x000D;&#x000A;&#x0009;otherwise&#x000D;&#x000A;&#x0009;&#x0009;PartitionArray =[2,2,2,2,2];&#x0009;&#x000D;&#x000A;end&#x000D;&#x000A;GSM_SignalPower_dBm = 20;&#x000D;&#x000A;Power_GSM = 10^(GSM_SignalPower_dBm/10) / 1000;&#x000D;&#x000A;&#x000D;&#x000A;% WCDMA configuration&#x000D;&#x000A;BW_WCDMA = 5e6;&#x000D;&#x000A;Foffset_WCDMA = 2.5e6;&#x000D;&#x000A;Fc_WCDMA = F_BWhigh - Foffset_WCDMA - 100e3; % channel raster of UTRA is 200KHz&#x000D;&#x000A;SamplesPerChip_WCDMA = 16;&#x000D;&#x000A;SR_WCDMA = 3.84e6*SamplesPerChip_WCDMA;&#x000D;&#x000A;Power_WCDMA_dBm = -110.3 + 6; %dBm&#x000D;&#x000A;Power_WCDMA = 10^((Power_WCDMA_dBm-30)/10);&#x000D;&#x000A;WCDMA_FilterLength = 16;&#x000D;&#x000A;TStep=1/SR_WCDMA;&#x000D;&#x000A;SourceDelay=(284+2*floor(WCDMA_FilterLength*SamplesPerChip_WCDMA/2)+1)*TStep;&#x000D;&#x000A;WCDMA_WantedSignal_dBm = -115;&#x000D;&#x000A;WCDMA_GainIndex = 11;&#x000D;&#x000A;WCDMA_RefCh=0;&#x000D;&#x000A;if (WCDMA_RefCh &lt; 5)&#x000D;&#x000A;&#x0009;WCDMA_Cali_Gain = 1.0/sqrt(1.0+(WCDMA_GainIndex/15.0)^2);&#x000D;&#x000A;elseif (WCDMA_RefCh == 5)&#x000D;&#x000A;&#x0009;WCDMA_Cali_Gain = 1.0/sqrt(2.0+(WCDMA_GainIndex/15.0)^2);&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;WCDMA_Cali_Gain = 1.0/sqrt(6.0+(WCDMA_GainIndex/15.0)^2);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;% Interferer&#x000D;&#x000A;FcStart_Interferer = F_BWhigh + 7.5e6;&#x000D;&#x000A;FreqOffsetStep=tune(0); % step size is 1MHz&#x000D;&#x000A;Fc_Interferer = FcStart_Interferer + FreqOffsetStep*1e6; &#x000D;&#x000A;BW_Interferer = 5e6;&#x000D;&#x000A;Interferer_SamplesPerChip = 16; &#x000D;&#x000A;SR_Interferer = 3.84e6 * Interferer_SamplesPerChip;&#x000D;&#x000A;Interferer_Power_dBm = -40;&#x000D;&#x000A;Power_Interferer = 10^(Interferer_Power_dBm/10) / 1000;&#x000D;&#x000A;Interferer_FilterLength = 16;&#x000D;&#x000A;L = floor(Interferer_FilterLength/2);&#x000D;&#x000A;Alpha = 0.22;&#x000D;&#x000A;SampPerSym = Interferer_SamplesPerChip;&#x000D;&#x000A;FilterType = &apos;sqrt&apos;;&#x000D;&#x000A;Window = &apos;rectangular&apos;;&#x000D;&#x000A;RRC_Coef = WCDMA_firrcos(L,Alpha,SampPerSym,FilterType,Window);&#x000D;&#x000A;&#x000D;&#x000A;SampleRates = [SR_GSM SR_WCDMA SR_Interferer];&#x000D;&#x000A;Fcs = [Fc_GSM Fc_WCDMA Fc_Interferer];&#x000D;&#x000A;Bandwidths = [BW_GSM BW_WCDMA BW_Interferer];&#x000D;&#x000A;OutputSampleRate = 61.44e6;&#x000D;&#x000A;&#x000D;&#x000A;% BER measurements&#x000D;&#x000A;GSM_BlockNum = 100;&#x000D;&#x000A;WCDMAFrameNum = 100;</Text>
<UnitUse><T>Int</T><D>2</D></UnitUse>
