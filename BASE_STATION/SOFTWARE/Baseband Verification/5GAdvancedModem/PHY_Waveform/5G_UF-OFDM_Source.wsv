<Item XName="Equations" Type="Equation">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>%%%%%%%%%%%%%%%%%%%%range check%%%%%%%%%%%%%%%%%%%%%&#x000D;&#x000A;if NumSubcarriers &lt;0&#x000D;&#x000A;error(&apos;NumSubcarriers should be no less than 0!&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if(BaseSampleRate&lt;=0)&#x000D;&#x000A;error(&apos;BaseSampleRate should be greater than 0!&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if(FilterLength&lt;=0)&#x000D;&#x000A;error(&apos;FilterLength should be greater than 0!&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if(NumSubcarriersPerSubband&lt;=0)&#x000D;&#x000A;error(&apos;NumSubcarriersPerSubband should be greater than 0!&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if(length(FilterCoef)~= FilterLength)&#x000D;&#x000A;error(&apos;The number of filter coefficients should be equal to FilterLength!&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if(NumSubbands &lt;=0)&#x000D;&#x000A;error(&apos;NumSubbands should be greater than 0!&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if((mod(NumSubcarriersPerSubband,2)==1)|(NumSubcarriersPerSubband ==2))&#x000D;&#x000A;error(&apos;NumSubcarriersPerSubband should be a positive even integer(&gt;=4)!&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if(NumSubbands*NumSubcarriersPerSubband &gt; NumSubcarriers)&#x000D;&#x000A;error(&apos;Total number of subcarriers is more than NumSubcarriers!&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;SubbandStartLocation_ascend = sort(SubbandStartLocation);&#x000D;&#x000A;for jj = 1:length(SubbandStartLocation)&#x000D;&#x000A;&#x0009;if ((SubbandStartLocation(jj) &lt; (-NumSubcarriers/2))|(SubbandStartLocation(jj) &gt;=(NumSubcarriers/2)))&#x000D;&#x000A;&#x0009;&#x0009;error(&apos;The elements in StartLocationSubband should be in the range [-NumSubcarriers/2, NumSubcarriers/2)!&apos;);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x0009;if ((SubbandStartLocation(jj) &lt; (-NumSubcarriers/2))&amp;(SubbandStartLocation(jj) &gt;=(NumSubcarriers/2)))&#x000D;&#x000A;&#x0009;&#x0009;error(&apos;The elements in SubbandStartLocation should be in the range [-NumSubcarriers/2, NumSubcarriers/2)!&apos;);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x0009;if(jj &lt; length(SubbandStartLocation))&#x000D;&#x000A;&#x0009;&#x0009;if ((SubbandStartLocation_ascend(jj)+ NumSubcarriersPerSubband)&gt; SubbandStartLocation_ascend(jj+1))&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;error([&apos;The start location &apos; num2str(SubbandStartLocation_ascend(jj+1)) &apos; is in the another subband!&apos;]);&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if(length(SubbandStartLocation)~= NumSubbands)&#x000D;&#x000A;&#x0009;error(&apos;The element number in SubbandStartLocation should be equal to NumSubbands&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;PilotsLocation_ascend = sort(PilotsLocation);&#x000D;&#x000A;&#x000D;&#x000A;if(PilotsLocation_ascend(end) &gt;= NumSubcarriersPerSubband)&#x000D;&#x000A;&#x0009;error(&apos;PilotsLocation should be in the range [0, NumSubcarriersPerSubband)!&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%&#x000D;&#x000A;index = zeros(NumSubbands,2);&#x000D;&#x000A;&#x000D;&#x000A;for i = 1: NumSubbands&#x000D;&#x000A;&#x0009;index(i,1) = SubbandStartLocation(i);&#x000D;&#x000A;&#x0009;index(i,2) = SubbandStartLocation(i)+ NumSubcarriersPerSubband -1;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;NumOfData = (NumSubcarriersPerSubband-length(PilotsLocation))*NumSubbands;&#x000D;&#x000A;NumOfDataPerSubband = (NumSubcarriersPerSubband-length(PilotsLocation));&#x000D;&#x000A;NumOfPilots = length(PilotsLocation)*NumSubbands;&#x000D;&#x000A;NumOfPilotsPerSubband = length(PilotsLocation);&#x000D;&#x000A;for i = 1:NumSubbands&#x000D;&#x000A;&#x0009;PilotsIndex((i-1)*length(PilotsLocation)+1:i*length(PilotsLocation)) = &#x0009;SubbandStartLocation(i)*ones(1,length(PilotsLocation))+ PilotsLocation;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;DataIndextmp = zeros(1,NumOfDataPerSubband);%%%%Relative DataIndex of every subband in [0,NumSubcarriersPerSubband-1]&#x000D;&#x000A;Indextmp = [0:NumSubcarriersPerSubband-1];&#x000D;&#x000A;m=1;&#x000D;&#x000A;&#x000D;&#x000A;for j=1:NumSubcarriersPerSubband&#x000D;&#x000A;&#x0009;if(find(Indextmp(j)==PilotsLocation))&#x000D;&#x000A;&#x0009;else&#x000D;&#x000A;&#x0009;&#x0009;DataIndextmp(m) = Indextmp(j);&#x000D;&#x000A;&#x0009;&#x0009;m=m+1&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;DataFilterIndex = zeros(1,NumOfDataPerSubband);&#x000D;&#x000A;DataFilterIndex= -floor(NumSubcarriersPerSubband/2)+ DataIndextmp;&#x000D;&#x000A;PilotsFilterIndex = zeros(1,NumOfPilotsPerSubband);&#x000D;&#x000A;PilotsFilterIndex= -floor(NumSubcarriersPerSubband/2)+ PilotsLocation;&#x000D;&#x000A;&#x000D;&#x000A;NumSubcarriersOS = NumSubcarriers * 2^OversampleOption;&#x000D;&#x000A;DataIndex = zeros(1,NumOfData);&#x000D;&#x000A;for i = 1:NumSubbands&#x000D;&#x000A;&#x0009;DataIndex((i-1)*NumOfDataPerSubband+1:i*NumOfDataPerSubband) = &#x0009;SubbandStartLocation(i)+ DataIndextmp;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;FCoef = fft(FilterCoef,NumSubcarriersOS);&#x000D;&#x000A;ActiveCoef = [FCoef(end-floor(NumSubcarriersPerSubband/2)+1:end),FCoef(1:NumSubcarriersPerSubband-floor(NumSubcarriersPerSubband/2))];&#x000D;&#x000A;power =  sqrt(mean(abs(ActiveCoef).^2));&#x000D;&#x000A;&#x000D;&#x000A;F_t = ActiveCoef/sqrt(NumSubcarriers);&#x000D;&#x000A;&#x000D;&#x000A;FilterUndoCompensate = sqrt(mean(abs(F_t).^2))./F_t;&#x000D;&#x000A;FilterUndoCompensate_D = FilterUndoCompensate(DataIndextmp+1).&apos;;&#x000D;&#x000A;FilterUndoCompensate_P = FilterUndoCompensate(PilotsLocation+1).&apos;;&#x000D;&#x000A;&#x000D;&#x000A;if AddCP == 1&#x000D;&#x000A;&#x0009;GuardInterval = CP_NumSymbols/NumSubcarriers;&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;GuardInterval = 0;&#x000D;&#x000A;end;&#x000D;&#x000A;&#x000D;&#x000A;NumSubcarriersOS = NumSubcarriers * 2^OversampleOption;&#x000D;&#x000A;CP_NumSymbolsOS = CP_NumSymbols * 2^OversampleOption;&#x000D;&#x000A;&#x000D;&#x000A;%delay the extra sample so that overall one UFMC symbol is delayed in the receiver&#x000D;&#x000A;SignalDelay = NumSubcarriersOS+FilterLength-1 - ReceiverDelay;&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;%Data symbols per UFMC symbol&#x000D;&#x000A;SymsPerUFMCSymbol = (NumSubcarriersPerSubband-length(PilotsLocation))*NumSubbands;</Text>
