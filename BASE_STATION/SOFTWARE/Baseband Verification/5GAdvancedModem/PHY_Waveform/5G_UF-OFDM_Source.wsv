<Item XName="Equations" Type="Equation">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>%%UFMC-like filter&#x000D;&#x000A;BaseFilterLength = 16;&#x000D;&#x000A;%FilterCoef =[0.1138,0.1964,0.3319,0.4926,0.6613,0.8163,0.9353,1.0000,1.0000,0.9353,0.8163,0.6613,0.4926,0.3319,0.1964,0.1138];%chebwin(16,40);&#x000D;&#x000A;FilterCoef =[0.0014,0.0114,0.0498,0.1472,0.3278,0.5791,0.8355,1.0000,1.0000,0.8355,0.5791,0.3278,0.1472,0.0498,0.0114,0.0014];%chebwin(16,120);&#x000D;&#x000A;&#x000D;&#x000A;%%%OFDM-like filter&#x000D;&#x000A;%BaseFilterLength = 1;&#x000D;&#x000A;%FilterCoef = [1];&#x000D;&#x000A;&#x000D;&#x000A;%Generate filter coef with OversampleOption&#x000D;&#x000A;FilterLength = BaseFilterLength*2^OversampleOption;&#x000D;&#x000A;if (OversampleOption == 0)&#x000D;&#x000A;&#x0009;FilterCoef = FilterCoef;&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;f = fft(FilterCoef);&#x000D;&#x000A;&#x0009;ff = [f(1,1:end/2), zeros(1,FilterLength-BaseFilterLength), f(end/2+1:end)];&#x000D;&#x000A;&#x0009;FilterCoef = ifft(ff);&#x000D;&#x000A;end;&#x000D;&#x000A;&#x000D;&#x000A;SampleRate = BaseSampleRate*2^OversampleOption;&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;rng(1);&#x000D;&#x000A;PilotsSeq = randn(1,4*1000);&#x000D;&#x000A;</Text>
