<DataEntry>8</DataEntry>
<Description>Number of HARQ processes for UE1</Description>
<HideCondition>0==ShowUE1_Parameters || UE1_HARQ_Enable == 0</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>11</D></Validate></Item>
<Item XName="UE1_PMI_Delay" Type="PartParam">
<DataEntry>6</DataEntry>
<Description>closed-loop PMI reporting delay in units of sub-frames (1ms) for UE1</Description>
<HideCondition>1</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>11</D></Validate></Item>
<Item XName="UE1_PMI_Granularity" Type="PartParam">
<DataEntry>25</DataEntry>
<Description>closed-loop PMI reporting granularity in units of resource blocks (RBs) for UE1</Description>
<HideCondition>1</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>11</D></Validate></Item>
<Item XName="UE1_Payload" Type="PartParam">
<DataEntry>UE1_Payload_0</DataEntry>
<Description>the input payload for UE 1, the meaning of the input is defined in UE1_Config</Description>
<HideCondition>0==ShowUE1_Parameters</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>14</D></Validate></Item>
<Item XName="UE1_RB_Alloc" Type="PartParam">
<DataEntry>UE1_RB_Alloc0</DataEntry>
<Description>the RB allocation for UE 1, in the formats of [start RB, number of RBs] or [SF0 start RB, SF0 number of RBs; . . . ; SF9 start RB, SF9 number of RBs]</Description>
<HideCondition>0==ShowUE1_Parameters</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="UE1_RV_Sequence" Type="PartParam">
<DataEntry>[0, 1, 2, 3]</DataEntry>
<Description>Redundancy Version Sequence for HARQ transmission for UE 1</Description>
<HideCondition>0==ShowUE1_Parameters</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="UE1_SNREstimatorMode" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>the working mode of SNR estimator.</Description>
<Enum>LTE_A_CQI_Gen__SNREstimatorMode@LTE Advanced Enums</Enum>
<HideCondition>0==UE1_AMC_Enable</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="UE1_SNRFilterAlpha" Type="PartParam">
<DataEntry>0.01</DataEntry>
<Description>The filter coefficient value for SNR estimation</Description>
<HideCondition>0==UE1_AMC_Enable</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="UE1_SNRToCQI" Type="PartParam">
<DataEntry>[0.0, 2.7, 4.3, 5.7, 6.9, 7.8, 8.1, 9.0, 10.0, 10.9, 12.3, 13.5, 15.6, 17.2, 19.9]</DataEntry>
<Description>minimum SNR values corresponding to CQI index 1 to 15</Description>
<HideCondition>0==UE1_AMC_Enable</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>14</D></Validate></Item>
<Item XName="UE1_n_RNTI" Type="PartParam">
<DataEntry>1</DataEntry>
<Description>Radio network temporary identifier for UE 1</Description>
<HideCondition>0==ShowUE1_Parameters</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>11</D></Validate></Item>
<Item XName="UE2_RB_Alloc" Type="PartParam">
<DataEntry>[0,0]</DataEntry>
<Description>the RB allocation for UE 2, in the formats of [start RB, number of RBs] or [SF0 start RB, SF0 number of RBs; . . . ; SF9 start RB, SF9 number of RBs]</Description>
<HideCondition>0==ShowOtherUEs_Parameters</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="UE3_RB_Alloc" Type="PartParam">
<DataEntry>[0,0]</DataEntry>
<Description>the RB allocation for UE 3, in the formats of [start RB, number of RBs] or [SF0 start RB, SF0 number of RBs; . . . ; SF9 start RB, SF9 number of RBs]</Description>
<HideCondition>0==ShowOtherUEs_Parameters</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="UE4_RB_Alloc" Type="PartParam">
<DataEntry>[0,0]</DataEntry>
<Description>the RB allocation for UE 4, in the formats of [start RB, number of RBs] or [SF0 start RB, SF0 number of RBs; . . . ; SF9 start RB, SF9 number of RBs]</Description>
<HideCondition>0==ShowOtherUEs_Parameters</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="UE5_RB_Alloc" Type="PartParam">
<DataEntry>[0,0]</DataEntry>
<Description>the RB allocation for UE 5, in the formats of [start RB, number of RBs] or [SF0 start RB, SF0 number of RBs; . . . ; SF9 start RB, SF9 number of RBs]</Description>
<HideCondition>0==ShowOtherUEs_Parameters</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="UE6_RB_Alloc" Type="PartParam">
<DataEntry>[0,0]</DataEntry>
<Description>the RB allocation for UE 6, in the formats of [start RB, number of RBs] or [SF0 start RB, SF0 number of RBs; . . . ; SF9 start RB, SF9 number of RBs]</Description>
<HideCondition>0==ShowOtherUEs_Parameters</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="UEs_CDD_Mode" Type="PartParam">
<DataEntry>[1,1,1,1,1,1]</DataEntry>
<Description>CDD Mode for each UE, 1 for Zero-Delay, 0 for Large-Delay</Description>
<HideCondition>0==ShowMIMO_Parameters</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="UEs_CdBlk_Index" Type="PartParam">
<DataEntry>[0,0,0,0,0,0]</DataEntry>
<Description>codebook index for precoding for each UE</Description>
<HideCondition>0==ShowMIMO_Parameters</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="UEs_MIMO_Mode" Type="PartParam">
<DataEntry>[0,0,0,0,0,0]</DataEntry>
<Description>MIMO Mode for each UE, 1 for TD, 0 for SM</Description>
<HideCondition>0==ShowMIMO_Parameters</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="UEs_NumOfCWs" Type="PartParam">
<DataEntry>[1,1,1,1,1,1]</DataEntry>
<Description>number of code words for each UE</Description>
<HideCondition>0==ShowMIMO_Parameters</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="UEs_NumOfLayers" Type="PartParam">
<DataEntry>[1,1,1,1,1,1]</DataEntry>
<Description>number of layers for each UE</Description>
<HideCondition>0==ShowMIMO_Parameters</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="UEs_Pa" Type="PartParam">
<DataEntry>[0,0,0,0,0,0]</DataEntry>
<Description>UE specific power parameter for each UE</Description>
<HideCondition>0==ShowPowerParameters</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>14</D></Validate></Item>
<Item XName="UEs_SpecificRS" Type="PartParam">
<DataEntry>[0,0,0,0,0,0]</DataEntry>
<Description>the antenna port for transmission mode 8 for each UE, 0 is port7, 1 is port8</Description>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="UEs_TransMode" Type="PartParam">
<DataEntry>[0, 0, 0, 0, 0, 0]</DataEntry>
<Description>UEs transmission mode[0,8]</Description>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="UEs_n_SCID" Type="PartParam">
<DataEntry>[0, 0, 0, 0, 0, 0]</DataEntry>
<Description>given by the scrambling identity field in the most recent DCI format 2B associated with the PDSCH transmission for each layer</Description>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item></Item></Item></Item>
