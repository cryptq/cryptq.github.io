<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="ShowUE1_Parameters" Type="PartParam">
<DataEntry>1</DataEntry>
<Description>show parameters for coded UE1</Description>
<Enum>LTE_DL_MIMO_2Ant_Rcv_ShowParameters@LTE 8.9 Enums</Enum>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="SpecialSF_Config" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>downlink and uplink allocations for TDD</Description>
<Enum>LTE_DL_MIMO_2Ant_Rcv_SpecialSF_Config@LTE 8.9 Enums</Enum>
<HideCondition>0==ShowSystemParameters || FrameMode ~= 1</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="Sym_StartPos" Type="PartParam">
<DataEntry>[-10, -10]</DataEntry>
<Description>start position (without oversampling) to get the OFDM symbol for FFT operation for long CP and short CP symbols respectively, compared to the start position of the OFDM body after CP</Description>
<HideCondition>0==ShowRxAlgorithmParameters</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="SyncMode" Type="PartParam">
<DataEntry>1</DataEntry>
<Description>synchronization for every port or one synchronization for all ports</Description>
<Enum>LTE_DL_MIMO_2Ant_Rcv_SyncMode@LTE 8.9 Enums</Enum>
<HideCondition>0==ShowRxAlgorithmParameters</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="TC_Iteration" Type="PartParam">
<DataEntry>6</DataEntry>
<Description>Turbo decoder iteration number</Description>
<HideCondition>0==ShowRxAlgorithmParameters</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>11</D></Validate></Item>
<Item XName="TDD_Config" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>downlink and uplink allocations for TDD</Description>
<Enum>LTE_DL_MIMO_2Ant_Rcv_TDD_Config@LTE 8.9 Enums</Enum>
<HideCondition>0==ShowSystemParameters || FrameMode ~= 1</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="Tmax" Type="PartParam">
<DataEntry>Tmax</DataEntry>
<Description>the maximum delay of multi-path channel. (used by 2D-MMSE channel estimator in PDSCH)</Description>
<HideCondition>0==ShowRxAlgorithmParameters || ChEstimatorMode ~= 1</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Unit><T>Int</T><D>7004</D></Unit>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="TrackRange" Type="PartParam">
<DataEntry>100e-6</DataEntry>
<Description>timing and frequence synchronization tracking range for the frames except the first frame, valid when SearchType is set to Search+Track</Description>
<HideCondition>0==ShowRxAlgorithmParameters || SearchType ~= 1</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Unit><T>Int</T><D>7004</D></Unit>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="UE1_AMC_Delay" Type="PartParam">
<DataEntry>4</DataEntry>
<Description>the CQI feedback delay in unit of subframes</Description>
<HideCondition>0==UE1_AMC_Enable</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>11</D></Validate></Item>
<Item XName="UE1_AMC_Enable" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>whether enable adaptive modulation and coding or not</Description>
<Enum>LTE_A_HARQ_Controller__AMC_Enable@LTE Advanced Enums</Enum>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="UE1_CL_Precoding_Enable" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>whether closed-loop MIMO precoding for UE1 is enabled</Description>
<Enum>LTE_DL_MIMO_Deprecoder__CL_Precoding_Enable@LTE 8.9 Enums</Enum>
<HideCondition>1</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="UE1_CQIToMCS" Type="PartParam">
<DataEntry>[0, 0, 0, 2, 4, 6, 8, 11, 13, 15, 18, 20, 22, 24, 26, 28]</DataEntry>
<Description>MCS indices corresponding to CQI index 0 to 15</Description>
<HideCondition>0==UE1_AMC_Enable</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="UE1_Category" Type="PartParam">
<DataEntry>4</DataEntry>
<Description>defines UE1 capability, used to get the total number of soft channel bits for derate-matching in downlink.</Description>
<Enum>LTE_HARQ_Controller__UE_Category@LTE 8.9 Enums</Enum>
<HideCondition>0==ShowUE1_Parameters</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="UE1_Config" Type="PartParam">
<DataEntry>UE1_Config_1</DataEntry>
<Description>the configuration mode of input data for UE 1.</Description>
<Enum>LTE_DL_MIMO_2Ant_Rcv_UE1_Config@LTE 8.9 Enums</Enum>
<HideCondition>0==ShowUE1_Parameters</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="UE1_HARQ_Enable" Type="PartParam">
<DataEntry>UE1_HARQ_Enable</DataEntry>
<Description>Whether HARQ closed-loop transmission is enable for UE1</Description>
<Enum>LTE_DL_Src_FIR_withInterp@LTE 8.9 Enums</Enum>
<HideCondition>0==ShowUE1_Parameters</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="UE1_MappingType" Type="PartParam">
<DataEntry>UE1_MappingType</DataEntry>
<Description>the modulation orders for UE 1 in each subframe, valid when UE1_Payload is not set to MCS index. (0:QPSK, 1:16QAM, 2:64QAM)</Description>
<HideCondition>0==ShowUE1_Parameters || UE1_Config == 0</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="UE1_MaxHARQTrans" Type="PartParam">
<DataEntry>4</DataEntry>
<Description>Maximum number of HARQ transmission per each HARQ process for UE1</Description>
<HideCondition>0==ShowUE1_Parameters || UE1_HARQ_Enable == 0</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>11</D></Validate></Item>
<Item XName="UE1_NumHARQ" Type="PartParam">
<DataEntry>8</DataEntry>
<Description>Number of HARQ processes for UE1</Description>
<HideCondition>0==ShowUE1_Parameters || UE1_HARQ_Enable == 0</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>11</D></Validate></Item>
<Item XName="UE1_PMI_Delay" Type="PartParam">
<DataEntry>6</DataEntry>
<Description>closed-loop PMI reporting delay in units of sub-frames (1ms) for UE1</Description>
<HideCondition>1</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>11</D></Validate></Item>
<Item XName="UE1_PMI_Granularity" Type="PartParam">
<DataEntry>25</DataEntry>
