<Item XName="Equations" Type="Equation">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>% FCarrier&#x000D;&#x000A;FCarrier = 2e9;&#x000D;&#x000A;&#x000D;&#x000A;% Transmit Power and Noise&#x000D;&#x000A;RS_EPRE = -25; %dBm/15KHz&#x000D;&#x000A;NDensity0 = 10^((RS_EPRE-10*log10(15e3)-SNR0)/10)/1000.0;&#x000D;&#x000A;GainSNR = SINR1-SINR0;&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;% Rx algorithm (for EPA 5Hz)&#x000D;&#x000A;Tmax = 0.01e-6;&#x000D;&#x000A;Fmax = 0.01;&#x000D;&#x000A;TC_Iteration = 6;&#x000D;&#x000A;DemapperType = 1;&#x000D;&#x000A;DemapperMaxLevel = 100.0;&#x000D;&#x000A;&#x000D;&#x000A;% Sampling Rate &#x000D;&#x000A;SamplingTable = [1.92 3.84 7.68 15.36 23.04 30.72];&#x000D;&#x000A;SamplingFreq = 1e6*SamplingTable(Bandwidth+1);&#x000D;&#x000A;SamplingRate = SamplingFreq*(2^OversamplingOption);&#x000D;&#x000A;SampsPerFrame = 10*0.001*SamplingRate;&#x000D;&#x000A;SampsPerSF = 0.001*SamplingRate;&#x000D;&#x000A;&#x000D;&#x000A;%RB Allocation (full allocation)&#x000D;&#x000A;RBTable = [6, 15, 25, 50, 75, 100];&#x000D;&#x000A;UE1_RB_Alloc=[0,RBTable(Bandwidth+1)];&#x000D;&#x000A;&#x000D;&#x000A;%Adopt FTPA (Fractional Transmit Power Allocation) method to determine the power allocation among users&#x000D;&#x000A;SINR0_Linear = 10^(SINR0/10);&#x000D;&#x000A;SINR1_Linear = 10^(SINR1/10);&#x000D;&#x000A;FTPA_Alpha = 0.5;&#x000D;&#x000A;P0 = SINR0_Linear^(-FTPA_Alpha)/(SINR0_Linear^(-FTPA_Alpha)+SINR1_Linear^(-FTPA_Alpha));&#x000D;&#x000A;P1 = SINR1_Linear^(-FTPA_Alpha)/(SINR0_Linear^(-FTPA_Alpha)+SINR1_Linear^(-FTPA_Alpha));&#x000D;&#x000A;&#x000D;&#x000A;%Get the best MCSs according to SINRs (target: 10%BLER)&#x000D;&#x000A;&#x000D;&#x000A;SINR0_New = SINR0+10*log10(P0);&#x000D;&#x000A;UE1_Config_0 = 0; %MCS Index&#x000D;&#x000A;if isempty(find(SINR_Table&lt;(SINR0_New)))&#x000D;&#x000A;&#x0009;UE1_Payload_0 = MCS_Table(1);&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;UE1_Payload_0 = MCS_Table(max(find(SINR_Table&lt;SINR0_New)));&#x000D;&#x000A;end;&#x000D;&#x000A;&#x000D;&#x000A;SINR1_New = SINR1+10*log10(P1);&#x000D;&#x000A;%consider the effect of UE0 to UE1&#x000D;&#x000A;SINR1_New_Linear = 10^(SINR1_New/10);&#x000D;&#x000A;SINR1_New_Linear = 1/(P0/P1+1/P1/SINR1_New_Linear);&#x000D;&#x000A;SINR1_New  = 10*log10(SINR1_New_Linear);&#x000D;&#x000A;ImplementLoss = 0.5;%dB&#x000D;&#x000A;SINR1_New  = SINR1_New - ImplementLoss;&#x000D;&#x000A;&#x000D;&#x000A;UE1_Config_1 = 0; %MCS Index&#x000D;&#x000A;if isempty(find(SINR_Table&lt;SINR1_New))&#x000D;&#x000A;&#x0009;UE1_Payload_1 = MCS_Table(1);&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;UE1_Payload_1 = MCS_Table(max(find(SINR_Table&lt;SINR1_New)));&#x000D;&#x000A;end;&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;%useless in MCS index mode&#x000D;&#x000A;UE1_MappingType = [0];&#x000D;&#x000A;</Text>
