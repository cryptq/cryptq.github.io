<Item XName="Bandwidth" Type="PartParam">
<DataEntry>Bandwidth</DataEntry>
<Description>bandwidth</Description>
<Enum>LTE_DL_MIMO_Deprecoder__Bandwidth@LTE 8.9 Enums</Enum>
<HideCondition>(3~=UE_TransMode &amp;&amp; 5~=UE_TransMode) || 0==CL_Precoding_Enable</HideCondition>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="CDD_Mode" Type="PartParam">
<DataEntry>UEs_CDD_Mode(6)</DataEntry>
<Description>cyclic delay diversity (CDD) mode, valid when MIMO_Mode is Spatial_Mux</Description>
<Enum>LTE_DL_MIMO_LayDemapDeprecoder_CDD_Mode@LTE 8.9 Enums</Enum>
<HideCondition>1</HideCondition>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="CL_Precoding_Enable" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>whether closed-loop MIMO precoding for UE1 is enabled</Description>
<Enum>LTE_DL_MIMO_Deprecoder__CL_Precoding_Enable@LTE 8.9 Enums</Enum>
<HideCondition>3~=UE_TransMode &amp;&amp; 5~=UE_TransMode</HideCondition>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="CRS_NumAntPorts" Type="PartParam">
<DataEntry>CRS_NumAntPorts</DataEntry>
<Description>number of CRS Antenna ports</Description>
<Enum>LTE_A_DL_MIMO_Deprecoder__CRS_NumAntPorts@LTE Advanced Enums</Enum>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="CdBlk_Index" Type="PartParam">
<DataEntry>UEs_CdBlk_Index(6)</DataEntry>
<Description>codebook indexrecoding for each UE</Description>
<HideCondition>3~=UE_TransMode &amp;&amp; 5~=UE_TransMode</HideCondition>
<Validate><T>Int</T><D>11</D></Validate></Item>
<Item XName="CyclicPrefix" Type="PartParam">
<DataEntry>CyclicPrefix</DataEntry>
<Description>type of cyclic prefix</Description>
<Enum>LTE_DL_MIMO_Deprecoder__CyclicPrefix@LTE 8.9 Enums</Enum>
<HideCondition>(3~=UE_TransMode &amp;&amp; 5~=UE_TransMode) || 0==CL_Precoding_Enable</HideCondition>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="FrameMode" Type="PartParam">
<DataEntry>FrameMode</DataEntry>
<Description>frame mode</Description>
<Enum>LTE_DL_MIMO_Deprecoder__FrameMode@LTE 8.9 Enums</Enum>
<HideCondition>(3~=UE_TransMode &amp;&amp; 5~=UE_TransMode) || 0==CL_Precoding_Enable</HideCondition>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="MIMO_Decoder" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>MIMO decoder mode for spatial multiplexing</Description>
<Enum>LTE_DL_MIMO_Deprecoder__MIMO_Decoder@LTE 8.9 Enums</Enum>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="MIMO_Mode" Type="PartParam">
<DataEntry>UEs_MIMO_Mode(6)</DataEntry>
<Description>MIMO Mode, 1 for TD, 0 for SM</Description>
<Enum>LTE_DL_MIMO_LayDemapDeprecoder_MIMO_Mode@LTE 8.9 Enums</Enum>
<HideCondition>1</HideCondition>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="NumOfCWs" Type="PartParam">
<DataEntry>UEs_NumOfCWs(6)</DataEntry>
<Description>number of code words</Description>
<Validate><T>Int</T><D>11</D></Validate></Item>
<Item XName="NumOfLayers" Type="PartParam">
<DataEntry>UEs_NumOfLayers(6)</DataEntry>
<Description>number of layers</Description>
<Validate><T>Int</T><D>11</D></Validate></Item>
<Item XName="NumRxAnts" Type="PartParam">
<DataEntry>NumRxAnts</DataEntry>
<Description>number of Rx Ant</Description>
<Enum>LTE_A_DL_MIMO_Deprecoder__NumRxAnts@LTE Advanced Enums</Enum>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="PDCCH_SymsPerSF" Type="PartParam">
<DataEntry>PDCCH_SymsPerSF</DataEntry>
<Description>number of OFDM symbols of PDCCH for each subframe</Description>
<HideCondition>(3~=UE_TransMode &amp;&amp; 5~=UE_TransMode) || 0==CL_Precoding_Enable</HideCondition>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PMI_Delay" Type="PartParam">
<DataEntry>6</DataEntry>
<Description>closed-loop PMI reporting delay in units of sub-frames (1ms)</Description>
<HideCondition>(3~=UE_TransMode &amp;&amp; 5~=UE_TransMode) || 0==CL_Precoding_Enable</HideCondition>
<Validate><T>Int</T><D>11</D></Validate></Item>
<Item XName="PMI_Granularity" Type="PartParam">
<DataEntry>25</DataEntry>
<Description>closed-loop PMI reporting granularity in units of resource blocks (RBs)</Description>
<HideCondition>(3~=UE_TransMode &amp;&amp; 5~=UE_TransMode) || 0==CL_Precoding_Enable</HideCondition>
<Validate><T>Int</T><D>11</D></Validate></Item>
<Item XName="PrecodingMatrix" Type="PartParam">
<DataEntry>PrecodingMatrix{6}</DataEntry>
<Description>the user defined precoding matrix</Description>
<HideCondition>7&gt;UE_TransMode || 0==UserDefinedPrecoder</HideCondition>
<Validate><T>Int</T><D>15</D></Validate></Item>
<Item XName="RB_Alloc" Type="PartParam">
<DataEntry>UE6_RB_Alloc</DataEntry>
<Description>the RB allocation for the UE, in the formats of [start RB, number of RBs] or [[SF0 start RB, SF0 number of RBs]; . . .; [SF9 start RB, SF9 number of RBs]]</Description>
<HideCondition>(3~=UE_TransMode &amp;&amp; 5~=UE_TransMode) || 0==CL_Precoding_Enable</HideCondition>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="RB_AllocType" Type="PartParam">
<DataEntry>RB_AllocType</DataEntry>
<Description>RB allocation type</Description>
<Enum>LTE_DL_MIMO_Deprecoder__RB_AllocType@LTE 8.9 Enums</Enum>
<HideCondition>(3~=UE_TransMode &amp;&amp; 5~=UE_TransMode) || 0==CL_Precoding_Enable</HideCondition>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="SpecialSF_Config" Type="PartParam">
<DataEntry>SpecialSF_Config</DataEntry>
<Description>special subframe configuration for TDD</Description>
<Enum>LTE_DL_MIMO_Deprecoder__SpecialSF_Config@LTE 8.9 Enums</Enum>
<HideCondition>(3~=UE_TransMode &amp;&amp; 5~=UE_TransMode) || 0==CL_Precoding_Enable</HideCondition>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="SubframeIgnored" Type="PartParam">
<DataEntry>SubframeIgnored</DataEntry>
<Description>number of subframes (or transport blocks) that is ignored at the beginning due to system delay</Description>
<Validate><T>Int</T><D>11</D></Validate></Item>
<Item XName="TDD_Config" Type="PartParam">
<DataEntry>TDD_Config</DataEntry>
<Description>downlink and uplink allocations for TDD</Description>
<Enum>LTE_DL_MIMO_Deprecoder__TDD_Config@LTE 8.9 Enums</Enum>
<HideCondition>(3~=UE_TransMode &amp;&amp; 5~=UE_TransMode) || 0==CL_Precoding_Enable</HideCondition>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="UE_TransMode" Type="PartParam">
<DataEntry>UEs_TransMode(6)</DataEntry>
<Description>UE Transmission mode</Description>
<Enum>LTE_A_DL_MIMO_Precoder__UE_TransMode@LTE Advanced Enums</Enum>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="UserDefinedPrecoder" Type="PartParam">
<DataEntry>UserDefinedPrecoder(6)</DataEntry>
