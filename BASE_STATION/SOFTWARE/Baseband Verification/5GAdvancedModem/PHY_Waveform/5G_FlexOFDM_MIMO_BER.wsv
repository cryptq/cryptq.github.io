<Data><T>Double</T><D>1024</D></Data></Item>
<Item XName="Data1_Demapper" Type="Variable">
<Creator>Equations</Creator>
<Data><T>Double</T><D>1</D></Data></Item>
<Item XName="Data1_MappingType" Type="Variable">
<Creator>Equations</Creator>
<Data><T>Double</T><D>1</D></Data></Item>
<Item XName="Data1_NumOfSym" Type="Variable">
<Creator>Equations</Creator>
<Data><T>Double</T><D>8</D></Data></Item>
<Item XName="Data2_Demapper" Type="Variable">
<Creator>Equations</Creator>
<Data><T>Double</T><D>1</D></Data></Item>
<Item XName="Data2_Enable" Type="Variable">
<Creator>Equations</Creator>
<Data><T>Double</T><D>0</D></Data></Item>
