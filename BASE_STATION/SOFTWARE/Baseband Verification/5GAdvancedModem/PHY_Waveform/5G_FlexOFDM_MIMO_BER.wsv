<Item XName="Equations" Type="Equation">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>%%%%%%%%%%%%%%%%%%%%%%%%%Number of antennas%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%&#x000D;&#x000A;&#x000D;&#x000A;NumTxTable = [1,1,2,2,4,2,4,8];&#x000D;&#x000A;NumRxTable = [1,2,2,4,4,8,8,8];&#x000D;&#x000A;FadingChTable = [0,1,6,3,9,10,14];&#x000D;&#x000A;&#x000D;&#x000A;NumOfTx = NumTxTable(NumTxRx+1);&#x000D;&#x000A;NumOfRx = NumRxTable(NumTxRx+1);&#x000D;&#x000A;&#x000D;&#x000A;if((ChannelEnable == 0)&amp;(NumOfTx ~= NumOfRx))&#x000D;&#x000A;&#x0009;error(&apos;NumOfTx should be equal to NumOfRx in AWGN channel.&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;FadingCh = 1;&#x000D;&#x000A;if(ChannelEnable == 1)&#x000D;&#x000A;&#x0009;if(NumTxRx ==0)&#x000D;&#x000A;&#x0009;else&#x000D;&#x000A;&#x0009;&#x0009;FadingCh = FadingChTable(NumTxRx);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%&#x000D;&#x000A;%%%%%%%%%%%%%%%%%%% get the velocity for channel model&#x000D;&#x000A;Doppler = 5; %5Hz&#x000D;&#x000A;FCarrier = 2e3;%MHz&#x000D;&#x000A;Velocity = 3.6*3e8/(FCarrier*1e6)*Doppler;&#x000D;&#x000A;&#x000D;&#x000A;SampleDensity = 2;&#x000D;&#x000A;CIRUpdateRate = SampleDensity*2*Doppler;&#x000D;&#x000A;&#x000D;&#x000A;%%%%%%%%%%%%%%%%%%% Frame Parameter Setting&#x000D;&#x000A;DFTSize = 1024;&#x000D;&#x000A;GuardLowerSubcarriers = 212;&#x000D;&#x000A;GuardUpperSubcarriers = 211;&#x000D;&#x000A;NumOfDC_Subcarriers = 1;&#x000D;&#x000A;Data1_NumOfSym = 8;&#x000D;&#x000A;Data2_Enable = 0;&#x000D;&#x000A;Data2_NumOfSym =8;&#x000D;&#x000A;&#x000D;&#x000A;if(Data2_Enable ==1)&#x000D;&#x000A;&#x0009;DataNum =2;&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;DataNum =1;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if(Data2_Enable ==1)&#x000D;&#x000A;&#x0009;NumOfSym=Data1_NumOfSym+Data2_NumOfSym;&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;NumOfSym=Data1_NumOfSym;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;Data1_MappingType = 1;           &#x000D;&#x000A;Data2_MappingType = 1;&#x0009;&#x0009; &#x000D;&#x000A;MappingTable = [1,2,4,6,8,0,3,5,7,9,10,11,12];  %%%%%% Conversion map from FlexOFDM UI to Bits &#x000D;&#x000A;%%%%%%%%%%%%%%%%%%% get the noise density&#x000D;&#x000A;Power_dBm = 10;&#x000D;&#x000A;OFDM_SampleFreq = 15.36;%MHz&#x000D;&#x000A;SystemSampleRate = OFDM_SampleFreq * 2^OversamplingRatio*1e6;&#x000D;&#x000A;if(ChannelEnable ==1)&#x000D;&#x000A;NDensity_dBm = 10*log10(NumOfTx)+Power_dBm - SNR - 10*log10(OFDM_SampleFreq*1e6*(DFTSize-GuardLowerSubcarriers-GuardUpperSubcarriers-NumOfDC_Subcarriers)/DFTSize);&#x000D;&#x000A;else&#x000D;&#x000A;NDensity_dBm = Power_dBm - SNR - 10*log10(OFDM_SampleFreq*1e6*(DFTSize-GuardLowerSubcarriers-GuardUpperSubcarriers-NumOfDC_Subcarriers)/DFTSize);&#x000D;&#x000A;end&#x000D;&#x000A;NDensity = 10^(NDensity_dBm/10)/1000;&#x000D;&#x000A;&#x000D;&#x000A;%%%%%%%%%%%%%%%%%%% Precoding Setting&#x000D;&#x000A;PrecodingEnable = 1;&#x000D;&#x000A;NumOfSubcarriersPerBlock = 30;   %%%%%% should be set as the divisor of NumUsefulSubcarriers&#x000D;&#x000A;NumOfSymbolsPerBlock =8;&#x0009; %%%%%% should be set as the divisor of NumOfSym&#x000D;&#x000A;&#x000D;&#x000A;NumUsefulSubcarriers=DFTSize-GuardLowerSubcarriers-GuardUpperSubcarriers-NumOfDC_Subcarriers;&#x000D;&#x000A;NumOfSubbands = NumUsefulSubcarriers/NumOfSubcarriersPerBlock;%%%%%check range%%should be integer&#x000D;&#x000A;&#x000D;&#x000A;MappingFlexToMapper =[0,1,4,6,8,9,2,5,7,10,11,12,13];   %%%%%%Conversion map from model Mapper(Demapper) to Bits&#x000D;&#x000A;Data1_Demapper= MappingFlexToMapper(Data1_MappingType+1);&#x000D;&#x000A;Data2_Demapper= MappingFlexToMapper(Data2_MappingType+1);&#x000D;&#x000A;&#x000D;&#x000A;%%%%%%%%%%%%%%%%%%% Preamble1 Setting (Preamble1 is used for synchronization)&#x000D;&#x000A;Preamble_CarrierIndex=[-NumUsefulSubcarriers/2:NumUsefulSubcarriers/2];&#x000D;&#x000A;Preamble_NumOfCarriers =[NumUsefulSubcarriers+1];&#x000D;&#x000A;Preamble1_Enable = 1;&#x000D;&#x000A;Preamble1_NumOfSyms = 1;&#x000D;&#x000A;Preamble1_Seq1 = sign(randn(1,NumOfSubbands*NumOfSubcarriersPerBlock+1));&#x000D;&#x000A;Preamble1_Seq = [Preamble1_Seq1,Preamble1_Seq1];&#x000D;&#x000A;&#x000D;&#x000A;%%%%%%%%%%%%%%%%%%% Setting for Channel Estimation&#x000D;&#x000A;PilotsBasedChannelEst = 1; &#x0009;%%%%%% 0: Using preamble for channel estimation   1:Using pilots for channel estimation&#x000D;&#x000A;MIMOType=1; &#x0009;&#x0009;&#x0009;%%%%%% Preamble &amp; Pilots Setting (0:Type1 nonoverlapor 1:Type2 overlap) if(PilotsBasedChannelEst = 0), only MIMOType = 1 is supported&#x000D;&#x000A;&#x000D;&#x000A;%%%%%%%%%%%%%%%%%%%%%% Setting on pilots and data are depended on the paramenter &apos;PilotsBasedChannelEst&apos; and &apos;MIMOType&apos;. There are 3 kinds of cases.&#x000D;&#x000A;if(PilotsBasedChannelEst == 0)&#x000D;&#x000A;%%%%%%%%%%%%%%%%%%% Preamble2 for channel estimation if channel estimation is based on preamble, only Overlap type is supported.&#x000D;&#x000A;&#x0009;if( MIMOType == 0)&#x000D;&#x000A;&#x0009;&#x0009;error(&apos;MIMOType 0 is not supported when using preamble2 to do channel estimation.&apos;);&#x000D;&#x000A;&#x0009;else&#x000D;&#x000A;&#x0009;Preamble2_Enable = 1;&#x000D;&#x000A;&#x0009;Preambel2_NumOfSyms =NumOfTx;&#x000D;&#x000A;&#x0009;Preamble2_Seq1=sign(randn(1,NumOfSubbands*NumOfSubcarriersPerBlock+1));&#x000D;&#x000A;&#x0009;&#x000D;&#x000A;&#x0009;if(NumOfTx == 2)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;P_Matrix = [1,-1;1,1];&#x000D;&#x000A;&#x0009;else&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;P_Matrix = ones(NumOfTx,NumOfTx);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;for ii= 1:NumOfTx-1&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;P_Matrix(ii,ii+1) = -1;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;P_Matrix(NumOfTx,1)= -1;&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x0009;Preamble_Value_Block =zeros(NumOfTx,length(Preamble2_Seq1)*Preambel2_NumOfSyms);&#x000D;&#x000A;&#x0009;for i=1:NumOfTx&#x000D;&#x000A;&#x0009;&#x0009;for k =1:Preambel2_NumOfSyms/NumOfTx&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;for j=1:NumOfTx&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;Preamble_Value_Block(i,(k-1)*length(Preamble2_Seq1)*NumOfTx+(j-1)*length(Preamble2_Seq1)+1:(k-1)*length(Preamble2_Seq1)*NumOfTx+j*length(Preamble2_Seq1)) = P_Matrix(i,j)*Preamble2_Seq1;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;Preamble2_Values = zeros(1,Preambel2_NumOfSyms*length(Preamble2_Seq1)*NumOfTx);&#x000D;&#x000A;&#x0009;Preamble2_Values = reshape(Preamble_Value_Block.&apos;,1,Preambel2_NumOfSyms*length(Preamble2_Seq1)*NumOfTx);&#x000D;&#x000A;&#x0009;Preamble2_Seq = Preamble2_Values;&#x000D;&#x000A;&#x0009;&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;FrequencyInterval = 60;&#x0009;&#x000D;&#x000A;&#x0009;TimeInterval = 1; %%%%%% should be multiple of NumOfTx and be less than Preambel2_NumOfSyms&#x000D;&#x000A;%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%using preamble to do channel estimation and phase tracking enable&#x000D;&#x000A;&#x0009;Pilot1_CarrierIndex=[-300:3:-1,1:3:300];&#x000D;&#x000A;%&#x0009;Pilot1_CarrierIndex =[Pilot1_CarrierIndex,Pilot1_CarrierIndex];&#x000D;&#x000A;&#x0009;Pilots_Values1 = zeros(1,NumOfSym*length(Pilot1_CarrierIndex));&#x000D;&#x000A;&#x0009;for ii= 1:NumOfSym&#x000D;&#x000A;&#x0009;&#x0009;Pilots_Values1(1,(ii-1)*length(Pilot1_CarrierIndex)+1:ii*length(Pilot1_CarrierIndex)) = sign(randn(1,length(Pilot1_CarrierIndex)));&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x0009;Pilot1_Seq = [Pilots_Values1];&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;EVMRef_CarrierIndex=[-300:-1,1:300];&#x000D;&#x000A;&#x0009;%EVMRef_CarrierIndex= [EVMRef_CarrierIndex,EVMRef_CarrierIndex];&#x000D;&#x000A;&#x0009;EVMRef_NumOfCarriers=[600];&#x000D;&#x000A;&#x0009;%EVMRef_NumOfCarriers=[EVMRef_NumOfCarriers,EVMRef_NumOfCarriers];&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;Data_NumOfCarriers=[400];&#x000D;&#x000A;&#x0009;%Data_NumOfCarriers=[Data_NumOfCarriers,Data_NumOfCarriers];&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;Data_CarrierIndex= sort([-299:3:-2,-298:3:-1,2:3:300,3:3:300]);&#x000D;&#x000A;&#x0009;%Data_CarrierIndex=[Data_CarrierIndex,Data_CarrierIndex];&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;Pilot1_NumOfCarriers =[200];&#x000D;&#x000A;&#x0009;%Pilot1_NumOfCarriers = [Pilot1_NumOfCarriers,Pilot1_NumOfCarriers];&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x000D;&#x000A;%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%&#x000D;&#x000A;if(PilotsBasedChannelEst ==1)&#x000D;&#x000A;&#x0009;Preamble2_Enable = 0;&#x000D;&#x000A;&#x0009;Preambel2_NumOfSyms =NumOfTx;&#x000D;&#x000A;&#x0009;Preamble2_Seq = 0;&#x000D;&#x000A;&#x0009;if(MIMOType==0)&#x000D;&#x000A;&#x0009;&#x0009;FrequencyInterval = 50;&#x0009;%%%%%%% shoule be changed according to different setting on pilots and NumOfTx&#x000D;&#x000A;&#x0009;&#x0009;TimeInterval =8;&#x0009;&#x0009;%%%%%%% shoule be changed according to different setting on pilots and NumOfTx&#x000D;&#x000A;&#x0009;&#x0009;Pilot1_CarrierIndex=[-300:3:-1,1:3:300];&#x000D;&#x000A;&#x0009;&#x0009;Pilot1_Value_t = sign(randn(1,length(Pilot1_CarrierIndex)));&#x000D;&#x000A;&#x0009;&#x0009;Pilot1_Value_t1 = zeros(NumOfTx,length(Pilot1_CarrierIndex));&#x000D;&#x000A;&#x0009;&#x0009;for ii=1:NumOfTx&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;Pilot1_Value_t1(ii,ii:NumOfTx:end) = Pilot1_Value_t(ii:NumOfTx:end);&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;Pilots_Value_Block =zeros(NumOfTx,length(Pilot1_CarrierIndex)*NumOfSym);&#x000D;&#x000A;&#x0009;&#x0009;for i=1:NumOfTx&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;for k =1:NumOfSym&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;Pilots_Value_Block(i,(k-1)*length(Pilot1_CarrierIndex)+1:k*length(Pilot1_CarrierIndex)) = Pilot1_Value_t1(i,:);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;Pilots_Values1 = zeros(1,NumOfSym*length(Pilot1_CarrierIndex)*NumOfTx);&#x000D;&#x000A;&#x0009;&#x0009;Pilots_Values1 = reshape(Pilots_Value_Block.&apos;,1,NumOfSym*length(Pilot1_CarrierIndex)*NumOfTx);&#x000D;&#x000A;&#x0009;&#x0009;Pilot1_Seq = sqrt(2)*[Pilots_Values1];&#x000D;&#x000A;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;EVMRef_CarrierIndex=[-300:-1,1:300];&#x000D;&#x000A;%&#x0009;&#x0009;EVMRef_CarrierIndex= [EVMRef_CarrierIndex];&#x000D;&#x000A;&#x0009;&#x0009;EVMRef_NumOfCarriers=[600];&#x000D;&#x000A;%&#x0009;&#x0009;EVMRef_NumOfCarriers=[EVMRef_NumOfCarriers];&#x000D;&#x000A;%&#x000D;&#x000A;&#x0009;&#x0009;Data_NumOfCarriers=[400];&#x000D;&#x000A;%&#x0009;&#x0009;Data_NumOfCarriers=[Data_NumOfCarriers];&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;&#x0009;Data_CarrierIndex= sort([-299:3:-2,-298:3:-1,2:3:300,3:3:300]);&#x000D;&#x000A;%&#x0009;&#x0009;Data_CarrierIndex=[Data_CarrierIndex];&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;&#x0009;Pilot1_NumOfCarriers =[200];&#x000D;&#x000A;%&#x0009;&#x0009;Pilot1_NumOfCarriers = [Pilot1_NumOfCarriers];&#x000D;&#x000A;&#x0009;else&#x000D;&#x000A;&#x0009;&#x0009;FrequencyInterval = 50;&#x0009;  %%%%%%% shoule be changed according to different setting on pilots and NumOfTx&#x000D;&#x000A;&#x0009;&#x0009;TimeInterval =8;&#x0009;&#x0009;  %%%%%%% shoule be changed according to different setting on pilots and NumOfTx&#x000D;&#x000A;&#x0009;&#x0009;Pilot1_CarrierIndex=[-300:3:-1,1:3:300];&#x000D;&#x000A;&#x0009;&#x0009;Pilot1_Value_t = sign(randn(1,length(Pilot1_CarrierIndex)));&#x000D;&#x000A;&#x0009;&#x0009;if(NumOfTx == 2)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;P_Matrix = [1,-1;1,1];&#x000D;&#x000A;&#x0009;&#x0009;else&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;P_Matrix = ones(NumOfTx,NumOfTx);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;for ii= 1:NumOfTx-1&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;P_Matrix(ii,ii+1) = -1;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;P_Matrix(NumOfTx,1)= -1;&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;Pilots_Value_Block =zeros(NumOfTx,length(Pilot1_CarrierIndex)*NumOfSym);&#x000D;&#x000A;&#x0009;&#x0009;for i=1:NumOfTx&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;for k =1:NumOfSym/NumOfTx&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;for j=1:NumOfTx&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;Pilots_Value_Block(i,(k-1)*length(Pilot1_CarrierIndex)*NumOfTx+(j-1)*length(Pilot1_CarrierIndex)+1:(k-1)*length(Pilot1_CarrierIndex)*NumOfTx+j*length(Pilot1_CarrierIndex)) = P_Matrix(i,j)*Pilot1_Value_t;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;&#x000D;&#x000A;%&#x0009;&#x0009;Pilot1_CarrierIndex =[Pilot1_CarrierIndex];&#x000D;&#x000A;&#x0009;&#x0009;Pilots_Values1 = zeros(1,NumOfSym*length(Pilot1_CarrierIndex)*NumOfTx);&#x000D;&#x000A;&#x0009;&#x0009;Pilots_Values1 = reshape(Pilots_Value_Block.&apos;,1,NumOfSym*length(Pilot1_CarrierIndex)*NumOfTx);&#x000D;&#x000A;&#x0009;&#x0009;Pilot1_Seq = [Pilots_Values1];&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;&#x0009;EVMRef_CarrierIndex=[-300:-1,1:300];&#x000D;&#x000A;%&#x0009;&#x0009;EVMRef_CarrierIndex= [EVMRef_CarrierIndex];&#x000D;&#x000A;&#x0009;&#x0009;EVMRef_NumOfCarriers=[600];&#x000D;&#x000A;%&#x0009;&#x0009;EVMRef_NumOfCarriers=[EVMRef_NumOfCarriers];&#x000D;&#x000A;%&#x000D;&#x000A;&#x0009;&#x0009;Data_NumOfCarriers=[400];&#x000D;&#x000A;%&#x0009;&#x0009;Data_NumOfCarriers=[Data_NumOfCarriers];&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;&#x0009;Data_CarrierIndex= sort([-299:3:-2,-298:3:-1,2:3:300,3:3:300]);&#x000D;&#x000A;%&#x0009;&#x0009;Data_CarrierIndex=[Data_CarrierIndex];&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;&#x0009;Pilot1_NumOfCarriers =[200];&#x000D;&#x000A;%&#x0009;&#x0009;Pilot1_NumOfCarriers = [Pilot1_NumOfCarriers];&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%&#x000D;&#x000A;CodeLengthTable = [1944,1296,648];&#x000D;&#x000A;CodeRateTable = [1/2,2/3,3/4,5/6];&#x000D;&#x000A;CodeLength_L = CodeLengthTable(CodeLength+1);&#x000D;&#x000A;CodeRate_L = CodeRateTable(CodeRate+1);&#x000D;&#x000A;CodeBlockSize = CodeLength_L*CodeRate_L;&#x000D;&#x000A;NumBitsPerFrame_D1 = MappingTable(Data1_MappingType+1)*sum(Data_NumOfCarriers)/length(Data_NumOfCarriers)*Data1_NumOfSym;&#x000D;&#x000A;NumBitsPerFrame_D2 = MappingTable(Data2_MappingType+1)*sum(Data_NumOfCarriers)/length(Data_NumOfCarriers)*Data2_NumOfSym;&#x000D;&#x000A;&#x000D;&#x000A;NumBlocks_D1 = floor(NumBitsPerFrame_D1/CodeLength_L);&#x000D;&#x000A;NumBlocks_D2 = floor(NumBitsPerFrame_D2/CodeLength_L);&#x000D;&#x000A;&#x000D;&#x000A;NumUsefulBits_D1 = NumOfTx*floor(NumBlocks_D1*CodeLength_L*CodeRate_L);&#x000D;&#x000A;NumUsefulBits_D2 = NumOfTx*floor(NumBlocks_D2*CodeLength_L*CodeRate_L);&#x000D;&#x000A;&#x000D;&#x000A;NumUsefulBits_D1_Uncoded = NumOfTx*NumBitsPerFrame_D1;&#x000D;&#x000A;NumUsefulBits_D2_Uncoded = NumOfTx*NumBitsPerFrame_D2;&#x000D;&#x000A;%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%&#x000D;&#x000A;%%%%%%%%%%%%%%%%%%%%%%%   Interleave&#x000D;&#x000A;InterleaveRow_D1 = 128;&#x000D;&#x000A;InterleaveCol_D1 = 500;&#x000D;&#x000A;&#x000D;&#x000A;InterleaveRow_D2 = 128;&#x000D;&#x000A;InterleaveCol_D2 = 500;&#x000D;&#x000A;&#x000D;&#x000A;if(InterleaveEnable==1)&#x000D;&#x000A;&#x0009;InterDelay_D1=(InterleaveRow_D1*InterleaveCol_D1/NumBitsPerFrame_D1)/NumOfTx;&#x000D;&#x000A;&#x0009;InterDelay_D2=(InterleaveRow_D2*InterleaveCol_D2/NumBitsPerFrame_D2)/NumOfTx;&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;InterDelay_D1 = 1;&#x000D;&#x000A;&#x0009;InterDelay_D2 = 1;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if((mod(InterleaveRow_D1*InterleaveCol_D1,NumBitsPerFrame_D1)~=0)&amp;(InterleaveEnable ==1))&#x000D;&#x000A;error(&apos;InterleaveRow_D1*InterleaveCol_D1 should be the multiple of NumBitsPerFrame_D1!&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if((Data2_Enable==1)&amp;(InterleaveEnable ==1))&#x000D;&#x000A;&#x0009;if(mod(InterleaveRow_D2*InterleaveCol_D2,NumBitsPerFrame_D2)~=0)&#x000D;&#x000A;&#x0009;error(&apos;InterleaveRow_D2*InterleaveCol_D2 should be the multiple of NumBitsPerFrame_D2!&apos;);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;</Text>
<UnitUse><T>Int</T><D>2</D></UnitUse>
