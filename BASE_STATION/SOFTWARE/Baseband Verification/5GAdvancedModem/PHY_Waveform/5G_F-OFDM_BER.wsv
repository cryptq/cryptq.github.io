<Item XName="Equations" Type="Equation">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>                                                                                 &#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;%%F-OFDM parameters:&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;%UE2 Parameters&#x000D;&#x000A;UE2_NumSubcarriers = 1024;&#x000D;&#x000A;UE2_SubcarrierSpacing = BaseSampleRate/UE2_NumSubcarriers;&#x000D;&#x000A;UE2_NumSubcarriersPerSubband = 24;&#x000D;&#x000A;UE2_SubbandStartLocation = 1;&#x000D;&#x000A;&#x000D;&#x000A;%UE1 parameters&#x000D;&#x000A;UE1_SubcarrierSpacing = BaseSampleRate/NumSubcarriers;&#x000D;&#x000A;&#x000D;&#x000A;%Common parameters&#x000D;&#x000A;OversampleOption = OversampleRatio;&#x000D;&#x000A;SampleRate = BaseSampleRate*2^OversampleRatio;&#x000D;&#x000A;&#x000D;&#x000A;%Filter parameters&#x000D;&#x000A;FilterLength = 513;&#x000D;&#x000A;Wn = NumSubcarriersPerSubband/(NumSubcarriers*2^OversampleOption);&#x000D;&#x000A;FilterCoef = fir1(FilterLength-1,Wn*1.15);&#x000D;&#x000A;&#x000D;&#x000A;%MappingTable&#x000D;&#x000A;BitsPerSymTable = [1,2,3,4,4,5,6,7,8,2,9,10,11,12,4,5,4,5,2];&#x000D;&#x000A;BitsPerSym = BitsPerSymTable(ModType+1);&#x000D;&#x000A;&#x000D;&#x000A;%Pilot parameters&#x000D;&#x000A;PilotsLocation = [0:3:47];&#x000D;&#x000A;PilotSeq = sign(randn(1,length(PilotsLocation)));&#x000D;&#x000A;&#x000D;&#x000A;SymsPerFOFDMSymbol = (NumSubcarriersPerSubband-length(PilotsLocation));&#x000D;&#x000A;&#x000D;&#x000A;NumSymsChannelEst =2;&#x000D;&#x000A;&#x000D;&#x000A;% get the noise density&#x000D;&#x000A;Bandwidth_Hz = NumSubcarriersPerSubband*BaseSampleRate/NumSubcarriers;;&#x000D;&#x000A;SignalPower_dBm = 10 * log10(SignalPower*1000);&#x000D;&#x000A;NDensity_dBm = SignalPower_dBm - SNR - 10*log10(Bandwidth_Hz);&#x000D;&#x000A;NDensity = 10^(NDensity_dBm/10)/1000;</Text>
