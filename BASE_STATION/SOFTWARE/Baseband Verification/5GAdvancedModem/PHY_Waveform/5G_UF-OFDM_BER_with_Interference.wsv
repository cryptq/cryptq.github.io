<Item XName="Equations" Type="Equation">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>% get the noise density&#x000D;&#x000A;Bandwidth_Hz = NumSubcarriersPerSubband*NumSubbands*BaseSampleRate/NumSubcarriers;;&#x000D;&#x000A;SignalPower_dBm = 10 * log10(SignalPower*1000);&#x000D;&#x000A;NDensity_dBm = SignalPower_dBm - SNR - 10*log10(Bandwidth_Hz);&#x000D;&#x000A;NDensity = 10^(NDensity_dBm/10)/1000;&#x000D;&#x000A;&#x000D;&#x000A;%%%UF-OFDM-like filter&#x000D;&#x000A;BaseFilterLength = 16;&#x000D;&#x000A;%%FilterCoef =[0.1138,0.1964,0.3319,0.4926,0.6613,0.8163,0.9353,1.0000,1.0000,0.9353,0.8163,0.6613,0.4926,0.3319,0.1964,0.1138];%chebwin(16,40);&#x000D;&#x000A;FilterCoef =[0.0014,0.0114,0.0498,0.1472,0.3278,0.5791,0.8355,1.0000,1.0000,0.8355,0.5791,0.3278,0.1472,0.0498,0.0114,0.0014];%chebwin(16,120);&#x000D;&#x000A;&#x000D;&#x000A;%%OFDM-like filter&#x000D;&#x000A;%BaseFilterLength = 1;&#x000D;&#x000A;%FilterCoef = [1];&#x000D;&#x000A;&#x000D;&#x000A;%Generate filter coef with OversampleOption&#x000D;&#x000A;FilterLength = BaseFilterLength*2^OversampleOption;&#x000D;&#x000A;if (OversampleOption == 0)&#x000D;&#x000A;&#x0009;FilterCoef = FilterCoef;&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;f = fft(FilterCoef);&#x000D;&#x000A;&#x0009;ff = [f(1,1:end/2), zeros(1,FilterLength-BaseFilterLength), f(end/2+1:end)];&#x000D;&#x000A;&#x0009;FilterCoef = ifft(ff);&#x000D;&#x000A;end;&#x000D;&#x000A;&#x000D;&#x000A;SampleRate = BaseSampleRate*2^OversampleOption;&#x000D;&#x000A;&#x000D;&#x000A;%Data symbols per UF-OFDM symbol&#x000D;&#x000A;SymsPerUFOFDMSymbol = (NumSubcarriersPerSubband-length(PilotsLocation))*NumSubbands;&#x000D;&#x000A;&#x000D;&#x000A;%MappingTable&#x000D;&#x000A;BitsPerSymTable = [1,2,3,4,4,5,6,7,8,2,9,10,11,12,4,5,4,5,2];&#x000D;&#x000A;BitsPerSym = BitsPerSymTable(ModType+1);&#x000D;&#x000A;&#x000D;&#x000A;%%%%%%%%%%%%%%%%%%%Timing and frequency offset&#x000D;&#x000A;foffset = FreqOffset*BaseSampleRate/NumSubcarriers;&#x000D;&#x000A;toffset = NumSubcarriers/BaseSampleRate*TimingOffset;&#x000D;&#x000A;&#x000D;&#x000A;if EnableInterferenceUser == 1&#x000D;&#x000A;&#x0009;InterferenceUserGain = 1;&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;InterferenceUserGain = 0;&#x000D;&#x000A;end;</Text>
