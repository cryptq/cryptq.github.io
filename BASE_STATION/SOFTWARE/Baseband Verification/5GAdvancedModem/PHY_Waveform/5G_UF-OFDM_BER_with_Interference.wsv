<Creator>Equations</Creator>
<Data><T>Array_Dbl64</T><D>2;16;1;7hBkDQ0yMz3;KlIPP8EM7{3;MrdhsAsVf{3;815}OCtr2}3;2v3wPpg{K}3;RAw8vo}XY}3;ZiT{{f6lg}3;m}3;m}3;ZiT{{f6lg}3;RAw8vo}XY}3;2v3wPpg{K}3;815}OCtr2}3;MrdhsAsVf{3;KlIPP8EM7{3;7hBkDQ0yMz3</D></Data></Item>
