<Param>Design1\UF-OFDM BER with Interference\Parameters\ParamSet\SNR</Param></Item>
<Item XName="Tune1" Type="TuneParam">
<Param>Design1\UF-OFDM BER with Interference\Parameters\ParamSet\FreqOffset</Param></Item>
