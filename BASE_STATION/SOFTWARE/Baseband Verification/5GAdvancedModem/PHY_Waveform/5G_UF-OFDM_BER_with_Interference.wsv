<Creator>Equations</Creator>
<Data><T>Array_Dbl64</T><D>2;19;1;m}3;4;804;G04;G04;K04;O04;R04;W04;4;Y04;a04;c04;e04;G04;K04;G04;K04;4</D></Data></Item>
