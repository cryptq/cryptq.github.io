&#x000D;&#x000A;&#x0009;&#x0009;Horig = H_2_3_1944;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;elseif K==N*3/4&#x000D;&#x000A;&#x0009;&#x0009;Horig = H_3_4_1944;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;elseif K==N*5/6&#x000D;&#x000A;&#x0009;&#x0009;Horig = H_5_6_1944;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;else&#x000D;&#x000A;&#x0009;&#x0009;error(&apos;invalid code rate&apos;);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;elseif N==1296&#x000D;&#x000A;&#x0009;Z = 54;&#x000D;&#x000A;&#x0009;if K==N*1/2&#x000D;&#x000A;&#x0009;&#x0009;Horig = H_1_2_1296;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;elseif K==N*2/3&#x000D;&#x000A;&#x0009;&#x0009;Horig = H_2_3_1296;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;elseif K==N*3/4&#x000D;&#x000A;&#x0009;&#x0009;Horig = H_3_4_1296;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;elseif K==N*5/6&#x000D;&#x000A;&#x0009;&#x0009;Horig = H_5_6_1296;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;else&#x000D;&#x000A;&#x0009;&#x0009;error(&apos;invalid code rate&apos;);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;elseif N==648&#x000D;&#x000A;&#x0009;Z = 27;&#x000D;&#x000A;&#x0009;if K==N*1/2&#x000D;&#x000A;&#x0009;&#x0009;Horig = H_1_2_648;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;elseif K==N*2/3&#x000D;&#x000A;&#x0009;&#x0009;Horig = H_2_3_648;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;elseif K==N*3/4&#x000D;&#x000A;&#x0009;&#x0009;Horig = H_3_4_648;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;elseif K==N*5/6&#x000D;&#x000A;&#x0009;&#x0009;Horig = H_5_6_648;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;else&#x000D;&#x000A;&#x0009;&#x0009;error(&apos;invalid code rate&apos;);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;error(&apos;invalid code length&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;P = N - K;&#x000D;&#x000A;&#x000D;&#x000A;H = -1 * ones(Z*numel(find(Horig~=-1)),1);&#x000D;&#x000A;H_RowWeight = zeros(P, 1);&#x000D;&#x000A;&#x000D;&#x000A;Hidx = 1;&#x000D;&#x000A;for ii=1:P/Z&#x000D;&#x000A;&#x0009;for row=1:Z&#x000D;&#x000A;&#x0009;&#x0009;weight = 0;&#x000D;&#x000A;&#x0009;&#x0009;for jj=1:24&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;if Horig(ii,jj)~=-1&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;H(Hidx) = (jj-1)*Z + mod(Horig(ii,jj)+row-1,Z);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;Hidx = Hidx+1;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;weight = weight + 1;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;H_RowWeight((ii-1)*Z+row) = weight;&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end</Text>
