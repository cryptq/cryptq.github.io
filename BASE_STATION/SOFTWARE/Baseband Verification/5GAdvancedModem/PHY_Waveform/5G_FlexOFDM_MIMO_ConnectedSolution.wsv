<Item XName="S3" Type="Part">
<Category>Instrumentation</Category>
<Description>M8190 Signal downloader supporting DUC (Digital Upconversion). Instrument must have DUC option installed.</Description>
<DisabledNetlist />
<Footprint />
<MathLang><T>Bool</T><D>1</D></MathLang>
<Model>SignalDownloader_M8190Env@Instruments Subnetwork Models</Model>
<ModelID />
<Netlist>Ch1,RF(1)?Connect1|Ch2,RF(2)?Connect2</Netlist>
<ParentPartName>SignalDownloader@Algorithm Design</ParentPartName>
<SectionNum><T>Int</T><D>0</D></SectionNum>
<ShortSymbol />
<ShowModel><T>Bool</T><D>0</D></ShowModel>
<SimOverride><T>Int</T><D>0</D></SimOverride>
<Symbol>AutoSymDF{SignalDownloader}</Symbol>
<Item XName="ModelsParamSet" Type="ModelsParamSet">
<Item XName="ModelSet_0" Type="ModelListEntry">
<Indentifier />
<ModelName>SignalDownloader_M8195_1CH@Instruments Subnetwork Models</ModelName></Item>
<Item XName="ModelSet_1" Type="ModelListEntry">
<Indentifier />
