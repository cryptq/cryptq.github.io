<Item XName="Equations" Type="Equation">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>MaxNumOfTxRFChains = 16;&#x000D;&#x000A;EnableSignal = zeros(MaxNumOfTxRFChains,1);&#x000D;&#x000A;&#x000D;&#x000A;if (Ntrf &lt; 1) || (Ntrf &gt; MaxNumOfTxRFChains)&#x000D;&#x000A;&#x0009;error(&apos;The range of Ntrf should be [1,16].&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if Ntrf == MaxNumOfTxRFChains&#x000D;&#x000A;&#x0009;EnableSignal = zeros(MaxNumOfTxRFChains,1);&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;EnableSignal = [zeros(Ntrf,1);ones(MaxNumOfTxRFChains-Ntrf,1)];&#x000D;&#x000A;end</Text>
