<Data><T>Array_Dbl64</T><D>2;400;1;io1C;eo1C;Wo1C;Ro1C;Ko1C;Go1C;8o1C;4o1C;yn1C;un1C;mn1C;in1C;an1C;Wn1C;On1C;Kn1C;Cn1C;8n1C;n1C;ym1C;qm1C;mm1C;em1C;am1C;Rm1C;Om1C;Gm1C;Cm1C;4m1C;m1C;ml1C;el1C;Ol1C;Gl1C;l1C;uk1C;ek1C;Wk1C;Gk1C;8k1C;uj1C;mj1C;Wj1C;Oj1C;8j1C;j1C;mi1C;ei1C;Oi1C;Gi1C;i1C;uh1C;eh1C;Wh1C;Gh1C;8h1C;ug1C;mg1C;Wg1C;Og1C;8g1C;g1C;mf1C;ef1C;Of1C;Gf1C;f1C;ue1C;ee1C;We1C;Ge1C;8e1C;ud1C;md1C;Wd1C;Od1C;8d1C;d1C;mc1C;ec1C;Oc1C;Gc1C;c1C;ub1C;eb1C;Wb1C;Gb1C;8b1C;ua1C;ma1C;Wa1C;Oa1C;8a1C;a1C;mZ1C;eZ1C;OZ1C;GZ1C;Z1C;uY1C;eY1C;WY1C;GY1C;8Y1C;uX1C;mX1C;WX1C;OX1C;8X1C;X1C;mW1C;eW1C;OW1C;GW1C;W1C;mV1C;GV1C;V1C;WU1C;GU1C;mT1C;WT1C;T1C;mR1C;GR1C;R1C;WS1C;GS1C;mQ1C;WQ1C;Q1C;mP1C;GP1C;P1C;WO1C;GO1C;mN1C;WN1C;N1C;mM1C;GM1C;M1C;WL1C;GL1C;mK1C;WK1C;K1C;mJ1C;GJ1C;J1C;WI1C;GI1C;mH1C;WH1C;H1C;mG1C;GG1C;G1C;F1C;WE1C;WD1C;D1C;C1C;WB1C;WA1C;A1C;91C;W81C;W71C;71C;61C;W51C;W41C;41C;31C;W21C;W11C;11C;1C;}0C;z0C;y0C;w0C;v0C;t0C;s0C;q0C;p0C;n0C;m0C;i0C;g0C;c0C;a0C;W0C;R0C;K0C;G0C;C;m}B;4;804;K04;O04;W04;Y04;c04;e04;i04;k04;n04;o04;q04;r04;t04;u04;w04;x04;z04;{04;14;W014;W114;214;314;W314;W414;514;614;W614;W714;814;914;W914;WA14;B14;C14;WC14;WD14;E14;F14;WF14;GG14;WG14;H14;GH14;mH14;I14;WI14;mI14;GJ14;WJ14;K14;GK14;mK14;L14;WL14;mL14;GM14;WM14;N14;GN14;mN14;O14;WO14;mO14;GP14;WP14;Q14;GQ14;mQ14;S14;WS14;mS14;GR14;WR14;T14;GT14;mT14;U14;WU14;mU14;GV14;WV14;W14;8W14;OW14;WW14;mW14;uW14;8X14;GX14;WX14;eX14;uX14;Y14;GY14;OY14;eY14;mY14;Z14;8Z14;OZ14;WZ14;mZ14;uZ14;8a14;Ga14;Wa14;ea14;ua14;b14;Gb14;Ob14;eb14;mb14;c14;8c14;Oc14;Wc14;mc14;uc14;8d14;Gd14;Wd14;ed14;ud14;e14;Ge14;Oe14;ee14;me14;f14;8f14;Of14;Wf14;mf14;uf14;8g14;Gg14;Wg14;eg14;ug14;h14;Gh14;Oh14;eh14;mh14;i14;8i14;Oi14;Wi14;mi14;ui14;8j14;Gj14;Wj14;ej14;uj14;k14;Gk14;Ok14;ek14;mk14;l14;8l14;Ol14;Wl14;ml14;ul14;4m14;8m14;Gm14;Km14;Rm14;Wm14;em14;im14;qm14;um14;n14;4n14;Cn14;Gn14;On14;Rn14;an14;en14;mn14;qn14;yn14;o14;8o14;Co14;Ko14;Oo14;Wo14;ao14;io14;mo14</D></Data></Item>
