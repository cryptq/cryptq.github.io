<Item XName="MXG_MIMO_Download" UserName="MXG_MIMO_Download" Type="Equation">
<AutoCalc><T>Bool</T><D>0</D></AutoCalc>
<Selected><T>Bool</T><D>0</D></Selected>
<Text>% HW_Available, IP_Master and IP_Slave &#x000D;&#x000A;% are defined in &quot;Globals&quot; Equation page.&#x000D;&#x000A;HWAvailable = 1;&#x000D;&#x000A;IP_Master = &apos;10.116.93.216&apos;;&#x000D;&#x000A;IP_Slave = &apos;10.116.92.246&apos;;&#x000D;&#x000A;IP_Slaves = &apos;10.116.92.246&apos;;&#x000D;&#x000A;&#x000D;&#x000A;% Generate and download waveforms&#x000D;&#x000A;runanalysis(&apos;Design1 Analysis&apos;);&#x000D;&#x000A;&#x000D;&#x000A;if HWAvailable == 1&#x000D;&#x000A;&#x0009;% Open communication port &#x000D;&#x000A;&#x0009;master = tcpip(IP_Master, 5025);&#x000D;&#x000A;&#x0009;slave = tcpip(IP_Slave, 5025);&#x000D;&#x000A;&#x0009;fopen(master);&#x000D;&#x000A;&#x0009;fopen(slave);&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;% Turn ON RF and Modulation&#x000D;&#x000A;&#x0009;SigGenE4438C_PowerOnOff(master, &apos;ON&apos;);&#x000D;&#x000A;&#x0009;Instr_OPC(master);&#x000D;&#x000A;&#x0009;SigGenE4438C_ModOnOff(master, &apos;ON&apos;);&#x000D;&#x000A;&#x0009;Instr_OPC(master);&#x000D;&#x000A;&#x0009;SigGenE4438C_PowerOnOff(slave, &apos;ON&apos;);&#x000D;&#x000A;&#x0009;Instr_OPC(slave);&#x000D;&#x000A;&#x0009;SigGenE4438C_ModOnOff(slave, &apos;ON&apos;);&#x000D;&#x000A;&#x0009;Instr_OPC(slave);&#x000D;&#x000A;&#x0009;fclose(slave);&#x000D;&#x000A;&#x0009;&#x000D;&#x000A;&#x0009;% Generate trigger pulse to synchronize&#x000D;&#x000A;&#x0009;% playback of waveforms in &#x000D;&#x000A;&#x0009;% both master and slave signal generators.&#x000D;&#x000A;&#x0009;fprintf(master, &apos;*TRG&apos;);&#x000D;&#x000A;&#x0009;fclose(master);&#x000D;&#x000A;&#x0009;&#x000D;&#x000A;&#x0009;clear master slave;&#x000D;&#x000A;end</Text>
<UnitUse><T>Int</T><D>2</D></UnitUse>
