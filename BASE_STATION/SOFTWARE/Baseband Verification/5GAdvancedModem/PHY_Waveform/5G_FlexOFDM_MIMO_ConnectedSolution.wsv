<Text>%please remember to active the avaliable dataset&#x000D;&#x000A;%using(&apos;Design1 Analysis_Design1_Data&apos;);&#x000D;&#x000A;using(&apos;Design1 Analysis2_FlexOFDM_MIMO_2x8_BER_Data&apos;);&#x000D;&#x000A;&#x000D;&#x000A;idxx = 1;&#x000D;&#x000A;&#x000D;&#x000A;%Tx&#x000D;&#x000A;f0 = graph_figure(&apos;TxSig Beam 1&apos;);&#x000D;&#x000A;f0.clear_data();&#x000D;&#x000A;f0.add_spherical_data(squeeze(PlotControl__PhiGrid(idxx,:,:)),squeeze(PlotControl__ThetaGrid(idxx,:,:)),squeeze(PlotControl__PowGrid(idxx,:,:)));&#x000D;&#x000A;&#x000D;&#x000A;%if exist(&apos;PlotControl__PhiGrid1&apos;)&#x000D;&#x000A;%&#x0009;f1 = graph_figure(&apos;TxSig Beam 2&apos;);&#x000D;&#x000A;%&#x0009;f1.clear_data();&#x000D;&#x000A;%&#x0009;f1.add_spherical_data(squeeze(PlotControl__PhiGrid1(idxx,:,:)),squeeze(PlotControl__ThetaGrid1(idxx,:,:)),squeeze(PlotControl__PowGrid1(idxx,:,:)));&#x000D;&#x000A;%end&#x000D;&#x000A;&#x000D;&#x000A;%Rx&#x000D;&#x000A;f00 = graph_figure(&apos;RxSig Beam 1&apos;);&#x000D;&#x000A;f00.clear_data();&#x000D;&#x000A;f00.add_spherical_data(squeeze(PlotControl__PhiGrid4(idxx,:,:)),squeeze(PlotControl__ThetaGrid4(idxx,:,:)),squeeze(PlotControl__PowGrid4(idxx,:,:)));&#x000D;&#x000A;%&#x000D;&#x000A;%if exist(&apos;PlotControl__PhiGrid5&apos;);&#x000D;&#x000A;%&#x0009;f11 = graph_figure(&apos;RxSig Beam 2&apos;);&#x000D;&#x000A;%&#x0009;f11.clear_data();&#x000D;&#x000A;%&#x0009;f11.add_spherical_data(squeeze(PlotControl__PhiGrid5(idxx,:,:)),squeeze(PlotControl__ThetaGrid5(idxx,:,:)),squeeze(PlotControl__PowGrid5(idxx,:,:)));&#x000D;&#x000A;%end</Text>
