<Item XName="Equations" Type="Equation">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>MaxNumOfRxRFChains = 16;&#x000D;&#x000A;EnableSignal = zeros(MaxNumOfRxRFChains,1);&#x000D;&#x000A;&#x000D;&#x000A;if (Nrrf &lt; 1) || (Nrrf &gt; MaxNumOfRxRFChains)&#x000D;&#x000A;&#x0009;error(&apos;The range of Nrrf should be [1,16].&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if Nrrf == MaxNumOfRxRFChains&#x000D;&#x000A;&#x0009;EnableSignal = zeros(MaxNumOfRxRFChains,1);&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;EnableSignal = [zeros(Nrrf,1);ones(MaxNumOfRxRFChains-Nrrf,1)];&#x000D;&#x000A;end</Text>
