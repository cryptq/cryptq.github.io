<Item XName="ADCBitWidth" Type="PartParam">
<DataEntry>1</DataEntry>
<Description>ADC bit width must be 14bit when DUC interpolation mode selected.</Description>
<Enum>M8190_DAC_BITWIDTH@Eagleware</Enum>
<Validate><T>Int</T><D>16</D></Validate></Item>
