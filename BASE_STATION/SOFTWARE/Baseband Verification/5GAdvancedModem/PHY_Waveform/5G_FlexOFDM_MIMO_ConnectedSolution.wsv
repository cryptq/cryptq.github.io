<DataEntry>1.5</DataEntry>
<Description>Amplitude in V (Range: 0.1 to 2 V)</Description>
<HideCondition>(OutputRoute == 0) || (OutputRoute == 2)</HideCondition>
<Unit><T>Int</T><D>41769</D></Unit>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="AmplitudeOutputDAC" Type="PartParam">
<DataEntry>500</DataEntry>
<Description>Amplitude in V (Range: 0.35 to 0.7V)</Description>
<HideCondition>(OutputRoute == 0) || (OutputRoute == 1)</HideCondition>
<Unit><T>Int</T><D>9003</D></Unit>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="AmplitudeOutputDC" Type="PartParam">
<DataEntry>0.5</DataEntry>
<Description>Amplitude in V (Range: 0.15 to 1 V)</Description>
<HideCondition>(OutputRoute == 1) || (OutputRoute == 2)</HideCondition>
<Unit><T>Int</T><D>9001</D></Unit>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="AmplitudeScaling" Type="PartParam">
<DataEntry>1</DataEntry>
<Description>Carrier Amplitude Scaling [Range: 0 to 2.83]</Description>
<HideCondition>(ShowAdvancedParams == 0)</HideCondition>
