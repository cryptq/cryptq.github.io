<Item XName="Equations" Type="Equation">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>&#x000D;&#x000A;if(Data2_Enable ==1)&#x000D;&#x000A;&#x0009;DataNum =2;&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;DataNum =1;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;MappingTable = [0,1,4,6,8,9,2,5,7,10,11,12,13];&#x000D;&#x000A;&#x000D;&#x000A;D1_MappingType = MappingTable(Data1_MappingType+1);&#x000D;&#x000A;D2_MappingType = MappingTable(Data2_MappingType+1);&#x000D;&#x000A;&#x000D;&#x000A;MappingTable = [1,2,4,6,8,0,3,5,7,9,10,11,12];&#x000D;&#x000A;NumBitsPerFrame_D1 = NumOfTx*MappingTable(Data1_MappingType+1)*sum(Data_NumOfCarriers)*Data1_NumOfSym/length(Data_NumOfCarriers);&#x000D;&#x000A;NumBitsPerFrame_D2 = NumOfTx*MappingTable(Data2_MappingType+1)*sum(Data_NumOfCarriers)*Data2_NumOfSym/length(Data_NumOfCarriers);&#x000D;&#x000A;&#x000D;&#x000A;NumSymsPerFrame_D1 = NumOfTx*sum(Data_NumOfCarriers)*Data1_NumOfSym/length(Data_NumOfCarriers);&#x000D;&#x000A;NumSymsPerFrame_D2 = NumOfTx*sum(Data_NumOfCarriers)*Data2_NumOfSym/length(Data_NumOfCarriers);</Text>
