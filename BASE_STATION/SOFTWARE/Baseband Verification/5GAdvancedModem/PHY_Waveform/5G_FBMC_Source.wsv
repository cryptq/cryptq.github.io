<Item XName="Equations" Type="Equation">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>%%%%%%%%%%%%%%%%%range check%%%%%%%%%%%%%%%%%%%%%%%%%%&#x000D;&#x000A;if(SampleRate&lt;=0)&#x000D;&#x000A;error(&apos;SampleRate should be greater than 0!&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if(IdleInterval&lt;0)&#x000D;&#x000A;error(&apos;IdleInterval should be no less than 0!&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if NumPreambleSyms &lt;0&#x000D;&#x000A;error(&apos;NumPreambleSyms should be no less than 0!&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if NumPreambleSyms &lt; (FilterOverlapFactor+2)&#x000D;&#x000A;error(&apos;NumPreambleSyms should be no less than FilterOverlapFactor+2!&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if NumDataSyms &lt;0&#x000D;&#x000A;error(&apos;NumDataSyms should be no less than 0!&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if NumSubcarriers &lt;0&#x000D;&#x000A;error(&apos;NumSubcarriers should be no less than 0!&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;%if(mod(length(ActiveSubcAlloc),2)==1)&#x000D;&#x000A;%error(&apos;The elements in ActiveSubcAlloc should be multiple of 2 as it defines multiple ranges for active subcarriers with the format of [StartIndex, StopIndex]!&apos;);&#x000D;&#x000A;%end&#x000D;&#x000A;&#x000D;&#x000A;for i = 1:length(ActiveSubcAlloc(:,1))&#x000D;&#x000A;&#x0009;if((ActiveSubcAlloc(i,1)&lt;(-NumSubcarriers/2))|(ActiveSubcAlloc(i,1)&gt;(NumSubcarriers/2-1))|(ActiveSubcAlloc(i,2)&lt;(-NumSubcarriers/2))|(ActiveSubcAlloc(i,2)&gt;(NumSubcarriers/2-1)))&#x000D;&#x000A;&#x0009;error(&apos;The elements in ActiveSubcAlloc should be in the range [-NumSubcarriers/2, NumSubcarriers/2)!&apos;);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;table = zeros(1,NumSubcarriers);&#x000D;&#x000A;for i = 1: length(ActiveSubcAlloc(:,1))&#x000D;&#x000A;&#x0009;for n = 1:ActiveSubcAlloc(i,2)-ActiveSubcAlloc(i,1)+1&#x000D;&#x000A;&#x0009;&#x0009;table(ActiveSubcAlloc(i,1)+n+NumSubcarriers/2) = table(ActiveSubcAlloc(i,1)+n+NumSubcarriers/2)+1;&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;for i = 1:NumSubcarriers&#x000D;&#x000A;&#x0009;if(table(i)&gt;1)&#x000D;&#x000A;&#x0009;&#x0009;error([&apos;The subcarrier with the index &apos; num2str(i-NumSubcarriers/2-1) &apos; has be set to be active by at least twice!&apos;]);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;for i = 1: length(PilotIndex)&#x000D;&#x000A;&#x0009;if ((PilotIndex(i)&lt;(-NumSubcarriers/2))|(PilotIndex(i)&gt;(NumSubcarriers/2-1)))&#x000D;&#x000A;&#x0009;error(&apos;The elements in PilotIndex should be in the range [-NumSubcarriers/2, NumSubcarriers/2)!&apos;);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if(length(PilotSequence)~=length(PilotIndex))&#x000D;&#x000A;error(&apos;The number of PilotIndex should be equal to the number of data in PilotSquence!&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if(FilterOverlapFactor &lt; 1)&#x000D;&#x000A;error(&apos;FilterOverlapFactor should be no less than 1!&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if(length(FilterCoef)~= FilterOverlapFactor)&#x000D;&#x000A;error(&apos;The number of FilterCoef should be equal to FilterOverlapFactor!&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if(ZC_RootIndex1==ZC_RootIndex2)&#x000D;&#x000A;error(&apos;ZC_RootIndex1 should not be equal to ZC_RootIndex2!&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if(ZC_RootIndex1&lt;0)&#x000D;&#x000A;error(&apos;ZC_RootIndex1 should be greater than 0!&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if(ZC_RootIndex2&lt;0)&#x000D;&#x000A;error(&apos;ZC_RootIndex2 should be greater than 0!&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;if((PilotEnable ==0)&amp;(PhaseTrackingEnable==1))&#x000D;&#x000A;error(&apos;PhaseTracking could be enable when pilot is enable!&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;OFDMMuxOversampleRatio = OversampleRatio;&#x000D;&#x000A;NumActiveSubc =0;&#x000D;&#x000A;for i = 1:length(ActiveSubcAlloc(:,1))&#x000D;&#x000A;&#x0009;NumActiveSubc = NumActiveSubc+ActiveSubcAlloc(i,2)-ActiveSubcAlloc(i,1)+1;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;ActiveSubcIndex = zeros(1,NumActiveSubc);&#x000D;&#x000A;initial_begin = 1;&#x000D;&#x000A;for i=1:length(ActiveSubcAlloc(:,1))&#x000D;&#x000A;initial_end = ActiveSubcAlloc(i,2)-ActiveSubcAlloc(i,1)+initial_begin;&#x000D;&#x000A;ActiveSubcIndex(initial_begin:initial_end)=[ActiveSubcAlloc(i,1):ActiveSubcAlloc(i,2)];&#x000D;&#x000A;initial_begin =initial_end+1;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;PilotAlloc = PilotIndex;&#x000D;&#x000A;if PilotEnable == 1&#x000D;&#x000A;&#x0009;DataSym_NumInput = 2;&#x000D;&#x000A;&#x0009;PilotLoc_tmp = PilotAlloc;&#x000D;&#x000A;&#x0009;m=1;&#x000D;&#x000A;&#x0009;%PilotLoc = zeros(1,1);&#x000D;&#x000A;&#x0009;for i= 1:length(PilotLoc_tmp)&#x000D;&#x000A;&#x0009;&#x0009;if(find(ActiveSubcIndex==PilotLoc_tmp(i)))&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PilotLoc(m)= PilotLoc_tmp(i);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;m=m+1;&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x0009;ActivePilot = length(PilotLoc);&#x000D;&#x000A;&#x0009;ActivePilotSequence = PilotSequence(1:ActivePilot);&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;DataSym_NumInput = 1;&#x000D;&#x000A;&#x0009;ActivePilot = 0;&#x000D;&#x000A;&#x0009;PilotLoc = [];&#x000D;&#x000A;&#x0009;ActivePilotSequence = [];&#x000D;&#x000A;end;&#x000D;&#x000A;&#x000D;&#x000A;m=1;&#x000D;&#x000A;%DataLoc=zeros(1,1);&#x000D;&#x000A;for i= 1:length(ActiveSubcIndex)&#x000D;&#x000A;&#x0009;if(find(PilotLoc==ActiveSubcIndex(i)))&#x000D;&#x000A;&#x0009;   &#x000D;&#x000A;&#x0009;else&#x000D;&#x000A;&#x0009;&#x0009;DataLoc(m)= ActiveSubcIndex(i);&#x000D;&#x000A;&#x0009;&#x0009;m=m+1;&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x000D;&#x000A;DataLoc=DataLoc;&#x000D;&#x000A;ActiveData = length(DataLoc);&#x000D;&#x000A;&#x000D;&#x000A;if(NumEqualizerTaps == 2)&#x000D;&#x000A;NumGuardRemove = FilterOverlapFactor+NumPreambleSyms +1;&#x000D;&#x000A;else&#x000D;&#x000A;NumGuardRemove = FilterOverlapFactor+NumPreambleSyms;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;FrameSizeWithoutIdle = (NumPreambleSyms+NumDataSyms+FilterOverlapFactor) * NumSubcarriers * (2^OversampleRatio);&#x000D;&#x000A;FrameSizeWithIdle = FrameSizeWithoutIdle  + floor(IdleInterval*SampleRate*(2^OversampleRatio)+0.5);</Text>
