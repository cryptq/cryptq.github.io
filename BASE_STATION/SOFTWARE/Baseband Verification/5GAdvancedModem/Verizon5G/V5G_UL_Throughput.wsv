<Item XName="BRS_Configuration" Type="PartParam">
<DataEntry>BRS_Configuration</DataEntry>
<Description>beam reference signal (BRS) configuration</Description>
<Enum>V5G_HARQ_Controller__BRS_Configuration@5G Advanced Modem Enums</Enum>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="CQI_BetaOffsetIndex" Type="PartParam">
<DataEntry>CQI_BetaOffsetIndex</DataEntry>
<Description>CQI offset values, used in calculating the number of coded CQI symbols. Range 0~15.</Description>
<HideCondition>1==xPUSCH_TransMode</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="CQI_NumInfoBits" Type="PartParam">
<DataEntry>CQI_NumInfoBits</DataEntry>
<Description>CQI information bits size</Description>
<HideCondition>1==xPUSCH_TransMode</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="CellID_Group" Type="PartParam">
<DataEntry>CellID_Group</DataEntry>
<Description>the index of cell identity group ([0:167])</Description>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>11</D></Validate></Item>
<Item XName="CellID_Sector" Type="PartParam">
<DataEntry>CellID_Sector</DataEntry>
<Description>the index of cell identity within the physical-layer cell-identity group ([0:2])</Description>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>11</D></Validate></Item>
<Item XName="DataSubframeStructure" Type="PartParam">
<DataEntry>DataSubframeStructure</DataEntry>
<Description>the data subframe structure configuration in each subframe, range is [0,10]</Description>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="DemapperMaxLevel" Type="PartParam">
<DataEntry>1.0</DataEntry>
<Description>the maximum level for soft demapping output when DemapperType is Soft or CSI</Description>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="DemapperType" Type="PartParam">
<DataEntry>1</DataEntry>
<Description>demapper type</Description>
<Enum>V5G_Demapper__DemapperType@5G Advanced Modem Enums</Enum>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="HARQ_Enable" Type="PartParam">
<DataEntry>HARQ_Enable</DataEntry>
<Description>whether enable HARQ or not</Description>
<Enum>LTE_UL_ChannelDecoder_HARQ_Enable@LTE 8.9 Enums</Enum>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="LDPC_Algorithm" Type="PartParam">
<DataEntry>1</DataEntry>
<Description>decoding algorithm for LDPC</Description>
<Enum>V5G_LDPC_Decoder__Algorithm@5G Advanced Modem Enums</Enum>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="LDPC_IterationNumber" Type="PartParam">
<DataEntry>30</DataEntry>
<Description>the number of iterations</Description>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>11</D></Validate></Item>
<Item XName="LDPC_ScalingFactor" Type="PartParam">
<DataEntry>1.0</DataEntry>
<Description>scaling factor for input signal</Description>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="L_CVRBGs" Type="PartParam">
<DataEntry>L_CVRBGs</DataEntry>
<Description>L_CVRBGs for xPUSCH transmission, the number of Virtual RBGs allocated to each user in each subframe</Description>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="Layers_REMapping_Config" Type="PartParam">
<DataEntry>Layers_REMapping_Config</DataEntry>
<Description>number of layers and associated RE mapping index indication by UL DCI formats for each user (see Table 5.3.3.1.1-1 of V5G 212).</Description>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="MCS" Type="PartParam">
<DataEntry>MCS</DataEntry>
<Description>modulation and coding scheme (MCS) for each user</Description>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="MMSE_RBWinLen" Type="PartParam">
<DataEntry>MMSE_RBWinLen</DataEntry>
<Description>number of RBs for each MMSE-2D interpolation</Description>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>11</D></Validate></Item>
<Item XName="MaxHARQTrans" Type="PartParam">
<DataEntry>MaxHARQTrans</DataEntry>
<Description>maximum number of HARQ transmission per each HARQ process</Description>
<HideCondition>0==HARQ_Enable</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>11</D></Validate></Item>
<Item XName="NumHARQ" Type="PartParam">
<DataEntry>NumHARQ</DataEntry>
<Description>number of HARQ processes</Description>
<HideCondition>0==HARQ_Enable</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>11</D></Validate></Item>
<Item XName="NumRxRFChains" Type="PartParam">
<DataEntry>NumRxRFChains</DataEntry>
<Description>number of Rx RF chains</Description>
<Enum />
<Validate><T>Int</T><D>11</D></Validate></Item>
<Item XName="NumTxPorts" Type="PartParam">
<DataEntry>NumTxPorts</DataEntry>
<Description>number of tx ports for uplink</Description>
<Enum>V5G_UL_DemuxOFDMSym__NumPorts@5G Advanced Modem Enums</Enum>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="NumUsers" Type="PartParam">
<DataEntry>NumUsers</DataEntry>
<Description>the number of users</Description>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>11</D></Validate></Item>
<Item XName="OversamplingOption" Type="PartParam">
<DataEntry>OversamplingOption</DataEntry>
<Description>oversampling ratio option</Description>
<Enum>LTE_DL_OFDM_Modulator_OversamplingOption@LTE 8.9 Enums</Enum>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="PCRS_Enable" Type="PartParam">
<DataEntry>[0]</DataEntry>
<Description>phase noise compensation reference signal (PCRS) is enabled or not in channel estimation for each user, O means NO, 1 means YES</Description>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PRACH_Configuration" Type="PartParam">
<DataEntry>PRACH_Configuration</DataEntry>
<Description>Physical random access channel (PRACH) configuration</Description>
<Enum>V5G_HARQ_Controller__PRACH_Configuration@5G Advanced Modem Enums</Enum>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="RI_BetaOffsetIndex" Type="PartParam">
<DataEntry>RI_BetaOffsetIndex</DataEntry>
<Description>RI offset values, used in calculating the number of coded RI symbols. Range 0~12.</Description>
<HideCondition>1==xPUSCH_TransMode</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="RI_NumInfoBits" Type="PartParam">
<DataEntry>RI_NumInfoBits</DataEntry>
<Description>RI information bits size</Description>
<HideCondition>1==xPUSCH_TransMode</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="RV_Sequence" Type="PartParam">
<DataEntry>[0,0,0,0]</DataEntry>
<Description>redundancy version sequence for HARQ closed-loop transmission ([0, 3])</Description>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="SNR" Type="PartParam">
<DataEntry>SNR</DataEntry>
<Description>SNR in dB. (used by 2D-MMSE channel estimator in xPUSCH)</Description>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="Sym_StartPos" Type="PartParam">
<DataEntry>[-3, -3]</DataEntry>
<Description>start position (without oversampling) to get the OFDM symbol for FFT operation for long CP and short CP symbols respectively, compared to the start position of the OFDM body after CP</Description>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="T_ePBCH" Type="PartParam">
<DataEntry>T_ePBCH</DataEntry>
<Description>ePBCH transmission periodicity as in Table 6.5.A.4-1 of V5G211</Description>
<Enum>V5G_HARQ_Controller__T_ePBCH@5G Advanced Modem Enums</Enum>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="Tmax" Type="PartParam">
<DataEntry>Tmax</DataEntry>
<Description>the maximum delay of multi-path channel. (used by 2D-MMSE channel estimator in xPUSCH)</Description>
<Show><T>Bool</T><D>0</D></Show>
<Unit><T>Int</T><D>7004</D></Unit>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="TransmissionMode" Type="PartParam">
<DataEntry>TransmissionMode</DataEntry>
<Description>transmission mode for each user, 0 means transmit diversity , 1 means spatial multiplexing</Description>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="VRBG_start" Type="PartParam">
<DataEntry>VRBG_start</DataEntry>
<Description>VRBG_start for xPUSCH transmission, the start index of Virtual RBGs allocated to each user in each subframe</Description>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="n2_xPUCCH" Type="PartParam">
<DataEntry>n2_xPUCCH</DataEntry>
<Description>resource index for xPUCCH formats 2</Description>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="n_ID" Type="PartParam">
<DataEntry>n_ID</DataEntry>
<Description>n_ID for DMRS generation for xPUSCH for each user</Description>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="n_RNTI" Type="PartParam">
<DataEntry>n_RNTI</DataEntry>
<Description>radio network temporary identifier for each user</Description>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="n_SCID" Type="PartParam">
<DataEntry>n_SCID</DataEntry>
<Description>n_SCID for DMRS generation for xPUSCH for each user</Description>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="xPUSCH_TransMode" Type="PartParam">
<DataEntry>xPUSCH_TransMode</DataEntry>
<Description>whether control and data are sent via xPUSCH</Description>
<Enum>V5G_HARQ_Controller__xPUSCH_TransMode@5G Advanced Modem Enums</Enum>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>16</D></Validate></Item></Item></Item>
