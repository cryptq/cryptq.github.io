<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="SpecShapingAntNum" Type="PartParam">
<DataEntry>1</DataEntry>
<Description>the number of antennas to apply spectrum shaping from Antenna index #1 to index #SpecShapingAntNum</Description>
<Validate><T>Int</T><D>11</D></Validate></Item>
<Item XName="SpecShapingScale" Type="PartParam">
<DataEntry>1</DataEntry>
<Description>spectrum shaping scale for FIR Filter</Description>
<Enum>V5G_SpecShaping__SpecShapingScale@5G Advanced Modem Enums</Enum>
<HideCondition>0==SpectrumShapingType</HideCondition>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="SpectrumShapingType" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>spectrum shaping method</Description>
<Enum>V5G_SpecShaping__SpectrumShapingType@5G Advanced Modem Enums</Enum>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="T_ePBCH" Type="PartParam">
<DataEntry>T_ePBCH</DataEntry>
