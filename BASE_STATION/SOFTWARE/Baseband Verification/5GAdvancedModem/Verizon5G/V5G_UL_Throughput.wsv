<Item XName="Equations" Type="Equation">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>NumTx = 2^(NumTxPorts);&#x000D;&#x000A;NumRx = NumRxRFChains;&#x000D;&#x000A;BaseSampleRate = 30.72e6*5;&#x000D;&#x000A;SampleRate = BaseSampleRate*(2^OversamplingOption);&#x000D;&#x000A;&#x000D;&#x000A;%Range check on NumTxPorts and Layers_REMapping_Config&#x000D;&#x000A;%if &#x000D;&#x000A;&#x000D;&#x000A;SignalPower = 10 %dBm&#x000D;&#x000A;%SNR = 30;&#x000D;&#x000A;Bandwidth_Hz = 12 * 5 * 15000 * 100;&#x000D;&#x000A;NDensity = SignalPower  - SNR - 10*log10(Bandwidth_Hz); %dBm&#x000D;&#x000A;&#x000D;&#x000A;%set the REs of EVM&#x000D;&#x000A;if(NumTxPorts ==1 &amp;&amp; TransmissionMode ==1&amp;&amp;(Layers_REMapping_Config &gt;3))&#x000D;&#x000A;NumOfInterestedPorts = 2;&#x000D;&#x000A;else&#x000D;&#x000A;NumOfInterestedPorts = 1;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;%More input parameters are set here&#x000D;&#x000A;n_ID = [0]; %n_ID for DMRS generation for xPDSCH for each user&#x000D;&#x000A;n_SCID = [0]; %n_SCID for DMRS generation for xPDSCH for each user&#x000D;&#x000A;CellID_Sector = 0;%the index of cell identity within the physical-layer cell-identity group ([0:2])&#x000D;&#x000A;CellID_Group = 0; %the index of cell identity group ([0:167])&#x000D;&#x000A;n_RNTI = [0];% radio network temporary identifier for each user&#x000D;&#x000A;n2_xPUCCH = [0];%resource index for xPUCCH formats 2&#x000D;&#x000A;xPUSCH_TransMode = 0; %whether control and data are sent via xPUSCH&#x000D;&#x000A;RI_NumInfoBits = [0]; %RI information bits size ([0,inf))&#x000D;&#x000A;RI_BetaOffsetIndex = [0];%RI offset values, used in calculating the number of coded RI symbols ([0,12])&#x000D;&#x000A;CQI_NumInfoBits = [0];%CQI information bits size ([0,inf))&#x000D;&#x000A;CQI_BetaOffsetIndex = [2];%CQI offset values, used in calculating number of coded CQI symbols ([2,15])&#x000D;&#x000A;xPUCCH_On = [1];%xPUCCH is enabled or not for each subframe of each user&#x000D;&#x000A;xPUCCH_NumHARQACKBits = [1];%number of HARQ-ACK bits for each subframe of each user, in range [0,22]&#x000D;&#x000A;xPUCCH_NumSRBits = [0];%number of scheduling request bits for each subframe of each user, in range [0,22]&#x000D;&#x000A;xPUCCH_NumCQIBits = [0];%number of CQI bits for each subframe of each user, in range [0,22]&#x000D;&#x000A;xPUCCH_NumPMIBits = [0];%number of PMI bits for each subframe of each user, in range [0,22]&#x000D;&#x000A;xPUCCH_NumRIBits = [0];%number of rank indicator bits for each subframe of each user, in range [0,22]&#x000D;&#x000A;xPUCCH_NumBSIBits = [0];%number of beam state information bits for each subframe of each user, in range [0,22]&#x000D;&#x000A;xPUCCH_NumBRIBits = [0];%number of beam refinement information bits for each subframe of each user, in range[0, 22]</Text>
