<Item XName="EquationText" Type="PartParam">
<DataEntry>if (Num_xPDSCH_REs ~= 0) &amp;&amp; (numel(CIR_xPDSCH{1})~=0)&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;metric = zeros(4 - DiversityRange, 1);&#x000D;&#x000A;&#x0009;for nn = 1:(4 - DiversityRange)&#x000D;&#x000A;&#x0009;&#x0009;metric(nn) = mean(abs(CIR_xPDSCH{1}).^2 - abs(CIR_xPDSCH{nn}).^2);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x0009;&#x000D;&#x000A;&#x0009;[MaxValue, MaxIndex] = sort(metric);&#x000D;&#x000A;&#x0009;output_CIR_xPDSCH = CIR_xPDSCH{MaxIndex};&#x000D;&#x000A;&#x0009;output_RX_xPDSCH = RX_xPDSCH{MaxIndex};&#x000D;&#x000A;&#x0009;&#x000D;&#x000A;&#x0009;if MaxIndex == 1&#x000D;&#x000A;&#x0009;&#x0009;Index_Sel_tmp = 1;&#x000D;&#x000A;&#x0009;elseif MaxIndex == 2&#x000D;&#x000A;&#x0009;&#x0009;Index_Sel_tmp = 2;&#x000D;&#x000A;&#x0009;elseif MaxIndex == 3&#x000D;&#x000A;&#x0009;&#x0009;Index_Sel_tmp = 3;&#x000D;&#x000A;&#x0009;else&#x000D;&#x000A;&#x0009;&#x0009;Index_Sel_tmp = 4;&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;output_RX_xPDSCH = RX_xPDSCH{1};&#x000D;&#x000A;&#x0009;output_CIR_xPDSCH = CIR_xPDSCH{1};&#x000D;&#x000A;&#x0009;Index_Sel_tmp = 1;&#x000D;&#x000A;end&#x000D;&#x000A;Index_Sel = Index_Sel_tmp;</DataEntry>
