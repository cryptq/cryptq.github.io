<Enum>V5G_DL_MuxOFDMSym__T_ePBCH@5G Advanced Modem Enums</Enum>
<HideCondition>~((ParametersDisplay==0) || (ParametersDisplay==1))</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
