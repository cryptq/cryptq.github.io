<Item XName="ClusterASA" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>Cluster azimuth spread of arrival angles in degree, range [0, 104]</Description>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="ClusterASD" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>Cluster azimuth spread of departure angles in degree, range [0, 104]</Description>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="ClusterAoA" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>Azimuth angle of arrival of each cluster in degree, range [-360, 360]</Description>
<Validate><T>Int</T><D>14</D></Validate></Item>
<Item XName="ClusterAoD" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>Azimuth angle of departure of each cluster in degree, range [-360, 360]</Description>
<Validate><T>Int</T><D>14</D></Validate></Item>
<Item XName="ClusterDelay" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>Delay of each cluster in s</Description>
<Validate><T>Int</T><D>14</D></Validate></Item>
<Item XName="ClusterPowerindB" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>Power of each cluster in dB</Description>
<Validate><T>Int</T><D>14</D></Validate></Item>
<Item XName="ClusterZSA" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>Cluster zenith spread of arrival angles in degree, range [0, 52]</Description>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="ClusterZSD" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>Cluster zenith spread of departure angles in degree, range [0, 52]</Description>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="ClusterZoA" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>Zenith angle of arrival of each cluster in degree, range [0, 180]</Description>
<Validate><T>Int</T><D>14</D></Validate></Item>
<Item XName="ClusterZoD" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>Zenith angle of departure of each cluster in degree, range [0, 180]</Description>
<Validate><T>Int</T><D>14</D></Validate></Item>
<Item XName="DisableInitialPhase" Type="PartParam">
<DataEntry>1</DataEntry>
<Description>Disable the effect of initial phases and set all initial phases to 0</Description>
<Enum>MIMO_3DChannel__DisableInitialPhase@5G Advanced Modem Enums</Enum>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="NumClusters" Type="PartParam">
<DataEntry>1</DataEntry>
<Description>Number of clusters, range [1, 32]</Description>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="NumRxAntPatternFiles" Type="PartParam">
<DataEntry>[1;1;1;1]</DataEntry>
<Description>Number of candidate pattern files for each Rx antenna element, range [1, 512]</Description>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="NumTxAntPatternFiles" Type="PartParam">
<DataEntry>[1;1;1;1]</DataEntry>
<Description>Number of candidate pattern files for each Tx antenna element, range [1, 512]</Description>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="RxAntPatternFileName" Type="PartParam">
<DataEntry />
<Description>Rx antenna pattern filename (if there are multiple files, select the first one)</Description>
<Validate><T>Int</T><D>10</D></Validate></Item>
<Item XName="RxAntPatternFileType" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>Rx Antenna pattern file format (EMPro or HFSS or CST)</Description>
<Enum>MIMO_3DChannel__RxAntPatternFileType@5G Advanced Modem Enums</Enum>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="RxAntPatternType" Type="PartParam">
<DataEntry>2</DataEntry>
<Description>Rx antenna radiation pattern, when set to &apos;FromFile&apos;, read the user-defined antenna pattern from file which is specified by the &apos;RxAntPatternFileName&apos;</Description>
<Enum>MIMO_3DChannel__RxAntPatternType@5G Advanced Modem Enums</Enum>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="RxMultiPatternEnable" Type="PartParam">
<DataEntry>1</DataEntry>
<Description>Enable multiple pattern files for each Rx antenna or beam</Description>
<Enum>MIMO_3DChannel__RxMultiPatternEnable@5G Advanced Modem Enums</Enum>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="SampleRate" Type="PartParam">
<DataEntry>5e6</DataEntry>
<Description>Sampling rate of input signal in Hz, range (0, +Inf)</Description>
<Unit><T>Int</T><D>1001</D></Unit>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="Seed" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>Seed of random integer number generator, range [0, 2^32-1]. When set to 0, the simulation data is generated randomly for each simulation run. For each non-zoro setting, the simulation can be repeated</Description>
<Validate><T>Int</T><D>11</D></Validate></Item>
