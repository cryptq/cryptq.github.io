<Item XName="AP_Layer_Config" Type="PartParam">
<DataEntry>AP_Layer_Config</DataEntry>
<Description>antenna port(s) and number of layers indication by DL DCI formats for xPDSCH transmission for each user, see Table 5.3.3.1.3-1 of V5G212.</Description>
<HideCondition>~((ParametersDisplay==0) || (ParametersDisplay==2))</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="BRS_Configuration" Type="PartParam">
<DataEntry>1</DataEntry>
<Description>beam reference signal (BRS) configuration</Description>
<Enum>V5G_DL_MuxOFDMSym__BRS_Configuration@5G Advanced Modem Enums</Enum>
<HideCondition>~((ParametersDisplay==0) || (ParametersDisplay==1))</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="CI_StartPos" Type="PartParam">
<DataEntry>-3</DataEntry>
<Description>the start position of cyclic interval (without oversampling), compared to the start position of CP (negative means ahead of CP)</Description>
<HideCondition>1==SpectrumShapingType||1==ParametersDisplay||2==ParametersDisplay</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>11</D></Validate></Item>
<Item XName="CellID_Group" Type="PartParam">
<DataEntry>CellID_Group</DataEntry>
<Description>the index of cell identity group</Description>
<HideCondition>~((ParametersDisplay==0) || (ParametersDisplay==1))</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>11</D></Validate></Item>
<Item XName="CellID_Sector" Type="PartParam">
<DataEntry>CellID_Sector</DataEntry>
<Description>the index of cell identity within the physical-layer cell-identity group</Description>
<HideCondition>~((ParametersDisplay==0) || (ParametersDisplay==1))</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>11</D></Validate></Item>
<Item XName="CyclicInterval" Type="PartParam">
<DataEntry>6</DataEntry>
<Description>the overlapped cyclic interval between two adjacent symbols in unit of chips (without oversampling), valid when SpectrumShapingType=TimeWindowing</Description>
<HideCondition>1==SpectrumShapingType||1==ParametersDisplay||2==ParametersDisplay</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>11</D></Validate></Item>
<Item XName="DataSubframeStructure" Type="PartParam">
<DataEntry>DataSubframeStructure</DataEntry>
<Description>the data subframe structure configuration in each subframe, range is [0,10]</Description>
<HideCondition>~((ParametersDisplay==0) || (ParametersDisplay==2))</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="FIR_FilterType" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>spectrum-shaping FIR filter type, valid when SpectrumShapingType=FIRFilter</Description>
<Enum>V5G_SpecShaping__FIR_FilterType@5G Advanced Modem Enums</Enum>
<HideCondition>0==SpectrumShapingType||1==ParametersDisplay||2==ParametersDisplay</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="FIR_Taps" Type="PartParam">
<DataEntry>19</DataEntry>
<Description>number of FIR filter taps, valid when SpectrumShapingType=FIRFilter</Description>
<HideCondition>0==SpectrumShapingType||1==ParametersDisplay||2==ParametersDisplay</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>11</D></Validate></Item>
<Item XName="FIR_withInterp" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>whether spectrum-shaping FIR filter with interpolation operation or not, valid when SpectrumShapingType=FIRFilter</Description>
<Enum>V5G_SpecShaping__FIR_withInterp@5G Advanced Modem Enums</Enum>
<HideCondition>0==SpectrumShapingType||1==ParametersDisplay||2==ParametersDisplay</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="HARQ_Enable" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>whether HARQ closed-loop transmission is enabled</Description>
<Enum>LTE_DL_Src_FIR_withInterp@LTE 8.9 Enums</Enum>
<HideCondition>~((ParametersDisplay==0) || (ParametersDisplay==2))</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="L_CVRBGs" Type="PartParam">
<DataEntry>L_CVRBGs</DataEntry>
<Description>L_CVRBGs for xPDSCH transmission, the number of Virtual RBGs allocated to each user in each subframe</Description>
<HideCondition>~((ParametersDisplay==0) || (ParametersDisplay==2))</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="MCS" Type="PartParam">
<DataEntry>MCS</DataEntry>
<Description>modulation and coding scheme (MCS) for each user</Description>
<HideCondition>~((ParametersDisplay==0) || (ParametersDisplay==2))</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="MaxHARQTrans" Type="PartParam">
<DataEntry>4</DataEntry>
<Description>maximum number of HARQ transmission per each HARQ process for each user</Description>
<HideCondition>~((ParametersDisplay==0) || (ParametersDisplay==2))</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="NumBRSPorts" Type="PartParam">
<DataEntry>1</DataEntry>
<Description>the number of BRS ports, range:[1,8]</Description>
<HideCondition>~((ParametersDisplay==0) || (ParametersDisplay==1))</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>11</D></Validate></Item>
<Item XName="NumHARQ" Type="PartParam">
<DataEntry>8</DataEntry>
<Description>number of HARQ processes for each user</Description>
<HideCondition>~((ParametersDisplay==0) || (ParametersDisplay==2))</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="NumUsers" Type="PartParam">
<DataEntry>NumUsers</DataEntry>
<Description>the number of users</Description>
<HideCondition>~((ParametersDisplay==0) || (ParametersDisplay==2))</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>11</D></Validate></Item>
<Item XName="OversamplingOption" Type="PartParam">
<DataEntry>OversamplingOption</DataEntry>
<Description>oversampling ratio</Description>
<Enum>V5G_DL_MuxSlot__OversamplingOption@5G Advanced Modem Enums</Enum>
<HideCondition>~((ParametersDisplay==0) || (ParametersDisplay==3))</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="PCRS_Enable" Type="PartParam">
<DataEntry>PCRS_Enable</DataEntry>
<Description>DL Phase noise compensation reference signal (PCRS) is enabled or not for each user, O means NO, 1 means YES</Description>
<HideCondition>~((ParametersDisplay==0) || (ParametersDisplay==2))</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PCRS_Ports_Config" Type="PartParam">
<DataEntry>PCRS_Ports_Config</DataEntry>
<Description>DL Phase noise compensation reference signal (PCRS) port configuration for each user, 0 means Port 60, 1 means Port 61, 2 means both Port 60 and 61</Description>
<HideCondition>~((ParametersDisplay==0) || (ParametersDisplay==2))</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PRACH_Configuration" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>Physical random access channel (PRACH) configuration</Description>
<Enum>V5G_DL_MuxOFDMSym__PRACH_Configuration@5G Advanced Modem Enums</Enum>
<HideCondition>~((ParametersDisplay==0) || (ParametersDisplay==1))</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="ParametersDisplay" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>to specify what kind of parameters to display</Description>
<Enum>V5G_DL_Src_ParameterCategory@5G Advanced Modem Enums</Enum>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="RRC_Alpha" Type="PartParam">
<DataEntry>0.22</DataEntry>
<Description>roll-off factor for root raised-cosine filter, valid when SpectrumShapingType=FIRFilter</Description>
<HideCondition>0==SpectrumShapingType||1==ParametersDisplay||2==ParametersDisplay</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="SearchSpaceIndex" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>search space index for xPDCCH assignment, the range is [0, 14]</Description>
<HideCondition>~((ParametersDisplay==0) || (ParametersDisplay==2))</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>11</D></Validate></Item>
<Item XName="SpecShapingAntNum" Type="PartParam">
<DataEntry>1</DataEntry>
<Description>the number of antennas to apply spectrum shaping from Antenna index #1 to index #SpecShapingAntNum</Description>
<HideCondition>1==ParametersDisplay||2==ParametersDisplay</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>11</D></Validate></Item>
<Item XName="SpecShapingScale" Type="PartParam">
<DataEntry>1</DataEntry>
