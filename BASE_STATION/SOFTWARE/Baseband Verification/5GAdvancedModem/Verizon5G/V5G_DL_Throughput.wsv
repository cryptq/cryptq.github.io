<Item XName="Equations" Type="Equation">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>N_DL_RB = 100;&#x000D;&#x000A;&#x000D;&#x000A;%adjust DMRS xPDCCH gain&#x000D;&#x000A;DMRS_xPDCCH_Gain = sqrt(0.5);&#x000D;&#x000A;&#x000D;&#x000A;%xPDCCH&#x000D;&#x000A;num_pdcch_syms = 1;&#x000D;&#x000A;for n = 1: size(DataSubframeStructure,1)*size(DataSubframeStructure,2)&#x000D;&#x000A;&#x0009;if DataSubframeStructure(n) == 2&#x000D;&#x000A;&#x0009;   num_pdcch_syms = 2;&#x000D;&#x000A;&#x0009;end;&#x000D;&#x000A;&#x0009;if DataSubframeStructure(n) == 3&#x000D;&#x000A;&#x0009;   num_pdcch_syms = 2;&#x000D;&#x000A;&#x0009;end;&#x000D;&#x000A;end;&#x000D;&#x000A;&#x000D;&#x000A;xPDCCH_NumSymbols = num_pdcch_syms*NumCCEs*48;</Text>
