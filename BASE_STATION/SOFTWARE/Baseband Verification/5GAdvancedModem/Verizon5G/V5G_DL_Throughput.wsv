<ParamOrder><T>Array_BString</T><D>1;20;NumUsers;SelectedUser;BRS_Configuration;NumBRSPorts;DataSubframeStructure;AP_Layer_Config;TransmissionMode;VRBG_start;L_CVRBGs;MCS;SNR;TxArrayStructure;TxArray_Configuration;TxNumElementsY;TxNumElementsZ;RxArrayStructure;RxArray_Configuration;RxNumElementsY;RxNumElementsZ;NumRxRFChains</D></ParamOrder>
<Item XName="AP_Layer_Config" Type="PartParam">
<DataEntry>[1, 0]</DataEntry>
<Description>the antenna port configuration</Description>
<Enum />
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="BRS_Configuration" Type="PartParam">
<DataEntry>1</DataEntry>
<Description>BRS configuration</Description>
<Enum>V5G_DL_BeamAcquisitionTracking__BRS_Configuration@5G Advanced Modem Enums</Enum>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="DataSubframeStructure" Type="PartParam">
<DataEntry>[0, 0]</DataEntry>
<Description>the data subframe structure configuration in each subframe, range is [0,10]</Description>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="L_CVRBGs" Type="PartParam">
<DataEntry>[5, 6]</DataEntry>
<Description>length of the resource allocation, in terms of virtually contiguously allocated virtual resource block groups</Description>
<Validate><T>Int</T><D>11</D></Validate></Item>
<Item XName="MCS" Type="PartParam">
<DataEntry>[3, 3]</DataEntry>
<Description>modulation and coding scheme (MCS) for each user</Description>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="NumBRSPorts" Type="PartParam">
<DataEntry>1</DataEntry>
<Description>the number of BRS ports, range:[1,8]</Description>
<Validate><T>Int</T><D>11</D></Validate></Item>
<Item XName="NumRxRFChains" Type="PartParam">
<DataEntry>1</DataEntry>
<Description>number of RX RF chains</Description>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="NumUsers" Type="PartParam">
<DataEntry>2</DataEntry>
<Description>number of users</Description>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="RxArrayStructure" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>shared array or subarray</Description>
<Enum>DigitalBeamformerTx__MultiUser@Data Flow Enums</Enum>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="RxArray_Configuration" Type="PartParam">
<DataEntry>2</DataEntry>
<Description>receiver antenna array configuration</Description>
<Enum>BeamPattern__Configuration@Data Flow Enums</Enum>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="RxNumElementsY" Type="PartParam">
<DataEntry>2</DataEntry>
<Description>number of elements on Y axis of receiver antenna array</Description>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="RxNumElementsZ" Type="PartParam">
<DataEntry>2</DataEntry>
<Description>number of elements on Z axis of receiver antenna array</Description>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="SNR" Type="PartParam">
<DataEntry>1.2</DataEntry>
