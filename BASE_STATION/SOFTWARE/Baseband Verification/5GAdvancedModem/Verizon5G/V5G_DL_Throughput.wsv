<Description>SNR in dB. (used by 2D-MMSE channel estimator in PDSCH)</Description>
<HideCondition>~((ParametersDisplay==0) || (ParametersDisplay==4))</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="StartSubframeIgnored" Type="PartParam">
<DataEntry>StartSubframeIgnored</DataEntry>
<Description>number of subframes (or transport blocks) that are ignored at the beginning due to beamforming training</Description>
<HideCondition>~((ParametersDisplay==0) || (ParametersDisplay==3))</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>11</D></Validate></Item>
<Item XName="SubframeIgnored" Type="PartParam">
<DataEntry>SubframeIgnored</DataEntry>
<Description>number of subframes (or transport blocks) that are ignored at the beginning due to system delay</Description>
<HideCondition>~((ParametersDisplay==0) || (ParametersDisplay==3))</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>11</D></Validate></Item>
<Item XName="T_ePBCH" Type="PartParam">
<DataEntry>T_ePBCH</DataEntry>
<Description>ePBCH transmission periodicity as in Table 6.5.A.4-1 of V5G211</Description>
<Enum>V5G_DL_DemuxOFDMSym__T_ePBCH@5G Advanced Modem Enums</Enum>
<HideCondition>~((ParametersDisplay==0) || (ParametersDisplay==1))</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="Tmax" Type="PartParam">
<DataEntry>Tmax</DataEntry>
<Description>the maximum delay of multi-path channel. (used by 2D-MMSE channel estimator in PDSCH)</Description>
<HideCondition>~((ParametersDisplay==0) || (ParametersDisplay==4))</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Unit><T>Int</T><D>7004</D></Unit>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="TransmissionMode" Type="PartParam">
<DataEntry>TransmissionMode</DataEntry>
<Description>transmission mode</Description>
<Enum>V5G_DL_Equalizer_xPDSCH__TransmissionMode@5G Advanced Modem Enums</Enum>
<HideCondition>~((ParametersDisplay==0) || (ParametersDisplay==2))</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="VRBG_start" Type="PartParam">
<DataEntry>VRBG_start(SelectedUser)</DataEntry>
<Description>VRBG_start for xPDSCH transmission, the start index of Virtual RBGs allocated to each user in each subframe</Description>
<HideCondition>~((ParametersDisplay==0) || (ParametersDisplay==2))</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="n_ID" Type="PartParam">
<DataEntry>n_ID(SelectedUser)</DataEntry>
<Description>n_ID for DMRS generation for xPDSCH for each user</Description>
<HideCondition>~((ParametersDisplay==0) || (ParametersDisplay==2))</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="n_RNTI" Type="PartParam">
<DataEntry>n_RNTI</DataEntry>
<Description>radio network temporary identifier ([0:65535])</Description>
<HideCondition>~((ParametersDisplay==0) || (ParametersDisplay==2))</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>11</D></Validate></Item>
<Item XName="n_SCID" Type="PartParam">
<DataEntry>n_SCID(SelectedUser)</DataEntry>
<Description>n_SCID for DMRS generation for xPDSCH for each user</Description>
<HideCondition>~((ParametersDisplay==0) || (ParametersDisplay==2))</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item></Item></Item>
