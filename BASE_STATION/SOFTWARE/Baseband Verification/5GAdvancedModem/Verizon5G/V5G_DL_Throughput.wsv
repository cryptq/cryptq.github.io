<Item XName="Equations" Type="Equation">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>% ------------------------------ Sim Configuration ------------------------------&#x000D;&#x000A;fc = 28e9; % Hz, carrier frequency&#x000D;&#x000A;OversamplingOption = 0; % oversampling ratio option&#x000D;&#x000A;NumUsers = 1; % number of users&#x000D;&#x000A;CellID_Sector = 0; % the index of cell identity within the physical-layer cell-identity group&#x000D;&#x000A;CellID_Group = 0; % the index of cell identity group&#x000D;&#x000A;n_ID = 0; % provided by higher layers for DMRS generation&#x000D;&#x000A;n_SCID = 0; % provided by DCI for DMRS generation&#x000D;&#x000A;n_xPDCCH_ID = 0; % provided by higher layers for DMRS generation&#x000D;&#x000A;n_RNTI = 1; % radio network temporary identifier&#x000D;&#x000A;SubframeIgnored = 1; % number of subframes (or transport blocks) that are ignored at the beginning due to system delay&#x000D;&#x000A;BSI_ReportDelay = 1; % BSI report delay per V5G.213&#x000D;&#x000A;BI_Rx_Delay = 1; % beam index delay in receiver side&#x000D;&#x000A;SYNC_En_Delay = 1; % SYNC_En delay in receiver side&#x000D;&#x000A;MMSE_RBWinLen = 3; % number of RBs for each MMSE-2D interpolation&#x000D;&#x000A;Tmax = 0.002/(30.72e6*5); % the maximum delay of multi-path channel. (used by 2D-MMSE channel estimator in PDSCH)&#x000D;&#x000A;PCRS_Enable = 0; % whether to enable PCRS transmission&#x000D;&#x000A;PCRS_Ports_Config = 2; % the antenna port(s) configuration for PCRS&#x000D;&#x000A;PRACH_Configuration = 1; % PRACH configuration&#x000D;&#x000A;T_ePBCH = 0; % ePBCH transmission periodicity as in Table 6.5.A.4-1 of V5G211&#x000D;&#x000A;SearchSpaceIndex = 0; % search space index for xPDCCH assignment, the range is [0, 14]&#x000D;&#x000A;SelectedUser = 1; % selected users to analysis in the receiver side, currently, it should be 1 constantly.&#x000D;&#x000A;HARQ_Enable = 0; % whether HARQ closed-loop transmission is enabled&#x000D;&#x000A;NumHARQ = 10; % number of HARQ processes for each user&#x000D;&#x000A;MaxHARQTrans = 4; % maximum number of HARQ transmission per each HARQ process for each user&#x000D;&#x000A;if TxArray_Configuration == 2&#x000D;&#x000A;&#x0009;TxNumRows = TxNumElementsY;&#x000D;&#x000A;&#x0009;TxNumCols = TxNumElementsZ;&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;TxNumRows = 1;&#x000D;&#x000A;&#x0009;TxNumCols = numel(TxPosition_X);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if RxArray_Configuration == 2&#x000D;&#x000A;&#x0009;RxNumRows = RxNumElementsY;&#x000D;&#x000A;&#x0009;RxNumCols = RxNumElementsZ;&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;RxNumRows = 1;&#x000D;&#x000A;&#x0009;RxNumCols = numel(RxPosition_X);&#x000D;&#x000A;end&#x000D;&#x000A;% ------------------------------ Tx Antenna Topology ------------------------------&#x000D;&#x000A;% UPA is the assumption&#x000D;&#x000A;NumTxAnts = TxNumElementsY * TxNumElementsZ;&#x000D;&#x000A;if TxArrayStructure == 0&#x000D;&#x000A;&#x0009;TxElementToUserMap = [1];&#x000D;&#x000A;&#x0009;TxBeamWeightsBusWidth = 16;&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;TxElementToUserMap = zeros(NumTxAnts, 1);&#x000D;&#x000A;%&#x0009;NOTICE: when subarray is enabled, ElementToUserMap needs set carefully&#x000D;&#x000A;&#x0009;TxElementToUserMap = [ones(16,1); 2*ones(16,1)];&#x000D;&#x000A;&#x0009;TxBeamWeightsBusWidth = 1;&#x000D;&#x000A;end&#x000D;&#x000A;% ------------------------------ Rx Antenna Topology ------------------------------&#x000D;&#x000A;% UPA is the assumption&#x000D;&#x000A;NumRxAnts = RxNumElementsY * RxNumElementsZ;&#x000D;&#x000A;if RxArrayStructure == 0&#x000D;&#x000A;&#x0009;RxElementToUserMap = [1];&#x000D;&#x000A;&#x0009;RxBeamWeightsBusWidth = NumRxRFChains;&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;RxElementToUserMap = zeros(NumRxAnts, 1);&#x000D;&#x000A;%&#x0009;NOTICE: when subarray is enabled, ElementToUserMap needs set carefully&#x000D;&#x000A;&#x0009;RxElementToUserMap = [ones(16,1); 2*ones(16,1)];&#x000D;&#x000A;&#x0009;RxBeamWeightsBusWidth = 1;&#x000D;&#x000A;end&#x000D;&#x000A;% ------------------------------ Other System Configurations ------------------------------&#x000D;&#x000A;fs = 30.72e6 * 5 * 2^(OversamplingOption);&#x000D;&#x000A;NumOfInterestedPorts = (AP_Layer_Config &gt; 3) + 1;&#x000D;&#x000A;if TransmissionMode == 0 % if diversity is selected, &#x000D;&#x000A;&#x0009;NumOfInterestedPorts = 1;&#x000D;&#x000A;end&#x000D;&#x000A;% ------------------------------ SNR configuration ------------------------------&#x000D;&#x000A;% the first &quot;10&quot; means 10dBm set by default in the design&#x000D;&#x000A;NormalizationOfCh = 10*log10(NumTxAnts);&#x000D;&#x000A;BFGain_Expected = 10*log10(NumTxAnts*NumRxAnts);&#x000D;&#x000A;NDensity = 10 - 10*log10(1200*75e3) - (SNR - BFGain_Expected - NormalizationOfCh);&#x000D;&#x000A;% ------------------------------------------------------------------------------------------&#x000D;&#x000A;% The TX/RX sweeping beams design are very important&#x000D;&#x000A;% It&apos;s recommended that they are predefined coincident with channel&apos;s AoA/ZoA/AoD/ZoD for reasonalbe simulation results&#x000D;&#x000A;% Please refer to the workspace Notes to find the way to correctly predefine TX/RS sweeping beams, as well as channel&apos;s AoA/ZoA/AoD/ZoD&#x000D;&#x000A;% ------------------------------ Tx Sweeping Beams Design ------------------------------&#x000D;&#x000A;NumOfTxBeams = 7 * (2^BRS_Configuration) * NumBRSPorts;&#x000D;&#x000A;TxAzimuthOfAvailableBeams = [315, 330, 345, 0, 15, 30, 45, 315, 330, 345, 0, 15, 30, 45];&#x000D;&#x000A;TxZenithOfAvailableBeams = [75*ones(1, 7), 105*ones(1,7)];&#x000D;&#x000A;% ------------------------------ Rx Beams Design ------------------------------&#x000D;&#x000A;NumOfRxBeams = 1;&#x000D;&#x000A;if NumOfRxBeams == 2&#x000D;&#x000A;&#x0009;RxZenithOfAvailableBeams = [90, 90];&#x000D;&#x000A;&#x0009;RxAzimuthOfAvailableBeams = [30, 330];&#x000D;&#x000A;elseif NumOfRxBeams == 1&#x000D;&#x000A;&#x0009;RxZenithOfAvailableBeams = [90];&#x000D;&#x000A;&#x0009;RxAzimuthOfAvailableBeams = [30];&#x000D;&#x000A;end&#x000D;&#x000A;StartSubframeIgnored = max(BSI_ReportDelay, BI_Rx_Delay) + (NumOfRxBeams/NumRxRFChains - 1)*25 + SubframeIgnored;&#x000D;&#x000A;% ------------------------------ Number of Channel Paths Information ------------------------------&#x000D;&#x000A;ClusterDelay = [0]; % SISO Case&#x000D;&#x000A;ClusterPowerindB = [0];&#x000D;&#x000A;%PathDelay = [0; 0]; % MIMO Case&#x000D;&#x000A;NumClusters = numel(ClusterDelay);&#x000D;&#x000A;if NumClusters == 2&#x000D;&#x000A;&#x0009;% Arrival&#x000D;&#x000A;&#x0009;ClusterAoA = [30, 330];&#x000D;&#x000A;&#x0009;ClusterZoA = [90, 90];&#x000D;&#x000A;&#x0009;% Departure&#x000D;&#x000A;&#x0009;ClusterAoD = [315, 45];&#x000D;&#x000A;&#x0009;ClusterZoD = [75, 105];&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;% Arrival&#x000D;&#x000A;&#x0009;ClusterAoA = [30];&#x000D;&#x000A;&#x0009;ClusterZoA = [90];&#x000D;&#x000A;&#x0009;% Departure&#x000D;&#x000A;&#x0009;ClusterAoD = [315];&#x000D;&#x000A;&#x0009;ClusterZoD = [75];&#x000D;&#x000A;end&#x000D;&#x000A;% ------------------------------ Additional Antenna TX/RX Array Configuration ------------------------------&#x000D;&#x000A;if TxArray_Configuration == 2&#x000D;&#x000A;&#x0009;TxArray_RotationAroundY = -90;&#x000D;&#x000A;&#x0009;RxArray_RotationAroundY = -90;&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;TxArray_RotationAroundY = 0;&#x000D;&#x000A;&#x0009;RxArray_RotationAroundY = 0;&#x000D;&#x000A;end&#x000D;&#x000A;TxDx = 0.5; TxDy = 0.5; TxDz = 0.5; % antenna spacing in x/y/z-axis direction in Tx&#x000D;&#x000A;% channel settings&#x000D;&#x000A;%TxPosition_X = zeros(NumTxAnts,1); % antenna position coordinate in x-axis in Tx&#x000D;&#x000A;%TxPosition_Y = reshape(repmat(TxDy*[0:TxNumElementsY-1]&apos;,TxNumElementsZ,1),[],1); % antenna position coordinate in y-axis in Tx&#x000D;&#x000A;%TxPosition_Z = kron(TxDz*[0:TxNumElementsZ-1]&apos;,ones(TxNumElementsY,1)); % antenna position coordinate in z-axis in Tx&#x000D;&#x000A;%TxBearingAngle = zeros(size(TxPosition_X));&#x000D;&#x000A;%TxDowntiltAngle = zeros(size(TxPosition_X));&#x000D;&#x000A;%TxSlantAngle = zeros(size(TxPosition_X));&#x000D;&#x000A;%TxPolarizationSlantAngle = zeros(1, NumTxAnts);&#x000D;&#x000A;&#x000D;&#x000A;NumOfRxAnty = RxNumElementsY;&#x000D;&#x000A;NumOfRxAntz = RxNumElementsZ;&#x000D;&#x000A;RxDx = 0.5; RxDy = 0.5; RxDz = 0.5; % antenna spacing in x/y/z-axis direction in Rx&#x000D;&#x000A;%RxPosition_X = zeros(NumRxAnts,1); % antenna position coordinate in x-axis in Rx&#x000D;&#x000A;%RxPosition_Y = reshape(repmat(RxDy*[0:NumOfRxAnty-1]&apos;,NumOfRxAntz,1),[],1); % antenna position coordinate in y-axis in Rx&#x000D;&#x000A;%RxPosition_Z = kron(RxDz*[0:NumOfRxAntz-1]&apos;,ones(NumOfRxAnty,1)); % antenna position coordinate in y-axis in Rx&#x000D;&#x000A;%RxBearingAngle = zeros(1,NumRxAnts);&#x000D;&#x000A;%RxDowntiltAngle = zeros(1,NumRxAnts);&#x000D;&#x000A;%RxSlantAngle = zeros(1,NumRxAnts);&#x000D;&#x000A;%RxPolarizationSlantAngle = zeros(1,NumRxAnts);&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;</Text>
