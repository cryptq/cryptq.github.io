<DataEntry>persistent NumErrorBits;&#x000D;&#x000A;persistent NumBits;&#x000D;&#x000A;if(isempty(NumErrorBits))&#x000D;&#x000A;&#x0009;NumErrorBits = 0;&#x000D;&#x000A;end&#x000D;&#x000A;if(isempty(NumBits))&#x000D;&#x000A;&#x0009;NumBits = 0;&#x000D;&#x000A;end&#x000D;&#x000A;if ((size(REF_Mtx,1)~=0)&amp;&amp;(size(RX_Mtx,1)~=0)&amp;&amp;(size(REF_Mtx,1)==size(RX_Mtx,1)))&#x000D;&#x000A;&#x0009;NumErrorBits = NumErrorBits + sum(abs(double(REF_Mtx) - (1 - double(RX_Mtx))/2));&#x000D;&#x000A;&#x0009;NumBits = NumBits + size(RX_Mtx,1);&#x000D;&#x000A;end&#x000D;&#x000A;if NumBits~=0&#x000D;&#x000A;&#x0009;BER = NumErrorBits/NumBits;&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;BER = 1;&#x000D;&#x000A;end&#x000D;&#x000A;</DataEntry>
