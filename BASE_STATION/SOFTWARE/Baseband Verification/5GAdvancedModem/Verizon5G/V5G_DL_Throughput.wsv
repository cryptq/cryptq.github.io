<Item XName="EquationText" Type="PartParam">
<DataEntry>if (Num_xPDSCH_REs ~= 0) &amp;&amp; (numel(CIR_xPDSCH1)~=0)&#x000D;&#x000A;&#x0009;if DiversityOption == 0&#x000D;&#x000A;&#x0009;&#x0009;metric = mean(abs(CIR_xPDSCH1).^2 - abs(CIR_xPDSCH2).^2);&#x000D;&#x000A;&#x0009;&#x0009;if metric &gt; 0&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;output_CIR_xPDSCH = CIR_xPDSCH1;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;output_RX_xPDSCH = RX_xPDSCH1;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;Index_Sel_tmp = 1;&#x000D;&#x000A;&#x0009;&#x0009;else&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;output_CIR_xPDSCH = CIR_xPDSCH2;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;output_RX_xPDSCH = RX_xPDSCH2;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;Index_Sel_tmp = 2;&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;elseif DiversityOption == 1&#x000D;&#x000A;&#x0009;&#x0009;output_CIR_xPDSCH = CIR_xPDSCH1;&#x000D;&#x000A;&#x0009;&#x0009;output_RX_xPDSCH = RX_xPDSCH1;&#x000D;&#x000A;&#x0009;&#x0009;Index_Sel_tmp = 1;&#x000D;&#x000A;&#x0009;elseif DiversityOption == 2&#x000D;&#x000A;&#x0009;&#x0009;output_CIR_xPDSCH = CIR_xPDSCH2;&#x000D;&#x000A;&#x0009;&#x0009;output_RX_xPDSCH = RX_xPDSCH2;&#x000D;&#x000A;&#x0009;&#x0009;Index_Sel_tmp = 2;&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;output_RX_xPDSCH = RX_xPDSCH1;&#x000D;&#x000A;&#x0009;output_CIR_xPDSCH = CIR_xPDSCH1;&#x000D;&#x000A;&#x0009;Index_Sel_tmp = 1;&#x000D;&#x000A;end&#x000D;&#x000A;Index_Sel = Index_Sel_tmp;</DataEntry>
<Description>Equation Text to Parse, edited in the equation set</Description>
<DocSymbol />
<IsSettable><T>Bool</T><D>0</D></IsSettable>
<Range />
<RunTimeTunable><T>Bool</T><D>0</D></RunTimeTunable>
