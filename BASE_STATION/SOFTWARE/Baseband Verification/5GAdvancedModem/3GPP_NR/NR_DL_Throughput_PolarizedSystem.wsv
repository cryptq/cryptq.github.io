<Validate><T>Int</T><D>11</D></Validate></Item>
<Item XName="SearchSpaceType" Type="PartParam">
<DataEntry>[0]</DataEntry>
<Description>search space type. 0: UE_specific; 1: Common</Description>
<HideCondition>PDCCH_Enable == 0</HideCondition>
