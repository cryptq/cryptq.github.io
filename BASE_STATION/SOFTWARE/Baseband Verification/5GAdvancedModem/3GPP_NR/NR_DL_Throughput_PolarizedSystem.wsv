<Item XName="EquationText" Type="PartParam">
<DataEntry>persistent NumErrorBits;&#x000D;&#x000A;persistent NumBits;&#x000D;&#x000A;persistent ctSlots;&#x000D;&#x000A;&#x000D;&#x000A;if (isempty(ctSlots))&#x000D;&#x000A;&#x0009;ctSlots = 0;&#x000D;&#x000A;elseif (ctSlots &lt; (NumSlotsMuted + SlotIgnored))&#x000D;&#x000A;&#x0009;ctSlots = ctSlots + 1;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;if(isempty(NumErrorBits))&#x000D;&#x000A;&#x0009;NumErrorBits = 0;&#x000D;&#x000A;end&#x000D;&#x000A;if(isempty(NumBits))&#x000D;&#x000A;&#x0009;NumBits = 0;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if ((ctSlots == (NumSlotsMuted + SlotIgnored))&amp;&amp;(size(REF_Mtx,1)~=0)&amp;&amp;(size(RX_Mtx,1)~=0)&amp;&amp;(size(REF_Mtx,1)==size(RX_Mtx,1)))&#x000D;&#x000A;&#x0009;NumErrorBits = NumErrorBits + sum(abs(double(REF_Mtx) - (1 - double(RX_Mtx))/2));&#x000D;&#x000A;&#x0009;NumBits = NumBits + size(RX_Mtx,1);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if NumBits~=0&#x000D;&#x000A;&#x0009;BER = NumErrorBits/NumBits;&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;BER = 1;&#x000D;&#x000A;end&#x000D;&#x000A;</DataEntry>
<Description>Equation Text to Parse, edited in the equation set</Description>
