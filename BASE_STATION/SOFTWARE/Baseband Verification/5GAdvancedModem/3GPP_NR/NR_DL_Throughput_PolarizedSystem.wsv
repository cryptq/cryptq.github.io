<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PDSCH_PTRS_FrequencyDensity" Type="PartParam">
<DataEntry>[0]</DataEntry>
<Description>set the Frequency Density (K_PTRS) for PDSCH PTRS signal. [0: 2 RBs; 1: 4 RBs]</Description>
<HideCondition>PDSCH_Enable==0 || PTRS_Enable ==0</HideCondition>
