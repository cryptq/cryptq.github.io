<Direction><T>Int</T><D>1</D></Direction>
<NetLabel>PTRS_Selected(1:BasebandDataWidth)</NetLabel>
<SchObject>Connect7</SchObject></Item>
<Item XName="P1" Type="PartPin">
<Direction><T>Int</T><D>0</D></Direction>
<IsMultiport><T>Bool</T><D>1</D></IsMultiport>
<PartID>ChannelEstimator</PartID>
<PinName>PTRS_PDSCH_Rx</PinName>
<SchObject>Part44</SchObject>
<TermNum>3</TermNum>
<Item XName="Subterminals" Type="SerItem">
<Item XName="T1" Type="SubTerm">
<MappedSchObject>Connect7</MappedSchObject>
<NetName>PTRS_Selected(1)</NetName></Item>
<Item XName="T2" Type="SubTerm">
<MappedSchObject>Connect7</MappedSchObject>
<NetName>PTRS_Selected(2)</NetName></Item></Item></Item></Item></Item>
<Item XName="Equations" Type="Equation">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>%%%%%%%%%%%%%%%%%BandWidth&amp;FR CarrierNumRBs&#x000D;&#x000A;if (FCarrierTx &gt;= 450e6 &amp;&amp; FCarrierTx &lt;= 6e9)&#x000D;&#x000A;&#x0009;FrequencyRange = 0; %FR1&#x000D;&#x000A;elseif (FCarrierTx &gt;= 24.25e9 &amp;&amp; FCarrierTx &lt;= 52.6e9)&#x000D;&#x000A;&#x0009;FrequencyRange = 1; %FR2&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;error(&apos;FCarrierTx should be in [450MHz, 6000MHz] for FR1 or [24250MHz, 52600MHz] for FR2.&apos;);&#x000D;&#x000A;end;&#x000D;&#x000A;&#x000D;&#x000A;if FrequencyRange == 0&#x000D;&#x000A;&#x0009;if (FCarrierRx &lt; 450e6 || FCarrierRx &gt; 6e9) &#x000D;&#x000A;&#x0009;&#x0009;error(&apos;FCarrierRx should be in the range of [450MHz, 6000MHz] for FR1&apos;);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;if (FCarrierRx &lt; 24.25e9 || FCarrierRx &gt; 52.6e9) &#x000D;&#x000A;&#x0009;&#x0009;error(&apos;FCarrierRx should be in the range of [24250MHz, 52600MHz] for FR2&apos;);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if (FrequencyRange==0)&#x000D;&#x000A;&#x0009;if(Numerology &gt;2)&#x000D;&#x000A;&#x0009;&#x0009;error(&apos;Numerology should not be more than 2(60kHz) in FR1&apos;);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x0009;switch Numerology&#x000D;&#x000A;&#x0009;case 0&#x000D;&#x000A;&#x0009;&#x0009;if (Bandwidth &gt; 7)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;error(&apos;Bandwidth should not be more than 50MHz for Numerolgoy 0(15kHz) in FR1&apos;);&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;case 1&#x000D;&#x000A;&#x0009;&#x0009;if (Bandwidth &gt; 12)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;error(&apos;Bandwidth should not be more than 100MHz for Numerolgoy 1(30kHz) in FR1&apos;);&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;case 2&#x000D;&#x000A;&#x0009;&#x0009;if (Bandwidth &gt; 12)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;error(&apos;Bandwidth should not be more than 100MHz for Numerolgoy 2(60kHz) in FR1&apos;);&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;if (Bandwidth &lt; 1)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;error(&apos;Bandwidth should not be less than 10MHz for Numerolgoy 2(60kHz) in FR1&apos;);&#x000D;&#x000A;&#x0009;&#x0009;end&#x0009;&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;if (Numerology &lt;2)&#x000D;&#x000A;&#x0009;&#x0009;error(&apos;Numerology should not be less than 2(60kHz) in FR2&apos;);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;if (Bandwidth ~= 7 &amp;&amp; Bandwidth &lt; 12)&#x000D;&#x000A;&#x0009;&#x0009;error(&apos;Bandwidth should be 50MHz, 100MHz, 200MHz or 400MHz in FR2&apos;);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;if (Bandwidth == 14 &amp;&amp; Numerology ==2)&#x000D;&#x000A;&#x0009;&#x0009;error(&apos;Bandwidth should be less than 400MHz for Numerolgoy 2(60kHz) in FR2&apos;);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x000D;&#x000A; &#x000D;&#x000A;&#x000D;&#x000A;FR1NumRBsTable=[25,52,79,106,133,160,216,270,0,0,0,0,0;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;11,24,38,51,65,78,106,133,162,189,217,245,273;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;0,11,18,24,31,38,51,65,79,93,107,121,135];&#x000D;&#x000A;FR2NumRBsTable=[66,132,264,0;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;32,66,132,264;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;17,34,69,138];&#x000D;&#x000A;&#x000D;&#x000A;t_SSB_Numerology = SSB_Numerology;&#x000D;&#x000A;%if SSB_Numerology &gt; 1&#x000D;&#x000A;%&#x0009;t_SSB_Numerology = SSB_Numerology + 1;&#x000D;&#x000A;%end&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;if(FrequencyRange ==0)&#x000D;&#x000A;&#x0009;CarrierNumRBs = FR1NumRBsTable(Numerology+1,Bandwidth+1);&#x000D;&#x000A;&#x0009;SSB_CarrierNumRBs = FR1NumRBsTable(t_SSB_Numerology+1,Bandwidth+1);&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;if(Bandwidth&lt;10)&#x000D;&#x000A;&#x0009;&#x0009;NumRBsIdx = 1;&#x000D;&#x000A;&#x0009;else&#x000D;&#x000A;&#x0009;&#x0009;NumRBsIdx = Bandwidth-10;&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x0009;CarrierNumRBs = FR2NumRBsTable(Numerology-1,NumRBsIdx);&#x000D;&#x000A;&#x0009;SSB_CarrierNumRBs = FR2NumRBsTable(t_SSB_Numerology-1,NumRBsIdx);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;if Numerology == t_SSB_Numerology&#x000D;&#x000A;&#x0009;if CarrierNumRBs ~= SSB_CarrierNumRBs&#x000D;&#x000A;&#x0009;&#x0009;error(&apos;The CarrierNumRBs should be the same as SSB_CarrierNumRBs because they have the same Numerology.&apos;);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x0009;&#x000D;&#x000A;&#x0009;if Numerology_k0 ~= SSB_Numerology_k0&#x000D;&#x000A;&#x0009;&#x0009;error(&apos;The Numerology_k0 should be the same as SSB_Numerology_k0 because they have the same Numerology.&apos;);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;if SyncFilter_Enable == 0&#x000D;&#x000A;&#x0009;&#x0009;error(&apos; SyncFilter_Enable should be Yes because Numerology is different from SSB_Numerology.&apos;);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;Numerology_all = unique([Numerology, t_SSB_Numerology], &apos;stable&apos;);&#x000D;&#x000A;CarrierNumRBs_all = unique([CarrierNumRBs, SSB_CarrierNumRBs], &apos;stable&apos;);&#x000D;&#x000A;SampleRate = 2.^ceil(log2(CarrierNumRBs_all*12))*2^(OversamplingOption)*15e3.*2.^(Numerology_all);&#x000D;&#x000A;MaxSampleRate = max(SampleRate);&#x000D;&#x000A;t_OversamplingOption = OversamplingOption + log2(MaxSampleRate./SampleRate);&#x000D;&#x000A;&#x000D;&#x000A;if Numerology == t_SSB_Numerology&#x000D;&#x000A;&#x0009;uOversamplingOption = [t_OversamplingOption t_OversamplingOption];&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;uOversamplingOption = t_OversamplingOption;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;SamplingRate = MaxSampleRate;&#x000D;&#x000A;&#x000D;&#x000A;CC_Bandwidth = CarrierNumRBs*12*15e3*2^Numerology;&#x000D;&#x000A;FFTSize = round(SamplingRate / (15000 * 2^Numerology));&#x000D;&#x000A;&#x000D;&#x000A;switch(Numerology)&#x000D;&#x000A;case 0 &#x000D;&#x000A;&#x0009;SCS = 15;&#x000D;&#x000A;case 1 &#x000D;&#x000A;&#x0009;SCS = 30;&#x000D;&#x000A;case 2 &#x000D;&#x000A;&#x0009;SCS = 60;&#x000D;&#x000A;case 3 &#x000D;&#x000A;&#x0009;SCS = 120;&#x000D;&#x000A;case 4 &#x000D;&#x000A;&#x0009;SCS = 240;&#x000D;&#x000A;otherwise&#x000D;&#x000A;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;postinfo([&apos;The SamplingRate is &apos; num2str(SamplingRate) &apos; Hz, the bandwidth of CC is &apos; num2str(CC_Bandwidth) &apos; Hz and the FFTSize is &apos; num2str(FFTSize) &apos; for Numerology &apos; num2str(Numerology) &apos; (&apos; num2str(SCS) &apos;kHz)&apos;]);&#x000D;&#x000A;&#x000D;&#x000A;CellID_Group = floor(CellID/3);&#x000D;&#x000A;CellID_Sector = mod(CellID, 3);&#x000D;&#x000A;&#x000D;&#x000A;if SSB_Enable == 0&#x000D;&#x000A;&#x0009;error(&apos;SSB_Enable must be YES.&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if PDSCH_Enable == 0&#x000D;&#x000A;&#x0009;error(&apos;PDSCH_Enable must be YES.&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if log2(FFTSize) - floor(log2(FFTSize)) ~= 0 %not integer&#x000D;&#x000A;&#x0009;error(&apos;SamplingRate is not valid. (SamplingRate / Subcarrier Spacing) should be integral exponent of 2.&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if NumBWPs ~= 1&#x000D;&#x000A;&#x0009;error(&apos;The receiver only support one BWP. &apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if NumBeamTrainingRounds &lt; 0&#x000D;&#x000A;&#x0009;error(&apos;NumBeamTrainingRounds should be greater than 0&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if length(BeamTrainingRxRFChainsList) &gt; NumRxRFChains&#x000D;&#x000A;&#x0009;error(&apos;NumBeamTrainingRounds should have NumRxRFChains elements.&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;for i = 1:length(BeamTrainingRxRFChainsList)&#x000D;&#x000A;&#x0009;if BeamTrainingRxRFChainsList(i) &lt; 0 || (BeamTrainingRxRFChainsList(i) &gt; (NumRxRFChains - 1))&#x000D;&#x000A;&#x0009;&#x0009;error(&apos;BeamTrainingRxRFChainsList should be in the range of [0 ~ NumRxRFChains-1].&apos;);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;%Range check&#x000D;&#x000A;if (length(PDSCH_DMRS_PortList)&lt;1)&#x000D;&#x000A;error(&apos;PDSCH_DMRS_PortList should be empty!!&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if (length(PDSCH_DMRS_PortList) &gt; 4)&#x000D;&#x000A;error(&apos;Ports in PDSCH_DMRS_PortList should no more than 4!!&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;%parsing BWP ports&#x000D;&#x000A;PDSCH_PortNum = zeros(1, NumBWPs);&#x000D;&#x000A;PDSCH_PortList = cell(1, NumBWPs);&#x000D;&#x000A;PDCCH_PortNum = zeros(1, NumBWPs);&#x000D;&#x000A;PDCCH_PortList = cell(1, NumBWPs);&#x000D;&#x000A;off = 0;&#x000D;&#x000A;for i = 1 : NumBWPs&#x000D;&#x000A;&#x0009;portNum = PDSCH_DMRS_NumPorts(mod(i - 1, length(PDSCH_DMRS_NumPorts)) + 1);&#x000D;&#x000A;&#x0009;schList = [];&#x000D;&#x000A;&#x0009;cchList = [];&#x000D;&#x000A;&#x0009;for j = 1 : portNum&#x000D;&#x000A;&#x0009;&#x0009;port = PDSCH_DMRS_PortList(mod(off + j - 1, length(PDSCH_DMRS_PortList)) + 1);&#x000D;&#x000A;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;if (port &gt;= 1000 &amp;&amp; port &lt;= 1011)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;schList = [schList, port];&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x0009;&#x000D;&#x000A;&#x0009;if (PDCCH_Enable)&#x000D;&#x000A;&#x0009;&#x0009;cchList = [cchList, 2000];&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x0009;&#x000D;&#x000A;&#x0009;PDSCH_PortList{i} = {unique(schList, &apos;stable&apos;)};&#x000D;&#x000A;&#x0009;PDCCH_PortList{i} = {unique(cchList, &apos;stable&apos;)};&#x000D;&#x000A;&#x0009;&#x000D;&#x000A;&#x0009;PDSCH_PortNum(i) = length(unique(schList));&#x000D;&#x000A;&#x0009;PDCCH_PortNum(i) = length(unique(cchList));&#x000D;&#x000A;&#x0009;&#x000D;&#x000A;&#x0009;local_ports = PDSCH_PortNum(i) + PDCCH_PortNum(i);&#x000D;&#x000A;&#x000D;&#x000A;%&#x0009;if local_ports ~= portNum&#x000D;&#x000A;%&#x0009;&#x0009;error(&apos;For a BWP, all ports should be unique.&apos;);&#x000D;&#x000A;%&#x0009;end&#x000D;&#x000A;%&#x0009;&#x000D;&#x000A;%&#x0009;%Check port list&#x000D;&#x000A;%&#x0009;if PDCCH_Enable == 1&#x000D;&#x000A;%&#x0009;&#x0009;if PDCCH_PortNum(i) ~= 1&#x000D;&#x000A;%&#x0009;&#x0009;&#x0009;error(&apos;When PDCCH is enabled, PDSCH_DMRS_PortList should have port 2000 for each BWP.&apos;);&#x000D;&#x000A;%&#x0009;&#x0009;end&#x000D;&#x000A;%&#x0009;end&#x000D;&#x000A;&#x0009;&#x000D;&#x000A;&#x0009;if PDSCH_Enable == 1&#x000D;&#x000A;&#x0009;&#x0009;if PDSCH_PortNum(i) &lt; 1 || PDSCH_PortNum(i) &gt; 12&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;error(&apos;When PDSCH is enabled, ports for PDSCH in PDSCH_DMRS_PortList should be 1000~1011.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x0009;&#x000D;&#x000A;&#x0009;off = off + portNum;&#x000D;&#x000A;end&#x000D;&#x000A;NumLayers = PDSCH_PortNum;&#x000D;&#x000A;&#x000D;&#x000A;local_PDSCH_DMRS_PortList = [];&#x000D;&#x000A;local_PDSCH_PortList = [];&#x000D;&#x000A;for i = 1: NumBWPs&#x000D;&#x000A;&#x0009;local_PDSCH_DMRS_PortList = [local_PDSCH_DMRS_PortList, cell2mat(PDSCH_PortList{i}), cell2mat(PDCCH_PortList{i})];&#x000D;&#x000A;&#x0009;local_PDSCH_PortList = [local_PDSCH_PortList, cell2mat(PDSCH_PortList{i})];&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if length(BWP_RBOffset) ~= length(BWP_NumRBs)&#x000D;&#x000A;error(&apos;The element number in BWP_RBOffset and DL_BWP_NumRBs should be the same.&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if (length(BWP_RBOffset) ~= NumBWPs&amp;&amp;length(BWP_RBOffset) ~= 1)&#x000D;&#x000A;error(&apos;The element number in BWP_RBOffset should be equal to 1 or NumBWPs.&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;for i=1:length(BWP_NumRBs)&#x000D;&#x000A;if(BWP_NumRBs(i) &lt; 20 || BWP_NumRBs(i) &gt;275)&#x000D;&#x000A;error(&apos;BWP_NumRBs should be in range [20,275]&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;for i=1:length(BWP_NumRBs)&#x000D;&#x000A;if(BWP_RBOffset(i)+BWP_NumRBs(i) &gt; CarrierNumRBs)&#x000D;&#x000A;error(&apos;BWP is out of CC, please check BWP_RBOffset and BWP_NumRBs!!&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;if (length(PDSCH_RBOffset) ~= length(PDSCH_NumRBs))&#x000D;&#x000A;error(&apos;The element number in PDSCH_RBOffset and PDSCH_NumRBs should be the same.&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;for i = 1:length(PDSCH_RBOffset)&#x000D;&#x000A;&#x0009;if (PDSCH_RBOffset(i) + PDSCH_NumRBs(i)) &gt; BWP_NumRBs&#x000D;&#x000A;&#x0009;error(&apos;PDSCH %d is out of BWP. Please check PDSCH_RBOffset and PDSCH_NumRBs.&apos;, i);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if (length(PDSCH_StartOFDMSym) ~= length(PDSCH_NumOFDMSyms))&#x000D;&#x000A;error(&apos;The element number in PDSCH_StartOFDMSym and PDSCH_NumOFDMSyms should be the same.&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;for i = 1:length(PDSCH_StartOFDMSym)&#x000D;&#x000A;&#x0009;if (PDSCH_StartOFDMSym(i) + PDSCH_NumOFDMSyms(i)) &gt; 14&#x000D;&#x000A;&#x0009;error(&apos;PDSCH %d is out of slot. Please check PDSCH_StartOFDMSym and PDSCH_NumOFDMSyms.&apos;, i);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if (length(PDSCH_StartOFDMSym) ~= length(PDSCH_DMRS_Length))&#x000D;&#x000A;error(&apos;The element number in PDSCH_StartOFDMSym and PDSCH_DMRS_Length should be the same.&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if (length(PDSCH_StartOFDMSym) ~= length(PDSCH_DMRS_AddPos))&#x000D;&#x000A;error(&apos;The element number in PDSCH_StartOFDMSym and PDSCH_DMRS_AddPos should be the same.&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;for i = 1:length(PDSCH_StartOFDMSym)&#x000D;&#x000A;&#x0009;if (PDSCH_DMRS_Length(i) ~= 1 &amp;&amp; PDSCH_DMRS_Length(i) ~= 2)&#x000D;&#x000A;&#x0009;&#x0009;error(&apos;PDSCH_DMRS_Length %d should be in the range of 1~2&apos;, i);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if PDSCH_MappingType == 0&#x000D;&#x000A;&#x0009;for i = 1:length(PDSCH_StartOFDMSym)&#x000D;&#x000A;&#x0009;&#x0009;DurationOFDMSym = PDSCH_StartOFDMSym(i) + PDSCH_NumOFDMSyms(i);&#x000D;&#x000A;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;if PDSCH_DMRS_TypeA_Pos(i) == 3 &#x000D;&#x000A;&#x0009;&#x0009;&#x0009;if PDSCH_DMRS_AddPos(i) == 3&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;error(&apos;For PDSCH_MappingType 0, the case PDSCH_DMRS_AddPos equal to 3 is only supported when PDSCH_DMRS_TypeA_Pos is equal to 2.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;if DurationOFDMSym == 4 || DurationOFDMSym == 3&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;error(&apos;Duration of 3 or 4 symbols is only applicable for PDSCH_DMRS_TypeA_Pos equals 2&apos;, i);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;if PDSCH_DMRS_Length(i) == 2&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;if PDSCH_DMRS_AddPos(i) &gt; 1&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;error(&apos;PDSCH_DMRS_AddPos %d should be 0 or 1&apos;, i);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;for i = 1:length(PDSCH_DMRS_AddPos)&#x000D;&#x000A;&#x0009;&#x0009;DurationOFDMSym = PDSCH_NumOFDMSyms(i);&#x000D;&#x000A;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;if PDSCH_DMRS_Length(i) == 1&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;if DurationOFDMSym == 2 || DurationOFDMSym == 4 || DurationOFDMSym ==6 || DurationOFDMSym == 7&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;if (PDSCH_DMRS_AddPos(i) &gt; 1)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;error(&apos;PDSCH_DMRS_AddPos %d should be 0 or 1 for PDSCH mapping type B.&apos;, i);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;else&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;if DurationOFDMSym ==6 || DurationOFDMSym == 7&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;if (PDSCH_DMRS_AddPos(i) &gt; 1)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;error(&apos;PDSCH_DMRS_AddPos %d should be 0 or 1 for PDSCH mapping type B.&apos;, i);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;for i=1:length(Modulation)&#x000D;&#x000A;&#x0009;if Modulation(i) == 0&#x000D;&#x000A;&#x0009;&#x0009;error(&apos;BPSK is not allowed by downlink.&apos;);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;if Payload_Config == 0 %MCS&#x000D;&#x000A;&#x0009;for i = 1:length(MCSTable)&#x000D;&#x000A;&#x0009;&#x0009;if MCSTable(i) &lt; 0 || MCSTable(i) &gt; 2&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;error(&apos;MCSTable should be select from 0: Table 5.1.3.1 - 1 | 1: Table 5.1.3.1 - 2 | 2: Table 5.1.3.1 - 3.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;%Check overlap&#x000D;&#x000A;%When mu is 15kHz or 30kHz, the SSB_RBOffset and SSB_k0 is expressed in terms of 15kHz.&#x000D;&#x000A;%When mu is 120kHz or 240kHz, the SSB_RBOffset and SSB_k0 is expressed in terms of 60kHz.&#x000D;&#x000A;mu_spacing = 1.0;&#x000D;&#x000A;if (SSB_Numerology == 1 || SSB_Numerology == 2)%30kHz or 120kHz&#x000D;&#x000A;&#x0009;mu_spacing = 0.5;&#x000D;&#x000A;elseif (SSB_Numerology == 3)%240kHz&#x000D;&#x000A;&#x0009;mu_spacing = 0.25;&#x000D;&#x000A;end&#x000D;&#x000A;&#x0009;&#x000D;&#x000A;%in terms of BWP numerology and BWP&apos;s common resource block 0&#x000D;&#x000A;%ssb&apos;s start tone relative to BWP&apos;s start tone&#x000D;&#x000A;firstTone = -CarrierNumRBs * 12 / 2;&#x000D;&#x000A;firstTone_SSB = -SSB_CarrierNumRBs * 12 / 2 * 2^(t_SSB_Numerology - Numerology);&#x000D;&#x000A;&#x000D;&#x000A;SSB_Start = (firstTone_SSB - firstTone) + ((SSB_RBOffset * 12 + SSB_k0) * mu_spacing + SSB_Numerology_k0) * 2^(t_SSB_Numerology - Numerology);&#x000D;&#x000A;SSB_End = SSB_Start + 20 * 12 * 2^(t_SSB_Numerology - Numerology) - 1;&#x000D;&#x000A;BWP_Start = BWP_RBOffset * 12 + Numerology_k0;&#x000D;&#x000A;BWP_End = BWP_Start + BWP_NumRBs * 12 - 1;&#x000D;&#x000A;%RePos1 = [SSB_Start, SSB_End, BWP_Start, BWP_End];&#x000D;&#x000A;%RePos2 = [BWP_Start, BWP_End, SSB_Start, SSB_End];&#x000D;&#x000A;if SSB_End &lt; BWP_Start&#x000D;&#x000A;&#x0009;overlap = false;&#x000D;&#x000A;elseif BWP_End &lt; SSB_Start&#x000D;&#x000A;&#x0009;overlap = false;&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;overlap = true;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if overlap &#x000D;&#x000A;&#x0009;error(&apos;SSB and BWP are not allowed to overlap in frequency domain!&apos;);&#x000D;&#x000A;end &#x000D;&#x000A;&#x000D;&#x000A;if SSB_Enable~=0 &amp;&amp; SSB_Numerology == 4&#x000D;&#x000A;&#x0009;error(&apos;SSB transmission in 240 kHz subcarriers is not supported yet&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;NumRxRFChainsData = length(unique(DataRcvRxRFChainsList));&#x000D;&#x000A;if (NumRxRFChainsData &gt; NumRxRFChains)&#x000D;&#x000A;&#x0009;error(&apos;The number of unique elements in DataRcvRxRFChainsList should not be more than NumRxRFChains &apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if DiversityOption == 0&#x000D;&#x000A;&#x0009;BasebandDataWidth = NumRxRFChainsData * 2;&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;BasebandDataWidth = NumRxRFChainsData;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if PDSCH_PortNum(1) &gt; NumRxRFChainsData&#x000D;&#x000A;&#x0009;error(&apos;The number of receiver chains in DataRcvRxRFChainsList should not be less than %d&apos;, PDSCH_PortNum(1) );&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;t_SSB_Enable= SSB_Enable;&#x000D;&#x000A;if t_SSB_Numerology ~= Numerology&#x000D;&#x000A;&#x0009;t_SSB_Enable = 0;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if SSB_Lmax == 0&#x000D;&#x000A;&#x0009;NumSSBlocks = 4;&#x000D;&#x000A;elseif SSB_Lmax == 1&#x000D;&#x000A;&#x0009;NumSSBlocks = 8;&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;NumSSBlocks = 64;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if (CarrierNumRBs*12/2)~= fix(CarrierNumRBs*12/2)&#x000D;&#x000A;FreqShift =-0.5;&#x000D;&#x000A;else&#x000D;&#x000A;FreqShift =0;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;for i=1:length(PDSCH_DMRS_NumPorts)&#x000D;&#x000A;if(PDSCH_DMRS_NumPorts&gt;4)&#x000D;&#x000A;&#x0009;NumCWs = 2;&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;NumCWs = 1;&#x000D;&#x000A;end&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if (CyclicPrefix == 0)&#x000D;&#x000A;&#x0009;SymbolPerSlot = 14;&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;SymbolPerSlot = 12;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;SlotPerFrame = 10 * 2^Numerology;&#x000D;&#x000A;&#x000D;&#x000A;SSB_Periodicity_FrameNum = 0.5 * 2^SSB_Periodicity;&#x000D;&#x000A;SlotIgnored = floor( SSB_Periodicity_FrameNum *  SlotPerFrame) * NumBeamTrainingRounds;&#x000D;&#x000A;&#x000D;&#x000A;if Numerology ~= t_SSB_Numerology&#x000D;&#x000A;&#x0009;FilterOutSSB = 1;&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;FilterOutSSB = 0;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;FilterOutSSB = 0;&#x000D;&#x000A;DC_Reserved = 0;&#x000D;&#x000A;RV_Sequence = [0,1,2,3];&#x000D;&#x000A;%debug&#x000D;&#x000A;NumFrames = 20;&#x000D;&#x000A;SSB_Period_Table = [5e-3, 10e-3, 20e-3, 40e-3, 80e-3, 160e-3 ];&#x000D;&#x000A;SSBtime = SSB_Period_Table(SSB_Periodicity + 1);&#x000D;&#x000A;SSBLen = SamplingRate * SSBtime;</Text>
<Item XName="BPMgr" Type="BPMgr">
<BPLines><T>Array_I64</T><D>1;0;</D></BPLines>
<BPStates><T>Array_I64</T><D>1;0;</D></BPStates></Item>
<Item XName="EqnBlock" Type="EqnBlock">
