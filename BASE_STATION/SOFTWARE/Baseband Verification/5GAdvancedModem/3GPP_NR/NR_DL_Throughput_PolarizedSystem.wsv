<Item XName="Note" UserName="Note" Type="Notes">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>&lt;P class=MsoNormal style=&quot;MARGIN: 0cm 0cm 0pt&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian; mso-bidi-font-family: Calibri&quot;&gt;&amp;nbsp; &lt;?xml:namespace prefix = &quot;o&quot; ns = &quot;urn:schemas-microsoft-com:office:office&quot; /&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;DIV style=&quot;BORDER-TOP: medium none; BORDER-RIGHT: medium none; BORDER-BOTTOM: windowtext 1pt solid; PADDING-BOTTOM: 1pt; PADDING-TOP: 0cm; PADDING-LEFT: 0cm; BORDER-LEFT: medium none; PADDING-RIGHT: 0cm; mso-element: para-border-div; mso-border-bottom-alt: solid windowtext .75pt&quot;&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;BORDER-TOP: medium none; BORDER-RIGHT: medium none; BORDER-BOTTOM: medium none; PADDING-BOTTOM: 0cm; TEXT-ALIGN: center; PADDING-TOP: 0cm; PADDING-LEFT: 0cm; BORDER-LEFT: medium none; MARGIN: 0cm 0cm 0pt; PADDING-RIGHT: 0cm; mso-border-bottom-alt: solid windowtext .75pt; mso-padding-alt: 0cm 0cm 1.0pt 0cm&quot; align=center&gt;&lt;B&gt;&lt;SPAN style=&apos;FONT-SIZE: 18pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif; mso-fareast-font-family: DengXian&apos;&gt;NR DL Throughput (Polarized System)&lt;/SPAN&gt;&lt;/B&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif; mso-fareast-font-family: DengXian&apos;&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&lt;/DIV&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: center; MARGIN: 0cm 0cm 0pt&quot; align=center&gt;&lt;I&gt;&lt;SPAN style=&apos;FONT-SIZE: 10pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif; mso-fareast-font-family: DengXian; mso-bidi-font-size: 12.0pt&apos;&gt;Keysight Technologies SystemVue Example&amp;nbsp;Workspace&lt;/SPAN&gt;&lt;/I&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian; mso-bidi-font-family: Calibri&quot;&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: center; MARGIN: 0cm 0cm 0pt&quot; align=center&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian; mso-bidi-font-family: Calibri&quot;&gt;&amp;nbsp;&lt;/SPAN&gt;&lt;I&gt;&lt;SPAN style=&quot;mso-bidi-font-family: Calibri; mso-fareast-font-family: DengXian; mso-bidi-font-size: 12.0pt; mso-ascii-font-family: Calibri; mso-hansi-font-family: Calibri&quot;&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/I&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0cm 0cm 0pt&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian; mso-bidi-font-family: Calibri&quot;&gt;This&amp;nbsp;workspace showcases New Radio polarized downlink system working in Frequency Range&amp;nbsp;1 (FR1) and Frequency Range (FR2). Upon the designs, throughput and BER can be measured.&amp;nbsp;Besides, antenna element radiation&amp;nbsp;pattern files can be imported into the design to refine the evaluation.&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0cm 0cm 0pt&quot;&gt;&lt;SPAN style=&apos;mso-bidi-font-family: Calibri; mso-fareast-font-family: &quot;Times New Roman&quot;; mso-ascii-font-family: Calibri; mso-hansi-font-family: Calibri&apos;&gt;&lt;o:p&gt;&lt;FONT face=Calibri&gt;&amp;nbsp;&lt;/FONT&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0cm 0cm 0pt&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian; mso-bidi-font-family: Calibri&quot;&gt;Three designs are included in this workspace: &lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;UL style=&quot;MARGIN-TOP: 0cm&quot; type=disc&gt;&#x000D;&#x000A;&lt;LI class=MsoNormal style=&quot;MARGIN: 0cm 0cm 0pt; mso-list: l0 level1 lfo1; tab-stops: list 36.0pt&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian; mso-bidi-font-family: Calibri&quot;&gt;MIMO 2x2 BF Polarized Case&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/LI&gt;&#x000D;&#x000A;&lt;LI class=MsoNormal style=&quot;MARGIN: 0cm 0cm 0pt; mso-list: l0 level1 lfo1; tab-stops: list 36.0pt&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian; mso-bidi-font-family: Calibri&quot;&gt;SISO BF MRC Polarized Diversity Case&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/LI&gt;&#x000D;&#x000A;&lt;LI class=MsoNormal style=&quot;MARGIN: 0cm 0cm 0pt; mso-list: l0 level1 lfo1; tab-stops: list 36.0pt&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian; mso-bidi-font-family: Calibri&quot;&gt;MIMO 2x2 BF Polarized Diversity Case&lt;/SPAN&gt;&lt;SPAN style=&quot;mso-bidi-font-family: Calibri; mso-fareast-font-family: DengXian; mso-bidi-font-size: 10.0pt; mso-ascii-font-family: Calibri; mso-hansi-font-family: Calibri&quot;&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/LI&gt;&lt;/UL&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0cm 0cm 0pt&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian; mso-bidi-font-family: Calibri&quot;&gt;&lt;o:p&gt;&amp;nbsp;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0cm 0cm 0pt&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian; mso-bidi-font-family: Calibri&quot;&gt;In each schematic, green part handles signals for the first polarization and Pink part handles signals for the second polarization. Information pertinent to polarization is included in MIMO_3DChannel Configuration section.&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0cm 0cm 0pt&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian; mso-bidi-font-family: Calibri&quot;&gt;&lt;o:p&gt;&amp;nbsp;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0cm 0cm 0pt&quot;&gt;&lt;SPAN lang=EN-GB style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian; mso-bidi-font-family: Arial; mso-ansi-language: EN-GB&quot;&gt;All definitions of number of RF chains, number of antenna elements in each schematic refer to the number per polarization.&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0cm 0cm 0pt&quot;&gt;&lt;SPAN lang=EN-GB style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian; mso-bidi-font-family: Arial; mso-ansi-language: EN-GB&quot;&gt;&lt;o:p&gt;&amp;nbsp;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0cm 0cm 0pt&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian; mso-bidi-font-family: Calibri&quot;&gt;Appendix about frequently used bandwidth configuration would help users configure the system easily.&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0cm 0cm 0pt&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian; mso-bidi-font-family: Calibri&quot;&gt;&lt;o:p&gt;&amp;nbsp;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0cm 0cm 0pt&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian; mso-bidi-font-family: Calibri&quot;&gt;Below are the details of these designs.&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: center; MARGIN: 0cm 0cm 0pt&quot; align=center&gt;&lt;SPAN style=&apos;FONT-SIZE: 14pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif; mso-fareast-font-family: DengXian&apos;&gt;&lt;o:p&gt;&amp;nbsp;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0cm 0cm 0pt&quot;&gt;&lt;B&gt;&lt;SPAN lang=EN-GB style=&apos;FONT-SIZE: 14pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif; mso-fareast-font-family: DengXian; mso-ansi-language: EN-GB&apos;&gt;MIMO 2x2 BF Polarized Case&lt;/SPAN&gt;&lt;/B&gt;&lt;SPAN lang=EN-GB style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian; mso-bidi-font-family: Arial; mso-ansi-language: EN-GB&quot;&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0cm 0cm 0pt&quot;&gt;&lt;SPAN lang=EN-GB style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian; mso-bidi-font-family: Arial; mso-ansi-language: EN-GB&quot;&gt;&amp;nbsp;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0cm 0cm 0pt&quot;&gt;&lt;SPAN lang=EN-GB style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian; mso-bidi-font-family: Arial; mso-ansi-language: EN-GB&quot;&gt;In this case, dual-polarized antenna arrays are deployed in both TX and RX sides. Only one channel&amp;nbsp;direction is&amp;nbsp;modelled in the 3D channel model and two streams of the MIMO transmission are transmitted in two polarizations respectively. &lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0cm 0cm 0pt&quot;&gt;&lt;SPAN lang=EN-GB style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian; mso-bidi-font-family: Arial; mso-ansi-language: EN-GB&quot;&gt;&lt;o:p&gt;&amp;nbsp;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0cm 0cm 0pt&quot;&gt;&lt;SPAN lang=EN-GB style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian; mso-bidi-font-family: Arial; mso-ansi-language: EN-GB&quot;&gt;Four RF chains are deployed in TX side. Two are for one polarization and the other two are for the other polarization. One RF in the two RFs for whichever polarization is used for data transmission and the other one is for SSB transmission.&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0cm 0cm 0pt&quot;&gt;&lt;SPAN lang=EN-GB style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian; mso-bidi-font-family: Arial; mso-ansi-language: EN-GB&quot;&gt;&lt;o:p&gt;&amp;nbsp;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0cm 0cm 0pt&quot;&gt;&lt;SPAN lang=EN-GB style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian; mso-bidi-font-family: Arial; mso-ansi-language: EN-GB&quot;&gt;Four RF chains are also deployed in RX side. Two are for one polarization and the other two are for the other polarization, just as same as the deployment in TX side. Similar, regarding two RFs in RX side for one polarization, one is for data receiving and the other one is for SSB receiving. &lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0cm 0cm 0pt&quot;&gt;&lt;SPAN lang=EN-GB style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian; mso-bidi-font-family: Arial; mso-ansi-language: EN-GB&quot;&gt;&lt;o:p&gt;&amp;nbsp;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0cm 0cm 0pt&quot;&gt;&lt;SPAN lang=EN-GB style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian; mso-bidi-font-family: Arial; mso-ansi-language: EN-GB&quot;&gt;The channel is set up with only one path and is configured to Dual Polarized mode to accommodate 2x2 MIMO transmission. &lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0cm 0cm 0pt&quot;&gt;&lt;SPAN lang=EN-GB style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian; mso-bidi-font-family: Arial; mso-ansi-language: EN-GB&quot;&gt;&lt;o:p&gt;&amp;nbsp;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0cm 0cm 0pt&quot;&gt;&lt;SPAN lang=EN-GB style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian; mso-bidi-font-family: Arial; mso-ansi-language: EN-GB&quot;&gt;&lt;o:p&gt;&amp;nbsp;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0cm 0cm 0pt&quot;&gt;&lt;B&gt;&lt;SPAN lang=EN-GB style=&apos;FONT-SIZE: 14pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif; mso-fareast-font-family: DengXian; mso-ansi-language: EN-GB&apos;&gt;SISO BF MRC Polarized Diversity Case&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/B&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0cm 0cm 0pt&quot;&gt;&lt;B&gt;&lt;SPAN lang=EN-GB style=&apos;FONT-SIZE: 14pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif; mso-fareast-font-family: DengXian; mso-ansi-language: EN-GB&apos;&gt;&lt;o:p&gt;&amp;nbsp;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/B&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0cm 0cm 0pt&quot;&gt;&lt;SPAN lang=EN-GB style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian; mso-bidi-font-family: Arial; mso-ansi-language: EN-GB&quot;&gt;In this case, dual-polarized antenna arrays are deployed in both TX and RX sides. Only one channel&amp;nbsp;direction is&amp;nbsp;modelled in the 3D channel model and the same stream is transmitted in both two polarizations.&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0cm 0cm 0pt&quot;&gt;&lt;SPAN lang=EN-GB style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian; mso-bidi-font-family: Arial; mso-ansi-language: EN-GB&quot;&gt;&lt;o:p&gt;&amp;nbsp;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0cm 0cm 0pt&quot;&gt;&lt;SPAN lang=EN-GB style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian; mso-bidi-font-family: Arial; mso-ansi-language: EN-GB&quot;&gt;The basic structure is as same as the structure used in the above case. The difference is that only one stream is transmitted in the system. In the receiver side signals from two polarizations are combined to get the only stream. The 1-layer signal is demodulated upon signals from two polarizations by MRC algorithm in the Equalizer. &lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0cm 0cm 0pt&quot;&gt;&lt;SPAN lang=EN-GB style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian; mso-bidi-font-family: Arial; mso-ansi-language: EN-GB&quot;&gt;&lt;/SPAN&gt;&amp;nbsp;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0cm 0cm 0pt&quot;&gt;&lt;SPAN lang=EN-GB style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian; mso-bidi-font-family: Arial; mso-ansi-language: EN-GB&quot;&gt;Throughput curves are obtained based on MRC, branch #1 and branch #2 respectively, where MRC outperforms receiving only on branch #1 or branch #2 by 3dB.&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0cm 0cm 0pt&quot;&gt;&lt;SPAN lang=EN-GB style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian; mso-bidi-font-family: Arial; mso-ansi-language: EN-GB&quot;&gt;&amp;nbsp;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0cm 0cm 0pt&quot;&gt;&lt;B&gt;&lt;SPAN lang=EN-GB style=&apos;FONT-SIZE: 14pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif; mso-fareast-font-family: DengXian; mso-ansi-language: EN-GB&apos;&gt;MIMO 2x2 BF Polarized Switch Diversity Case&lt;/SPAN&gt;&lt;/B&gt;&lt;SPAN lang=EN-GB style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian; mso-bidi-font-family: Arial; mso-ansi-language: EN-GB&quot;&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0cm 0cm 0pt&quot;&gt;&lt;SPAN lang=EN-GB style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian; mso-bidi-font-family: Arial; mso-ansi-language: EN-GB&quot;&gt;&lt;o:p&gt;&amp;nbsp;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0cm 0cm 0pt&quot;&gt;&lt;SPAN lang=EN-GB style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian; mso-bidi-font-family: Arial; mso-ansi-language: EN-GB&quot;&gt;In this case, two&amp;nbsp;patches equipped in RX side are used for diversity purpose. One of the two patches would be selected at&amp;nbsp;certain slots and data receiving would be based on the selected branch. &lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0cm 0cm 0pt&quot;&gt;&lt;SPAN lang=EN-GB style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian; mso-bidi-font-family: Arial; mso-ansi-language: EN-GB&quot;&gt;&lt;o:p&gt;&amp;nbsp;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0cm 0cm 0pt&quot;&gt;&lt;SPAN lang=EN-GB style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian; mso-bidi-font-family: Calibri; mso-ansi-language: EN-GB&quot;&gt;The structure in Tx side is as same as the structures used in above two designs. &lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0cm 0cm 0pt&quot;&gt;&lt;SPAN lang=EN-GB style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian; mso-bidi-font-family: Calibri; mso-ansi-language: EN-GB&quot;&gt;&lt;o:p&gt;&amp;nbsp;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0cm 0cm 0pt&quot;&gt;&lt;SPAN lang=EN-GB style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian; mso-bidi-font-family: Calibri; mso-ansi-language: EN-GB&quot;&gt;Regarding RX side, the structure in above design appears twice in current design to mimic two diversity branches. Signal from one diversity branch is selected for demodulation.&lt;/SPAN&gt;&lt;SPAN lang=EN-GB style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian; mso-bidi-font-family: Arial; mso-ansi-language: EN-GB&quot;&gt; &lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0cm 0cm 0pt&quot;&gt;&lt;SPAN lang=EN-GB style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian; mso-bidi-font-family: Arial; mso-ansi-language: EN-GB&quot;&gt;&lt;o:p&gt;&amp;nbsp;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0cm 0cm 0pt&quot;&gt;&lt;SPAN lang=EN-GB style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian; mso-bidi-font-family: Arial; mso-ansi-language: EN-GB&quot;&gt;Each patch associated with specific branch in RX side is comprised of a 2x2 dual-polarized array, which means one 2x2 array corresponds to one polarization and the other 2x2 array corresponds to the other polarization. Two streams are transmitted in two polarizations, one for each.&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0cm 0cm 0pt&quot;&gt;&lt;SPAN lang=EN-GB style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian; mso-bidi-font-family: Calibri; mso-ansi-language: EN-GB&quot;&gt;&lt;o:p&gt;&amp;nbsp;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0cm 0cm 0pt&quot;&gt;&lt;B&gt;&lt;SPAN lang=EN-GB style=&apos;FONT-SIZE: 14pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif; mso-fareast-font-family: DengXian; mso-ansi-language: EN-GB&apos;&gt;MIMO_3DChannel Configuration &lt;/SPAN&gt;&lt;/B&gt;&lt;SPAN lang=EN-GB style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian; mso-bidi-font-family: Arial; mso-ansi-language: EN-GB&quot;&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0cm 0cm 0pt&quot;&gt;&lt;SPAN lang=EN-GB style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian; mso-bidi-font-family: Calibri; mso-ansi-language: EN-GB&quot;&gt;&lt;o:p&gt;&amp;nbsp;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0cm 0cm 0pt&quot;&gt;&lt;SPAN lang=EN-GB style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian; mso-bidi-font-family: Arial; mso-ansi-language: EN-GB&quot;&gt;Signals associated with two polarizations from source are reconstructed before being connected to channel model and signals output from channel model are also reconstructed before being connected to subsequent modules. These refactoring assures signals associated with specific polarization are placed in order.&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0cm 0cm 0pt&quot;&gt;&lt;SPAN lang=EN-GB style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian; mso-bidi-font-family: Arial; mso-ansi-language: EN-GB&quot;&gt;&lt;o:p&gt;&amp;nbsp;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0cm 0cm 0pt&quot;&gt;&lt;B&gt;&lt;SPAN lang=EN-GB style=&apos;FONT-SIZE: 14pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif; mso-fareast-font-family: DengXian; mso-ansi-language: EN-GB&apos;&gt;Mechanism of Beams Scheduling&lt;/SPAN&gt;&lt;/B&gt;&lt;SPAN lang=EN-GB style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian; mso-bidi-font-family: Arial; mso-ansi-language: EN-GB&quot;&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0cm 0cm 0pt&quot;&gt;&lt;SPAN lang=EN-GB style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian; mso-bidi-font-family: Arial; mso-ansi-language: EN-GB&quot;&gt;&lt;o:p&gt;&amp;nbsp;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0cm 0cm 0pt&quot;&gt;&lt;SPAN lang=EN-GB style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian; mso-bidi-font-family: Arial; mso-ansi-language: EN-GB&quot;&gt;When there are multiple NR_DL_BeamsScheduler modules in the design, they may need to cooperate. &lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0cm 0cm 0pt&quot;&gt;&lt;SPAN lang=EN-GB style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian; mso-bidi-font-family: Arial; mso-ansi-language: EN-GB&quot;&gt;&lt;o:p&gt;&amp;nbsp;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0cm 0cm 0pt&quot;&gt;&lt;SPAN lang=EN-GB style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian; mso-bidi-font-family: Arial; mso-ansi-language: EN-GB&quot;&gt;For example, in the switch diversity case, multiple patches associated with specific branches are deployed in the RX side, each of which can be conducted to specific directions to receive signal, but in the TX side, only one patch is deployed. TX side must decide the TX transmitting direction upon the feedback from multiple diversity branches.&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0cm 0cm 0pt&quot;&gt;&lt;SPAN lang=EN-GB style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian; mso-bidi-font-family: Arial; mso-ansi-language: EN-GB&quot;&gt;&lt;o:p&gt;&amp;nbsp;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0cm 0cm 0pt&quot;&gt;&lt;SPAN lang=EN-GB style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian; mso-bidi-font-family: Arial; mso-ansi-language: EN-GB&quot;&gt;The parameters NumDiversityBranches, BranchIndex, together with input port named TxBeamsTrigger of NR_DL_BeamsScheduler module are responsible for the cooperation mechanism in diversity case. &lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0cm 0cm 0pt&quot;&gt;&lt;SPAN lang=EN-GB style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian; mso-bidi-font-family: Arial; mso-ansi-language: EN-GB&quot;&gt;&lt;o:p&gt;&amp;nbsp;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0cm 0cm 0pt&quot;&gt;&lt;SPAN lang=EN-GB style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian; mso-bidi-font-family: Arial; mso-ansi-language: EN-GB&quot;&gt;Firstly, parameter NumDiversityBranches informs each module that how many NR_DL_BeamsScheduler modules are there in the design and BranchIndex informs the index of the module. &lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0cm 0cm 0pt&quot;&gt;&lt;SPAN lang=EN-GB style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian; mso-bidi-font-family: Arial; mso-ansi-language: EN-GB&quot;&gt;&lt;o:p&gt;&amp;nbsp;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0cm 0cm 0pt&quot;&gt;&lt;SPAN lang=EN-GB style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian; mso-bidi-font-family: Arial; mso-ansi-language: EN-GB&quot;&gt;Secondly, TxBeamsTrigger, as a common signal to all NR_DL_BeamsScheduler modules, indicates which NR_DL_BeamsScheduler&#x2019;s &lt;SPAN style=&quot;mso-spacerun: yes&quot;&gt;&amp;nbsp;&lt;/SPAN&gt;BI_TxRFChains output takes effect, which means only the modules with BranchIndex equalling to TxBeamsTrigger indication take effects and others keep outputting zeros. Most of the time, it&#x2019;s true. The exception is at very beginning, before SSBPower input becomes valid, the NR_DL_BeamsScheduler with BranchIndex=1 takes responsible for outputting beam index for initial beam training.&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0cm 0cm 0pt&quot;&gt;&lt;SPAN lang=EN-GB style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian; mso-bidi-font-family: Calibri; mso-ansi-language: EN-GB&quot;&gt;&lt;o:p&gt;&amp;nbsp;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0cm 0cm 0pt&quot;&gt;&lt;SPAN lang=EN-GB style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian; mso-bidi-font-family: Calibri; mso-ansi-language: EN-GB&quot;&gt;&lt;o:p&gt;&amp;nbsp;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0cm 0cm 0pt&quot;&gt;&lt;B&gt;&lt;SPAN lang=EN-GB style=&apos;FONT-SIZE: 14pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif; mso-fareast-font-family: DengXian; mso-ansi-language: EN-GB&apos;&gt;Simulation Notes&lt;/SPAN&gt;&lt;/B&gt;&lt;SPAN lang=EN-GB style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian; mso-bidi-font-family: Arial; mso-ansi-language: EN-GB&quot;&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0cm 0cm 0pt&quot;&gt;&lt;SPAN lang=EN-GB style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian; mso-bidi-font-family: Calibri; mso-ansi-language: EN-GB&quot;&gt;&lt;o:p&gt;&amp;nbsp;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0cm 0cm 0pt&quot;&gt;&lt;SPAN lang=EN-GB style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian; mso-bidi-font-family: Calibri; mso-ansi-language: EN-GB&quot;&gt;All three designs are based on fading channels, so it&#x2019;s critical to setup the simulation and RX algorithm parameters correctly before simulation. &lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0cm 0cm 0pt&quot;&gt;&lt;SPAN lang=EN-GB style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian; mso-bidi-font-family: Calibri; mso-ansi-language: EN-GB&quot;&gt;&lt;o:p&gt;&amp;nbsp;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0cm 0cm 0pt&quot;&gt;&lt;SPAN lang=EN-GB style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian; mso-bidi-font-family: Calibri; mso-ansi-language: EN-GB&quot;&gt;The most confusing part is how to setup the simulation slots for collecting reasonable BER and calculating throughput. The most important aspect is velocity configured in channel model, from which we can derive maximum doppler shift. Then, coherent time can be gotten upon the maximum doppler shift. The number of simulation slots should at least cover 5~10 coherent time to get expected average power.&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0cm 0cm 0pt&quot;&gt;&lt;SPAN lang=EN-GB style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian; mso-bidi-font-family: Calibri; mso-ansi-language: EN-GB&quot;&gt;&lt;o:p&gt;&amp;nbsp;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0cm 0cm 0pt&quot;&gt;&lt;SPAN lang=EN-GB style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian; mso-bidi-font-family: Calibri; mso-ansi-language: EN-GB&quot;&gt;Fmax and Tmax in RX side should be setup carefully according to channel configuration. Please refer to RX receiver guide to learn how to setup them correctly.&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0cm 0cm 0pt&quot;&gt;&lt;SPAN lang=EN-GB style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian; mso-bidi-font-family: Calibri; mso-ansi-language: EN-GB&quot;&gt;&lt;o:p&gt;&amp;nbsp;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0cm 0cm 0pt&quot;&gt;&lt;SPAN lang=EN-GB style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian; mso-bidi-font-family: Calibri; mso-ansi-language: EN-GB&quot;&gt;&lt;o:p&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian&quot;&gt;&lt;FONT face=Arial&gt;&lt;SPAN lang=EN-GB&gt;&lt;o:p&gt;&lt;SPAN style=&quot;FONT-SIZE: 14pt&quot;&gt;&lt;o:p&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian&quot;&gt;&amp;nbsp;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 0pt; mso-list: l0 level1 lfo1&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 14pt&quot;&gt;&lt;FONT size=2 face=Arial&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 14pt&quot;&gt;&lt;FONT face=Arial&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 14pt&quot;&gt;&lt;STRONG&gt;&lt;FONT face=Arial&gt;Signal Power Setting&lt;/FONT&gt;&lt;/STRONG&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 0pt; mso-list: l0 level1 lfo1&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 14pt&quot;&gt;&lt;FONT size=2 face=Arial&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 14pt&quot;&gt;&lt;FONT face=Arial&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 14pt&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian&quot;&gt;&lt;o:p&gt;In each design, there is one or several Oscillators following the NR_DL_Source. The Oscillator is used to tune the signal power to a specific power level, together with NR_DL_Source.&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 0pt; mso-list: l0 level1 lfo1&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 14pt&quot;&gt;&lt;FONT size=2 face=Arial&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 14pt&quot;&gt;&lt;FONT face=Arial&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 14pt&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian&quot;&gt;&lt;o:p&gt;If there&amp;nbsp;are one port and one RF chain for the signal transmission, the signal power setting is straightforward:&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 0pt; mso-list: l0 level1 lfo1&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 14pt&quot;&gt;&lt;FONT size=2 face=Arial&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 14pt&quot;&gt;&lt;FONT face=Arial&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 14pt&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian&quot;&gt;&lt;o:p&gt;If you specify the Power Parameter to, say 20, in Oscillator with unit dBm, the signal would be tuned to be with power 20dBm/15kHz in the frequency range where it&apos;s allocated.&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 0pt; mso-list: l0 level1 lfo1&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 14pt&quot;&gt;&lt;FONT size=2 face=Arial&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 14pt&quot;&gt;&lt;FONT face=Arial&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 14pt&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 14pt&quot;&gt;&lt;FONT size=2 face=Arial&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 14pt&quot;&gt;&lt;FONT face=Arial&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 14pt&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian&quot;&gt;&lt;o:p&gt;No matter what subcarrier spacing is used, the power spectrum would be 20dBm/15kHz in the frequency range where it&apos;s allocated.&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 0pt; mso-list: l0 level1 lfo1&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 14pt&quot;&gt;&lt;FONT size=2 face=Arial&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 14pt&quot;&gt;&lt;FONT face=Arial&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 14pt&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 14pt&quot;&gt;&lt;FONT size=2 face=Arial&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 14pt&quot;&gt;&lt;FONT face=Arial&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 14pt&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian&quot;&gt;&lt;o:p&gt;That means if 30kHz subcarrier spacing is specified, it results in 23dBm/30kHz.&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 0pt; mso-list: l0 level1 lfo1&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 14pt&quot;&gt;&lt;FONT size=2 face=Arial&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 14pt&quot;&gt;&lt;FONT face=Arial&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 14pt&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 14pt&quot;&gt;&lt;FONT size=2 face=Arial&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 14pt&quot;&gt;&lt;FONT face=Arial&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 14pt&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian&quot;&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&amp;nbsp;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 0pt; mso-list: l0 level1 lfo1&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 14pt&quot;&gt;&lt;FONT size=2 face=Arial&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 14pt&quot;&gt;&lt;FONT face=Arial&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 14pt&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 14pt&quot;&gt;&lt;FONT size=2 face=Arial&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 14pt&quot;&gt;&lt;FONT face=Arial&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 14pt&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian&quot;&gt;&lt;o:p&gt;Normally, multiple ports would be configured. Therefore the resulting signal power spectrum&amp;nbsp;would vary upon different configurations.&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 0pt; mso-list: l0 level1 lfo1&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 14pt&quot;&gt;&lt;FONT size=2 face=Arial&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 14pt&quot;&gt;&lt;FONT face=Arial&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 14pt&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 14pt&quot;&gt;&lt;FONT size=2 face=Arial&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 14pt&quot;&gt;&lt;FONT face=Arial&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 14pt&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian&quot;&gt;&lt;o:p&gt;Let&apos;s assume Power is still set to 20. and Let&apos;s&amp;nbsp;take an&amp;nbsp;example: if three ports are configured: port 1000 and port&amp;nbsp;1001 for PDSCH transmission and port&amp;nbsp;4000 for SSB transmission. Three RF chains are equipped for the transmission.&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 0pt; mso-list: l0 level1 lfo1&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 14pt&quot;&gt;&lt;FONT size=2 face=Arial&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 14pt&quot;&gt;&lt;FONT face=Arial&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 14pt&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 14pt&quot;&gt;&lt;FONT size=2 face=Arial&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 14pt&quot;&gt;&lt;FONT face=Arial&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 14pt&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian&quot;&gt;&lt;o:p&gt;If PortRFMappingMatrix = [1 0 0 1 1 1], the first RF chain transmit both port 1000 signal and port 4000 signal. Considering port 4000 signal is only transmitted in limited slots, the power spectrum would be still 20dBm/15kHz in the frequence range where PDSCH is allocated. The same thing happens for the second RF chain.&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 0pt; mso-list: l0 level1 lfo1&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 14pt&quot;&gt;&lt;FONT size=2 face=Arial&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 14pt&quot;&gt;&lt;FONT face=Arial&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 14pt&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 14pt&quot;&gt;&lt;FONT size=2 face=Arial&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 14pt&quot;&gt;&lt;FONT face=Arial&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 14pt&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian&quot;&gt;&lt;o:p&gt;If PortRFMappingMatrix = [1 1 1 1 1 1], which means signals associated with port 1000, port 1001 and port 4000 are all transmitted in both RF chains. In this case, the power spectrum would be 23dBm/15kHz in the frequency range where PDSCH transmission is allocated.&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 0pt; mso-list: l0 level1 lfo1&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 14pt&quot;&gt;&lt;FONT size=2 face=Arial&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 14pt&quot;&gt;&lt;FONT face=Arial&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 14pt&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 14pt&quot;&gt;&lt;FONT size=2 face=Arial&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 14pt&quot;&gt;&lt;FONT face=Arial&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 14pt&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian&quot;&gt;&lt;o:p&gt;The setting PortRFMappingMatrix = [1 1 1 1 1 1] doesn&apos;t make sense if you want to succeed the transmission, but it&apos;s a good example to elaborate the power setting hereby.&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 0pt; mso-list: l0 level1 lfo1&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 14pt&quot;&gt;&lt;FONT size=2 face=Arial&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 14pt&quot;&gt;&lt;FONT face=Arial&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 14pt&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 14pt&quot;&gt;&lt;FONT size=2 face=Arial&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 14pt&quot;&gt;&lt;FONT face=Arial&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 14pt&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian&quot;&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&amp;nbsp;&lt;/P&gt;&lt;/SPAN&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0cm 0cm 0pt&quot;&gt;&lt;SPAN lang=EN-GB style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian; mso-bidi-font-family: Calibri; mso-ansi-language: EN-GB&quot;&gt;&lt;o:p&gt;&amp;nbsp;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0cm 0cm 0pt&quot;&gt;&lt;B&gt;&lt;SPAN lang=EN-GB style=&apos;FONT-SIZE: 14pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif; mso-fareast-font-family: DengXian; mso-ansi-language: EN-GB&apos;&gt;Appendix&lt;/SPAN&gt;&lt;/B&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0cm 0cm 0pt&quot;&gt;&lt;FONT face=Calibri&gt;&lt;SPAN style=&apos;mso-bidi-font-family: Calibri; mso-fareast-font-family: &quot;Times New Roman&quot;; mso-ascii-font-family: Calibri; mso-hansi-font-family: Calibri&apos;&gt;&amp;nbsp;&lt;/SPAN&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian; mso-bidi-font-family: Calibri&quot;&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0cm 0cm 0pt&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian; mso-bidi-font-family: Calibri&quot;&gt;&lt;o:p&gt;&amp;nbsp;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: center; MARGIN: 3pt 0cm 9pt&quot; align=center&gt;&lt;B&gt;&lt;SPAN lang=EN-GB style=&apos;FONT-SIZE: 10pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif; mso-fareast-font-family: &quot;Yu Mincho&quot;; mso-ansi-language: EN-GB&apos;&gt;Transmission bandwidth configuration N&lt;SUB&gt;RB&lt;/SUB&gt; for FR1&lt;/SPAN&gt;&lt;/B&gt;&lt;B&gt;&lt;SPAN lang=EN-GB style=&apos;FONT-SIZE: 12pt