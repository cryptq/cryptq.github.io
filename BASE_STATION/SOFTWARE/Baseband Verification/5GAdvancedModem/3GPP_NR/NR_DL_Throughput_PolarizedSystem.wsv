<HideCondition>PDCCH_Enable == 0</HideCondition>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PDCCH_AllocatedSlots" Type="PartParam">
<DataEntry>[0:9]</DataEntry>
<Description>Allocated slot indices for PDCCH in each frame for all BWPs. The index starts from 0 to (N-1), where N is the number of slots per frame.</Description>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PDCCH_CandidateIndex" Type="PartParam">
<DataEntry>[0]</DataEntry>
<Description>PDCCH candidate index in the range of 0 ~ PDCCH_NumCandidates - 1.</Description>
<HideCondition>PDCCH_Enable == 0</HideCondition>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PDCCH_DMRS_MapMode" Type="PartParam">
<DataEntry>[1]</DataEntry>
<Description>PDCCH DMRS MapMode. 0: Map to CORESET; 1: Map to PDCCH only.</Description>
<HideCondition>PDCCH_Enable == 0</HideCondition>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PDCCH_Enable" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>enable or disable PDCCH and its DMRS transmission</Description>
<Enum>NR_DL_ResourceAllocator__PDCCH_Enable@5G Advanced Modem Enums</Enum>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="PDCCH_NumAllocatedSlots" Type="PartParam">
<DataEntry>[10]</DataEntry>
<Description>Number of allocated slots for PDCCH in each frame for each BWP.The size of this parameter is equal to NumBWPs</Description>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PDCCH_NumCandidates" Type="PartParam">
<DataEntry>[4]</DataEntry>
<Description>number of PDCCH candidates. Allowed value are 1, 2, 3, 4, 5, 6, 8.</Description>
<HideCondition>PDCCH_Enable == 0</HideCondition>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PDCCH_n_RNTI" Type="PartParam">
<DataEntry>[0]</DataEntry>
<Description>radio network temporary identifier for each PDCCH.</Description>
<HideCondition>PDCCH_Enable == 0</HideCondition>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PDSCH_AllocatedSlots" Type="PartParam">
<DataEntry>ActiveSlots</DataEntry>
<Description>Allocated slot indices for PDSCH in each frame for all BWPs. The index starts from 0 to (N-1), where N is the number of slots per frame.</Description>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PDSCH_DMRS_AddPos" Type="PartParam">
<DataEntry>PDSCH_DMRS_AddPos</DataEntry>
