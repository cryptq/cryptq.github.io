<Item XName="AntennaPortIndex" Type="PartParam">
<DataEntry>[0]</DataEntry>
<Description>PDSCH antenna port index used to be measured for each BWP</Description>
<HideCondition>SaveVSASetupFile==0</HideCondition>
<Validate><T>Int</T><D>13</D></Validate></Item>
