<Enum>NR_HARQ_Controller__Payload_Config@5G Advanced Modem Enums</Enum>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="PhaseRotation_Enable" Type="PartParam">
<DataEntry>PhaseRotation_Enable</DataEntry>
<Description>enable or disable additional phase rotation specified in section 5.4 of 3GPP TS 38.211</Description>
<Enum>NR_DL_FrameSync__PhaseRotation_Enable@5G Advanced Modem Enums</Enum>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="SNR" Type="PartParam">
<DataEntry>15</DataEntry>
<Description>SNR in dB. (used by 2D-MMSE channel estimator in PDSCH)</Description>
