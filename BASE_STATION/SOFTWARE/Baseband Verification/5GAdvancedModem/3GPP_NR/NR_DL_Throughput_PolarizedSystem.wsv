<Selected><T>Bool</T><D>0</D></Selected>
<Item XName="Page" Type="PageMgr">
<Item XName="Display0" Type="ParmsDisp">
<DVport><T>Array_Dbl64</T><D>1;4;;;G24;G24</D></DVport>
<PVPort><T>Array_Dbl64</T><D>1;4;Wr0C;dPcPcPcvx0C;1000000aj14;dPcPcPcBp14</D></PVPort>
<Show><T>Bool</T><D>0</D></Show></Item></Item>
<Item XName="ParamSet" Type="ParamSet">
<ParamOrder><T>Array_BString</T><D>1;105;DiversityOption;PhaseRotation_Enable;FCarrierTx;FCarrierRx;NumRxRFChains;NumBeamTrainingRounds;BeamTrainingRxRFChainsList;DataRcvRxRFChainsList;CellID;nCI;Bandwidth;Numerology;Numerology_k0;OversamplingOption;NumBWPs;CyclicPrefix;SSB_Enable;SSB_Numerology;SSB_Numerology_k0;SSB_k0;SubCarrierSpacingCommon;SSB_RBOffset;SSB_TimeOffset;SSB_Periodicity;SSB_SymStartOption30K;SSB_Lmax;SSB_ActiveBlocks;PBCH_DMRS_PowerBoosting;PBCH_PowerBoosting;BWP_RBOffset;BWP_NumRBs;PDSCH_Enable;PDSCH_DMRS_NumPorts;PDSCH_DMRS_PortList;PDSCH_n_RNTI;PDSCH_n_ID;Payload_Config;MCS;MCSTable;TransBlockSize;Modulation;LDPCBaseGraphType;HARQ_Enable;MaxHARQTrans;NumHARQ;PDSCH_NumAllocatedSlots;PDSCH_AllocatedSlots;PDSCH_MappingType;PDSCH_RBOffset;PDSCH_NumRBs;PDSCH_StartOFDMSym;PDSCH_NumOFDMSyms;PDSCH_PowerBoosting;PDSCH_DMRS_n_SCID;PDSCH_DMRS_N_ID;PDSCH_DMRS_ConfigType;PDSCH_DMRS_AddPos;PDSCH_DMRS_TypeA_Pos;PDSCH_DMRS_Length;PDSCH_DMRS_CDMGroupNum;PDSCH_DMRS_PowerBoosting;PTRS_Enable;PDSCH_PTRS_TimeDensity;PDSCH_PTRS_FrequencyDensity;PDSCH_PTRS_ResourceElementOffset;PDSCH_PTRS_PowerBoosting;PDCCH_Enable;PDCCH_NumAllocatedSlots;PDCCH_AllocatedSlots;CORESET_Index;CORESET_InterleaverSize;CORESET_MappingType;CORESET_NumSyms;CORESET_RB_Bitmap;CORESET_REG_BundleSize;CORESET_ShiftIndex;CORESET_SymOffset;PDCCH_n_RNTI;SearchSpaceType;PDCCH_AggregationLevel;PDCCH_NumCandidates;PDCCH_CandidateIndex;PDCCH_DMRS_MapMode;CSIRS_Enable;StartSlotOffset;Sym_StartPos;MMSE_RBWinLen;MMSE_Config;SNR;Tmax;Fmax;PBCH_Decoding_Enable;SyncFilter_Enable;FreqSync_Enable;SyncSearchRange;SyncTrackingRange;SyncThreshold;BWPFilterEnable;CompensateFreqOffset;DemapperType;DemapperMaxLevel;LDPC_Algorithm;LDPC_IterationNumber;LDPC_ScalingFactor;NumSlotsMuted</D></ParamOrder>
<Item XName="BWPFilterEnable" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>whether filter the BWP signal from received signal.</Description>
<Enum>NR_DemuxFrame__BWPFilterEnable@5G Advanced Modem Enums</Enum>
<HideCondition>1</HideCondition>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="BWP_NumRBs" Type="PartParam">
<DataEntry>250</DataEntry>
<Description>number of PRB in BWP basd on different SCS of different numerology</Description>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="BWP_RBOffset" Type="PartParam">
<DataEntry>20</DataEntry>
<Description>the starting RB index of resource blocks allocated to BWP in the whole bandwidth based on SCS of 15KHz</Description>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="Bandwidth" Type="PartParam">
<DataEntry>7</DataEntry>
<Description>bandwidth</Description>
<Enum>NR_VSA_Gen__BandWidth@5G Advanced Modem Enums</Enum>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="BeamTrainingRxRFChainsList" Type="PartParam">
<DataEntry>[0]</DataEntry>
<Description>the index of receiver&apos;s input antenna associated with RX beams. The elements number should not be greater than NumRxRFChains.</Description>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="CORESET_Index" Type="PartParam">
<DataEntry>[0]</DataEntry>
<Description>a control resource set index in the range of 0 ~ 11</Description>
<HideCondition>PDCCH_Enable == 0</HideCondition>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="CORESET_InterleaverSize" Type="PartParam">
<DataEntry>[6]</DataEntry>
<Description>the interleaver size (R) given by higher-layer parameter CORESET-interleaver-size. The value should be {2,3,6}</Description>
<HideCondition>PDCCH_Enable == 0</HideCondition>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="CORESET_MappingType" Type="PartParam">
<DataEntry>[0]</DataEntry>
<Description>the CCE-to-REG mapping type for each CORESET in each BWP. 0 means non-interleaved while 1 means interleaved</Description>
<HideCondition>PDCCH_Enable == 0</HideCondition>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="CORESET_NumSyms" Type="PartParam">
<DataEntry>[1]</DataEntry>
<Description>number of OFDM symbols in the time domain for each CORESET in each BWP. The value should be {1,2,3}</Description>
<HideCondition>PDCCH_Enable == 0</HideCondition>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="CORESET_RB_Bitmap" Type="PartParam">
<DataEntry>[1, 1, 1, 1, 1, 1, 1, 1]</DataEntry>
<Description>PRB bitmap for each CORESET in each BWP in ascending order. Each bit represents a non-overlapping group of 6 PRBs. LSB means the lowest group of 6 PRBs.</Description>
<HideCondition>PDCCH_Enable == 0</HideCondition>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="CORESET_REG_BundleSize" Type="PartParam">
<DataEntry>[6]</DataEntry>
<Description>the REG bundle size for each CORESET in each BWP configured by the higher-layer parameter CORESET-REG-bundle-size. {2,6} for CORESET_NumSyms=1; {CORESET_NumSyms,6} for CORESET_NumSyms={2,3}</Description>
<HideCondition>PDCCH_Enable == 0</HideCondition>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="CORESET_ShiftIndex" Type="PartParam">
<DataEntry>[0]</DataEntry>
<Description>the shift given by the higher-layer parameter CORESET-shift-index. The value should be {0,1,...,274}</Description>
<HideCondition>PDCCH_Enable == 0</HideCondition>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="CORESET_SymOffset" Type="PartParam">
<DataEntry>[0]</DataEntry>
<Description>start OFDM symbol index in the time domain for each CORESET in each BWP.</Description>
<HideCondition>PDCCH_Enable == 0</HideCondition>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="CSIRS_Enable" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>enable or disable CSI RS transmission</Description>
<Enum>NR_DL_ResourceAllocator__CSIRS_Enable@5G Advanced Modem Enums</Enum>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="CellID" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>cell identity</Description>
<Validate><T>Int</T><D>11</D></Validate></Item>
<Item XName="CompensateFreqOffset" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>switch ON/OFF frequency offset compensation</Description>
<Enum>NR_DemuxFrame__CompensateFreqOffset@5G Advanced Modem Enums</Enum>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="CyclicPrefix" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>normal CP or extended CP(0: Normal; 1: Extended)</Description>
<Enum>NR_DL_MuxOFDMSym__CyclicPrefix@5G Advanced Modem Enums</Enum>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="DataRcvRxRFChainsList" Type="PartParam">
<DataEntry>[0]</DataEntry>
<Description>the index of receiver&apos;s RF chains associated with data receiving.</Description>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="DemapperMaxLevel" Type="PartParam">
<DataEntry>1.0</DataEntry>
<Description>the maximum level for soft demapping output when DemapperType is Soft or CSI</Description>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="DemapperType" Type="PartParam">
<DataEntry>1</DataEntry>
<Description>demapper type</Description>
<Enum>V5G_Demapper__DemapperType@5G Advanced Modem Enums</Enum>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="DiversityOption" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>0: MRC; 1: Only Branch#1; 2: Only Branch #2</Description>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="FCarrierRx" Type="PartParam">
<DataEntry>6e9</DataEntry>
<Description>frequency carrier of the received signal</Description>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="FCarrierTx" Type="PartParam">
<DataEntry>6e9</DataEntry>
<Description>frequency carrier of the transmitting signal</Description>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="Fmax" Type="PartParam">
<DataEntry>1</DataEntry>
<Description>the maximum doppler frequency. (used by 2D-MMSE channel estimator in PDSCH)</Description>
<Unit><T>Int</T><D>1001</D></Unit>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="FreqSync_Enable" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>Sync: enable or disable frequency synchronization</Description>
<Enum>NR_DL_FrameSync__FreqSync_Enable@5G Advanced Modem Enums</Enum>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="HARQ_Enable" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>whether HARQ closed-loop transmission is enabled</Description>
<Enum>NR_HARQ_Controller__HARQ_Enable@5G Advanced Modem Enums</Enum>
<HideCondition>1</HideCondition>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="LDPCBaseGraphType" Type="PartParam">
<DataEntry>[0]</DataEntry>
<Description>LDPC base graph type. 0 : Base Graph1; 1 : Base Graph2;</Description>
<HideCondition>Payload_Config == 0</HideCondition>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="LDPC_Algorithm" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>decoding algorithm for LDPC</Description>
<Enum>NR_LDPC_Decoder__Algorithm@5G Advanced Modem Enums</Enum>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="LDPC_IterationNumber" Type="PartParam">
<DataEntry>30</DataEntry>
<Description>the number of iterations</Description>
<Validate><T>Int</T><D>11</D></Validate></Item>
<Item XName="LDPC_ScalingFactor" Type="PartParam">
<DataEntry>1.0</DataEntry>
<Description>scaling factor for input signal</Description>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="MCS" Type="PartParam">
<DataEntry>[0]</DataEntry>
<Description>modulation and coding scheme (MCS) for each user</Description>
<HideCondition>Payload_Config == 1</HideCondition>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="MCSTable" Type="PartParam">
<DataEntry>[0]</DataEntry>
<Description>The MCS index table to use for D-SCH, see section 5.1.3 and 6.1.4 of 38.214. [0: Table 5.1.3.1-1 | 1: Table 5.1.3.1-2 | 2: Table 5.1.3.1-3 | 3: Table 6.1.4.1-1 | 4: Table 6.1.4.1-2]</Description>
<HideCondition>Payload_Config == 1</HideCondition>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="MMSE_Config" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>simplified mode estimates one SNR for MMSE channel estimation, but enhanced mode estimates SNR for each RBG received associated with one TX port and RX antenna. Besides, SpecifySNR allows user to specify SNR value.</Description>
<Enum>NR_PDSCH_ChannelEstimator__MMSE_Config@5G Advanced Modem Enums</Enum>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="MMSE_RBWinLen" Type="PartParam">
<DataEntry>3</DataEntry>
<Description>number of RBs for each MMSE-2D interpolation</Description>
<Validate><T>Int</T><D>11</D></Validate></Item>
<Item XName="MaxHARQTrans" Type="PartParam">
<DataEntry>4</DataEntry>
<Description>maximum number of HARQ transmission per each HARQ process for each user</Description>
<HideCondition>HARQ_Enable == 0</HideCondition>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="Modulation" Type="PartParam">
<DataEntry>1</DataEntry>
<Description>the modulation orders in each slot. (0:BPSK or Pi/2 BPSK, 1:QPSK, 2:16QAM, 3:64QAM, 4:256QAM).</Description>
<HideCondition>Payload_Config == 0</HideCondition>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="NumBWPs" Type="PartParam">
<DataEntry>1</DataEntry>
<Description>number of BWPs</Description>
<Validate><T>Int</T><D>11</D></Validate></Item>
<Item XName="NumBeamTrainingRounds" Type="PartParam">
<DataEntry>1</DataEntry>
<Description>the number of SSB periods used to do beam training by receiver.</Description>
<Validate><T>Int</T><D>11</D></Validate></Item>
<Item XName="NumHARQ" Type="PartParam">
<DataEntry>8</DataEntry>
<Description>number of HARQ processes for each user</Description>
<HideCondition>HARQ_Enable == 0</HideCondition>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="NumRxRFChains" Type="PartParam">
<DataEntry>1</DataEntry>
<Description>the number of RX RF chains</Description>
<Validate><T>Int</T><D>11</D></Validate></Item>
<Item XName="NumSlotsMuted" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>number of slots before effective data come, which is additional time instants besides SlotsIgnored</Description>
<Validate><T>Int</T><D>11</D></Validate></Item>
<Item XName="Numerology" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>numerology(0: 15kHz;1:30kHz;2:60kHz;3:120kHz;4:240kHz)</Description>
<Enum>NR_DemuxSlot__Numerology@5G Advanced Modem Enums</Enum>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="Numerology_k0" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>the lowest numbered subcarrier in a common resource block for specific numerology</Description>
<Validate><T>Int</T><D>11</D></Validate></Item>
<Item XName="OversamplingOption" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>oversampling  option of max(CarrierNumRBs, SSB_CarrierNumRBs)</Description>
<Enum>FBMC_DemuxFrame__OversampleOption@5G Advanced Modem Enums</Enum>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="PBCH_DMRS_PowerBoosting" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>DMRS of PBCH power factor</Description>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="PBCH_Decoding_Enable" Type="PartParam">
<DataEntry>1</DataEntry>
<Description>enable or disable PBCH decoding when doing schronization.</Description>
<Enum>NR_DL_FrameSync__PBCH_Decoding_Enable@5G Advanced Modem Enums</Enum>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="PBCH_PowerBoosting" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>PBCH power factor</Description>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="PDCCH_AggregationLevel" Type="PartParam">
<DataEntry>[2]</DataEntry>
<Description>number of control-channel elements (CCEs) for each PDCCH in each BWP. The value should be {1, 2, 4, 8, 16}.</Description>
<HideCondition>PDCCH_Enable == 0</HideCondition>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PDCCH_AllocatedSlots" Type="PartParam">
<DataEntry>[0:9]</DataEntry>
<Description>Allocated slot indices for PDCCH in each frame for all BWPs. The index starts from 0 to (N-1), where N is the number of slots per frame.</Description>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PDCCH_CandidateIndex" Type="PartParam">
<DataEntry>[0]</DataEntry>
<Description>PDCCH candidate index in the range of 0 ~ PDCCH_NumCandidates - 1.</Description>
<HideCondition>PDCCH_Enable == 0</HideCondition>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PDCCH_DMRS_MapMode" Type="PartParam">
<DataEntry>[1]</DataEntry>
<Description>PDCCH DMRS MapMode. 0: Map to CORESET; 1: Map to PDCCH only.</Description>
<HideCondition>PDCCH_Enable == 0</HideCondition>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PDCCH_Enable" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>enable or disable PDCCH and its DMRS transmission</Description>
<Enum>NR_DL_ResourceAllocator__PDCCH_Enable@5G Advanced Modem Enums</Enum>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="PDCCH_NumAllocatedSlots" Type="PartParam">
<DataEntry>[10]</DataEntry>
<Description>Number of allocated slots for PDCCH in each frame for each BWP.The size of this parameter is equal to NumBWPs</Description>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PDCCH_NumCandidates" Type="PartParam">
<DataEntry>[4]</DataEntry>
<Description>number of PDCCH candidates. Allowed value are 1, 2, 3, 4, 5, 6, 8.</Description>
<HideCondition>PDCCH_Enable == 0</HideCondition>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PDCCH_n_RNTI" Type="PartParam">
<DataEntry>[0]</DataEntry>
<Description>radio network temporary identifier for each PDCCH.</Description>
<HideCondition>PDCCH_Enable == 0</HideCondition>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PDSCH_AllocatedSlots" Type="PartParam">
<DataEntry>[0:9]</DataEntry>
<Description>Allocated slot indices for PDSCH in each frame for all BWPs. The index starts from 0 to (N-1), where N is the number of slots per frame.</Description>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PDSCH_DMRS_AddPos" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>DL-DMRSadd_pos. The number of additional positions for DMRS.</Description>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PDSCH_DMRS_CDMGroupNum" Type="PartParam">
<DataEntry>[1]</DataEntry>
<Description>the number of CDM groups without data of values 1, 2, and 3, which refers to CDM groups {0}, {0, 1} and {0, 1, 2} respectively.</Description>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PDSCH_DMRS_ConfigType" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>dmrs configuration type for PDSCH</Description>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PDSCH_DMRS_Length" Type="PartParam">
<DataEntry>[1]</DataEntry>
<Description>DL-DMRS-len. The number of symbols of one DMRS.</Description>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PDSCH_DMRS_N_ID" Type="PartParam">
<DataEntry>[0]</DataEntry>
<Description>used for PDSCH DMRS initialization (0~65535). Given by the higher-layer parameters scramblingID0 and scramblingID1.</Description>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PDSCH_DMRS_NumPorts" Type="PartParam">
<DataEntry>[1]</DataEntry>
<Description>number of ports for each BWP</Description>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PDSCH_DMRS_PortList" Type="PartParam">
<DataEntry>[1000]</DataEntry>
<Description>ports index, the range of each element should be in range of [1000 ~ 1011]</Description>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PDSCH_DMRS_PowerBoosting" Type="PartParam">
<DataEntry>[0.0]</DataEntry>
<Description>PDSCH DMRS power in dB for each PDSCH.</Description>
<Validate><T>Int</T><D>14</D></Validate></Item>
<Item XName="PDSCH_DMRS_TypeA_Pos" Type="PartParam">
<DataEntry>2</DataEntry>
<Description>DL-DMRS-typeA-pos. The position of first DMRS symbol.</Description>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PDSCH_DMRS_n_SCID" Type="PartParam">
<DataEntry>[0]</DataEntry>
<Description>used for PDSCH DMRS initialization (0/1).</Description>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PDSCH_Enable" Type="PartParam">
<DataEntry>1</DataEntry>
<Description>enable or disable PDSCH and its DMRS transmission</Description>
<Enum>NR_DL_MuxOFDMSym__PDSCH_Enable@5G Advanced Modem Enums</Enum>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="PDSCH_MappingType" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>PDSCH mapping type (A or B)</Description>
<Enum>NR_DL_MuxOFDMSym__PDSCH_MappingType@5G Advanced Modem Enums</Enum>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="PDSCH_NumAllocatedSlots" Type="PartParam">
<DataEntry>[10]</DataEntry>
<Description>Number of allocated slots for PDSCH in each frame for each BWP.The size of this parameter is equal to NumBWPs</Description>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PDSCH_NumOFDMSyms" Type="PartParam">
<DataEntry>13</DataEntry>
<Description>number of OFDM symbols for each PDSCH.</Description>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PDSCH_NumRBs" Type="PartParam">
<DataEntry>250</DataEntry>
<Description>number of resource blocks (RBs) for each PDSCH.</Description>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PDSCH_PTRS_FrequencyDensity" Type="PartParam">
<DataEntry>[0]</DataEntry>
<Description>set the Frequency Density (K_PTRS) for PDSCH PTRS signal. [0: 2 RBs; 1: 4 RBs]</Description>
<HideCondition>PTRS_Enable == 0</HideCondition>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PDSCH_PTRS_PowerBoosting" Type="PartParam">
<DataEntry>[0]</DataEntry>
<Description>PDSCH PTRS power boosting in dB for each PDSCH PTRS.</Description>
<HideCondition>PTRS_Enable == 0</HideCondition>
<Validate><T>Int</T><D>14</D></Validate></Item>
<Item XName="PDSCH_PTRS_ResourceElementOffset" Type="PartParam">
<DataEntry>[0]</DataEntry>
<Description>set the PTRS RE Offset for PDSCH PTRS signal generation. [0: 00; 1: 01; 2: 10; 3: 11]</Description>
<HideCondition>PTRS_Enable == 0</HideCondition>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PDSCH_PTRS_TimeDensity" Type="PartParam">
<DataEntry>[0]</DataEntry>
<Description>set the Time Density (L_PTRS) for PDSCH PTRS signal. [0: 1 symbol; 1: 2 symbols; 2: 4 symbols]</Description>
<HideCondition>PTRS_Enable == 0</HideCondition>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PDSCH_PowerBoosting" Type="PartParam">
<DataEntry>[0.0]</DataEntry>
<Description>PDSCH power in dB</Description>
<Validate><T>Int</T><D>14</D></Validate></Item>
<Item XName="PDSCH_RBOffset" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>the starting RB index of resource blocks allocated to the user</Description>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PDSCH_StartOFDMSym" Type="PartParam">
<DataEntry>1</DataEntry>
<Description>the index for the first OFDM symbol allocated to each PDSCH.</Description>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PDSCH_n_ID" Type="PartParam">
<DataEntry>[0]</DataEntry>
