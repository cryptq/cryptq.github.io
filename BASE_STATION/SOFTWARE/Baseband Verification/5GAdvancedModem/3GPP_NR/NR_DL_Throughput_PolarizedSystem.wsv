<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>11</D></Validate></Item>
<Item XName="SearchSpaceType" Type="PartParam">
<DataEntry>[0]</DataEntry>
<Description>search space type. 0: UE_specific; 1: Common</Description>
<HideCondition>PDCCH_Enable == 0</HideCondition>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="StartSlotOffset" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>the start slot offset of first transport block from the start of first radio frame</Description>
<HideCondition>1</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>11</D></Validate></Item>
<Item XName="SubCarrierSpacingCommon" Type="PartParam">
<DataEntry>2</DataEntry>
<Description>higher-layer parameter</Description>
<Enum>NR_DL_ResourceAllocator__subCarrierSpacingCommon@5G Advanced Modem Enums</Enum>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="Sym_StartPos" Type="PartParam">
<DataEntry>[-3,-3]</DataEntry>
<Description>start position (without oversampling) to get the OFDM symbol for FFT operation for long CP and short CP symbols respectively, compared to the start position of the OFDM body after CP</Description>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="SyncFilter_Enable" Type="PartParam">
