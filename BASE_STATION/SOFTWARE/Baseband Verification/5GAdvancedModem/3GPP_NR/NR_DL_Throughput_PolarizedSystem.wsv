<Enum />
<HideCondition>PDSCH_Enable==0</HideCondition>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PDSCH_n_ID" Type="PartParam">
<DataEntry>[0]</DataEntry>
