<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PDSCH_DMRS_Length" Type="PartParam">
<DataEntry>PDSCH_DMRS_Length</DataEntry>
<Description>DL-DMRS-len. The number of symbols of one DMRS.</Description>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PDSCH_DMRS_N_ID" Type="PartParam">
<DataEntry>[0]</DataEntry>
