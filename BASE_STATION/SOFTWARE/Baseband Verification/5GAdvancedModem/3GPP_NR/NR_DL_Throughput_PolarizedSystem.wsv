<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>11</D></Validate></Item>
<Item XName="NumBeamTrainingRounds" Type="PartParam">
<DataEntry>NumBeamTrainingRounds</DataEntry>
<Description>the number of SSB periods used to do beam training by receiver.</Description>
<Validate><T>Int</T><D>11</D></Validate></Item>
<Item XName="NumDiversityBranches" Type="PartParam">
<DataEntry>NumDiversityBranches</DataEntry>
<Description>number of branches for switch diversity</Description>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="NumHARQ" Type="PartParam">
<DataEntry>8</DataEntry>
