<DataEntry>=PDSCH_NumOFDMSyms</DataEntry>
<Description>number of OFDM symbols for each PDSCH.</Description>
<HideCondition>PDSCH_Enable==0</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PDSCH_NumRBs" Type="PartParam">
<DataEntry>=PDSCH_NumRBs</DataEntry>
