<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="FIR_FilterType" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>spectrum-shaping FIR filter type, valid when SpectrumShapingType=FIRFilter</Description>
<Enum>NR_SpecShaping__FIR_FilterType@5G Advanced Modem Enums</Enum>
<HideCondition>2~=SpectrumShapingType</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="FIR_Taps" Type="PartParam">
