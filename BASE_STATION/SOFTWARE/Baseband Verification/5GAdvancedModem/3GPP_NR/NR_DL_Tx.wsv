<Item XName="Equations" Type="Equation">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>%%%%%%%%%%%%%%%%Using Equation CalcuEVM to runanalysis or runanalysis directly&#x000D;&#x000A;if(~exist(&apos;G_SWEEP&apos;))&#x000D;&#x000A;AoD_Cen = 45;%%% deg&#x000D;&#x000A;ZoD_Cen = 45;%%% deg&#x000D;&#x000A;AoD = tune(45);%%% deg&#x000D;&#x000A;ZoD = 45;%%% deg&#x000D;&#x000A;SNR = 30;%%%dB&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;%set Tx/Rx antenna arrays&#x000D;&#x000A;TxNumRows = 8;&#x000D;&#x000A;TxNumCols = 8;&#x000D;&#x000A;&#x000D;&#x000A;RxNumRows = 8;&#x000D;&#x000A;RxNumCols = 8;&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;%%%%%%%%caculate number of ports&#x000D;&#x000A;%NumPortsOut = length(unique(BWP_PortList));&#x000D;&#x000A;&#x000D;&#x000A;%%%%%%%%%%%%%%%%%%%%%%%get CarrierNumRBs from bandwidth and frequency range&#x000D;&#x000A;BandwidthTable =[5e6,10e6,15e6,20e6,25e6,30e6,40e6,50e6,60e6,70e6,80e6,90e6,100e6,200e6,400e6];&#x000D;&#x000A;if (Bandwidth==15)&#x000D;&#x000A;&#x0009;CarrierNumRBs = UserDefinedCarrierNumRBs;&#x000D;&#x000A;&#x0009;FFT_Size = 2.^ceil(log2(CarrierNumRBs*12)).*2^(OversamplingOption);&#x000D;&#x000A;&#x0009;SamplingRate = max(FFT_Size*15e3.*2.^Numerology);&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;FFT_Size = 2^ceil(log2(BandwidthTable(Bandwidth+1)/(15e3*2^Numerology)))*2^(OversamplingOption);&#x000D;&#x000A;&#x0009;SamplingRate = 2.^ceil(log2(BandwidthTable(Bandwidth+1)/15e3))*2^(OversamplingOption)*15e3;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;%%%%%%%%%%% AWGN noise density&#x000D;&#x000A;EPRE = 0;%%% dBm/15kHz&#x000D;&#x000A;&#x000D;&#x000A;NDensity_dBm = EPRE - SNR - 10*log10(15e3)+ 10*log10(TxNumRows*TxNumCols);&#x000D;&#x000A;&#x000D;&#x000A;%%%%%%%%%%%%%%set SlotIgnored&#x000D;&#x000A;SlotPerFrame = 10 * 2^Numerology;&#x000D;&#x000A;&#x000D;&#x000A;SSB_Periodicity_FrameNum = 0.5 * 2^SSB_Periodicity;&#x000D;&#x000A;SlotIgnored = floor( SSB_Periodicity_FrameNum *  SlotPerFrame);&#x000D;&#x000A;&#x000D;&#x000A;%%%%%%%%%%%%%%%%%default parameters&#x000D;&#x000A;ResourceGridEnable = 1;&#x000D;&#x000A;N_GridStart = [0];&#x000D;&#x000A;SSB_N_GridStart = 0;&#x000D;&#x000A;GridStart = [0];%%%%%% for EVM model,please make sure GridStart is consistent with N_GridStart&#x000D;&#x000A;SSB_GridStart = 0;%%%%%% for EVM model,please make sure SSB_GridStart is consistent with SSB_N_GridStart&#x000D;&#x000A;&#x000D;&#x000A;PSS_PowerBoosting = 0;&#x000D;&#x000A;SSS_PowerBoosting = 0;&#x000D;&#x000A;PBCH_DMRS_PowerBoosting = 0;&#x000D;&#x000A;PBCH_PowerBoosting =0;&#x000D;&#x000A;&#x000D;&#x000A;PDSCH_DMRS_ConfigType = [0];&#x000D;&#x000A;PDSCH_DMRS_Length =[1];&#x000D;&#x000A;PDSCH_DMRS_AddPos =[0];&#x000D;&#x000A;PDSCH_DMRS_TypeA_Pos =[2];&#x000D;&#x000A;PDSCH_MappingType = 0;&#x000D;&#x000A;PDSCH_DMRS_PowerBoosting = [0];&#x000D;&#x000A;PDSCH_PowerBoosting = [0];&#x000D;&#x000A;LDPCBaseGraphType =[0];&#x000D;&#x000A;PDSCH_DMRS_n_SCID =[0];&#x000D;&#x000A;PDSCH_DMRS_N_ID =[1];&#x000D;&#x000A;PDSCH_n_RNTI = [0];&#x000D;&#x000A;PDSCH_n_ID_Scrambler =[0];&#x000D;&#x000A;PDSCH_DMRS_CDMGroupNum = [1];&#x000D;&#x000A;subCarrierSpacingCommon = 2;&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% for Rx beam sweep to get the power in different direction&#x000D;&#x000A;%Here defines beam control for SSB blocks&#x000D;&#x000A;SSB_TimeTable = [5e-3, 10e-3, 20e-3, 40e-3, 80e-3, 160e-3];&#x000D;&#x000A;Time = SSB_TimeTable(SSB_Periodicity+1);&#x000D;&#x000A;FrameLength = Time*SamplingRate;&#x000D;&#x000A;long_symbol_len = (144 + 16*2^Numerology + 2048) * FFT_Size / 2048;&#x000D;&#x000A;short_symbol_len = (144 + 2048) * FFT_Size / 2048;&#x000D;&#x000A;long_cp_diff = 16*2^Numerology * FFT_Size / 2048;&#x000D;&#x000A;SSB_Lmax_Len = 64 ; %%%% for FR2&#x000D;&#x000A;%RxPhiTable = [-80:120/SSB_Lmax_Len:40];&#x000D;&#x000A;%RxPhiTable = [0:90/SSB_Lmax_Len:90];&#x000D;&#x000A;RxThetaTable = [0:90/SSB_Lmax_Len:90];&#x000D;&#x000A;SS_Idx_120K = [ 4,8,16,20,32,36,44,48,60,64,72,76,88,92,100,104,144,148,156,160,172,176,184,188,200,204,212,216,228,232,240,244,284,288,296,300,312,316,324,328,340,344,352,356,368,372,380,384,424,428,436,440,452,456,464,468,480,484,492,496,508,512,520,524];&#x000D;&#x000A;SS_Idx_240K  = [ 8,12,16,20,32,36,40,44,64,68,72,76,88,92,96,100,120,124,128,132,144,148,152,156,176,180,184,188,200,204,208,212,288,292,296,300,312,316,320,324,344,348,352,356,368,372,376,380,400,404,408,412,424,428,432,436,456,460,464,468,480,484,488,492 ];&#x000D;&#x000A;NumSymbolsPerSlot = 14*2^Numerology;&#x000D;&#x000A;&#x000D;&#x000A;%RxPhi = zeros(FrameLength,1);&#x000D;&#x000A;RxPhi = ones(FrameLength,1)*AoD;&#x000D;&#x000A;RxTheta = zeros(FrameLength,1);&#x000D;&#x000A;for n=1:SSB_Lmax_Len,&#x000D;&#x000A;&#x0009;%for each SSB&#x000D;&#x000A;&#x0009;if (Numerology == 3)&#x000D;&#x000A;&#x0009;&#x0009;sym_idx = SS_Idx_120K(n);&#x000D;&#x000A;&#x0009;else&#x000D;&#x000A;&#x0009;&#x0009;sym_idx = SS_Idx_240K(n);&#x000D;&#x000A;&#x0009;end;&#x0009;&#x000D;&#x000A;&#x0009;num_long_cp = floor(sym_idx/(NumSymbolsPerSlot/2) + 1);&#x000D;&#x000A;&#x0009;&#x000D;&#x000A;%&#x0009;RxPhi(num_long_cp*long_cp_diff+(sym_idx)*short_symbol_len+1: num_long_cp*long_cp_diff+(sym_idx+4)*short_symbol_len)= RxPhiTable(n);&#x000D;&#x000A;&#x0009;RxTheta(num_long_cp*long_cp_diff+(sym_idx)*short_symbol_len+1: num_long_cp*long_cp_diff+(sym_idx+4)*short_symbol_len)= RxThetaTable(n);&#x000D;&#x000A;end;&#x000D;&#x000A;&#x000D;&#x000A;%RxTheta = ones(FrameLength,1)* ZoD;&#x000D;&#x000A;&#x000D;&#x000A;%%%%%%%%%%%%%%%%%%%%%%%%%%get modulation( (0:BPSK or Pi/2 BPSK, 1:QPSK, 2:16QAM, 3:64QAM, 4:256QAM)) from parameter&#x000D;&#x000A;Modulation_t = zeros(1,length(Modulation));&#x000D;&#x000A;for i = 1:length(Modulation)&#x000D;&#x000A;switch(Modulation(i))&#x000D;&#x000A;&#x0009;case 2 &#x000D;&#x000A;&#x0009;&#x0009;Modulation_t(i) = 1;&#x000D;&#x000A;&#x0009;case 4 &#x000D;&#x000A;&#x0009;&#x0009;Modulation_t(i) = 2;&#x000D;&#x000A;&#x0009;case 6 &#x000D;&#x000A;&#x0009;&#x0009;Modulation_t(i) = 3;&#x000D;&#x000A;&#x0009;case 8 &#x000D;&#x000A;&#x0009;&#x0009;Modulation_t(i) = 4;&#x000D;&#x000A;&#x0009;otherwise&#x000D;&#x000A;&#x0009;&#x0009;error(&apos;Element of Modulation should be {2,4,6,8}&apos;);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;%%%%%%%%%%%%%%%%%%%%%%%%%set parameters for EVM model&#x000D;&#x000A;GridMu = repmat(Numerology,1,NumBWPs);&#x000D;&#x000A;GridMu = sort(unique(GridMu(1:NumBWPs)));&#x000D;&#x000A;GridPosition = GridStart.*2.^GridMu*12*15e3;&#x000D;&#x000A;GridDiff = GridPosition-GridPosition(find(max(GridMu)));&#x000D;&#x000A;GridBandwidth = max(abs(GridDiff));&#x000D;&#x000A;&#x000D;&#x000A;if (Bandwidth==15)&#x000D;&#x000A;&#x0009;if(ResourceGridEnable==0)&#x000D;&#x000A;&#x0009;&#x0009;FilterBandwidth = max(CarrierNumRBs*12*15e3.*2.^Numerology);&#x000D;&#x000A;&#x0009;else&#x000D;&#x000A;&#x0009;&#x0009;if(GridBandwidth&gt;0)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;FilterBandwidth = max(CarrierNumRBs*12*15e3.*2.^Numerology) + GridBandwidth*2;&#x000D;&#x000A;&#x0009;&#x0009;else&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;FilterBandwidth = max(CarrierNumRBs*12*15e3.*2.^Numerology);&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;if(ResourceGridEnable==0)&#x000D;&#x000A;&#x0009;&#x0009;FilterBandwidth = BandwidthTable(Bandwidth+1);&#x000D;&#x000A;&#x0009;else&#x000D;&#x000A;&#x0009;&#x0009;if(GridBandwidth&gt;0)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;FilterBandwidth = BandwidthTable(Bandwidth+1) + GridBandwidth*2;&#x000D;&#x000A;&#x0009;&#x0009;else&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;FilterBandwidth = BandwidthTable(Bandwidth+1);&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;L_Table = [4, 8, 64];&#x000D;&#x000A;Num_SSB = L_Table(SSB_Lmax + 1);&#x000D;&#x000A;ActiveSSB = [0:Num_SSB-1];&#x000D;&#x000A;&#x000D;&#x000A;Mu_BWP = [];&#x000D;&#x000A;for i = 0:NumBWPs-1&#x000D;&#x000A;&#x0009;Mu_BWP = [Mu_BWP, Numerology(mod(i, length(Numerology))+1)];&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;NumSlotsPerFrame = 10 * 2.^Mu_BWP;&#x000D;&#x000A;ActiveSlots = [];&#x000D;&#x000A;for i = 1:length(NumSlotsPerFrame)&#x000D;&#x000A;&#x0009;ActiveSlots = [ActiveSlots, 0:NumSlotsPerFrame(i)-1];&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;EVM_StartSlot = zeros(1, NumBWPs);&#x000D;&#x000A;EVM_NumSlots = 5;%% set number of demodulated slots to be 5 slots in order to speed up in constellation&#x000D;&#x000A;&#x000D;&#x000A;if(ResourceGridEnable~=1)&#x000D;&#x000A;&#x0009;warning(&apos;EVM measurements might be inaccurate in case of multiple different Numerologies setting when ResourceGridEnable for NR_Source is NO.&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;</Text>
<Item XName="BPMgr" Type="BPMgr">
<BPLines><T>Array_I64</T><D>1;0;</D></BPLines>
<BPStates><T>Array_I64</T><D>1;0;</D></BPStates></Item>
