<Item XName="CalcuEIRP" UserName="CalcuEIRP" Type="Equation">
<AutoCalc><T>Bool</T><D>0</D></AutoCalc>
<Selected><T>Bool</T><D>0</D></Selected>
<Text>using(&apos;Sweep_EIRP&apos;);&#x000D;&#x000A;&#x000D;&#x000A;%graph7B=graph_figure(&apos;EIRP_Pattern&apos;);&#x000D;&#x000A;[theta,phi]=meshgrid([0:90/64:(90/64)*63]/180*pi,[0:5:360]/180*pi);&#x000D;&#x000A;power = reshape(SSB_Power,64,73);&#x000D;&#x000A;power = power&apos;;&#x000D;&#x000A;%graph7B.add_spherical_data( phi,theta,max(power,-10)) ;&#x000D;&#x000A;&#x000D;&#x000A;power_W = 10.^(power/10)/1000;&#x000D;&#x000A;TRP = 0;&#x000D;&#x000A;for i= 1:length(theta(:,1))&#x000D;&#x000A;&#x0009;for j = 1:length(theta(1,:))&#x000D;&#x000A;&#x0009;&#x0009;TRP = TRP +pi/(2*length(theta(:,1))*length(theta(1,:)))*power_W(i,j)*sin(theta(i,j));&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;TRP = 10*log10(TRP*1000);&#x000D;&#x000A;&#x0009;</Text>
