<Item XName="CalcuEVM" UserName="CalcuEVM" Type="Equation">
<AutoCalc><T>Bool</T><D>0</D></AutoCalc>
<Selected><T>Bool</T><D>0</D></Selected>
<Text>G_SWEEP = 1;&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;AoD_Cen = 45;%%% deg&#x000D;&#x000A;ZoD_Cen = 45;%%% deg&#x000D;&#x000A;&#x000D;&#x000A;Sensitivity = 2; %%% deg&#x000D;&#x000A;&#x000D;&#x000A;AoD_Table = [AoD_Cen-Sensitivity,AoD_Cen,AoD_Cen+Sensitivity,AoD_Cen,AoD_Cen ];&#x000D;&#x000A;ZoD_Table = [ZoD_Cen,ZoD_Cen,ZoD_Cen,ZoD_Cen-Sensitivity,ZoD_Cen+Sensitivity];&#x000D;&#x000A;&#x000D;&#x000A;for j = 1:6&#x000D;&#x000A;SNR = 5*j;&#x000D;&#x000A;for i= 1:5&#x000D;&#x000A;AoD = AoD_Table(i);&#x000D;&#x000A;ZoD = ZoD_Table(i);&#x000D;&#x000A;runanalysis(&apos;Design3 Analysis&apos;);&#x000D;&#x000A;EVM_tmp(i) = getvariable(&apos;Design3 Analysis_Design3_Data&apos;,&apos;N2_BWP0PDSCHEVM&apos;); &#x000D;&#x000A;end&#x000D;&#x000A;EVM_FR2(j) = sum(EVM_tmp)/5;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;clear G_SWEEP;</Text>
<UnitUse><T>Int</T><D>2</D></UnitUse>
