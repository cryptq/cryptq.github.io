<Item XName="BWP_NumRBs" Type="PartParam">
<DataEntry>[100,133]</DataEntry>
<Description>number of PRB in BWP basd on different SCS of different numerology</Description>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="BWP_RBOffset" Type="PartParam">
<DataEntry>[0]</DataEntry>
<Description>the starting RB index of resource blocks allocated to BWP in the whole bandwidth based on specific SCS</Description>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="Bandwidth" Type="PartParam">
<DataEntry>7</DataEntry>
<Description>Bandwidth</Description>
<Enum>NR_VSA_Gen__BandWidth@5G Advanced Modem Enums</Enum>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="CellID" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>the index of cell identity</Description>
<Validate><T>Int</T><D>11</D></Validate></Item>
<Item XName="CyclicPrefix" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>normal CP or extended CP(0: Normal; 1: Extended)</Description>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="FCarrier" Type="PartParam">
<DataEntry>2e9</DataEntry>
<Description>range of frequency carrier</Description>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="MCS" Type="PartParam">
<DataEntry>[0]</DataEntry>
<Description>modulation and coding scheme (MCS) for each user</Description>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="MCSTable" Type="PartParam">
<DataEntry>[0]</DataEntry>
<Description>The MCS index table. [0~2] for CP-OFDM. [1,3,4] for DFT-s-OFDM. [0: 64QAM table | 1: 256QAM table | 2: 64QAMLowSE table | 3: DFT-64QAM table | 4: DFT-64QAMLowSE]</Description>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="Modulation" Type="PartParam">
<DataEntry>[2]</DataEntry>
<Description>modulation orders in each slot. (2:QPSK, 4:16QAM, 6:64QAM, 8:256QAM)</Description>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="NumBWPs" Type="PartParam">
<DataEntry>2</DataEntry>
<Description>number of BWPs</Description>
<Validate><T>Int</T><D>11</D></Validate></Item>
<Item XName="NumSlots" Type="PartParam">
<DataEntry>10</DataEntry>
<Description>number of slots to simulate</Description>
<Enum />
<Validate><T>Int</T><D>11</D></Validate></Item>
<Item XName="NumTxRFChains" Type="PartParam">
<DataEntry>1</DataEntry>
<Description>number of Tx RF chains</Description>
<Enum />
<Validate><T>Int</T><D>11</D></Validate></Item>
<Item XName="Numerology" Type="PartParam">
<DataEntry>[0,1]</DataEntry>
<Description>numerology(0: 15kHz;1:30kHz;2:60kHz;3:120kHz;4:240kHz)</Description>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="Numerology_k0" Type="PartParam">
<DataEntry>[0]</DataEntry>
<Description>the lowest numbered subcarrier in a common resource block for specific numerology</Description>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="OversamplingOption" Type="PartParam">
<DataEntry>2</DataEntry>
<Description>oversampling  option</Description>
<Enum>FBMC_ChannelEstimator__OversampleOption@5G Advanced Modem Enums</Enum>
<Unit><T>Int</T><D>0</D></Unit>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="PBCH_Decoding_Enable" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>enable or disable PBCH decoding.</Description>
<Enum>NR_DL_FrameSync__PBCH_Decoding_Enable@5G Advanced Modem Enums</Enum>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="PDSCH_DMRS_NumPorts" Type="PartParam">
<DataEntry>[1]</DataEntry>
<Description>number of ports for each BWP</Description>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PDSCH_DMRS_PortList" Type="PartParam">
<DataEntry>[1000]</DataEntry>
<Description>ports index, the range of each element should be in range of [1000 ~ 1011]</Description>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PDSCH_Enable" Type="PartParam">
<DataEntry>1</DataEntry>
<Description>enable or disable PDSCH and its DMRS transmission</Description>
<Enum>NR_DL_MuxOFDMSym__PDSCH_Enable@5G Advanced Modem Enums</Enum>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="PDSCH_NumOFDMSyms" Type="PartParam">
<DataEntry>[14]</DataEntry>
<Description>number of OFDM symbols for each PDSCH.</Description>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PDSCH_NumRBs" Type="PartParam">
<DataEntry>[100,68]</DataEntry>
<Description>number of resource blocks (RBs) for each PDSCH.</Description>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PDSCH_RBOffset" Type="PartParam">
<DataEntry>[0,65]</DataEntry>
<Description>the starting RB index of resource blocks allocated to the user</Description>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PDSCH_StartOFDMSym" Type="PartParam">
<DataEntry>[0]</DataEntry>
<Description>the index for the first OFDM symbol allocated to each PDSCH.</Description>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="Payload_Config" Type="PartParam">
<DataEntry>1</DataEntry>
<Description>the configuration mode of input data of D-SCH.</Description>
<Enum>NR_HARQ_Controller__Payload_Config@5G Advanced Modem Enums</Enum>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="PhaseRotation_Enable" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>enable or disable additional phase rotation specified in section 5.4 of 3GPP TS 38.211</Description>
<Enum>NR_MuxSlot__PhaseRotation_Enable@5G Advanced Modem Enums</Enum>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="PortstoRFMatrix" Type="PartParam">
<DataEntry>[1,1]</DataEntry>
<Description>unique ports (include SSB ports) to RF Chains matrix</Description>
<Enum />
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="SNR" Type="PartParam">
<DataEntry>30</DataEntry>
<Description>signal noise ratio in dB</Description>
<Tunable><T>Bool</T><D>1</D></Tunable>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="SSB_Enable" Type="PartParam">
<DataEntry>1</DataEntry>
<Description>enable or disable SS/PBCH blocks transmission</Description>
<Enum>NR_DL_MuxOFDMSym__SSB_Enable@5G Advanced Modem Enums</Enum>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="SSB_Lmax" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>number of SS/PBCH block candidates for a half frame with SS/PBCH blocks</Description>
<Enum>NR_DL_MuxOFDMSym__SSB_Lmax@5G Advanced Modem Enums</Enum>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="SSB_Numerology" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>numerology of SSB</Description>
<Enum>NR_SSB_Numerology@5G Advanced Modem Enums</Enum>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="SSB_Periodicity" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>SS/PBCH block transmission period</Description>
<Enum>NR_DL_FrameSync__SSB_Periodicity@5G Advanced Modem Enums</Enum>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="SSB_RBOffset" Type="PartParam">
<DataEntry>100</DataEntry>
<Description>the starting RB index of resource blocks allocated to SSB in the whole bandwidth based on 15kHz or 60kHz</Description>
