<Data><T>Double</T><D>16.85</D></Data></Item>
<Item XName="TIME" Type="Variable">
<Creator>GlobalEqns</Creator>
<Data><T>Double</T><D>0</D></Data></Item>
<Item XName="Time_Spacing" Type="Variable">
<Creator>GlobalEqns</Creator>
<Data><T>Double</T><D>1e-06</D></Data>
<SIUnits />
<Unit><T>Int</T><D>7004</D></Unit></Item></Item></Item>
<Item XName="Note" UserName="Note" Type="Notes">
<IsHtml><T>Bool</T><D>1</D></IsHtml>
<Selected><T>Bool</T><D>0</D></Selected>
<Text>&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: center; MARGIN: 0in 0in 0pt&quot; align=center&gt;&lt;SPAN style=&apos;FONT-SIZE: 18pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif&apos;&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;&lt;FONT face=DengXian&gt;&amp;nbsp;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoTitle style=&quot;BORDER-TOP: medium none; BORDER-RIGHT: medium none; BORDER-BOTTOM: windowtext 0.75pt solid; PADDING-BOTTOM: 1pt; PADDING-TOP: 0in; PADDING-LEFT: 0in; BORDER-LEFT: medium none; MARGIN: 0in 0in 0pt; PADDING-RIGHT: 0in&quot; align=center&gt;&lt;STRONG&gt;&lt;FONT size=5 face=Arial&gt;NR DL Tx&lt;/FONT&gt;&lt;/STRONG&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: center; MARGIN: 0in 0in 0pt&quot; align=center&gt;&lt;EM&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: Arial; mso-bidi-font-size: 12.0pt&quot;&gt;Keysight Technologies SystemVue Example&amp;nbsp;Workspace&lt;/SPAN&gt;&lt;/EM&gt;&lt;/P&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 0pt&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;&lt;?xml:namespace prefix = &quot;o&quot; ns = &quot;urn:schemas-microsoft-com:office:office&quot; /&gt;&lt;o:p&gt;&lt;FONT face=DengXian&gt;&lt;/FONT&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&amp;nbsp;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: left; MARGIN: 0in 0in 0pt&quot; align=left&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;&lt;FONT face=DengXian&gt;This example workspace demonstrates spectrum, constellation, EVM, ACLR and CCDF measurements for an NR downlink transmitter. The performance&lt;/FONT&gt;&lt;/SPAN&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Times New Roman&quot;,serif&apos;&gt; &lt;/SPAN&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;&lt;FONT face=DengXian&gt;for FR1 and FR2 are shown in different folds. And for FR1, there are two folders for SSB and BWP in one numerology and in two different numerologies.&lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: left; MARGIN: 0in 0in 0pt&quot; align=left&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;&lt;FONT face=DengXian&gt;Folder: &lt;B style=&quot;mso-bidi-font-weight: normal&quot;&gt;FR1&amp;nbsp;One Numerology&lt;/B&gt;, SSB and BWP are in the same numerology (15kHz). There are two BWPs (PDSCH) and SSB in the 15kHz CC.&lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: left; MARGIN: 0in 0in 0pt&quot; align=left&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;&lt;FONT face=DengXian&gt;Folder: &lt;B style=&quot;mso-bidi-font-weight: normal&quot;&gt;FR1&amp;nbsp;Two Numerologies&lt;/B&gt;, SSB and BWP are in different numerology (PDSCH &amp;amp;SSB: 15kHz; PDSCH: 30kHz). There are&amp;nbsp;two BWPs (PDSCH) in both 15kHz CC and 30kHz CC.&lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: left; MARGIN: 0in 0in 0pt&quot; align=left&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;&lt;FONT face=DengXian&gt;Folder: &lt;/FONT&gt;&lt;A name=OLE_LINK4&gt;&lt;B style=&quot;mso-bidi-font-weight: normal&quot;&gt;&lt;FONT face=DengXian&gt;FR2&lt;/FONT&gt;&lt;/B&gt;&lt;/A&gt;&lt;FONT face=DengXian&gt;, SSB and BWP are in the same numerology (120kHz). There are one BWP (PDSCH) and SSB in the CC.&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: left; MARGIN: 0in 0in 0pt&quot; align=left&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;&lt;FONT face=DengXian&gt;Folder: &lt;STRONG&gt;FRC&lt;/STRONG&gt;. FRC downlink cases in 3GPP 38.101-1 are shown in this folder. &lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: left; MARGIN: 0in 0in 0pt&quot; align=left&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;&lt;o:p&gt;&lt;FONT face=DengXian&gt;&amp;nbsp;&lt;/FONT&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: left; MARGIN: 0in 0in 0pt&quot; align=left&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;&lt;FONT face=DengXian&gt;Overall the followings are the features supported in the example.&lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: left; MARGIN: 0in 0in 0pt 0.5in; TEXT-INDENT: -0.25in&quot; align=left&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;&lt;FONT face=DengXian&gt;1.&lt;/FONT&gt;&lt;/SPAN&gt;&lt;SPAN style=&apos;FONT-SIZE: 10pt; FONT-FAMILY: &quot;Times New Roman&quot;,serif&apos;&gt;&amp;nbsp;&lt;/SPAN&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;&lt;FONT face=DengXian&gt;NR transmitter signal with multiple numerologies &lt;SPAN style=&quot;mso-spacerun: yes&quot;&gt;&amp;nbsp;&lt;/SPAN&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: left; MARGIN: 0in 0in 0pt 0.5in; TEXT-INDENT: -0.25in&quot; align=left&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;&lt;FONT face=DengXian&gt;2.&lt;/FONT&gt;&lt;/SPAN&gt;&lt;SPAN style=&apos;FONT-SIZE: 10pt; FONT-FAMILY: &quot;Times New Roman&quot;,serif&apos;&gt;&amp;nbsp;&lt;/SPAN&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;&lt;FONT face=DengXian&gt;Spectrum, constellation, EVM, ACLR and CCDF measurements are supported&lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: left; MARGIN: 0in 0in 0pt 0.5in; TEXT-INDENT: -0.25in&quot; align=left&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;&lt;FONT face=DengXian&gt;3.&lt;/FONT&gt;&lt;/SPAN&gt;&lt;SPAN style=&apos;FONT-SIZE: 10pt; FONT-FAMILY: &quot;Times New Roman&quot;,serif&apos;&gt;&amp;nbsp;&lt;/SPAN&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;&lt;FONT face=DengXian&gt;EVM vs SNR&amp;nbsp;graph is supported with non-linear PA in the simulation&lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: left; MARGIN: 0in 0in 0pt 0.5in; TEXT-INDENT: -0.25in&quot; align=left&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;&lt;FONT face=DengXian&gt;4.&lt;/FONT&gt;&lt;/SPAN&gt;&lt;SPAN style=&apos;FONT-SIZE: 10pt; FONT-FAMILY: &quot;Times New Roman&quot;,serif&apos;&gt;&lt;SPAN style=&quot;mso-tab-count: 2&quot;&gt;&amp;nbsp;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;&lt;FONT face=DengXian&gt;AWGN channel is added&lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: left; MARGIN: 0in 0in 0pt 0.5in; TEXT-INDENT: -0.25in&quot; align=left&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;&lt;FONT face=DengXian&gt;5.&lt;/FONT&gt;&lt;/SPAN&gt;&lt;SPAN style=&apos;FONT-SIZE: 10pt; FONT-FAMILY: &quot;Times New Roman&quot;,serif&apos;&gt;&amp;nbsp;&lt;/SPAN&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;&lt;FONT face=DengXian&gt;Performance in VSA are shown with pre-configured VSA setup-file &lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: left; MARGIN: 0in 0in 0pt 0.5in; TEXT-INDENT: -0.25in&quot; align=left&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;&lt;/SPAN&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;&lt;FONT face=DengXian&gt;6.&lt;/FONT&gt;&lt;/SPAN&gt;&lt;SPAN style=&apos;FONT-SIZE: 10pt; FONT-FAMILY: &quot;Times New Roman&quot;,serif&apos;&gt;&amp;nbsp;&lt;/SPAN&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;&lt;FONT face=DengXian&gt;Tx RF channel modeling and Tx phased array structure for FR2&lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: left; MARGIN: 0in 0in 0pt 0.5in; TEXT-INDENT: -0.25in&quot; align=left&gt;&lt;FONT face=DengXian&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;7.&lt;SPAN style=&quot;mso-tab-count: 2&quot;&gt;&amp;nbsp;&lt;/SPAN&gt;EVM measurements in FR2 are based on the average of EVM on different Rx&amp;nbsp;direction&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: left; MARGIN: 0in 0in 0pt 0.5in; TEXT-INDENT: -0.25in&quot; align=left&gt;&lt;FONT face=DengXian&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;8. EIRP and TRP measurements in FR2&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: left; MARGIN: 0in 0in 0pt 0.5in; TEXT-INDENT: -0.25in&quot; align=left&gt;&lt;FONT face=DengXian&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;9. VSA setup file generation is supported based on VSA 2018 Update 1.0&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: left; MARGIN: 0in 0in 0pt 0.5in; TEXT-INDENT: -0.25in&quot; align=left&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif&apos;&gt;&amp;nbsp;&lt;/SPAN&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: left; MARGIN: 0in 0in 0pt&quot; align=left&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;&lt;FONT face=DengXian&gt;The followings are the results after simulation:&lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: left; MARGIN: 0in 0in 0pt 0.5in; TEXT-INDENT: -0.25in&quot; align=left&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;&lt;FONT face=DengXian&gt;1.&lt;/FONT&gt;&lt;/SPAN&gt;&lt;SPAN style=&apos;FONT-SIZE: 10pt; FONT-FAMILY: &quot;Times New Roman&quot;,serif&apos;&gt;&amp;nbsp;&amp;nbsp;&lt;/SPAN&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;&lt;FONT face=DengXian&gt;Transmit spectrum (see&lt;B&gt; Spectrum &lt;/B&gt;Graph) using the data in Design Analysis_Design_Data&lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: left; MARGIN: 0in 0in 0pt 0.5in; TEXT-INDENT: -0.25in&quot; align=left&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;&lt;FONT face=DengXian&gt;2.&lt;/FONT&gt;&lt;/SPAN&gt;&lt;SPAN style=&apos;FONT-SIZE: 10pt; FONT-FAMILY: &quot;Times New Roman&quot;,serif&apos;&gt;&amp;nbsp;&amp;nbsp;&lt;/SPAN&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;&lt;FONT face=DengXian&gt;Constellation for different BWP (see &lt;B&gt;Constellation&lt;/B&gt; &lt;/FONT&gt;&lt;A name=OLE_LINK1&gt;&lt;FONT face=DengXian&gt;Graph&lt;/FONT&gt;&lt;/A&gt;&lt;FONT face=DengXian&gt;) using the data in Design Analysis_Design_Data&lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: left; MARGIN: 0in 0in 0pt 0.5in; TEXT-INDENT: -0.25in&quot; align=left&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;&lt;FONT face=DengXian&gt;3.&lt;/FONT&gt;&lt;/SPAN&gt;&lt;SPAN style=&apos;FONT-SIZE: 10pt; FONT-FAMILY: &quot;Times New Roman&quot;,serif&apos;&gt;&amp;nbsp;&amp;nbsp;&lt;/SPAN&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;&lt;FONT face=DengXian&gt;EVM vs SNR with/without non-linear PA (see &lt;B&gt;SNR vs. EVM&lt;/B&gt; Graph) using the data in WorkspaceVariables&lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: left; MARGIN: 0in 0in 0pt 0.5in; TEXT-INDENT: -0.25in&quot; align=left&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;&lt;FONT face=DengXian&gt;4.&lt;/FONT&gt;&lt;/SPAN&gt;&lt;SPAN style=&apos;FONT-SIZE: 10pt; FONT-FAMILY: &quot;Times New Roman&quot;,serif&apos;&gt;&amp;nbsp;&amp;nbsp;&lt;/SPAN&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;&lt;FONT face=DengXian&gt;ACLR (see &lt;B&gt;ACLR_Table&lt;/B&gt; Table) using the data in Design Analysis_Design_Data&lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: left; MARGIN: 0in 0in 0pt 0.5in; TEXT-INDENT: -0.25in&quot; align=left&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;&lt;FONT face=DengXian&gt;5.&lt;SPAN style=&quot;mso-tab-count: 1&quot;&gt;&amp;nbsp; &lt;/SPAN&gt;Beam pattern (Dynamic3D Graph) for FR2&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: left; MARGIN: 0in 0in 0pt 0.5in; TEXT-INDENT: -0.25in&quot; align=left&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;&lt;FONT face=DengXian&gt;6.&amp;nbsp; EIRP pattern (see&lt;STRONG&gt; EIRP_Pattern&lt;/STRONG&gt; Graph) using the data in WorkspaceVariables&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: left; MARGIN: 0in 0in 0pt 0.5in; TEXT-INDENT: -0.25in&quot; align=left&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;&lt;FONT face=DengXian&gt;7.&amp;nbsp; TRP (See &lt;STRONG&gt;TRP&lt;/STRONG&gt; Table) using the data in WorkspaceVariables&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: left; MARGIN: 0in 0in 0pt 0.5in; TEXT-INDENT: -0.25in&quot; align=left&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif&apos;&gt;&amp;nbsp;&lt;/SPAN&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Times New Roman&quot;,serif&apos;&gt;&amp;nbsp;&lt;/SPAN&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif&apos;&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: left; MARGIN: 0in 0in 0pt&quot; align=left&gt;&lt;B&gt;&lt;SPAN style=&quot;FONT-SIZE: 12pt&quot;&gt;3GPP NR EVM measurement&lt;/SPAN&gt;&lt;/B&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Times New Roman&quot;,serif&apos;&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: left; MARGIN: 0in 0in 0pt&quot; align=left&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Times New Roman&quot;,serif&apos;&gt;&amp;nbsp;&lt;/SPAN&gt;&lt;B&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/B&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: left; MARGIN: 0in 0in 0pt&quot; align=left&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;The EVM measurement in SystemVue is based on EVM model.EVM model support multi-BWPs in different Numerologies. Make sure the parameters for source and receiver are consistent.&amp;nbsp;In this example, one frame signal is used to do demodulation and get EVM&amp;nbsp;result in&amp;nbsp;one time&amp;nbsp;defined by parameter MeasInterval. Please&amp;nbsp;update this value if more signal is used for demodulation.&amp;nbsp;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: left; MARGIN: 0in 0in 0pt&quot; align=left&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;For FR1, input&amp;nbsp;EVM vs&amp;nbsp;SNR graph is gotten by sweep SNR vs. EVM with/without no-linear PA by using PAEnable in Equations. In &lt;B style=&quot;mso-bidi-font-weight: normal&quot;&gt;FR1&amp;nbsp;One Numerology,&lt;/B&gt; Bandwidth =50Mhz, (&lt;EM&gt;CarrierNumRBs&lt;/EM&gt; = 270), &lt;EM&gt;EPRE&lt;/EM&gt; = -10 (dBm/15kHz) the power of CC is 10*log10(270*12)-10 = 25.1dBm and dBc1out of PA is set to 32dBm considering the PAPR.&lt;/SPAN&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Times New Roman&quot;,serif&apos;&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: left; MARGIN: 0in 0in 0pt&quot; align=left&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;&lt;o:p&gt;&amp;nbsp;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: left; MARGIN: 0in 0in 0pt&quot; align=left&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;For FR2 EVM measurement, it is based on a set of specific directions from the AAS (active antenna system) BS (base station) which is of interest rather than the average or total EVM over the entire sphere. In this design, the direction of transmitter beam is fixed by parameters ZoD_Cen, AoD_Cen. And the receive path is set by parameters ZoD and AoD which is used in AntennaArrayTx model. 5 different position of ZoD and AoD is set to calculate the EVM in those 5 different directions. The EVM is average of those five EVM value. And it is gotten in Equation CalcuEVM. &amp;nbsp;In CalcuEVM, SNR is swept and EVM vs SNR can be get. Please disable the models for EIRP measurement to avoid long simulation time while running Equation CalcuEVM.&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: left; MARGIN: 0in 0in 0pt&quot; align=left&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;&lt;/SPAN&gt;&amp;nbsp;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: left; MARGIN: 0in 0in 0pt&quot; align=left&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;Filter is added to the demodulated signal if UseMcFilter (EVM model) is set to Yes and the same filter is used in VSA model by default setup file.&amp;nbsp;According to the definition of SNR in 3GPP, it is the signal to noise ratio in bandwidth. In this model, if filter is not used, noise&amp;nbsp;will be calculated on&amp;nbsp;the whole band of samplingrate, in this case, EVM result may be 3dB worse when OversamplingOption is set to Ratio 2 compared to set to Ratio 1. If filter is used, impairment of filter may introduce performance degradation in noiseless scenario, EVM may around -70dB instead of -120dB, but this degradation disappears in noisy scenario.&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: left; MARGIN: 0in 0in 0pt&quot; align=left&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; mso-no-proof: yes&quot;&gt;&lt;?xml:namespace prefix = &quot;v&quot; ns = &quot;urn:schemas-microsoft-com:vml&quot; /&gt;&lt;v:shapetype id=_x0000_t75 coordsize=&quot;21600,21600&quot; o:spt=&quot;75&quot; o:preferrelative=&quot;t&quot; path=&quot;m@4@5l@4@11@9@11@9@5xe&quot; filled=&quot;f&quot; stroked=&quot;f&quot;&gt;&lt;v:stroke joinstyle=&quot;miter&quot;&gt;&lt;/v:stroke&gt;&lt;v:formulas&gt;&lt;v:f eqn=&quot;if lineDrawn pixelLineWidth 0&quot;&gt;&lt;/v:f&gt;&lt;v:f eqn=&quot;sum @0 1 0&quot;&gt;&lt;/v:f&gt;&lt;v:f eqn=&quot;sum 0 0 @1&quot;&gt;&lt;/v:f&gt;&lt;v:f eqn=&quot;prod @2 1 2&quot;&gt;&lt;/v:f&gt;&lt;v:f eqn=&quot;prod @3 21600 pixelWidth&quot;&gt;&lt;/v:f&gt;&lt;v:f eqn=&quot;prod @3 21600 pixelHeight&quot;&gt;&lt;/v:f&gt;&lt;v:f eqn=&quot;sum @0 0 1&quot;&gt;&lt;/v:f&gt;&lt;v:f eqn=&quot;prod @6 1 2&quot;&gt;&lt;/v:f&gt;&lt;v:f eqn=&quot;prod @7 21600 pixelWidth&quot;&gt;&lt;/v:f&gt;&lt;v:f eqn=&quot;sum @8 21600 0&quot;&gt;&lt;/v:f&gt;&lt;v:f eqn=&quot;prod @7 21600 pixelHeight&quot;&gt;&lt;/v:f&gt;&lt;v:f eqn=&quot;sum @10 21600 0&quot;&gt;&lt;/v:f&gt;&lt;/v:formulas&gt;&lt;v:path o:extrusionok=&quot;f&quot; gradientshapeok=&quot;t&quot; o:connecttype=&quot;rect&quot;&gt;&lt;/v:path&gt;&lt;o:lock v:ext=&quot;edit&quot; aspectratio=&quot;t&quot;&gt;&lt;/o:lock&gt;&lt;/v:shapetype&gt;&lt;/SPAN&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&amp;nbsp;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: left; MARGIN: 0in 0in 0pt&quot; align=left&gt;&lt;B&gt;&lt;SPAN style=&quot;FONT-SIZE: 12pt&quot;&gt;ACLR measurement&lt;/SPAN&gt;&lt;/B&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Times New Roman&quot;,serif&apos;&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: left; MARGIN: 0in 0in 0pt&quot; align=left&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Times New Roman&quot;,serif&apos;&gt;&amp;nbsp;&lt;/SPAN&gt;&lt;B&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/B&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: left; MARGIN: 0in 0in 0pt&quot; align=left&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;ACLR is calculate by equation ACLR using spectrum data in Design Analysis_Design_Data. Please keep the parameters in ACLR equation shown below consistent with the parameters in Design.&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: left; MARGIN: 0in 0in 0pt&quot; align=left&gt;&lt;B style=&quot;mso-bidi-font-weight: normal&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;FR1 &lt;/SPAN&gt;&lt;/B&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: left; MARGIN: 0in 0in 0pt&quot; align=left&gt;&lt;B style=&quot;mso-bidi-font-weight: normal&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;&lt;/SPAN&gt;&lt;/B&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Times New Roman&quot;,serif&apos;&gt;bandwidth = 50e6; %%%Hz&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: left; MARGIN: 0in 0in 0pt&quot; align=left&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Times New Roman&quot;,serif&apos;&gt;FCarrier = 2e9; %%% Hz &lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: left; MARGIN: 0in 0in 0pt&quot; align=left&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Times New Roman&quot;,serif&apos;&gt;CarrierNumRBs = 270;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: left; MARGIN: 0in 0in 0pt&quot; align=left&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Times New Roman&quot;,serif&apos;&gt;SCS = 15e3; %%%Hz&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: left; MARGIN: 0in 0in 0pt&quot; align=left&gt;&lt;B style=&quot;mso-bidi-font-weight: normal&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;FR2&lt;/SPAN&gt;&lt;/B&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: left; MARGIN: 0in 0in 0pt&quot; align=left&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Times New Roman&quot;,serif&apos;&gt;bandwidth = 100e6; %%%Hz&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: left; MARGIN: 0in 0in 0pt&quot; align=left&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Times New Roman&quot;,serif&apos;&gt;FCarrier = 28e9; %%% Hz &lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: left; MARGIN: 0in 0in 0pt&quot; align=left&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Times New Roman&quot;,serif&apos;&gt;CarrierNumRBs = 66;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: left; MARGIN: 0in 0in 0pt&quot; align=left&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Times New Roman&quot;,serif&apos;&gt;SCS = 120e3; %%%Hz&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: left; MARGIN: 0in 0in 0pt&quot; align=left&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Times New Roman&quot;,serif&apos;&gt;&lt;o:p&gt;&amp;nbsp;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: left; MARGIN: 0in 0in 0pt&quot; align=left&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;Please run the equation if spectrum data are updated.&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: left; MARGIN: 0in 0in 0pt&quot; align=left&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;SpectrumShapping is added in Source to ensure ACLR performance.&amp;nbsp;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: left; MARGIN: 0in 0in 0pt&quot; align=left&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;&lt;/SPAN&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Times New Roman&quot;,serif&apos;&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&amp;nbsp;&lt;/P&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Times New Roman&quot;,serif&apos;&gt;&lt;o:p&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 0pt; LINE-HEIGHT: normal&quot;&gt;&lt;FONT face=&quot;Times New Roman&quot;&gt;&lt;B&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: DengXian; mso-hansi-font-family: &quot;Times New Roman&quot;; mso-bidi-font-family: &quot;Times New Roman&quot;&apos;&gt;EIRP and TRP Measurement&lt;/SPAN&gt;&lt;/B&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Times New Roman&quot;,serif; mso-fareast-font-family: DengXian&apos;&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 0pt; LINE-HEIGHT: normal&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Times New Roman&quot;,serif; mso-fareast-font-family: &quot;Times New Roman&quot;&apos;&gt;&amp;nbsp;&amp;nbsp;&lt;/SPAN&gt;&lt;B&gt;&lt;SPAN style=&apos;FONT-SIZE: 10pt; FONT-FAMILY: &quot;Times New Roman&quot;,serif; mso-fareast-font-family: &quot;Times New Roman&quot;&apos;&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/B&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 0pt; LINE-HEIGHT: normal&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 10pt; FONT-FAMILY: DengXian; mso-hansi-font-family: &quot;Times New Roman&quot;; mso-bidi-font-family: &quot;Times New Roman&quot;&apos;&gt;&lt;FONT face=&quot;Times New Roman&quot;&gt;In this example, transmitter beam is fixed to AoD_Cen and ZoD_Cen. We get EIRP (power) after transmitter in different directions by using Sweep1 on AoD which is set in AntennaArrayTx model (A4).&amp;nbsp;To fast the simulation, we put different ZoD for 64 different SSB. Value of ZoD are set by &lt;/FONT&gt;&lt;A name=OLE_LINK6&gt;&lt;/A&gt;&lt;A name=OLE_LINK5&gt;&lt;SPAN style=&quot;mso-bookmark: OLE_LINK6&quot;&gt;&lt;FONT face=&quot;Times New Roman&quot;&gt;RxThetaTable &lt;/FONT&gt;&lt;/SPAN&gt;&lt;/A&gt;&lt;FONT face=&quot;Times New Roman&quot;&gt;in Equations.&amp;nbsp; Resolution of EIRP can be set by RxThetaTable and AoD. Resolution of AoD is set in Sweep1. In this example,&amp;nbsp;Phi (AoD)is in the range [0:360) degree and Theta(ZoD) is in the range [0:90] for EIRP pattern. When Sweep1 is done, please run Equation CalcuEIRP to get the pattern of EIRP and TRP. TRP is the total radiated power in upper hemisphere. Please disable the models for EVM mearsurement in EIRP &lt;SPAN style=&apos;FONT-SIZE: 10pt; FONT-FAMILY: &quot;Times New Roman&quot;,serif; LINE-HEIGHT: 107%; mso-fareast-font-family: DengXian; mso-fareast-language: EN-US; mso-ansi-language: EN-US; mso-bidi-language: AR-SA&apos;&gt;measurement &lt;/SPAN&gt;while using Sweep1.&lt;/FONT&gt;&lt;/SPAN&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Times New Roman&quot;,serif; mso-fareast-font-family: &quot;Times New Roman&quot;&apos;&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: left; MARGIN: 0in 0in 0pt&quot; align=left&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Times New Roman&quot;,serif&apos;&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&amp;nbsp;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: left; MARGIN: 0in 0in 0pt&quot; align=left&gt;&lt;B&gt;&lt;SPAN style=&quot;FONT-SIZE: 12pt&quot;&gt;Noise Density Calculation&lt;/SPAN&gt;&lt;/B&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Times New Roman&quot;,serif&apos;&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: left; MARGIN: 0in 0in 0pt&quot; align=left&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Times New Roman&quot;,serif&apos;&gt;&amp;nbsp;&amp;nbsp;&lt;/SPAN&gt;&lt;B&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/B&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: left; MARGIN: 0in 0in 0pt&quot; align=left&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;In this part, the thermal noise is added by &lt;EM&gt;NDensity_dBm&lt;/EM&gt; in AddNDensity model which is calculated in Equation. In FR2 folder, antenna gain is removed when calculate noise density. If beam pattern is added, please remove the beam pattern gain to make sure SNR is right. SNR is set in Equation in FR2 while it is set in Parameters in other two folders. EPRE is defined in dBm/15kHz for every numerology and it is set in Osillator model to adjust the power.&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: left; MARGIN: 0in 0in 0pt&quot; align=left&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;&lt;/SPAN&gt;&amp;nbsp;&lt;/P&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: left; MARGIN: 0in 0in 0pt&quot; align=left&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;&lt;STRONG&gt;&lt;FONT size=3&gt;FRC&lt;/FONT&gt;&lt;/STRONG&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: left; MARGIN: 0in 0in 0pt&quot; align=left&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;FDD FRC table in A.3.2 and TDD FRC table in A.3.3 in 38.101-1 (V15.4.0) are supported. HAQR, TRS and PRB bunlding are not supported. Paremeters for different table are set in Equation. The rest of parameters which are not list in A.3.2/A.3.3 are set in Source model and EVM model. Please make sure parameters consistent for those two models. For SCS 15kHz and SCS 30kHz, SSB_Numerology is set as the same SCS with Numerology. But for SCS 60kHz, because there is no SSB of SCS 60kHz, SSB_Numerology is set to 30kHz in Equation. To steer clear of SSB slot, the first and second slots of SCS 60kHz are muted. For table A.3.2.2,&amp;nbsp;table A.3.2.3, table A.3.3.2&amp;nbsp;and table A.3.3.3,&amp;nbsp;MCS &lt;SPAN lang=EN-GB style=&apos;FONT-SIZE: 10pt; FONT-FAMILY: &quot;Times New Roman&quot;,serif; mso-fareast-font-family: &quot;Times New Roman&quot;; mso-fareast-language: EN-US; mso-ansi-language: EN-GB; mso-bidi-language: AR-SA&apos;&gt;&lt;FONT face=Arial&gt;Table 5.1.3.1-1 in 38.214&lt;/FONT&gt;&lt;/SPAN&gt;&amp;nbsp;is used.For table A.3.2.4 and table A.3.3.4,&amp;nbsp;MCS &lt;SPAN lang=EN-GB style=&apos;FONT-SIZE: 10pt; FONT-FAMILY: &quot;Times New Roman&quot;,serif; mso-fareast-font-family: &quot;Times New Roman&quot;; mso-fareast-language: EN-US; mso-ansi-language: EN-GB; mso-bidi-language: AR-SA&apos;&gt;&lt;FONT face=Arial&gt;Table 5.1.3.1-2 in 38.214&lt;/FONT&gt;&lt;/SPAN&gt;&amp;nbsp;is used. When Fill_OCNG is set to YES, EVM model can not demodulated correctly, so Fill_OCNG is set to NO in this design. This FRC design is based on FR1.&lt;/SPAN&gt;&lt;/P&gt;&lt;/SPAN&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: left; MARGIN: 0in 0in 0pt&quot; align=left&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Times New Roman&quot;,serif&apos;&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&amp;nbsp;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: left; MARGIN: 0in 0in 0pt&quot; align=left&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Times New Roman&quot;,serif&apos;&gt;&lt;o:p&gt;&lt;STRONG&gt;How to set parameters for NR_DL_Source&lt;/STRONG&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: left; MARGIN: 0in 0in 0pt&quot; align=left&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Times New Roman&quot;,serif&apos;&gt;&lt;o:p&gt;&lt;FONT size=2&gt;1. &lt;EM&gt;NumBWPs &lt;/EM&gt;is number of all BWPs and the size of &lt;EM&gt;Numerology &lt;/EM&gt;should equal to one or &lt;EM&gt;NumBWPs.&lt;/EM&gt;&lt;/FONT&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: left; MARGIN: 0in 0in 0pt&quot; align=left&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Times New Roman&quot;,serif&apos;&gt;&lt;o:p&gt;&lt;FONT size=2&gt;2. &lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;&lt;EM&gt;Numerology_k0&lt;/EM&gt; is&amp;nbsp; k0 for each BWP numerology when &lt;EM&gt;Resource&lt;!--__SearchResult__0--&gt;&lt;/A&gt;&lt;/SPAN&gt;GridEnable&lt;/EM&gt; is disable. Size of &lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;&lt;EM&gt;Numerology_k0&lt;/EM&gt;&lt;/SPAN&gt;&lt;EM&gt; &lt;/EM&gt;is&amp;nbsp;number of &lt;EM&gt;Numerology&lt;/EM&gt; without repetition and the order of &lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;&lt;EM&gt;Numerology_k0&lt;/EM&gt;&lt;/SPAN&gt;&lt;EM&gt; &lt;/EM&gt;should be consistent with unique &lt;EM&gt;Numerology&lt;/EM&gt;. For example, &lt;EM&gt;NumBWPs&lt;/EM&gt; = 3, &lt;EM&gt;Numerology&lt;/EM&gt; = [1,1,2], size of &lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;&lt;EM&gt;Numerology_k0 &lt;/EM&gt;&lt;/SPAN&gt;should be 2 and &lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;&lt;EM&gt;Numerology_k0&lt;/EM&gt;&lt;/SPAN&gt; = [0, 1]. &lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;&lt;EM&gt;Numerology_k0&lt;/EM&gt;&lt;/SPAN&gt;&amp;nbsp;is&amp;nbsp;0 subcarrier&amp;nbsp;for numerology&amp;nbsp;1 and&amp;nbsp;1 subcarrier&amp;nbsp;for numerology2.&amp;nbsp;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: left; MARGIN: 0in 0in 0pt&quot; align=left&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Times New Roman&quot;,serif&apos;&gt;&lt;o:p&gt;&lt;FONT size=2&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;4. Enumeration for &lt;EM&gt;Numerology&lt;/EM&gt; and for &lt;EM&gt;SSB_Numerology&lt;/EM&gt;&amp;nbsp;can be&amp;nbsp;different. &lt;EM&gt;SSB_Numerology_k0&lt;/EM&gt; is k0 for SSB numerology when&lt;EM&gt; ResourGridEnable&lt;/EM&gt; is disable and &lt;EM&gt;SSB_Enable&lt;/EM&gt; is set to YES. &lt;EM&gt;SSB_Numerology_k0&lt;/EM&gt; will be ignored if &lt;EM&gt;SSB_Numerology&lt;/EM&gt; is a repetition in &lt;EM&gt;Numerology&lt;/EM&gt;.&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: left; MARGIN: 0in 0in 0pt&quot; align=left&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Times New Roman&quot;,serif&apos;&gt;&lt;o:p&gt;&lt;FONT size=2&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;5. Size of other array parameters should equal to one or &lt;EM&gt;NumBWPs&lt;/EM&gt;.&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: left; MARGIN: 0in 0in 0pt&quot; align=left&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Times New Roman&quot;,serif&apos;&gt;&lt;o:p&gt;&lt;FONT size=2&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;6. Bus width of input port&amp;nbsp;PDSCH_Bits should equal to &lt;EM&gt;NumBWPs&lt;/EM&gt; and the order should be consistent with BWPs setting. For example, &lt;EM&gt;NumBWPs&lt;/EM&gt; = 3, &lt;EM&gt;Numerology&lt;/EM&gt; = [1,1,2], bus 0,1 of PDSCH_Bits is for numerology1 and bus&amp;nbsp;2 of PDSCH_Bits is for numerology2.&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: left; MARGIN: 0in 0in 0pt&quot; align=left&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Times New Roman&quot;,serif&apos;&gt;&lt;o:p&gt;&lt;FONT size=2&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;7. Bus width of output port&amp;nbsp;ChannelBits/ModSymbols should equal to &lt;EM&gt;NumBWPs&lt;/EM&gt; and the order should be consistent with BWPs setting. For example, &lt;EM&gt;NumBWPs&lt;/EM&gt; = 3, &lt;EM&gt;Numerology&lt;/EM&gt; = [1,1,2], bus 0,1 of ChannelBits/ModSymbols is for numerology1 and bus&amp;nbsp;2 of ChannelBits/ModSymbols is for numerology2.&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: left; MARGIN: 0in 0in 0pt&quot; align=left&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Times New Roman&quot;,serif&apos;&gt;&lt;o:p&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;8.&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;&amp;nbsp;There are three types of time domain signal output: SSBOut, BWPOut and PortsOut. Let me take an example to articulate the output form:&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: left; MARGIN: 0in 0in 0pt&quot; align=left&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;&lt;FONT face=&quot;Times New Roman&quot;&gt;Given NumBWPs = 2, PDSCH_DMRS_NumPort =[2, 4], PDSCH_DMRS_PortList&lt;SPAN style=&quot;mso-spacerun: yes&quot;&gt;&amp;nbsp; &lt;/SPAN&gt;= [1000, 1001, 1000, 1001, 1002, 1003], SSB_Enable = YES&amp;nbsp;(All these parameters are set in Source GUI)&lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: left; MARGIN: 0in 0in 0pt&quot; align=left&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;&lt;FONT face=&quot;Times New Roman&quot;&gt;Then, there are two BWPs, the first BWP (BWP#0) holds 2 PDSCH ports: port 1000 and port 1001. the second BWP (BWP#1) holds 4 PDSCH ports: port 1000, port 1001, port 1002 and port 1003.&lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: left; MARGIN: 0in 0in 0pt&quot; align=left&gt;&lt;FONT face=&quot;Times New Roman&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;SSB is configured, the port of which is 4000 per 38.211 definition. &lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: left; MARGIN: 0in 0in 0pt&quot; align=left&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;&lt;FONT face=&quot;Times New Roman&quot;&gt;SSBOut would output SSB signal alone, which is a single port, since we do not support multiple SSB in one numerology.&lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: left; MARGIN: 0in 0in 0pt&quot; align=left&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;&lt;FONT face=&quot;Times New Roman&quot;&gt;BWPOut would output signals with buswidth 6, the order is consistent with the order predefined in BWP_PortList&lt;SPAN style=&quot;mso-spacerun: yes&quot;&gt;&amp;nbsp; &lt;/SPAN&gt;= [1000, 1001, 1000, 1001, 1002, 1003].&lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: left; MARGIN: 0in 0in 0pt&quot; align=left&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;&lt;FONT face=&quot;Times New Roman&quot;&gt;PortsOut would output signals with buswidth 4, each of which holds one specific port, say port 1000, port 1001, port 1002, port 1003. &lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: left; MARGIN: 0in 0in 0pt&quot; align=left&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;&lt;FONT face=&quot;Times New Roman&quot;&gt;In this configuration, two ports&apos; signal of BWP#0 would be transmitted in first two lines of the output and four ports&apos;s signal of BWP#1 would be transmitted in all four lines of the output accordingly.&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: left; MARGIN: 0in 0in 0pt&quot; align=left&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;&lt;FONT face=&quot;Times New Roman&quot;&gt;9.&lt;/FONT&gt;&lt;/SPAN&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;&lt;FONT face=&quot;Times New Roman&quot;&gt;The size of PortstoRFMatrix is (unique(PDSCH_DMRS_PortList)+1)* NumTxRFChains if PDCCH is not enabled. 1 in above formula means SSB ports and SSB ports is always the last ports in the matrix. &lt;/FONT&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 0pt&quot;&gt;&lt;FONT face=&quot;Times New Roman&quot;&gt;&lt;FONT size=2&gt;For example, BWP_PortList=[1000,1005,1003,1000], NumTxRFChains&amp;nbsp;=2 and the size of PortstoRFMatrix should be 4*2 = 8, considering PortstoRFMatrix is [1, 0,1,1,1,1,1,1]. unique input ports&amp;nbsp;are in ascending order considering SSB port as port 4000,&amp;nbsp;input port is 1000, 1003,1005,4000. First 2 elements ([1,0]) is ports 1000 mapping matrix to RF chain1 and not mapping to RF chain2, and&amp;nbsp;for the third and 4th elements [1,1], so ports 1003 is mapping to RF chain1 and RF chain2. It is the same case for ports 1005 and 4000, they are mapping to RF chain1 and RF chain2.&lt;/FONT&gt;&lt;/FONT&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 0pt&quot;&gt;&lt;FONT face=&quot;Times New Roman&quot;&gt;&lt;FONT size=2&gt;10. The size of PortstoRFMatrix is (unique(PDSCH_DMRS_PortList)+2)* NumTxRFChains if PDCCH is enabled. PDCCH port is&amp;nbsp;in the&amp;nbsp;second last.&amp;nbsp;&lt;/FONT&gt;&lt;/FONT&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 0pt&quot;&gt;&lt;FONT face=&quot;Times New Roman&quot;&gt;&lt;FONT size=2&gt;11. When &lt;EM&gt;Resource&lt;!--__SearchResult__1--&gt;&lt;/A&gt;&lt;/SPAN&gt;GridEnable&lt;/EM&gt; is set to YES, &lt;EM&gt;N_GridStart&lt;/EM&gt; and &lt;EM&gt;SSB_N_GridStart&lt;/EM&gt; will set grid start of BWP numerologies and SSB&amp;nbsp;numerology. &lt;EM&gt;SSB_N_GridStart&lt;/EM&gt; will be invalid when &lt;EM&gt;SSB_Numerology&lt;/EM&gt; is a repetition in &lt;EM&gt;Numerology&lt;/EM&gt;.&lt;/FONT&gt;&lt;/FONT&gt;&lt;/P&gt;&lt;/SPAN&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: left; MARGIN: 0in 0in 0pt&quot; align=left&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;&lt;/SPAN&gt;&amp;nbsp;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: left; MARGIN: 0in 0in 0pt&quot; align=left&gt;&lt;/SPAN&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;Note that &lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: left; MARGIN: 0in 0in 0pt 0.5in; TEXT-INDENT: -0.25in&quot; align=left&gt;&lt;FONT face=&quot;Times New Roman&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;1.&lt;/SPAN&gt;&lt;SPAN style=&apos;FONT-SIZE: 7pt; FONT-FAMILY: &quot;Times New Roman&quot;,serif&apos;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/SPAN&gt;&lt;SPAN style=&apos;FONT-SIZE: 7pt; FONT-FAMILY: &quot;Times New Roman&quot;,serif&apos;&gt;&lt;STRONG&gt;&amp;nbsp;&lt;/STRONG&gt;&lt;/SPAN&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; mso-bidi-font-weight: bold&quot;&gt;Receiver&lt;/SPAN&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt; will introduce one SS/PBCH frame delay.&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: left; MARGIN: 0in 0in 0pt 0.5in; TEXT-INDENT: -0.25in&quot; align=left&gt;&lt;FONT face=&quot;Times New Roman&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;2.&lt;/SPAN&gt;&lt;SPAN style=&apos;FONT-SIZE: 7pt; FONT-FAMILY: &quot;Times New Roman&quot;,serif&apos;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;FONT size=2&gt;PBCH decoding is supported if parameters of PBCH_Decoding_Enable is set to Yes.&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: left; MARGIN: 0in 0in 0pt 0.5in; TEXT-INDENT: -0.25in&quot; align=left&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;&lt;FONT face=&quot;Times New Roman&quot;&gt;3.&amp;nbsp;&amp;nbsp; Run Design3 Analysis with EVM measurement and EIRP measurement enable, we will get the one EVM value at beam direction and EIRP with Phi equals to beam direction and&amp;nbsp;Theta from [0:90) degree.&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: left; MARGIN: 0in 0in 0pt 0.5in; TEXT-INDENT: -0.25in&quot; align=left&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;&lt;FONT face=&quot;Times New Roman&quot;&gt;4&amp;nbsp;&amp;nbsp;&amp;nbsp; SSB and BWP in two different numerologies is not supported in VSA, so BWP2 in&lt;STRONG&gt; FR1 Two Numerologies&lt;/STRONG&gt; can&apos;t be demodulated in VSA.&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: left; MARGIN: 0in 0in 0pt 0.5in; TEXT-INDENT: -0.25in&quot; align=left&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;&lt;FONT face=&quot;Times New Roman&quot;&gt;5.&amp;nbsp;&amp;nbsp;&amp;nbsp;VSA in FR2 takes lots of time because of the high sampling rate and mass of data to synchronization in VSA.&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: left; MARGIN: 0in 0in 0pt 0.5in; TEXT-INDENT: -0.25in&quot; align=left&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;&lt;FONT face=&quot;Times New Roman&quot;&gt;6.&amp;nbsp;&amp;nbsp; VSA setup file is based on VSA 2018 Update 1.0. Please exist VSA instance before starting new simulation.&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: left; MARGIN: 0in 0in 0pt 0.5in; TEXT-INDENT: -0.25in&quot; align=left&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 10pt; FONT-FAMILY: DengXian; mso-hansi-font-family: &quot;Times New Roman&quot;; mso-bidi-font-family: &quot;Times New Roman&quot;&apos;&gt;&lt;FONT face=&quot;Times New Roman&quot;&gt;7.&amp;nbsp;&amp;nbsp; Only SSB &lt;SPAN style=&apos;FONT-SIZE: 10pt; FONT-FAMILY: &quot;Times New Roman&quot;,serif; LINE-HEIGHT: 107%; mso-fareast-font-family: DengXian; mso-fareast-language: EN-US; mso-ansi-language: EN-US; mso-bidi-language: AR-SA&apos;&gt;synchronization&lt;/SPAN&gt; is supported in NR DL receiver, so SSB should be enable in this example. EVM measurement is taken&amp;nbsp;on PDSCH, so PDSCH should also be enable in this example.&amp;nbsp;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: left; MARGIN: 0in 0in 0pt 0.5in; TEXT-INDENT: -0.25in&quot; align=left&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 10pt; FONT-FAMILY: DengXian; mso-hansi-font-family: &quot;Times New Roman&quot;; mso-bidi-font-family: &quot;Times New Roman&quot;&apos;&gt;&lt;FONT face=&quot;Times New Roman&quot;&gt;8.&amp;nbsp;&amp;nbsp;&amp;nbsp;Change the parameters of spectrum shapping in Source will affect ACLR.&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: left; MARGIN: 0in 0in 0pt 0.5in; TEXT-INDENT: -0.25in&quot; align=left&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 10pt; FONT-FAMILY: DengXian; mso-hansi-font-family: &quot;Times New Roman&quot;; mso-bidi-font-family: &quot;Times New Roman&quot;&apos;&gt;&lt;FONT face=&quot;Times New Roman&quot;&gt;9.&amp;nbsp;&amp;nbsp; SSB and&amp;nbsp;BWP overlapping in frequency domain&amp;nbsp;is not allowing in this example.&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: left; MARGIN: 0in 0in 0pt 0.5in; TEXT-INDENT: -0.25in&quot; align=left&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 10pt; FONT-FAMILY: DengXian; mso-hansi-font-family: &quot;Times New Roman&quot;; mso-bidi-font-family: &quot;Times New Roman&quot;&apos;&gt;&lt;FONT face=&quot;Times New Roman&quot;&gt;10. SSB_RBOffset is based on 15kHz when SCS of SSB is 15kHz and 30kHz and SSB_RBOffset is based on 60kHz when SCS of SSB is 120kHz.&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: left; MARGIN: 0in 0in 0pt 0.5in; TEXT-INDENT: -0.25in&quot; align=left&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 10pt; FONT-FAMILY: DengXian; mso-hansi-font-family: &quot;Times New Roman&quot;; mso-bidi-font-family: &quot;Times New Roman&quot;&apos;&gt;&lt;FONT face=&quot;Times New Roman&quot;&gt;11.&amp;nbsp;240kHz SSB is not&amp;nbsp;supported&amp;nbsp;now.&amp;nbsp;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: left; MARGIN: 0in 0in 0pt 0.5in; TEXT-INDENT: -0.25in&quot; align=left&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 10pt; FONT-FAMILY: DengXian; mso-hansi-font-family: &quot;Times New Roman&quot;; mso-bidi-font-family: &quot;Times New Roman&quot;&apos;&gt;&lt;FONT face=&quot;Times New Roman&quot;&gt;12. EVM model is based on 3GPP specification version 15.2.0&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: left; MARGIN: 0in 0in 0pt 0.5in; TEXT-INDENT: -0.25in&quot; align=left&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 10pt; FONT-FAMILY: DengXian; mso-hansi-font-family: &quot;Times New Roman&quot;; mso-bidi-font-family: &quot;Times New Roman&quot;&apos;&gt;&lt;FONT face=&quot;Times New Roman&quot;&gt;13. Datasheets are deleted because of the size of example, please rerun analysis to get the datasheet.&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: left; MARGIN: 0in 0in 0pt 0.5in; TEXT-INDENT: -0.25in&quot; align=left&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 10pt; FONT-FAMILY: DengXian; mso-hansi-font-family: &quot;Times New Roman&quot;; mso-bidi-font-family: &quot;Times New Roman&quot;&apos;&gt;&lt;FONT face=&quot;Times New Roman&quot;&gt;14. Constellation&amp;nbsp;will not be shown in figure Constellation unless the parameter SaveConstellation of EVM is set to YES. In case&amp;nbsp;SaveConstellation is NO, errors might be posted when opening constellation figures&amp;nbsp;since no&amp;nbsp;related data is available. However,&amp;nbsp;the errors&amp;nbsp;will not have any impact on the simulation and the results of&amp;nbsp;EVM and other measurements.&amp;nbsp;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: left; MARGIN: 0in 0in 0pt 0.5in; TEXT-INDENT: -0.25in&quot; align=left&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 10pt; FONT-FAMILY: DengXian; mso-hansi-font-family: &quot;Times New Roman&quot;; mso-bidi-font-family: &quot;Times New Roman&quot;&apos;&gt;&lt;FONT face=&quot;Times New Roman&quot;&gt;15.For Design3, please set OversamplingOption to Ratio 4 or more to run analysis and get ACLR. Now OversamplingOption is set to Ratio 1 to reduce the size of this example.&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: left; MARGIN: 0in 0in 0pt 0.5in; TEXT-INDENT: -0.25in&quot; align=left&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 10pt; FONT-FAMILY: DengXian; mso-hansi-font-family: &quot;Times New Roman&quot;; mso-bidi-font-family: &quot;Times New Roman&quot;&apos;&gt;&lt;FONT face=&quot;Times New Roman&quot;&gt;16.Number of slots of demodulated PDSCH is set to 5 (except FRC folder )by parameters EVM_NumSlots which is set in Equation in order to speed up plot of constellation when SaveConstellation is set to Yes.&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: left; MARGIN: 0in 0in 0pt 0.5in; TEXT-INDENT: -0.25in&quot; align=left&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 10pt; FONT-FAMILY: DengXian; mso-hansi-font-family: &quot;Times New Roman&quot;; mso-bidi-font-family: &quot;Times New Roman&quot;&apos;&gt;&lt;FONT face=&quot;Times New Roman&quot;&gt;17.&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 10pt; FONT-FAMILY: DengXian; mso-hansi-font-family: &quot;Times New Roman&quot;; mso-bidi-font-family: &quot;Times New Roman&quot;&apos;&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian&quot;&gt;&lt;FONT face=&quot;Times New Roman&quot;&gt;Parameters&amp;nbsp;Bandwidth is used in this example and the realationship between bandwidth and number of RBs are shown in 38.104 table 5.3.2-1 and table 5.3.2-2. The configuration of subcarrier spacing 240kHz is also shown below. FrequencyRange is gotten by parameter FCarrierTx.&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: left; MARGIN: 0in 0in 0pt 0.5in; TEXT-INDENT: -0.25in&quot; align=left&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 10pt; FONT-FAMILY: DengXian; mso-hansi-font-family: &quot;Times New Roman&quot;; mso-bidi-font-family: &quot;Times New Roman&quot;&apos;&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 10pt; FONT-FAMILY: DengXian; mso-hansi-font-family: &quot;Times New Roman&quot;; mso-bidi-font-family: &quot;Times New Roman&quot;&apos;&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;&lt;FONT face=&quot;Times New Roman&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 10pt; FONT-FAMILY: DengXian; mso-hansi-font-family: &quot;Times New Roman&quot;; mso-bidi-font-family: &quot;Times New Roman&quot;&apos;&gt;18.&lt;SPAN style=&apos;FONT-SIZE: 14px; FONT-FAMILY: -apple-system, BlinkMacSystemFont, &quot;Segoe UI&quot;, Roboto, Oxygen, Ubuntu, &quot;Fira Sans&quot;, &quot;Droid Sans&quot;, &quot;Helvetica Neue&quot;, sans-serif; WHITE-SPACE: normal; WORD-SPACING: 0px; TEXT-TRANSFORM: none; FLOAT: none; FONT-WEIGHT: 400; COLOR: rgb(23,43,77); FONT-STYLE: normal; TEXT-ALIGN: left; ORPHANS: 2; WIDOWS: 2; DISPLAY: inline !important; LETTER-SPACING: normal; BACKGROUND-COLOR: rgb(255,255,255); TEXT-INDENT: 0px; font-variant-ligatures: normal; font-variant-caps: normal; -webkit-text-stroke-width: 0px; text-decoration-style: initial; text-decoration-color: initial&apos;&gt;&lt;FONT color=#000000 size=2 face=&quot;Times New Roman&quot;&gt;EVM model will internally calculate&amp;nbsp;Numerology_k0 and SSB_Numerology_k0 with the configured GridStart and SSB_GridStart according to definition in 5.3 of 38.211. &lt;/FONT&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;EVM measurements might be&amp;nbsp;wrong in case of multiple different Numerologies setting&amp;nbsp;with Resource&lt;!--__SearchResult__2--&gt;&lt;/A&gt;&lt;/SPAN&gt;GridEnable for NR_Source&amp;nbsp;disabled, where Numerology_k0 and SSB_Numerology_k0 are set manually by users, unless these two parameters&amp;nbsp;are calculated&amp;nbsp;and set correctly. Therefore, Resource&lt;!--__SearchResult__3--&gt;&lt;/A&gt;&lt;/SPAN&gt;GridEnable is set to YES by default in this example.&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: left; MARGIN: 0in 0in 0pt 0.5in; TEXT-INDENT: -0.25in&quot; align=left&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 10pt; FONT-FAMILY: DengXian; mso-hansi-font-family: &quot;Times New Roman&quot;; mso-bidi-font-family: &quot;Times New Roman&quot;&apos;&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian&quot;&gt;&lt;FONT face=&quot;Times New Roman&quot;&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&amp;nbsp;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: left; MARGIN: 0in 0in 0pt 0.5in; TEXT-INDENT: -0.25in&quot; align=left&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 10pt; FONT-FAMILY: DengXian; mso-hansi-font-family: &quot;Times New Roman&quot;; mso-bidi-font-family: &quot;Times New Roman&quot;&apos;&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian&quot;&gt;&lt;/SPAN&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: DengXian&quot;&gt;&lt;FONT face=Arial&gt;&lt;A name=_Hlk497144372&gt;&lt;SPAN lang=EN-GB style=&apos;mso-fareast-font-family: &quot;Yu Mincho&quot;&apos;&gt;&lt;FONT size=2&gt;&lt;STRONG&gt;Table 5.3.2-1: &lt;/STRONG&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/A&gt;&lt;FONT size=2&gt;&lt;STRONG&gt;&lt;SPAN lang=EN-GB style=&apos;mso-fareast-font-family: &quot;Yu Mincho&quot;&apos;&gt;Transmission bandwidth configuration N&lt;SUB&gt;RB&lt;/SUB&gt; for FR1&lt;/SPAN&gt;&lt;SPAN lang=EN-GB style=&apos;mso-fareast-font-family: &quot;Yu Mincho&quot;; mso-fareast-language: ZH-CN&apos;&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/STRONG&gt;&lt;/FONT&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 0pt; mso-list: l0 level1 lfo1&quot;&gt;&#x000D;&#x000A;&lt;TABLE class=MsoNormalTable style=&quot;BORDER-TOP: medium none; BORDER-RIGHT: medium none; WIDTH: 99.98%; BORDER-COLLAPSE: collapse; BORDER-BOTTOM: medium none; BORDER-LEFT: medium none; MARGIN: auto 4.85pt; mso-border-alt: solid black .5pt; mso-yfti-tbllook: 1536; mso-padding-alt: 0in 0in 0in 0in; mso-border-insideh: .5pt solid black; mso-border-insidev: .5pt solid black; mso-table-overlap: never; mso-table-lspace: 7.1pt; mso-table-rspace: 7.1pt; mso-table-anchor-vertical: paragraph; mso-table-anchor-horizontal: column; mso-table-left: -.55pt; mso-table-top: .05pt&quot; cellSpacing=0 cellPadding=0 width=&quot;99%&quot; align=left border=1&gt;&#x000D;&#x000A;&lt;TBODY&gt;&#x000D;&#x000A;&lt;TR style=&quot;mso-yfti-irow: 0; mso-yfti-firstrow: yes&quot;&gt;&#x000D;&#x000A;&lt;TD style=&quot;BORDER-TOP: black 1pt solid; BORDER-RIGHT: black 1pt solid; WIDTH: 5.9%; BORDER-BOTTOM: black 1pt solid; PADDING-BOTTOM: 0in; PADDING-TOP: 0.75pt; PADDING-LEFT: 4.05pt; BORDER-LEFT: black 1pt solid; PADDING-RIGHT: 4.05pt; BACKGROUND-COLOR: transparent; mso-border-alt: solid black .5p