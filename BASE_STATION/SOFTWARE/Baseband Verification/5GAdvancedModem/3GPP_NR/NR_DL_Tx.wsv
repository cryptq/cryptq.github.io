<Text>%%%%%%%%%%%%%%%%%%%%%%%%%% range check %%%%%%%%%%%%%%%%%%%%%%%%%%%%&#x000D;&#x000A;if ((FCarrier &lt; 450e6) &amp;&amp; (FCarrierTx &gt; 6e9))&#x000D;&#x000A;error(&apos;FCarrier is not in the legit range: {FR1: 450 MHz ~ 6000 MHz}&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;BandwidthTable =[5e6,10e6,15e6,20e6,25e6,30e6,40e6,50e6,60e6,70e6,80e6,90e6,100e6,200e6,400e6];&#x000D;&#x000A;&#x000D;&#x000A;NumRBsMu0 = [25,52,79,106,133,160,216,270];&#x000D;&#x000A;NumRBsMu1 = [11,24,38,51,65,78,106,133,162,189,217,245,273];&#x000D;&#x000A;NumRBsMu2 = [0,11,18,24,31,38,51,65,79,93,107,121,135];&#x000D;&#x000A;&#x000D;&#x000A;MCS_IndexList = [4, 24, 23];&#x000D;&#x000A;MCS_TableList = [0, 0, 1];&#x000D;&#x000A;&#x000D;&#x000A;%%%%%%%%%%% AWGN noise density&#x000D;&#x000A;EPRE = -10%%% dBm/15kHz&#x000D;&#x000A;NDensity_dBm = EPRE - SNR - 10*log10(15e3);&#x000D;&#x000A;&#x000D;&#x000A;%%%%%%%%%%%%%common parameters for all FRC&#x000D;&#x000A;CORESET_NumSyms = [2];&#x000D;&#x000A;CORESET_RB_Bitmap =ones(1,46);&#x000D;&#x000A;PDSCH_MappingType = [0];&#x000D;&#x000A;PDSCH_StartOFDMSym = [2];&#x000D;&#x000A;PDSCH_NumOFDMSyms = [12];&#x000D;&#x000A;PDSCH_DMRS_TypeA_Pos = [2];&#x000D;&#x000A;PDSCH_DMRS_ConfigType = [0];&#x000D;&#x000A;PDSCH_DMRS_AddPos =[2];&#x000D;&#x000A;SSB_Enable = 1;&#x000D;&#x000A;&#x000D;&#x000A;%%%%%%%%%%%%%%%%%%%%&#x000D;&#x000A;if (Bandwidth==15)&#x000D;&#x000A;&#x0009;error(&apos;UserDefined Bandwidth is not supported by FRC simulation&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;if (OperationMode == 0) %FDD&#x000D;&#x000A;&#x0009;switch(FRC_Table_FDD)&#x000D;&#x000A;&#x0009;&#x0009;case 0   %%%%%SCS 15 kHz, FDD, QPSK 1/3&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;if(Bandwidth &gt; 7)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;error(&apos;Bandwidth more than 50MHz are not supported in Table A3.2.2-1&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;Numerology = [0];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;BWP_NumRBs = NumRBsMu0(Bandwidth+1);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDSCH_NumRBs = NumRBsMu0(Bandwidth+1);&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDSCH_NumAllocatedSlots = [9];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDSCH_AllocatedSlots = [1:9];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDCCH_NumAllocatedSlots  = [9];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDCCH_AllocatedSlots = [1:9];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;MCS = [4];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;MCSTable = [0];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;SSB_Numerology = [0];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;SSB_Periodicity = 1;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;SSB_ActiveBlocks = [0,1];&#x000D;&#x000A;&#x0009;&#x0009;case 1   %%%%% SCS 30 kHz, FDD, QPSK 1/3&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;if(Bandwidth ==9 ||Bandwidth ==13 ||Bandwidth ==14 )&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;error(&apos;Bandwidth 70MHz, 200MHz and 400MHz are not supported in Table A3.2.2-2&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;if(Bandwidth ==0)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;SSB_Enable =0;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;Numerology = [1];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;BWP_NumRBs = NumRBsMu1(Bandwidth+1);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDSCH_NumRBs = NumRBsMu1(Bandwidth+1);&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDSCH_NumAllocatedSlots = [19];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDSCH_AllocatedSlots = [1:19];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDCCH_NumAllocatedSlots  = [19];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDCCH_AllocatedSlots = [1:19];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;MCS = [4];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;MCSTable = [0];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;SSB_Numerology = [1];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;SSB_Periodicity = 1;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;SSB_ActiveBlocks = [0,1];&#x000D;&#x000A;&#x0009;&#x0009;case 2  %%%%%%%%%% SCS 60 kHz, FDD, QPSK 1/3&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;if(Bandwidth ==9 ||Bandwidth ==0 ||Bandwidth ==13 ||Bandwidth ==14 )&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;error(&apos;Bandwidth 5MHz, 70MHz, 200MHz and 400MHzare not supported in Table A3.2.2-3&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;Numerology = [2];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;BWP_NumRBs = NumRBsMu2(Bandwidth+1);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDSCH_NumRBs = NumRBsMu2(Bandwidth+1);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDSCH_NumAllocatedSlots = [38];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDSCH_AllocatedSlots = [2:39];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDCCH_NumAllocatedSlots  = [38];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDCCH_AllocatedSlots = [2:39];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;MCS = [4];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;MCSTable = [0];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;SSB_Numerology = [1];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;SSB_Periodicity = 1;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;SSB_ActiveBlocks = [0,1];&#x000D;&#x000A;&#x0009;&#x0009;case 3   %%%%%SCS 15 kHz, FDD, 64QAM&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;if(Bandwidth &gt; 7)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;error(&apos;Bandwidth more than 50MHz are not supported in Table A3.2.3-1&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;Numerology = [0];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;BWP_NumRBs = NumRBsMu0(Bandwidth+1);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDSCH_NumRBs = NumRBsMu0(Bandwidth+1);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDSCH_NumAllocatedSlots = [9];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDSCH_AllocatedSlots = [1:9];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDCCH_NumAllocatedSlots  = [9];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDCCH_AllocatedSlots = [1:9];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;MCS = [24];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;MCSTable = [0];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;SSB_Numerology = [0];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;SSB_Periodicity = 1;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;SSB_ActiveBlocks = [0,1];&#x000D;&#x000A;&#x0009;&#x0009;case 4   %%%%% SCS 30 kHz, FDD, 64QAM&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;if(Bandwidth ==9 ||Bandwidth ==11 ||Bandwidth ==13 ||Bandwidth ==14 )&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;error(&apos;Bandwidth 70MHz, 90MHz, 200MHz and 400MHz are not supported in Table A3.2.3-2&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;if(Bandwidth ==0)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;SSB_Enable =0;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;Numerology = [1];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;BWP_NumRBs = NumRBsMu1(Bandwidth+1);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDSCH_NumRBs = NumRBsMu1(Bandwidth+1);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDSCH_NumAllocatedSlots = [19];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDSCH_AllocatedSlots = [1:19];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDCCH_NumAllocatedSlots  = [19];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDCCH_AllocatedSlots = [1:19];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;MCS = [24];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;MCSTable = [0];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;SSB_Numerology = [1];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;SSB_Periodicity = 1;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;SSB_ActiveBlocks = [0,1];&#x000D;&#x000A;&#x0009;&#x0009;case 5  %%%%%%%%%% SCS 60 kHz, FDD, 64QAM&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;if(Bandwidth ==9 ||Bandwidth ==0 ||Bandwidth ==11 ||Bandwidth ==13 ||Bandwidth ==14  )&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;error(&apos;Bandwidth 5MHz, 70MHz, 90MHz, 200MHz and 400MHzare not supported in Table A3.2.2-3&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;Numerology = [2];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;BWP_NumRBs = NumRBsMu2(Bandwidth+1);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDSCH_NumRBs = NumRBsMu2(Bandwidth+1);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDSCH_NumAllocatedSlots = [38];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDSCH_AllocatedSlots = [2:39];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDCCH_NumAllocatedSlots  = [38];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDCCH_AllocatedSlots = [2:39];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;MCS = [24];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;MCSTable = [0];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;SSB_Numerology = [1];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;SSB_Periodicity = 1;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;SSB_ActiveBlocks = [0,1];&#x000D;&#x000A;&#x0009;&#x0009;case 6   %%%%%SCS 15 kHz, FDD, 256QAM&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;if(Bandwidth &gt; 7)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;error(&apos;Bandwidth more than 50MHz are not supported in Table A3.2.4-1&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;Numerology = [0];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;BWP_NumRBs = NumRBsMu0(Bandwidth+1);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDSCH_NumRBs = NumRBsMu0(Bandwidth+1);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDSCH_NumAllocatedSlots = [9];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDSCH_AllocatedSlots = [1:9];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDCCH_NumAllocatedSlots  = [9];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDCCH_AllocatedSlots = [1:9];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;MCS = [23];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;MCSTable = [1];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;SSB_Numerology = [0];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;SSB_Periodicity = 1;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;SSB_ActiveBlocks = [0,1];&#x000D;&#x000A;&#x0009;&#x0009;case 7   %%%%% SCS 30 kHz, FDD, 256QAM&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;if(Bandwidth ==9 ||Bandwidth ==11 ||Bandwidth ==13 ||Bandwidth ==14 )&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;error(&apos;Bandwidth 70MHz, 90MHz, 200MHz and 400MHz are not supported in Table A3.2.4-2&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;if(Bandwidth ==0)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;SSB_Enable =0;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;Numerology = [1];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;BWP_NumRBs = NumRBsMu1(Bandwidth+1);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDSCH_NumRBs = NumRBsMu1(Bandwidth+1);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDSCH_NumAllocatedSlots = [19];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDSCH_AllocatedSlots = [1:19];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDCCH_NumAllocatedSlots  = [19];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDCCH_AllocatedSlots = [1:19];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;MCS = [23];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;MCSTable = [1];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;SSB_Numerology = [1];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;SSB_Periodicity = 1;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;SSB_ActiveBlocks = [0,1];&#x000D;&#x000A;&#x0009;&#x0009;case 8  %%%%%%%%%% SCS 60 kHz, FDD, 256QAM&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;if(Bandwidth ==9 ||Bandwidth ==0 ||Bandwidth ==11 ||Bandwidth ==13 ||Bandwidth ==14  )&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;error(&apos;Bandwidth 5MHz, 70MHz, 90MHz, 200MHz and 400MHzare not supported in Table A3.2.4-3&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;Numerology = [2];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;BWP_NumRBs = NumRBsMu2(Bandwidth+1);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDSCH_NumRBs = NumRBsMu2(Bandwidth+1);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDSCH_NumAllocatedSlots = [38];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDSCH_AllocatedSlots = [2:39];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDCCH_NumAllocatedSlots  = [38];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDCCH_AllocatedSlots = [2:39];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;MCS = [23];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;MCSTable = [1];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;SSB_Numerology = [1];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;SSB_Periodicity = 1;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;SSB_ActiveBlocks = [0,1];&#x000D;&#x000A;&#x0009;&#x0009;otherwise&#x000D;&#x000A;&#x0009;end&#x0009;&#x000D;&#x000A;&#x0009;&#x000D;&#x000A;&#x0009;EVM_StartSlot = [PDSCH_AllocatedSlots(1)];&#x000D;&#x000A;&#x0009;EVM_NumSlots = PDSCH_NumAllocatedSlots;&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;switch(FRC_Table_TDD)&#x000D;&#x000A;&#x0009;&#x0009;case {0,3,6}  %%%%%0:SCS 15 kHz, TDD, QPSK 1/3&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;%%%%%3:SCS 15 kHz, TDD, 64QAM 3/4&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;%%%%%6:SCS 15 kHz, TDD, 256QAM 4/5&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;if(Bandwidth &gt; 7)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;error(&apos;Bandwidth more than 50MHz are not supported in Table A3.3.%d-1&apos;, (floor(FRC_Table_TDD/3)+2));&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;Numerology = [0];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;BWP_NumRBs = NumRBsMu0(Bandwidth+1);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDSCH_NumRBs = NumRBsMu0(Bandwidth+1);&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDSCH_NumAllocatedSlots = [5];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDSCH_AllocatedSlots = [1,2,5,6,7];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDCCH_NumAllocatedSlots  = PDSCH_NumAllocatedSlots;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDCCH_AllocatedSlots = PDSCH_AllocatedSlots;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;MCS = MCS_IndexList(floor(FRC_Table_TDD/3)+1);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;MCSTable = MCS_TableList(floor(FRC_Table_TDD/3)+1);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;SSB_Numerology = [0];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;SSB_Periodicity = 1;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;SSB_ActiveBlocks = [0,1];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;EVM_StartSlot = [5];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;EVM_NumSlots = [3];&#x000D;&#x000A;&#x0009;&#x0009;case {1,4,7}  %%%%%1:SCS 30 kHz, TDD, QPSK 1/3&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;%%%%%4:SCS 30 kHz, TDD, 64QAM 3/4&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;%%%%%7:SCS 30 kHz, TDD, 256QAM 4/5&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;if(Bandwidth ==9 || Bandwidth ==11 ||Bandwidth ==13 ||Bandwidth ==14 )&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;error(&apos;Bandwidth 70MHz, 90MHz, 200MHz and 400MHz are not supported in A3.3.%d-2&apos;, (floor(FRC_Table_TDD/3)+2));&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;if(Bandwidth ==0)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;SSB_Enable =0;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;Numerology = [1];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;BWP_NumRBs = NumRBsMu1(Bandwidth+1);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDSCH_NumRBs = NumRBsMu1(Bandwidth+1);&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDSCH_NumAllocatedSlots = [13];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDSCH_AllocatedSlots = [1:6,10:16];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDCCH_NumAllocatedSlots  = PDSCH_NumAllocatedSlots;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDCCH_AllocatedSlots = PDSCH_AllocatedSlots;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;MCS = MCS_IndexList(floor(FRC_Table_TDD/3)+1);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;MCSTable = MCS_TableList(floor(FRC_Table_TDD/3)+1);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;SSB_Numerology = [1];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;SSB_Periodicity = 1;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;SSB_ActiveBlocks = [0,1];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;EVM_StartSlot = [10];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;EVM_NumSlots = [7];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;case {2,5,8}  %%%%%2:SCS 60 kHz, TDD, QPSK 1/3&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;%%%%%5:SCS 60 kHz, TDD, 64QAM 3/4&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;%%%%%8:SCS 60 kHz, TDD, 256QAM 4/5&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;if(Bandwidth ==9 ||Bandwidth ==0 || Bandwidth ==11 ||Bandwidth ==13 ||Bandwidth ==14 )&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;error(&apos;Bandwidth 5MHz, 70MHz, 90MHz, 200MHz and 400MHzare not supported in A3.3.%d-3&apos;, (floor(FRC_Table_TDD/3)+2));&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;Numerology = [2];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;BWP_NumRBs = NumRBsMu2(Bandwidth+1);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDSCH_NumRBs = NumRBsMu2(Bandwidth+1);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDSCH_NumAllocatedSlots = [26];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDSCH_AllocatedSlots = [2:13,20:33];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDCCH_NumAllocatedSlots  = PDSCH_NumAllocatedSlots;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PDCCH_AllocatedSlots = PDSCH_AllocatedSlots;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;MCS = MCS_IndexList(floor(FRC_Table_TDD/3)+1);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;MCSTable = MCS_TableList(floor(FRC_Table_TDD/3)+1);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;SSB_Numerology = [1];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;SSB_Periodicity = 1;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;SSB_ActiveBlocks = [0,1];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;EVM_StartSlot = [2];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;EVM_NumSlots = [12];&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;&#x0009;otherwise&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;FilterBandwidth = BandwidthTable(Bandwidth+1);&#x000D;&#x000A;&#x000D;&#x000A;%%%%%%%%%%%%%%%%%default parameters&#x000D;&#x000A;ResourceGridEnable = 1;&#x000D;&#x000A;N_GridStart =[0];&#x000D;&#x000A;SSB_N_GridStart =0; &#x000D;&#x000A;GridStart = [0];%%%%%% for EVM model,please make sure GridStart is consistent with N_GridStart&#x000D;&#x000A;SSB_GridStart = 0;%%%%%% for EVM model,please make sure SSB_GridStart is consistent with SSB_N_GridStart&#x000D;&#x000A;&#x000D;&#x000A;if(ResourceGridEnable~=1)&#x000D;&#x000A;&#x0009;warning(&apos;EVM measurements might be inaccurate in case of multiple different Numerologies setting when ResourceGridEnable for NR_Source is NO.&apos;);&#x000D;&#x000A;end&#x0009;&#x000D;&#x000A;&#x000D;&#x000A;%%%%%%%%%%%%%%%%%%samplingRate&#x000D;&#x000A;SamplingRate = 2.^ceil(log2(BandwidthTable(Bandwidth+1)/15e3))*2^(OversamplingOption)*15e3;&#x000D;&#x000A;</Text>
