<Item XName="P1" Type="PartPin">
<Direction><T>Int</T><D>0</D></Direction>
<IsMultiport><T>Bool</T><D>1</D></IsMultiport>
<PartID>NR_DL_Source_1</PartID>
<PinName>HARQ_Bits</PinName>
<SchObject>Part12</SchObject>
<TermNum>8</TermNum>
<Item XName="Subterminals" Type="SerItem">
<Item XName="T1" Type="SubTerm">
<NetName>8</NetName></Item></Item></Item></Item></Item>
<Item XName="Equations" Type="Equation">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>%%%%%%%%caculate number of ports&#x000D;&#x000A;%NumPortsOut = length(unique(PDSCH_DMRS_PortList));&#x000D;&#x000A;&#x000D;&#x000A;%%%%%%%%%%%%%%%%%%%%%%%get CarrierNumRBs from bandwidth and frequency range&#x000D;&#x000A;BandwidthTable =[5e6,10e6,15e6,20e6,25e6,30e6,40e6,50e6,60e6,70e6,80e6,90e6,100e6,200e6,400e6];&#x000D;&#x000A;if (Bandwidth==15)&#x000D;&#x000A;&#x0009;CarrierNumRBs = UserDefinedCarrierNumRBs;&#x000D;&#x000A;&#x0009;FFTSize = 2.^ceil(log2(CarrierNumRBs*12)).*2^(OversamplingOption);&#x000D;&#x000A;&#x0009;SamplingRate = max(FFTSize*15e3.*2.^Numerology);&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;SamplingRate = 2.^ceil(log2(BandwidthTable(Bandwidth+1)/15e3))*2^(OversamplingOption)*15e3;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;%%%%%%%%%%% AWGN noise density&#x000D;&#x000A;EPRE = -10%%% dBm/15kHz&#x000D;&#x000A;PAEnable = 1;%%%0: disable  1:enable&#x000D;&#x000A;&#x000D;&#x000A;NDensity_dBm = EPRE - SNR - 10*log10(15e3);&#x000D;&#x000A;&#x000D;&#x000A;%%%%%%%%%%%%%%set SlotIgnored&#x000D;&#x000A;SlotPerFrame = 10 * 2^Numerology;&#x000D;&#x000A;&#x000D;&#x000A;SSB_Periodicity_FrameNum = 0.5 * 2^SSB_Periodicity;&#x000D;&#x000A;SlotIgnored = floor( SSB_Periodicity_FrameNum *  SlotPerFrame);&#x000D;&#x000A;&#x000D;&#x000A;%%%%%%%%%%%%%%%%%default parameters&#x000D;&#x000A;ResourceGridEnable = 1;&#x000D;&#x000A;N_GridStart =[0];&#x000D;&#x000A;SSB_N_GridStart =0; &#x000D;&#x000A;GridStart = [0];%%%%%% for EVM model,please make sure GridStart is consistent with N_GridStart&#x000D;&#x000A;SSB_GridStart = 0;%%%%%% for EVM model,please make sure SSB_GridStart is consistent with SSB_N_GridStart&#x000D;&#x000A;&#x000D;&#x000A;PSS_PowerBoosting = 0;&#x000D;&#x000A;SSS_PowerBoosting = 0;&#x000D;&#x000A;PBCH_DMRS_PowerBoosting = 0;&#x000D;&#x000A;PBCH_PowerBoosting =0;&#x000D;&#x000A;&#x000D;&#x000A;PDSCH_DMRS_ConfigType = [0];&#x000D;&#x000A;PDSCH_DMRS_Length =[1];&#x000D;&#x000A;PDSCH_DMRS_AddPos =[0];&#x000D;&#x000A;PDSCH_DMRS_TypeA_Pos =[2];&#x000D;&#x000A;PDSCH_MappingType = 0;&#x000D;&#x000A;PDSCH_DMRS_PowerBoosting = [0];&#x000D;&#x000A;PDSCH_PowerBoosting = [0];&#x000D;&#x000A;LDPCBaseGraphType =[0];&#x000D;&#x000A;PDSCH_DMRS_n_SCID =[0];&#x000D;&#x000A;PDSCH_DMRS_N_ID =[1];&#x000D;&#x000A;PDSCH_n_RNTI = [0];&#x000D;&#x000A;PDSCH_n_ID_Scrambler =[0];&#x000D;&#x000A;PDSCH_DMRS_CDMGroupNum = [1];&#x000D;&#x000A;subCarrierSpacingCommon = 2;&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;%%%%%%%%%%%%%%%%%%%%%%%%%%get modulation( (0:BPSK or Pi/2 BPSK, 1:QPSK, 2:16QAM, 3:64QAM, 4:256QAM)) from parameter&#x000D;&#x000A;Modulation_t = zeros(1,length(Modulation));&#x000D;&#x000A;for i = 1:length(Modulation)&#x000D;&#x000A;switch(Modulation(i))&#x000D;&#x000A;&#x0009;case 2 &#x000D;&#x000A;&#x0009;&#x0009;Modulation_t(i) = 1;&#x000D;&#x000A;&#x0009;case 4 &#x000D;&#x000A;&#x0009;&#x0009;Modulation_t(i) = 2;&#x000D;&#x000A;&#x0009;case 6 &#x000D;&#x000A;&#x0009;&#x0009;Modulation_t(i) = 3;&#x000D;&#x000A;&#x0009;case 8 &#x000D;&#x000A;&#x0009;&#x0009;Modulation_t(i) = 4;&#x000D;&#x000A;&#x0009;otherwise&#x000D;&#x000A;&#x0009;&#x0009;error(&apos;Element of Modulation should be {2,4,6,8}&apos;);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;%%%%%%%%%%%%%%%%%%%%%%%%%set parameters for EVM model&#x000D;&#x000A;GridMu = repmat(Numerology,1,NumBWPs);&#x000D;&#x000A;GridMu = sort(unique(GridMu(1:NumBWPs)));&#x000D;&#x000A;GridPosition = GridStart.*2.^GridMu*12*15e3;&#x000D;&#x000A;GridDiff = GridPosition-GridPosition(find(max(GridMu)));&#x000D;&#x000A;GridBandwidth = max(abs(GridDiff));&#x000D;&#x000A;&#x000D;&#x000A;if (Bandwidth==15)&#x000D;&#x000A;&#x0009;if(ResourceGridEnable==0)&#x000D;&#x000A;&#x0009;&#x0009;FilterBandwidth = max(CarrierNumRBs*12*15e3.*2.^Numerology);&#x000D;&#x000A;&#x0009;else&#x000D;&#x000A;&#x0009;&#x0009;if(GridBandwidth&gt;0)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;FilterBandwidth = max(CarrierNumRBs*12*15e3.*2.^Numerology) + GridBandwidth*2;&#x000D;&#x000A;&#x0009;&#x0009;else&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;FilterBandwidth = max(CarrierNumRBs*12*15e3.*2.^Numerology);&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;if(ResourceGridEnable==0)&#x000D;&#x000A;&#x0009;&#x0009;FilterBandwidth = BandwidthTable(Bandwidth+1);&#x000D;&#x000A;&#x0009;else&#x000D;&#x000A;&#x0009;&#x0009;if(GridBandwidth&gt;0)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;FilterBandwidth = BandwidthTable(Bandwidth+1) + GridBandwidth*2;&#x000D;&#x000A;&#x0009;&#x0009;else&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;FilterBandwidth = BandwidthTable(Bandwidth+1);&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;L_Table = [4, 8, 64];&#x000D;&#x000A;Num_SSB = L_Table(SSB_Lmax + 1);&#x000D;&#x000A;ActiveSSB = [0:Num_SSB-1];&#x000D;&#x000A;&#x000D;&#x000A;Mu_BWP = [];&#x000D;&#x000A;for i = 0:NumBWPs-1&#x000D;&#x000A;&#x0009;Mu_BWP = [Mu_BWP, Numerology(mod(i, length(Numerology))+1)];&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;NumSlotsPerFrame = 10 * 2.^Mu_BWP;&#x000D;&#x000A;ActiveSlots = [];&#x000D;&#x000A;for i = 1:length(NumSlotsPerFrame)&#x000D;&#x000A;&#x0009;ActiveSlots = [ActiveSlots, 0:NumSlotsPerFrame(i)-1];&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;EVM_StartSlot = zeros(1, NumBWPs);&#x000D;&#x000A;EVM_NumSlots = 5;%% set number of demodulated slots to be 5 slots in order to speed up in constellation&#x000D;&#x000A;&#x000D;&#x000A;if(ResourceGridEnable~=1)&#x000D;&#x000A;&#x0009;warning(&apos;EVM measurements might be inaccurate in case of multiple different Numerologies setting when ResourceGridEnable for NR_Source is NO.&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;</Text>
