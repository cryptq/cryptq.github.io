<HideCondition>0==PUCCH_Enable</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PUCCH_n_ID" Type="PartParam">
<DataEntry>[0]</DataEntry>
<Description>data-scrambling-Identity for each PUCCH. 0 ~ 1023 or CellID.</Description>
<HideCondition>0==PUCCH_Enable || (PUCCH_Format ~= 2&amp;&amp;PUCCH_Format ~= 3&amp;&amp;PUCCH_Format ~= 4)</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PUCCH_n_RNTI" Type="PartParam">
<DataEntry>[0]</DataEntry>
