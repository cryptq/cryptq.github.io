<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PUSCH_PTRS_FrequencyDensity" Type="PartParam">
<DataEntry>[0]</DataEntry>
<Description>set the Frequency Density (K_PTRS) for PUSCH PTRS signal when TransformPrecodingEnabled is NO. [0: 2 RBs; 1: 4 RBs]</Description>
<Enum />
<HideCondition>PUSCH_Enable == 0 || PTRS_Enable == 0 || TransformPrecodingEnabled == 1</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PUSCH_PTRS_N_ID" Type="PartParam">
<DataEntry>[0]</DataEntry>
