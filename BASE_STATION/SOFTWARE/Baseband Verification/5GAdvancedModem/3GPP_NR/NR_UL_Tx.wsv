<Enum />
<HideCondition>PUSCH_Enable==0</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="PUSCH_NumAllocatedSlots" Type="PartParam">
<DataEntry>NumSlotsPerFrame</DataEntry>
<Description>Number of allocated slots for PUSCH in each frame for each BWP.The size of this parameter is equal to NumBWPs</Description>
<HideCondition>PUSCH_Enable==0</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PUSCH_NumAntennaPorts" Type="PartParam">
<DataEntry>PUSCH_NumAntennaPorts</DataEntry>
