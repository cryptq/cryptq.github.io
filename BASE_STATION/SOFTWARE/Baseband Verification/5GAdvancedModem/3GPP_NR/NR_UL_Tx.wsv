<Item XName="PUCCH_OCCLength" Type="PartParam">
<DataEntry>[2]</DataEntry>
<Description>the OCC length for PUCCH format 4. It can be 2 or 4.</Description>
<HideCondition>0==PUCCH_Enable || PUCCH_Format ~= 4</HideCondition>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PUCCH_PowerBoosting" Type="PartParam">
<DataEntry>[0]</DataEntry>
