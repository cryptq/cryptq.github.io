<Item XName="Equations" Type="Equation">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>SlotNumber = 1;&#x000D;&#x000A;PAEnable = 1;%%%0: disable  1:enable&#x000D;&#x000A;&#x000D;&#x000A;%%%%%calculate FFTSize and SamplingRate%%%%%%%%%%%%%%%%%%%%&#x000D;&#x000A;BandwidthTable =[5e6,10e6,15e6,20e6,25e6,30e6,40e6,50e6,60e6,70e6,80e6,90e6,100e6,200e6,400e6];&#x000D;&#x000A;if (Bandwidth==15)&#x000D;&#x000A;&#x0009;CarrierNumRBs = UserDefinedCarrierNumRBs;&#x000D;&#x000A;&#x0009;FFTSize = 2.^ceil(log2(CarrierNumRBs*12)).*2^(OversamplingOption);&#x000D;&#x000A;&#x0009;SamplingRate = max(FFTSize*15e3.*2.^Numerology);&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;SamplingRate = 2.^ceil(log2(BandwidthTable(Bandwidth+1)/15e3))*2^(OversamplingOption)*15e3;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;SubcarrierSpacing = 15e3 * 2^Numerology;&#x000D;&#x000A;SlotTimeInterval = 0.001 / 2^Numerology;&#x000D;&#x000A;WaveformLength = SamplingRate * SlotTimeInterval * SlotNumber;&#x000D;&#x000A;&#x000D;&#x000A;%%%% for ACLR&#x000D;&#x000A;FilterEnable =1;&#x000D;&#x000A;PassFreq = 25e6;&#x000D;&#x000A;StopFreq = 30e6;&#x000D;&#x000A;%%%%%%%%%%%%%%%%%%%%%%%%%%get modulation( (0:BPSK or Pi/2 BPSK, 1:QPSK, 2:16QAM, 3:64QAM, 4:256QAM)) from parameter&#x000D;&#x000A;Modulation_t = zeros(1,length(Modulation));&#x000D;&#x000A;for i = 1:length(Modulation)&#x000D;&#x000A;switch(Modulation(i))&#x000D;&#x000A;&#x0009;case 1 &#x000D;&#x000A;&#x0009;&#x0009;Modulation_t(i) = 0;&#x000D;&#x000A;&#x0009;case 2 &#x000D;&#x000A;&#x0009;&#x0009;Modulation_t(i) = 1;&#x000D;&#x000A;&#x0009;case 4 &#x000D;&#x000A;&#x0009;&#x0009;Modulation_t(i) = 2;&#x000D;&#x000A;&#x0009;case 6&#x000D;&#x000A;&#x0009;&#x0009;Modulation_t(i) = 3;&#x000D;&#x000A;&#x0009;case 8&#x000D;&#x000A;&#x0009;&#x0009;Modulation_t(i) = 4;&#x000D;&#x000A;&#x0009;otherwise&#x000D;&#x000A;&#x0009;&#x0009;error(&apos;Element of Modulation should be {1,2,4,6,8}&apos;);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x000D;&#x000A;%%%%%%%%%%%%%%%%%%%%%Filter for EVM model&#x000D;&#x000A;if (Bandwidth==15)&#x000D;&#x000A;&#x0009;FilterBandwidth = max(CarrierNumRBs*12*15e3.*2.^Numerology);&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;FilterBandwidth = BandwidthTable(Bandwidth+1);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;BPSKType = ~BPSKEnabled;&#x000D;&#x000A;&#x000D;&#x000A;NumSlotsPerFrame = 10 * 2^Numerology;&#x000D;&#x000A;ActiveSlots = [0:NumSlotsPerFrame-1];&#x000D;&#x000A;&#x000D;&#x000A;EVM_StartSlot = 0;&#x000D;&#x000A;EVM_NumSlots = 5; %%% Number of slots for demodulated PUSCH is set to 5 to speed up constellation plot&#x000D;&#x000A;&#x000D;&#x000A;Power = 10;%dBm&#x000D;&#x000A;PRPR = 9.5;&#x000D;&#x000A;C1dB = 10 + 10*log10(PUSCH_NumRBs*12*2^Numerology) + PRPR - 1;&#x000D;&#x000A;NDensity_dBm = Power - SNR - 10*log10(15e3);&#x000D;&#x000A;&#x000D;&#x000A;if(OversamplingOption &gt;1)&#x000D;&#x000A;&#x0009;OversamplingOptionEVM = 1;&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;OversamplingOptionEVM = OversamplingOption;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;DownSampleFactor = 2^(OversamplingOption)/2;&#x000D;&#x000A;&#x000D;&#x000A;ResourceGridEnable = 1;&#x000D;&#x000A;if (ResourceGridEnable~=1)&#x000D;&#x000A;&#x0009;warning(&apos;EVM measurements might be inaccurate in case of multiple different Numerologies setting when ResourceGridEnable for NR_Source is NO.&apos;);&#x000D;&#x000A;end&#x0009;&#x000D;&#x000A;</Text>
