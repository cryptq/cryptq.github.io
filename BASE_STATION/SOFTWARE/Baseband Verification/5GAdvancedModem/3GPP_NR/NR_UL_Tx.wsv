<Item XName="Calcu_ACLR" UserName="Calcu_ACLR" Type="Equation">
<AutoCalc><T>Bool</T><D>0</D></AutoCalc>
<Selected><T>Bool</T><D>0</D></Selected>
<Text>%%%%%%%%%%%%%%%get spectrum data&#x000D;&#x000A;using(&apos;Design1 Analysis_Design1_Data&apos;);&#x000D;&#x000A;&#x000D;&#x000A;%%%%%%%%%%%%%%%%set parameters to calculate ACLR, please keep parameters consistent with that in Design&#x000D;&#x000A;bandwidth = 50e6; %%%Hz&#x000D;&#x000A;FCarrier = 1e9; %%% Hz &#x000D;&#x000A;CarrierNumRBs = 270;&#x000D;&#x000A;SCS = 15e3; %%%Hz&#x000D;&#x000A;&#x000D;&#x000A;Power = sum(Spectrum_Power(find((Spectrum_Power_Freq(:)&gt;=(FCarrier-(CarrierNumRBs*SCS*12)/2))&amp;(Spectrum_Power_Freq(:)&lt;(FCarrier+(CarrierNumRBs*SCS*12)/2)))));&#x000D;&#x000A;upper_power_ac = sum(Spectrum_Power(find((Spectrum_Power_Freq(:)&gt;=(FCarrier+bandwidth -(CarrierNumRBs*SCS*12)/2))&amp;(Spectrum_Power_Freq(:)&lt;(FCarrier+ bandwidth+(CarrierNumRBs*SCS*12)/2)))));&#x000D;&#x000A;lower_power_ac = sum(Spectrum_Power(find((Spectrum_Power_Freq(:)&gt;=(FCarrier-bandwidth -(CarrierNumRBs*SCS*12)/2))&amp;(Spectrum_Power_Freq(:)&lt;(FCarrier- bandwidth+(CarrierNumRBs*SCS*12)/2)))));&#x000D;&#x000A;ACLR1_upper = 10*log10(Power) - 10*log10(upper_power_ac);%%%%dB&#x000D;&#x000A;ACLR1_lower = 10*log10(Power) - 10*log10(lower_power_ac);%%%%dB</Text>
