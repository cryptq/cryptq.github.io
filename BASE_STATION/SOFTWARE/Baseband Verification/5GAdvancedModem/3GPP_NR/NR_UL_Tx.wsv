<HideCondition>PUSCH_Enable == 0 || PTRS_Enable == 0</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PUSCH_PowerBoosting" Type="PartParam">
<DataEntry>PUSCH_PowerBoosting</DataEntry>
<Description>power boosting for each PUSCH in dB.</Description>
<HideCondition>PUSCH_Enable==0</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>14</D></Validate></Item>
<Item XName="PUSCH_RA_Type0Bitmap" Type="PartParam">
