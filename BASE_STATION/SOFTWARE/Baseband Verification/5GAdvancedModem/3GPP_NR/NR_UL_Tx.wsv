<Item XName="PUSCH_AllocatedSlots" Type="PartParam">
<DataEntry>PUSCH_AllocatedSlots</DataEntry>
<Description>Allocated slot indices for PUSCH in each frame for all BWPs. The index starts from 0 to (N-1), where N is the number of slots per frame.</Description>
<HideCondition>PUSCH_Enable==0</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PUSCH_BitInfoLength_CSI1" Type="PartParam">
<DataEntry>[10]</DataEntry>
<Description>The number of information bits of CSI1 in PUSCH.</Description>
<HideCondition>0==PUSCH_Enable || 0 == PUSCH_CSI1_Enabled</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PUSCH_BitInfoLength_CSI2" Type="PartParam">
<DataEntry>[10]</DataEntry>
<Description>The number of information bits of CSI2 in PUSCH.</Description>
<HideCondition>0==PUSCH_Enable || 0 == PUSCH_CSI2_Enabled</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PUSCH_BitInfoLength_HARQACK" Type="PartParam">
<DataEntry>[10]</DataEntry>
<Description>The number of information bits of HARQACK in PUSCH.</Description>
<HideCondition>0==PUSCH_Enable || 0 == PUSCH_HARQACK_Enabled</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PUSCH_CSI1_BetaOffsetIndex" Type="PartParam">
<DataEntry>[0]</DataEntry>
<Description>The beta offset index of CSI1 when multiplexing with UL_SCH. Range: 0 - 18.</Description>
<HideCondition>0==PUSCH_Enable || 0 == PUSCH_CSI1_Enabled</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PUSCH_CSI1_Enabled" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>Enable or disable CSI1 when UCI is multiplexed with UL-SCH.</Description>
<Enum>NR_HARQ_Controller__PUSCH_Enable@5G Advanced Modem Enums</Enum>
<HideCondition>0==PUSCH_Enable</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="PUSCH_CSI2_BetaOffsetIndex" Type="PartParam">
<DataEntry>[0]</DataEntry>
<Description>The beta offset index of CSI2 when multiplexing with UL_SCH. Range: 0 - 18.</Description>
<HideCondition>0==PUSCH_Enable || 0 == PUSCH_CSI2_Enabled</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PUSCH_CSI2_Enabled" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>Enable or disable CSI2 when UCI is multiplexed with UL-SCH.</Description>
<Enum>NR_HARQ_Controller__PUSCH_Enable@5G Advanced Modem Enums</Enum>
<HideCondition>0==PUSCH_Enable</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="PUSCH_DMRS_AddPos" Type="PartParam">
<DataEntry>PUSCH_DMRS_AddPos</DataEntry>
<Description>UL-DMRSadd_pos. The number of additional positions for DMRS.</Description>
<HideCondition>PUSCH_Enable==0</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PUSCH_DMRS_CDMGroupNum" Type="PartParam">
<DataEntry>[2]</DataEntry>
<Description>it&apos;s the number of CDM groups without data of values 1, 2, and 3, which refers to CDM groups {0}, {0, 1} and {0, 1, 2} respectively.</Description>
<HideCondition>PUSCH_Enable==0</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PUSCH_DMRS_ConfigType" Type="PartParam">
<DataEntry>PUSCH_DMRS_ConfigType</DataEntry>
<Description>dmrs configuration type for PUSCH. 0: Configuration Type 1; 1: Configuration Type 2.</Description>
<Enum />
<HideCondition>PUSCH_Enable==0</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PUSCH_DMRS_GroupHoppingEnabled" Type="PartParam">
<DataEntry>[0]</DataEntry>
<Description>it&apos;s used when generating PUSCH DMRS sequence when Transform Precoding is enabled. 1 denotes group hopping is enabled for the UE. 0, otherwise.</Description>
<HideCondition>0==TransformPrecodingEnabled || PUSCH_Enable==0</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
