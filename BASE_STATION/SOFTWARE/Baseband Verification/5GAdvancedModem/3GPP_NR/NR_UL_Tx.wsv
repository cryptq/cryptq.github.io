<Item XName="PUSCH_CSI2_BetaOffsetIndex" Type="PartParam">
<DataEntry>[0]</DataEntry>
<Description>The beta offset index of CSI2 when multiplexing with UL_SCH. Range: 0 - 18.</Description>
<HideCondition>0==PUSCH_Enable || 0 == PUSCH_CSI2_Enabled</HideCondition>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PUSCH_CSI2_Enabled" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>Enable or disable CSI2 when UCI is multiplexed with UL-SCH.</Description>
<Enum>NR_HARQ_Controller__PUSCH_Enable@5G Advanced Modem Enums</Enum>
<HideCondition>0==PUSCH_Enable</HideCondition>
