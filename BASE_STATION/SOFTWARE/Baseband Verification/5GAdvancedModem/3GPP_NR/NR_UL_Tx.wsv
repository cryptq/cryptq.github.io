<HideCondition>PUSCH_Enable==0</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PUSCH_HARQACK_BetaOffsetIndex" Type="PartParam">
<DataEntry>[0]</DataEntry>
<Description>The beta offset index of HARQACK when multiplexing with UL_SCH. Range: 0 - 15.</Description>
<HideCondition>0==PUSCH_Enable</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PUSCH_HARQACK_Enabled" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>Enable or disable HARQACK when UCI is multiplexed with UL-SCH.</Description>
<Enum>NR_HARQ_Controller__PUSCH_Enable@5G Advanced Modem Enums</Enum>
<HideCondition>0==PUSCH_Enable</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="PUSCH_MappingType" Type="PartParam">
