<Item XName="EquationText" Type="PartParam">
<DataEntry>NumSym = numel(Data{1});&#x000D;&#x000A;if NumSym==0&#x000D;&#x000A;&#x0009;Data_Selected = [];&#x000D;&#x000A;&#x0009;DMRS_Selected = [];&#x000D;&#x000A;&#x0009;PTRS_Selected = [];&#x000D;&#x000A;&#x0009;Index_Selected = 0;&#x000D;&#x000A;&#x0009;PowB1 = 0;&#x000D;&#x000A;&#x0009;PowB2 = 0;&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;if DiversityOption == 0&#x000D;&#x000A;&#x0009;&#x0009;Pow_Branch1 = mean(abs(Data{1}).^2)&#x000D;&#x000A;&#x0009;&#x0009;Pow_Branch2 = mean(abs(Data{2}).^2)&#x000D;&#x000A;&#x0009;&#x0009;if Pow_Branch1 &gt; Pow_Branch2&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;Data_Selected = Data{1};&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;DMRS_Selected = DMRS{1};&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PTRS_Selected = PTRS{1};&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;Index_Selected = 1;&#x000D;&#x000A;&#x0009;&#x0009;else&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;Data_Selected = Data{2};&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;DMRS_Selected = DMRS{2};&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;PTRS_Selected = PTRS{2};&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;Index_Selected = 2;&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;elseif DiversityOption == 1&#x000D;&#x000A;&#x0009;&#x0009;Data_Selected = Data{1};&#x000D;&#x000A;&#x0009;&#x0009;DMRS_Selected = DMRS{1};&#x000D;&#x000A;&#x0009;&#x0009;PTRS_Selected = PTRS{1};&#x000D;&#x000A;&#x0009;&#x0009;Index_Selected = 1;&#x000D;&#x000A;&#x0009;elseif DiversityOption == 2&#x000D;&#x000A;&#x0009;&#x0009;Data_Selected = Data{2};&#x000D;&#x000A;&#x0009;&#x0009;DMRS_Selected = DMRS{2};&#x000D;&#x000A;&#x0009;&#x0009;PTRS_Selected = PTRS{2};&#x000D;&#x000A;&#x0009;&#x0009;Index_Selected = 2;&#x000D;&#x000A;&#x0009;else&#x000D;&#x000A;&#x0009;&#x0009;Data_Selected = [];&#x000D;&#x000A;&#x0009;&#x0009;DMRS_Selected = [];&#x000D;&#x000A;&#x0009;&#x0009;PTRS_Selected = [];&#x000D;&#x000A;&#x0009;&#x0009;Index_Selected = 0;&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x0009;PowB1 = mean(abs(Data{1}).^2);&#x000D;&#x000A;&#x0009;PowB2 = mean(abs(Data{2}).^2);&#x000D;&#x000A;&#x0009;&#x000D;&#x000A;end</DataEntry>
