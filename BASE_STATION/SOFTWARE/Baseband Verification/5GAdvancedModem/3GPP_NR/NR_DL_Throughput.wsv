<Item XName="AutoFrameSync" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>Whether to automaticlly detect time and frequency synchronization position and offset or to manually set them up</Description>
<Enum>NR_UL_FreqSync__Enabled@5G Advanced Modem Enums</Enum>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="Bandwidth" Type="PartParam">
<DataEntry>1</DataEntry>
<Description>Bandwidth</Description>
<Enum>NR_VSA_Gen__BandWidth@5G Advanced Modem Enums</Enum>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="DesiredDelay" Type="PartParam">
<DataEntry>14</DataEntry>
<Description>Manual setup of time synchronization position instead of auto-detection from NR_DL_FrameSync model when ReceiverDelay is set to 1</Description>
<Validate><T>Int</T><D>11</D></Validate></Item>
<Item XName="DesiredFreqOffset" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>Manual setup of frequency synchronization offset instead of auto-detection from NR_DL_FrameSync model when ReceiverDelay is set to 1</Description>
<Unit><T>Int</T><D>1001</D></Unit>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="HARQ_Enable" Type="PartParam">
<DataEntry>1</DataEntry>
<Description>whether HARQ closed-loop transmission is enabled</Description>
<Enum>NR_HARQ_Controller__HARQ_Enable@5G Advanced Modem Enums</Enum>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="MaxHARQTrans" Type="PartParam">
<DataEntry>4</DataEntry>
<Description>maximum number of HARQ transmission per each HARQ process for each user</Description>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="NumHARQ" Type="PartParam">
<DataEntry>8</DataEntry>
<Description>number of HARQ processes for each user</Description>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="NumSimulationSlots" Type="PartParam">
<DataEntry>1000</DataEntry>
<Description>number of slots for simulation</Description>
<Enum />
<Validate><T>Int</T><D>11</D></Validate></Item>
<Item XName="OversamplingOption" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>oversampling  option</Description>
<Enum>FBMC_DemuxFrame__OversampleOption@5G Advanced Modem Enums</Enum>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="RV_Sequence" Type="PartParam">
<DataEntry>[0,1,2,3]</DataEntry>
<Description>redundancy version sequence for HARQ closed-loop transmission</Description>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="SNR" Type="PartParam">
<DataEntry>6</DataEntry>
<Description>SNR in dB</Description>
<Tunable><T>Bool</T><D>1</D></Tunable>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="SyncMethod" Type="PartParam">
<DataEntry>1</DataEntry>
<Description>Synchronization method when AutoFrameSync is YES (0:SSB Sync; 1:CP+DMRS Sync)</Description>
<Enum>NR_DL_SyncMethod@5G Advanced Modem Enums</Enum>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="SystemConfiguration" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>FRC or user defined configuration</Description>
<Enum>NR_SystemConfiguration@5G Advanced Modem Enums</Enum>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="UserDefinedCarrierNumRBs" Type="PartParam">
<DataEntry>[52]</DataEntry>
<Description>user defined number of PRBs for each unique Numerology corresponding to the order of the configured Numerology. Valid only when Bandwidth is specified as UserDefined</Description>
<Validate><T>Int</T><D>13</D></Validate></Item></Item></Item>
