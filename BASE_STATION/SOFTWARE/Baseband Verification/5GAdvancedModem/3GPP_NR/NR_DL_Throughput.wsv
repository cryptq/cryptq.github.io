<Validate><T>Int</T><D>11</D></Validate></Item>
<Item XName="NumBeamTrainingRounds" Type="PartParam">
<DataEntry>1</DataEntry>
<Description>the number of SSB periods used to do beam training by receiver.</Description>
<Validate><T>Int</T><D>11</D></Validate></Item>
<Item XName="NumHARQ" Type="PartParam">
<DataEntry>8</DataEntry>
<Description>number of HARQ processes for each user</Description>
<HideCondition>HARQ_Enable == 0</HideCondition>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="NumRxRFChains" Type="PartParam">
<DataEntry>1</DataEntry>
<Description>the number of RX RF chains</Description>
<Validate><T>Int</T><D>11</D></Validate></Item>
<Item XName="NumSlotsMuted" Type="PartParam">
