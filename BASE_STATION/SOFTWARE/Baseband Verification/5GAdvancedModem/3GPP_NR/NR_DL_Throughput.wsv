<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="BWP_RBOffset" Type="PartParam">
<DataEntry>BWP_RBOffset</DataEntry>
<Description>the starting RB index of resource blocks allocated to BWP in the whole bandwidth based on SCS of 15KHz</Description>
<Show><T>Bool</T><D>0</D></Show>
