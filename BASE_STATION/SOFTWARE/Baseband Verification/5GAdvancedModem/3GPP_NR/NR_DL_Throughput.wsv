<Data><T>Array_Dbl64</T><D>2;10;1;;m}3;4;804;G04;K04;O04;R04;W04;Y04</D></Data></Item>
<Item XName="BFGainRx" Type="Variable">
<Creator>Equations</Creator>
<Data><T>Double</T><D>6.020599913279624</D></Data></Item>
<Item XName="BFGainTx" Type="Variable">
<Creator>Equations</Creator>
<Data><T>Double</T><D>9.030899869919436</D></Data></Item>
