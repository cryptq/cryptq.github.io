<ParamOrder><T>Array_BString</T><D>1;65;Numerology;CyclicPrefix;CellID;NumUsers;BWP_RBOffset;BWP_NumRBs;HARQ_Enable;NumHARQ;MaxHARQTrans;RV_Sequence;Payload_Config;MCS;MCSTable;TransBlockSize;Modulation;LDPCBaseGraphType;NumLayers;ChBit_Config;NumChBits;PDSCH_n_RNTI;PDSCH_n_ID;PDSCH_Enable;PDSCH_DMRS_NumPorts;PDSCH_DMRS_PortList;PDSCH_RBOffset;PDSCH_NumRBs;PDSCH_StartOFDMSym;PDSCH_NumOFDMSyms;PDSCH_MappingType;PDSCH_DMRS_ConfigType;PDSCH_DMRS_Length;PDSCH_DMRS_AddPos;PDSCH_DMRS_TypeA_Pos;PDSCH_DMRS_CDMGroupNum;PTRS_Enable;PDSCH_PTRS_TimeDensity;PDSCH_PTRS_FrequencyDensity;PDSCH_PTRS_ResourceElementOffset;CSIRS_Enable;PDCCH_Enable;CORESET_InterleaverSize;CORESET_MappingType;CORESET_NumSyms;CORESET_RB_Bitmap;CORESET_REG_BundleSize;CORESET_ShiftIndex;CORESET_SymOffset;PDCCH_AggregationLevel;PDCCH_CCEOffset;SSB_Enable;SSB_Lmax;SSB_Periodicity;SSB_k0;SSB_SymStartOption30K;SSB_TimeOffset;SSB_RBOffset;q;SubCarrierSpacingCommon;StartSlotOffset;LDPC_Algorithm;LDPC_IterationNumber;LDPC_ScalingFactor;Polarity;SlotIgnored;NumSlotsMuted</D></ParamOrder>
<Item XName="BWP_NumRBs" Type="PartParam">
<DataEntry>BWP_NumRBs</DataEntry>
<Description>number of PRBs in this BWP</Description>
<Enum />
<HideCondition>1==ChBit_Config</HideCondition>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="BWP_RBOffset" Type="PartParam">
<DataEntry>BWP_RBOffset</DataEntry>
<Description>the starting RB index of resource blocks allocated to this BWP in the whole bandwidth</Description>
<Enum />
<HideCondition>1==ChBit_Config</HideCondition>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="CORESET_InterleaverSize" Type="PartParam">
<DataEntry>CORESET_InterleaverSize</DataEntry>
<Description>the interleaver size (R) given by higher-layer parameter CORESET-interleaver-size. The value should be {2,3,6}</Description>
<HideCondition>1==ChBit_Config || PDCCH_Enable == 0</HideCondition>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="CORESET_MappingType" Type="PartParam">
<DataEntry>CORESET_MappingType</DataEntry>
<Description>the CCE-to-REG mapping type for each CORESET in each BWP. 0 means non-interleaved while 1 means interleaved</Description>
<HideCondition>1==ChBit_Config || PDCCH_Enable == 0</HideCondition>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="CORESET_NumSyms" Type="PartParam">
<DataEntry>CORESET_NumSyms</DataEntry>
<Description>number of OFDM symbols in the time domain for each CORESET in each BWP. The value should be {1,2,3}</Description>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="CORESET_RB_Bitmap" Type="PartParam">
<DataEntry>CORESET_RB_Bitmap</DataEntry>
<Description>PRB bitmap for each CORESET in each BWP in ascending order. Each bit represents a non-overlapping group of 6 PRBs. LSB means the lowest group of 6 PRBs.</Description>
<HideCondition>1==ChBit_Config || PDCCH_Enable == 0</HideCondition>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="CORESET_REG_BundleSize" Type="PartParam">
<DataEntry>CORESET_REG_BundleSize</DataEntry>
<Description>the REG bundle size for each CORESET in each BWP configured by the higher-layer parameter CORESET-REG-bundle-size. {2,6} for CORESET_NumSyms=1; {CORESET_NumSyms,6} for CORESET_NumSyms={2,3}</Description>
<HideCondition>1==ChBit_Config || PDCCH_Enable == 0</HideCondition>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="CORESET_ShiftIndex" Type="PartParam">
<DataEntry>CORESET_ShiftIndex</DataEntry>
<Description>the shift given by the higher-layer parameter CORESET-shift-index. The value should be {0,1,...,274}</Description>
<HideCondition>1==ChBit_Config || PDCCH_Enable == 0</HideCondition>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="CORESET_SymOffset" Type="PartParam">
<DataEntry>CORESET_SymOffset</DataEntry>
<Description>start OFDM symbol index in the time domain for each CORESET in each BWP.</Description>
<HideCondition>1==ChBit_Config || PDCCH_Enable == 0</HideCondition>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="CSIRS_Enable" Type="PartParam">
<DataEntry>CSIRS_Enable</DataEntry>
<Description>enable or disable CSI RS transmission</Description>
<Enum>NR_HARQ_Controller__CSIRS_Enable@5G Advanced Modem Enums</Enum>
<HideCondition>1==ChBit_Config</HideCondition>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="CellID" Type="PartParam">
<DataEntry>CellID</DataEntry>
<Description>cell identity</Description>
<Validate><T>Int</T><D>11</D></Validate></Item>
<Item XName="ChBit_Config" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>configuration mode of channel bit size.</Description>
<Enum>NR_HARQ_Controller__ChBit_Config@5G Advanced Modem Enums</Enum>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="CyclicPrefix" Type="PartParam">
<DataEntry>CyclicPrefix</DataEntry>
<Description>normal CP or extended CP</Description>
<Enum>NR_DL_MuxOFDMSym__CyclicPrefix@5G Advanced Modem Enums</Enum>
<HideCondition>1==ChBit_Config</HideCondition>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="HARQ_Enable" Type="PartParam">
<DataEntry>=HARQ_Enable</DataEntry>
<Description>whether HARQ closed-loop transmission is enabled</Description>
<Enum>NR_HARQ_Controller__HARQ_Enable@5G Advanced Modem Enums</Enum>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="LDPCBaseGraphType" Type="PartParam">
<DataEntry>=LDPCBaseGraphType</DataEntry>
<Description>LDPC base graph type. 0 : Base Graph1; 1 : Base Graph2;</Description>
<HideCondition>Payload_Config == 0</HideCondition>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="LDPC_Algorithm" Type="PartParam">
<DataEntry>=LDPC_Algorithm</DataEntry>
<Description>decoding algorithm for LDPC</Description>
<Enum>NR_LDPC_Decoder__Algorithm@5G Advanced Modem Enums</Enum>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="LDPC_IterationNumber" Type="PartParam">
<DataEntry>=LDPC_IterationNumber</DataEntry>
<Description>The number of iterations</Description>
<Validate><T>Int</T><D>11</D></Validate></Item>
<Item XName="LDPC_ScalingFactor" Type="PartParam">
<DataEntry>=LDPC_ScalingFactor</DataEntry>
<Description>Scaling factor for input signal</Description>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="MCS" Type="PartParam">
<DataEntry>=MCS</DataEntry>
<Description>modulation and coding scheme (MCS) for each user</Description>
<HideCondition>Payload_Config == 1</HideCondition>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="MCSTable" Type="PartParam">
<DataEntry>=MCSTable</DataEntry>
<Description>The MCS index table to use for D-SCH, see section 5.1.3 and 6.1.4 of 38.214. [0: Table 5.1.3.1-1 | 1: Table 5.1.3.1-2 | 2: Table 5.1.3.1-3 | 3: Table 6.1.4.1-1 | 4: Table 6.1.4.1-2]</Description>
<HideCondition>Payload_Config == 1</HideCondition>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="MaxHARQTrans" Type="PartParam">
<DataEntry>=MaxHARQTrans</DataEntry>
<Description>maximum number of HARQ transmission per each HARQ process for each user</Description>
<HideCondition>0==HARQ_Enable</HideCondition>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="Modulation" Type="PartParam">
<DataEntry>Modulation</DataEntry>
<Description>modulation orders in each slot. (0:BPSK or Pi/2 BPSK, 1:QPSK, 2:16QAM, 3:64QAM, 4:256QAM), only valid when the Qm port is unconnected.</Description>
<HideCondition>Payload_Config == 0</HideCondition>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="NumChBits" Type="PartParam">
<DataEntry>10080</DataEntry>
<Description>number of channel bits</Description>
<HideCondition>0==ChBit_Config</HideCondition>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="NumHARQ" Type="PartParam">
<DataEntry>=NumHARQ</DataEntry>
<Description>number of HARQ processes for each user</Description>
<HideCondition>0==HARQ_Enable</HideCondition>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="NumLayers" Type="PartParam">
<DataEntry>PDSCH_PortNum</DataEntry>
<Description>number of layers used by each user.</Description>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="NumSlotsMuted" Type="PartParam">
<DataEntry>=NumSlotsMuted</DataEntry>
<Description>number of slots before effective data come, which is additional time instants besides SlotsIgnored</Description>
<Validate><T>Int</T><D>11</D></Validate></Item>
<Item XName="NumUsers" Type="PartParam">
<DataEntry>NumBWPs</DataEntry>
<Description>number of users</Description>
<Enum />
<Validate><T>Int</T><D>3</D></Validate></Item>
<Item XName="Numerology" Type="PartParam">
<DataEntry>Numerology</DataEntry>
<Description>OFDM numerology</Description>
<Enum>NR_LDPC_CodeBlockSegmentation__Numerology@5G Advanced Modem Enums</Enum>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="PDCCH_AggregationLevel" Type="PartParam">
<DataEntry>PDCCH_AggregationLevel</DataEntry>
<Description>number of control-channel elements (CCEs) for each PDCCH in each BWP. The value should be {1, 2, 4, 8, 16}.</Description>
<HideCondition>1==ChBit_Config || PDCCH_Enable == 0</HideCondition>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PDCCH_CCEOffset" Type="PartParam">
<DataEntry>[0]</DataEntry>
<Description>start CCE index within the CORESET for each PDCCH in each BWP starting with 0.</Description>
<HideCondition>1==ChBit_Config || PDCCH_Enable == 0</HideCondition>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PDCCH_Enable" Type="PartParam">
<DataEntry>PDCCH_Enable</DataEntry>
<Description>enable or disable PDCCH and its DMRS transmission</Description>
<Enum>NR_HARQ_Controller__PDCCH_Enable@5G Advanced Modem Enums</Enum>
<HideCondition>1==ChBit_Config</HideCondition>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="PDSCH_DMRS_AddPos" Type="PartParam">
<DataEntry>PDSCH_DMRS_AddPos</DataEntry>
<Description>DL-DMRSadd_pos. The number of additional positions for DMRS.</Description>
<HideCondition>1==ChBit_Config</HideCondition>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PDSCH_DMRS_CDMGroupNum" Type="PartParam">
<DataEntry>PDSCH_DMRS_CDMGroupNum</DataEntry>
<Description>It&apos;s the number of CDM groups without data of values 1, 2, and 3, which refers to CDM groups {0}, {0, 1} and {0, 1, 2} respectively.</Description>
<HideCondition>1==ChBit_Config</HideCondition>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PDSCH_DMRS_ConfigType" Type="PartParam">
<DataEntry>PDSCH_DMRS_ConfigType</DataEntry>
<Description>DL DMRS config type. 0 means Type 1 and 1 means Type 2.</Description>
<HideCondition>1==ChBit_Config</HideCondition>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PDSCH_DMRS_Length" Type="PartParam">
<DataEntry>PDSCH_DMRS_Length</DataEntry>
<Description>DL-DMRS-len. The number of symbols of one DMRS.</Description>
<HideCondition>1==ChBit_Config</HideCondition>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PDSCH_DMRS_NumPorts" Type="PartParam">
<DataEntry>PDSCH_DMRS_NumPorts</DataEntry>
<Description>number of ports for each BWP</Description>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PDSCH_DMRS_PortList" Type="PartParam">
<DataEntry>PDSCH_DMRS_PortList</DataEntry>
<Description>ports index, the range of each element should be in range of [1000 ~ 1011]</Description>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PDSCH_DMRS_TypeA_Pos" Type="PartParam">
<DataEntry>PDSCH_DMRS_TypeA_Pos</DataEntry>
<Description>DL-DMRS-typeA-pos. The position of first DMRS symbol.</Description>
<HideCondition>1==ChBit_Config</HideCondition>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PDSCH_Enable" Type="PartParam">
<DataEntry>PDSCH_Enable</DataEntry>
<Description>enable or disable PUSCH and its DMRS transmission</Description>
<Enum>NR_HARQ_Controller__PUSCH_Enable@5G Advanced Modem Enums</Enum>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="PDSCH_MappingType" Type="PartParam">
<DataEntry>PDSCH_MappingType</DataEntry>
<Description>PDSCH mapping type (A or B)</Description>
<Enum>NR_HARQ_Controller__PDSCH_MappingType@5G Advanced Modem Enums</Enum>
<HideCondition>1==ChBit_Config</HideCondition>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="PDSCH_NumOFDMSyms" Type="PartParam">
<DataEntry>PDSCH_NumOFDMSyms</DataEntry>
<Description>number of OFDM symbols for each PDSCH.</Description>
<HideCondition>1==ChBit_Config</HideCondition>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PDSCH_NumRBs" Type="PartParam">
<DataEntry>PDSCH_NumRBs</DataEntry>
<Description>number of resource blocks (RBs) for each PDSCH.</Description>
<HideCondition>1==ChBit_Config</HideCondition>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PDSCH_PTRS_FrequencyDensity" Type="PartParam">
<DataEntry>PDSCH_PTRS_FrequencyDensity</DataEntry>
<Description>Set the Frequency Density (K_PTRS) for PDSCH PTRS signal. [0: 2 RBs; 1: 4 RBs]</Description>
<HideCondition>ChBit_Config == 1 || PDSCH_Enable == 0 || PTRS_Enable == 0</HideCondition>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PDSCH_PTRS_ResourceElementOffset" Type="PartParam">
<DataEntry>PDSCH_PTRS_ResourceElementOffset</DataEntry>
<Description>Set the PTRS RE Offset for PDSCH PTRS signal generation. [0: 00; 1: 01; 2: 10; 3: 11]</Description>
<HideCondition>ChBit_Config == 1 || PDSCH_Enable == 0 || PTRS_Enable == 0</HideCondition>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PDSCH_PTRS_TimeDensity" Type="PartParam">
<DataEntry>PDSCH_PTRS_TimeDensity</DataEntry>
<Description>Set the Time Density (L_PTRS) for PDSCH PTRS signal. [0: 1 symbol; 1: 2 symbols; 2: 4 symbols]</Description>
<HideCondition>ChBit_Config == 1 || PDSCH_Enable == 0 || PTRS_Enable == 0</HideCondition>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PDSCH_RBOffset" Type="PartParam">
<DataEntry>PDSCH_RBOffset</DataEntry>
<Description>the index of the first resource blocks (RB) allocated to each PDSCH.</Description>
<HideCondition>1==ChBit_Config</HideCondition>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PDSCH_StartOFDMSym" Type="PartParam">
<DataEntry>PDSCH_StartOFDMSym</DataEntry>
<Description>the index for the first OFDM symbol allocated to each PDSCH.</Description>
<HideCondition>1==ChBit_Config</HideCondition>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PDSCH_n_ID" Type="PartParam">
<DataEntry>=PDSCH_n_ID</DataEntry>
<Description>Data-scrambling-Identity for each PDSCH. 0 ~ 1023 or CellID.</Description>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PDSCH_n_RNTI" Type="PartParam">
<DataEntry>=PDSCH_n_RNTI</DataEntry>
<Description>radio network temporary identifier for each PDSCH.</Description>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PTRS_Enable" Type="PartParam">
<DataEntry>PTRS_Enable</DataEntry>
<Description>Enable or disable PDSCH Phase-tracking reference signals transmission</Description>
<Enum>NR_HARQ_Controller__PTRS_Enable@5G Advanced Modem Enums</Enum>
