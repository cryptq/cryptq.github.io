<Item XName="TransBlockSize" Type="PartParam">
<DataEntry>TransBlockSize</DataEntry>
<Description>transport block size for each slot. Only valid when the TBS port is unconnected.</Description>
<HideCondition>Payload_Config == 0</HideCondition>
