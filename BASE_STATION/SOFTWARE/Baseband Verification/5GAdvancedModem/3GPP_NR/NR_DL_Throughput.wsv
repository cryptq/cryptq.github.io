<HideCondition>PTRS_Enable == 0</HideCondition>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PDSCH_PowerBoosting" Type="PartParam">
<DataEntry>[0.0]</DataEntry>
<Description>PDSCH power in dB</Description>
<Validate><T>Int</T><D>14</D></Validate></Item>
<Item XName="PDSCH_RBOffset" Type="PartParam">
<DataEntry>0</DataEntry>
