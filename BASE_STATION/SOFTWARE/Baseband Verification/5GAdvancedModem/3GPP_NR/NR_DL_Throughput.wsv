<Enum>V5G_Demapper__DemapperType@5G Advanced Modem Enums</Enum>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="DesiredDelay" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>Manual setup of time synchronization position instead of auto-detection from NR_DL_FrameSync model when AutoFrameSync is NO</Description>
<Enum />
<HideCondition>1==AutoFrameSync</HideCondition>
<Validate><T>Int</T><D>11</D></Validate></Item>
<Item XName="DesiredFreqOffset" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>Manual setup of frequency synchronization offset instead of auto-detection from NR_DL_FrameSync model when AutoFrameSync is NO</Description>
<HideCondition>1==AutoFrameSync</HideCondition>
<Unit><T>Int</T><D>1001</D></Unit>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="FCarrierRx" Type="PartParam">
<DataEntry>FCarrier</DataEntry>
