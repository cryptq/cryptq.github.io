<Enum>NR_HARQ_Controller__PUSCH_Enable@5G Advanced Modem Enums</Enum>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="PDSCH_MappingType" Type="PartParam">
<DataEntry>PDSCH_MappingType</DataEntry>
<Description>PDSCH mapping type (A or B)</Description>
<Enum>NR_HARQ_Controller__PDSCH_MappingType@5G Advanced Modem Enums</Enum>
<HideCondition>1==ChBit_Config</HideCondition>
