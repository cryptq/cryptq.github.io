<DataEntry>[0]</DataEntry>
<Description>PDCCH candidate index in the range of 0 ~ PDCCH_NumCandidates - 1.</Description>
<HideCondition>PDCCH_Enable==0</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
