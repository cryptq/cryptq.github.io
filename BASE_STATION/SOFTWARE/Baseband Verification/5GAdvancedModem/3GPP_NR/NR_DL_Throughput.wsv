<Data><T>Double</T><D>15</D></Data></Item>
<Item XName="BeamTrainingRxRFChainsList" Type="Variable">
<Creator>Equations</Creator>
<Data><T>Array_Dbl64</T><D>2;1;2;m}3;4</D></Data></Item>
<Item XName="CarrierNumRBs" Type="Variable">
