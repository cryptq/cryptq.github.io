<Enum>NR_DL_MuxOFDMSym__PDSCH_MappingType@5G Advanced Modem Enums</Enum>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="PDSCH_NumAllocatedSlots" Type="PartParam">
<DataEntry>[10]</DataEntry>
<Description>Number of allocated slots for PDSCH in each frame for each BWP.The size of this parameter is equal to NumBWPs</Description>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PDSCH_NumOFDMSyms" Type="PartParam">
<DataEntry>13</DataEntry>
