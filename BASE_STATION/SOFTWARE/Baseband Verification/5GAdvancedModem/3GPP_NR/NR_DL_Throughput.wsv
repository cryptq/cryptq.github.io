<HideCondition>PDCCH_Enable == 0</HideCondition>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="CORESET_MappingType" Type="PartParam">
<DataEntry>[0]</DataEntry>
<Description>the CCE-to-REG mapping type for each CORESET in each BWP. 0 means non-interleaved while 1 means interleaved</Description>
<HideCondition>PDCCH_Enable == 0</HideCondition>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="CORESET_NumSyms" Type="PartParam">
<DataEntry>[1]</DataEntry>
<Description>number of OFDM symbols in the time domain for each CORESET in each BWP. The value should be {1,2,3}</Description>
<HideCondition>PDCCH_Enable == 0</HideCondition>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="CORESET_RB_Bitmap" Type="PartParam">
<DataEntry>[1, 1, 1, 1, 1, 1, 1, 1]</DataEntry>
<Description>PRB bitmap for each CORESET in each BWP in ascending order. Each bit represents a non-overlapping group of 6 PRBs. LSB means the lowest group of 6 PRBs.</Description>
<HideCondition>PDCCH_Enable == 0</HideCondition>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="CORESET_REG_BundleSize" Type="PartParam">
<DataEntry>[6]</DataEntry>
<Description>the REG bundle size for each CORESET in each BWP configured by the higher-layer parameter CORESET-REG-bundle-size. {2,6} for CORESET_NumSyms=1; {CORESET_NumSyms,6} for CORESET_NumSyms={2,3}</Description>
<HideCondition>PDCCH_Enable == 0</HideCondition>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="CORESET_ShiftIndex" Type="PartParam">
<DataEntry>[0]</DataEntry>
<Description>the shift given by the higher-layer parameter CORESET-shift-index. The value should be {0,1,...,274}</Description>
<HideCondition>PDCCH_Enable == 0</HideCondition>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="CORESET_SymOffset" Type="PartParam">
<DataEntry>[0]</DataEntry>
<Description>start OFDM symbol index in the time domain for each CORESET in each BWP.</Description>
<HideCondition>PDCCH_Enable == 0</HideCondition>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="CSIRS_Enable" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>enable or disable CSI RS transmission</Description>
<Enum>NR_DL_ResourceAllocator__CSIRS_Enable@5G Advanced Modem Enums</Enum>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="CellID" Type="PartParam">
<DataEntry>CellID</DataEntry>
<Description>cell identity</Description>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>11</D></Validate></Item>
<Item XName="CompensateFreqOffset" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>switch ON/OFF frequency offset compensation</Description>
<Enum>NR_DemuxFrame__CompensateFreqOffset@5G Advanced Modem Enums</Enum>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="CyclicPrefix" Type="PartParam">
<DataEntry>CyclicPrefix</DataEntry>
<Description>normal CP or extended CP(0: Normal; 1: Extended)</Description>
<Enum>NR_DL_MuxOFDMSym__CyclicPrefix@5G Advanced Modem Enums</Enum>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="DC_Reserved" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>DC is reserved or not (0: No; 1: Yes)</Description>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="DataRcvRxRFChainsList" Type="PartParam">
<DataEntry>[0;1]</DataEntry>
<Description>the index of receiver&apos;s RF chains associated with data receiving.</Description>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="DemapperMaxLevel" Type="PartParam">
<DataEntry>1.0</DataEntry>
<Description>the maximum level for soft demapping output when DemapperType is Soft or CSI</Description>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="DemapperType" Type="PartParam">
<DataEntry>1</DataEntry>
<Description>demapper type</Description>
<Enum>NR_Demapper__DemapperType@5G Advanced Modem Enums</Enum>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="FCarrierRx" Type="PartParam">
<DataEntry>FCarrier</DataEntry>
<Description>frequency carrier of the received signal</Description>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="FCarrierTx" Type="PartParam">
<DataEntry>FCarrier</DataEntry>
<Description>frequency carrier of the transmitting signal</Description>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="Fmax" Type="PartParam">
<DataEntry>1</DataEntry>
<Description>the maximum doppler frequency. (used by 2D-MMSE channel estimator in PDSCH)</Description>
<Show><T>Bool</T><D>0</D></Show>
<Unit><T>Int</T><D>1001</D></Unit>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="HARQ_Enable" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>whether HARQ closed-loop transmission is enabled</Description>
<Enum>NR_HARQ_Controller__HARQ_Enable@5G Advanced Modem Enums</Enum>
<HideCondition>1</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="LDPCBaseGraphType" Type="PartParam">
<DataEntry>LDPCBaseGraphType</DataEntry>
<Description>LDPC base graph type. 0 : Base Graph1; 1 : Base Graph2;</Description>
<HideCondition>Payload_Config == 0</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="LDPC_Algorithm" Type="PartParam">
<DataEntry>1</DataEntry>
<Description>decoding algorithm for LDPC</Description>
<Enum>NR_LDPC_Decoder__Algorithm@5G Advanced Modem Enums</Enum>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="LDPC_IterationNumber" Type="PartParam">
<DataEntry>30</DataEntry>
