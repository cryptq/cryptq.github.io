<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PDSCH_DMRS_TypeA_Pos" Type="PartParam">
<DataEntry>PDSCH_DMRS_TypeA_Pos</DataEntry>
<Description>DL-DMRS-typeA-pos. The position of first DMRS symbol.</Description>
<HideCondition>1==ChBit_Config</HideCondition>
<Validate><T>Int</T><D>13</D></Validate></Item>
