<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="SyncFilter_Enable" Type="PartParam">
<DataEntry>1</DataEntry>
<Description>Sync: enable or disable filter to get PSS/SSS on input signals</Description>
<Enum>NR_DL_FrameSync__Filter_Enable@5G Advanced Modem Enums</Enum>
<HideCondition>0==AutoFrameSync || 1==SyncMethod</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="SyncMaxEstFreqError" Type="PartParam">
<DataEntry>1</DataEntry>
<Description>Specify the frequency error range (-SyncMaxEstFreqError ~ SyncMaxEstFreqError) to be estimated in terms of subcarrier.</Description>
<HideCondition>0==AutoFrameSync || 0==SyncMethod</HideCondition>
<Validate><T>Int</T><D>11</D></Validate></Item>
<Item XName="SyncMethod" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>Synchronization method when AutoFrameSync is YES (0:SSB Sync; 1:CP+DMRS Sync)</Description>
<Enum>NR_DL_SyncMethod@5G Advanced Modem Enums</Enum>
<HideCondition>0==AutoFrameSync</HideCondition>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="SyncSearchRange" Type="PartParam">
<DataEntry>5e-3</DataEntry>
<Description>Sync: search length (starting from the beginning of input data) in units of time (seconds)</Description>
<HideCondition>0==AutoFrameSync || 1==SyncMethod</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="SyncThreshold" Type="PartParam">
<DataEntry>0.4</DataEntry>
<Description>Sync :The correlation threshold for the successful synchronization. It&apos;s in the range of 0.01 ~ 1.0.</Description>
<HideCondition>0==AutoFrameSync || 1==SyncMethod || 1==PBCH_Decoding_Enable</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="SyncTrackingRange" Type="PartParam">
<DataEntry>1024</DataEntry>
<Description>Sync: Tracking length (the searching range centered at the synchronization position detected last time) in units of samples</Description>
<HideCondition>0==AutoFrameSync || 1==SyncMethod</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>11</D></Validate></Item>
<Item XName="Tmax" Type="PartParam">
<DataEntry>1e-6</DataEntry>
<Description>the maximum delay of multi-path channel. (used by 2D-MMSE channel estimator in PDSCH)</Description>
<Show><T>Bool</T><D>0</D></Show>
<Unit><T>Int</T><D>7004</D></Unit>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="TransBlockSize" Type="PartParam">
<DataEntry>TransBlockSize</DataEntry>
<Description>the transport block size (TBS) for each PDSCH. Enabled when Payload_Config is set to 1</Description>
<HideCondition>Payload_Config == 0 || PDSCH_Enable == 0</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="UserDefinedCarrierNumRBs" Type="PartParam">
<DataEntry>UserDefinedCarrierNumRBs</DataEntry>
<Description>user defined number of PRBs for each unique Numerology correspoding to the order of the configured Numerology</Description>
<Enum />
<HideCondition>Bandwidth~=15</HideCondition>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="nCI" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>carrier indicator field value.</Description>
<Validate><T>Int</T><D>11</D></Validate></Item></Item></Item></Item>
