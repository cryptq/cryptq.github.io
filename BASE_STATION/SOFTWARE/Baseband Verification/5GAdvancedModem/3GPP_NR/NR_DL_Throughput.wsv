<Data><T>Array_Dbl64</T><D>2;13;3;v04;A14;mJ14;WQ14;eW14;a14;h14;um14;;;;;;c04;u04;314;W914;GG14;WJ14;WQ14;eW14;Ga14;ed14;8h14;ek14;4n14;;c04;o04;u04;}04;314;W914;GG14;mJ14;GN14;mQ14;GU14;uW14</D></Data></Item>
<Item XName="FR2NumRBsTable" Type="Variable">
