<Item XName="Equations" Type="Equation">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>%%%%%%%%%%%%%%%%%%%%% get CarrierNumRBs by bandwidth and FR&#x000D;&#x000A;FCarrier = 1e9;&#x000D;&#x000A;FCarrierTx = FCarrier;&#x000D;&#x000A;FCarrierRx = FCarrier;&#x000D;&#x000A;&#x000D;&#x000A;if (FCarrierTx &gt;= 450e6 &amp;&amp; FCarrierTx &lt;= 6e9)&#x000D;&#x000A;&#x0009;FrequencyRange = 0; %FR1&#x000D;&#x000A;elseif (FCarrierTx &gt;= 24.25e9 &amp;&amp; FCarrierTx &lt;= 52.6e9)&#x000D;&#x000A;&#x0009;FrequencyRange = 1; %FR2&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;error(&apos;FCarrierTx should be in [450MHz, 6000MHz] for FR1 or [24250MHz, 52600MHz] for FR2.&apos;);&#x000D;&#x000A;end;&#x000D;&#x000A;&#x000D;&#x000A;if FrequencyRange == 0&#x000D;&#x000A;&#x0009;if (FCarrierRx &lt; 450e6 || FCarrierRx &gt; 6e9) &#x000D;&#x000A;&#x0009;&#x0009;error(&apos;FCarrierRx should be in the range of [450MHz, 6000MHz] for FR1&apos;);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;if (FCarrierRx &lt; 24.25e9 || FCarrierRx &gt; 52.6e9) &#x000D;&#x000A;&#x0009;&#x0009;error(&apos;FCarrierRx should be in the range of [24250MHz, 52600MHz] for FR2&apos;);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x000D;&#x000A;FR1NumRBsTable=[25,52,79,106,133,160,216,270,0,0,0,0,0;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;11,24,38,51,65,78,106,133,162,189,217,245,273;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;0,11,18,24,31,38,51,65,79,93,107,121,135];&#x000D;&#x000A;FR2NumRBsTable=[66,132,264,0;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;32,66,132,264;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;17,34,69,138];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;for i=1:length(Numerology)&#x000D;&#x000A;&#x0009;if(FrequencyRange ==0&amp;&amp;Numerology(i)&gt;2)&#x000D;&#x000A;&#x0009;&#x0009;error(&apos;Numerology 3,4 are not supportted in FR1&apos;);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x0009;if(FrequencyRange ==1&amp;&amp;Numerology(i)&lt;2)&#x000D;&#x000A;&#x0009;&#x0009;error(&apos;Numerology 0,1 are not supportted in FR2&apos;);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if (Bandwidth==15)&#x000D;&#x000A;&#x0009;CarrierNumRBs = UserDefinedCarrierNumRBs;&#x000D;&#x000A;else&#x0009;&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;if(FrequencyRange ==0)&#x000D;&#x000A;&#x0009;&#x0009;CarrierNumRBs = FR1NumRBsTable(Numerology+1,Bandwidth+1);&#x000D;&#x000A;&#x0009;else&#x000D;&#x000A;&#x0009;&#x0009;if(Bandwidth&lt;10)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;NumRBsIdx = 1;&#x000D;&#x000A;&#x0009;&#x0009;else&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;NumRBsIdx = Bandwidth-10;&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;CarrierNumRBs = FR2NumRBsTable(Numerology-1, NumRBsIdx);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x0009;&#x000D;&#x000A;&#x000D;&#x000A;% Antenna array configuration, RF and ports mapping configuration&#x000D;&#x000A;% Beam training procedure configuration, &#x000D;&#x000A;NumTxRFChains = 3;&#x000D;&#x000A;NumRxRFChains = 4;&#x000D;&#x000A;PortRFMappingMatrix = [1;0;0;0;1;0;0;0;1];&#x000D;&#x000A;BeamTrainingRxRFChainsList = [2;3];&#x000D;&#x000A;DataRcvRxRFChainsList = [0;1];&#x000D;&#x000A;NumBeamTrainingRounds = 2;&#x000D;&#x000A;% Working beam space configuration, note the unit is radian&#x000D;&#x000A;TxThetaTable = [90;90;90;90]/180*pi;&#x000D;&#x000A;TxPhiTable = [60;20;340;300]/180*pi;&#x000D;&#x000A;RxThetaTable = [90;90;90;90]/180*pi;&#x000D;&#x000A;RxPhiTable = [60;20;340;300]/180*pi;&#x000D;&#x000A;% Channel directions configuration, note the unit is degree&#x000D;&#x000A;ChTxTheta = TxThetaTable([2,4])/pi*180;&#x000D;&#x000A;ChTxPhi = TxPhiTable([2,4])/pi*180;&#x000D;&#x000A;ChRxTheta = RxThetaTable([1,3])/pi*180;&#x000D;&#x000A;ChRxPhi = RxPhiTable([1,3])/pi*180;&#x000D;&#x000A;% Real antenna elements configuration&#x000D;&#x000A;NumTxAnts = 8;&#x000D;&#x000A;NumRxAnts = 4;&#x000D;&#x000A;% SNR setting&#x000D;&#x000A;&#x000D;&#x000A;SNR = tune(50);&#x000D;&#x000A;TxRFChainPower_dBm_15kHz = tune(10); % dBm/15kHz&#x000D;&#x000A;BFGainTx = 10*log10(NumTxAnts);&#x000D;&#x000A;BFGainRx = 10*log10(NumRxAnts);&#x000D;&#x000A;TargetNDensity_dBm_Hz = TxRFChainPower_dBm_15kHz + 10*log10(2^Numerology) - SNR - 10*log10(15e3*(2^Numerology)) + BFGainTx + BFGainRx; % dBm/Hz&#x000D;&#x000A;&#x000D;&#x000A;% FFTSize and SamplingRate calculation&#x000D;&#x000A;FFTSize = 2^ceil(log2(CarrierNumRBs(1)*12))*2^(OversamplingOption);&#x000D;&#x000A;SamplingRate = FFTSize*15e3*2^Numerology;&#x000D;&#x000A;% Configuration check and basic paramter derivation&#x000D;&#x000A;if NumBWPs~=1&#x000D;&#x000A;&#x0009;error(&apos;Only one BWP is supported in throughput simulation.&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;SlotPerFrame = 10 * 2^Numerology;&#x000D;&#x000A;SSB_Periodicity_FrameNum = 0.5 * 2^SSB_Periodicity;&#x000D;&#x000A;SlotIgnored = floor( SSB_Periodicity_FrameNum *  SlotPerFrame)*NumBeamTrainingRounds;&#x000D;&#x000A;% NumSlotMuted configuration, to avoid invalid data analysis&#x000D;&#x000A;NumSlotsMuted = 2 * SlotIgnored;&#x000D;&#x000A;&#x000D;&#x000A;%%%%%%%%%%%%%%%%%%%%%%%%%%get modulation( (0:BPSK or Pi/2 BPSK, 1:QPSK, 2:16QAM, 3:64QAM, 4:256QAM)) from parameter&#x000D;&#x000A;Modulation_t = zeros(1,length(Modulation));&#x000D;&#x000A;for i = 1:length(Modulation)&#x000D;&#x000A;switch(Modulation(i))&#x000D;&#x000A;&#x0009;case 2 &#x000D;&#x000A;&#x0009;&#x0009;Modulation_t(i) = 1;&#x000D;&#x000A;&#x0009;case 4 &#x000D;&#x000A;&#x0009;&#x0009;Modulation_t(i) = 2;&#x000D;&#x000A;&#x0009;case 6 &#x000D;&#x000A;&#x0009;&#x0009;Modulation_t(i) = 3;&#x000D;&#x000A;&#x0009;case 8 &#x000D;&#x000A;&#x0009;&#x0009;Modulation_t(i) = 4;&#x000D;&#x000A;&#x0009;otherwise&#x000D;&#x000A;&#x0009;&#x0009;error(&apos;Element of Modulation should be {2,4,6,8}&apos;);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;L_Table = [4, 8, 64];&#x000D;&#x000A;Num_SSB = L_Table(SSB_Lmax + 1);&#x000D;&#x000A;ActiveSSB = [0:Num_SSB-1];&#x000D;&#x000A;&#x000D;&#x000A;Mu_BWP = [];&#x000D;&#x000A;for i = 0:NumBWPs-1&#x000D;&#x000A;&#x0009;Mu_BWP = [Mu_BWP, Numerology(mod(i, length(Numerology))+1)];&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;NumSlotsPerFrame = 10 * 2.^Mu_BWP;&#x000D;&#x000A;ActiveSlots = [];&#x000D;&#x000A;for i = 1:length(NumSlotsPerFrame)&#x000D;&#x000A;&#x0009;ActiveSlots = [ActiveSlots, 0:NumSlotsPerFrame(i)-1];&#x000D;&#x000A;end</Text>
