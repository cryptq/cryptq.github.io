<DataFormat><T>Int</T><D>0</D></DataFormat>
<Label>Simulation</Label>
<Meas>y</Meas>
<MeasFormat />
<MeasGroup />
<MeasSource><T>Int</T><D>2</D></MeasSource>
<OnRight><T>Bool</T><D>0</D></OnRight>
<PPVar>y</PPVar>
<PlotType />
<PosX><T>Double</T><D>0</D></PosX>
<PosY><T>Double</T><D>0</D></PosY>
<SeriesType><T>Int</T><D>8</D></SeriesType>
<SymbolShape><T>Int</T><D>1</D></SymbolShape>
<UserHide><T>Bool</T><D>0</D></UserHide>
<ZOrder><T>Int</T><D>9000</D></ZOrder>
<Item XName="Eqns" Type="Equation">
<Text>y = getvariable(&apos;WorkspaceVariables&apos;, &apos;BER_Table&apos;);&#x000D;&#x000A;x = getvariable(&apos;WorkspaceVariables&apos;, &apos;SNR_SISO&apos;);&#x000D;&#x000A;setindep(&apos;y&apos;, &apos;x&apos;);</Text>
<Item XName="BPMgr" Type="BPMgr">
<BPLines><T>Empty</T></BPLines>
<BPStates><T>Empty</T></BPStates></Item>
<Item XName="EqnBlock" Type="EqnBlock">
<Lang><T>Int</T><D>1</D></Lang>
<UsingContext>WorkspaceVariables;</UsingContext></Item>
<Item XName="Font" Type="Font">
<Name>Courier New</Name>
<Size><T>Double</T><D>125</D></Size></Item>
<Item XName="FunctionBlock" Type="FunctionBlock" />
<Item XName="VarBlock" Type="VarBlock" /></Item></Item>
<Item XName="Series1" Type="GraphSeries">
<Color><T>Int</T><D>16711680</D></Color>
<Context>&lt; Post Processed &gt;</Context>
<DataFormat><T>Int</T><D>0</D></DataFormat>
<Label>Ideal</Label>
<Meas>y</Meas>
<MeasFormat />
<MeasGroup />
<MeasSource><T>Int</T><D>2</D></MeasSource>
<OnRight><T>Bool</T><D>0</D></OnRight>
<PPVar>y</PPVar>
<PlotType />
<PosX><T>Double</T><D>0</D></PosX>
<PosY><T>Double</T><D>0</D></PosY>
<SeriesType><T>Int</T><D>8</D></SeriesType>
<SymbolShape><T>Int</T><D>1</D></SymbolShape>
<UserHide><T>Bool</T><D>0</D></UserHide>
<ZOrder><T>Int</T><D>8999</D></ZOrder>
<Item XName="Eqns" Type="Equation">
<Text>y = getvariable(&apos;WorkspaceVariables&apos;, &apos;ber_ideal_siso&apos;);&#x000D;&#x000A;x = getvariable(&apos;WorkspaceVariables&apos;, &apos;SNR_SISO&apos;);&#x000D;&#x000A;setindep(&apos;y&apos;, &apos;x&apos;);</Text>
<Item XName="BPMgr" Type="BPMgr">
<BPLines><T>Empty</T></BPLines>
<BPStates><T>Empty</T></BPStates></Item>
<Item XName="EqnBlock" Type="EqnBlock">
<Lang><T>Int</T><D>1</D></Lang>
<UsingContext>WorkspaceVariables;</UsingContext></Item>
<Item XName="Font" Type="Font">
<Name>Courier New</Name>
<Size><T>Double</T><D>125</D></Size></Item>
<Item XName="FunctionBlock" Type="FunctionBlock" />
<Item XName="VarBlock" Type="VarBlock" /></Item></Item></Item>
<Item XName="Width" Type="Param">
<Data><T>Double</T><D>0.2060291394335512</D></Data></Item></Item>
<Item XName="Sweep_SISO" UserName="Sweep_SISO" Type="Equation">
<AutoCalc><T>Bool</T><D>0</D></AutoCalc>
<Selected><T>Bool</T><D>0</D></Selected>
<Text>%In the equation, need to set the following values that will be passed to Pamameter Tab in SISO design&#x000D;&#x000A; %Numerology (0: 15KHz, 1: 30KHz, 2: 60KHz, 3: 120KHz, 4: 240KHz, 5: 480KHz)&#x000D;&#x000A; %PDSCH_RBNumRBs&#x000D;&#x000A; %SNR&#x000D;&#x000A; %EPRE_dBm_15kHz&#x000D;&#x000A;Numerology = 0;&#x000D;&#x000A;PDSCH_RBNumRBs = 52;&#x000D;&#x000A;&#x000D;&#x000A;%set the noise &#x000D;&#x000A;NDensity_dBm_Hz = -174;%dBm/Hz &#x000D;&#x000A;%set noise figure (NF) here if RF models have NF effect&#x000D;&#x000A;NF = 0; %dB&#x000D;&#x000A;&#x000D;&#x000A;%set sweep mode (Mode 0: sweep SNR; Mode 1: sweep receiver power sensitivity)&#x000D;&#x000A;SweepMode = 0;&#x000D;&#x000A;%set SNR range for Mode 0&#x000D;&#x000A;SNR_SISO = -1:4;&#x000D;&#x000A;%set receiver power sensitivity for Mode 1&#x000D;&#x000A;Power_SISO = -105:-100; %dBm&#x000D;&#x000A;&#x000D;&#x000A;if SweepMode == 0&#x000D;&#x000A;&#x0009;%set SNR sweep range&#x000D;&#x000A;&#x0009;EbNo_SISO = SNR_SISO - 10*log10(2); %2 means QPSK. For other modulations, need to change this value&#x000D;&#x000A;&#x0009;ber_ideal_siso = berawgn(EbNo_SISO,&apos;qam&apos;,4);&#x000D;&#x000A;else %Mode 1: sweep receiver power sensitivity&#x000D;&#x000A;    EbNo_SISO = SNR_SISO - 10*log10(2); %2 means QPSK. For other modulations, need to change this value&#x000D;&#x000A;&#x0009;ber_ideal_siso = berawgn(EbNo_SISO,&apos;qam&apos;,4);&#x000D;&#x000A;end;&#x000D;&#x000A;&#x000D;&#x000A;for n = 1:length(SNR_SISO)&#x000D;&#x000A;&#x0009;if SweepMode == 0 %Mode 0: sweep SNR&#x000D;&#x000A;&#x0009;&#x0009;SNR = SNR_SISO(n);&#x000D;&#x000A;&#x0009;&#x0009;EPRE_dBm_15kHz = NDensity_dBm_Hz +10*log10(15e3) + SNR + NF; % dBm/15kHz&#x000D;&#x000A;    &#x0009;SignalPower_dBm(n) = EPRE_dBm_15kHz + 10*log10(PDSCH_RBNumRBs*12);&#x000D;&#x000A;&#x0009;else %Mode 1: sweep receiver power sensitivity&#x000D;&#x000A;&#x0009;&#x0009;SignalPower_dBm(n) = Power_SISO(n);&#x000D;&#x000A;&#x0009;&#x0009;EPRE_dBm_15kHz = SignalPower_dBm(n) - 10*log10(PDSCH_RBNumRBs*12*2^Numerology); % dBm/15kHz&#x000D;&#x000A;&#x0009;&#x0009;SNR = EPRE_dBm_15kHz - 10*log10(15e3) - NDensity_dBm_Hz - NF;&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x0009;&#x000D;&#x000A;&#x0009;runanalysis(&apos;SISO_Analysis&apos;);&#x000D;&#x000A;&#x0009;using(&apos;SISO_Analysis_SISO_Data&apos;);&#x000D;&#x000A;&#x0009;%get BER and Throughput&#x000D;&#x000A;&#x0009;BER_Table(n) = BER;&#x000D;&#x000A;&#x0009;Throughput_Table(n) = N1_Throughput;&#x000D;&#x000A;&#x0009;ThroughputFraction_Table(n) = N1_ThroughputFraction;&#x000D;&#x000A;end;&#x000D;&#x000A;&#x000D;&#x000A;</Text>
