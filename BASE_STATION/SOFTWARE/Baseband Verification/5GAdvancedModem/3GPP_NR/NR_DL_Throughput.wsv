<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="LDPCBaseGraphType" Type="PartParam">
<DataEntry>=LDPCBaseGraphType</DataEntry>
<Description>LDPC base graph type. 0 : Base Graph1; 1 : Base Graph2;</Description>
<HideCondition>Payload_Config == 0</HideCondition>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="LDPC_Algorithm" Type="PartParam">
<DataEntry>=LDPC_Algorithm</DataEntry>
