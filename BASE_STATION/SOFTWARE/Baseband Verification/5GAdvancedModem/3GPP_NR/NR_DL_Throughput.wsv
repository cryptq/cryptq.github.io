<Item XName="Equations" Type="Equation">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>%CC_Bandwidth = CarrierNumRBs*12*15e3*2^Numerology;&#x000D;&#x000A;FCarrier = 1e9;&#x000D;&#x000A;FCarrierTx = FCarrier;&#x000D;&#x000A;FCarrierRx = FCarrier;&#x000D;&#x000A;&#x000D;&#x000A;if (FCarrierTx &gt;= 450e6 &amp;&amp; FCarrierTx &lt;= 6e9)&#x000D;&#x000A;&#x0009;FrequencyRange = 0; %FR1&#x000D;&#x000A;elseif (FCarrierTx &gt;= 24.25e9 &amp;&amp; FCarrierTx &lt;= 52.6e9)&#x000D;&#x000A;&#x0009;FrequencyRange = 1; %FR2&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;error(&apos;FCarrierTx should be in [450MHz, 6000MHz] for FR1 or [24250MHz, 52600MHz] for FR2.&apos;);&#x000D;&#x000A;end;&#x000D;&#x000A;&#x000D;&#x000A;if FrequencyRange == 0&#x000D;&#x000A;&#x0009;if (FCarrierRx &lt; 450e6 || FCarrierRx &gt; 6e9) &#x000D;&#x000A;&#x0009;&#x0009;error(&apos;FCarrierRx should be in the range of [450MHz, 6000MHz] for FR1&apos;);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;if (FCarrierRx &lt; 24.25e9 || FCarrierRx &gt; 52.6e9) &#x000D;&#x000A;&#x0009;&#x0009;error(&apos;FCarrierRx should be in the range of [24250MHz, 52600MHz] for FR2&apos;);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;FR1NumRBsTable=[25,52,79,106,133,160,216,270,0,0,0,0,0;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;11,24,38,51,65,78,106,133,162,189,217,245,273;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;0,11,18,24,31,38,51,65,79,93,107,121,135];&#x000D;&#x000A;FR2NumRBsTable=[66,132,264,0;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;32,66,132,264;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;17,34,69,138];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;%%%%%%%%%%%%%%%%%%samplingRate&#x000D;&#x000A;BandwidthTable =[5e6,10e6,15e6,20e6,25e6,30e6,40e6,50e6,60e6,70e6,80e6,90e6,100e6,200e6,400e6];&#x000D;&#x000A;if (Bandwidth==15)&#x000D;&#x000A;&#x0009;CarrierNumRBs = UserDefinedCarrierNumRBs;&#x000D;&#x000A;&#x0009;FFTSize = 2.^ceil(log2(CarrierNumRBs*12)).*2^(OversamplingOption);&#x000D;&#x000A;&#x0009;SamplingRate = max(FFTSize*15e3.*2.^Numerology);&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;if(FrequencyRange ==0)&#x000D;&#x000A;&#x0009;&#x0009;CarrierNumRBs = FR1NumRBsTable(Numerology+1,Bandwidth+1);&#x000D;&#x000A;&#x0009;else&#x000D;&#x000A;&#x0009;&#x0009;if(Bandwidth&lt;10)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;NumRBsIdx = 1;&#x000D;&#x000A;&#x0009;&#x0009;else&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;NumRBsIdx = Bandwidth-10;&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;CarrierNumRBs = FR2NumRBsTable(Numerology-1,NumRBsIdx);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;FFTSize = 2^ceil(log2(CarrierNumRBs*12))*2^(OversamplingOption);&#x000D;&#x000A;&#x0009;SamplingRate = FFTSize*15e3*2^Numerology;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;NumRBsMu0 = [25,52,79,106,133,160,216,270];&#x000D;&#x000A;NumRBsMu1 = [11,24,38,51,65,78,106,133,162,189,217,245,273];&#x000D;&#x000A;NumRBsMu2 = [0,11,18,24,31,38,51,65,79,93,107,121,135];&#x000D;&#x000A;&#x000D;&#x000A;MCS_IndexList = [4, 24, 23];&#x000D;&#x000A;MCS_TableList = [0, 0, 1];&#x000D;&#x000A;&#x000D;&#x000A;%%%%%%%%%%% AWGN noise density&#x000D;&#x000A;%EPRE = -10%%% dBm/15kHz&#x000D;&#x000A;%NDensity_dBm = EPRE - SNR - 10*log10(15e3);&#x000D;&#x000A;&#x0009;&#x000D;&#x000A;if SystemConfiguration == 1 %User Defined&#x000D;&#x000A;&#x0009;PhaseRotation_Enable =0;&#x000D;&#x000A;&#x0009;Numerology = 0;&#x000D;&#x000A;&#x0009;Numerology_k0 = 0;&#x000D;&#x000A;&#x0009;NumBWPs = 1;&#x000D;&#x000A;&#x0009;CellID = 0;&#x000D;&#x000A;&#x0009;CyclicPrefix = 0;&#x000D;&#x000A;&#x0009;SSB_Enable = 1;&#x000D;&#x000A;&#x0009;SSB_Lmax = 0;&#x000D;&#x000A;&#x0009;SSB_RBOffset = 0;&#x000D;&#x000A;&#x0009;SSB_SymStartOption30K = 0;&#x000D;&#x000A;&#x0009;SSB_TimeOffset = 0;&#x000D;&#x000A;&#x0009;SSB_Numerology = [0];&#x000D;&#x000A;&#x0009;SSB_Periodicity = 1;&#x000D;&#x000A;&#x0009;SSB_ActiveBlocks = [0,1];&#x000D;&#x000A;&#x0009;PSS_PowerBoosting = 0;&#x000D;&#x000A;&#x0009;SSS_PowerBoosting = 0;&#x000D;&#x000A;&#x0009;PBCH_DMRS_PowerBoosting = 0;&#x000D;&#x000A;&#x0009;PBCH_PowerBoosting = 0;&#x000D;&#x000A;&#x0009;PDSCH_Enable = 1;&#x000D;&#x000A;&#x0009;PDSCH_NumAllocatedSlots = [9];&#x000D;&#x000A;&#x0009;PDSCH_AllocatedSlots = [1:9];&#x000D;&#x000A;&#x0009;PDSCH_DMRS_NumPorts = 1;&#x000D;&#x000A;&#x0009;PDSCH_DMRS_PortList = 1000;&#x000D;&#x000A;&#x0009;Payload_Config = 0;&#x000D;&#x000A;&#x0009;MCS = [4];&#x000D;&#x000A;&#x0009;MCSTable = [0];&#x000D;&#x000A;&#x0009;BWP_RBOffset = 0;&#x000D;&#x000A;&#x0009;if(Bandwidth == 15)&#x000D;&#x000A;&#x0009;&#x0009;BWP_NumRBs = CarrierNumRBs;&#x000D;&#x000A;&#x0009;else&#x000D;&#x000A;&#x0009;&#x0009;BWP_NumRBs = NumRBsMu0(Bandwidth+1);&#x0009;&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x0009;PDSCH_DMRS_Length = [1];&#x000D;&#x000A;&#x0009;PDSCH_DMRS_CDMGroupNum = [2];&#x000D;&#x000A;&#x0009;PDSCH_RBOffset = 0;&#x000D;&#x000A;&#x0009;PDSCH_NumRBs = BWP_NumRBs;&#x0009;&#x000D;&#x000A;&#x0009;PDSCH_PowerBoosting = 0;&#x000D;&#x000A;&#x0009;PDSCH_DMRS_PowerBoosting = 0;&#x000D;&#x000A;&#x0009;PDSCH_MappingType = [0];&#x000D;&#x000A;&#x0009;PDSCH_StartOFDMSym = [2];&#x000D;&#x000A;&#x0009;PDSCH_NumOFDMSyms = [12];&#x000D;&#x000A;&#x0009;PDSCH_DMRS_TypeA_Pos = [2];&#x000D;&#x000A;&#x0009;PDSCH_DMRS_ConfigType = [0];&#x000D;&#x000A;&#x0009;PDSCH_DMRS_AddPos =[2];&#x000D;&#x000A;&#x0009;CORESET_NumSyms = [2];&#x000D;&#x000A;&#x0009;CORESET_RB_Bitmap =ones(1,46);&#x000D;&#x000A;&#x0009;PDCCH_NumAllocatedSlots  = [9];&#x000D;&#x000A;&#x0009;PDCCH_AllocatedSlots = [1:9];&#x000D;&#x000A;&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;if(Bandwidth == 15)&#x000D;&#x000A;&#x0009;&#x0009;error(&apos;UserDefined Bandwidth is not supported by FRC simulation&apos;);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x0009;%%%%%%%%% Fixed Reference Configuration %%%%%%%%%%%%%%%%%%%&#x000D;&#x000A;&#x0009;OperationMode = 1; %0: FDD; 1: TDD&#x000D;&#x000A;&#x0009;FRC_Table = 0;%FDD  0; A.3.2.2-1; 1:A.3.2.2-2; 2:A.3.2.2-3; 3:A.3.2.3-1; 4:A.3.2.3-2; 5:A.3.2.3-3; 6:A.3.2.4-1; 7:A.3.2.4-2; 8:A.3.2.4-3&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;  %TDD  0; A.3.3.2-1; 1:A.3.3.2-2; 2:A.3.3.2-3; 3:A.3.2.3-1; 4:A.3.2.3-2; 5:A.3.2.3-3; 6:A.3.2.4-1; 7:A.3.2.4-2; 8:A.3.2.4-3&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;%%%%%%%%%%%%%common parameters for all FRC&#x000D;&#x000A;&#x0009;CORESET_NumSyms = [2];&#x000D;&#x000A;&#x0009;CORESET_RB_Bitmap =ones(1,46);&#x000D;&#x000A;&#x0009;PDSCH_MappingType = [0];&#x000D;&#x000A;&#x0009;PDSCH_StartOFDMSym = [0];&#x000D;&#x000A;&#x0009;PDSCH_NumOFDMSyms = [14];&#x000D;&#x000A;&#x0009;PDSCH_DMRS_TypeA_Pos = [2];&#x000D;&#x000A;&#x0009;PDSCH_DMRS_ConfigType = [0];&#x000D;&#x000A;&#x0009;PDSCH_DMRS_AddPos =[2];&#x000D;&#x000A;&#x0009;SSB_Enable = 1;&#x000D;&#x000A;&#x0009;PhaseRotation_Enable =0;&#x000D;&#x000A;&#x0009;Numerology_k0 = 0;&#x000D;&#x000A;&#x0009;NumBWPs = 1;&#x000D;&#x000A;&#x0009;CellID = 0;&#x000D;&#x000A;&#x0009;CyclicPrefix = 0;&#x000D;&#x000A;&#x0009;SSB_Lmax = 0;&#x000D;&#x000A;&#x0009;SSB_RBOffset = 0;&#x000D;&#x000A;&#x0009;SSB_SymStartOption30K = 0;&#x000D;&#x000A;&#x0009;SSB_TimeOffset = 0;&#x000D;&#x000A;&#x0009;PSS_PowerBoosting = 0;&#x000D;&#x000A;&#x0009;SSS_PowerBoosting = 0;&#x000D;&#x000A;&#x0009;PBCH_DMRS_PowerBoosting = 0;&#x000D;&#x000A;&#x0009;PBCH_PowerBoosting = 0;&#x000D;&#x000A;&#x0009;PDSCH_Enable = 1;&#x000D;&#x000A;&#x0009;PDSCH_DMRS_NumPorts = 1;&#x000D;&#x000A;&#x0009;PDSCH_DMRS_PortList = 1000;&#x000D;&#x000A;&#x0009;Payload_Config = 0;&#x000D;&#x000A;&#x0009;BWP_RBOffset = 0;&#x000D;&#x000A;&#x0009;PDSCH_DMRS_Length = [1];&#x000D;&#x000A;&#x0009;PDSCH_DMRS_CDMGroupNum = [2];&#x000D;&#x000A;&#x0009;PDSCH_RBOffset = 0;&#x000D;&#x000A;&#x0009;PDSCH_PowerBoosting = 0;&#x000D;&#x000A;&#x0009;PDSCH_DMRS_PowerBoosting = 0;&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;%%%%%%%%%%%%%%%%%%%%&#x000D;&#x000A;&#x0009;if (OperationMode == 0) %FDD&#x000D;&#x000A;&#x0009;&#x0009;switch(FRC_Table)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;case 0   %%%%%SCS 15 kHz, FDD, QPSK 1/3&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;if(Bandwidth &gt; 7)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;error(&apos;Bandwidth more than 50MHz are not supported in Table A3.2.2-1&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;Numerology = [0];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;BWP_NumRBs = NumRBsMu0(Bandwidth+1);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDSCH_NumRBs = NumRBsMu0(Bandwidth+1);&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDSCH_NumAllocatedSlots = [9];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDSCH_AllocatedSlots = [1:9];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDCCH_NumAllocatedSlots  = [9];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDCCH_AllocatedSlots = [1:9];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;MCS = [4];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;MCSTable = [0];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;SSB_Numerology = [0];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;SSB_Periodicity = 1;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;SSB_ActiveBlocks = [0,1];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;case 1   %%%%% SCS 30 kHz, FDD, QPSK 1/3&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;if(Bandwidth ==9 ||Bandwidth ==13 ||Bandwidth ==14 )&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;error(&apos;Bandwidth 70MHz, 200MHz and 400MHz are not supported in Table A3.2.2-2&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;if(Bandwidth ==0)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;SSB_Enable =0;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;error(&apos;Bandwidth 5MHz with numerology 30kHz cannot hold a SSB.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;Numerology = [1];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;BWP_NumRBs = NumRBsMu1(Bandwidth+1);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDSCH_NumRBs = NumRBsMu1(Bandwidth+1);&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDSCH_NumAllocatedSlots = [19];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDSCH_AllocatedSlots = [1:19];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDCCH_NumAllocatedSlots  = [19];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDCCH_AllocatedSlots = [1:19];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;MCS = [4];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;MCSTable = [0];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;SSB_Numerology = [1];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;SSB_Periodicity = 1;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;SSB_ActiveBlocks = [0,1];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;case 2  %%%%%%%%%% SCS 60 kHz, FDD, QPSK 1/3&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;if(Bandwidth ==9 ||Bandwidth ==0 ||Bandwidth ==13 ||Bandwidth ==14 )&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;error(&apos;Bandwidth 5MHz, 70MHz, 200MHz and 400MHzare not supported in Table A3.2.2-3&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;Numerology = [2];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;BWP_NumRBs = NumRBsMu2(Bandwidth+1);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDSCH_NumRBs = NumRBsMu2(Bandwidth+1);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDSCH_NumAllocatedSlots = [38];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDSCH_AllocatedSlots = [2:39];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDCCH_NumAllocatedSlots  = [38];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDCCH_AllocatedSlots = [2:39];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;MCS = [4];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;MCSTable = [0];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;SSB_Numerology = [1];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;SSB_Periodicity = 1;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;SSB_ActiveBlocks = [0,1];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;case 3   %%%%%SCS 15 kHz, FDD, 64QAM&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;if(Bandwidth &gt; 7)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;error(&apos;Bandwidth more than 50MHz are not supported in Table A3.2.3-1&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;Numerology = [0];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;BWP_NumRBs = NumRBsMu0(Bandwidth+1);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDSCH_NumRBs = NumRBsMu0(Bandwidth+1);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDSCH_NumAllocatedSlots = [9];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDSCH_AllocatedSlots = [1:9];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDCCH_NumAllocatedSlots  = [9];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDCCH_AllocatedSlots = [1:9];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;MCS = [24];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;MCSTable = [0];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;SSB_Numerology = [0];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;SSB_Periodicity = 1;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;SSB_ActiveBlocks = [0,1];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;case 4   %%%%% SCS 30 kHz, FDD, 64QAM&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;if(Bandwidth ==9 ||Bandwidth ==11 ||Bandwidth ==13 ||Bandwidth ==14 )&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;error(&apos;Bandwidth 70MHz, 90MHz, 200MHz and 400MHz are not supported in Table A3.2.3-2&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;if(Bandwidth ==0)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;SSB_Enable =0;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;error(&apos;Bandwidth 5MHz with numerology 30kHz cannot hold a SSB.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;Numerology = [1];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;BWP_NumRBs = NumRBsMu1(Bandwidth+1);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDSCH_NumRBs = NumRBsMu1(Bandwidth+1);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDSCH_NumAllocatedSlots = [19];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDSCH_AllocatedSlots = [1:19];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDCCH_NumAllocatedSlots  = [19];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDCCH_AllocatedSlots = [1:19];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;MCS = [24];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;MCSTable = [0];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;SSB_Numerology = [1];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;SSB_Periodicity = 1;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;SSB_ActiveBlocks = [0,1];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;case 5  %%%%%%%%%% SCS 60 kHz, FDD, 64QAM&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;if(Bandwidth ==9 ||Bandwidth ==0 ||Bandwidth ==11 ||Bandwidth ==13 ||Bandwidth ==14  )&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;error(&apos;Bandwidth 5MHz, 70MHz, 90MHz, 200MHz and 400MHzare not supported in Table A3.2.2-3&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;Numerology = [2];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;BWP_NumRBs = NumRBsMu2(Bandwidth+1);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDSCH_NumRBs = NumRBsMu2(Bandwidth+1);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDSCH_NumAllocatedSlots = [38];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDSCH_AllocatedSlots = [2:39];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDCCH_NumAllocatedSlots  = [38];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDCCH_AllocatedSlots = [2:39];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;MCS = [24];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;MCSTable = [0];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;SSB_Numerology = [1];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;SSB_Periodicity = 1;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;SSB_ActiveBlocks = [0,1];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;case 6   %%%%%SCS 15 kHz, FDD, 256QAM&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;if(Bandwidth &gt; 7)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;error(&apos;Bandwidth more than 50MHz are not supported in Table A3.2.4-1&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;Numerology = [0];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;BWP_NumRBs = NumRBsMu0(Bandwidth+1);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDSCH_NumRBs = NumRBsMu0(Bandwidth+1);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDSCH_NumAllocatedSlots = [9];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDSCH_AllocatedSlots = [1:9];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDCCH_NumAllocatedSlots  = [9];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDCCH_AllocatedSlots = [1:9];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;MCS = [23];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;MCSTable = [1];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;SSB_Numerology = [0];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;SSB_Periodicity = 1;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;SSB_ActiveBlocks = [0,1];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;case 7   %%%%% SCS 30 kHz, FDD, 256QAM&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;if(Bandwidth ==9 ||Bandwidth ==11 ||Bandwidth ==13 ||Bandwidth ==14 )&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;error(&apos;Bandwidth 70MHz, 90MHz, 200MHz and 400MHz are not supported in Table A3.2.4-2&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;if(Bandwidth ==0)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;SSB_Enable =0;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;error(&apos;Bandwidth 5MHz with numerology 30kHz cannot hold a SSB.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;Numerology = [1];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;BWP_NumRBs = NumRBsMu1(Bandwidth+1);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDSCH_NumRBs = NumRBsMu1(Bandwidth+1);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDSCH_NumAllocatedSlots = [19];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDSCH_AllocatedSlots = [1:19];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDCCH_NumAllocatedSlots  = [19];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDCCH_AllocatedSlots = [1:19];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;MCS = [23];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;MCSTable = [1];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;SSB_Numerology = [1];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;SSB_Periodicity = 1;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;SSB_ActiveBlocks = [0,1];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;case 8  %%%%%%%%%% SCS 60 kHz, FDD, 256QAM&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;if(Bandwidth ==9 ||Bandwidth ==0 ||Bandwidth ==11 ||Bandwidth ==13 ||Bandwidth ==14  )&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;error(&apos;Bandwidth 5MHz, 70MHz, 90MHz, 200MHz and 400MHzare not supported in Table A3.2.4-3&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;Numerology = [2];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;BWP_NumRBs = NumRBsMu2(Bandwidth+1);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDSCH_NumRBs = NumRBsMu2(Bandwidth+1);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDSCH_NumAllocatedSlots = [38];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDSCH_AllocatedSlots = [2:39];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDCCH_NumAllocatedSlots  = [38];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDCCH_AllocatedSlots = [2:39];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;MCS = [23];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;MCSTable = [1];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;SSB_Numerology = [1];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;SSB_Periodicity = 1;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;SSB_ActiveBlocks = [0,1];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;otherwise&#x000D;&#x000A;&#x0009;&#x0009;end&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;else&#x000D;&#x000A;&#x0009;&#x0009;switch(FRC_Table)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;case {0,3,6}  %%%%%0:SCS 15 kHz, TDD, QPSK 1/3&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;%%%%%3:SCS 15 kHz, TDD, 64QAM 3/4&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;%%%%%6:SCS 15 kHz, TDD, 256QAM 4/5&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;if(Bandwidth &gt; 7)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;error(&apos;Bandwidth more than 50MHz are not supported in Table A3.3.%d-1&apos;, (floor(FRC_Table/3)+2));&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;Numerology = [0];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;BWP_NumRBs = NumRBsMu0(Bandwidth+1);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDSCH_NumRBs = NumRBsMu0(Bandwidth+1);&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDSCH_NumAllocatedSlots = [5];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDSCH_AllocatedSlots = [1,2,5,6,7];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDCCH_NumAllocatedSlots  = PDSCH_NumAllocatedSlots;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDCCH_AllocatedSlots = PDSCH_AllocatedSlots;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;MCS = MCS_IndexList(floor(FRC_Table/3)+1);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;MCSTable = MCS_TableList(floor(FRC_Table/3)+1);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;SSB_Numerology = [0];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;SSB_Periodicity = 1;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;SSB_ActiveBlocks = [0,1];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;case {1,4,7}  %%%%%1:SCS 30 kHz, TDD, QPSK 1/3&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;%%%%%4:SCS 30 kHz, TDD, 64QAM 3/4&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;%%%%%7:SCS 30 kHz, TDD, 256QAM 4/5&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;if(Bandwidth ==9 || Bandwidth ==11 ||Bandwidth ==13 ||Bandwidth ==14 )&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;error(&apos;Bandwidth 70MHz, 90MHz, 200MHz and 400MHz are not supported in A3.3.%d-2&apos;, (floor(FRC_Table/3)+2));&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;if(Bandwidth ==0)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;SSB_Enable =0;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;error(&apos;Bandwidth 5MHz with numerology 30kHz cannot hold a SSB.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;Numerology = [1];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;BWP_NumRBs = NumRBsMu1(Bandwidth+1);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDSCH_NumRBs = NumRBsMu1(Bandwidth+1);&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDSCH_NumAllocatedSlots = [13];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDSCH_AllocatedSlots = [1:6,10:16];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDCCH_NumAllocatedSlots  = PDSCH_NumAllocatedSlots;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDCCH_AllocatedSlots = PDSCH_AllocatedSlots;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;MCS = MCS_IndexList(floor(FRC_Table/3)+1);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;MCSTable = MCS_TableList(floor(FRC_Table/3)+1);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;SSB_Numerology = [1];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;SSB_Periodicity = 1;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;SSB_ActiveBlocks = [0,1];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;case {2,5,8}  %%%%%2:SCS 60 kHz, TDD, QPSK 1/3&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;%%%%%5:SCS 60 kHz, TDD, 64QAM 3/4&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;%%%%%8:SCS 60 kHz, TDD, 256QAM 4/5&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;if(Bandwidth ==9 ||Bandwidth ==0 || Bandwidth ==11 ||Bandwidth ==13 ||Bandwidth ==14 )&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;error(&apos;Bandwidth 5MHz, 70MHz, 90MHz, 200MHz and 400MHzare not supported in A3.3.%d-3&apos;, (floor(FRC_Table/3)+2));&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;Numerology = [2];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;BWP_NumRBs = NumRBsMu2(Bandwidth+1);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDSCH_NumRBs = NumRBsMu2(Bandwidth+1);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDSCH_NumAllocatedSlots = [26];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDSCH_AllocatedSlots = [2:13,20:33];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDCCH_NumAllocatedSlots  = PDSCH_NumAllocatedSlots;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;PDCCH_AllocatedSlots = PDSCH_AllocatedSlots;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;MCS = MCS_IndexList(floor(FRC_Table/3)+1);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;MCSTable = MCS_TableList(floor(FRC_Table/3)+1);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;SSB_Numerology = [1];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;SSB_Periodicity = 1;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;SSB_ActiveBlocks = [0,1];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;otherwise&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;for i=1:length(Numerology)&#x000D;&#x000A;&#x0009;if(FrequencyRange ==0&amp;&amp;Numerology(i)&gt;2)&#x000D;&#x000A;&#x0009;&#x0009;error(&apos;Numerology 3,4 are not supportted in FR1&apos;);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x0009;if(FrequencyRange ==1&amp;&amp;Numerology(i)&lt;2)&#x000D;&#x000A;&#x0009;&#x0009;error(&apos;Numerology 0,1 are not supportted in FR2&apos;);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if NumBWPs~=1&#x000D;&#x000A;&#x0009;error(&apos;Only one BWP is supported in throughput simulation.&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;% in the simulation, NumTxRFChains is set to equal to the size of PDSCH_DMRS_PortList&#x000D;&#x000A;% as well as NumRxRFChains&#x000D;&#x000A;NumTxRFChains = numel(PDSCH_DMRS_PortList);&#x000D;&#x000A;NumRxRFChains = numel(PDSCH_DMRS_PortList);&#x000D;&#x000A;&#x000D;&#x000A;SlotPerFrame = 10 * 2^Numerology;&#x000D;&#x000A;SSB_Periodicity_FrameNum = 0.5 * 2^SSB_Periodicity;&#x000D;&#x000A;SlotIgnored = floor( SSB_Periodicity_FrameNum *  SlotPerFrame);&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;NDensity_dBm_Hz = -174;%dBm/Hz&#x000D;&#x000A;%SNR = 10;&#x000D;&#x000A;%%EPRE_dBm_15kHz (input power) is also set in Sweep_SISO equation page&#x000D;&#x000A;%EPRE_dBm_15kHz = NDensity_dBm_Hz +10*log10(15e3) + SNR; % dBm/15kHz&#x000D;&#x000A;%</Text>
