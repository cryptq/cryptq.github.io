<Item XName="DataRcvRxRFChainsList" Type="Variable">
<Creator>Equations</Creator>
<Data><T>Double</T><D>0</D></Data></Item>
<Item XName="FCarrier" Type="Variable">
<Creator>Equations</Creator>
<Data><T>Double</T><D>1000000000</D></Data></Item>
<Item XName="FCarrierRx" Type="Variable">
<Creator>Equations</Creator>
<Data><T>Double</T><D>1000000000</D></Data></Item>
<Item XName="FCarrierTx" Type="Variable">
<Creator>Equations</Creator>
<Data><T>Double</T><D>1000000000</D></Data></Item>
<Item XName="FFTSize" Type="Variable">
<Creator>Equations</Creator>
