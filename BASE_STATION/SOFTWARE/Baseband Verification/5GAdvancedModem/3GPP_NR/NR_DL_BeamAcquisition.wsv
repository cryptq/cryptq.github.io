<Text>&#x000D;&#x000A;%generate phi in one 5 ms&#x000D;&#x000A;FR1NumRBsTable=[25,52,79,106,133,160,216,270,0,0,0,0,0;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;11,24,38,51,65,78,106,133,162,189,217,245,273;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;0,11,18,24,31,38,51,65,79,93,107,121,135];&#x000D;&#x000A;FR2NumRBsTable=[66,132,264,0;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;32,66,132,264;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;17,34,69,138];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;if(FrequencyRange ==0)&#x000D;&#x000A;&#x0009;CarrierNumRBs = FR1NumRBsTable(Numerology+1,Bandwidth+1);&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;if(Bandwidth&lt;10)&#x000D;&#x000A;&#x0009;&#x0009;NumRBsIdx = 1;&#x000D;&#x000A;&#x0009;else&#x000D;&#x000A;&#x0009;&#x0009;NumRBsIdx = Bandwidth-10;&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x0009;CarrierNumRBs = FR2NumRBsTable(Numerology-1,NumRBsIdx);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;CC_Bandwidth = CarrierNumRBs*12*15e3*2^Numerology;&#x000D;&#x000A;OversamplingOption = 0;&#x000D;&#x000A;FFT_Size = 2^ceil(log2(CarrierNumRBs*12))*2^(OversamplingOption);&#x000D;&#x000A;SampleRate = FFT_Size*15e3*2^Numerology;&#x000D;&#x000A;SSB_TimeTable = [5e-3, 10e-3, 20e-3, 40e-3, 80e-3, 160e-3];&#x000D;&#x000A;Time = SSB_TimeTable(SSB_Periodicity+1);&#x000D;&#x000A;FrameLength = Time*SampleRate;&#x000D;&#x000A;&#x000D;&#x000A;long_symbol_len = (144 + 16*2^Numerology + 2048) * FFT_Size / 2048;&#x000D;&#x000A;short_symbol_len = (144 + 2048) * FFT_Size / 2048;&#x000D;&#x000A;long_cp_diff = 16*2^Numerology * FFT_Size / 2048;&#x000D;&#x000A;&#x000D;&#x000A;%Here defines beam control for SSB blocks&#x000D;&#x000A;SS_Idx_15K_le3G = [ 2, 8, 16, 22 ];&#x000D;&#x000A;SS_Idx_15K_gt3G_le6G = [ 2, 8, 16, 22, 30, 36, 44, 50];&#x000D;&#x000A;SS_Idx_30K_le3G_Option1 = [ 4, 8, 16, 20 ];&#x000D;&#x000A;SS_Idx_30K_gt3G_le6G_Option1 = [ 4, 8, 16, 20, 32, 36, 44, 48 ];&#x000D;&#x000A;SS_Idx_30K_le3G_Option2 = [ 2, 8, 16, 22 ];&#x000D;&#x000A;SS_Idx_30K_gt3G_le6G_Option2 = [ 2, 8, 16, 22, 30, 36, 44, 50 ];&#x000D;&#x000A;SS_Idx_120K = [ 4,8,16,20,32,36,44,48,60,64,72,76,88,92,100,104,144,148,156,160,172,176,184,188,200,204,212,216,228,232,240,244,284,288,296,300,312,316,324,328,340,344,352,356,368,372,380,384,424,428,436,440,452,456,464,468,480,484,492,496,508,512,520,524];&#x000D;&#x000A;SS_Idx_240K  = [ 8,12,16,20,32,36,40,44,64,68,72,76,88,92,96,100,120,124,128,132,144,148,152,156,176,180,184,188,200,204,208,212,288,292,296,300,312,316,320,324,344,348,352,356,368,372,376,380,400,404,408,412,424,428,432,436,456,460,464,468,480,484,488,492 ];&#x000D;&#x000A;NumSymbolsPerSlot = 14*2^Numerology;&#x000D;&#x000A;&#x000D;&#x000A;TxPhi = zeros(FrameLength,1);&#x000D;&#x000A;NumRxBeams = length(RxPhiTable);&#x000D;&#x000A;RxPhi = zeros(FrameLength*NumRxBeams, 1);&#x000D;&#x000A;for n=1:SSB_Lmax_Len,&#x000D;&#x000A;&#x0009;%for each SSB&#x000D;&#x000A;&#x0009;if Numerology == 0&#x000D;&#x000A;&#x0009;&#x0009;if SSB_Lmax == 0&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;sym_idx = SS_Idx_15K_le3G(n);&#x000D;&#x000A;&#x0009;&#x0009;elseif SSB_Lmax == 1&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;sym_idx = SS_Idx_15K_gt3G_le6G(n);&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;elseif Numerology == 1&#x000D;&#x000A;&#x0009;&#x0009;if SSB_SymStartOption30kHz == 0&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;if SSB_Lmax == 0&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;sym_idx = SS_Idx_30K_le3G_Option1(n);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;elseif SSB_Lmax == 1&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;sym_idx = SS_Idx_30K_gt3G_le6G_Option1(n);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;else&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;if SSB_Lmax == 0&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;sym_idx = SS_Idx_30K_le3G_Option2(n);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;elseif SSB_Lmax == 1&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;sym_idx = SS_Idx_30K_gt3G_le6G_Option2(n);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;elseif (Numerology == 3)&#x000D;&#x000A;&#x0009;&#x0009;sym_idx = SS_Idx_120K(n);&#x000D;&#x000A;&#x0009;else&#x000D;&#x000A;&#x0009;&#x0009;sym_idx = SS_Idx_240K(n);&#x000D;&#x000A;&#x0009;end;&#x0009;&#x000D;&#x000A;&#x0009;num_long_cp = floor(sym_idx/(NumSymbolsPerSlot/2) + 1);&#x000D;&#x000A;&#x0009;&#x000D;&#x000A;&#x0009;TxPhi(num_long_cp*long_cp_diff+(sym_idx)*short_symbol_len+1: num_long_cp*long_cp_diff+(sym_idx+4)*short_symbol_len)= TxPhiTable(n);&#x000D;&#x000A;end;&#x000D;&#x000A;for n=1:NumRxBeams&#x000D;&#x000A;&#x0009;RxPhi((n-1)*FrameLength+1: n*FrameLength) = RxPhiTable(n);&#x000D;&#x000A;end;&#x000D;&#x000A;&#x000D;&#x000A;%set Noise&#x000D;&#x000A;if (Numerology == 3)&#x000D;&#x000A;&#x0009;SCS = 120e3;&#x000D;&#x000A;else % ==4&#x000D;&#x000A;&#x0009;SCS = 240e3;&#x000D;&#x000A;end;&#x000D;&#x000A;NDensity_dBm = SignalPower_EPRE_dBm  - SNR - 10*log10(15e3) + 10*log10(TxNumRows*TxNumCols);&#x000D;&#x000A;&#x000D;&#x000A;SearchRange = 5e-3;&#x000D;&#x000A;&#x000D;&#x000A;SSB_ActiveBlocks = [0:SSB_Lmax_Len-1];&#x000D;&#x000A;&#x000D;&#x000A;%NDensity_dBm = SignalPower_EPRE_dBm  - SNR - 10*log10(SCS);&#x000D;&#x000A;&#x000D;&#x000A;%if (Numerology == 3)&#x000D;&#x000A;%&#x0009;SearchRange = 0.5e-3;&#x000D;&#x000A;%else % ==4&#x000D;&#x000A;%&#x0009;SearchRange = 0.25e-3;&#x000D;&#x000A;%end;&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;</Text>
