<Item XName="GlobalParameters" UserName="GlobalParameters" Type="Equation">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>%Here we define global parameters&#x000D;&#x000A;&#x000D;&#x000A;%set NR SSB parameters&#x000D;&#x000A;FrequencyRange = 1;&#x000D;&#x000A;Bandwidth = 12; %%% 50MHz&#x000D;&#x000A;Numerology = 3; %0-&gt;15kHz, 1-&gt;30kHz, 3-&gt; 120KHz, 4-&gt; 240KHz&#x000D;&#x000A;SSB_RBOffset = 10; %offset RB index in Carrier bandwidth&#x000D;&#x000A;SSB_Lmax = 2; %L = 64&#x000D;&#x000A;SSB_Periodicity = 0; %5ms, 10ms, 20ms, 40ms, 80ms, 160ms&#x000D;&#x000A;SSB_SymStartOption30kHz = 0;%0-&gt;Option1, 1-&gt;Option2&#x000D;&#x000A;if SSB_Lmax == 0&#x000D;&#x000A;&#x0009;SSB_Lmax_Len = 4;&#x000D;&#x000A;elseif SSB_Lmax == 1&#x000D;&#x000A;&#x0009;SSB_Lmax_Len = 8;&#x000D;&#x000A;else %=2&#x000D;&#x000A;&#x0009;SSB_Lmax_Len = 64;&#x000D;&#x000A;end;&#x000D;&#x000A;NumFrames = 1;&#x000D;&#x000A;&#x000D;&#x000A;%set RF/Beam parameters&#x000D;&#x000A;FCarrier = 28e9;&#x000D;&#x000A;SignalPower_EPRE_dBm = -5;&#x000D;&#x000A;&#x000D;&#x000A;TxPhiTable = [-60:120/SSB_Lmax_Len:60];&#x000D;&#x000A;RxPhiTable = [-15,0,15];&#x000D;&#x000A;&#x000D;&#x000A;%set Tx/Rx antenna arrays&#x000D;&#x000A;TxNumRows = 8;&#x000D;&#x000A;TxNumCols = 8;&#x000D;&#x000A;&#x000D;&#x000A;RxNumRows = 4;&#x000D;&#x000A;RxNumCols = 4;&#x000D;&#x000A;&#x000D;&#x000A;%set one-tap LOS channel (using common DF models)&#x000D;&#x000A;AoD = -20;&#x000D;&#x000A;ZoD = 30;&#x000D;&#x000A;AoA = 0;&#x000D;&#x000A;ZoA = 30;&#x000D;&#x000A;&#x000D;&#x000A;%set SNR in dB at each Rx antenna element&#x000D;&#x000A;SNR = 20; %dB</Text>
<UnitUse><T>Int</T><D>2</D></UnitUse>
<Item XName="BPMgr" Type="BPMgr">
<BPLines><T>Empty</T></BPLines>
<BPStates><T>Empty</T></BPStates></Item>
