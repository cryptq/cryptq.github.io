<Item XName="CalMaxTxRxBeam" UserName="CalMaxTxRxBeam" Type="Equation">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>using(&apos;Design1 Analysis_Design1_Data&apos;)&#x000D;&#x000A;power = SSB_Power;&#x000D;&#x000A;&#x000D;&#x000A;[val, pos] = max(power)&#x000D;&#x000A;pos = pos - 1; %start from 0&#x000D;&#x000A;MaxRxBeamIndex = floor(pos/SSB_Lmax_Len);%start from 0&#x000D;&#x000A;MaxRxBeamAngle = RxPhiTable(MaxRxBeamIndex+1);&#x000D;&#x000A;&#x000D;&#x000A;MaxTxBeamIndex = mod(pos, SSB_Lmax_Len);%start from 0&#x000D;&#x000A;MaxTxBeamAngle = TxPhiTable(MaxTxBeamIndex+1);</Text>
