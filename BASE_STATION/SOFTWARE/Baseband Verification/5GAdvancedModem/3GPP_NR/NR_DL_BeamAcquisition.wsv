<HideCondition>PDCCH_Enable==0</HideCondition>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PDCCH_PowerBoosting" Type="PartParam">
<DataEntry>[0]</DataEntry>
<Description>power boosting in dB for each PDCCH</Description>
<Enum />
<HideCondition>PDCCH_Enable==0</HideCondition>
<Validate><T>Int</T><D>14</D></Validate></Item>
<Item XName="PDCCH_n_RNTI" Type="PartParam">
<DataEntry>[1]</DataEntry>
<Description>The RNTI carried on CRC bits for PDCCH</Description>
<HideCondition>PDCCH_Enable==0</HideCondition>
<Validate><T>Int</T><D>13</D></Validate></Item>
<Item XName="PDSCH_AllocatedSlots" Type="PartParam">
<DataEntry>[0:9]</DataEntry>
