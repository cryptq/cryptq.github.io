<Item XName="Theoretical_16-QAM_BER" UserName="Theoretical_16-QAM_BER" Type="Equation">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>EbNodB_16=0:1:20&#x000D;&#x000A;EbNo=10.^(EbNodB_16/10);&#x000D;&#x000A;%16-QAM BER&#x000D;&#x000A;k=4;&#x000D;&#x000A;M=2^k;&#x000D;&#x000A;x=sqrt(3*k*EbNo/(M-1));&#x000D;&#x000A;QAM_16_Pb=(4/k)*(1-1/sqrt(M))*(1/2)*erfc(x/sqrt(2));&#x000D;&#x000A;&#x000D;&#x000A;</Text>
