<Item XName="FCarrier" Type="PartParam">
<DataEntry>60e+9</DataEntry>
<Description>Frequency carrier</Description>
<Unit><T>Int</T><D>1001</D></Unit>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="FramesToMeas" Type="PartParam">
<DataEntry>2</DataEntry>
<Description>number of frames that will be measured for EVM</Description>
<Validate><T>Int</T><D>11</D></Validate></Item>
<Item XName="InterpacketGap" Type="PartParam">
<DataEntry>2.0e-6</DataEntry>
<Description>The Inter-packet gap value determines the duration of the zero signal energy period preceding each packet.  The value is limited to 0 to 200&#x00C2;&#x00B5;s. The default value is 2&#x00C2;&#x00B5;s.</Description>
<Unit><T>Int</T><D>7004</D></Unit>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="MCS" Type="PartParam">
<DataEntry>16</DataEntry>
<Description>Modulation coding scheme, in rang[0:27]</Description>
<Enum />
<Validate><T>Int</T><D>11</D></Validate></Item>
<Item XName="OversampleRatio" Type="PartParam">
<DataEntry>1</DataEntry>
<Description>0:x1, 1:x2, 2:x4, 3:x8</Description>
<Enum />
<Validate><T>Int</T><D>11</D></Validate></Item>
<Item XName="PSDU_Len" Type="PartParam">
<DataEntry>600</DataEntry>
<Description>Set the non-Control PHY PSDU length in octets. For non-Control PHY modes it is limited to the range [0:262143].</Description>
<Validate><T>Int</T><D>11</D></Validate></Item>
<Item XName="Power" Type="PartParam">
<Data><T>Double</T><D>1</D></Data>
<Description>Transmitter power</Description>
<Unit><T>Int</T><D>11001</D></Unit>
<Validate><T>Int</T><D>0</D></Validate></Item></Item></Item>
