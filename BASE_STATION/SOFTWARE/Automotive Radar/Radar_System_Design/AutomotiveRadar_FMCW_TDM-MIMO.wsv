<Item XName="EquationText" Type="PartParam">
<DataEntry>DataCube = zeros(RangeFFT, DopplerFFT);&#x000D;&#x000A;for Tx = 1:TxElementNum&#x000D;&#x000A;&#x0009;DataCube = DataCube + reshape(input((Tx-1)*RangeFFT*DopplerFFT+1:(Tx-1)*RangeFFT*DopplerFFT+RangeFFT*DopplerFFT), RangeFFT, DopplerFFT)&#x000D;&#x000A;end;&#x000D;&#x000A;DataCube(DataCube&lt; TxElementNum * DataFloor) = 0;&#x000D;&#x000A;DataCube_temp = [DataCube(:,end) DataCube DataCube(:,1)];&#x000D;&#x000A;&#x000D;&#x000A;DataCubeRangeDiff = diff(DataCube);&#x000D;&#x000A;DataCubeDopplerDiff = diff(DataCube_temp,1,2);&#x000D;&#x000A;&#x000D;&#x000A;clear DataCube DataCube_temp&#x000D;&#x000A;&#x000D;&#x000A;DataCubeRangePeak = zeros(RangeFFT,DopplerFFT);&#x000D;&#x000A;DataCubeDopplerPeak = zeros(RangeFFT,DopplerFFT);&#x000D;&#x000A;&#x000D;&#x000A;for m = 1:size(DataCubeRangeDiff,2)&#x000D;&#x000A;    for n = 1:size(DataCubeRangeDiff,1)-1&#x000D;&#x000A;        if DataCubeRangeDiff(n,m)&gt;0 &amp;&amp; DataCubeRangeDiff(n+1,m)&lt;0&#x000D;&#x000A;            DataCubeRangePeak(n+1,m) = 1;         &#x000D;&#x000A;        end&#x000D;&#x000A;    end&#x000D;&#x000A;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;for m = 1:size(DataCubeDopplerDiff,1)&#x000D;&#x000A;    for n = 1:size(DataCubeDopplerDiff,2) - 1&#x000D;&#x000A;        if DataCubeDopplerDiff(m,n)&gt;0 &amp;&amp; DataCubeDopplerDiff(m,n+1)&lt;0&#x000D;&#x000A;            DataCubeDopplerPeak(m,n) = 1; &#x000D;&#x000A;        &#x000D;&#x000A;        end&#x000D;&#x000A;    end&#x000D;&#x000A;end&#x000D;&#x000A;DataCubePeak = DataCubeRangePeak.*DataCubeDopplerPeak;&#x000D;&#x000A;clear DataCubeRangePeak DataCubeDopplerPeak&#x000D;&#x000A;&#x000D;&#x000A;[RangeBin,VelocityBin] = find(DataCubePeak == 1);&#x000D;&#x000A;&#x000D;&#x000A;TargetNum = size(RangeBin,1);&#x000D;&#x000A;</DataEntry>
<Description>Equation Text to Parse, edited in the equation set</Description>
<DocSymbol />
<IsSettable><T>Bool</T><D>0</D></IsSettable>
<Range />
<RunTimeTunable><T>Bool</T><D>0</D></RunTimeTunable>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>4</D></Validate></Item>
