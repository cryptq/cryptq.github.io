<DataEntry>&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;%fd = [2.9768 3]*2/(3.0e8/Fcarrier);&#x000D;&#x000A;TargeData = zeros(TxElementNum*RxElementNum,TargetNum);&#x000D;&#x000A;for Tg = 1:TargetNum&#x000D;&#x000A;&#x0009;TargetRanges(Tg) = (Range(Tg)-1) /RangeFFTSize*SampleRate*Tp/BW*3e8/2;&#x000D;&#x000A;&#x0009;if Velocity(Tg)-1 &gt; DopplerFFTSize/2&#x000D;&#x000A;        TargetVelocities(Tg) = -1*(DopplerFFTSize-Velocity(Tg)+1)/DopplerFFTSize * (1/(2*PRI*TxElementNum)) * (3.0e8/Fcarrier);&#x000D;&#x000A;    else&#x000D;&#x000A;        TargetVelocities(Tg) = (Velocity(Tg)-1)/DopplerFFTSize * (1/(2*PRI*TxElementNum))*(3.0e8/Fcarrier);&#x000D;&#x000A;    end&#x000D;&#x000A;&#x0009;fd = (Velocity(Tg)-1)/DopplerFFTSize * (1/(PRI*TxElementNum));&#x0009;&#x000D;&#x000A;    for Rx = 1:RxElementNum&#x000D;&#x000A;&#x0009;&#x0009;for Tx = 1:TxElementNum    &#x000D;&#x000A;&#x0009;        TargeData((Tx-1)*RxElementNum+Rx,Tg) = ChannelData{Rx}((Tx-1)*RangeFFTSize*DopplerFFTSize+Velocity(Tg)*RangeFFTSize + Range(Tg))*exp(-1i*2*pi*fd*(Tx-1)*PRI);&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;&#x000D;&#x000A;&#x0009;PhaseData = angle(TargeData);&#x000D;&#x000A;&#x0009;PhaseDiffData = diff(PhaseData);&#x000D;&#x000A;&#x0009;PhaseDiffData(PhaseDiffData&gt;pi) = PhaseDiffData(PhaseDiffData&gt;pi) - 2*pi;&#x000D;&#x000A;&#x0009;TargetAngles = -asind(mean(PhaseDiffData)/2/pi/0.5)&#x000D;&#x000A;&#x000D;&#x000A;if TargetNum == 0&#x000D;&#x000A;&#x0009;TargetRanges{1} = 0;&#x000D;&#x000A;&#x0009;TargetVelocities{1} = 0;&#x000D;&#x000A;&#x0009;TargetAngles{1} = 0;&#x000D;&#x000A;end</DataEntry>
