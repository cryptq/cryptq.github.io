<ZOrder><T>Int</T><D>1</D></ZOrder></Item></Item>
<Item XName="VarBlock" Type="VarBlock" /></Item>
<Item XName="Step02-RangeDoppler_Spectrum_Plot" UserName="Step02-RangeDoppler_Spectrum_Plot" Type="Equation">
<AutoCalc><T>Bool</T><D>0</D></AutoCalc>
<Selected><T>Bool</T><D>0</D></Selected>
<Text>%Run analysis&#x000D;&#x000A;runanalysis(&apos;DA2&apos;);&#x000D;&#x000A;using(&apos;DA2_DS2_Data&apos;);&#x000D;&#x000A;&#x000D;&#x000A;%Display Range-Doppler Spectrum and Target&#x000D;&#x000A;%%--------------------------------------------------------------------------&#x000D;&#x000A;%%2D Range-Doppler FFT Plotting Control Parameters&#x000D;&#x000A;FigName1 = &apos;Ch1 Range-Doppler Spectrum-BeforeCFAR&apos;;&#x000D;&#x000A;FigName2 = &apos;Ch1 Range-Doppler Spectrum-AfterCFAR&apos;;&#x000D;&#x000A;&#x000D;&#x000A;DisplayUnit_BeforeCFAR = 1; %Dispay Format Control, 0 for No Linear, 1 for dB&#x000D;&#x000A;Norm_BeforeCFAR = 1; %Normalization Control, 0 for No Normalization, 1 for Normalization&#x000D;&#x000A;&#x000D;&#x000A;DispLimit_BeforeCFAR.Switch = 1; %Display Limit Switch, 0 for OFF, 1 for ON&#x000D;&#x000A;DispLimit_BeforeCFAR.Lower = -120; %-60&#x000D;&#x000A;DispLimit_BeforeCFAR.Upper = 0;&#x000D;&#x000A;&#x000D;&#x000A;RangeMax_BeforeCFAR.Switch = 0;&#x000D;&#x000A;RangeMax_BeforeCFAR.Limit = floor(chirp_Nsamples_BB/2);&#x000D;&#x000A;&#x000D;&#x000A;DisplayUnit_AfterCFAR = 0; %Dispay Format Control, 0 for No Linear, 1 for dB&#x000D;&#x000A;Norm_AfterCFAR = 1; %Normalization Control, 0 for No Normalization, 1 for Normalization&#x000D;&#x000A;&#x000D;&#x000A;DispLimit_AfterCFAR.Switch = 0; %Display Limit Switch, 0 for OFF, 1 for ON&#x000D;&#x000A;DispLimit_AfterCFAR.Lower = 0; %-60&#x000D;&#x000A;DispLimit_AfterCFAR.Upper = 1;&#x000D;&#x000A;&#x000D;&#x000A;RangeMax_AfterCFAR.Switch = 1;&#x000D;&#x000A;RangeMax_AfterCFAR.Limit = floor(chirp_Nsamples_BB/4*3);&#x000D;&#x000A;&#x000D;&#x000A;%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%&#x000D;&#x000A;%% Function Note&#x000D;&#x000A;%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%&#x000D;&#x000A;% Range-Doppler Map Spectrum Plot for FMCW Radar 1-Rx Complex Echo Data&#x000D;&#x000A;%&#x000D;&#x000A;% [USAGE]&#x000D;&#x000A;% DisplayRangeDopplerSpectrum(echo,Fcarrier,PRI,RangeFFTSize,DopplerFFTSize,RangeMax,ADCFs,ChirpDuration,Bandwidth,Name, DisplayUnit, Norm, DispLimit)&#x000D;&#x000A;%&#x000D;&#x000A;% [INPUTS]&#x000D;&#x000A;% echo: Complex Rx Echo Data (complex data in linear scale after dechirp);&#x000D;&#x000A;% Fcarrier: Carrier Frequency (in Hz);&#x000D;&#x000A;% PRI: Pulse Repetition Interval (in sec)&#xFF1B;&#x000D;&#x000A;% Range/DopplerFFTSize: FFT Size in Range/Doppler domain;&#x000D;&#x000A;% RangeMax: Range Display Control Struct:&#x000D;&#x000A;%% RangeMax.Switch controls the OFF/ON of Range Display Range switch (bool, 0 for OFF, 1 for ON),&#x000D;&#x000A;%% RangeMax.Limit sets the number of range values to be displayed (in number of points, unitless);&#x000D;&#x000A;% ADCFs: Sample Rate for ADC output data (sample rate after down chirp, in Samp/sec);&#x000D;&#x000A;% ChirpDuration: Chirp Pulse Duration (in sec);&#x000D;&#x000A;% Bandwidth: Baseband Bandwidth (in Hz);&#x000D;&#x000A;% Name: Figure Name to be displayed;&#x000D;&#x000A;% DisplayUnit: Range-Doppler Map Spectrum Display Unit Setting (bool, 0 for linear, 1 for dB)&#x000D;&#x000A;% Norm&#xFF1A; Range-Doppler Output Normalization (bool, 0 for No, 1 for Yes (normalized to maximum value))&#x000D;&#x000A;% DispLimit: Display Limiting Control Struct: &#x000D;&#x000A;%% DispLimit.Switch: Amplitude Display Limit Switch (bool, 0 for OFF, 1 for ON)&#x000D;&#x000A;%% DispLimit.Upper: Upper Limit for Amplitude Display (linear or dB, unitless)&#x000D;&#x000A;%% DispLimit.Lower: Lower Limit for Amplitude Display (linear or dB, unitless)&#x000D;&#x000A;%&#x000D;&#x000A;% [OUTPUTS]&#x000D;&#x000A;% Range/Doppler Spectrum Mapping Plot, New Figure created automatically&#x000D;&#x000A;%%--------------------------------------------------------------------------&#x000D;&#x000A;AutomotiveRadar_DisplayRangeDopplerSpectrum(FFTBinBeforeCFAR1,Fcarrier,TxElementNum*PRI,RangeFFTSize,DopplerFFTSize,RangeMax_BeforeCFAR,... &#x000D;&#x000A;ADCFs,chirp_duration,chirp_BW, FigName1, DisplayUnit_BeforeCFAR , Norm_BeforeCFAR, DispLimit_BeforeCFAR);&#x000D;&#x000A;&#x000D;&#x000A;AutomotiveRadar_DisplayRangeDopplerSpectrum(FFTBinAfterCFAR,Fcarrier,TxElementNum*PRI,RangeFFTSize,DopplerFFTSize,RangeMax_AfterCFAR,... &#x000D;&#x000A;ADCFs,chirp_duration,chirp_BW, FigName2, DisplayUnit_AfterCFAR , Norm_AfterCFAR, DispLimit_AfterCFAR);</Text>
<Item XName="BPMgr" Type="BPMgr">
<BPLines><T>Empty</T></BPLines>
<BPStates><T>Empty</T></BPStates></Item>
<Item XName="EqnBlock" Type="EqnBlock">
<Lang><T>Int</T><D>1</D></Lang>
<UsingContext>DA2_DS2_Data;</UsingContext></Item>
<Item XName="Font" Type="Font">
<Name>Courier New</Name>
<Size><T>Double</T><D>125</D></Size></Item>
<Item XName="FunctionBlock" Type="FunctionBlock" />
<Item XName="Page" Type="PageMgr">
<Item XName="Display0" Type="EquationDisp">
<DVport><T>Array_Dbl64</T><D>1;4;;;z14;R14</D></DVport>
<PVPort><T>Array_Dbl64</T><D>1;4;;;D6tORZ94u24;SAgfec2FN24</D></PVPort>
<Show><T>Bool</T><D>1</D></Show>
<ShowCmd><T>Int</T><D>1</D></ShowCmd>
<Split><T>Double</T><D>0.3</D></Split>
<Split2><T>Double</T><D>0.3</D></Split2>
<Window><T>Array_I64</T><D>1;4;;s4;a7;H7</D></Window>
<ZOrder><T>Int</T><D>2</D></ZOrder></Item></Item>
<Item XName="VarBlock" Type="VarBlock" /></Item>
<Item XName="Step03-Target_XYCorr_Plot" UserName="Step03-Target_XYCorr_Plot" Type="Equation">
<AutoCalc><T>Bool</T><D>0</D></AutoCalc>
<Selected><T>Bool</T><D>0</D></Selected>
<Text>using(&apos;DA2_DS2_Data&apos;);&#x000D;&#x000A;&#x000D;&#x000A;%%--------------------------------------------------------------------------&#x000D;&#x000A;%% Set XY Coordinate Limits&#x000D;&#x000A;xRange = [-30;30];&#x000D;&#x000A;yRange = [30;220];&#x000D;&#x000A;&#x000D;&#x000A;%% Set Figure Title&#x000D;&#x000A;FigName = &apos;Raw Target Detection Results in X-Y Coordinate&apos;;&#x000D;&#x000A;&#x000D;&#x000A;%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%&#x000D;&#x000A;%% Function Note&#x000D;&#x000A;%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%&#x000D;&#x000A;% Plot Target Distribution in planar XY coordinates&#x000D;&#x000A;%&#x000D;&#x000A;% [USAGE]&#x000D;&#x000A;% AutomotiveRadar_DisplayTargetsInXYCoordinate(GraphName, xRange, yRange,DataChannels, DataChannelSum, RangeFFTSize,DopplerFFTSize, ADCFs, chirp_duration, BandWidth) &#x000D;&#x000A;%&#x000D;&#x000A;% [INPUTS]&#x000D;&#x000A;% GraphName: Output Graph Name&#x000D;&#x000A;% xRange: X coordinates ranges to be plotted, unitless&#x000D;&#x000A;% yRange: Y coordinates ranges to be plotted, unitless&#x000D;&#x000A;% DataChannels: [NumDataSamples NumChannels], complex Rx channel signals&#x000D;&#x000A;%% eg. Suppose we have obtained 4-Rx data after 2D-FFT, before 2D-CFAR;&#x000D;&#x000A;%% Then the format of DataChannels (all in complex data) = [FFTBinBeforeCFAR1.&apos;;FFTBinBeforeCFAR2.&apos;; FFTBinBeforeCFAR3.&apos;; FFTBinBeforeCFAR4.&apos;]&#x000D;&#x000A;% DataChannelSum: Complex Sum of all Rx Data, usually obtained in workspace, complex Rx channel signals&#x000D;&#x000A;% Range/DopplerFFTSize: FFT Size in Range/Doppler domain;&#x000D;&#x000A;% ADCFs: ADC Sample Rate (in Sample/Sec)&#x000D;&#x000A;% ChirpDuration: Chirp Pulse Duration (in sec);&#x000D;&#x000A;% Bandwidth: Baseband Bandwidth (in Hz);&#x000D;&#x000A;% &#x000D;&#x000A;% [OUTPUTS]&#x000D;&#x000A;% Static Target Detection Results with Planar X-Y Plot, New Figure created automatically&#x000D;&#x000A;%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%&#x000D;&#x000A;&#x000D;&#x000A;RxChannels = [FFTBinBeforeCFAR1.&apos;; &#x000D;&#x000A;&#x0009;&#x0009;&#x0009;  FFTBinBeforeCFAR2.&apos;; &#x000D;&#x000A;&#x0009;&#x0009;&#x0009;  FFTBinBeforeCFAR3.&apos;; &#x000D;&#x000A;&#x0009;&#x0009;&#x0009;  FFTBinBeforeCFAR4.&apos;];&#x000D;&#x000A;&#x000D;&#x000A;AutomotiveRadar_DisplayTargetsInXYCoordinate(FigName, xRange, yRange, RxChannels, SumChannel, RangeFFTSize,DopplerFFTSize,ADCFs,chirp_duration,chirp_BW);&#x000D;&#x000A;&#x000D;&#x000A;%% Resave CFAR + Threshold target detection results&#x000D;&#x000A;TargetNumber = size(TargetRanges,3);&#x000D;&#x000A;if TargetNumber &gt; 0&#x000D;&#x000A;&#x0009;MeasuredRange1 = TargetRanges(1,1);%RangeBin(1)  / RangeFFTSize * ADCFs * chirp_duration * c / (2 * chirp_BW);&#x000D;&#x000A;&#x0009;MeasuredVelocity1 = TargetVelocties(1,1);%VelocityBin(1) / DopplerFFTSize * PRF * Wavelength/2 ;&#x000D;&#x000A;&#x0009;MeasuredAngle1 = TargetAngles(1,1);%Angles(1);&#x0009;&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;MeasuredRange1 = 0;&#x000D;&#x000A;    MeasuredVelocity1 = 0;&#x000D;&#x000A;&#x0009;MeasuredAngle1 = 0;&#x0009;&#x000D;&#x000A;end;&#x000D;&#x000A;if TargetNumber &gt; 1&#x0009;&#x000D;&#x000A;&#x0009;MeasuredRange2 =  TargetRanges(1,2);%RangeBin(2)  / RangeFFTSize * ADCFs * chirp_duration * c / (2 * chirp_BW);&#x000D;&#x000A;    MeasuredVelocity2 = TargetVelocties(1,2);%VelocityBin(2) / DopplerFFTSize * PRF * Wavelength/2;&#x000D;&#x000A;&#x0009;MeasuredAngle2 = TargetAngles(1,2);%Angles(2);&#x0009;&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;MeasuredRange2 = 0;&#x000D;&#x000A;    MeasuredVelocity2 = 0;&#x0009;&#x000D;&#x000A;&#x0009;MeasuredAngle2 = 0;&#x0009;&#x000D;&#x000A;end;</Text>
