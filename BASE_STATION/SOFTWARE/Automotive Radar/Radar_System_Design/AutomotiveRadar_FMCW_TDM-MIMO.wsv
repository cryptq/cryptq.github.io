 a customized antenna pattern file&lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormalCxSpMiddle style=&quot;MARGIN: 0in 0in 10pt 0.7in; LINE-HEIGHT: normal; TEXT-INDENT: -0.25in; mso-add-space: auto&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 12pt; COLOR: black; mso-fareast-font-family: Calibri; mso-font-kerning: 12.0pt; mso-bidi-font-family: Calibri; mso-ascii-font-family: Calibri; mso-hansi-font-family: Calibri&quot;&gt;&lt;FONT face=&quot;Times New Roman&quot;&gt;4.&lt;/FONT&gt;&lt;/SPAN&gt;&lt;SPAN style=&apos;FONT-SIZE: 7pt; FONT-FAMILY: &quot;Times New Roman&quot;,serif; COLOR: black; mso-fareast-font-family: Calibri; mso-font-kerning: 12.0pt&apos;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;/SPAN&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; COLOR: black; mso-fareast-font-family: &quot;Times New Roman&quot;; mso-font-kerning: 12.0pt; mso-bidi-font-family: Calibri; mso-ascii-font-family: Calibri; mso-hansi-font-family: Calibri&apos;&gt;&lt;FONT face=&quot;Times New Roman&quot;&gt;Enable phase noise simulation or not (the actual phase noise data is defined in &lt;B style=&quot;mso-bidi-font-weight: normal&quot;&gt;PN_Data&lt;/B&gt; variable in the &lt;B style=&quot;mso-bidi-font-weight: normal&quot;&gt;Step01-System_Equations&lt;/B&gt; equation)&lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormalCxSpMiddle style=&quot;MARGIN: 0in 0in 10pt 0.7in; LINE-HEIGHT: normal; TEXT-INDENT: -0.25in; mso-add-space: auto&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 12pt; COLOR: black; mso-fareast-font-family: Calibri; mso-font-kerning: 12.0pt; mso-bidi-font-family: Calibri; mso-ascii-font-family: Calibri; mso-hansi-font-family: Calibri&quot;&gt;&lt;FONT face=&quot;Times New Roman&quot;&gt;5.&lt;/FONT&gt;&lt;/SPAN&gt;&lt;SPAN style=&apos;FONT-SIZE: 7pt; FONT-FAMILY: &quot;Times New Roman&quot;,serif; COLOR: black; mso-fareast-font-family: Calibri; mso-font-kerning: 12.0pt&apos;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;/SPAN&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; COLOR: black; mso-fareast-font-family: &quot;Times New Roman&quot;; mso-font-kerning: 12.0pt; mso-bidi-font-family: Calibri; mso-ascii-font-family: Calibri; mso-hansi-font-family: Calibri&apos;&gt;&lt;FONT face=&quot;Times New Roman&quot;&gt;Enable thermal noise or not&lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormalCxSpMiddle style=&quot;MARGIN: 0in 0in 10pt 0.7in; LINE-HEIGHT: normal; TEXT-INDENT: -0.25in; mso-add-space: auto&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; COLOR: black; mso-fareast-font-family: &quot;Times New Roman&quot;; mso-font-kerning: 12.0pt; mso-bidi-font-family: Calibri; mso-ascii-font-family: Calibri; mso-hansi-font-family: Calibri&apos;&gt;&lt;o:p&gt;&lt;FONT face=&quot;Times New Roman&quot;&gt;&amp;nbsp;&lt;/FONT&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 10pt 0.2in; LINE-HEIGHT: normal&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; COLOR: black; mso-fareast-font-family: &quot;Times New Roman&quot;; mso-font-kerning: 12.0pt; mso-bidi-font-family: Calibri; mso-ascii-font-family: Calibri; mso-hansi-font-family: Calibri&apos;&gt;&lt;FONT face=Calibri&gt;After the simulation is finished, the following results are shown in the text windows:&lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormalCxSpMiddle style=&quot;MARGIN: 0in 0in 10pt 0.7in; LINE-HEIGHT: normal; TEXT-INDENT: -0.25in; mso-add-space: auto&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 12pt; FONT-FAMILY: Symbol; COLOR: black; mso-fareast-font-family: Symbol; mso-font-kerning: 12.0pt; mso-bidi-font-family: Symbol&quot;&gt;&#x00B7;&lt;/SPAN&gt;&lt;SPAN style=&apos;FONT-SIZE: 7pt; FONT-FAMILY: &quot;Times New Roman&quot;,serif; COLOR: black; mso-fareast-font-family: Symbol; mso-font-kerning: 12.0pt&apos;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;/SPAN&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; COLOR: black; mso-fareast-font-family: &quot;Times New Roman&quot;; mso-font-kerning: 12.0pt; mso-bidi-font-family: Calibri; mso-ascii-font-family: Calibri; mso-hansi-font-family: Calibri&apos;&gt;&lt;FONT face=&quot;Times New Roman&quot;&gt;Target Range True Values &lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormalCxSpMiddle style=&quot;MARGIN: 0in 0in 10pt 0.7in; LINE-HEIGHT: normal; TEXT-INDENT: -0.25in; mso-add-space: auto&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 12pt; FONT-FAMILY: Symbol; COLOR: black; mso-fareast-font-family: Symbol; mso-font-kerning: 12.0pt; mso-bidi-font-family: Symbol&quot;&gt;&#x00B7;&lt;/SPAN&gt;&lt;SPAN style=&apos;FONT-SIZE: 7pt; FONT-FAMILY: &quot;Times New Roman&quot;,serif; COLOR: black; mso-fareast-font-family: Symbol; mso-font-kerning: 12.0pt&apos;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;/SPAN&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; COLOR: black; mso-fareast-font-family: &quot;Times New Roman&quot;; mso-font-kerning: 12.0pt; mso-bidi-font-family: Calibri; mso-ascii-font-family: Calibri; mso-hansi-font-family: Calibri&apos;&gt;&lt;FONT face=&quot;Times New Roman&quot;&gt;Target Range Measured Values &lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormalCxSpMiddle style=&quot;MARGIN: 0in 0in 10pt 0.7in; LINE-HEIGHT: normal; TEXT-INDENT: -0.25in; mso-add-space: auto&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 12pt; FONT-FAMILY: Symbol; COLOR: black; mso-fareast-font-family: Symbol; mso-font-kerning: 12.0pt; mso-bidi-font-family: Symbol&quot;&gt;&#x00B7;&lt;/SPAN&gt;&lt;SPAN style=&apos;FONT-SIZE: 7pt; FONT-FAMILY: &quot;Times New Roman&quot;,serif; COLOR: black; mso-fareast-font-family: Symbol; mso-font-kerning: 12.0pt&apos;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;/SPAN&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; COLOR: black; mso-fareast-font-family: &quot;Times New Roman&quot;; mso-font-kerning: 12.0pt; mso-bidi-font-family: Calibri; mso-ascii-font-family: Calibri; mso-hansi-font-family: Calibri&apos;&gt;&lt;FONT face=&quot;Times New Roman&quot;&gt;Target Velocity True Values&lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormalCxSpMiddle style=&quot;MARGIN: 0in 0in 10pt 0.7in; LINE-HEIGHT: normal; TEXT-INDENT: -0.25in; mso-add-space: auto&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 12pt; FONT-FAMILY: Symbol; COLOR: black; mso-fareast-font-family: Symbol; mso-font-kerning: 12.0pt; mso-bidi-font-family: Symbol&quot;&gt;&#x00B7;&lt;/SPAN&gt;&lt;SPAN style=&apos;FONT-SIZE: 7pt; FONT-FAMILY: &quot;Times New Roman&quot;,serif; COLOR: black; mso-fareast-font-family: Symbol; mso-font-kerning: 12.0pt&apos;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;/SPAN&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; COLOR: black; mso-fareast-font-family: &quot;Times New Roman&quot;; mso-font-kerning: 12.0pt; mso-bidi-font-family: Calibri; mso-ascii-font-family: Calibri; mso-hansi-font-family: Calibri&apos;&gt;&lt;FONT face=&quot;Times New Roman&quot;&gt;Target Velocity Measured Values&lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormalCxSpMiddle style=&quot;MARGIN: 0in 0in 10pt 0.7in; LINE-HEIGHT: normal; TEXT-INDENT: -0.25in; mso-add-space: auto&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 12pt; FONT-FAMILY: Symbol; COLOR: black; mso-fareast-font-family: Symbol; mso-font-kerning: 12.0pt; mso-bidi-font-family: Symbol&quot;&gt;&#x00B7;&lt;/SPAN&gt;&lt;SPAN style=&apos;FONT-SIZE: 7pt; FONT-FAMILY: &quot;Times New Roman&quot;,serif; COLOR: black; mso-fareast-font-family: Symbol; mso-font-kerning: 12.0pt&apos;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;/SPAN&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; COLOR: black; mso-fareast-font-family: &quot;Times New Roman&quot;; mso-font-kerning: 12.0pt; mso-bidi-font-family: Calibri; mso-ascii-font-family: Calibri; mso-hansi-font-family: Calibri&apos;&gt;&lt;FONT face=&quot;Times New Roman&quot;&gt;Target Angle True Values&lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormalCxSpMiddle style=&quot;MARGIN: 0in 0in 10pt 0.7in; LINE-HEIGHT: normal; TEXT-INDENT: -0.25in; mso-add-space: auto&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 12pt; FONT-FAMILY: Symbol; COLOR: black; mso-fareast-font-family: Symbol; mso-font-kerning: 12.0pt; mso-bidi-font-family: Symbol&quot;&gt;&#x00B7;&lt;/SPAN&gt;&lt;SPAN style=&apos;FONT-SIZE: 7pt; FONT-FAMILY: &quot;Times New Roman&quot;,serif; COLOR: black; mso-fareast-font-family: Symbol; mso-font-kerning: 12.0pt&apos;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;/SPAN&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; COLOR: black; mso-fareast-font-family: &quot;Times New Roman&quot;; mso-font-kerning: 12.0pt; mso-bidi-font-family: Calibri; mso-ascii-font-family: Calibri; mso-hansi-font-family: Calibri&apos;&gt;&lt;FONT face=&quot;Times New Roman&quot;&gt;Target Angle Measured Values&lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormalCxSpMiddle style=&quot;MARGIN: 0in 0in 10pt 0.7in; LINE-HEIGHT: normal; TEXT-INDENT: -0.25in; mso-add-space: auto&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif; mso-fareast-font-family: &quot;Times New Roman&quot;&apos;&gt;&lt;o:p&gt;&amp;nbsp;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal&quot;&gt;&lt;FONT face=Calibri&gt;&lt;B&gt;&lt;SPAN style=&apos;FONT-SIZE: 13.5pt; COLOR: black; mso-fareast-font-family: &quot;Times New Roman&quot;; mso-font-kerning: 12.0pt; mso-bidi-font-family: Calibri; mso-ascii-font-family: Calibri; mso-hansi-font-family: Calibri&apos;&gt;Note: &lt;/SPAN&gt;&lt;/B&gt;&lt;SPAN style=&apos;FONT-SIZE: 13.5pt; COLOR: black; mso-fareast-font-family: &quot;Times New Roman&quot;; mso-font-kerning: 12.0pt; mso-bidi-font-family: Calibri; mso-ascii-font-family: Calibri; mso-hansi-font-family: Calibri&apos;&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoListParagraphCxSpFirst style=&quot;MARGIN: 1.2pt 0in 10pt 52.2pt; TEXT-INDENT: -19.8pt; mso-add-space: auto; mso-list: l0 level1 lfo1&quot;&gt;&lt;SPAN style=&apos;FONT-FAMILY: &quot;Calibri&quot;,sans-serif; COLOR: black; mso-fareast-font-family: Calibri; mso-font-kerning: 12.0pt&apos;&gt;&lt;SPAN style=&quot;mso-list: Ignore&quot;&gt;1.&lt;SPAN style=&apos;FONT: 7pt &quot;Times New Roman&quot;&apos;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;SPAN style=&apos;FONT-FAMILY: &quot;Calibri&quot;,sans-serif; COLOR: black; mso-font-kerning: 12.0pt&apos;&gt;If you are not familiar with the three-layer radar simulation architectures, please refer to other radar/automotive radar examples for more information.&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoListParagraphCxSpLast style=&quot;MARGIN: 1.2pt 0in 10pt 52.2pt; mso-add-space: auto&quot;&gt;&lt;SPAN style=&apos;FONT-FAMILY: &quot;Calibri&quot;,sans-serif; COLOR: black; mso-font-kerning: 12.0pt&apos;&gt;&lt;o:p&gt;&amp;nbsp;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormalCxSpFirst style=&quot;MARGIN: 0in 0in 10pt 0.7in; LINE-HEIGHT: normal; TEXT-INDENT: -0.25in; mso-add-space: auto&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 12pt; COLOR: black; mso-fareast-font-family: Calibri; mso-font-kerning: 12.0pt; mso-bidi-font-family: Calibri; mso-ascii-font-family: Calibri; mso-hansi-font-family: Calibri&quot;&gt;&lt;FONT face=&quot;Times New Roman&quot;&gt;2.&lt;/FONT&gt;&lt;/SPAN&gt;&lt;SPAN style=&apos;FONT-SIZE: 7pt; FONT-FAMILY: &quot;Times New Roman&quot;,serif; COLOR: black; mso-fareast-font-family: Calibri; mso-font-kerning: 12.0pt&apos;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;/SPAN&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; COLOR: black; mso-fareast-font-family: &quot;Times New Roman&quot;; mso-font-kerning: 12.0pt; mso-bidi-font-family: Calibri; mso-ascii-font-family: Calibri; mso-hansi-font-family: Calibri&apos;&gt;&lt;FONT face=&quot;Times New Roman&quot;&gt;In current Rx design, there is no filter added before &lt;B style=&quot;mso-bidi-font-weight: normal&quot;&gt;DownSample&lt;/B&gt; model to reduce the noise output of signal bandwidth. This is not the same as generic RF design noise floor changing and will decrease input noise level. &lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormalCxSpMiddle style=&quot;MARGIN: 0in 0in 10pt 0.7in; LINE-HEIGHT: normal; TEXT-INDENT: -0.25in; mso-add-space: auto&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; COLOR: black; mso-fareast-font-family: &quot;Times New Roman&quot;; mso-font-kerning: 12.0pt; mso-bidi-font-family: Calibri; mso-ascii-font-family: Calibri; mso-hansi-font-family: Calibri&apos;&gt;&lt;o:p&gt;&lt;FONT face=&quot;Times New Roman&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;/FONT&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; COLOR: black; mso-fareast-font-family: &quot;Times New Roman&quot;; mso-font-kerning: 12.0pt; mso-bidi-font-family: Calibri; mso-ascii-font-family: Calibri; mso-hansi-font-family: Calibri&apos;&gt;&lt;FONT face=&quot;Times New Roman&quot;&gt;To compensate the noise level, the noise added in &lt;B style=&quot;mso-bidi-font-weight: normal&quot;&gt;AddNDensity&lt;/B&gt; model is set with an offset of &lt;I style=&quot;mso-bidi-font-style: normal&quot;&gt;(-10*log10(ADC_DS_Ratio)&lt;/I&gt;). If users want to add a filter to reduce the noise out of signal bandwidth, then they need to adjust measured range result by removing the filter delay introduced by the filter.&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormalCxSpMiddle style=&quot;MARGIN: 0in 0in 10pt 0.7in; LINE-HEIGHT: normal; TEXT-INDENT: -0.25in; mso-add-space: auto&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; COLOR: black; mso-fareast-font-family: &quot;Times New Roman&quot;; mso-font-kerning: 12.0pt; mso-bidi-font-family: Calibri; mso-ascii-font-family: Calibri; mso-hansi-font-family: Calibri&apos;&gt;&lt;FONT face=&quot;Times New Roman&quot;&gt;3.&amp;nbsp;&amp;nbsp; There are two built-in functions applied in this example, one is DisplayRangeDopplerSpectrum() and the other is DisplayTargetsInXYCoordinate(). The function usage note is given here and please refer to the &quot;Step02&quot; and &quot;Step03&quot; equations for application details.&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormalCxSpMiddle style=&quot;MARGIN: 0in 0in 10pt 0.7in; LINE-HEIGHT: normal; TEXT-INDENT: -0.25in; mso-add-space: auto&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; COLOR: black; mso-fareast-font-family: &quot;Times New Roman&quot;; mso-font-kerning: 12.0pt; mso-bidi-font-family: Calibri; mso-ascii-font-family: Calibri; mso-hansi-font-family: Calibri&apos;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;FONT size=2&gt;%%%%%%%%%%%%%%%%%%%&lt;BR&gt;%% Function Note&lt;BR&gt;%%%%%%%%%%%%%%%%%%%&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormalCxSpMiddle style=&quot;MARGIN: 0in 0in 10pt 0.7in; LINE-HEIGHT: normal; TEXT-INDENT: -0.25in; mso-add-space: auto&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; COLOR: black; mso-fareast-font-family: &quot;Times New Roman&quot;; mso-font-kerning: 12.0pt; mso-bidi-font-family: Calibri; mso-ascii-font-family: Calibri; mso-hansi-font-family: Calibri&apos;&gt;&lt;FONT size=2&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; % Range-Doppler Map Spectrum Plot for FMCW Radar 1-Rx Complex Echo Data&lt;BR&gt;%&lt;BR&gt;% [USAGE]&lt;BR&gt;% DisplayRangeDopplerSpectrum(echo,Fcarrier,PRI,RangeFFTSize,DopplerFFTSize,RangeMax,ADCFs,ChirpDuration,Bandwidth,Name, DisplayUnit, Norm, DispLimit)&lt;BR&gt;%&lt;BR&gt;% [INPUTS]&lt;BR&gt;% echo: Complex Rx Echo Data (complex data in linear scale after dechirp);&lt;BR&gt;% Fcarrier: Carrier Frequency (in Hz);&lt;BR&gt;% PRI: Pulse Repetition Interval (in sec)&#xFF1B;&lt;BR&gt;% Range/DopplerFFTSize: FFT Size in Range/Doppler domain;&lt;BR&gt;% RangeMax: Range Display Control Struct:&lt;BR&gt;%% RangeMax.Switch controls the OFF/ON of Range Display Range switch (bool, 0 for OFF, 1 for ON),&lt;BR&gt;%% RangeMax.Limit sets the number of range values to be displayed (in number of points, unitless);&lt;BR&gt;% ADCFs: Sample Rate for ADC output data (sample rate after down chirp, in Samp/sec);&lt;BR&gt;% ChirpDuration: Chirp Pulse Duration (in sec);&lt;BR&gt;% Bandwidth: Baseband Bandwidth (in Hz);&lt;BR&gt;% Name: Figure Name to be displayed;&lt;BR&gt;% DisplayUnit: Range-Doppler Map Spectrum Display Unit Setting (bool, 0 for linear, 1 for dB)&lt;BR&gt;% Norm&#xFF1A; Range-Doppler Output Normalization (bool, 0 for No, 1 for Yes (normalized to maximum value))&lt;BR&gt;% DispLimit: Display Limiting Control Struct: &lt;BR&gt;%% DispLimit.Switch: Amplitude Display Limit Switch (bool, 0 for OFF, 1 for ON)&lt;BR&gt;%% DispLimit.Upper: Upper Limit for Amplitude Display (linear or dB, unitless)&lt;BR&gt;%% DispLimit.Lower: Lower Limit for Amplitude Display (linear or dB, unitless)&lt;BR&gt;%&lt;BR&gt;% [OUTPUTS]&lt;BR&gt;% Range/Doppler Spectrum Mapping Plot, New Figure created automatically&lt;BR&gt;%%--------------------------------------------------------------------------&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormalCxSpMiddle style=&quot;MARGIN: 0in 0in 10pt 0.7in; LINE-HEIGHT: normal; TEXT-INDENT: -0.25in; mso-add-space: auto&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; COLOR: black; mso-fareast-font-family: &quot;Times New Roman&quot;; mso-font-kerning: 12.0pt; mso-bidi-font-family: Calibri; mso-ascii-font-family: Calibri; mso-hansi-font-family: Calibri&apos;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;FONT size=2&gt;%%%%%%%%%%%%%%%%%%%&lt;BR&gt;%% Function Note&lt;BR&gt;%%%%%%%%%%%%%%%%%%%&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormalCxSpMiddle style=&quot;MARGIN: 0in 0in 10pt 0.7in; LINE-HEIGHT: normal; TEXT-INDENT: -0.25in; mso-add-space: auto&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; COLOR: black; mso-fareast-font-family: &quot;Times New Roman&quot;; mso-font-kerning: 12.0pt; mso-bidi-font-family: Calibri; mso-ascii-font-family: Calibri; mso-hansi-font-family: Calibri&apos;&gt;&lt;FONT size=2&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; % Plot Target Distribution in planar XY coordinates&lt;BR&gt;%&lt;BR&gt;% [USAGE]&lt;BR&gt;% AutomotiveRadar_DisplayTargetsInXYCoordinate(GraphName, xRange, yRange,DataChannels, DataChannelSum, RangeFFTSize,DopplerFFTSize, ADCFs, chirp_duration, BandWidth) &lt;BR&gt;%&lt;BR&gt;% [INPUTS]&lt;BR&gt;% GraphName: Output Graph Name&lt;BR&gt;% xRange: X coordinates ranges to be plotted, unitless&lt;BR&gt;% yRange: Y coordinates ranges to be plotted, unitless&lt;BR&gt;% DataChannels: [NumDataSamples NumChannels], complex Rx channel signals&lt;BR&gt;%% eg. Suppose we have obtained 4-Rx data after 2D-FFT, before 2D-CFAR;&lt;BR&gt;%% Then the format of DataChannels (all in complex data) = [FFTBinBeforeCFAR1.&apos;;FFTBinBeforeCFAR2.&apos;; FFTBinBeforeCFAR3.&apos;; FFTBinBeforeCFAR4.&apos;]&lt;BR&gt;% DataChannelSum: Complex Sum of all Rx Data, usually obtained in workspace, complex Rx channel signals&lt;BR&gt;% Range/DopplerFFTSize: FFT Size in Range/Doppler domain;&lt;BR&gt;% ADCFs: ADC Sample Rate (in Sample/Sec)&lt;BR&gt;% ChirpDuration: Chirp Pulse Duration (in sec);&lt;BR&gt;% Bandwidth: Baseband Bandwidth (in Hz);&lt;BR&gt;% &lt;BR&gt;% [OUTPUTS]&lt;BR&gt;% Static Target Detection Results with Planar X-Y Plot, New Figure created automatically&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormalCxSpMiddle style=&quot;MARGIN: 0in 0in 10pt 0.7in; LINE-HEIGHT: normal; TEXT-INDENT: -0.25in; mso-add-space: auto&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; COLOR: black; mso-fareast-font-family: &quot;Times New Roman&quot;; mso-font-kerning: 12.0pt; mso-bidi-font-family: Calibri; mso-ascii-font-family: Calibri; mso-hansi-font-family: Calibri&apos;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 8pt&quot;&gt;&lt;o:p&gt;&lt;FONT face=Calibri&gt;&amp;nbsp;&lt;/FONT&gt;&lt;/o:p&gt;&lt;/P&gt;</Text>
<Item XName="Page" Type="PageMgr">
<Item XName="Display0" Type="NotesDisp">
<DVport><T>Array_Dbl64</T><D>1;4;;;z14;R14</D></DVport>
<PVPort><T>Array_Dbl64</T><D>1;4;;;D6tORZ94u24;SAgfec2FN24</D></PVPort>
<Show><T>Bool</T><D>1</D></Show>
<ShowCmd><T>Int</T><D>1</D></ShowCmd>
<Window><T>Array_I64</T><D>1;4;;;a7;S2</D></Window>
<ZOrder><T>Int</T><D>0</D></ZOrder></Item></Item></Item>
<Item XName="Page" Type="PageMgr" />
<Item XName="Step01-System_Equations" UserName="Step01-System_Equations" Type="Equation">
<AutoCalc><T>Bool</T><D>1</D></AutoCalc>
<Selected><T>Bool</T><D>0</D></Selected>
<Text>%Set System Parameters&#x000D;&#x000A;SampleRate = 400e6;&#x000D;&#x000A;Fcarrier = 77e9;&#x000D;&#x000A;TxPwr = tune(35); %Tx Power in dBm&#x000D;&#x000A;TxAntennaMode = tune(0); %0: set by TxAntennaGain; 1: read from antenna pattern file&#x000D;&#x000A;TxAntennaGain = tune(21.4990335942763);&#x000D;&#x000A;if TxAntennaMode  == 0&#x000D;&#x000A;&#x0009;ElementPatternType = 0;&#x000D;&#x000A;&#x0009;EnableAntennaGain = 0;&#x000D;&#x000A;&#x0009;TxAntGain = TxAntennaGain;&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;ElementPatternType = 3;&#x000D;&#x000A;&#x0009;EnableAntennaGain = 2;&#x000D;&#x000A;&#x0009;TxAntGain = 0;&#x000D;&#x000A;end;&#x000D;&#x000A;&#x000D;&#x000A;RxAntennaGain = 15;&#x000D;&#x000A;&#x000D;&#x000A;%Set Antenna Array Parameters&#x000D;&#x000A;TxNum_H = 4;&#x000D;&#x000A;TxNum_V = 1;&#x000D;&#x000A;RxNum_H = 4;&#x000D;&#x000A;RxNum_V = 1;&#x000D;&#x000A;&#x000D;&#x000A;TxD_H = 0.5 * RxNum_H;;&#x000D;&#x000A;TxD_V = 0.5 * RxNum_V;;&#x000D;&#x000A;RxD_H = 0.5;&#x000D;&#x000A;RxD_V = 0.5;&#x000D;&#x000A;&#x000D;&#x000A;TxElementNum = TxNum_H;&#x000D;&#x000A;RxElementNum = RxNum_H; &#x000D;&#x000A;if TxElementNum &gt; 1&#x000D;&#x000A;&#x0009;EnableTDMMIMOReshape = 0;&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;EnableTDMMIMOReshape = 2;&#x000D;&#x000A;end;&#x000D;&#x000A;&#x000D;&#x000A;%Set Chirp Parameters&#x000D;&#x000A;chirp_BW=200e6;&#x000D;&#x000A;chirp_duration=25.6e-6;&#x000D;&#x000A;intrapulse=5e-6;&#x000D;&#x000A;PRI=chirp_duration+intrapulse;&#x000D;&#x000A;PRI_Num = SampleRate*PRI;&#x000D;&#x000A;PRF=1/PRI;&#x000D;&#x000A;chirp_Nsamples=SampleRate*PRI;&#x000D;&#x000A;&#x000D;&#x000A;%Set ADC Parameters&#x000D;&#x000A;ADCFs=20e6;&#x000D;&#x000A;ADC_DS_Ratio=ceil(SampleRate/ADCFs);&#x000D;&#x000A;chirp_Nsamples_BB = ADCFs*chirp_duration;&#x000D;&#x000A;&#x000D;&#x000A;% PRI_NumPts after Dechirp: Used for Range limiation in result plotting.&#x000D;&#x000A;PRI_NumPts = floor (PRI_Num/ADC_DS_Ratio); &#x000D;&#x000A;&#x000D;&#x000A;%Set FFT Parameters&#x000D;&#x000A;EnableFFTWindow = tune(1);&#x000D;&#x000A;FFTSize = chirp_duration*ADCFs;&#x0009;&#x000D;&#x000A;RangeFFTSize = FFTSize;&#x000D;&#x000A;DopplerFFTSize = 64;&#x000D;&#x000A;DataCubeSize = RangeFFTSize * DopplerFFTSize;&#x000D;&#x000A;TotalPts = TxNum_H*RangeFFTSize*DopplerFFTSize;&#x000D;&#x000A;FFT_DS_Ratio=chirp_Nsamples_BB/FFTSize;&#x000D;&#x000A;c = 3.0e8;&#x000D;&#x000A;Wavelength = c / Fcarrier;&#x000D;&#x000A;RangeVector = [0:RangeFFTSize-1] / RangeFFTSize * ADCFs * chirp_duration * c / (2 * chirp_BW);&#x000D;&#x000A;VelocityVector = [-DopplerFFTSize/2:-1 0:DopplerFFTSize/2 - 1] / DopplerFFTSize * PRF * Wavelength/2 ;&#x000D;&#x000A;&#x000D;&#x000A;%Set LNA Parameters&#x000D;&#x000A;LNA_Gain = 30; %dB&#x000D;&#x000A;LNA_NF = 0;  %Noise figure in dB&#x000D;&#x000A;&#x000D;&#x000A;%Set Phase Noise Parameters&#x000D;&#x000A;EnableThermalNoise = tune(0);&#x000D;&#x000A;if EnableThermalNoise == 0&#x000D;&#x000A;&#x0009;ThermalNoiseFlag = 2;&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;ThermalNoiseFlag  = 0;&#x000D;&#x000A;end;&#x000D;&#x000A;&#x000D;&#x000A;EnablePhaseNoise = tune(0);&#x000D;&#x000A;PN_BW = 10e6; %Phase Noise bandwidth&#x000D;&#x000A;PN_Data = [PN_BW/1000 -70  PN_BW/10 -80 PN_BW -90];% 4*PN_BW -120];&#x000D;&#x000A;%PN_Data = [PN_BW/1000 -150  PN_BW/10 -150 PN_BW -160 4*PN_BW -160];&#x000D;&#x000A;%PN_Data = [PN_BW/1000 -70  PN_BW/10 -80 PN_BW -90]% 4*PN_BW -110];&#x000D;&#x000A;if EnablePhaseNoise == 0&#x000D;&#x000A;&#x0009;PhaseNoiseData = &apos;&apos;;&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;PhaseNoiseData = PN_Data;&#x000D;&#x000A;end;&#x000D;&#x000A;&#x000D;&#x000A;%Set Target Parameter&#x000D;&#x000A;NumScartters = 2; %only support one scatter&#x000D;&#x000A;P0 = [0 0 0]; %platform position&#x000D;&#x000A;P1 = [10 0 180]; %target1 position&#x000D;&#x000A;P2 = [0 0 200]; %target2 position&#x000D;&#x000A;V1 = [0 0 3]; %target1 velocity&#x000D;&#x000A;V2 = [0 0 3]; %target2 velocity&#x000D;&#x000A;&#x000D;&#x000A;%get true range and velocity value&#x000D;&#x000A;Range1 = sqrt(sum((P1-P0).^2));&#x000D;&#x000A;Velocity1 = sqrt(sum((V1.*(P1-P0)/Range1).^2));&#x000D;&#x000A;Angle1 = atan((P1(1)-P0(1))/(P1(3)-P0(3)))*180/pi;&#x000D;&#x000A;Range2 = sqrt(sum((P2-P0).^2));&#x000D;&#x000A;Velocity2 = sqrt(sum((V2.*(P2-P0)/Range2).^2));&#x000D;&#x000A;Angle2 = atan((P2(1)-P0(1))/(P2(3)-P0(3)))*180/pi;&#x000D;&#x000A;&#x000D;&#x000A;</Text>
<UnitUse><T>Int</T><D>2</D></UnitUse>
<Item XName="BPMgr" Type="BPMgr">
<BPLines><T>Array_I64</T><D>1;0;</D></BPLines>
<BPStates><T>Array_I64</T><D>1;0;</D></BPStates></Item>
<Item XName="EqnBlock" Type="EqnBlock">
<Lang><T>Int</T><D>1</D></Lang></Item>
<Item XName="Font" Type="Font">
<Name>Courier New</Name>
<Size><T>Double</T><D>132.6125</D></Size></Item>
<Item XName="FunctionBlock" Type="FunctionBlock" />
<Item XName="Page" Type="PageMgr">
<Item XName="Display0" Type="EquationDisp">
<DVport><T>Array_Dbl64</T><D>1;4;;;z14;R14</D></DVport>
<PVPort><T>Array_Dbl64</T><D>1;4;;;D6tORZ94u24;SAgfec2FN24</D></PVPort>
<Show><T>Bool</T><D>1</D></Show>
<ShowCmd><T>Int</T><D>1</D></ShowCmd>
<Split><T>Double</T><D>0.3</D></Split>
<Split2><T>Double</T><D>0.3</D></Split2>
