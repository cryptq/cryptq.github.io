<Item XName="Note" UserName="Note" Type="Notes">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 0pt; LINE-HEIGHT: normal&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Times New Roman&quot;,serif; mso-fareast-font-family: &quot;Times New Roman&quot;&apos;&gt;&lt;?xml:namespace prefix = &quot;o&quot; ns = &quot;urn:schemas-microsoft-com:office:office&quot; /&gt;&lt;o:p&gt;&amp;nbsp;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;DIV style=&quot;BORDER-TOP: medium none; BORDER-RIGHT: medium none; BORDER-BOTTOM: windowtext 1pt solid; PADDING-BOTTOM: 1pt; PADDING-TOP: 0in; PADDING-LEFT: 0in; BORDER-LEFT: medium none; PADDING-RIGHT: 0in; mso-element: para-border-div; mso-border-bottom-alt: solid windowtext .75pt&quot;&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;BORDER-TOP: medium none; BORDER-RIGHT: medium none; BORDER-BOTTOM: medium none; PADDING-BOTTOM: 0in; TEXT-ALIGN: center; PADDING-TOP: 0in; PADDING-LEFT: 0in; BORDER-LEFT: medium none; MARGIN: 0in 0in 0pt; LINE-HEIGHT: normal; PADDING-RIGHT: 0in; mso-border-bottom-alt: solid windowtext .75pt; mso-padding-alt: 0in 0in 1.0pt 0in&quot; align=center&gt;&lt;B&gt;&lt;SPAN style=&apos;FONT-SIZE: 18pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif; mso-fareast-font-family: &quot;Times New Roman&quot;&apos;&gt;Automotive Radar&amp;nbsp;Phase Noise&amp;nbsp;Target&amp;nbsp;Masking&amp;nbsp;Example&lt;/SPAN&gt;&lt;/B&gt;&lt;SPAN style=&apos;FONT-SIZE: 18pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif; mso-fareast-font-family: &quot;Times New Roman&quot;&apos;&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&lt;/DIV&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: center; MARGIN: 0in 0in 0pt; LINE-HEIGHT: normal&quot; align=center&gt;&lt;B&gt;&lt;SPAN style=&apos;FONT-SIZE: 10pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif; mso-fareast-font-family: &quot;Times New Roman&quot;; mso-bidi-font-size: 12.0pt&apos;&gt;Keysight Technologies SystemVue Example Workspace&lt;/SPAN&gt;&lt;/B&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif; mso-fareast-font-family: &quot;Times New Roman&quot;&apos;&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: center; MARGIN: 0in 0in 0pt; LINE-HEIGHT: normal&quot; align=center&gt;&lt;B&gt;&lt;SPAN style=&apos;FONT-SIZE: 10pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif; mso-fareast-font-family: &quot;Times New Roman&quot;&apos;&gt;&amp;nbsp;&lt;/SPAN&gt;&lt;/B&gt;&lt;SPAN style=&apos;FONT-SIZE: 13.5pt; COLOR: black; mso-fareast-font-family: &quot;Times New Roman&quot;; mso-font-kerning: 12.0pt; mso-bidi-font-family: Calibri; mso-ascii-font-family: Calibri; mso-hansi-font-family: Calibri&apos;&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 10pt; LINE-HEIGHT: normal&quot;&gt;&lt;B&gt;&lt;SPAN style=&apos;FONT-SIZE: 13.5pt; COLOR: black; mso-fareast-font-family: &quot;Times New Roman&quot;; mso-font-kerning: 12.0pt; mso-bidi-font-family: Calibri; mso-ascii-font-family: Calibri; mso-hansi-font-family: Calibri&apos;&gt;&lt;FONT face=Calibri&gt;Simulation Task&amp;nbsp;&lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/B&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 10pt 0.2in; LINE-HEIGHT: normal&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; COLOR: black; mso-fareast-font-family: &quot;Times New Roman&quot;; mso-font-kerning: 12.0pt; mso-bidi-font-family: Calibri; mso-ascii-font-family: Calibri; mso-hansi-font-family: Calibri&apos;&gt;&lt;FONT face=Calibri&gt;This workspace illustrates an Automotive FMCW-based Radar&amp;nbsp;example with&amp;nbsp;phase noise impairment modeling&amp;nbsp;capabilities, and compares two&amp;nbsp;cases with distinct transmitter VCO phase noise levels. &lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 10pt 0.2in; LINE-HEIGHT: normal&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; COLOR: black; mso-fareast-font-family: &quot;Times New Roman&quot;; mso-font-kerning: 12.0pt; mso-bidi-font-family: Calibri; mso-ascii-font-family: Calibri; mso-hansi-font-family: Calibri&apos;&gt;&lt;FONT face=Calibri&gt;Target masking effects in Range-Doppler spectrum plots are clearly demonstrated.&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal; mso-layout-grid-align: none&quot;&gt;&lt;B&gt;&lt;SPAN style=&apos;FONT-SIZE: 13.5pt; COLOR: black; mso-fareast-font-family: &quot;Times New Roman&quot;; mso-font-kerning: 12.0pt; mso-bidi-font-family: Calibri; mso-ascii-font-family: Calibri; mso-hansi-font-family: Calibri&apos;&gt;&lt;FONT face=Calibri&gt;Workspace Description&lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/B&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 10pt 0.2in; LINE-HEIGHT: normal&quot;&gt;&lt;FONT face=Calibri&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; COLOR: black; mso-fareast-font-family: &quot;Times New Roman&quot;; mso-font-kerning: 12.0pt; mso-bidi-font-family: Calibri; mso-ascii-font-family: Calibri; mso-hansi-font-family: Calibri&apos;&gt;This example is designed to address phase noise impairment&amp;nbsp;impacts on&amp;nbsp;automotive radar target detection performances. &lt;/SPAN&gt;&lt;SPAN style=&apos;FONT-SIZE: 18pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif; COLOR: black; mso-fareast-font-family: &quot;Times New Roman&quot;; mso-font-kerning: 12.0pt&apos;&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 10pt 0.2in; LINE-HEIGHT: normal&quot;&gt;&lt;FONT face=Calibri&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; COLOR: black; mso-fareast-font-family: &quot;Times New Roman&quot;; mso-font-kerning: 12.0pt; mso-bidi-font-family: Calibri; mso-ascii-font-family: Calibri; mso-hansi-font-family: Calibri&apos;&gt;Firstly, phase noise is modeled with modulator model to simulate PLL+VCO-based transmitter architectures with phase noise capabilities. &lt;/SPAN&gt;&lt;SPAN style=&apos;FONT-SIZE: 18pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif; COLOR: black; mso-fareast-font-family: &quot;Times New Roman&quot;; mso-font-kerning: 12.0pt&apos;&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 10pt 0.2in; LINE-HEIGHT: normal&quot;&gt;&lt;FONT face=Calibri&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; COLOR: black; mso-fareast-font-family: &quot;Times New Roman&quot;; mso-font-kerning: 12.0pt; mso-bidi-font-family: Calibri; mso-ascii-font-family: Calibri; mso-hansi-font-family: Calibri&apos;&gt;Secondly, two 1Tx-1Rx pairs are realized in the schematic design. The light blue blocks show the pair with a good phase noise profile (No Phase Noise, NPN&amp;nbsp;case), while the magenta blocks show the other pair with worse phase noise profile (With Phase Noise, PN case). &lt;/SPAN&gt;&lt;SPAN style=&apos;FONT-SIZE: 13.5pt; COLOR: black; mso-fareast-font-family: &quot;Times New Roman&quot;; mso-font-kerning: 12.0pt; mso-bidi-font-family: Calibri; mso-ascii-font-family: Calibri; mso-hansi-font-family: Calibri&apos;&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 10pt 0.2in; LINE-HEIGHT: normal&quot;&gt;&lt;FONT face=Calibri&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; COLOR: black; mso-fareast-font-family: &quot;Times New Roman&quot;; mso-font-kerning: 12.0pt; mso-bidi-font-family: Calibri; mso-ascii-font-family: Calibri; mso-hansi-font-family: Calibri&apos;&gt;The RCS data are taken from the HRL Lab &amp;amp; General Motors measured results (Scenario-02 in VehicleScenario.wsv workspace). The nearest target is a truck with highest RCS and lowest velocity. The other two vehicles with&amp;nbsp;longer distances&amp;nbsp;are one van and one sedan.&lt;/SPAN&gt;&lt;SPAN style=&apos;FONT-SIZE: 13.5pt; COLOR: black; mso-fareast-font-family: &quot;Times New Roman&quot;; mso-font-kerning: 12.0pt; mso-bidi-font-family: Calibri; mso-ascii-font-family: Calibri; mso-hansi-font-family: Calibri&apos;&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 10pt 0.2in; LINE-HEIGHT: normal&quot;&gt;&lt;FONT face=Calibri&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; COLOR: black; mso-fareast-font-family: &quot;Times New Roman&quot;; mso-font-kerning: 12.0pt; mso-bidi-font-family: Calibri; mso-ascii-font-family: Calibri; mso-hansi-font-family: Calibri&apos;&gt;We use the 2D-FFT 3D plots&amp;nbsp;to demonstrate&amp;nbsp;phase noise impacts on&amp;nbsp;the&amp;nbsp;noise floor levels. For the&amp;nbsp;NPN case, the floor is&amp;nbsp;covered by dark blue&amp;nbsp;colors (under -55 dB approx.), while for&amp;nbsp;the&amp;nbsp;PN case, the noise floor around the two targets&amp;nbsp;is dominated by light green colors (up to -40 dB&amp;nbsp;approx.). &lt;/SPAN&gt;&lt;SPAN style=&apos;FONT-SIZE: 13.5pt; COLOR: black; mso-fareast-font-family: &quot;Times New Roman&quot;; mso-font-kerning: 12.0pt; mso-bidi-font-family: Calibri; mso-ascii-font-family: Calibri; mso-hansi-font-family: Calibri&apos;&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 10pt 0.2in; LINE-HEIGHT: normal&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; COLOR: black; mso-fareast-font-family: &quot;Times New Roman&quot;; mso-font-kerning: 12.0pt; mso-bidi-font-family: Calibri; mso-ascii-font-family: Calibri; mso-hansi-font-family: Calibri&apos;&gt;&lt;FONT face=Calibri&gt;Regarding the target peaks, for the NPN figure, three peaks are clearly visible, while for the PN case, only the truck (nearest to radar and with highest RCS) could be discernable while the other two targets with weaker returns are barely visible and buried under the noise floor.&lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 10pt 0.2in; LINE-HEIGHT: normal&quot;&gt;&lt;FONT face=Calibri&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; COLOR: black; mso-fareast-font-family: &quot;Times New Roman&quot;; mso-font-kerning: 12.0pt; mso-bidi-font-family: Calibri; mso-ascii-font-family: Calibri; mso-hansi-font-family: Calibri&apos;&gt;For CFAR and binary detection results, for both NPN and PN cases, only the truck is detected.&lt;/SPAN&gt;&lt;SPAN style=&apos;FONT-SIZE: 13.5pt; COLOR: black; mso-fareast-font-family: &quot;Times New Roman&quot;; mso-font-kerning: 12.0pt; mso-bidi-font-family: Calibri; mso-ascii-font-family: Calibri; mso-hansi-font-family: Calibri&apos;&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 10pt; LINE-HEIGHT: normal&quot;&gt;&lt;FONT face=Calibri&gt;&lt;B&gt;&lt;SPAN style=&apos;FONT-SIZE: 13.5pt; COLOR: black; mso-fareast-font-family: &quot;Times New Roman&quot;; mso-font-kerning: 12.0pt; mso-bidi-font-family: Calibri; mso-ascii-font-family: Calibri; mso-hansi-font-family: Calibri&apos;&gt;Range-Doppler Plotting Note&lt;/SPAN&gt;&lt;/B&gt;&lt;SPAN style=&apos;FONT-SIZE: 13.5pt; COLOR: black; mso-fareast-font-family: &quot;Times New Roman&quot;; mso-font-kerning: 12.0pt; mso-bidi-font-family: Calibri; mso-ascii-font-family: Calibri; mso-hansi-font-family: Calibri&apos;&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 10pt 0.2in; LINE-HEIGHT: 106%&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; COLOR: black; LINE-HEIGHT: 106%; mso-fareast-font-family: &quot;Times New Roman&quot;; mso-font-kerning: 12.0pt; mso-bidi-font-family: Calibri; mso-ascii-font-family: Calibri; mso-hansi-font-family: Calibri&apos;&gt;&lt;FONT face=Calibri&gt;A generic 2D-FFT (Range-Doppler) spectrum plotting function is BUILT-IN for Automotive Radar Library and typical calling codes are given in &quot;Step03_Range-Doppler_Plot&quot; equation file.&lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 10pt 0.2in; LINE-HEIGHT: 106%&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; COLOR: black; LINE-HEIGHT: 106%; mso-fareast-font-family: &quot;Times New Roman&quot;; mso-font-kerning: 12.0pt; mso-bidi-font-family: Calibri; mso-ascii-font-family: Calibri; mso-hansi-font-family: Calibri&apos;&gt;&lt;FONT face=Calibri&gt;The user is advised to try customized cases specifically for the dedicated radar design. For instance, if the target ranges are much further, the phase noise impacts&amp;nbsp;on 2D-FFT noise floor (low SNR cases)&amp;nbsp;could be&amp;nbsp;insignificant, while target masking are governed by other factors such as range attenuation or thermal noise floor.&amp;nbsp;&lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 10pt 0.2in; LINE-HEIGHT: 106%&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; COLOR: black; LINE-HEIGHT: 106%; mso-fareast-font-family: &quot;Times New Roman&quot;; mso-font-kerning: 12.0pt; mso-bidi-font-family: Calibri; mso-ascii-font-family: Calibri; mso-hansi-font-family: Calibri&apos;&gt;&lt;FONT face=Calibri&gt;For both cases, phase noise settings are&amp;nbsp;done in the Step02_System_Equation file, and the profile vector is transferred to Tx_VCO_UpConv subnet. &lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 10pt 0.2in; LINE-HEIGHT: normal&quot;&gt;&lt;FONT face=Calibri&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; COLOR: black; mso-fareast-font-family: &quot;Times New Roman&quot;; mso-font-kerning: 12.0pt; mso-bidi-font-family: Calibri; mso-ascii-font-family: Calibri; mso-hansi-font-family: Calibri&apos;&gt;Please run the Step01 and Step02 first, then run the simulation and&amp;nbsp;the&amp;nbsp;Range_Doppler_Plot&amp;nbsp;for simulation analysis and 2D-FFT figure plotting.&lt;/SPAN&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif; mso-fareast-font-family: &quot;Times New Roman&quot;&apos;&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 0pt; LINE-HEIGHT: normal&quot;&gt;&lt;B&gt;&lt;SPAN style=&apos;FONT-FAMILY: &quot;Arial&quot;,sans-serif&apos;&gt;References:&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/B&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 0pt; LINE-HEIGHT: normal&quot;&gt;&lt;B&gt;&lt;SPAN style=&apos;FONT-FAMILY: &quot;Arial&quot;,sans-serif&apos;&gt;&lt;o:p&gt;&amp;nbsp;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/B&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 0pt; LINE-HEIGHT: normal&quot;&gt;&lt;SPAN style=&apos;FONT-FAMILY: &quot;Arial&quot;,sans-serif; mso-bidi-font-weight: bold&apos;&gt;1, K.Geary, Joseph S. Colburn, etc., (Joint work by HRL Lab and General Motors), &lt;B&gt;Automotive Radar Target Characterization from 22 to 29 GHz and 76 to 81 GHz&lt;/B&gt;, &lt;I style=&quot;mso-bidi-font-style: normal&quot;&gt;IEEE Radar Conference&lt;/I&gt;, 2013.&lt;/SPAN&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Times New Roman&quot;,serif; mso-fareast-font-family: &quot;Times New Roman&quot;&apos;&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 8pt&quot;&gt;&lt;o:p&gt;&lt;FONT face=Calibri&gt;&amp;nbsp;&lt;/FONT&gt;&lt;/o:p&gt;&lt;/P&gt;</Text>
