<Item XName="Page" Type="PageMgr">
<Item XName="Display0" Type="EquationDisp">
<DVport><T>Array_Dbl64</T><D>1;4;;;Co14;714</D></DVport>
<PVPort><T>Array_Dbl64</T><D>1;4;;;HV{yvpqBk24;SVfzbsV5324</D></PVPort>
<Show><T>Bool</T><D>1</D></Show>
<ShowCmd><T>Int</T><D>1</D></ShowCmd>
<Split><T>Double</T><D>0.3</D></Split>
<Split2><T>Double</T><D>0.3</D></Split2>
<Window><T>Array_I64</T><D>1;4;t4;;k9;P1</D></Window>
<ZOrder><T>Int</T><D>3</D></ZOrder></Item></Item>
<Item XName="VarBlock" Type="VarBlock" /></Item>
<Item XName="Step03-Range_Doppler_Plot" UserName="Step03-Range_Doppler_Plot" Type="Equation">
<AutoCalc><T>Bool</T><D>0</D></AutoCalc>
<Selected><T>Bool</T><D>0</D></Selected>
<Text>% runanalysis(&apos;DFA_AdvPN&apos;);&#x000D;&#x000A;&#x000D;&#x000A;using(&apos;DFA_AdvPN_Data&apos;);&#x000D;&#x000A;&#x000D;&#x000A;Echo_NoPN = DopplerFFTOut_NoPN_RDPlot;&#x000D;&#x000A;Echo_WithPN = DopplerFFTOut_WithPN_RDPlot;&#x000D;&#x000A;Fc = RF_Freq_Tx;&#x000D;&#x000A;ADCFs = ADC_Rx.Fs;&#x000D;&#x000A;FigName_NoPN = &apos;Range-Doppler Matrix-NO VCO Phase Noise&apos;;&#x000D;&#x000A;FigName_WithPN = &apos;Range-Doppler Matrix-With VCO Phase Noise&apos;;&#x000D;&#x000A;&#x000D;&#x000A;%%2D Range-Doppler FFT Plotting Control Parameters&#x000D;&#x000A;AmpDisp = 1; %Dispay Format Control, 0 for No Linear, 1 for dB&#x000D;&#x000A;Norm = 1; %Normalization Control, 0 for No Normalization, 1 for Normalization&#x000D;&#x000A;&#x000D;&#x000A;DispLimit.Switch = 1;&#x000D;&#x000A;DispLimit.Lower = -70; %-60&#x000D;&#x000A;DispLimit.Upper = 0;&#x000D;&#x000A;&#x000D;&#x000A;RangeMax.Switch = 1;&#x000D;&#x000A;RangeMax.Limit = PRI_NumPts/4;&#x000D;&#x000A;&#x000D;&#x000A;%%2D Range-Doppler FFT Plotting&#x000D;&#x000A;AutomotiveRadar_DisplayRangeDopplerSpectrum(Echo_NoPN,Fc,PRI, RangeFFTSize, DopplerFFTSize, RangeMax, ADCFs,...&#x000D;&#x000A;TChirp, BW, FigName_NoPN, AmpDisp, Norm, DispLimit);&#x000D;&#x000A;&#x000D;&#x000A;AutomotiveRadar_DisplayRangeDopplerSpectrum(Echo_WithPN, Fc, PRI, RangeFFTSize, DopplerFFTSize, RangeMax, ADCFs,...&#x000D;&#x000A;TChirp,BW, FigName_WithPN, AmpDisp, Norm, DispLimit);</Text>
