<Item XName="Step01-Scenario2_RCS_Main" UserName="Step01-Scenario2_RCS_Main" Type="Equation">
<AutoCalc><T>Bool</T><D>0</D></AutoCalc>
<Selected><T>Bool</T><D>0</D></Selected>
<Text>%% This Equation contains the basic configurations for Vehicle RCS Test-Scenario No.2&#x000D;&#x000A;%% Reference Paper: &#x000D;&#x000A;% K.Geary, Joseph S. Colburn, etc., (Joint work by HRL Lab and General Motors)&#x000D;&#x000A;% Automotive Radar Target Characterization from 22 to 29 GHz and 76 to 81 GHz &#x000D;&#x000A;% 2013-IEEE Radar Conference.&#x000D;&#x000A;%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%&#x000D;&#x000A;%%Preliminary RCS Data Setups&#x000D;&#x000A;%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%&#x000D;&#x000A;%% Scenario Setup Mode Selection (ONLY set to 02 for this example)&#x000D;&#x000A;Scenario_Setup = 02; %%  &#x000D;&#x000A;&#x000D;&#x000A;%% RCS Output Settings&#x000D;&#x000A;Sce02_No_Tgts = 3; %% Total target numbers (from 0 to 10)&#x000D;&#x000A;Sce02_Freq_Band = 02; %% 01 for 22-29 GHz, 02 for 76-81 GHz&#x000D;&#x000A;&#x000D;&#x000A;Sce02_RCS_Type = [02, 03, 01]; %% 01-06: Sedan (Cadillac STS), Truck (Chevrolet Avalanche), Van (Chevrolet Express), Bicyclist, Motorist, Adult Pedestrian;&#x000D;&#x000A;Sce02_RCS_ValueSel = [01, 04, 02]; %% 01 for Back/Front Peak, 02 for Oblique Peak (if any), 03 for Side Peak, 04 for Minimum;&#x000D;&#x000A;&#x000D;&#x000A;%%RCS Output as SquareMeters&#x000D;&#x000A;Sce02_RCS = RCS_Output_VehicleSce2(Scenario_Setup, Sce02_No_Tgts, Sce02_Freq_Band, Sce02_RCS_Type, Sce02_RCS_ValueSel);&#x0009;&#x000D;&#x000A;&#x000D;&#x000A;</Text>
<Item XName="BPMgr" Type="BPMgr">
<BPLines><T>Empty</T></BPLines>
<BPStates><T>Empty</T></BPStates></Item>
<Item XName="EqnBlock" Type="EqnBlock">
<Lang><T>Int</T><D>1</D></Lang></Item>
<Item XName="Font" Type="Font">
<Name>Courier New</Name>
<Size><T>Double</T><D>125</D></Size></Item>
<Item XName="FunctionBlock" Type="FunctionBlock" />
<Item XName="Page" Type="PageMgr">
<Item XName="Display0" Type="EquationDisp">
<DVport><T>Array_Dbl64</T><D>1;4;;;Co14;J14</D></DVport>
<PVPort><T>Array_Dbl64</T><D>1;4;;;HV{yvpqBk24;SWh1k68YF24</D></PVPort>
<Show><T>Bool</T><D>1</D></Show>
<ShowCmd><T>Int</T><D>1</D></ShowCmd>
<Split><T>Double</T><D>0.3</D></Split>
<Split2><T>Double</T><D>0.3</D></Split2>
<Window><T>Array_I64</T><D>1;4;;j3;t4;a5</D></Window>
<ZOrder><T>Int</T><D>2</D></ZOrder></Item></Item>
<Item XName="VarBlock" Type="VarBlock" /></Item>
<Item XName="Step02-System_Equations" UserName="Step02-System_Equations" Type="Equation">
<AutoCalc><T>Bool</T><D>0</D></AutoCalc>
<Selected><T>Bool</T><D>0</D></Selected>
<Text>%% This Equation contains all system-level design parameters for this example&#x000D;&#x000A;%% All parameters are effective in the whole workspace&#x000D;&#x000A;&#x000D;&#x000A;SampleRate = 1.2e9; %System SampleRate&#x000D;&#x000A;C = 3e8;&#x000D;&#x000A;RF_Freq_Tx = 77e9;&#x000D;&#x000A;Lamda = C/RF_Freq_Tx;&#x000D;&#x000A;%% FMCW Chirp Parameters&#x000D;&#x000A;TChirp = 51.2e-6;&#x000D;&#x000A;TIdle = 10e-6;&#x000D;&#x000A;BW = 500e6;&#x000D;&#x000A;Slope = BW/TChirp;&#x000D;&#x000A;PRI = TChirp + TIdle;    %Chirp Duration&#x000D;&#x000A;Chirp_NoPts = TChirp*SampleRate;&#x000D;&#x000A;PRI_NoPts = PRI*SampleRate;&#x000D;&#x000A;%% Target Configurations&#x000D;&#x000A;TarNum = 3;&#x000D;&#x000A;&#x000D;&#x000A;P0 = [0 0 0];&#x000D;&#x000A;&#x000D;&#x000A;P1 = [5 0 35]; %20/50&#x000D;&#x000A;P2 = [-4 0 54]; %37/90&#x000D;&#x000A;P3 = [0 0 63];&#x000D;&#x000A;&#x000D;&#x000A;V1 = [0 0 2];&#x000D;&#x000A;V2 = [0 0 10];&#x000D;&#x000A;V3 = [0 0 5];&#x000D;&#x000A;&#x000D;&#x000A;RCS1 = Sce02_RCS(1);&#x000D;&#x000A;RCS2 = Sce02_RCS(2);&#x000D;&#x000A;RCS3 = Sce02_RCS(3);&#x000D;&#x000A;%% Antenna Array Configurations&#x000D;&#x000A;TxNum_H = 1;&#x000D;&#x000A;TxNum_V = 1;&#x000D;&#x000A;RxNum_H = 1;&#x000D;&#x000A;RxNum_V = 1;&#x000D;&#x000A;&#x000D;&#x000A;TxD_H = 0.5;&#x000D;&#x000A;TxD_V = 0.5;&#x000D;&#x000A;RxD_H = 0.5;&#x000D;&#x000A;RxD_V = 0.5;&#x000D;&#x000A;&#x000D;&#x000A;TxElementNum = TxNum_H * TxNum_V;&#x000D;&#x000A;RxElementNum = RxNum_H * RxNum_V;&#x000D;&#x000A;&#x000D;&#x000A;AntGain_Tx = 10;&#x000D;&#x000A;AntGain_Rx = 10;&#x000D;&#x000A;&#x000D;&#x000A;%% RF Impairment Parameters&#x000D;&#x000A;&#x000D;&#x000A;NsFlr_Thermal_dBm = -173.975 %173.975;&#x000D;&#x000A;%VCO Phase Noise Settings&#x000D;&#x000A;PN_BW = 10e6; %Phase Noise bandwidth&#x000D;&#x000A;PN_Data_NoPN = [PN_BW/1000 -160  PN_BW/10 -160 PN_BW -170]&#x000D;&#x000A;PN_Data_WithPN = [PN_BW/1000 -70  PN_BW/10 -80 PN_BW -90]% 4*PN_BW -110];&#x000D;&#x000A;&#x000D;&#x000A;PA_Tx.Gain = 25;&#x000D;&#x000A;PA_Tx.NF = 10;&#x000D;&#x000A;PA_Tx.TOI = 100;&#x000D;&#x000A;&#x000D;&#x000A;LNA_Rx.Gain = 40;&#x000D;&#x000A;LNA_Rx.NF = 5;&#x000D;&#x000A;LNA_Rx.TOI = 100;&#x000D;&#x000A;&#x000D;&#x000A;Mixer_Rx.LOAtten = 0;&#x000D;&#x000A;Mixer_Rx.ConvGain = 10;&#x000D;&#x000A;Mixer_Rx.NF = 10;&#x000D;&#x000A;Mixer_Rx.SOI = 100;&#x000D;&#x000A;Mixer_Rx.TOI = 90;&#x000D;&#x000A;&#x000D;&#x000A;% Ideal ADC with ONLY sampling rate defined&#x000D;&#x000A;ADC_Rx.Fs = 20e6;&#x000D;&#x000A;&#x000D;&#x000A;%% Range &amp; Velocity DSP Parameters&#x000D;&#x000A;DownFactor = floor (SampleRate/ADC_Rx.Fs);&#x000D;&#x000A;&#x000D;&#x000A;Chirp_NumPts = floor(Chirp_NoPts/DownFactor);&#x000D;&#x000A;PRI_NumPts = floor (PRI_NoPts/DownFactor);&#x000D;&#x000A;&#x000D;&#x000A;nRead = PRI_NumPts;&#x000D;&#x000A;nWrite = Chirp_NumPts;&#x000D;&#x000A;RangeFFTSize = Chirp_NumPts;&#x000D;&#x000A;%RangeFFTSize = 1024;%2^nextpow2(nWrite); % Nearest larger 2^N value is preferred&#x000D;&#x000A;DopplerFFTSize = 32;&#x000D;&#x000A;&#x000D;&#x000A;%% True Range &amp; Velocity Values&#x000D;&#x000A;Range_TarNo1 = sqrt(sum((P1-P0).^2));&#x000D;&#x000A;Range_TarNo2 = sqrt(sum((P2-P0).^2));&#x000D;&#x000A;Range_TarNo3 = sqrt(sum((P3-P0).^2));&#x000D;&#x000A;&#x000D;&#x000A;Velocity_TarNo1 = sqrt(sum((V1.*(P1-P0)/Range_TarNo1).^2));&#x000D;&#x000A;Velocity_TarNo2 = sqrt(sum((V2.*(P2-P0)/Range_TarNo2).^2));&#x000D;&#x000A;Velocity_TarNo3 = sqrt(sum((V3.*(P3-P0)/Range_TarNo3).^2));&#x000D;&#x000A;&#x000D;&#x000A;</Text>
<Item XName="BPMgr" Type="BPMgr">
