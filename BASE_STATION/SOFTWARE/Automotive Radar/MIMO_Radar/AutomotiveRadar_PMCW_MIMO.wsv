<Text>using(&apos;DF1_PMCWSystem_Data&apos;);&#x000D;&#x000A;&#x000D;&#x000A;%%2D Range-Doppler FFT Plotting Control Parameters&#x000D;&#x000A;&#x000D;&#x000A;%% Full Doppler Vector&#x000D;&#x000A;PRF = 1 / PRI;&#x000D;&#x000A;velocity = (-DopplerBin/2 :1 :(DopplerBin/2-1)) / DopplerBin * PRF * Wavelength/2 ;&#x000D;&#x000A;&#x000D;&#x000A;%% Limit Range Size: Trim to 1/3 of the maximum range size&#x000D;&#x000A;RangeLimit = floor(1 * RangeBin);&#x000D;&#x000A;%% Trimmed Range Vector: &#x000D;&#x000A;&#x000D;&#x000A;range = [0:RangeLimit-1] / SampleRate * c/2;&#x000D;&#x000A;&#x000D;&#x000A;%% Trimmed Doppler Size: if the user needs, currently NOT cut&#x000D;&#x000A;DopplerLimit = floor(floor((1-1) * DopplerBin)/2);&#x000D;&#x000A;&#x000D;&#x000A;%% Reshape the DataCube and Flip the Doppler Data&#x000D;&#x000A;Amp = reshape(RDDataCube, RangeBin, DopplerBin);&#x000D;&#x000A;Amp = [Amp(:,DopplerBin/2 + 1  : DopplerBin) Amp(:,1:DopplerBin/2)];&#x000D;&#x000A;Amp = fliplr(Amp);&#x000D;&#x000A;&#x000D;&#x000A;%% Leave only the Doppler Data within Doppler Limit&#x000D;&#x000A;Amp = Amp(:,(DopplerLimit+1):(DopplerBin-DopplerLimit));&#x000D;&#x000A;velocity = velocity((DopplerLimit+1):(DopplerBin-DopplerLimit));&#x000D;&#x000A;&#x000D;&#x000A;%% Trim the range and calculate the dB value&#x000D;&#x000A;Amp = 10*log10(abs(Amp(1:RangeLimit,:)).^2);&#x000D;&#x000A;&#x000D;&#x000A;%% Limit the lowest power threshold to -80 below maximum power&#x000D;&#x000A;PowerLimit = max(max(Amp))-40; &#x000D;&#x000A;Amp(Amp&lt;PowerLimit) = PowerLimit;&#x000D;&#x000A;&#x000D;&#x000A;%% Plot the range-doppler graph:&#x000D;&#x000A;graph = graph_figure(&apos;Range-Doppler Spectrum Plot&apos;);&#x000D;&#x000A;graph.add_surface_data(velocity,range,Amp);&#x000D;&#x000A;graph.set_label_x(&apos;Velocity-m/s&apos;);&#x000D;&#x000A;graph.set_label_y(&apos;Range-m&apos;);&#x000D;&#x000A;graph.set_label_z(&apos;Amplitude-dB&apos;);&#x000D;&#x000A;&#x000D;&#x000A;AngleAxis = -90:0.1:90;&#x000D;&#x000A;AngleMusic1 = AngleMUSIC(1,:,1);&#x000D;&#x000A;AngleMusic2 = AngleMUSIC(1,:,2);</Text>
