<Item XName="EquationText" Type="PartParam">
<DataEntry>&#x000D;&#x000A;&#x000D;&#x000A;DataInput = input;&#x000D;&#x000A;&#x000D;&#x000A;Index= find(DataInput==1);&#x000D;&#x000A;TargetScatterNum = size(Index,1);&#x000D;&#x000A;&#x000D;&#x000A;Range = (mod(Index,RangeFFTSize)-1)/ SampleRate*3.0e8/2;&#x000D;&#x000A;Wavelength = 3.0e8/Fcarrier;&#x000D;&#x000A;&#x000D;&#x000A;DopplerBin = floor(Index/RangeFFTSize) ;&#x000D;&#x000A;DopplerBin(DopplerBin&gt;DopplerFFTSize/2) = DopplerBin(DopplerBin&gt;DopplerFFTSize/2) - DopplerFFTSize;&#x000D;&#x000A;&#x000D;&#x000A;Velocity = -DopplerBin/DopplerFFTSize /PRI  * Wavelength/2;&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;TargeData = zeros(RxChannelNum,TargetScatterNum);&#x000D;&#x000A;for Tg = 1:TargetScatterNum&#x000D;&#x000A;&#x0009;for Rx = 1:RxChannelNum&#x000D;&#x000A;&#x0009;&#x0009;TargeData(Rx,Tg) = ChannelData{Rx}(Index(Tg));&#x0009;&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x0009;&#x000D;&#x000A;&#x0009;PeakPhase = angle(TargeData(:,Tg));&#x000D;&#x000A;&#x0009;PhaseDiff = diff(PeakPhase);&#x000D;&#x000A;&#x0009;PhaseDiff(PhaseDiff&lt;0) = PhaseDiff(PhaseDiff&lt;0) + 2*pi&#x000D;&#x000A;&#x0009;PhaseDiff(PhaseDiff&gt;pi) = PhaseDiff(PhaseDiff&gt;pi) - 2*pi;&#x000D;&#x000A;&#x0009;MeanPhase = mean(PhaseDiff);&#x000D;&#x000A;&#x0009;Angle(Tg,1) = -asind(MeanPhase/pi);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;%Angle = PhaseDiff;</DataEntry>
<Description>Equation Text to Parse, edited in the equation set</Description>
<DocSymbol />
<IsSettable><T>Bool</T><D>0</D></IsSettable>
<Range />
<RunTimeTunable><T>Bool</T><D>0</D></RunTimeTunable>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>4</D></Validate></Item>
<Item XName="Fcarrier" Type="PartParam">
<Custom><T>Bool</T><D>1</D></Custom>
<DataEntry>FCarrier</DataEntry>
<Validate><T>Int</T><D>0</D></Validate></Item>
