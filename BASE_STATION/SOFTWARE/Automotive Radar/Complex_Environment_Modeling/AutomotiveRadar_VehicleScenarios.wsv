<Item XName="Step02-System_Equations" UserName="Step02-System_Equations" Type="Equation">
<AutoCalc><T>Bool</T><D>0</D></AutoCalc>
<Selected><T>Bool</T><D>0</D></Selected>
<Text>%% This Equation contains all system-level design parameters for this example&#x000D;&#x000A;%% All parameters are effective in the whole workspace&#x000D;&#x000A;&#x000D;&#x000A;SampleRate = 1.2e9; %System SampleRate&#x000D;&#x000A;C = 3e8;&#x000D;&#x000A;RF_Freq_Tx = 79e9;&#x000D;&#x000A;Lamda = C/RF_Freq_Tx;&#x000D;&#x000A;%% FMCW Chirp Parameters&#x000D;&#x000A;TChirp = 51.2e-6;&#x000D;&#x000A;TIdle = 10e-6;&#x000D;&#x000A;BW = 500e6;&#x000D;&#x000A;Slope = BW/TChirp;&#x000D;&#x000A;PRI = TChirp + TIdle;    %Chirp Duration&#x000D;&#x000A;Chirp_NoPts = TChirp*SampleRate;&#x000D;&#x000A;PRI_NoPts = PRI*SampleRate;&#x000D;&#x000A;&#x000D;&#x000A;%% Radar Platform Configurations &#x000D;&#x000A;&#x000D;&#x000A;P0 = [0 0 0];&#x000D;&#x000A;V0 = [0 0 2];&#x000D;&#x000A;&#x000D;&#x000A;%% Antenna Array Configurations&#x000D;&#x000A;&#x000D;&#x000A;TxNum_H = 1;&#x000D;&#x000A;TxNum_V = 1;&#x000D;&#x000A;RxNum_H = 1;&#x000D;&#x000A;RxNum_V = 1;&#x000D;&#x000A;&#x000D;&#x000A;TxD_H = 0.5;&#x000D;&#x000A;TxD_V = 0.5;&#x000D;&#x000A;RxD_H = 0.5;&#x000D;&#x000A;RxD_V = 0.5;&#x000D;&#x000A;&#x000D;&#x000A;TxElementNum = TxNum_H * TxNum_V;&#x000D;&#x000A;RxElementNum = RxNum_H * RxNum_V;&#x000D;&#x000A;&#x000D;&#x000A;AntGain_Tx = 10;&#x000D;&#x000A;AntGain_Rx = 10;&#x000D;&#x000A;&#x000D;&#x000A;%% RF Impairment Parameters&#x000D;&#x000A;NsFlr_Thermal_dBm = -173.975;&#x000D;&#x000A;PA_Tx.Gain = 25;&#x000D;&#x000A;PA_Tx.NF = 10;&#x000D;&#x000A;PA_Tx.TOI = 100;&#x000D;&#x000A;&#x000D;&#x000A;LNA_Rx.Gain = 40;&#x000D;&#x000A;LNA_Rx.NF = 5;&#x000D;&#x000A;LNA_Rx.TOI = 100;&#x000D;&#x000A;&#x000D;&#x000A;Mixer_Rx.LOAtten = 0;&#x000D;&#x000A;Mixer_Rx.ConvGain = 10;&#x000D;&#x000A;Mixer_Rx.NF = 5;&#x000D;&#x000A;Mixer_Rx.SOI = 100;&#x000D;&#x000A;Mixer_Rx.TOI = 90;&#x000D;&#x000A;&#x000D;&#x000A;% Ideal ADC with ONLY sampling rate defined&#x000D;&#x000A;ADC_Rx.Fs = 40e6;&#x000D;&#x000A;&#x000D;&#x000A;%% Range &amp; Velocity DSP Parameters&#x000D;&#x000A;nRead = PRI*ADC_Rx.Fs;&#x000D;&#x000A;nWrite = TChirp*ADC_Rx.Fs;&#x000D;&#x000A;RangeFFTSize = 2048;%2^nextpow2(nWrite); % Nearest larger 2^N value is preferred&#x000D;&#x000A;DopplerFFTSize = 64;&#x000D;&#x000A;&#x000D;&#x000A;%% Target Number Configurations&#x000D;&#x000A;switch (Scenario_Setup)&#x000D;&#x000A;&#x0009;case 01&#x000D;&#x000A;&#x0009;&#x0009;TarNum = Sce01_No_Tgts; &#x000D;&#x000A;&#x0009;case 02&#x000D;&#x000A;&#x0009;&#x0009;TarNum = Sce02_No_Tgts; &#x000D;&#x000A;&#x0009;case 03&#x000D;&#x000A;&#x0009;&#x0009;TarNum = Sce03_No_Tgts; &#x000D;&#x000A;&#x0009;case 04&#x000D;&#x000A;&#x0009;&#x0009;TarNum = Sce04_No_Tgts; &#x000D;&#x000A;&#x0009;otherwise&#x000D;&#x000A;&#x0009;&#x0009;error (&apos;Scenario Number Setup ERROR, please double check.&apos;)&#x000D;&#x000A;end</Text>
<Item XName="BPMgr" Type="BPMgr">
<BPLines><T>Empty</T></BPLines>
<BPStates><T>Empty</T></BPStates></Item>
<Item XName="EqnBlock" Type="EqnBlock">
<Lang><T>Int</T><D>1</D></Lang></Item>
<Item XName="Font" Type="Font">
<Name>Courier New</Name>
<Size><T>Double</T><D>125</D></Size></Item>
<Item XName="FunctionBlock" Type="FunctionBlock" />
<Item XName="Page" Type="PageMgr">
<Item XName="Display0" Type="EquationDisp">
<DVport><T>Array_Dbl64</T><D>1;4;;;p14;GR14</D></DVport>
<PVPort><T>Array_Dbl64</T><D>1;4;;;SWh1k68Yl24;OPTbrLKRN24</D></PVPort>
<Show><T>Bool</T><D>1</D></Show>
<ShowCmd><T>Int</T><D>1</D></ShowCmd>
<Split><T>Double</T><D>0.3</D></Split>
<Split2><T>Double</T><D>0.3</D></Split2>
<Window><T>Array_I64</T><D>1;4;45;;8A;R2</D></Window>
<ZOrder><T>Int</T><D>3</D></ZOrder></Item></Item>
