<Item XName="RCS_Output_VehicleSce3" UserName="RCS_Output_VehicleSce3" Type="function">
<Description>%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%&#x000D;&#x000A;Function RCS_Output_VehicleSce3:&#x000D;&#x000A;This function proposes reference RCS values in SquareMeters for each Target taken from the reference paper&#x000D;&#x000A;%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%&#x000D;&#x000A;&#x000D;&#x000A;</Description>
<Selected><T>Bool</T><D>0</D></Selected>
<Text>% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%&#x000D;&#x000A;% Function RCS_Output_VehicleSce3:&#x000D;&#x000A;% This function proposes reference RCS values in SquareMeters for each Target taken from the reference paper&#x000D;&#x000A;% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%&#x000D;&#x000A;&#x000D;&#x000A;function RCS = RCS_Output_VehicleSce3(Scenario_Setup, No_Tgts, Freq_Band, RCS_Type, RCS_ValueSel)&#x000D;&#x000A;&#x000D;&#x000A;%% Measurement Polarization Notification:&#x000D;&#x000A;postinfo (&apos;RCS Measurement Polarization: HH&apos;);&#x000D;&#x000A;&#x000D;&#x000A;%% Parameter Checks&#x000D;&#x000A;if (Scenario_Setup ~= 03)&#x000D;&#x000A;&#x0009;error (&apos;Scenario Number Setup ERROR, please reset.&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if ((No_Tgts &lt;= 0) || (No_Tgts &gt; 10))&#x000D;&#x000A;&#x0009;error (&apos;Target Number Out of Range, please reset this value.&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if ((Freq_Band ~= 01) &amp;&amp; (Freq_Band ~= 02))&#x000D;&#x000A;&#x0009;error (&apos;Frequency band selection ERROR.&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if (Freq_Band == 01)&#x000D;&#x000A;&#x0009;warning (&apos;22-29 GHz Measurement NOT conducted in this paper, use 76-81 GHz.&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if (length (RCS_Type) ~= No_Tgts)&#x000D;&#x000A;&#x0009;error (&apos;RCS Type Array MUST be SAME as No_Tgts, please reset this value.&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if (length (RCS_Type) ~= length (RCS_ValueSel))&#x000D;&#x000A;&#x0009;error (&apos;RCS_Type Length NOT equal to RCS_ValueSel, please check.&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;for i = 1:1:length (RCS_Type)&#x000D;&#x000A;&#x0009;if ((RCS_Type(i) ~= 01) &amp;&amp; (RCS_Type(i) ~= 02) &amp;&amp; (RCS_Type(i) ~= 03) &amp;&amp; (RCS_Type(i) ~= 04) &amp;&amp; (RCS_Type(i) ~= 05) &amp;&amp; (RCS_Type(i) ~= 06) &amp;&amp; (RCS_Type(i) ~= 07))&#x000D;&#x000A;&#x0009;&#x0009;error (&apos;RCS Type Setup Error, please reset RCS Type Array&apos;);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;for i = 1:1:length (RCS_ValueSel)&#x000D;&#x000A;&#x0009;if ((RCS_ValueSel(i) ~= 01) &amp;&amp; (RCS_ValueSel(i) ~= 02) &amp;&amp; (RCS_ValueSel(i) ~= 03) &amp;&amp; (RCS_ValueSel(i) ~= 04))&#x000D;&#x000A;&#x0009;&#x0009;error (&apos;RCS VALUE selection setup ERROR, please reset this value.&apos;);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;%% RCS output codes&#x000D;&#x000A;RCS = zeros (No_Tgts,1);&#x000D;&#x000A;&#x000D;&#x000A;for k = 1:1:length (RCS_Type)&#x000D;&#x000A;&#x0009;switch (RCS_Type(k))&#x000D;&#x000A;&#x0009;&#x0009;case 01&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;postinfo (&apos;Scenario-3, Van (Renault Trafic) RCS Selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;switch (RCS_ValueSel(k))&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;case 01&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Back/Front Peak RCS value selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;RCS(k) = 24; &#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;case 02&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Oblique Peak RCS value selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;RCS(k) = 7;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;% warning (&apos;Oblique Peak NOT apparent, Set equal to Minimum&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;case 03&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Side Peak RCS value selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;RCS(k) = 21.8;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;case 04&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Minimum RCS value selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;RCS(k) = -2.8;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;% warning (&apos;Possible Missing Minimum RCS covered by legends in paper&apos;);&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;case 02&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;postinfo (&apos;Scenario-3, Small Van (Peugeot 5008) RCS Selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;switch (RCS_ValueSel(k))&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;case 01&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Back/Front Peak RCS value selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;RCS(k) = 14.2; &#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;case 02&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Oblique Peak RCS value selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;RCS(k) = 7.5;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;% warning (&apos;Oblique Peak NOT apparent, Set equal to Minimum&apos;);&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;case 03&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Side Peak RCS value selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;RCS(k) = 22.3;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;case 04&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Minimum RCS value selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;RCS(k) = -2.5;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;% warning (&apos;Possible Missing Minimum RCS covered by legends in paper&apos;);&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;&#x0009;case 03&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;postinfo (&apos;Scenario-3, Sedan (Peugeot 406) RCS Selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;switch (RCS_ValueSel(k))&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;case 01&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Back/Front Peak RCS value selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;RCS(k) = 15.8; &#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;case 02&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Oblique Peak RCS value selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;RCS(k) = 5.4;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;% warning (&apos;Oblique Peak NOT apparent, Set equal to Minimum&apos;);&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;case 03&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Side Peak RCS value selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;RCS(k) = 19.7;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;case 04&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Minimum RCS value selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;RCS(k) = -3.2;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;case 04&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;postinfo (&apos;Scenario-3, Small Sedan (Peugeot 107) RCS Selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;switch (RCS_ValueSel(k))&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;case 01&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Back/Front Peak RCS value selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;RCS(k) = 21.3; &#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;case 02&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Oblique Peak RCS value selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;RCS(k) = 7.2;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;% warning (&apos;Oblique Peak NOT apparent, Set equal to Back/Front Peak&apos;);&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;case 03&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Side Peak RCS value selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;RCS(k) = 19;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;case 04&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Minimum RCS value selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;RCS(k) = -4;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;case 05&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;postinfo (&apos;Scenario-3, Luxury Sedan (Alfa Romeo Giulietta) RCS Selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;switch (RCS_ValueSel(k))&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;case 01&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Back/Front Peak RCS value selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;RCS(k) = 17.4; &#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;case 02&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Oblique Peak RCS value selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;RCS(k) = 12.8;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;% warning (&apos;Oblique Peak NOT apparent, Set equal to Minimum&apos;);&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;case 03&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Side Peak RCS value selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;RCS(k) = 21.2;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;case 04&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Minimum RCS value selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;RCS(k) = -5;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;case 06&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;postinfo (&apos;Scenario-3, Bicycle RCS Selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;switch (RCS_ValueSel(k))&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;case 01&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Back/Front Peak RCS value selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;RCS(k) = -2.7; &#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;warning (&apos;Back/Front Peak NOT apparent, Set equal to Oblique Peak&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;case 02&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Oblique Peak RCS value selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;RCS(k) = -2.7;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;% warning (&apos;Oblique Peak NOT apparent, Set equal to Back/Front Peak&apos;);&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;case 03&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Side Peak RCS value selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;RCS(k) =10.5;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;warning (&apos;Side Peak NOT apparent, Set equal to Maximum&apos;);&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;case 04&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Minimum RCS value selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;RCS(k) = -10.2;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;case 07&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;postinfo (&apos;Scenario-3, Pedestrian RCS Selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;switch (RCS_ValueSel(k))&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;case 01&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Back/Front Peak RCS value selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;RCS(k) = 0.7; &#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;warning (&apos;Back/Front Peak NOT apparent, Set equal to Oblique Peak&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;case 02&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Oblique Peak RCS value selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;RCS(k) = 0.7;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;% warning (&apos;Oblique Peak NOT apparent, Set equal to Back/Front Peak&apos;);&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;case 03&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Side Peak RCS value selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;RCS(k) = -0.5;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;warning (&apos;Side Peak NOT apparent, Set equal to 2nd peak&apos;);&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;case 04&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Minimum RCS value selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;RCS(k) = -8.2;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;end &#x000D;&#x000A;end&#x000D;&#x000A;&#x0009;&#x0009;&#x000D;&#x000A;&#x000D;&#x000A;RCS = 10.^(RCS/10); &#x000D;&#x000A;end</Text>
