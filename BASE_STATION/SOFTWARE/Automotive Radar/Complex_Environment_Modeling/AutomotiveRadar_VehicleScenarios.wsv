<Item XName="RCS_Output_VehicleSce4" UserName="RCS_Output_VehicleSce4" Type="function">
<Description>%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%&#x000D;&#x000A;Function RCS_Output_VehicleSce4:&#x000D;&#x000A;This function proposes reference RCS values in SquareMeters for each Target taken from the reference paper&#x000D;&#x000A;%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%&#x000D;&#x000A;&#x000D;&#x000A;</Description>
<Selected><T>Bool</T><D>0</D></Selected>
<Text>% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%&#x000D;&#x000A;% Function RCS_Output_VehicleSce4:&#x000D;&#x000A;% This function proposes reference RCS values in SquareMeters for each Target taken from the reference paper&#x000D;&#x000A;% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%&#x000D;&#x000A;&#x000D;&#x000A;function RCS = RCS_Output_VehicleSce4(Scenario_Setup, No_Tgts, Freq_Band, RCS_Type, RCS_ValueSel)&#x000D;&#x000A;&#x000D;&#x000A;%% Measurement Polarization Notification:&#x000D;&#x000A;postinfo (&apos;RCS Measurement Polarization: HH&apos;);&#x000D;&#x000A;&#x000D;&#x000A;%% Parameter Checks&#x000D;&#x000A;if (Scenario_Setup ~= 04)&#x000D;&#x000A;&#x0009;error (&apos;Scenario Number Setup ERROR, please reset.&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if ((No_Tgts &lt;= 0) || (No_Tgts &gt; 10))&#x000D;&#x000A;&#x0009;error (&apos;Target Number Out of Range, please reset this value.&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if ((Freq_Band ~= 01) &amp;&amp; (Freq_Band ~= 02))&#x000D;&#x000A;&#x0009;error (&apos;Frequency band selection ERROR.&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if (Freq_Band == 01)&#x000D;&#x000A;&#x0009;warning (&apos;For 24 GHz, ONLY mean RCS values for Sedan and Pedestrian are available.&apos;);&#x000D;&#x000A;&#x0009;postinfo (&apos;All RCS ValueSel Reset to Mean.&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if (length (RCS_Type) ~= No_Tgts)&#x000D;&#x000A;&#x0009;error (&apos;RCS Type Array MUST be SAME as No_Tgts, please reset this value.&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if (length (RCS_Type) ~= length (RCS_ValueSel))&#x000D;&#x000A;&#x0009;error (&apos;RCS_Type Length NOT equal to RCS_ValueSel, please check.&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;for i = 1:1:length (RCS_Type)&#x000D;&#x000A;&#x0009;if ((RCS_Type(i) ~= 01) &amp;&amp; (RCS_Type(i) ~= 02))&#x000D;&#x000A;&#x0009;&#x0009;error (&apos;RCS Type Setup Error, please reset RCS Type Array&apos;);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;for i = 1:1:length (RCS_ValueSel)&#x000D;&#x000A;&#x0009;if ((RCS_ValueSel(i) ~= 00) &amp;&amp; (RCS_ValueSel(i) ~= 01) &amp;&amp; (RCS_ValueSel(i) ~= 02) &amp;&amp; (RCS_ValueSel(i) ~= 03) &amp;&amp; (RCS_ValueSel(i) ~= 04))&#x000D;&#x000A;&#x0009;&#x0009;error (&apos;RCS VALUE selection setup ERROR, please reset this value.&apos;);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x0009;&#x000D;&#x000A;&#x0009;if (Freq_Band == 01)&#x000D;&#x000A;&#x0009;&#x0009;RCS_ValueSel(i) = 00;&#x000D;&#x000A;&#x0009;end &#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;%% RCS output codes&#x000D;&#x000A;RCS = zeros (No_Tgts,1);&#x000D;&#x000A;&#x000D;&#x000A;for k = 1:1:length (RCS_Type)&#x000D;&#x000A;&#x0009;if (Freq_Band == 01) %% FreqBand = 24 GHz&#x000D;&#x000A;&#x0009;&#x0009;switch (RCS_Type(k))&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;case 01&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Scenario-4, Van RCS Selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Mean RCS value selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;RCS(k) = 9; &#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;case 02&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Scenario-4, Pedestrian RCS Selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Mean RCS value selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;RCS(k) = 1.5;&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009; &#x000D;&#x000A;&#x0009;else %%FreqBand = 79 GHz&#x000D;&#x000A;&#x0009;&#x0009;switch (RCS_Type(k))&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;case 01&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Scenario-4, Van RCS Selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;switch (RCS_ValueSel(k))&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;case 00&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Mean RCS value selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;RCS(k) = 15;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;case 01&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Back/Front Peak RCS value selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;RCS(k) = 28; &#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;case 02&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Oblique Peak RCS value selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;RCS(k) = 17;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;% warning (&apos;Oblique Peak NOT apparent, Set equal to Minimum&apos;);&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;case 03&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Side Peak RCS value selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;RCS(k) = 31.5;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;case 04&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Minimum RCS value selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;RCS(k) = 1.2;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;case 02&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Scenario-4, Pedestrian RCS Selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;switch (RCS_ValueSel(k))&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;case 00&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Mean RCS value selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;RCS(k) = 6;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;case 01&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Back/Front Peak RCS value selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;RCS(k) = 15.3; &#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;case 02&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Oblique Peak RCS value selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;RCS(k) = 14.9;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;% warning (&apos;Oblique Peak NOT apparent, Set equal to Back/Front Peak&apos;);&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;case 03&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Side Peak RCS value selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;RCS(k) = 12;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;case 04&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Minimum RCS value selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;RCS(k) = -5;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;end &#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x000D;&#x000A;end&#x000D;&#x000A;RCS = 10.^(RCS/10); &#x000D;&#x000A;end</Text>
