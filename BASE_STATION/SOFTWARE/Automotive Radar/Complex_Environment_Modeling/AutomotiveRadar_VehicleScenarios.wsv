<Description>%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%&#x000D;&#x000A;Function RCS_Output_VehicleSce2:&#x000D;&#x000A;This function proposes reference RCS values in SquareMeters for each Target taken from the reference paper&#x000D;&#x000A;%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%&#x000D;&#x000A;&#x000D;&#x000A;</Description>
<Selected><T>Bool</T><D>0</D></Selected>
<Text>% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%&#x000D;&#x000A;% Function RCS_Output_VehicleSce2:&#x000D;&#x000A;% This function proposes reference RCS values in SquareMeters for each Target taken from the reference paper&#x000D;&#x000A;% %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%&#x000D;&#x000A;&#x000D;&#x000A;function RCS = RCS_Output_VehicleSce2(Scenario_Setup, No_Tgts, Freq_Band, RCS_Type, RCS_ValueSel)&#x000D;&#x000A;&#x000D;&#x000A;%% Measurement Polarization Notification:&#x000D;&#x000A;postinfo (&apos;RCS Measurement Polarization: HH&apos;);&#x000D;&#x000A;&#x000D;&#x000A;%% Parameter Checks&#x000D;&#x000A;if (Scenario_Setup ~= 02)&#x000D;&#x000A;&#x0009;error (&apos;Scenario Number Setup ERROR, please reset.&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if ((No_Tgts &lt;= 0) || (No_Tgts &gt; 10))&#x000D;&#x000A;&#x0009;error (&apos;Target Number Out of Range, please reset this value.&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if ((Freq_Band ~= 01) &amp;&amp; (Freq_Band ~= 02))&#x000D;&#x000A;&#x0009;error (&apos;Frequency band selection ERROR.&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if (length (RCS_Type) ~= No_Tgts)&#x000D;&#x000A;&#x0009;error (&apos;RCS Type Array MUST be SAME as No_Tgts, please reset this value.&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if (length (RCS_Type) ~= length (RCS_ValueSel))&#x000D;&#x000A;&#x0009;error (&apos;RCS_Type Length NOT equal to RCS_ValueSel, please check.&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;for i = 1:1:length (RCS_Type)&#x000D;&#x000A;&#x0009;if ((RCS_Type(i) ~= 01) &amp;&amp; (RCS_Type(i) ~= 02) &amp;&amp; (RCS_Type(i) ~= 03) &amp;&amp; (RCS_Type(i) ~= 04) &amp;&amp; (RCS_Type(i) ~= 05) &amp;&amp; (RCS_Type(i) ~= 06))&#x000D;&#x000A;&#x0009;&#x0009;error (&apos;RCS Type Setup Error, please reset RCS Type Array&apos;);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;for i = 1:1:length (RCS_ValueSel)&#x000D;&#x000A;&#x0009;if ((RCS_ValueSel(i) ~= 01) &amp;&amp; (RCS_ValueSel(i) ~= 02) &amp;&amp; (RCS_ValueSel(i) ~= 03) &amp;&amp; (RCS_ValueSel(i) ~= 04))&#x000D;&#x000A;&#x0009;&#x0009;error (&apos;RCS VALUE selection setup ERROR, please reset this value.&apos;);&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;%% RCS output codes&#x000D;&#x000A;RCS = zeros (No_Tgts,1);&#x000D;&#x000A;&#x000D;&#x000A;for k = 1:1:length (RCS_Type)&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;if (Freq_Band == 01)&#x000D;&#x000A;&#x0009;&#x0009;postinfo (&apos;Frequency Band = 22-29 GHz selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;switch (RCS_Type(k))&#x000D;&#x000A;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;case 01&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Scenario-2, Sedan (Cadillac STS) RCS Selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;switch (RCS_ValueSel(k))&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;case 01&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Back/Front Peak RCS value selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;RCS(k) = 10.8; &#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;case 02&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Oblique Peak RCS value selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;RCS(k) = 2;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;% warning (&apos;Oblique Peak NOT apparent, Set equal to Minimum&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;case 03&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Side Peak RCS value selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;RCS(k) = 22;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;case 04&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Minimum RCS value selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;RCS(k) = -4.5;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;warning (&apos;Possible Missing Minimum RCS covered by legends in paper&apos;);&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;case 02&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Scenario-2, Truck (Chevrolet Avalanche) RCS Selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;switch (RCS_ValueSel(k))&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;case 01&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Back/Front Peak RCS value selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;RCS(k) = 23; &#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;case 02&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Oblique Peak RCS value selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;RCS(k) = 14;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;% warning (&apos;Oblique Peak NOT apparent, Set equal to Minimum&apos;);&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;case 03&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Side Peak RCS value selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;RCS(k) = 20.5;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;case 04&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Minimum RCS value selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;RCS(k) = -3;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;warning (&apos;Possible Missing Minimum RCS covered by legends in paper&apos;);&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;case 03&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Scenario-2, Van (Chevrolet Express) RCS Selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;switch (RCS_ValueSel(k))&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;case 01&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Back/Front Peak RCS value selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;RCS(k) = 15.5; &#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;case 02&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Oblique Peak RCS value selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;RCS(k) = 7.8;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;% warning (&apos;Oblique Peak NOT apparent, Set equal to Minimum&apos;);&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;case 03&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Side Peak RCS value selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;RCS(k) = 23;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;case 04&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Minimum RCS value selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;RCS(k) = -6.5;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;case 04&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Scenario-2, Bicyclist RCS Selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;switch (RCS_ValueSel(k))&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;case 01&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Back/Front Peak RCS value selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;RCS(k) = -2.5; &#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;case 02&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Oblique Peak RCS value selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;RCS(k) = -0.8;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;% warning (&apos;Oblique Peak NOT apparent, Set equal to Minimum&apos;);&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;case 03&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Side Peak RCS value selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;RCS(k) = 7.2;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;case 04&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Minimum RCS value selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;RCS(k) = -10.5;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;case 05&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Scenario-2, Motorist RCS Selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;switch (RCS_ValueSel(k))&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;case 01&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Back/Front Peak RCS value selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;RCS(k) = -6; &#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;case 02&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Oblique Peak RCS value selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;RCS(k) = 1.5;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;% warning (&apos;Oblique Peak NOT apparent, Set equal to Minimum&apos;);&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;case 03&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Side Peak RCS value selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;RCS(k) = 8.2;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;case 04&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Minimum RCS value selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;RCS(k) = -12.8;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;case 06&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Scenario-2, Adult Pedestrian RCS Selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;switch (RCS_ValueSel(k))&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;case 01&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Back/Front Peak RCS value selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;RCS(k) = -2.5; &#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;warning (&apos;Back/Front Peak NOT apparent, Set equal to Maximum&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;case 02&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Oblique Peak RCS value selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;RCS(k) = -4.2;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;% warning (&apos;Oblique Peak NOT apparent, Set equal to Minimum&apos;);&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;case 03&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Side Peak RCS value selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;RCS(k) = -2.5;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;warning (&apos;Side Peak NOT apparent, Set equal to Maximum&apos;);&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;case 04&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Minimum RCS value selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;RCS(k) = -8.2;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;end &#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;else&#x000D;&#x000A;&#x0009;&#x0009;postinfo (&apos;Frequency Band = 76-81 GHz selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;switch (RCS_Type(k))&#x000D;&#x000A;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;case 01&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Scenario-2, Sedan (Cadillac STS) RCS Selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;switch (RCS_ValueSel(k))&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;case 01&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Back/Front Peak RCS value selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;RCS(k) = 21.8; &#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;case 02&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Oblique Peak RCS value selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;RCS(k) = 5.3;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;% warning (&apos;Oblique Peak NOT apparent, Set equal to Minimum&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;case 03&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Side Peak RCS value selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;RCS(k) = 31;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;case 04&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Minimum RCS value selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;RCS(k) = -7.5;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;warning (&apos;Possible Missing Minimum RCS covered by legends in paper&apos;);&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;case 02&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Scenario-2, Truck (Chevrolet Avalanche) RCS Selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;switch (RCS_ValueSel(k))&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;case 01&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Back/Front Peak RCS value selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;RCS(k) = 27.7; &#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;case 02&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Oblique Peak RCS value selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;RCS(k) = 13.6;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;% warning (&apos;Oblique Peak NOT apparent, Set equal to Minimum&apos;);&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;case 03&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Side Peak RCS value selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;RCS(k) = 23.8;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;case 04&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Minimum RCS value selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;RCS(k) = -6.8;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;% warning (&apos;Possible Missing Minimum RCS covered by legends in paper&apos;);&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;case 03&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Scenario-2, Van (Chevrolet Express) RCS Selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;switch (RCS_ValueSel(k))&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;case 01&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Back/Front Peak RCS value selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;RCS(k) = 13.8; &#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;case 02&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Oblique Peak RCS value selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;RCS(k) = 9.2;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;% warning (&apos;Oblique Peak NOT apparent, Set equal to Minimum&apos;);&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;case 03&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Side Peak RCS value selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;RCS(k) = 31;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;case 04&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Minimum RCS value selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;RCS(k) = -0.8;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;case 04&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Scenario-2, Bicyclist RCS Selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;switch (RCS_ValueSel(k))&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;case 01&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Back/Front Peak RCS value selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;RCS(k) = -2.5; &#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;case 02&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Oblique Peak RCS value selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;RCS(k) = -2.5;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;% warning (&apos;Oblique Peak NOT apparent, Set equal to Back/Front Peak&apos;);&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;case 03&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Side Peak RCS value selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;RCS(k) = 14.6;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;case 04&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Minimum RCS value selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;RCS(k) = -8.0;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;case 05&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Scenario-2, Motorist RCS Selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;switch (RCS_ValueSel(k))&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;case 01&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Back/Front Peak RCS value selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;RCS(k) = 1.5; &#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;case 02&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Oblique Peak RCS value selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;RCS(k) = 3.2;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;% warning (&apos;Oblique Peak NOT apparent, Set equal to Minimum&apos;);&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;case 03&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Side Peak RCS value selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;RCS(k) = 7.8;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;case 04&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Minimum RCS value selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;RCS(k) = -8;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;case 06&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Scenario-2, Adult Pedestrian RCS Selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;switch (RCS_ValueSel(k))&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;case 01&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Back/Front Peak RCS value selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;RCS(k) = -2; &#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;% warning (&apos;Back/Front Peak NOT apparent, Set equal to Maximum&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;case 02&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Oblique Peak RCS value selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;RCS(k) = -2;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;warning (&apos;Oblique Peak NOT apparent, Set equal to Back/Front Peak&apos;);&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;case 03&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Side Peak RCS value selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;RCS(k) = -7.6;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;warning (&apos;Side Peak NOT apparent, Set equal to Maximum&apos;);&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;case 04&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;postinfo (&apos;Minimum RCS value selected.&apos;);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;RCS(k) = -8.2;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;end &#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;RCS = 10.^(RCS/10); &#x000D;&#x000A;&#x000D;&#x000A;end</Text>
