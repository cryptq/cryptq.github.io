<Item XName="Equations" Type="Equation">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>%% Target Position, Velocity and RCS Definitions&#x000D;&#x000A;&#x000D;&#x000A;Sce04_P1 = [-5 0 5*sqrt(3)];&#x000D;&#x000A;Sce04_P2 = [1 0 14];&#x000D;&#x000A;Sce04_P3 = [2 0 20];&#x000D;&#x000A;Sce04_P4 = [5 0 11];&#x000D;&#x000A;&#x000D;&#x000A;Sce04_V1 = [0 0 5];&#x000D;&#x000A;Sce04_V2 = [1 0 12];&#x000D;&#x000A;Sce04_V3 = [0 0 4];&#x000D;&#x000A;Sce04_V4 = [0 0 -0.5];&#x000D;&#x000A;&#x000D;&#x000A;Sce04_RCS1 = Sce04_RCS(1);&#x000D;&#x000A;Sce04_RCS2 = Sce04_RCS(2);&#x000D;&#x000A;Sce04_RCS3 = Sce04_RCS(3);&#x000D;&#x000A;Sce04_RCS4 = Sce04_RCS(4);&#x000D;&#x000A;&#x000D;&#x000A;%% True Target Range &amp; Velocity Values&#x000D;&#x000A;Sce04_TarRange_No1 = sqrt(sum((Sce04_P1-P0).^2));&#x000D;&#x000A;Sce04_TarRange_No2 = sqrt(sum((Sce04_P2-P0).^2));&#x000D;&#x000A;Sce04_TarRange_No3 = sqrt(sum((Sce04_P3-P0).^2));&#x000D;&#x000A;Sce04_TarRange_No4 = sqrt(sum((Sce04_P4-P0).^2));&#x000D;&#x000A;&#x000D;&#x000A;Sce04_TarVel_No1 = sqrt(sum(((Sce04_V1-V0).*(Sce04_P1-P0)/Sce04_TarRange_No1).^2));&#x000D;&#x000A;Sce04_TarVel_No2 = sqrt(sum(((Sce04_V2-V0).*(Sce04_P2-P0)/Sce04_TarRange_No2).^2));&#x000D;&#x000A;Sce04_TarVel_No3 = sqrt(sum(((Sce04_V3-V0).*(Sce04_P3-P0)/Sce04_TarRange_No3).^2));&#x000D;&#x000A;Sce04_TarVel_No4 = sqrt(sum(((Sce04_V4-V0).*(Sce04_P4-P0)/Sce04_TarRange_No4).^2));</Text>
