<Item XName="Equations" Type="Equation">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>%% Target Position, Velocity and RCS Definitions&#x000D;&#x000A;&#x000D;&#x000A;Sce02_P1 = [-5 0 5*sqrt(3)];&#x000D;&#x000A;Sce02_P2 = [1 0 14];&#x000D;&#x000A;Sce02_P3 = [2 0 20];&#x000D;&#x000A;Sce02_P4 = [5 0 11];&#x000D;&#x000A;Sce02_P5 = [-4 0 5];&#x000D;&#x000A;Sce02_P6 = [1 0 25];&#x000D;&#x000A;&#x000D;&#x000A;Sce02_V1 = [0 0 5];&#x000D;&#x000A;Sce02_V2 = [1 0 12];&#x000D;&#x000A;Sce02_V3 = [0 0 4];&#x000D;&#x000A;Sce02_V4 = [0 0 -0.5];&#x000D;&#x000A;Sce02_V5 = [-2 0 -4];&#x000D;&#x000A;Sce02_V6 = [-8 0 1];&#x000D;&#x000A;&#x000D;&#x000A;Sce02_RCS1 = Sce02_RCS(1);&#x000D;&#x000A;Sce02_RCS2 = Sce02_RCS(2);&#x000D;&#x000A;Sce02_RCS3 = Sce02_RCS(3);&#x000D;&#x000A;Sce02_RCS4 = Sce02_RCS(4);&#x000D;&#x000A;Sce02_RCS5 = Sce02_RCS(5);&#x000D;&#x000A;Sce02_RCS6 = Sce02_RCS(6);&#x000D;&#x000A;&#x000D;&#x000A;%% True Target Range &amp; Velocity Values&#x000D;&#x000A;Sce02_TarRange_No1 = sqrt(sum((Sce02_P1-P0).^2));&#x000D;&#x000A;Sce02_TarRange_No2 = sqrt(sum((Sce02_P2-P0).^2));&#x000D;&#x000A;Sce02_TarRange_No3 = sqrt(sum((Sce02_P3-P0).^2));&#x000D;&#x000A;Sce02_TarRange_No4 = sqrt(sum((Sce02_P4-P0).^2));&#x000D;&#x000A;Sce02_TarRange_No5 = sqrt(sum((Sce02_P5-P0).^2));&#x000D;&#x000A;Sce02_TarRange_No6 = sqrt(sum((Sce02_P6-P0).^2));&#x000D;&#x000A;&#x000D;&#x000A;Sce02_TarVel_No1 = sqrt(sum(((Sce02_V1-V0).*(Sce02_P1-P0)/Sce02_TarRange_No1).^2));&#x000D;&#x000A;Sce02_TarVel_No2 = sqrt(sum(((Sce02_V2-V0).*(Sce02_P2-P0)/Sce02_TarRange_No2).^2));&#x000D;&#x000A;Sce02_TarVel_No3 = sqrt(sum(((Sce02_V3-V0).*(Sce02_P3-P0)/Sce02_TarRange_No3).^2));&#x000D;&#x000A;Sce02_TarVel_No4 = sqrt(sum(((Sce02_V4-V0).*(Sce02_P4-P0)/Sce02_TarRange_No4).^2));&#x000D;&#x000A;Sce02_TarVel_No5 = sqrt(sum(((Sce02_V5-V0).*(Sce02_P5-P0)/Sce02_TarRange_No5).^2));&#x000D;&#x000A;Sce02_TarVel_No6 = sqrt(sum(((Sce02_V6-V0).*(Sce02_P6-P0)/Sce02_TarRange_No6).^2));</Text>
