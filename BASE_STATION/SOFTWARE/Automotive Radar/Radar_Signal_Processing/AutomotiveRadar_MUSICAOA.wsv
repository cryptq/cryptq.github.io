<Item XName="Parameters" UserName="Parameters" Type="Equation">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>&#x000D;&#x000A;&#x000D;&#x000A;Fcarrier = 77e9;&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;% simulation parameters&#x000D;&#x000A;SampleRate = 500e6;&#x000D;&#x000A;&#x000D;&#x000A;% waveform parameters&#x000D;&#x000A;Tp = 51.2e-6;&#x000D;&#x000A;PRI = Tp;&#x000D;&#x000A;BandWidth = 200e6;&#x000D;&#x000A;&#x000D;&#x000A;% RF parameters&#x000D;&#x000A;&#x000D;&#x000A;% antenna parameters&#x000D;&#x000A;TxEleNumH = 1;&#x000D;&#x000A;TxEleNumV = 1;&#x000D;&#x000A;TxEleNum = TxEleNumH * TxEleNumV;&#x000D;&#x000A;&#x000D;&#x000A;RxEleNumH = 4;&#x000D;&#x000A;RxEleNumV = 1;&#x000D;&#x000A;RxEleNum = RxEleNumH * RxEleNumV;&#x000D;&#x000A;&#x000D;&#x000A;% platform parameters&#x000D;&#x000A;Position0 = [0 0 0];&#x000D;&#x000A;Velocity0 = [0 0 0];&#x000D;&#x000A;&#x000D;&#x000A;% target parameters&#x000D;&#x000A;TargetNum = 4;&#x000D;&#x000A;&#x000D;&#x000A;Position1 = [0 0 10];&#x000D;&#x000A;Velocity1 = [0 0 10];&#x000D;&#x000A;&#x000D;&#x000A;Position2 = [5 0 60];&#x000D;&#x000A;Velocity2 = [0 0 15];&#x000D;&#x000A;&#x000D;&#x000A;Position3 = [-5 0 60];&#x000D;&#x000A;Velocity3 = [0 0 4];&#x000D;&#x000A;&#x000D;&#x000A;Position4 = [-10 0 90];&#x000D;&#x000A;Velocity4 = [0 0 5];&#x000D;&#x000A;&#x000D;&#x000A;%R1 = 150;&#x000D;&#x000A;%R2 = 100;&#x000D;&#x000A;%&#x000D;&#x000A;%R3 = 50;&#x000D;&#x000A;%&#x000D;&#x000A;%V1 = 30e3/3600;&#x000D;&#x000A;%V2 = 20e3/3600;&#x000D;&#x000A;%V3 = 10e3/3600;&#x000D;&#x000A;&#x000D;&#x000A;% intermediate frequency digitization parameters &#x000D;&#x000A;ADCFs = 10e6;&#x000D;&#x000A;&#x000D;&#x000A;% signal processing parameters&#x000D;&#x000A;RangeSample = ADCFs * Tp;&#x000D;&#x000A;RangeFFTSize = 512;&#x000D;&#x000A;DopplerFFTSize = 128;&#x000D;&#x000A;NumSampleCPI = RangeFFTSize*DopplerFFTSize;</Text>
