<Item XName="EquationSet" Type="PartParam">
<DataEntry />
<Description>Flags that we need a right-click &quot;Edit Equations&quot; menu</Description>
<DocSymbol />
<IsSettable><T>Bool</T><D>0</D></IsSettable>
<Range />
<RunTimeTunable><T>Bool</T><D>0</D></RunTimeTunable>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>4</D></Validate></Item>
<Item XName="EquationText" Type="PartParam">
<DataEntry>&#x000D;&#x000A;&#x000D;&#x000A;DataInput = input;&#x000D;&#x000A;&#x000D;&#x000A;Index= find(DataInput==1);&#x000D;&#x000A;TargetNum = size(Index,1);&#x000D;&#x000A;&#x000D;&#x000A;Range = (mod(Index,RangeFFTSize)-1) / RangeFFTSize * ADCFs * PulseWidth * 3.0e8 / (2 * Bandwidth);&#x000D;&#x000A;Wavelength = 3.0e8/Fcarrier;&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;Velocity = floor(Index/RangeFFTSize) / DopplerFFTSize * Wavelength/PRI/2;&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;TargeData = zeros(RxChannelNum,TargetNum);&#x000D;&#x000A;&#x000D;&#x000A;for Rx = 1:RxChannelNum&#x000D;&#x000A;    for Tg = 1:TargetNum&#x000D;&#x000A;&#x0009;    TargeData(Rx,Tg) = ChannelData{Rx}(Index(Tg));&#x0009;&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;a_search=zeros(RxChannelNum,1);             &#x000D;&#x000A;Search_theta=-90:90;         &#x000D;&#x000A;&#x000D;&#x000A;P=zeros(length(Search_theta),TargetNum);  &#x000D;&#x000A;&#x000D;&#x000A;lamda = 3.0e8/Fcarrier;&#x000D;&#x000A;Sensor_x = (0:RxChannelNum-1)*lamda/2;&#x000D;&#x000A;for Tg = 1:TargetNum&#x000D;&#x000A;&#x000D;&#x000A;    X = TargeData(:,Tg);&#x000D;&#x000A;&#x000D;&#x000A;    R=X*X&apos;;&#x000D;&#x000A;&#x0009;&#x000D;&#x000A;    [U,S,V]=svd(R);&#x000D;&#x000A;&#x0009;&#x000D;&#x000A;&#x0009;SVal = diag(S);&#x000D;&#x000A;    for m = 1:length(SVal)-1&#x000D;&#x000A;        if SVal(m)/SVal(m+1) &gt; 1e4&#x000D;&#x000A;           Source_num = m;&#x000D;&#x000A;           break&#x000D;&#x000A;        end&#x000D;&#x000A;    end&#x000D;&#x000A;&#x0009;&#x000D;&#x000A;    Un=U(:,(Source_num+1):RxChannelNum-1);&#x000D;&#x000A;&#x000D;&#x000A;    for i=1:length(Search_theta) &#x000D;&#x000A;        a_search=exp(-1i*2*pi/lamda*(Sensor_x&apos;*(sind(Search_theta(i)))));&#x000D;&#x000A;        P(i,Tg)=1/abs((a_search)&apos;*(Un*Un&apos;)*a_search);&#x000D;&#x000A;    end&#x000D;&#x000A;&#x000D;&#x000A;end&#x000D;&#x000A;Angle = 10*log10(P);&#x000D;&#x000A;%P_max=max(max(P));&#x000D;&#x000A;%P_MUSIC=10*log10(P/P_max);&#x000D;&#x000A;%surf(Search_fi,Search_theta,P_MUSIC);</DataEntry>
<Description>Equation Text to Parse, edited in the equation set</Description>
<DocSymbol />
<IsSettable><T>Bool</T><D>0</D></IsSettable>
<Range />
<RunTimeTunable><T>Bool</T><D>0</D></RunTimeTunable>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>4</D></Validate></Item>
