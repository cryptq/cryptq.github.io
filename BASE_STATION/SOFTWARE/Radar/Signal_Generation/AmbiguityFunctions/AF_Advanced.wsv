<Item XName="Barker-Code" UserName="Barker-Code" Type="Folder">
<IsOpen><T>Bool</T><D>1</D></IsOpen>
<Selected><T>Bool</T><D>0</D></Selected>
<Item XName="AF_Plot_Barker" UserName="AF_Plot_Barker" Type="Equation">
<AutoCalc><T>Bool</T><D>0</D></AutoCalc>
<Selected><T>Bool</T><D>0</D></Selected>
<Text>using(&apos;Barker_Data&apos;);&#x000D;&#x000A;a = S1_AF;&#x000D;&#x000A;length = Length_Barker;&#x000D;&#x000A;fft_size = FFTSize_Barker;&#x000D;&#x000A;ts = 1/SampleRate;&#x000D;&#x000A;normalized = 1;&#x000D;&#x000A;&#x000D;&#x000A;N = length;&#x000D;&#x000A;N2 = N*2+1;&#x000D;&#x000A;M = fft_size;&#x000D;&#x000A;Tf = ts;&#x000D;&#x000A;abs_label = normalized;&#x000D;&#x000A;AF = zeros(1, N2, M);&#x000D;&#x000A;AF(1,1:N2, 1:M) = a(1,:,:);&#x000D;&#x000A;AF = reshape(AF, N2, M);&#x000D;&#x000A;&#x000D;&#x000A;f_abs = ((-M/2:M/2-1)/M)*(1/Tf);&#x000D;&#x000A;t_abs = (-N:N)*Tf;&#x000D;&#x000A;&#x000D;&#x000A;f_rel = ((-M/2:M/2-1)/M)*(1/Tf)*(N*Tf);&#x000D;&#x000A;t_rel = (-N:N)/N&#x000D;&#x000A;&#x000D;&#x000A;peak=max(max(AF));&#x000D;&#x000A;&#x000D;&#x000A;graph1 = graph_figure(&apos;Ambiguity Surface Barker-13&apos;);&#x000D;&#x000A;if(abs_label)&#x000D;&#x000A;&#x0009;graph1.add_surface_data(f_abs,t_abs,AF);&#x000D;&#x000A;&#x0009;graph1.set_label_x(&apos;Doppler shift (Hz)&apos;);&#x000D;&#x000A;&#x0009;graph1.set_label_y(&apos;delay (sec)&apos;);&#x000D;&#x000A;&#x0009;graph1.set_label_z(&apos;amplitude&apos;);&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;graph1.add_surface_data(f_rel,t_rel,AF);&#x000D;&#x000A;&#x0009;graph1.set_label_x(&apos;normalized Doppler shift&apos;);&#x000D;&#x000A;&#x0009;graph1.set_label_y(&apos;normalized delay&apos;);&#x0009;&#x000D;&#x000A;&#x0009;graph1.set_label_z(&apos;amplitude&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;f_abs_3 = f_abs;&#x000D;&#x000A;t_abs_3 = t_abs;&#x000D;&#x000A;AF_ZeroDopplerCutVar_3 = AF(:,M/2+1);&#x000D;&#x000A;AF_ZeroDelayCutVar_3 = AF(N,:);</Text>
