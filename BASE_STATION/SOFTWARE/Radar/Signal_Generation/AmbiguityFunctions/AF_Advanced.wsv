<Item XName="EquationText" Type="PartParam">
<DataEntry>&apos;[r c] = size(input);&#x000D;&#x000A;if (input == 1)&#x000D;&#x000A;&#x0009;input = input.&apos;;&#x000D;&#x000A;end&#x000D;&#x000A;x = input;&#x000D;&#x000A;N = length;&#x000D;&#x000A;M = fft_size;&#x000D;&#x000A;AF = zeros(2*N+1, M);&#x000D;&#x000A;for n = -N+2:N&#x000D;&#x000A;&#x0009;if (n &lt;= 1)&#x000D;&#x000A;&#x0009;&#x0009;AF(n+N,1:n+N-1) = x(1:n+N-1).*conj(x(2-n:N));&#x000D;&#x000A;&#x0009;else&#x000D;&#x000A;&#x0009;&#x0009;AF(n+N,n:N) = x(n:N).*conj(x(1:N-n+1));&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;for n = 1:2*N+1&#x000D;&#x000A;&#x0009;AF(n,:) = fftshift(M*ifft(AF(n,:)));&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;AF = abs(AF);</DataEntry>
<Description>Equation Text to Parse, edited in the equation set</Description>
<DocSymbol />
<IsSettable><T>Bool</T><D>0</D></IsSettable>
<Range />
<RunTimeTunable><T>Bool</T><D>0</D></RunTimeTunable>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>4</D></Validate></Item>
