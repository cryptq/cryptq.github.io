<Item XName="Eqns" Type="Equation">
<Text>y = getvariable(&apos;WorkspaceVariables&apos;, &apos;AF_ZeroDopplerCutVar_3&apos;);&#x000D;&#x000A;x = getvariable(&apos;WorkspaceVariables&apos;, &apos;t_abs_3&apos;);&#x000D;&#x000A;setindep(&apos;y&apos;, &apos;x&apos;);</Text>
