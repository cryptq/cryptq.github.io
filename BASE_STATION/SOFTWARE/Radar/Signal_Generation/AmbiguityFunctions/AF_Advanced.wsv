<Text>%% This Equation file calculates all parameters required for ambiguity function calculations&#x000D;&#x000A;%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%&#x000D;&#x000A;%%&#x000D;&#x000A;SampleRate = 10e6;&#x000D;&#x000A;%%Barker-Code AF Parameters&#x000D;&#x000A;% Src parameters&#x000D;&#x000A;SubPulseWidth_Barker = 1e-6;&#x000D;&#x000A;PRI_Barker = 13e-6;&#x000D;&#x000A;% AF Function parameters&#x000D;&#x000A;Length_Barker = PRI_Barker*SampleRate;&#x000D;&#x000A;FFTSize_Barker = 256;&#x000D;&#x000A;Ts_Barker = 1/SampleRate;&#x000D;&#x000A;&#x000D;&#x000A;%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%&#x000D;&#x000A;%%Costas AF Parameters&#x000D;&#x000A;% Src parameters&#x000D;&#x000A;PRI_Costas = 100e-6;&#x000D;&#x000A;Costas_TimePeiod = PRI_Costas/10; %10 is the Costas Type Length&#x000D;&#x000A;CostasSeq_DeltaF = 1/Costas_TimePeiod;&#x000D;&#x000A;% AF Function parameters&#x000D;&#x000A;SampleRate_Costas = 2e6;&#x000D;&#x000A;Length_Costas = PRI_Costas*SampleRate_Costas;&#x000D;&#x000A;FFTSize_Costas = 256;&#x000D;&#x000A;&#x000D;&#x000A;%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%&#x000D;&#x000A;%%NLFM AF Parameters&#x000D;&#x000A;PulseWidth_NLFM = 1e-5;&#x000D;&#x000A;PRI_NLFM = 1e-5;&#x000D;&#x000A;BW_NLFM = 5e6;&#x000D;&#x000A;% AF Function parameters&#x000D;&#x000A;Length_NLFM = PRI_NLFM*SampleRate;&#x000D;&#x000A;FFTSize_NLFM = 512;&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;</Text>
