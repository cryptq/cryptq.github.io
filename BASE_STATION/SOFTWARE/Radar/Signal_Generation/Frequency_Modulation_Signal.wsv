<Item XName="Equations" Type="Equation">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>%% Costas Coding Parameters&#x000D;&#x000A;SampleRate = 10e6;&#x000D;&#x000A;PRI = 7e-5;%1e-4;&#x000D;&#x000A;&#x000D;&#x000A;Length_CostasCode = 7; %% Need to be changed if Costas Code Type is changed to another length.&#x000D;&#x000A;&#x000D;&#x000A;Costas_SeqDeltaFreq = 1e5;&#x000D;&#x000A;Costas_TimePeriod = 1e-5;&#x000D;&#x000A;&#x000D;&#x000A;Pulse_SampleNum = SampleRate*Costas_TimePeriod*Length_CostasCode;&#x000D;&#x000A;PRI_SampleNum = SampleRate*PRI;&#x000D;&#x000A;Sink_SampleNum = 4*PRI_SampleNum; %% Gather 4 PRIs in Time Sink.&#x000D;&#x000A;&#x000D;&#x000A;ACF_SampleNum = PRI_SampleNum*2;&#x000D;&#x000A;&#x000D;&#x000A;ResBW = 1e3;%Costas_TimePeriod*SampleRate &#x000D;&#x000A;&#x000D;&#x000A;%[2,4,8,5,10,9,7,3,6,1]</Text>
<Item XName="BPMgr" Type="BPMgr">
<BPLines><T>Array_I64</T><D>1;0;</D></BPLines>
<BPStates><T>Array_I64</T><D>1;0;</D></BPStates></Item>
