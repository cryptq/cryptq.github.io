<Item XName="result_analysis" UserName="result_analysis" Type="Equation">
<AutoCalc><T>Bool</T><D>0</D></AutoCalc>
<Selected><T>Bool</T><D>0</D></Selected>
<Text>using(&apos;DF4_Design4_Data&apos;);&#x000D;&#x000A;&#x000D;&#x000A;Fs = BB_SampleRate;&#x000D;&#x000A;t = (0 : 1/Fs : PulseWidth-1/Fs)&apos;;&#x000D;&#x000A;&#x000D;&#x000A;using(&apos;DF4_Design4_Data&apos;);&#x000D;&#x000A;&#x000D;&#x000A;%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%&#x000D;&#x000A;%% LFM Signal Processing&#x000D;&#x000A;L = length(LFM_signal);&#x000D;&#x000A;LFM_signal_i = real(LFM_signal);&#x000D;&#x000A;LFM_signal_q = imag(LFM_signal);&#x000D;&#x000A;&#x000D;&#x000A;% single-sided amplitude spectrum.&#x000D;&#x000A;NFFT = 2^nextpow2(L); % Next power of 2 from length of y&#x000D;&#x000A;Y = fft(LFM_signal,NFFT)/L;&#x000D;&#x000A;f = Fs/2*linspace(0,1,NFFT/2+1)&apos;;&#x000D;&#x000A;LFM_Spec = 20*log10(abs(Y(1:NFFT/2+1)));&#x000D;&#x000A;LFM_Spec = LFM_Spec(1:length(f));&#x000D;&#x000A;&#x000D;&#x000A;% Plot Frequency-Time Spectrum&#x000D;&#x000A;xh1=unwrap(angle(LFM_signal));&#x000D;&#x000A;xhd1=diff(xh1)/(2*pi)*Fs;&#x000D;&#x000A;LFM_Freq = xhd1(1:length(t)-1,1);&#x000D;&#x000A;&#x000D;&#x000A;% Chirp Rate&#x000D;&#x000A;LFM_chirpRate = diff(xhd1)*Fs/1e6;%MHz/us&#x000D;&#x000A;LFM_chirpRate = LFM_chirpRate(1:length(t)-2);&#x000D;&#x000A;&#x000D;&#x000A;%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%&#x000D;&#x000A;%% NLFM Signal Processing&#x000D;&#x000A;L = length(NLFM_signal);&#x000D;&#x000A;NLFM_signal_i = real(NLFM_signal);&#x000D;&#x000A;NLFM_signal_q = imag(NLFM_signal);&#x000D;&#x000A;&#x000D;&#x000A;% single-sided amplitude spectrum.&#x000D;&#x000A;NFFT = 2^nextpow2(L); % Next power of 2 from length of y&#x000D;&#x000A;Y = fft(NLFM_signal,NFFT)/L;&#x000D;&#x000A;f = Fs/2*linspace(0,1,NFFT/2+1)&apos;;&#x000D;&#x000A;NLFM_Spec = 20*log10(abs(Y(1:NFFT/2+1)));&#x000D;&#x000A;&#x000D;&#x000A;% Plot Frequency-Time Spectrum&#x000D;&#x000A;xh1=unwrap(angle(NLFM_signal));&#x000D;&#x000A;xhd1=diff(xh1)/(2*pi)*Fs;&#x000D;&#x000A;NLFM_Freq = xhd1(1:length(t)-1,1);&#x000D;&#x000A;&#x000D;&#x000A;% Chirp Rate&#x000D;&#x000A;NLFM_chirpRate = diff(xhd1)*Fs/1e6;%MHz/us&#x000D;&#x000A;NLFM_chirpRate = NLFM_chirpRate(1:length(t)-2);</Text>
<UnitUse><T>Int</T><D>2</D></UnitUse>
