<Item XName="Equations" Type="Equation">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>% OversamplingOption&#x000D;&#x000A;OversamplingOption = 1;&#x000D;&#x000A;&#x000D;&#x000A;% FCarrier&#x000D;&#x000A;FCarrier = 2e9;&#x000D;&#x000A;FCarrier1 = FCarrier-10e6-50e3;&#x000D;&#x000A;FCarrier2 = FCarrier+10e6+50e3;&#x000D;&#x000A;% Transmit Power&#x000D;&#x000A;RS_EPRE = -25;&#x000D;&#x000A;&#x000D;&#x000A;NDensity = 10^((RS_EPRE-10*log10(15e3)-SNR)/10)/1000.0;&#x000D;&#x000A;&#x000D;&#x000A;% Rx algorithm (for EPA 5Hz)&#x000D;&#x000A;Tmax = 0.01e-6;&#x000D;&#x000A;Fmax = 0.01;&#x000D;&#x000A;TC_Iteration = 6;&#x000D;&#x000A;DemapperType = 1;&#x000D;&#x000A;DemapperMaxLevel = 100.0;&#x000D;&#x000A;Bandwidth=5;&#x000D;&#x000A;% Sampling Rate &#x000D;&#x000A;SamplingTable = [1.92 3.84 7.68 15.36 23.04 30.72];&#x000D;&#x000A;SamplingFreq = 1e6*SamplingTable(Bandwidth+1);&#x000D;&#x000A;SamplingRate = SamplingFreq*(2^OversamplingOption);&#x000D;&#x000A;SampsPerFrame = 10*0.001*SamplingRate;&#x000D;&#x000A;SampsPerSF = 0.001*SamplingRate;&#x000D;&#x000A;&#x000D;&#x000A;%RB Allocation&#x000D;&#x000A;%UE1_RB_Alloc0(1:1:9)=0:1:8;&#x000D;&#x000A;%UE1_RB_Alloc0(10:1:18)=16:1:24;&#x000D;&#x000A;%UE1_RB_Alloc0(19:1:25)=-1;&#x000D;&#x000A;%UE1_RB_Alloc1=0:1:24;&#x000D;&#x000A;%UE1_RB_Alloc2=0:1:24;&#x000D;&#x000A;%UE1_RB_Alloc3=0:1:24;&#x000D;&#x000A;%UE1_RB_Alloc4=0:1:24;&#x000D;&#x000A;%UE1_RB_Alloc5(1:1:9)=0:1:8;&#x000D;&#x000A;%UE1_RB_Alloc5(10:1:18)=16:1:24;&#x000D;&#x000A;%UE1_RB_Alloc5(19:1:25)=-1;&#x000D;&#x000A;%UE1_RB_Alloc6=0:1:24;&#x000D;&#x000A;%UE1_RB_Alloc7=0:1:24;&#x000D;&#x000A;%UE1_RB_Alloc8=0:1:24;&#x000D;&#x000A;%UE1_RB_Alloc9=0:1:24;&#x000D;&#x000A;UE1_RB_Alloc0(1:1:46)=0:1:45;&#x000D;&#x000A;UE1_RB_Alloc0(47:1:93)=53:1:99;&#x000D;&#x000A;UE1_RB_Alloc0(94:1:100)=-1;&#x000D;&#x000A;UE1_RB_Alloc1(1:1:46)=0:1:45;&#x000D;&#x000A;UE1_RB_Alloc1(47:1:93)=53:1:99;&#x000D;&#x000A;UE1_RB_Alloc1(94:1:100)=-1;&#x000D;&#x000A;UE1_RB_Alloc2=0:1:99;&#x000D;&#x000A;UE1_RB_Alloc3=0:1:99;&#x000D;&#x000A;UE1_RB_Alloc4=0:1:99;&#x000D;&#x000A;UE1_RB_Alloc5(1:1: