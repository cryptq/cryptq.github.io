<Item XName="Generate Signals" UserName="Generate Signals" Type="Equation">
<AutoCalc><T>Bool</T><D>0</D></AutoCalc>
<Description>g_WfmStartTime = 0;  % 0 s&#x000D;&#x000A;g_WfmStopTime = 80e-3; % 80 mS&#x000D;&#x000A;delays = 100000;&#x000D;&#x000A;% Break the memory limitation using SV&#x000D;&#x000A;% Asumming the required signal length &gt; the memory depth of instruments&#x000D;&#x000A;% what we can do is write the signal with required length in local disk, &#x000D;&#x000A;% devide the original sequece to number of subsequence that can be processed properly &#x000D;&#x000A;% by the instruments.  Each time we just process one of the subsequence &#x000D;&#x000A;tStep = 1/Sample_Rate;&#x000D;&#x000A;% WfmStartTimes = [0, 80e-3, 160e-3];&#x000D;&#x000A;% WfmStopTimes = [80e-3 - tStep, 160e-3 - tStep, 240e-3 - tStep];&#x000D;&#x000A;% NumSubSequences = l0;&#x000D;&#x000A;SubSTime = 80e-3;&#x000D;&#x000A;PowerLevel = -30; %in dBm &#x000D;&#x000A;% Use SystemVue instrument control functions for E4438C to control power&#x0009;&#x000D;&#x000A;% SigGenE4438C_SetPower_dBm(srcs, PowerLevel);&#x000D;&#x000A;% Specify VSG instruments&#x000D;&#x000A;srcIPs = &apos;192.168.0.11&apos;;&#x000D;&#x000A;% srcs = tcpip(srcIPs, 5025);&#x000D;&#x000A;% Generate a long sequence and write to the local disk&#x000D;&#x000A;% runanalysis(&apos;DF1&apos;);&#x000D;&#x000A;% Open src&apos;s tcpip port for communication&#x000D;&#x000A;% fopen(srcs);&#x000D;&#x000A;AverageTh = 0;&#x000D;&#x000A;% Process SubS one by one for the BER/ThroughPut measurements&#x000D;&#x000A;for idxSubS = 1:1:10&#x000D;&#x000A;&#x0009;g_WfmStartTime = SubSTime*(idxSubS-1);&#x000D;&#x000A;&#x0009;g_WfmStopTime = g_WfmStartTime + SubSTime - tStep;&#x000D;&#x000A;&#x0009;% Read subsequece data from the original sequence&#x000D;&#x000A; &#x0009;runanalysis(&apos;DF2&apos;);&#x000D;&#x000A;    for ii = 1:1:delays&#x000D;&#x000A;        sqrt(2.5);&#x000D;&#x000A;        atan(2.5);&#x000D;&#x000A;    end &#x000D;&#x000A;&#x0009;% Do ThroughPut/BER measurement&#x000D;&#x000A;&#x0009;runanalysis(&apos;DF3&apos;);&#x000D;&#x000A;&#x0009;Throuput(idxSubS) = getvariable(&apos;DF3_data&apos;, &apos;LTE_TDD_UL_Receiver__L1_ThroughputFraction&apos;);&#x0009;&#x000D;&#x000A;&#x0009;AverageTh = AverageTh + Throuput(idxSubS);&#x000D;&#x000A;end&#x000D;&#x000A;setvariable(&apos;DF3_data&apos;, &apos;TotalTh&apos;,AverageTh/NumSubSequences&apos;);&#x000D;&#x000A;setvariable(&apos;DF3_data&apos;, &apos;Throughput&apos;,Throuput&apos;);</Description>
<Selected><T>Bool</T><D>0</D></Selected>
<Text>runanalysis(&apos;DF1&apos;);&#x000D;&#x000A;runanalysis(&apos;DF2&apos;);&#x000D;&#x000A;runanalysis(&apos;DF3&apos;);&#x000D;&#x000A;runanalysis(&apos;DF4&apos;);&#x000D;&#x000A;runanalysis(&apos;DF5&apos;);&#x000D;&#x000A;runanalysis(&apos;DF6&apos;);</Text>
<UnitUse><T>Int</T><D>2</D></UnitUse>
