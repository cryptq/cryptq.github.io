<Item XName="Equations" Type="Equation">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>%% Compensate Filter Delay for the SpectraSys RFLink Filters&#x000D;&#x000A;FilterDelay = 1.15e-5 + 2.85e-5; %% Read Filter Delays from &#x000D;&#x000A;DelayComp_Num = floor(-1*FilterDelay*fs );&#x000D;&#x000A;&#x000D;&#x000A;%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%&#x000D;&#x000A;% PRI_Input=tune(100);&#x000D;&#x000A;% Pulse_Width=tune(10);&#x000D;&#x000A;%Bandwidth=tune(2e6);&#x000D;&#x000A;&#x000D;&#x000A;%PulseWidth = 10e-6;&#x000D;&#x000A;%Pulsewidth = PulseWidth;&#x000D;&#x000A;NumberOfAnt=tune(16);&#x000D;&#x000A;%Pulsewidth = PulseWidth;&#x000D;&#x000A;NumberOfAnt1D = NumberOfAnt;&#x000D;&#x000A;&#x000D;&#x000A;SignalClutterRatio=tune(-5);  % signal-to-clutter ratio (dB)&#x000D;&#x000A;SCR = SignalClutterRatio;&#x000D;&#x000A;SNR = 10;  % signal-to-noise ratio(dB)</Text>
