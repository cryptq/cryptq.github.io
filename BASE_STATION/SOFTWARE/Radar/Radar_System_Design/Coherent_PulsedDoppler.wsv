<Item XName="Equation1" UserName="Equation1" Type="Equation">
<AutoCalc><T>Bool</T><D>0</D></AutoCalc>
<Selected><T>Bool</T><D>0</D></Selected>
<Text>PRI_Num = 80;&#x000D;&#x000A;FFT_Size = 256;&#x000D;&#x000A;PRI = 8e-6;&#x000D;&#x000A;RF_Freq = 4.27e9;&#x000D;&#x000A;c = 3e8;&#x000D;&#x000A;range_max = c*PRI/2;&#x000D;&#x000A;fd_max = 1/PRI/2;&#x000D;&#x000A;samplerate = 10e6;&#x000D;&#x000A;PRF = 1 / PRI;&#x000D;&#x000A;wavelength = c / RF_Freq;&#x000D;&#x000A;&#x000D;&#x000A;using(&apos;Design1_Data&apos;);&#x000D;&#x000A;rd_mtx = reshape( S6, PRI_Num, FFT_Size );&#x000D;&#x000A;&#x000D;&#x000A;rd_mtx_re = real(rd_mtx);&#x000D;&#x000A;rd_mtx_im = imag(rd_mtx);&#x000D;&#x000A;&#x000D;&#x000A;range = [0:PRI_Num-1] * (c/2 / samplerate);&#x000D;&#x000A;velocity = [0 : PRF/FFT_Size : PRF-PRF/FFT_Size] * wavelength / 2.0;&#x000D;&#x000A;&#x000D;&#x000A;fd = rd_mtx_re + j * rd_mtx_im;&#x000D;&#x000A;&#x000D;&#x000A;range_doppler_result = graph_figure(&apos;The Range-Doppler Processing Result&apos;);&#x000D;&#x000A;range_doppler_result.add_mesh_data(abs(fd));&#x000D;&#x000A;range_doppler_result.set_title(&apos;The Range-Doppler Processing Result&apos;);&#x000D;&#x000A;range_doppler_result.set_label_x(&apos;Velocity(m/s)&apos;);&#x000D;&#x000A;range_doppler_result.set_label_y(&apos;Range(m)&apos;);&#x000D;&#x000A;range_doppler_result.set_label_z(&apos;Amplitude&apos;);&#x000D;&#x000A;</Text>
<UnitUse><T>Int</T><D>2</D></UnitUse>
