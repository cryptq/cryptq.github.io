<Item XName="Equation_PD" UserName="Equation_PD" Type="Equation">
<AutoCalc><T>Bool</T><D>0</D></AutoCalc>
<Selected><T>Bool</T><D>0</D></Selected>
<Text>using(&apos;Design1 Analysis2_Design2_Data&apos;);&#x000D;&#x000A;&#x000D;&#x000A;echo = PC_data;&#x000D;&#x000A;&#x000D;&#x000A;echo_re = real(echo);&#x000D;&#x000A;echo_im = imag(echo);&#x000D;&#x000A;&#x000D;&#x000A;PRI = 100e-6;&#x000D;&#x000A;fs = 4e6;&#x000D;&#x000A;&#x000D;&#x000A;PRI_Sample_Num = PRI * fs;&#x000D;&#x000A;CPI_Num = 32;&#x000D;&#x000A;&#x000D;&#x000A;PD_Result_re = real(PD_Out);&#x000D;&#x000A;PD_Result_im = imag(PD_Out);&#x000D;&#x000A;&#x000D;&#x000A;echo_cplx = echo_re + j * echo_im;&#x000D;&#x000A;&#x000D;&#x000A;echo_mat = reshape(echo_cplx, PRI_Sample_Num, CPI_Num);&#x000D;&#x000A;&#x000D;&#x000A;echo_mat_fft = zeros(PRI_Sample_Num, CPI_Num);&#x000D;&#x000A;&#x000D;&#x000A;for n = 1 : PRI_Sample_Num&#x000D;&#x000A;&#x0009;echo_mat_fft(n,:) = fft(echo_mat(n, :));&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;graph1 = graph_figure(&apos;Range-Doppler Matrix&apos;);&#x000D;&#x000A;graph1.add_surface_data(abs(echo_mat_fft));&#x000D;&#x000A;graph1.set_label_x(&apos;PRF&apos;);&#x000D;&#x000A;graph1.set_label_y(&apos;range&apos;);&#x000D;&#x000A;graph1.set_label_z(&apos;amplitude&apos;);&#x000D;&#x000A;&#x000D;&#x000A;PD_result_cplx = PD_Result_re + j * PD_Result_im;&#x000D;&#x000A;PD_result_mat = reshape(PD_result_cplx, PRI_Sample_Num, CPI_Num);&#x000D;&#x000A;&#x000D;&#x000A;graph2 = graph_figure(&apos;PD_result&apos;);&#x000D;&#x000A;graph2.add_surface_data(abs(PD_result_mat));&#x000D;&#x000A;graph2.set_label_x(&apos;PRF&apos;);&#x000D;&#x000A;graph2.set_label_y(&apos;range&apos;);&#x000D;&#x000A;graph2.set_label_z(&apos;amplitude&apos;);</Text>
