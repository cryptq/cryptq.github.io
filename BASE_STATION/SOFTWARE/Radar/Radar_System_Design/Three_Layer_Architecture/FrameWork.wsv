<Text>PRI_Sample_Num = PRI * fs;&#x000D;&#x000A;CPI_Num = 32;&#x000D;&#x000A;% PRI_Input=tune(100);&#x000D;&#x000A;% Pulse_Width=tune(10);&#x000D;&#x000A;%Bandwidth=tune(2e6);&#x000D;&#x000A;PRI = 100e-6;&#x000D;&#x000A;%PulseWidth = 10e-6;&#x000D;&#x000A;%Pulsewidth = PulseWidth;&#x000D;&#x000A;NumberOfAnt=tune(16);&#x000D;&#x000A;%Pulsewidth = PulseWidth;&#x000D;&#x000A;NumberOfAnt1D = NumberOfAnt;&#x000D;&#x000A;&#x000D;&#x000A;SignalClutterRatio=tune(-5);  % signal-to-clutter ratio (dB)&#x000D;&#x000A;SCR = SignalClutterRatio;&#x000D;&#x000A;SNR = 10;  % signal-to-noise ratio(dB)</Text>
