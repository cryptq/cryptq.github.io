<Item XName="EquationText" Type="PartParam">
<DataEntry>persistent m theta phi;&#x000D;&#x000A;&#x000D;&#x000A;if isempty(m)&#x000D;&#x000A;&#x0009;m = 0;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if isempty(theta)&#x000D;&#x000A;&#x0009;theta = theta_start * pi / 180;;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if isempty(phi)&#x000D;&#x000A;&#x0009;phi = 0;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;m = m + 1;&#x000D;&#x000A;if m == PRISamNum + 1&#x000D;&#x000A;&#x0009;m = 1;&#x000D;&#x000A;&#x0009;if theta &gt;= (theta_end-1e-3) * pi / 180&#x000D;&#x000A;&#x0009;   theta = theta_start * pi / 180;&#x000D;&#x000A;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;else&#x000D;&#x000A;&#x0009;   theta = theta + BeamStep_theta * pi / 180;&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x0009;&#x000D;&#x000A;&#x0009;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if theta &lt; 0&#x000D;&#x000A;   phi_out = pi;&#x000D;&#x000A;else&#x000D;&#x000A;   phi_out = 0;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;theta_out = abs(theta);&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;%persistent m Azi Ele;&#x000D;&#x000A;%&#x000D;&#x000A;%if isempty(m)&#x000D;&#x000A;%&#x0009;m = 0;&#x000D;&#x000A;%end&#x000D;&#x000A;%&#x000D;&#x000A;%if isempty(Ele)&#x000D;&#x000A;%&#x0009;Ele = Ele_start * pi / 180;;&#x000D;&#x000A;%end&#x000D;&#x000A;%&#x000D;&#x000A;%if isempty(Azi)&#x000D;&#x000A;%&#x0009;Azi = Azi_start * pi / 180;&#x000D;&#x000A;%end&#x000D;&#x000A;%&#x000D;&#x000A;%m = m + 1;&#x000D;&#x000A;%if m == PRISamNum + 1&#x000D;&#x000A;%&#x0009;m = 1;&#x000D;&#x000A;%&#x0009;if Azi &gt;= (Azi_end-1e-3) * pi / 180&#x000D;&#x000A;%&#x0009;   Azi = Azi_start * pi / 180;&#x000D;&#x000A;%&#x0009;   &#x000D;&#x000A;%&#x0009;   if Ele &gt;= (Ele_end-1e-3) * pi / 180&#x000D;&#x000A;%&#x0009;      Ele = Ele_start * pi / 180;&#x000D;&#x000A;%&#x0009;   else&#x000D;&#x000A;%&#x0009;      Ele = Ele + BeamStep_Ele * pi / 180;&#x000D;&#x000A;%&#x0009;   end&#x000D;&#x000A;%&#x0009;   &#x000D;&#x000A;%&#x0009;else&#x000D;&#x000A;%&#x0009;   Azi = Azi + BeamStep_Azi * pi / 180;&#x000D;&#x000A;%&#x0009;end&#x000D;&#x000A;%&#x0009;&#x000D;&#x000A;%&#x0009;&#x000D;&#x000A;%&#x0009;   &#x000D;&#x000A;%&#x0009;&#x000D;&#x000A;%&#x0009;&#x000D;&#x000A;%end&#x000D;&#x000A;%&#x000D;&#x000A;%Azi_out = Azi;&#x000D;&#x000A;%Ele_out = Ele;&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;</DataEntry>
