<Item XName="Equation_PD" UserName="Equation_PD" Type="Equation">
<AutoCalc><T>Bool</T><D>0</D></AutoCalc>
<Selected><T>Bool</T><D>0</D></Selected>
<Text>&#x000D;&#x000A;using(&apos;Design1 Analysis2_Design2_Data&apos;);&#x000D;&#x000A;&#x000D;&#x000A;echo = S7.&apos;;&#x000D;&#x000A;&#x000D;&#x000A;c = 3.0e8;&#x000D;&#x000A;lamda = c/fc;&#x000D;&#x000A;&#x000D;&#x000A;PRI_Sample_Num = PRI * fs;&#x000D;&#x000A;&#x000D;&#x000A;wavelength = 3e8 / 10e9;&#x000D;&#x000A;PRF = 1 / PRI;&#x000D;&#x000A;&#x000D;&#x000A;BeamStep = 1.2 * 0.886 * 1 /(0.5 * numx) * 180/pi;%1.2 stands for taylor weigts broaden the beamwidth&#x000D;&#x000A;BeamNum = floor((AngleEnd - AngleStart)/BeamStep) + 1;&#x000D;&#x000A;&#x000D;&#x000A;Beamdata = reshape(echo,PRI_Sample_Num*CPI_Num,BeamNum);&#x000D;&#x000A;&#x000D;&#x000A;echo_mat_fft = zeros(PRI_Sample_Num,CPI_Num);&#x000D;&#x000A;&#x000D;&#x000A;range = [0:PRI_Sample_Num-1] / fs * 150e6;&#x000D;&#x000A;velocity = ([-CPI_Num/2 + 0.5: 1 :CPI_Num/2-0.5]) / CPI_Num * PRF * wavelength/2 ;&#x000D;&#x000A;&#x000D;&#x000A;threshold = 1e5;% SLB threshold sidelobe blanking if radar phase array model is 1e-7&#x000D;&#x000A;target_num = 3;&#x000D;&#x000A;&#x000D;&#x000A;target_x = zeros(1,target_num);&#x000D;&#x000A;target_y = zeros(1,target_num); &#x000D;&#x000A;target_z = zeros(1,target_num);&#x000D;&#x000A;target_Azi = zeros(1,target_num);&#x000D;&#x000A;ii = 1;&#x000D;&#x000A;k_factor_inverse = 64*pi^1.5*c / lamda/2/fs;&#x000D;&#x000A;&#x000D;&#x000A;for i = 1:BeamNum&#x000D;&#x000A;&#x000D;&#x000A;    echo_mat = reshape(Beamdata(:,i), PRI_Sample_Num,CPI_Num);&#x000D;&#x000A;    &#x0009;&#x000D;&#x000A;    for n = 1 : PRI_Sample_Num&#x000D;&#x000A;        echo_mat(n,:) = echo_mat(n,:) * n^2 * k_factor_inverse;&#x000D;&#x000A;&#x0009;    echo_mat_fft(n,:) = abs(fftshift(fft(echo_mat(n,:))));&#x000D;&#x000A;    end&#x000D;&#x000A;&#x0009;    &#x000D;&#x000A;&#x0009;graph = graph_figure(num2str(i));&#x000D;&#x000A;&#x0009;graph.clear_data();&#x000D;&#x000A;&#x0009;graph.add_surface_data(velocity,range,echo_mat_fft);&#x000D;&#x000A;&#x0009;graph.set_label_x(&apos;Velocity-m/s&apos;);&#x000D;&#x000A;    graph.set_label_y(&apos;Range-m&apos;);&#x000D;&#x000A;    graph.set_label_z(&apos;Amplitude&apos;);&#x000D;&#x000A;&#x0009;&#x000D;&#x000A;&#x0009;pks = graph.get_all_peaks();&#x000D;&#x000A;&#x0009;peak = pks.indices;&#x000D;&#x000A;&#x0009;max = echo_mat_fft(peak(1),peak(2));&#x000D;&#x000A;&#x0009;if max &gt; threshold&#x000D;&#x000A;&#x0009;   &#x000D;&#x000A;&#x0009;   target_Azi = AngleStart + (i-1) * BeamStep;&#x000D;&#x000A;&#x0009;   range_0 = double(peak(1)) / fs * c / 2;  &#x000D;&#x000A;&#x0009;   target_x(ii) = range_0 * sind(target_Azi);&#x000D;&#x000A;&#x0009;   target_z(ii) = range_0 * cosd(target_Azi);&#x0009;   &#x000D;&#x000A;&#x0009;   ii = ii + 1;&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;target1_xyz_true = [0 0 900];&#x000D;&#x000A;target2_xyz_true = [-5.03e3 0 6e3];&#x000D;&#x000A;target3_xyz_true = [6.35e3 0 11e3];&#x000D;&#x000A;&#x000D;&#x000A;target_x_true = [target1_xyz_true(1) target2_xyz_true(1) target3_xyz_true(1) 0];&#x000D;&#x000A;target_y_true = [target1_xyz_true(2) target2_xyz_true(2) target3_xyz_true(2) 0];&#x000D;&#x000A;target_z_true = [target1_xyz_true(3) target2_xyz_true(3) target3_xyz_true(3) 0];&#x000D;&#x000A;&#x000D;&#x000A;target_x_0 = [target_x 0];&#x000D;&#x000A;target_y_0 = [target_y 0];&#x000D;&#x000A;target_z_0 = [target_z 0];&#x000D;&#x000A;&#x000D;&#x000A;graph1 = graph_figure(&apos;Target measurement space distribution&apos;);&#x000D;&#x000A;graph1.add_scatter_data(target_x_0, target_y_0, target_z_0);&#x000D;&#x000A;&#x000D;&#x000A;graph2 = graph_figure(&apos;Target true space distribution&apos;);&#x000D;&#x000A;graph2.add_scatter_data(target_x_true, target_y_true, target_z_true);&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;%echo = PD_Out.&apos;;&#x000D;&#x000A;%BeamNum = 9;&#x000D;&#x000A;%&#x000D;&#x000A;%&#x000D;&#x000A;%&#x000D;&#x000A;%PRI = 100e-6;&#x000D;&#x000A;%fs = 4e6;&#x000D;&#x000A;%&#x000D;&#x000A;%PRI_Sample_Num = PRI * fs;&#x000D;&#x000A;%CPI_Num = 32;&#x000D;&#x000A;%&#x000D;&#x000A;%Beamdata = reshape(echo,PRI_Sample_Num*CPI_Num,BeamNum);&#x000D;&#x000A;%&#x000D;&#x000A;%wavelength = 3e8 / 10e9;&#x000D;&#x000A;%PRF = 1 / PRI;&#x000D;&#x000A;%&#x000D;&#x000A;%range = [0:PRI_Sample_Num-1] / fs * 150e6;&#x000D;&#x000A;%velocity = ([0:CPI_Num-1]) / CPI_Num * PRF * wavelength / 2;&#x000D;&#x000A;%threshold = 1e-7;&#x000D;&#x000A;%&#x000D;&#x000A;%&#x000D;&#x000A;%for i = 1:BeamNum&#x000D;&#x000A;%    &#x000D;&#x000A;%    PD_result_mat = reshape(Beamdata(:,i), PRI_Sample_Num,CPI_Num);&#x000D;&#x000A;%&#x0009;graph = graph_figure(num2str(i));&#x000D;&#x000A;%&#x0009;graph.clear_data();&#x000D;&#x000A;%&#x0009;graph.add_surface_data(abs(PD_result_mat));&#x000D;&#x000A;%&#x0009;graph.set_label_x(&apos;Doppler&apos;);&#x000D;&#x000A;%    graph.set_label_y(&apos;Range&apos;);&#x000D;&#x000A;%    graph.set_label_z(&apos;Amplitude&apos;);&#x000D;&#x000A;%&#x000D;&#x000A;%end&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;</Text>
<UnitUse><T>Int</T><D>2</D></UnitUse>
