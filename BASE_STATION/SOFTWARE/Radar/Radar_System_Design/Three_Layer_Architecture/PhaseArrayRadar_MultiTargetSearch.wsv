<DVport><T>Array_Dbl64</T><D>1;4;;;Rt14;Y14</D></DVport>
<PVPort><T>Array_Dbl64</T><D>1;4;;;JbALgKRLq24;248GW01FV24</D></PVPort>
<Show><T>Bool</T><D>0</D></Show>
<ShowCmd><T>Int</T><D>1</D></ShowCmd>
<Split><T>Double</T><D>0.3341836734693878</D></Split>
<Split2><T>Double</T><D>0.209106239460371</D></Split2>
<Window><T>Array_I64</T><D>1;4;z7;85;zB;k7</D></Window>
