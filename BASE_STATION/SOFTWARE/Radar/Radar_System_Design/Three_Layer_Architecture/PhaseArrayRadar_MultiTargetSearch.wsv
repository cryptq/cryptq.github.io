<Item XName="Equations" Type="Equation">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>&#x000D;&#x000A;&#x000D;&#x000A;target1_xyz = [0 0 900];&#x000D;&#x000A;target2_xyz = [-5.03e3 0 6e3];&#x000D;&#x000A;target3_xyz = [6.35e3 0 11e3];&#x000D;&#x000A;&#x000D;&#x000A;num=numx*numy;&#x000D;&#x000A;&#x000D;&#x000A;c = 3e8;&#x000D;&#x000A;lamda = c/fc;&#x000D;&#x000A;&#x000D;&#x000A;BeamStep = 1.2 * 0.886 * 1 /(0.5 * numx) * 180/pi;%1.2 stands for taylor weigts broaden the beamwidth&#x000D;&#x000A;&#x000D;&#x000A;BeamNum = floor((AngleEnd - AngleStart)/BeamStep) + 1;</Text>
<UnitUse><T>Int</T><D>2</D></UnitUse>
