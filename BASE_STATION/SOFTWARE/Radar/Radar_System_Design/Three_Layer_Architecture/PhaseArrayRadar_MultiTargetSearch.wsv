<Selected><T>Bool</T><D>1</D></Selected>
<Text>&lt;DIV style=&quot;BORDER-TOP: medium none; BORDER-RIGHT: medium none; BORDER-BOTTOM: windowtext 1pt solid; PADDING-BOTTOM: 1pt; PADDING-TOP: 0in; PADDING-LEFT: 0in; BORDER-LEFT: medium none; PADDING-RIGHT: 0in; mso-element: para-border-div; mso-border-bottom-alt: solid windowtext .75pt&quot;&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;BORDER-TOP: medium none; BORDER-RIGHT: medium none; BORDER-BOTTOM: medium none; PADDING-BOTTOM: 0in; TEXT-ALIGN: center; PADDING-TOP: 0in; PADDING-LEFT: 0in; MARGIN: 0in 0in 0pt; BORDER-LEFT: medium none; LINE-HEIGHT: normal; PADDING-RIGHT: 0in; mso-border-bottom-alt: solid windowtext .75pt; mso-padding-alt: 0in 0in 1.0pt 0in&quot; align=center&gt;&lt;B&gt;&lt;SPAN style=&apos;FONT-SIZE: 18pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif; mso-fareast-font-family: &quot;Times New Roman&quot;&apos;&gt;Simulation Template for Multi-Target Search Phase Array Radar Framework&lt;/SPAN&gt;&lt;/B&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif; mso-fareast-font-family: &quot;Times New Roman&quot;&apos;&gt;&lt;?xml:namespace prefix = &quot;o&quot; ns = &quot;urn:schemas-microsoft-com:office:office&quot; /&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&lt;/DIV&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: center; MARGIN: 0in 0in 0pt; LINE-HEIGHT: normal&quot; align=center&gt;&lt;B&gt;&lt;SPAN style=&apos;FONT-SIZE: 10pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif; mso-fareast-font-family: &quot;Times New Roman&quot;; mso-bidi-font-size: 12.0pt&apos;&gt;Keysight Technologies SystemVue Example Workspace&lt;/SPAN&gt;&lt;/B&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif; mso-fareast-font-family: &quot;Times New Roman&quot;&apos;&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: center; MARGIN: 0in 0in 0pt; LINE-HEIGHT: normal&quot; align=center&gt;&lt;B&gt;&lt;SPAN style=&apos;FONT-SIZE: 10pt; FONT-FAMILY: &quot;Arial&quot;,sans-serif; mso-fareast-font-family: &quot;Times New Roman&quot;&apos;&gt;&amp;nbsp;&lt;/SPAN&gt;&lt;/B&gt;&lt;SPAN style=&apos;FONT-SIZE: 13.5pt; COLOR: black; mso-fareast-font-family: &quot;Times New Roman&quot;; mso-ascii-font-family: Calibri; mso-hansi-font-family: Calibri; mso-bidi-font-family: Calibri; mso-font-kerning: 12.0pt&apos;&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 10pt; LINE-HEIGHT: normal&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 13.5pt; COLOR: black; mso-fareast-font-family: &quot;Times New Roman&quot;; mso-ascii-font-family: Calibri; mso-hansi-font-family: Calibri; mso-bidi-font-family: Calibri; mso-font-kerning: 12.0pt&apos;&gt;&lt;FONT face=Calibri&gt;************************************************&lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 10pt; LINE-HEIGHT: normal&quot;&gt;&lt;FONT face=Calibri&gt;&lt;B&gt;&lt;SPAN style=&apos;FONT-SIZE: 13.5pt; COLOR: black; mso-fareast-font-family: &quot;Times New Roman&quot;; mso-ascii-font-family: Calibri; mso-hansi-font-family: Calibri; mso-bidi-font-family: Calibri; mso-font-kerning: 12.0pt&apos;&gt;Simulation Task&lt;/SPAN&gt;&lt;/B&gt;&lt;SPAN style=&apos;FONT-SIZE: 13.5pt; COLOR: black; mso-fareast-font-family: &quot;Times New Roman&quot;; mso-ascii-font-family: Calibri; mso-hansi-font-family: Calibri; mso-bidi-font-family: Calibri; mso-font-kerning: 12.0pt&apos;&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 10pt; LINE-HEIGHT: normal&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 13.5pt; COLOR: black; mso-fareast-font-family: &quot;Times New Roman&quot;; mso-ascii-font-family: Calibri; mso-hansi-font-family: Calibri; mso-bidi-font-family: Calibri; mso-font-kerning: 12.0pt&apos;&gt;&lt;FONT face=Calibri&gt;************************************************&lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 10pt; LINE-HEIGHT: normal&quot;&gt;&lt;FONT face=Calibri&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; COLOR: black; mso-fareast-font-family: &quot;Times New Roman&quot;; mso-ascii-font-family: Calibri; mso-hansi-font-family: Calibri; mso-bidi-font-family: Calibri; mso-font-kerning: 12.0pt&apos;&gt;This workspace as a template shows how to set up the multi-target search in phase array radar system based on the generalized framework and how to solve the multi-target positon by PD signal processing.&lt;/SPAN&gt;&lt;SPAN style=&apos;FONT-SIZE: 13.5pt; COLOR: black; mso-fareast-font-family: &quot;Times New Roman&quot;; mso-ascii-font-family: Calibri; mso-hansi-font-family: Calibri; mso-bidi-font-family: Calibri; mso-font-kerning: 12.0pt&apos;&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 10pt; LINE-HEIGHT: normal&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 13.5pt; COLOR: black; mso-fareast-font-family: &quot;Times New Roman&quot;; mso-ascii-font-family: Calibri; mso-hansi-font-family: Calibri; mso-bidi-font-family: Calibri; mso-font-kerning: 12.0pt&apos;&gt;&lt;FONT face=Calibri&gt;************************************************&lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 10pt; LINE-HEIGHT: normal&quot;&gt;&lt;B&gt;&lt;SPAN style=&apos;FONT-SIZE: 13.5pt; COLOR: black; mso-fareast-font-family: &quot;Times New Roman&quot;; mso-ascii-font-family: Calibri; mso-hansi-font-family: Calibri; mso-bidi-font-family: Calibri; mso-font-kerning: 12.0pt&apos;&gt;&lt;FONT face=Calibri&gt;Workspace Description&lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/B&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 10pt; LINE-HEIGHT: normal&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 13.5pt; COLOR: black; mso-fareast-font-family: &quot;Times New Roman&quot;; mso-ascii-font-family: Calibri; mso-hansi-font-family: Calibri; mso-bidi-font-family: Calibri; mso-font-kerning: 12.0pt&apos;&gt;&lt;FONT face=Calibri&gt;************************************************&lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 10pt; LINE-HEIGHT: normal&quot;&gt;&lt;FONT face=Calibri&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; mso-fareast-font-family: &quot;Times New Roman&quot;; mso-ascii-font-family: Calibri; mso-hansi-font-family: Calibri; mso-bidi-font-family: Calibri&apos;&gt;This workspace as a template shows how to set up multi-target radar search mode simulation based on phase array radar system.&lt;/SPAN&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Times New Roman&quot;,serif; mso-fareast-font-family: &quot;Times New Roman&quot;&apos;&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 10pt; LINE-HEIGHT: normal&quot;&gt;&lt;FONT face=Calibri&gt;&lt;SPAN style=&quot;FONT-SIZE: 12pt; mso-fareast-font-family: Symbol; mso-ascii-font-family: Calibri; mso-hansi-font-family: Calibri; mso-bidi-font-family: Calibri&quot;&gt;The example includes three layers: trajectory layer, antenna layer&amp;nbsp;and signal layer. &lt;/SPAN&gt;&lt;SPAN style=&apos;FONT-SIZE: 7pt; FONT-FAMILY: &quot;Times New Roman&quot;,serif; mso-fareast-font-family: Symbol&apos;&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 10pt; LINE-HEIGHT: normal&quot;&gt;&lt;FONT face=Calibri&gt;&lt;SPAN style=&quot;FONT-SIZE: 12pt; mso-fareast-font-family: Symbol; mso-ascii-font-family: Calibri; mso-hansi-font-family: Calibri; mso-bidi-font-family: Calibri&quot;&gt;In the trajectory layer, the RADAR_Platform model and RADAR_TargetScatterLocation model are used to generate the trajectories of transmitter, receiver, and scatters of target. The output is at the SimpleXYZ_frame(x, y, z). &lt;/SPAN&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Times New Roman&quot;,serif; mso-fareast-font-family: Symbol&apos;&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 10pt; LINE-HEIGHT: normal&quot;&gt;&lt;FONT face=Calibri&gt;&lt;SPAN style=&quot;FONT-SIZE: 12pt; mso-fareast-font-family: Symbol; mso-ascii-font-family: Calibri; mso-hansi-font-family: Calibri; mso-bidi-font-family: Calibri&quot;&gt;In antenna layer, the transmit antenna gains and the receive antenna gains to the scatters of targets can be computed according to the locations of transmit platforms and receive platforms and scatters of targets. The locations are at the SimpleXYZ_frame.&lt;/SPAN&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Times New Roman&quot;,serif; mso-fareast-font-family: Symbol&apos;&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 10pt; LINE-HEIGHT: normal&quot;&gt;&lt;FONT face=Calibri&gt;&lt;SPAN style=&quot;FONT-SIZE: 12pt; mso-fareast-font-family: Symbol; mso-ascii-font-family: Calibri; mso-hansi-font-family: Calibri; mso-bidi-font-family: Calibri&quot;&gt;In the signal layer, the input signal will be changed to the echoes from different scatters of targets according to the locations at SimpleXYZ_frame at each sampling time and the antenna gains from antenna layer. &lt;/SPAN&gt;&lt;SPAN style=&apos;FONT-SIZE: 12pt; FONT-FAMILY: &quot;Times New Roman&quot;,serif; mso-fareast-font-family: Symbol&apos;&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 10pt; LINE-HEIGHT: normal&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 12pt; mso-fareast-font-family: Symbol; mso-ascii-font-family: Calibri; mso-hansi-font-family: Calibri; mso-bidi-font-family: Calibri&quot;&gt;&lt;FONT face=Calibri&gt;The workspace build up phase array radar 2D search mode, 2D means the radar could get target azimuth and range information. Because of the radar signal processing adopt PD processing, target velocity is obtained, too.&lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 10pt; LINE-HEIGHT: normal&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 12pt; mso-fareast-font-family: Symbol; mso-ascii-font-family: Calibri; mso-hansi-font-family: Calibri; mso-bidi-font-family: Calibri&quot;&gt;&lt;FONT face=Calibri&gt;In the signal layer, the matlab script is the beam control, the beam control generates the beam pointing angle based on the detection area and beam width. The beam weights model generates the array weighted coefficients then control the beam rotation. Very beam has some dwell time, the transmitting antenna transmits pulse train, the receiving antenna receives pulse train and do PD processing, the next dell time, the beam switch next position and do the same signal processing. If the detection area needs N beams to cover, the workspace will generate N Range -Doppler spectrum graph.&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 10pt; LINE-HEIGHT: normal&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 12pt; mso-fareast-font-family: Symbol; mso-ascii-font-family: Calibri; mso-hansi-font-family: Calibri; mso-bidi-font-family: Calibri&quot;&gt;&lt;FONT face=Calibri&gt;&lt;SPAN style=&quot;FONT-SIZE: 12pt; mso-fareast-font-family: Symbol; mso-ascii-font-family: Calibri; mso-hansi-font-family: Calibri; mso-bidi-font-family: Calibri&quot;&gt;&lt;o:p&gt;&lt;SPAN style=&apos;FONT-SIZE: 13.5pt; COLOR: black; mso-fareast-font-family: &quot;Times New Roman&quot;; mso-ascii-font-family: Calibri; mso-hansi-font-family: Calibri; mso-bidi-font-family: Calibri; mso-font-kerning: 12.0pt&apos;&gt;&lt;FONT face=Calibri&gt;************************************************&lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 10pt; LINE-HEIGHT: normal&quot;&gt;&lt;B&gt;&lt;SPAN style=&apos;FONT-SIZE: 13.5pt; COLOR: black; mso-fareast-font-family: &quot;Times New Roman&quot;; mso-ascii-font-family: Calibri; mso-hansi-font-family: Calibri; mso-bidi-font-family: Calibri; mso-font-kerning: 12.0pt&apos;&gt;&lt;FONT face=Calibri&gt;Note&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/B&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 10pt; LINE-HEIGHT: normal&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 13.5pt; COLOR: black; mso-fareast-font-family: &quot;Times New Roman&quot;; mso-ascii-font-family: Calibri; mso-hansi-font-family: Calibri; mso-bidi-font-family: Calibri; mso-font-kerning: 12.0pt&apos;&gt;&lt;FONT face=Calibri&gt;************************************************&lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 10pt; LINE-HEIGHT: normal&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 12pt; mso-fareast-font-family: Symbol; mso-ascii-font-family: Calibri; mso-hansi-font-family: Calibri; mso-bidi-font-family: Calibri&quot;&gt;&lt;FONT face=Calibri&gt;The workspace is about the 2D radar, only scan in the azimuth, which is used for early warning. So the target position coordinate should specify as&amp;nbsp;[x, 0, z]. Otherwise, the measurement result is not match the target parameter setting.&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 10pt; LINE-HEIGHT: normal&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 12pt; mso-fareast-font-family: Symbol; mso-ascii-font-family: Calibri; mso-hansi-font-family: Calibri; mso-bidi-font-family: Calibri&quot;&gt;&lt;FONT face=Calibri&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&amp;nbsp;&lt;/P&gt;&lt;SPAN style=&quot;FONT-SIZE: 12pt; mso-fareast-font-family: Symbol; mso-ascii-font-family: Calibri; mso-hansi-font-family: Calibri; mso-bidi-font-family: Calibri&quot;&gt;&lt;FONT face=Calibri&gt;&lt;/FONT&gt;&lt;o:p&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 10pt; LINE-HEIGHT: normal&quot;&gt;&lt;SPAN style=&apos;FONT-SIZE: 13.5pt; COLOR: black; mso-fareast-font-family: &quot;Times New Roman&quot;; mso-ascii-font-family: Calibri; mso-hansi-font-family: Calibri; mso-bidi-font-family: Calibri; mso-font-kerning: 12.0pt&apos;&gt;&lt;FONT face=Calibri&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&amp;nbsp;&lt;/P&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 10pt; LINE-HEIGHT: normal&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 12pt; mso-fareast-font-family: Symbol; mso-ascii-font-family: Calibri; mso-hansi-font-family: Calibri; mso-bidi-font-family: Calibri&quot;&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&amp;nbsp;&lt;/P&gt;</Text>
