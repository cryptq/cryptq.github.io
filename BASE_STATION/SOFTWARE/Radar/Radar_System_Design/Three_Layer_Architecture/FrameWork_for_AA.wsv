<Item XName="Equation_PD" UserName="Equation_PD" Type="Equation">
<AutoCalc><T>Bool</T><D>1</D></AutoCalc>
<Selected><T>Bool</T><D>0</D></Selected>
<Text>using(&apos;Design1 Analysis2_Design2_Data&apos;);&#x000D;&#x000A;&#x000D;&#x000A;echo = PC_data;&#x000D;&#x000A;&#x000D;&#x000A;echo_re = real(echo);&#x000D;&#x000A;echo_im = imag(echo);&#x000D;&#x000A;DR = R18_Pd*100;&#x000D;&#x000A;PRI = 200e-6;&#x000D;&#x000A;fs = 4e6;&#x000D;&#x000A;C=3e8; % velocity of Light&#x000D;&#x000A;Fcarrier = 2e9; &#x000D;&#x000A;range_max=C*PRI/2;&#x0009;&#x000D;&#x000A;fd_max=1/PRI/2;&#x0009;&#x000D;&#x000A;&#x000D;&#x000A;PRI_Sample_Num = PRI * fs;&#x000D;&#x000A;CPI_Num = 32;&#x000D;&#x000A;&#x000D;&#x000A;PC_result_re = real(PC_data); &#x0009;% PC_data is the sink at the output of Radar_Pulsecompression&#x000D;&#x000A;PC_result_im = imag(PC_data);&#x000D;&#x000A;PD_Result_re = real(PD_Out);&#x000D;&#x000A;PD_Result_im = imag(PD_Out);&#x000D;&#x000A;&#x000D;&#x000A;% pattern = S7(:)&apos;;&#x000D;&#x000A;&#x000D;&#x000A;wavelength = 3e8 / Fcarrier;&#x000D;&#x000A;PRF = 1 / PRI;&#x000D;&#x000A;&#x000D;&#x000A;echo_cplx = echo_re + j * echo_im;&#x000D;&#x000A;&#x000D;&#x000A;echo_mat = reshape(echo_cplx, PRI_Sample_Num, CPI_Num);&#x000D;&#x000A;&#x000D;&#x000A;echo_mat_fft = zeros(PRI_Sample_Num, CPI_Num);&#x000D;&#x000A;&#x000D;&#x000A;for n = 1 : PRI_Sample_Num&#x000D;&#x000A;&#x0009;echo_mat_fft(n,:) = fft(echo_mat(n, :));&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;% figure(1)&#x000D;&#x000A;range = [0:PRI_Sample_Num-1] / fs * 150e6;&#x000D;&#x000A;velocity = ([0:CPI_Num-1]) / CPI_Num * PRF * wavelength / 2;&#x000D;&#x000A;g_echo=graph_figure(&apos;echo_mat_fft&apos;);&#x000D;&#x000A;[xx,yy]=meshgrid(velocity,range);&#x000D;&#x000A;g_echo.add_surface_data(xx,yy,abs(echo_mat_fft));&#x000D;&#x000A;g_echo.set_label_y(&apos;Range&apos;);&#x000D;&#x000A;g_echo.set_label_x(&apos;Velocity&apos;);&#x000D;&#x000A;g_echo.set_label_z(&apos;Power&apos;);&#x000D;&#x000A;&#x000D;&#x000A;PD_result_cplx = PD_Result_re + j * PD_Result_im;&#x000D;&#x000A;PD_result_mat = reshape(PD_result_cplx, PRI_Sample_Num, CPI_Num);&#x000D;&#x000A;&#x000D;&#x000A;% figure(2)&#x000D;&#x000A;range = [0:PRI_Sample_Num-1] / fs * 150e6;&#x000D;&#x000A;velocity = ([0:CPI_Num-1]) / CPI_Num * PRF * wavelength / 2;&#x000D;&#x000A;g_echo=graph_figure(&apos;PD_result_mat&apos;);&#x000D;&#x000A;[xx,yy]=meshgrid(velocity,range);&#x000D;&#x000A;g_echo.add_surface_data(xx,yy,abs(PD_result_mat));&#x000D;&#x000A;g_echo.set_label_y(&apos;Range&apos;);&#x000D;&#x000A;g_echo.set_label_x(&apos;Velocity&apos;);&#x000D;&#x000A;g_echo.set_label_z(&apos;Power&apos;);&#x000D;&#x000A;&#x000D;&#x000A;PC_result_cplx = PC_result_re + j * PC_result_im;&#x000D;&#x000A;PC_result_mat = reshape(PC_result_cplx, PRI_Sample_Num, CPI_Num);&#x000D;&#x000A;PC_result_mat_fft = zeros(PRI_Sample_Num, CPI_Num);&#x000D;&#x000A;for n = 1 : PRI_Sample_Num&#x000D;&#x000A;&#x0009;PC_result_mat_fft(n,:) = fft(PC_result_mat(n, :));&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;[r1,d1] = find(PC_result_mat_fft==max(max(PC_result_mat_fft)));&#x000D;&#x000A;r1=r1-1;&#x000D;&#x000A;range_before = r1/PRI_Sample_Num*range_max; % range calculation after signal processor&#x000D;&#x000A;d1=d1-1;&#x000D;&#x000A;dd1 = d1;&#x000D;&#x000A;if d1 &gt;=CPI_Num/2&#x000D;&#x000A;&#x0009;d1 = -(CPI_Num-d1);&#x000D;&#x000A;end&#x000D;&#x000A;fd1 = d1/(CPI_Num/2)*fd_max;&#x000D;&#x000A;if fd1 &gt;1/(2*PRI)&#x000D;&#x000A;&#x0009;velocity_before = C*fd1/2/Fcarrier - C/2/PRI/Fcarrier;&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;velocity_before = C*fd1/2/Fcarrier;&#x000D;&#x000A;end&#x000D;&#x000A;PD_result_cplx = PD_Result_re + j * PD_Result_im;&#x000D;&#x000A;PD_result_mat = reshape(PD_result_cplx, PRI_Sample_Num, CPI_Num);&#x000D;&#x000A;[r2,d2] = find(PD_result_mat==max(max(PD_result_mat)));&#x000D;&#x000A;r2=r2-1;&#x000D;&#x000A;range_after = r2/PRI_Sample_Num*range_max; % range calculation after signal processor&#x000D;&#x000A;d2=d2-1;&#x000D;&#x000A;dd2 = d2;&#x000D;&#x000A;if d2 &gt;=CPI_Num/2&#x000D;&#x000A;&#x0009;d2 = -(CPI_Num-d2);&#x000D;&#x000A;end&#x000D;&#x000A;fd2 = d2/(CPI_Num/2)*fd_max;&#x000D;&#x000A;if fd2 &gt;1/(2*PRI)&#x000D;&#x000A;&#x0009;velocity_after = C*fd2/2/Fcarrier - C/2/PRI/Fcarrier;&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;velocity_after = C*fd2/2/Fcarrier;&#x000D;&#x000A;end&#x000D;&#x000A;</Text>
<UnitUse><T>Int</T><D>2</D></UnitUse>
