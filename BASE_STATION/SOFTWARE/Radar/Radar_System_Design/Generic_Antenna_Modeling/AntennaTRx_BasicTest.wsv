<Item XName="Equation0_SimParams" UserName="Equation0_SimParams" Type="Equation">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>%% This equation does parameter configuratons for Design4 schematic&#x000D;&#x000A;&#x000D;&#x000A;ThetaMax = 181;&#x000D;&#x000A;EleMax = ThetaMax;&#x000D;&#x000A;&#x000D;&#x000A;PhiMax = 361;&#x000D;&#x000A;AziMax = PhiMax;&#x000D;&#x000A;AngleMax = ThetaMax*PhiMax;&#x000D;&#x000A;&#x000D;&#x000A;</Text>
<Item XName="BPMgr" Type="BPMgr">
<BPLines><T>Empty</T></BPLines>
<BPStates><T>Empty</T></BPStates></Item>
<Item XName="EqnBlock" Type="EqnBlock">
<Lang><T>Int</T><D>1</D></Lang></Item>
<Item XName="Font" Type="Font">
<Name>Courier New</Name>
<Size><T>Double</T><D>125</D></Size></Item>
<Item XName="FunctionBlock" Type="FunctionBlock" />
<Item XName="Page" Type="PageMgr">
<Item XName="Display0" Type="EquationDisp">
<DVport><T>Array_Dbl64</T><D>1;4;;;YC24;Of14</D></DVport>
<PVPort><T>Array_Dbl64</T><D>1;4;;;OSXj5MFe}24;It3TFqJ8R24</D></PVPort>
<Show><T>Bool</T><D>0</D></Show>
<ShowCmd><T>Int</T><D>1</D></ShowCmd>
<Split><T>Double</T><D>0.3</D></Split>
<Split2><T>Double</T><D>0.3</D></Split2>
<Window><T>Array_I64</T><D>1;4;C{}}}}}}}}}};t;nC;j4</D></Window>
<ZOrder><T>Int</T><D>9</D></ZOrder></Item></Item>
<Item XName="VarBlock" Type="VarBlock" /></Item>
<Item XName="Equation1_RecPattPlot_UV2" UserName="Equation1_RecPattPlot_UV2" Type="Equation">
<AutoCalc><T>Bool</T><D>0</D></AutoCalc>
<Selected><T>Bool</T><D>0</D></Selected>
<Text>using(&apos;DF4_Design4_Data&apos;);&#x000D;&#x000A;&#x000D;&#x000A;%% Obtain Pattern Data from Simulation Dataset&#x000D;&#x000A;pattern_re = real(Pattern_AntTx);&#x000D;&#x000A;pattern_im = imag(Pattern_AntTx);&#x000D;&#x000A;&#x000D;&#x000A;% pattern_re = real(Pattern_AntRx);&#x000D;&#x000A;% pattern_im = imag(Pattern_AntRx);&#x000D;&#x000A;&#x000D;&#x000A;pattern = pattern_re + j * pattern_im;&#x000D;&#x000A;%% reshape pattern to specific size&#x000D;&#x000A;pattern_mat = reshape(pattern, EleMax, AziMax);&#x000D;&#x000A;pattern_abs = abs(pattern_mat)&apos;;&#x000D;&#x000A;&#x000D;&#x000A;%% elevation and azimuth angle range in degrees&#x000D;&#x000A;elv = [0 : EleMax - 1]; %[0:179] For UV Plot, Elevation Angle Range is [-90:89]&#x000D;&#x000A;azm = [0 : AziMax - 1];&#x000D;&#x000A;&#x000D;&#x000A;%% plot circular Scan pattern&#x000D;&#x000A;[T P] = meshgrid(elv, azm);&#x000D;&#x000A;&#x000D;&#x000A;%% manually convert to cartesian coordinates&#x000D;&#x000A;u = sin(T/180*pi) .* cos(P/180*pi);&#x000D;&#x000A;v = sin(T/180*pi) .* sin(P/180*pi);&#x000D;&#x000A;w = cos(T/180*pi);&#x000D;&#x000A;&#x000D;&#x000A;Pattern_figure = graph_figure(&apos;AntPatt_AntTx_TarScan_UV_Lin&apos;);&#x000D;&#x000A;Pattern_figure.add_mesh_data(u,v,pattern_abs);&#x000D;&#x000A;Pattern_figure.set_label_x(&apos;horizontal&apos;);&#x000D;&#x000A;Pattern_figure.set_label_y(&apos;vertical&apos;);&#x000D;&#x000A;Pattern_figure.set_label_z(&apos;amplitude&apos;);&#x000D;&#x000A;&#x000D;&#x000A;%% reduce workspace size by clearing temporary variables&#x000D;&#x000A;clear u v w T P pattern_re pattern_im </Text>
<UnitUse><T>Int</T><D>2</D></UnitUse>
<Item XName="BPMgr" Type="BPMgr">
<BPLines><T>Empty</T></BPLines>
<BPStates><T>Empty</T></BPStates></Item>
<Item XName="EqnBlock" Type="EqnBlock">
<Lang><T>Int</T><D>1</D></Lang>
<UsingContext>Design1_Data;Design1_Data2;DF4_Design4_Data;</UsingContext></Item>
<Item XName="Font" Type="Font">
<Name>Courier New</Name>
<Size><T>Double</T><D>125</D></Size></Item>
<Item XName="FunctionBlock" Type="FunctionBlock" />
<Item XName="Page" Type="PageMgr">
<Item XName="Display0" Type="EquationDisp">
<DVport><T>Array_Dbl64</T><D>1;4;;;E224;qo14</D></DVport>
<PVPort><T>Array_Dbl64</T><D>1;4;;;F8xWiZbCq24;M2Q9ebjsa24</D></PVPort>
<Show><T>Bool</T><D>0</D></Show>
<ShowCmd><T>Int</T><D>1</D></ShowCmd>
<Split><T>Double</T><D>0.3</D></Split>
<Split2><T>Double</T><D>0.1664374140302614</D></Split2>
<Window><T>Array_I64</T><D>1;4;q1;I2;FB;g7</D></Window>
<ZOrder><T>Int</T><D>8</D></ZOrder></Item></Item>
<Item XName="VarBlock" Type="VarBlock" /></Item>
<Item XName="Equation2_SpherPattPlot2" UserName="Equation2_SpherPattPlot2" Type="Equation">
<AutoCalc><T>Bool</T><D>0</D></AutoCalc>
<Selected><T>Bool</T><D>0</D></Selected>
<Text>using(&apos;DF4_Design4_Data&apos;);&#x000D;&#x000A;%%Select output pattern scale mode: 0 for dB, 1 for linear&#x000D;&#x000A;PatternScale = 1;&#x000D;&#x000A;&#x000D;&#x000A;switch (PatternScale)&#x000D;&#x000A;&#x0009;case (0)&#x000D;&#x000A;&#x0009;&#x0009;pattern = 20*log10(abs(pattern_mat));&#x000D;&#x000A;&#x0009;&#x0009;FigName = &apos;AntPatt_AntTx_TarScan_SphereView_dB&apos;;&#x000D;&#x000A;&#x0009;case (1)&#x000D;&#x000A;&#x0009;&#x0009;pattern = abs(pattern_mat)&#x000D;&#x000A;&#x0009;&#x0009;FigName = &apos;AntPatt_AntTx_TarScan_SphereView_Lin&apos;; &#x000D;&#x000A;&#x0009;otherwise&#x000D;&#x000A;&#x0009;&#x0009;error (&apos;PatternScale Output Format Setting is WRONG!&apos;)&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%&#x000D;&#x000A;%% Plot the Spherical Coordinate View-Using Dataset Data Directly (Misses one angle in final figures;)&#x000D;&#x000A;% Pattern_figure = graph_figure(&apos;AntPatt_AntTx_TarScan_SphView_1&apos;);&#x000D;&#x000A;% Pattern_figure.add_spherical_data(pattern,&apos;Amplitude&apos;); % % abs(pattern_mat)&#x000D;&#x000A;&#x000D;&#x000A;%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%&#x000D;&#x000A;%% Plot the Spherical Coordinate View-Realign Azimuth and Elevation&#x000D;&#x000A;Pattern_figure = graph_figure(FigName); &#x000D;&#x000A;[azm,elv]      = meshgrid( (0:PhiMax-1)*pi/180,(0:ThetaMax-1)*pi/180 ); % For UV Plot, Elevation Angle Range is [0:179]&#x000D;&#x000A;&#x000D;&#x000A;Pattern_figure.add_spherical_data(azm,elv,pattern,&apos;Amplitude&apos;); % abs(pattern_mat)&#x000D;&#x000A;%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%&#x000D;&#x000A;&#x000D;&#x000A;%% reduce workspace size by clearing temporary variables&#x000D;&#x000A;clear azm elv pattern&#x000D;&#x000A;clear u v w T P pattern_re pattern_im</Text>
