<Item XName="PlotSphereView_PhaArrTx" UserName="PlotSphereView_PhaArrTx" Type="Equation">
<AutoCalc><T>Bool</T><D>0</D></AutoCalc>
<Selected><T>Bool</T><D>0</D></Selected>
<Text>%% This equation demonstrates the antenna pattern plotting (Spherical View) &#x000D;&#x000A;% (for Phased Array Antenna Tx, one element pattern imported)&#x000D;&#x000A;&#x000D;&#x000A;using(&apos;Design1 Analysis2_Design4_Data&apos;);&#x000D;&#x000A;&#x000D;&#x000A;%% Extract Data from Dataset&#x000D;&#x000A;Pattern_Value = abs(Pattern_PhasedArrTx);&#x000D;&#x000A;Pattern_mat = reshape(Pattern_Value, EleMax, AziMax);&#x000D;&#x000A;Pattern_mat = 20*log10(Pattern_mat); %% If you need to see dB, use this statement&#x000D;&#x000A;&#x000D;&#x000A;FigName = &apos;AntPatt_PhaArrAntTx_TarScan_SphereView_dB&apos;&#x000D;&#x000A;Pattern_figure = graph_figure(FigName); &#x000D;&#x000A;[azm,elv]      = meshgrid( (-(AziMax-1)/2 : (AziMax-1)/2)*pi/180,(0:ThetaMax-1)*pi/180 ); % Elevation Angle Range is [0:180]&#x000D;&#x000A;&#x000D;&#x000A;Pattern_figure.add_spherical_data(azm,elv,Pattern_mat,&apos;Amplitude&apos;); % abs(pattern_mat)&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;%% Another method to plot the SphereView Antenna Pattern&#x000D;&#x000A;&#x000D;&#x000A;%% For XY-plane, x axis is along the horizontal direction and y axis is along the vertical direct&#x000D;&#x000A;%theta = [0 : 180];&#x000D;&#x000A;%phi = [0 : 360];&#x000D;&#x000A;%[T P] = meshgrid(theta, phi);&#x000D;&#x000A;%u = sin(T/180*pi) .* cos(P/180*pi);&#x000D;&#x000A;%v = sin(T/180*pi) .* sin(P/180*pi);&#x000D;&#x000A;%w = cos(T/180*pi);&#x000D;&#x000A;&#x000D;&#x000A;%% The function cart2sph convert the data to the spherical coordinates using azimuth and elevation&#x000D;&#x000A;%% Please refer to Matlab cart2sph help doc&#x000D;&#x000A;%[Azm,Elv,Pattern_mat_re] = cart2sph(Pattern_mat.*u,Pattern_mat.*v,Pattern_mat.*w);&#x000D;&#x000A;&#x000D;&#x000A;%% Verify that our u,v,w do what we think they do.&#x000D;&#x000A;%assert(norm(Pattern_mat(:)-Pattern_mat_re(:))&lt;1e-9);&#x000D;&#x000A;&#x000D;&#x000A;%graph = graph_figure(&apos;OneEle_ArrPatt_PhasedArrTx_SphereView_Lin&apos;);&#x000D;&#x000A;%% The function add_spherical_data uses the phi and theta&#x000D;&#x000A;%% The phi equals to the azimuth used by cart2sph&#x000D;&#x000A;%% The theta equals to pi/2-elevation used by cart2sph&#x000D;&#x000A;%% Please refer to the Matlab Script add_spherical_data help doc&#x000D;&#x000A;%graph.clear_data();&#x000D;&#x000A;%graph.add_spherical_data(Azm, pi/2-Elv, Pattern_mat_re,&apos;surface2&apos;);&#x000D;&#x000A;%graph.set_title(&apos;OneEle_ArrPatt_PhasedArrTx_SphereView_Lin&apos;);&#x000D;&#x000A;%graph.set_colormap(&apos;arctic&apos;);</Text>
