<Item XName="Page" Type="PageMgr" />
<Item XName="Plot2DPattern_AntPolarTx_UV" UserName="Plot2DPattern_AntPolarTx_UV" Type="Equation">
<AutoCalc><T>Bool</T><D>0</D></AutoCalc>
<Selected><T>Bool</T><D>0</D></Selected>
<Text>%% This equation demonstrates the antenna pattern plotting (2D UV plannar view)&#x000D;&#x000A;% (for Antenna Polarization Tx, one element pattern imported)&#x000D;&#x000A;% If the user need to plot AntPolarRx, just change all the Tx to Rx inside this equation file.&#x000D;&#x000A;&#x000D;&#x000A;using(&apos;Design1 Analysis2_Design4_Data&apos;);&#x000D;&#x000A;&#x000D;&#x000A;Pattern_Value = abs(Pattern_AntPolarTx_H);&#x000D;&#x000A;Pattern_mat_H = reshape(Pattern_Value, EleMax, AziMax);&#x000D;&#x000A;% In UV Plotting, Pattern_mat needs to be 361*181: &#x000D;&#x000A;Pattern_mat_H = Pattern_mat_H&apos;;&#x000D;&#x000A;%20*log10(Pattern_mat_H&apos;); % Change to this statement if you need to see the dB plotting&#x000D;&#x000A;&#x000D;&#x000A;Pattern_Value = abs(Pattern_AntPolarTx_V);&#x000D;&#x000A;Pattern_mat_V = reshape(Pattern_Value, EleMax, AziMax);&#x000D;&#x000A;% In UV Plotting, Pattern_mat needs to be 361*181: &#x000D;&#x000A;Pattern_mat_V = Pattern_mat_V&apos;;&#x000D;&#x000A;%20*log10(Pattern_mat_V&apos;); % Change to this statement if you need to see the dB plotting&#x000D;&#x000A;&#x000D;&#x000A;Pattern_Value = abs(Pattern_AntPolarTx_HVComb);&#x000D;&#x000A;Pattern_mat_HVComb = reshape(Pattern_Value, EleMax, AziMax);&#x000D;&#x000A;% In UV Plotting, Pattern_mat needs to be 361*181: &#x000D;&#x000A;Pattern_mat_HVComb = Pattern_mat_HVComb&apos;;&#x000D;&#x000A;&#x000D;&#x000A;%% According to the antenna data format of EMpro and HFSS&#x000D;&#x000A;%% The range of theta is [0:pi]&#x000D;&#x000A;%% The range of phi is [0:2*pi]&#x000D;&#x000A;theta = [0 : ThetaMax-1];&#x000D;&#x000A;phi = [0 : PhiMax - 1]; %[0:360] for AntPolarTRx, offset -180 deg for PhaArrTx (This is different from AntPolarTx/Rx)&#x000D;&#x000A;[T P] = meshgrid(theta, phi);&#x000D;&#x000A;&#x000D;&#x000A;%% For XY-plane, x axis is along the horizontal direction and y axis is along the vertical direction&#x000D;&#x000A;u = sin(T/180*pi) .* cos(P/180*pi);&#x000D;&#x000A;v = sin(T/180*pi) .* sin(P/180*pi);&#x000D;&#x000A;w = cos(T/180*pi);&#x000D;&#x000A;&#x000D;&#x000A;%% H-Polarized Antenna Pattern Plotting&#x000D;&#x000A;graph = graph_figure(&apos;AntPatt_AntPolarTx_H_TarScan_UV_Lin&apos;);&#x000D;&#x000A;graph.clear_data();&#x000D;&#x000A;graph.add_surface_data(u,v, Pattern_mat_H,&apos;surface1&apos;);&#x000D;&#x000A;graph.set_title(&apos;AntPatt_AntPolarTx_H_TarScan_UV_Lin&apos;);&#x000D;&#x000A;graph.set_label_x(&apos;u_coord&apos;);&#x000D;&#x000A;graph.set_label_y(&apos;v_coord&apos;);&#x000D;&#x000A;&#x000D;&#x000A;%% V-Polarized Antenna Pattern Plotting&#x000D;&#x000A;graph = graph_figure(&apos;AntPatt_AntPolarTx_V_TarScan_UV_Lin&apos;);&#x000D;&#x000A;graph.clear_data();&#x000D;&#x000A;graph.add_surface_data(u,v, Pattern_mat_V,&apos;surface1&apos;);&#x000D;&#x000A;graph.set_title(&apos;AntPatt_AntPolarTx_V_TarScan_UV_dB&apos;);&#x000D;&#x000A;graph.set_label_x(&apos;u_coord&apos;);&#x000D;&#x000A;graph.set_label_y(&apos;v_coord&apos;);&#x000D;&#x000A;&#x000D;&#x000A;%% HV-Polarized Combined Antenna Pattern Plotting&#x000D;&#x000A;graph = graph_figure(&apos;AntPatt_AntPolarTx_HVComb_TarScan_UV_Lin&apos;);&#x000D;&#x000A;graph.clear_data();&#x000D;&#x000A;graph.add_surface_data(u,v, Pattern_mat_HVComb,&apos;surface1&apos;);&#x000D;&#x000A;graph.set_title(&apos;AntPatt_AntPolarTx_HVComb_TarScan_UV_dB&apos;);&#x000D;&#x000A;graph.set_label_x(&apos;u_coord&apos;);&#x000D;&#x000A;graph.set_label_y(&apos;v_coord&apos;);</Text>
