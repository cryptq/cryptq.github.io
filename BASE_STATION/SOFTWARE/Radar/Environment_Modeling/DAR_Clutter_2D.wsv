<Item XName="VarBlock" Type="VarBlock">
<Item XName="LogOutput" Type="Variable">
<ByAnalysis><T>Bool</T><D>1</D></ByAnalysis>
<Data>Data Flow Analysis : Design1 Analysis&#x000D;&#x000A;9/2/2016..9:47 AM&#x000D;&#x000A;Ambient Temperature[C]=27.000000&#x000D;&#x000A;Execution time: 0.722 sec&#x000D;&#x000A;</Data></Item></Item></Item>
<Item XName="Font" Type="Font">
<Size><T>Double</T><D>125</D></Size></Item></Item>
<Item XName="Equation" UserName="Equation" Type="Equation">
<AutoCalc><T>Bool</T><D>0</D></AutoCalc>
<Selected><T>Bool</T><D>1</D></Selected>
<Text>bb=double(getvariable(&apos;Design1_Data&apos;, &apos;S1&apos;));&#x000D;&#x000A;real_bb=real(bb);&#x000D;&#x000A;imag_bb=imag(bb);&#x000D;&#x000A;NumOfAntx = double(getvariable(&apos;Design1_Data&apos;, &apos;NumOfAntx&apos;));&#x000D;&#x000A;NumOfAnty = double(getvariable(&apos;Design1_Data&apos;, &apos;NumOfAnty&apos;));&#x000D;&#x000A;NumOfPulse = double(getvariable(&apos;Design1_Data&apos;, &apos;NumOfPulse&apos;));&#x000D;&#x000A;Phi = double(getvariable(&apos;Design1_Data&apos;, &apos;Phi&apos;));&#x000D;&#x000A;v = double(getvariable(&apos;Design1_Data&apos;, &apos;Vt&apos;));&#x000D;&#x000A;Tr = double(getvariable(&apos;Design1_Data&apos;, &apos;PRI&apos;));&#x000D;&#x000A;Fc = double(getvariable(&apos;Design1_Data&apos;, &apos;Fc&apos;));&#x000D;&#x000A;Nc = double(getvariable(&apos;Design1_Data&apos;, &apos;NumOfClutterPathes&apos;));&#x000D;&#x000A;WaveLen = 3e8/Fc;&#x000D;&#x000A;&#x000D;&#x000A;Dx=0.5;&#x000D;&#x000A;Dy=0.5;&#x000D;&#x000A;%Nc=180;&#x000D;&#x000A;N = NumOfAntx*NumOfAnty; % number of ant&#x000D;&#x000A;M = NumOfPulse; % number of PRI&#x000D;&#x000A;bbb=real_bb+j*imag_bb;&#x000D;&#x000A;bbb=reshape(bbb, N*M, N*M);&#x000D;&#x000A;R = bbb;&#x000D;&#x000A;%%% calculate aN, bM&#x000D;&#x000A;Theta = -pi/2;&#x000D;&#x000A;ThetaStep = pi/Nc;&#x000D;&#x000A;for temp_idx = 0:1:Nc-1&#x000D;&#x000A;   tempy = Dy * sin(Theta) * sin(Phi);&#x000D;&#x000A;   tempx = Dx * sin(Theta) * cos(Phi);  % x is the radar movement direction&#x000D;&#x000A;   a = zeros(N, 1);&#x000D;&#x000A;   for YIndex = 0:1:NumOfAnty-1   &#x000D;&#x000A;       for XIndex = 0:1:NumOfAntx-1       &#x000D;&#x000A;           Theta_Normal = YIndex * tempy + XIndex * tempx;&#x000D;&#x000A;           temp = 2 * pi * Theta_Normal;           &#x000D;&#x000A;           aN(XIndex + YIndex * NumOfAntx + 1, temp_idx+1) = cos(temp) + j*sin(temp);&#x000D;&#x000A;       end&#x000D;&#x000A;   end&#x000D;&#x000A;   &#x000D;&#x000A;   %% perform the Kronecker product kron(b,a)&#x000D;&#x000A;   fd_Normal = (2*v*Tr/WaveLen)*sin(Theta)*cos(Phi);&#x000D;&#x000A;   temp = 2 * pi * fd_Normal;&#x000D;&#x000A;&#x000D;&#x000A;   k = 0:1:M-1;   &#x000D;&#x000A;   b = exp(j*temp*k);   &#x000D;&#x000A;   b = b.&apos;;&#x000D;&#x000A;   bM(:,temp_idx+1)= b;&#x000D;&#x000A;   %%% add normalization&#x000D;&#x000A;   %a = a./ sqrt(N);&#x000D;&#x000A;   %b = b./ sqrt(M);   &#x000D;&#x000A;   %Phi_Theta_fd = kron(b,a);  %??????      &#x000D;&#x000A;   Theta = Theta + ThetaStep;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;R = R + eye(N * M, N * M)*1e-3;&#x000D;&#x000A;inv_R = inv(R);&#x000D;&#x000A;&#x000D;&#x000A;Theta_Normal = -0.5:1/Nc:0.5-1/Nc;&#x000D;&#x000A;fd_Normal = -0.5:1/Nc:0.5-1/Nc;&#x000D;&#x000A;for ii = 1 : length(Theta_Normal) &#x000D;&#x000A;    for jj = 1 : length(Theta_Normal) &#x000D;&#x000A;%             SS = kron(aN(:,ii),bM(:,jj)); &#x000D;&#x000A;            SS = kron(bM(:,jj), aN(:,ii)); &#x000D;&#x000A;            P_f(ii,jj) = SS&apos; * R * SS; &#x000D;&#x000A;            P_min_var(ii,jj) = 1 ./ (SS&apos; * inv_R * SS); &#x000D;&#x000A;    end &#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;corr_result = graph_figure(&apos;amplitude(abs) of Correlation Matrix&apos;);&#x000D;&#x000A;corr_result.add_mesh_data(abs(R));&#x000D;&#x000A;&#x000D;&#x000A;PSD_figure = graph_figure(&apos;Power spectrum density(dB)&apos;);&#x000D;&#x000A;PSD_figure.add_mesh_data(20*log10(abs(P_f)));</Text>
<UnitUse><T>Int</T><D>2</D></UnitUse>
