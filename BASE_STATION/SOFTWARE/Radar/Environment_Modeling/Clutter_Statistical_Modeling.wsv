<Item XName="Equations" Type="Equation">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>TStep = 1/SamplingRate;&#x000D;&#x000A;PRI_Num = floor(PRI*SamplingRate);&#x000D;&#x000A;Ratio = PRI_Num;&#x000D;&#x000A;&#x000D;&#x000A;Distance = 1000;%m&#x000D;&#x000A;c = 3e8;%m/s&#x000D;&#x000A;delay = 2*Distance/c;&#x000D;&#x000A;delaySample = floor(delay*SamplingRate+1)+1;&#x000D;&#x000A;&#x000D;&#x000A;PRF = 1/PRI;&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;</Text>
<UnitUse><T>Int</T><D>2</D></UnitUse>
