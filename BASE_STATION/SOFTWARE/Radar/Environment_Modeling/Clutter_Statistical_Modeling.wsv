<Item XName="Equations" Type="Equation">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>%% ---- Baseband Source Parameters&#x000D;&#x000A;BB_SamplingRate=40e6;&#x000D;&#x000A;f0=0;&#x000D;&#x000A;%% ---- Transmitter RF Parameters&#x000D;&#x000A;IF_Freq=Fi;&#x000D;&#x000A;RF_Freq=Fc;&#x000D;&#x000A;BB_UpSamplingRatio=2;&#x000D;&#x000A;IF_SamplingRate=BB_SamplingRate*BB_UpSamplingRatio;&#x000D;&#x000A;TStep=1/IF_SamplingRate;&#x000D;&#x000A;DAC_NBits=DAC_NBits;&#x000D;&#x000A;RF_Gain=50;&#x000D;&#x000A;IF_Gain=50;&#x000D;&#x000A;BB_SamplesPerPulse=PulseWidth*BB_SamplingRate;&#x000D;&#x000A;IF_SamplesPerPulse=PulseWidth*IF_SamplingRate;&#x000D;&#x000A;SamplesPerPRI = PRI*IF_SamplingRate;&#x000D;&#x000A;&#x000D;&#x000A;%% ---- Target Parameters&#x000D;&#x000A;DurationTime=PRI;&#x000D;&#x000A;IncludeProp=1;&#x000D;&#x000A;&#x000D;&#x000A;%% ---- Clutter Modeling Parameters&#x000D;&#x000A;c = 3e8;&#x000D;&#x000A;WaveLen = c/RF_Freq;&#x000D;&#x000A;&#x000D;&#x000A;if floor(IncludeProp)&lt;1&#x000D;&#x000A;&#x0009;PropEffect = 1;&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;PropEffect = 8*pi*sqrt(pi)*(Range_1^2)/WaveLen; %%Interested Target: Target-1, using Range_1 here.&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;Gain=RF_Gain*IF_Gain; %%Gain from Baseband to Clutter Input&#x000D;&#x000A;P_Lin=Gain^2/2/50/(PropEffect^2);&#x000D;&#x000A;P_dBm=10*log10(P_Lin)+30;&#x000D;&#x000A;&#x000D;&#x000A;CSR = -10; %Clutter to Signal Ratio (dB) which is set manually&#x000D;&#x000A;P_ClutterIn=Gain^2/2/50;&#x000D;&#x000A;P_ClutterIn_dBm=10*log10(P_ClutterIn)+30;&#x000D;&#x000A;P_ClutterOut_dBm=P_dBm+CSR;&#x000D;&#x000A;Pc_dB = P_ClutterOut_dBm - P_ClutterIn_dBm;&#x000D;&#x000A;Gain_Clutter = 10^(Pc_dB/20);&#x000D;&#x000A;% Pc_Lin = 10^(Pc_dB/1e-3);&#x000D;&#x000A;% Gain_Clutter=sqrt(Pc_Lin*2*50);</Text>
<UnitUse><T>Int</T><D>2</D></UnitUse>
