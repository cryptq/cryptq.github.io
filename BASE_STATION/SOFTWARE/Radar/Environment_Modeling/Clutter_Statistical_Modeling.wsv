<Item XName="Eqns" Type="Equation">
<Text>clutter = getvariable(&apos;Sweep1_Data&apos;,&apos;Clutter&apos;);&#x000D;&#x000A; x = abs(clutter(end*2/3+1:end));&#x000D;&#x000A; &#x000D;&#x000A; numBins = 100;&#x000D;&#x000A; minBin = 0;&#x000D;&#x000A; maxBin = 10;&#x000D;&#x000A; stepBin = (maxBin-minBin)/numBins;&#x000D;&#x000A; binRange = (minBin:stepBin:maxBin)&apos;;&#x000D;&#x000A; y = histc(x, binRange); %&#x000D;&#x000A; &#x000D;&#x000A; y= y./length(x); %normalization&#x000D;&#x000A; y = y/stepBin; %sample Number for each stepBin&#x000D;&#x000A; setindep(&apos;y&apos;,&apos;binRange&apos;);</Text>
