<Text>% PDF paramters&#x000D;&#x000A;using(&apos;Sweep1_Data&apos;);&#x000D;&#x000A;PRI = getvariable(&apos;Sweep1_Data&apos;, &apos;PRI&apos;); PRI=PRI(1);&#x000D;&#x000A;SamplingRate = getvariable(&apos;Sweep1_Data&apos;, &apos;SamplingRate&apos;);SamplingRate=SamplingRate(1);&#x000D;&#x000A;Variance = getvariable(&apos;Sweep1_Data&apos;, &apos;Variance&apos;);Variance=Variance(1);&#x000D;&#x000A;SizeFactor = getvariable(&apos;Sweep1_Data&apos;, &apos;SizeFactor&apos;);SizeFactor=SizeFactor(1);&#x000D;&#x000A;ShapeFactor = getvariable(&apos;Sweep1_Data&apos;, &apos;ShapeFactor&apos;);ShapeFactor=ShapeFactor(1);&#x000D;&#x000A;Order = getvariable(&apos;Sweep1_Data&apos;, &apos;Order&apos;);Order=Order(1);&#x000D;&#x000A;ExpIndex = getvariable(&apos;Sweep1_Data&apos;, &apos;ExpIndex&apos;);ExpIndex=ExpIndex(1);&#x000D;&#x000A;FilterLen = getvariable(&apos;Sweep1_Data&apos;, &apos;FilterLen&apos;);FilterLen(1);&#x000D;&#x000A;% PSD Parameters&#x000D;&#x000A;PSDVariance = getvariable(&apos;Sweep1_Data&apos;, &apos;PSDVariance&apos;);PSDVariance=PSDVariance(1);&#x000D;&#x000A;FreqCutoff = getvariable(&apos;Sweep1_Data&apos;, &apos;FreqCutoff&apos;);FreqCutoff=FreqCutoff(1);&#x000D;&#x000A;N = getvariable(&apos;Sweep1_Data&apos;, &apos;N&apos;);N=N(1);&#x000D;&#x000A;Fd = getvariable(&apos;Sweep1_Data&apos;, &apos;Fd&apos;);Fd=Fd(1);&#x000D;&#x000A;isCoherent = getvariable(&apos;Sweep1_Data&apos;, &apos;isCoherent&apos;);isCoherent=isCoherent(1);&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;%% to calculate PDF and PSD&#x000D;&#x000A;PRF = 1/PRI;&#x000D;&#x000A;fftSize = 1024;&#x000D;&#x000A;MinData = 0;&#x000D;&#x000A;MaxData = 10;&#x000D;&#x000A;NumBins = 100;&#x000D;&#x000A;Interval = (MaxData-MinData)/NumBins;&#x000D;&#x000A;&#x000D;&#x000A;x = (MinData:Interval:MaxData)&apos;;&#x000D;&#x000A;f = [-PRF/2 : PRF/fftSize : PRF/2 - PRF/fftSize];&#x000D;&#x000A;&#x000D;&#x000A;VA = sqrt(Variance);&#x000D;&#x000A;PDF_RayLeigh_Ref = (x/(VA^2)) .* exp( -((x/VA).^2) / 2);&#x000D;&#x000A;if(isCoherent)&#x000D;&#x000A;&#x0009;temp1 = sqrt(4*pi*log(ShapeFactor))*abs(x);&#x000D;&#x000A;&#x0009;temp2 = log(abs(x)./SizeFactor);&#x000D;&#x000A;&#x0009;temp3 = -1./(4*log(ShapeFactor))*temp2.^2; &#x000D;&#x000A;&#x0009;PDF_LogNormal_Ref = (1./temp1).*exp(temp3);&#x000D;&#x000A;&#x0009;&#x000D;&#x000A;&#x0009;temp1 = ShapeFactor.*log(2)./SizeFactor;&#x000D;&#x000A;&#x0009;temp2 = (x./SizeFactor).^(ShapeFactor-1);&#x000D;&#x000A;&#x0009;temp3 = log(2).*(x./SizeFactor).^ShapeFactor;&#x000D;&#x000A;&#x0009;PDF_Weibull_Ref = temp1.*temp2.*exp(-temp3);&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;PDF_LogNormal_Ref = (1./(sqrt(2*pi)*ShapeFactor*x)) .* exp(-((log(x/SizeFactor)).^2)/(2*ShapeFactor*ShapeFactor));&#x000D;&#x000A;&#x0009;PDF_Weibull_Ref = (ShapeFactor/SizeFactor) .* (x/SizeFactor).^(ShapeFactor-1) .* exp(-(x/SizeFactor).^ShapeFactor);&#x000D;&#x000A;end&#x000D;&#x000A;PDF_LogNormal_Ref (1) = 0; %% Set the 1st value of PDF_LogNormal_Ref = 0 to avoid NaN value.&#x000D;&#x000A;&#x000D;&#x000A;PSD_Gauss = exp( -(f/PSDVariance).^2 / 2 );&#x000D;&#x000A;PSD_Cauchy = FreqCutoff.^2 ./(FreqCutoff.^2 + abs(f).^2);&#x000D;&#x000A;PSD_AllPole = FreqCutoff.^N ./(FreqCutoff.^N + abs(f).^N);&#x000D;&#x000A;&#x000D;&#x000A;%f_RF = f + RF_Freq;&#x000D;&#x000A;f_RF = f;</Text>
