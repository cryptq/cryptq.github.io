<Item XName="Eqns" Type="Equation">
<Text>using(&apos;Sweep1_Data&apos;);&#x000D;&#x000A;fftSize = getvariable(&apos;vars_graph&apos;, &apos;fftSize&apos;);&#x000D;&#x000A;x = getvariable(&apos;vars_graph&apos;, &apos;f_RF&apos;);&#x000D;&#x000A;Clutter = getvariable(&apos;Sweep1_Data&apos;,&apos;Clutter&apos;);&#x000D;&#x000A;&#x000D;&#x000A;y = Clutter(end/3+1:end*2/3);&#x000D;&#x000A;y = y - mean(y);&#x000D;&#x000A;Y = fftshift(abs(fft(y,fftSize)));&#x000D;&#x000A;&#x000D;&#x000A;%Y = 20*log10(Y);&#x000D;&#x000A;&#x000D;&#x000A;Y = Y./max(Y);&#x000D;&#x000A;&#x000D;&#x000A;setindep(&apos;Y&apos;, &apos;x&apos;);&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;</Text>
