<Item XName="Eqns" Type="Equation">
<Text>y = getvariable(&apos;vars_graph&apos;, &apos;PSD_Gauss&apos;);&#x000D;&#x000A;x = getvariable(&apos;vars_graph&apos;, &apos;f_RF&apos;);&#x000D;&#x000A;%y = 20*log10(y+1e-6);&#x000D;&#x000A;%y = yy./max(yy);&#x000D;&#x000A;&#x000D;&#x000A;setindep(&apos;y&apos;, &apos;x&apos;);</Text>
