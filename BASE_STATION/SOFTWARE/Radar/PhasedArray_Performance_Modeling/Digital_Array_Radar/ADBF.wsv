<Text>%% This equation file configures system-level global parameters&#x000D;&#x000A;&#x000D;&#x000A;%% Generic Parameters&#x000D;&#x000A;SampleRate = 10e6;&#x000D;&#x000A;Fc = 10e9;&#x000D;&#x000A;C = 3e8;&#x000D;&#x000A;Lamda = C/Fc;&#x000D;&#x000A;NDensity = -100.975;&#x000D;&#x000A;&#x000D;&#x000A;%% Source/Jamming Signal Parameters&#x000D;&#x000A;% Interested Signal Parameters: &#x000D;&#x000A;PRI = 100e-6;&#x000D;&#x000A;PulseWidth = 30e-6;&#x000D;&#x000A;BW = 5e6;&#x000D;&#x000A;NumSamp_PRI = floor(SampleRate*PRI);&#x000D;&#x000A;&#x000D;&#x000A;% Jamming Signal Parameters:&#x000D;&#x000A;NumSamp = NumSamp_PRI;&#x000D;&#x000A;Mean = 0;&#x000D;&#x000A;Stdev = 1;&#x000D;&#x000A;BWJam = 0.1;&#x000D;&#x000A;&#x000D;&#x000A;%% Radar AntiInterference Parameters&#x000D;&#x000A;NumOfCH = 16;&#x000D;&#x000A;D = 0.5; % Element Spacing&#x000D;&#x000A;Theta_Signal = 30; % Predefined Signal Incoming Direction&#x000D;&#x000A;Theta_Jammer = 60; % Predefined Jammer Incoming Direction&#x000D;&#x000A;&#x000D;&#x000A;Theta_ADBF = 35; % &quot;Guessed&quot; Signal Incoming Direction for ADBF&#x000D;&#x000A;&#x000D;&#x000A;%% ADBF Pattern Sweep Parameters&#x000D;&#x000A;LowLim_Theta = -90;&#x000D;&#x000A;UpLim_Theta = 90;&#x000D;&#x000A;Step_Theta = 1;&#x000D;&#x000A;Num_Theta = floor( (UpLim_Theta - LowLim_Theta)/Step_Theta + 1 );&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;</Text>
