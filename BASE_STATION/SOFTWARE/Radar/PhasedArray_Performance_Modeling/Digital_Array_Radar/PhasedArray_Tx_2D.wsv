<Item XName="Page" Type="PageMgr" />
<Item XName="XY_2DPattern2" UserName="XY_2DPattern2" Type="Equation">
<AutoCalc><T>Bool</T><D>0</D></AutoCalc>
<Selected><T>Bool</T><D>0</D></Selected>
<Text>using(&apos;DF2_Design2_Data&apos;);&#x000D;&#x000A;&#x000D;&#x000A;Pattern_Value = abs(Pattern);&#x000D;&#x000A;Pattern_mat = reshape(Pattern_Value, 181, 361);&#x000D;&#x000A;Pattern_mat = Pattern_mat&apos;;&#x000D;&#x000A;&#x000D;&#x000A;%% According to the antenna data format of EMpro and HFSS&#x000D;&#x000A;%% The range of theta is [0:pi]&#x000D;&#x000A;%% The range of phi is [0:2*pi]&#x000D;&#x000A;theta = [0 : 180];&#x000D;&#x000A;phi = [0 : 360];&#x000D;&#x000A;[T P] = meshgrid(theta, phi);&#x000D;&#x000A;&#x000D;&#x000A;%% For XY-plane, x axis is along the horizontal direction and y axis is along the vertical direction&#x000D;&#x000A;u = sin(T/180*pi) .* cos(P/180*pi);&#x000D;&#x000A;v = sin(T/180*pi) .* sin(P/180*pi);&#x000D;&#x000A;w = cos(T/180*pi);&#x000D;&#x000A;&#x000D;&#x000A;graph = graph_figure(&apos;Horizonta lLinear Array 2D array pattern&apos;);&#x000D;&#x000A;graph.clear_data();&#x000D;&#x000A;graph.add_surface_data(u,v, Pattern_mat,&apos;surface1&apos;);&#x000D;&#x000A;graph.set_title(&apos;Horizonta lLinear Array 2D array pattern&apos;);&#x000D;&#x000A;graph.set_label_x(&apos;u_coord&apos;);&#x000D;&#x000A;graph.set_label_y(&apos;V_coord&apos;);</Text>
<Item XName="BPMgr" Type="BPMgr">
<BPLines><T>Empty</T></BPLines>
<BPStates><T>Empty</T></BPStates></Item>
<Item XName="EqnBlock" Type="EqnBlock">
<Lang><T>Int</T><D>1</D></Lang></Item>
<Item XName="Font" Type="Font">
<Name>Courier New</Name>
<Size><T>Double</T><D>125</D></Size></Item>
<Item XName="FunctionBlock" Type="FunctionBlock" />
<Item XName="Page" Type="PageMgr">
<Item XName="Display0" Type="EquationDisp">
<DVport><T>Array_Dbl64</T><D>1;4;;;Cp14;OY14</D></DVport>
<PVPort><T>Array_Dbl64</T><D>1;4;;;bsNQVfRfm24;RvobBNguV24</D></PVPort>
<Show><T>Bool</T><D>0</D></Show>
<ShowCmd><T>Int</T><D>1</D></ShowCmd>
<Split><T>Double</T><D>0.3</D></Split>
<Split2><T>Double</T><D>0.3</D></Split2>
<Window><T>Array_I64</T><D>1;4;M9;D9;WC;JC</D></Window>
<ZOrder><T>Int</T><D>5</D></ZOrder></Item></Item>
<Item XName="VarBlock" Type="VarBlock" /></Item>
<Item XName="XY_SphereView2" UserName="XY_SphereView2" Type="Equation">
<AutoCalc><T>Bool</T><D>0</D></AutoCalc>
<Selected><T>Bool</T><D>0</D></Selected>
<Text>using(&apos;DF2_Design2_Data&apos;);&#x000D;&#x000A;&#x000D;&#x000A;Pattern_Value = abs(Pattern);&#x000D;&#x000A;%Pattern_Value = 20*log10(Pattern_Value);&#x000D;&#x000A;Pattern_mat = reshape(Pattern_Value, 181, 361);&#x000D;&#x000A;Pattern_mat = Pattern_mat&apos;;&#x000D;&#x000A;&#x000D;&#x000A;%% For XY-plane, x axis is along the horizontal direction and y axis is along the vertical direct&#x000D;&#x000A;theta = [0 : 180];&#x000D;&#x000A;phi = [0 : 360];&#x000D;&#x000A;[T P] = meshgrid(theta, phi);&#x000D;&#x000A;u = sin(T/180*pi) .* cos(P/180*pi);&#x000D;&#x000A;v = sin(T/180*pi) .* sin(P/180*pi);&#x000D;&#x000A;w = cos(T/180*pi);&#x000D;&#x000A;&#x000D;&#x000A;%% The function cart2sph convert the data to the spherical coordinates using azimuth and elevation&#x000D;&#x000A;%% Please refer to Matlab cart2sph help doc&#x000D;&#x000A;[Azm,Elv,Pattern_mat_re] = cart2sph(Pattern_mat.*u,Pattern_mat.*v,Pattern_mat.*w);&#x000D;&#x000A;&#x000D;&#x000A;%% Verify that our u,v,w do what we think they do.&#x000D;&#x000A;assert(norm(Pattern_mat(:)-Pattern_mat_re(:))&lt;1e-9);&#x000D;&#x000A;&#x000D;&#x000A;graph = graph_figure(&apos;Horizontal LinearArray Spherical Pattern View&apos;);&#x000D;&#x000A;%% The function add_spherical_data uses the phi and theta&#x000D;&#x000A;%% The phi equals to the azimuth used by cart2sph&#x000D;&#x000A;%% The theta equals to pi/2-elevation used by cart2sph&#x000D;&#x000A;%% Please refer to the Matlab Script add_spherical_data help doc&#x000D;&#x000A;graph.clear_data();&#x000D;&#x000A;graph.add_spherical_data(Azm, pi/2-Elv, Pattern_mat_re,&apos;surface2&apos;);&#x000D;&#x000A;graph.set_title(&apos;Horizontal LinearArray Spherical Pattern View&apos;);&#x000D;&#x000A;graph.set_colormap(&apos;arctic&apos;);</Text>
