<Item XName="EquationText" Type="PartParam">
<DataEntry>% generate the pattern matrix&#x000D;&#x000A;Pattern_value = abs(Pattern_in);&#x000D;&#x000A;%Pattern_value = 20*log10(Pattern_value);&#x000D;&#x000A;Pattern_matrix = reshape(Pattern_value, 181, 361);&#x000D;&#x000A;Pattern_matrix = Pattern_matrix&apos;;&#x000D;&#x000A;&#x000D;&#x000A;% generate the phi and theta matrix&#x000D;&#x000A;x = [0 : 180];&#x000D;&#x000A;y = [0 : 360];&#x000D;&#x000A;x = x/180*pi;&#x000D;&#x000A;y = y/180*pi;&#x000D;&#x000A;[Theta_matrix Phi_matrix] = meshgrid(x, y);</DataEntry>
<Description>Equation Text to Parse, edited in the equation set</Description>
<DocSymbol />
<IsSettable><T>Bool</T><D>0</D></IsSettable>
<Range />
<RunTimeTunable><T>Bool</T><D>0</D></RunTimeTunable>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>4</D></Validate></Item>
