<Item XName="EquationText" Type="PartParam">
<DataEntry>%% According to the antenna data format of EMpro and HFSS&#x000D;&#x000A;%% The range of theta is [0:pi]&#x000D;&#x000A;&#x000D;&#x000A;persistent idx;&#x000D;&#x000A;&#x000D;&#x000A;if isempty(idx) &#x000D;&#x000A;&#x0009;idx&#x0009;= 0;&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;idx = idx + 1;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;theta_idx &#x0009;= mod(idx, 181);&#x000D;&#x000A;phi_idx&#x0009;&#x0009;= mod(floor(idx/181),361);&#x000D;&#x000A;&#x000D;&#x000A;theta&#x0009;= theta_idx/ 180 * pi;&#x000D;&#x000A;phi&#x0009;&#x0009;= phi_idx/ 180 * pi;</DataEntry>
<Description>Equation Text to Parse, edited in the equation set</Description>
<DocSymbol />
<IsSettable><T>Bool</T><D>0</D></IsSettable>
<Range />
<RunTimeTunable><T>Bool</T><D>0</D></RunTimeTunable>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>4</D></Validate></Item>
<Item XName="IOInfo" Type="PartParam">
<DataEntry>theta?0?0?1?17?0#phi?0?0?1?17?0#</DataEntry>
<Description>IO Port Info</Description>
<DocSymbol />
<IsSettable><T>Bool</T><D>0</D></IsSettable>
<Range />
<RunTimeTunable><T>Bool</T><D>0</D></RunTimeTunable>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>4</D></Validate></Item>
<Item XName="Interpreter" Type="PartParam">
<DataEntry>0</DataEntry>
<Description>MATLAB Script or retail MATLAB</Description>
<DocSymbol />
<Enum>MATLAB_Script__Interpreter@Data Flow Enums</Enum>
<IsSettable><T>Bool</T><D>0</D></IsSettable>
<Range />
<RunTimeTunable><T>Bool</T><D>0</D></RunTimeTunable>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="Vectorization" Type="PartParam">
<DataEntry>100</DataEntry>
<Description>Vectorization factor</Description>
<DocSymbol />
<Range />
