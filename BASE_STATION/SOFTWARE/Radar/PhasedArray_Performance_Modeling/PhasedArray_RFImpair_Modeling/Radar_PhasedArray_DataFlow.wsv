<Item XName="SystemLevel_Global_Params" UserName="SystemLevel_Global_Params" Type="Equation">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>%% This equation is designed to configure general-purpose GLOBAL parameters &#x000D;&#x000A;&#x000D;&#x000A;%% Platform/Target Parameters&#x000D;&#x000A;RadarPos = [0 0 1500];&#x000D;&#x000A;RadarVel = 0;&#x000D;&#x000A;&#x000D;&#x000A;TarNum = 1;&#x000D;&#x000A;ScatterLoc = [0 0 0];&#x000D;&#x000A;TarPos = [0 0.02 1500]&#x000D;&#x000A;&#x000D;&#x000A;%% Radar System_Parameters&#x000D;&#x000A;C = 3e8;&#x000D;&#x000A;SampleRate = 4e6;&#x000D;&#x000A;&#x000D;&#x000A;PRI = 100e-6;&#x000D;&#x000A;PulseWidth = 10e-6;&#x000D;&#x000A;BandWidth = 2e6;&#x000D;&#x000A;&#x000D;&#x000A;%% Beam Tuning Parameters&#x000D;&#x000A;FRxTx = Fc; % Same as carrier frequency&#x000D;&#x000A;beamTheta_Tx = 10;%tune(9); %deg&#x000D;&#x000A;beamPhi_Tx = 0;%tune(0); %deg&#x000D;&#x000A;&#x000D;&#x000A;beamTheta_Rx = 10;%tune(9); %deg&#x000D;&#x000A;beamPhi_Rx = 0;%tune(0); %deg&#x000D;&#x000A;&#x000D;&#x000A;%% RF System-Level Parameters&#x000D;&#x000A;Fc = 10e9;&#x000D;&#x000A;Tx_Pwr_dBm = 10; % in dBm&#x000D;&#x000A;Tx_Gain = 50; % in dB&#x000D;&#x000A;Rx_Gain = 50; % in dB&#x000D;&#x000A;&#x000D;&#x000A;%% Antenna Array Parameters&#x000D;&#x000A;NumEl = 8;%tune(8);&#x000D;&#x000A;NumEl_Total = NumEl*NumEl;&#x000D;&#x000A;&#x000D;&#x000A;%% Signal Processing Parameters&#x000D;&#x000A;FFTSize = 1024; %% Pulse Compression FFTSize&#x000D;&#x000A;CPI_Num = 32;&#x000D;&#x000A;&#x000D;&#x000A;PRI_Sample_Num = PRI * SampleRate;&#x000D;&#x000A;CPI_Sample_Num = PRI_Sample_Num*CPI_Num;&#x000D;&#x000A;&#x000D;&#x000A;%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%&#x000D;&#x000A;%% Old Code below for further reorg&#x000D;&#x000A;% ArrayState = tune(1);   &#x0009;&#x0009;&#x0009;% 1 - Rx, 2 - Tx&#x0009;&#x0009;&#x0009;   &#x0009;&#x0009;&#x000D;&#x000A;%ArrayState_Tx = 2;&#x000D;&#x000A;%ArrayState_Rx = 1;&#x000D;&#x000A;&#x000D;&#x000A;%RxPwrDensity_dBm = -50;&#x0009;&#x0009;&#x0009;&#x0009;% dBm&#x000D;&#x000A;%&#x000D;&#x000A;%&#x000D;&#x000A;%SpeedOfLight = 299792458;&#x0009;&#x0009;&#x0009;% m / s&#x000D;&#x000A;%WaveLength = SpeedOfLight / (FRxTx * 1e9);&#x000D;&#x000A;%&#x000D;&#x000A;%RxPwrIn_Watts = 10^( ( RxPwrDensity_dBm - 30 ) / 10 ) * WaveLength^2 / ( 4 * pi );&#x000D;&#x000A;%RxPwrIn_dBm = dbm( RxPwrIn_Watts);&#x000D;&#x000A;%&#x000D;&#x000A;%PhiCutAngle = tune(0);</Text>
<Item XName="BPMgr" Type="BPMgr">
<BPLines><T>Empty</T></BPLines>
<BPStates><T>Empty</T></BPStates></Item>
<Item XName="EqnBlock" Type="EqnBlock">
<Lang><T>Int</T><D>1</D></Lang></Item>
<Item XName="Font" Type="Font">
<Name>Courier New</Name>
<Size><T>Double</T><D>125</D></Size></Item>
<Item XName="FunctionBlock" Type="FunctionBlock" />
<Item XName="Page" Type="PageMgr">
<Item XName="Display0" Type="EquationDisp">
<DVport><T>Array_Dbl64</T><D>1;4;;;yo14;Oe14</D></DVport>
<PVPort><T>Array_Dbl64</T><D>1;4;;;jOnY5Bb}a24;Y49Ia8N1S24</D></PVPort>
<Show><T>Bool</T><D>0</D></Show>
<ShowCmd><T>Int</T><D>1</D></ShowCmd>
<Split><T>Double</T><D>0.3</D></Split>
<Split2><T>Double</T><D>0.3</D></Split2>
<Window><T>Array_I64</T><D>1;4;05;;0A;f3</D></Window>
<ZOrder><T>Int</T><D>7</D></ZOrder></Item></Item>
<Item XName="VarBlock" Type="VarBlock" /></Item>
<Item XName="SystemLevel_RFImpair_Params" UserName="SystemLevel_RFImpair_Params" Type="Equation">
<AutoCalc><T>Bool</T><D>1</D></AutoCalc>
<Selected><T>Bool</T><D>1</D></Selected>
<Text>%% This equation is designed to implement RF impairments both at Tx and RF phased array RF stages&#x000D;&#x000A;&#x000D;&#x000A;%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%&#x000D;&#x000A;%% Global RF Impairment Switch&#x000D;&#x000A;%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%&#x000D;&#x000A;RF_Impair_Switch = 0; %0 for NO impairment, 1 for with all impairments configured as the following&#x000D;&#x000A;&#x000D;&#x000A;%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%&#x000D;&#x000A;%% Paramter Initializations (For NO RF Impairment conditions)&#x000D;&#x000A;%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%&#x000D;&#x000A;&#x000D;&#x000A;%% Tx RF Impairment Parameters&#x000D;&#x000A;%%-------------------------------------------------%%&#x000D;&#x000A;%% Power Divider Parameters&#x000D;&#x000A;PwrDiv_Loss_Tx= 0;&#x000D;&#x000A;&#x000D;&#x000A;%% Phased Array Amplitude Tuning (Amplifier) Parameters&#x000D;&#x000A;AmpErrType_Tx = 0;&#x000D;&#x000A;AmpErrStdDev_Tx = 0; % Initialization ONLY&#x000D;&#x000A;AmpGain_Tx = 10;&#x000D;&#x000A;NFAmp_Tx = 0; &#x000D;&#x000A;&#x000D;&#x000A;%% Phased Array Phase Tuning (Phase Shifter) Parameters&#x000D;&#x000A;PhaShif_QuanType_Tx = 0; % Enum&#x000D;&#x000A;PhaShif_QuanBit_Tx = 1; % Initialization ONLY&#x000D;&#x000A;PhaShif_PhaErrType_Tx = 0; % Enum&#x000D;&#x000A;PhaShif_PhaErrStdDev_Tx = 0; % Initialization ONLY&#x000D;&#x000A;&#x000D;&#x000A;%% Power Amplifier Parameters&#x000D;&#x000A;PwrAmpGain_Tx = Tx_Gain;&#x000D;&#x000A;PwrAmpGainErrType_Tx = 0;&#x000D;&#x000A;PwrAmpGainErrStdDev_Tx = 0;&#x0009;% Initialization ONLY&#x000D;&#x000A;NFPwrAmp_Tx = 0; &#x000D;&#x000A;GCTypePwrAmp_Tx = 0;&#x000D;&#x000A;TOIOutPwrAmp_Tx = 100;&#x000D;&#x000A;dBc1OutPwrAmp_Tx = 90;&#x000D;&#x000A;%%-------------------------------------------------%%&#x000D;&#x000A;&#x000D;&#x000A;%% Rx RF Impairment Parameters&#x000D;&#x000A;&#x000D;&#x000A;%% LNA Amplifier Parameters&#x000D;&#x000A;LNAAmpGain_Rx = Rx_Gain;&#x000D;&#x000A;LNAAmpGainErrType_Rx = 0;&#x000D;&#x000A;LNAAmpGainErrStdDev_Rx = 0;&#x0009;% Initialization ONLY&#x000D;&#x000A;NFLNAAmp_Rx = 0; &#x000D;&#x000A;GCTypeLNAAmp_Rx = 0;&#x000D;&#x000A;TOIOutLNAAmp_Rx = 100;&#x000D;&#x000A;dBc1OutLNAAmp_Rx = 90;&#x000D;&#x000A;&#x000D;&#x000A;%% Phased Array Amplitude Tuning (Amplifier) Parameters&#x000D;&#x000A;AmpErrType_Rx = 0;&#x000D;&#x000A;AmpErrStdDev_Rx = 0; % Initialization ONLY&#x000D;&#x000A;AmpGain_Rx = 10;&#x000D;&#x000A;NFAmp_Rx = 0; &#x000D;&#x000A;&#x000D;&#x000A;%% Phased Array Phase Tuning (Phase Shifter) Parameters&#x000D;&#x000A;PhaShif_QuanType_Rx = 0; % Enum&#x000D;&#x000A;PhaShif_QuanBit_Rx = 1; % Initialization ONLY&#x000D;&#x000A;PhaShif_PhaErrType_Rx = 0; % Enum&#x000D;&#x000A;PhaShif_PhaErrStdDev_Rx = 0; % Initialization ONLY&#x000D;&#x000A;&#x000D;&#x000A;%% Power Combiner Parameters&#x000D;&#x000A;PwrDiv_Loss_Rx = 0;&#x000D;&#x000A;&#x000D;&#x000A;%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%&#x000D;&#x000A;%% Paramter Tuning (For WITH RF Impairment conditions)&#x000D;&#x000A;%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%&#x000D;&#x000A;if RF_Impair_Switch == 1&#x000D;&#x000A;&#x0009;&#x000D;&#x000A;&#x0009;%% Tune your Tx RF Impairment Parameters Here&#x000D;&#x000A;&#x0009;%%-------------------------------------------------%%&#x000D;&#x000A;&#x0009;%% Power Divider Parameters&#x000D;&#x000A;&#x0009;PwrDiv_Loss_Tx = 0;&#x000D;&#x000A;&#x0009;&#x000D;&#x000A;&#x0009;%% Phased Array Amplitude Tuning (Amplifier) Parameters&#x000D;&#x000A;&#x0009;AmpErrType_Tx = 1; %% This is Enum&#x000D;&#x000A;&#x0009;AmpErrStdDev_Tx = 0.1;&#x000D;&#x000A;&#x0009;NFAmp_Tx = 6;&#x000D;&#x000A;&#x0009;&#x000D;&#x000A;&#x0009;%% Phased Array Phase Tuning (Phase Shifter) Parameters&#x000D;&#x000A;&#x0009;PhaShif_QuanType_Tx = 1; % Enum&#x000D;&#x000A;&#x0009;PhaShif_QuanBit_Tx = 8;&#x000D;&#x000A;&#x0009;PhaShif_PhaErrType_Tx = 1;&#x000D;&#x000A;&#x0009;PhaShif_PhaErrStdDev_Tx = 3;&#x000D;&#x000A;&#x0009;&#x000D;&#x000A;&#x0009;%% Power Amplifier Parameters&#x000D;&#x000A;&#x0009;PwrAmpGainErrType_Tx = 1;&#x000D;&#x000A;&#x0009;PwrAmpGainErrStdDev_Tx = 0.5;&#x000D;&#x000A;&#x0009;NFPwrAmp_Tx = 10;&#x0009;&#x000D;&#x000A;&#x0009;GCTypePwrAmp_Tx = 3;&#x000D;&#x000A;&#x0009;TOIOutPwrAmp_Tx = 53;&#x000D;&#x000A;&#x0009;dBc1OutPwrAmp_Tx = 40;&#x000D;&#x000A;&#x0009;%%-------------------------------------------------%%&#x000D;&#x000A;&#x0009;&#x000D;&#x000A;&#x0009;%% Tune your Rx RF Impairment Parameters Here&#x000D;&#x000A;&#x0009;%%-------------------------------------------------%%&#x000D;&#x000A;&#x0009;%% Low Noise Amplifier Parameters&#x000D;&#x000A;&#x0009;LNAAmpGainErrType_Rx = 1; &#x000D;&#x000A;&#x0009;LNAAmpGainErrStdDev_Rx = 0.5; &#x000D;&#x000A;&#x0009;NFLNAAmp_Rx = 0;&#x0009;&#x000D;&#x000A;&#x0009;GCTypeLNAAmp_Rx = 3;&#x000D;&#x000A;&#x0009;TOIOutLNAAmp_Rx = 53;&#x000D;&#x000A;&#x0009;dBc1OutLNAAmp_Rx = 40;&#x000D;&#x000A;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;%% Phased Array Amplitude Tuning (Amplifier) Parameters&#x000D;&#x000A;&#x0009;AmpErrType_Rx = 1;&#x000D;&#x000A;&#x0009;AmpErrStdDev_Rx = 0.1; &#x000D;&#x000A;&#x0009;NFAmp_Rx = 6; &#x000D;&#x000A;&#x000D;&#x000A;&#x0009;%% Phased Array Phase Tuning (Phase Shifter) Parameters&#x000D;&#x000A;&#x0009;PhaShif_QuanType_Rx = 1; % Enum&#x000D;&#x000A;&#x0009;PhaShif_QuanBit_Rx = 8; &#x000D;&#x000A;&#x0009;PhaShif_PhaErrType_Rx = 1; % Enum&#x000D;&#x000A;&#x0009;PhaShif_PhaErrStdDev_Rx = 3; &#x000D;&#x000A;&#x0009;&#x000D;&#x000A;&#x0009;%% Power Combiner Parameters&#x000D;&#x000A;&#x0009;PwrDiv_Loss_Rx = 0;&#x000D;&#x000A;&#x0009;&#x000D;&#x000A;end</Text>
