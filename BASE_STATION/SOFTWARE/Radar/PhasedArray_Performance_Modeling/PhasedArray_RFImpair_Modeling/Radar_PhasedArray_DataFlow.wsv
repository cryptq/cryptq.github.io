<Item XName="SetupCouplingMatrix" UserName="SetupCouplingMatrix" Type="Equation">
<AutoCalc><T>Bool</T><D>1</D></AutoCalc>
<Selected><T>Bool</T><D>0</D></Selected>
<Text>useSParameter = 1;&#x000D;&#x000A;&#x000D;&#x000A;if useSParameter == 1&#x000D;&#x000A;&#x0009;using(&apos;8x8_array_touchstone.s64p&apos;);&#x000D;&#x000A;&#x0009;couplingMtx = squeeze(S);&#x000D;&#x000A;&#x0009;couplingMtx = couplingMtx - couplingMtx .* eye(64) + eye(64);&#x000D;&#x000A;&#x0009;setdisplayunit(couplingMtx,&apos;&apos;);&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;% column major ordering of locations for 8x8 URA&#x000D;&#x000A;&#x0009;numAntsX = 8;&#x000D;&#x000A;&#x0009;numAntsY = 8;&#x000D;&#x000A;&#x0009;numAnts = numAntsX * numAntsY;&#x000D;&#x000A;&#x0009;distanceX = 0.5; %in wavelength&#x000D;&#x000A;&#x0009;distanceY = 0.5; %in wavelength&#x000D;&#x000A;&#x0009;dBDownPerWavelength = 30;&#x000D;&#x000A;&#x0009;dBThreshold = -100;&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;[locationX, locationY] = meshgrid([0:numAntsX]*distanceX, [0:numAntsY]*distanceY);&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;%couplingMtx(m,n) represents the complex coupling coefficient from the n-th antenna element to the m-th antenna element&#x000D;&#x000A;&#x0009;couplingMtx = eye(numAnts); %default coupling matrix as identify matrix&#x000D;&#x000A;&#x0009;for n = 1 : numAnts&#x000D;&#x000A;&#x0009;&#x0009;for m = 1 : numAnts&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;distanceInWavelength = sqrt((locationX(n) - locationX(m))^2 + (locationY(n) - locationY(m))^2);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;if ( distanceInWavelength * -dBDownPerWavelength &gt; dBThreshold )&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;couplingMtx(m,n) = 10^(distanceInWavelength * -dBDownPerWavelength / 20);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x000D;&#x000A;</Text>
<Item XName="BPMgr" Type="BPMgr">
<BPLines><T>Empty</T></BPLines>
<BPStates><T>Empty</T></BPStates></Item>
<Item XName="EqnBlock" Type="EqnBlock">
<Lang><T>Int</T><D>1</D></Lang>
<UsingContext>8x8_array_touchstone.s64p;</UsingContext></Item>
<Item XName="Font" Type="Font">
<Name>Courier New</Name>
<Size><T>Double</T><D>125</D></Size></Item>
<Item XName="FunctionBlock" Type="FunctionBlock" />
<Item XName="Page" Type="PageMgr">
<Item XName="Display0" Type="EquationDisp">
<DVport><T>Array_Dbl64</T><D>1;4;;;4r14;V14</D></DVport>
<PVPort><T>Array_Dbl64</T><D>1;4;;;ZSCknOcUn24;qzGt3TNkP24</D></PVPort>
<Show><T>Bool</T><D>0</D></Show>
<ShowCmd><T>Int</T><D>1</D></ShowCmd>
<Split><T>Double</T><D>0.3</D></Split>
<Split2><T>Double</T><D>0.3</D></Split2>
<Window><T>Array_I64</T><D>1;4;X4;;r6;V</D></Window>
<ZOrder><T>Int</T><D>6</D></ZOrder></Item></Item>
<Item XName="VarBlock" Type="VarBlock" /></Item></Item>
<Item XName="Equation_ResultPlots" UserName="Equation_ResultPlots" Type="Equation">
<AutoCalc><T>Bool</T><D>0</D></AutoCalc>
<Selected><T>Bool</T><D>0</D></Selected>
<Text>%using(&apos;DF1_NoRFImpair_Data&apos;);&#x000D;&#x000A;using(&apos;DF1_WithRFImpair_Data&apos;);&#x000D;&#x000A;&#x000D;&#x000A;echo = PulseComp_ChopData; %echo = PulseComp_Data&#x000D;&#x000A;&#x000D;&#x000A;echo_re = real(echo);&#x000D;&#x000A;echo_im = imag(echo);&#x000D;&#x000A;&#x000D;&#x000A;PD_Result_re = real(PDOut_ChopData);&#x000D;&#x000A;PD_Result_im = imag(PDOut_ChopData);&#x000D;&#x000A;&#x000D;&#x000A;wavelength = C / Fc;&#x000D;&#x000A;PRF = 1 / PRI;&#x000D;&#x000A;&#x000D;&#x000A;echo_cplx = echo_re + j * echo_im;&#x000D;&#x000A;&#x000D;&#x000A;echo_mat = reshape(echo_cplx, PRI_Sample_Num, CPI_Num);&#x000D;&#x000A;&#x000D;&#x000A;echo_mat_fft = zeros(PRI_Sample_Num, CPI_Num);&#x000D;&#x000A;&#x000D;&#x000A;for n = 1 : PRI_Sample_Num&#x000D;&#x000A;&#x0009;echo_mat_fft(n,:) = fft(echo_mat(n, :));&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;%range_doppler = graph_figure(&apos;Range-Doppler RawMatrix-WithImpair&apos;); %NoImpair&#x000D;&#x000A;%range_doppler.add_surface_data(abs(echo_mat_fft));&#x000D;&#x000A;%range_doppler.set_label_x(&apos;PRF&apos;);&#x000D;&#x000A;%range_doppler.set_label_y(&apos;range&apos;);&#x000D;&#x000A;%range_doppler.set_label_z(&apos;amplitude&apos;);&#x000D;&#x000A;%&#x000D;&#x000A;range = [0:PRI_Sample_Num-1] / fs * C/2;&#x000D;&#x000A;velocity = ([0:CPI_Num-1]) / CPI_Num * PRF * wavelength / 2;&#x000D;&#x000A;&#x000D;&#x000A;graph1 = graph_figure(&apos;Range-Doppler Matrix-WithImpair&apos;); %NoImpair&#x000D;&#x000A;graph1.add_surface_data(velocity, range, abs(echo_mat_fft));&#x000D;&#x000A;graph1.set_label_x(&apos;Velocity&apos;);&#x000D;&#x000A;graph1.set_label_y(&apos;Range&apos;);&#x000D;&#x000A;graph1.set_label_z(&apos;Amplitude&apos;);&#x000D;&#x000A;&#x000D;&#x000A;PD_result_cplx = PD_Result_re + j * PD_Result_im;&#x000D;&#x000A;PD_result_mat = reshape(PD_result_cplx, PRI_Sample_Num, CPI_Num);&#x000D;&#x000A;graph2 = graph_figure(&apos;PD Result-WithImpair&apos;); %NoImpair&#x000D;&#x000A;graph2.add_surface_data(velocity, range ,abs(PD_result_mat));&#x000D;&#x000A;graph2.set_label_x(&apos;Velocity&apos;);&#x000D;&#x000A;graph2.set_label_y(&apos;Range&apos;);&#x000D;&#x000A;graph2.set_label_z(&apos;Amplitude&apos;);&#x000D;&#x000A;</Text>
<UnitUse><T>Int</T><D>2</D></UnitUse>
