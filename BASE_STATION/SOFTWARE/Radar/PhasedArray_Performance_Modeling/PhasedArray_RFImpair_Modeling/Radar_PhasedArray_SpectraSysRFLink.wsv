<Item XName="Rx_PhArrayDesign_RunSim" UserName="Rx_PhArrayDesign_RunSim" Type="Equation">
<AutoCalc><T>Bool</T><D>0</D></AutoCalc>
<Selected><T>Bool</T><D>0</D></Selected>
<Text>runanalysis(&apos;PhasedArrayRx&apos;);&#x000D;&#x000A;&#x000D;&#x000A;using(&apos;PhasedArrayRx_PhArrayDesign2_Data&apos;);&#x000D;&#x000A;&#x000D;&#x000A;% Phased Array Configuration Plot&#x000D;&#x000A;graph1=graph_figure(&apos;Rx Array Config&apos;);&#x000D;&#x000A;graph1.add_scatter_data( PartInfo_AntennaLocationX_ArrayAnt1, PartInfo_AntennaLocationY_ArrayAnt1, PartInfo_AntennaLocationZ_ArrayAnt1 );&#x000D;&#x000A;% Phased Array Beam Pattern&#x000D;&#x000A;graph2=graph_figure(&apos;Rx Phased Array Pattern&apos;);&#x000D;&#x000A;graph2.add_spherical_data( ArrayMeas_Directivity_PhiGrid , ArrayMeas_Directivity_ThetaGrid, max(10*log10(ArrayMeas_Directivity_Pattern),-30) );</Text>
