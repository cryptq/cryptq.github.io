<Item XName="Display0" Type="NotesDisp">
<DVport><T>Array_Dbl64</T><D>1;4;;;OD24;C224</D></DVport>
<PVPort><T>Array_Dbl64</T><D>1;4;;;7XN4UH3I034;gIbALgNAq24</D></PVPort>
<Show><T>Bool</T><D>1</D></Show>
<ShowCmd><T>Int</T><D>3</D></ShowCmd>
