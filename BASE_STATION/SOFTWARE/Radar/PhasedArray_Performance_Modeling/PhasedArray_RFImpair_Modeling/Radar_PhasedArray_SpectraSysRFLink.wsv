<Item XName="Equation_ResultPlots_Basic" UserName="Equation_ResultPlots_Basic" Type="Equation">
<AutoCalc><T>Bool</T><D>0</D></AutoCalc>
<Selected><T>Bool</T><D>0</D></Selected>
<Text>using(&apos;DF2_Main2_Data_BasicImpair&apos;);&#x000D;&#x000A;&#x000D;&#x000A;echo = PulseComp_ChopData; %echo = PulseComp_Data&#x000D;&#x000A;&#x000D;&#x000A;echo_re = real(echo);&#x000D;&#x000A;echo_im = imag(echo);&#x000D;&#x000A;&#x000D;&#x000A;PD_Result_re = real(PDOut_ChopData);&#x000D;&#x000A;PD_Result_im = imag(PDOut_ChopData);&#x000D;&#x000A;&#x000D;&#x000A;wavelength = C / Fc;&#x000D;&#x000A;PRF = 1 / PRI;&#x000D;&#x000A;&#x000D;&#x000A;echo_cplx = echo_re + j * echo_im;&#x000D;&#x000A;&#x000D;&#x000A;echo_mat = reshape(echo_cplx, PRI_Sample_Num, CPI_Num);&#x000D;&#x000A;&#x000D;&#x000A;echo_mat_fft = zeros(PRI_Sample_Num, CPI_Num);&#x000D;&#x000A;&#x000D;&#x000A;for n = 1 : PRI_Sample_Num&#x000D;&#x000A;&#x0009;echo_mat_fft(n,:) = fft(echo_mat(n, :));&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;range_doppler = graph_figure(&apos;Range-Doppler RawMatrix_Basic&apos;);&#x000D;&#x000A;range_doppler.add_surface_data(abs(echo_mat_fft));&#x000D;&#x000A;range_doppler.set_label_x(&apos;PRF&apos;);&#x000D;&#x000A;range_doppler.set_label_y(&apos;range&apos;);&#x000D;&#x000A;range_doppler.set_label_z(&apos;amplitude&apos;);&#x000D;&#x000A;&#x000D;&#x000A;range = [0:PRI_Sample_Num-1] / SampleRate * C/2;&#x000D;&#x000A;velocity = ([0:CPI_Num-1]) / CPI_Num * PRF * wavelength / 2;&#x000D;&#x000A;&#x000D;&#x000A;graph1 = graph_figure(&apos;Range-Doppler Matrix_Basic&apos;);&#x000D;&#x000A;graph1.add_surface_data(velocity, range, abs(echo_mat_fft));&#x000D;&#x000A;graph1.set_label_x(&apos;Velocity&apos;);&#x000D;&#x000A;graph1.set_label_y(&apos;Range&apos;);&#x000D;&#x000A;graph1.set_label_z(&apos;Amplitude&apos;);&#x000D;&#x000A;&#x000D;&#x000A;PD_result_cplx = PD_Result_re + j * PD_Result_im;&#x000D;&#x000A;PD_result_mat = reshape(PD_result_cplx, PRI_Sample_Num, CPI_Num);&#x000D;&#x000A;graph2 = graph_figure(&apos;PD Result_Basic&apos;);&#x000D;&#x000A;graph2.add_surface_data(velocity, range ,abs(PD_result_mat));&#x000D;&#x000A;graph2.set_label_x(&apos;Velocity&apos;);&#x000D;&#x000A;graph2.set_label_y(&apos;Range&apos;);&#x000D;&#x000A;graph2.set_label_z(&apos;Amplitude&apos;);&#x000D;&#x000A;</Text>
<UnitUse><T>Int</T><D>2</D></UnitUse>
