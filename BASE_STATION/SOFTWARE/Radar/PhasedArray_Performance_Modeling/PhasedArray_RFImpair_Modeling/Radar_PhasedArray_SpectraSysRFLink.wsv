<Item XName="Eqns" Type="Equation">
<Text>using(&apos;PhasedArray1_Main1_Data&apos;);&#x000D;&#x000A;% &lt;Enter your &apos;MATLAB Script&apos; equations here&gt;&#x000D;&#x000A;thetaGrid = squeeze(double(ArrayMeas_Directivity_ThetaGrid));&#x000D;&#x000A;phiGrid = squeeze(double(ArrayMeas_Directivity_PhiGrid));&#x000D;&#x000A;directivityGrid = squeeze(double(ArrayMeas_Directivity_Pattern));&#x000D;&#x000A;&#x000D;&#x000A;phi=PhiCutAngle;&#x000D;&#x000A;theta_points = [90:-1:1, 0:90]*pi/180;&#x000D;&#x000A;theta_angles = [-90:90]*pi/180;&#x000D;&#x000A;phi_points = [(phi+180)*pi/180*ones(1,90), phi*pi/180*ones(1,91)];&#x000D;&#x000A;&#x000D;&#x000A;phiCut=interp2(thetaGrid, phiGrid, directivityGrid, theta_points, phi_points );&#x000D;&#x000A;setdisplayunit(phiCut,&apos;dB&apos;);&#x000D;&#x000A;setdisplayunit(theta_angles, &apos;deg&apos;);&#x000D;&#x000A;setindep(phiCut, &apos;theta_angles&apos; );</Text>
