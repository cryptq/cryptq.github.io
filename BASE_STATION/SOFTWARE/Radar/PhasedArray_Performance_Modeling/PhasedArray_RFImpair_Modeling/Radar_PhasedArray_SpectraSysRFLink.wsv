<Item XName="Tx_PhArrayDesign_Params" UserName="Tx_PhArrayDesign_Params" Type="Equation">
<AutoCalc><T>Bool</T><D>0</D></AutoCalc>
<Selected><T>Bool</T><D>0</D></Selected>
<Text>%******** User Inputs **********************&#x000D;&#x000A;sch_th = beamTheta_Tx;%tune(0);&#x000D;&#x000A;sch_phi = beamPhi_Tx;%tune(0);&#x000D;&#x000A;FRxTx = Fc; %tune(10);&#x0009;&#x0009;&#x0009;   &#x0009;&#x0009;% Frequency in GHz&#x000D;&#x000A;&#x000D;&#x000A;ArrayState = 2; %tune(2);   &#x0009;&#x0009;&#x0009;% 1 - Rx, 2 - Tx&#x000D;&#x000A;&#x000D;&#x000A;RxPwrDensity_dBm = -50;&#x0009;&#x0009;&#x0009;&#x0009;% dBm&#x000D;&#x000A;TxPin_dBm = 16;&#x000D;&#x000A;&#x000D;&#x000A;atype = 2;%tune(4);&#x000D;&#x000A;atext = {&apos;Linear Array&apos;;&apos;URA&apos;;} %(3 through 5 are currently NOT supported in this workspace)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;%&apos;Circular&apos;;&apos;Rectangular Array with Triangle Grid&apos;;&apos;Hexagon&apos;};&#x000D;&#x000A;&#x000D;&#x000A;atext2 = atext{atype};&#x000D;&#x000A;stext = {&apos;Rx&apos;;&apos;Tx&apos;};&#x000D;&#x000A;stext2 = stext{ArrayState}; &#x000D;&#x000A;&#x000D;&#x000A;% Array type &#x000D;&#x000A;%&#x0009;1 = &apos;Linear Array&apos;&#x000D;&#x000A;%&#x0009;2 = &apos;URA&apos; &#x000D;&#x000A;%&#x0009;3 = &apos;Circular&apos; %% (3 through 5 are currently NOT supported in this workspace)&#x000D;&#x000A;%&#x0009;4 = &apos;Rectangular Array with Triangle Grid&apos;&#x000D;&#x000A;%&#x0009;5 = &apos;Hexagon&apos;&#x000D;&#x000A;&#x000D;&#x000A;%For linear Array Setup&#x000D;&#x000A;NumLin = 16;&#x000D;&#x000A;&#x000D;&#x000A;%For URA Array Setup&#x000D;&#x000A;NumRow = 8;&#x000D;&#x000A;NumCol = 8;%16;&#x000D;&#x000A;&#x000D;&#x000A;%%For Circular Array Setup&#x000D;&#x000A;Num_perCircle = [1,4,8,16,16];&#x000D;&#x000A;Phase_perCircle = [0,0,0,0,0];&#x000D;&#x000A;RadiCircle = [0,0.5,1.0,1.5,2.0];&#x000D;&#x000A;%&#x000D;&#x000A;%%For Rectangular with Triangular Grid Array Setup&#x000D;&#x000A;NumRowT = 8;%16;&#x000D;&#x000A;NumColT = 8;%16;&#x000D;&#x000A;%&#x000D;&#x000A;%%For Hexagonal Array Setup&#x000D;&#x000A;NumBot = 5;&#x000D;&#x000A;NumMid = 11;&#x000D;&#x000A;num_per_row = [NumBot:NumMid,NumMid-1:-1:NumBot]&#x000D;&#x000A;NumRowCol = 2*(NumMid - NumBot) + 1;&#x000D;&#x000A;&#x000D;&#x000A;%******** End User Inputs ******************&#x000D;&#x000A;&#x000D;&#x000A;switch atype&#x000D;&#x000A;&#x0009;case 1&#x000D;&#x000A;&#x0009;&#x0009;NumElem = NumLin;&#x000D;&#x000A;&#x0009;&#x0009;NC = 1;&#x000D;&#x000A;&#x0009;&#x0009;NR = NumLin;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;case 2&#x000D;&#x000A;&#x0009;&#x0009;NumElem = NumRow * NumCol;&#x000D;&#x000A;&#x0009;&#x0009;NC = NumCol;&#x000D;&#x000A;&#x0009;&#x0009;NR = NumRow;&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;case 3&#x000D;&#x000A;&#x0009;&#x0009;NumElem = sum(Num_perCircle);&#x000D;&#x000A;&#x0009;&#x0009;NC = NumElem;&#x000D;&#x000A;&#x0009;&#x0009;NR = 1;&#x000D;&#x000A;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;case 4&#x000D;&#x000A;&#x0009;&#x0009;NumElem = NumRowT * NumColT;&#x000D;&#x000A;&#x0009;&#x0009;NC = NumColT;&#x000D;&#x000A;&#x0009;&#x0009;NR = NumRowT;&#x0009;&#x0009;&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;case 5&#x000D;&#x000A;&#x0009;&#x0009;NumElem = sum([NumBot:NumMid-1])*2 + NumMid;&#x000D;&#x000A;&#x0009;&#x0009;NC = NumElem;&#x000D;&#x000A;&#x0009;&#x0009;NR = 1;&#x000D;&#x000A;end</Text>
