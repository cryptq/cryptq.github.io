<Item XName="VarBlock" Type="VarBlock" /></Item>
<Item XName="SetupCouplingMatrix" UserName="SetupCouplingMatrix" Type="Equation">
<AutoCalc><T>Bool</T><D>1</D></AutoCalc>
<Selected><T>Bool</T><D>0</D></Selected>
<Text>useSParameter = 1;&#x000D;&#x000A;&#x000D;&#x000A;if useSParameter == 1&#x000D;&#x000A;&#x0009;using(&apos;8x8_array_touchstone.s64p&apos;);&#x000D;&#x000A;&#x0009;couplingMtx = squeeze(S);&#x000D;&#x000A;&#x0009;couplingMtx = couplingMtx - couplingMtx .* eye(64) + eye(64);&#x000D;&#x000A;&#x0009;setdisplayunit(couplingMtx,&apos;&apos;);&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;% column major ordering of locations for 8x8 URA&#x000D;&#x000A;&#x0009;numAntsX = 8;&#x000D;&#x000A;&#x0009;numAntsY = 8;&#x000D;&#x000A;&#x0009;numAnts = numAntsX * numAntsY;&#x000D;&#x000A;&#x0009;distanceX = 0.5; %in wavelength&#x000D;&#x000A;&#x0009;distanceY = 0.5; %in wavelength&#x000D;&#x000A;&#x0009;dBDownPerWavelength = 30;&#x000D;&#x000A;&#x0009;dBThreshold = -100;&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;[locationX, locationY] = meshgrid([0:numAntsX]*distanceX, [0:numAntsY]*distanceY);&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;%couplingMtx(m,n) represents the complex coupling coefficient from the n-th antenna element to the m-th antenna element&#x000D;&#x000A;&#x0009;couplingMtx = eye(numAnts); %default coupling matrix as identify matrix&#x000D;&#x000A;&#x0009;for n = 1 : numAnts&#x000D;&#x000A;&#x0009;&#x0009;for m = 1 : numAnts&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;distanceInWavelength = sqrt((locationX(n) - locationX(m))^2 + (locationY(n) - locationY(m))^2);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;if ( distanceInWavelength * -dBDownPerWavelength &gt; dBThreshold )&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;couplingMtx(m,n) = 10^(distanceInWavelength * -dBDownPerWavelength / 20);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x000D;&#x000A;</Text>
