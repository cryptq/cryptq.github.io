<Item XName="ActiveLoading" Type="PartParam">
<DataEntry>0</DataEntry>
<Default><T>Bool</T><D>1</D></Default>
<Description>Antenna array mutual coupling option</Description>
<Enum>ActiveLoading</Enum>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="ActiveReflectionCoefs" Type="PartParam">
<DataEntry />
<Default><T>Bool</T><D>1</D></Default>
<Description>Active reflection coefficients of phased array antenna elements</Description>
<HideCondition>(ActiveLoading &lt; 4) | (ActiveLoading &gt; 4)</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>15</D></Validate></Item>
<Item XName="AntennaEfficiency" Type="PartParam">
<DataEntry>0</DataEntry>
<Default><T>Bool</T><D>1</D></Default>
<Description>Antenna efficiency</Description>
<Show><T>Bool</T><D>0</D></Show>
<Unit><T>Int</T><D>15001</D></Unit>
<Validate><T>Int</T><D>14</D></Validate></Item>
<Item XName="AntennaEfficiencyFreq" Type="PartParam">
<DataEntry />
<Default><T>Bool</T><D>1</D></Default>
<Description>Frequency for frequency dependent antenna efficiency</Description>
<Show><T>Bool</T><D>0</D></Show>
<Unit><T>Int</T><D>33771</D></Unit>
<Validate><T>Int</T><D>14</D></Validate></Item>
<Item XName="ArrayRadiation" Type="PartParam">
<DataEntry>1</DataEntry>
<Description>Array radiation region for directivity beam pattern integration</Description>
<Enum>ArrayRadiation</Enum>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="AxialRatio" Type="PartParam">
<DataEntry>[2]</DataEntry>
<Default><T>Bool</T><D>1</D></Default>
<Description>Axial ratio of elliptical polarization. Should be &gt; 1.0</Description>
<HideCondition>(ElementPatternType &gt; 2) | (ElementPolarizationFormat ~= 2)</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>14</D></Validate></Item>
<Item XName="CenterArrayAtOrigin" Type="PartParam">
<DataEntry>0</DataEntry>
<Default><T>Bool</T><D>1</D></Default>
<Description>Center array at origin</Description>
<Enum>NO_YES</Enum>
<HideCondition>~(Configuration == 1 | Configuration == 2 | Configuration == 4 | Configuration == 5)</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="Configuration" Type="PartParam">
<DataEntry>2</DataEntry>
<Default><T>Bool</T><D>1</D></Default>
<Description>Antenna array configuration</Description>
<Enum>AntConfig</Enum>
<Validate><T>Int</T><D>16</D></Validate></Item>
<Item XName="CosineExponent" Type="PartParam">
<DataEntry>1</DataEntry>
<Default><T>Bool</T><D>1</D></Default>
<Description>The cosine antenna element pattern is cos(theta)^CosineExponent</Description>
<HideCondition>(ElementPatternType &lt; 2) | (ElementPatternType &gt; 2)</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="CouplingMatrix" Type="PartParam">
<DataEntry />
<Default><T>Bool</T><D>1</D></Default>
<Description>Mutual coupling matrix</Description>
<HideCondition>(ActiveLoading &lt; 1) | (ActiveLoading &gt; 1)</HideCondition>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>15</D></Validate></Item>
<Item XName="CustomFailure" Type="PartParam">
<DataEntry>[1]</DataEntry>
<Default><T>Bool</T><D>1</D></Default>
<Description>Custom element failure specification (0 signifies element failure; 1 signifies element working properly)</Description>
<HideCondition>(ElementFailure &lt; 2) | (ElementFailure &gt; 2)</HideCondition>
