<Item XName="SystemLevel_Parameters" UserName="SystemLevel_Parameters" Type="Equation">
<AutoCalc><T>Bool</T><D>1</D></AutoCalc>
<Selected><T>Bool</T><D>0</D></Selected>
<Text>%% Platform/Target Parameters&#x000D;&#x000A;RadarPos = [0 0 1500];&#x000D;&#x000A;RadarVel = 0;&#x000D;&#x000A;&#x000D;&#x000A;TarNum = 1;&#x000D;&#x000A;ScatterLoc = [0 0 0];&#x000D;&#x000A;TarPos = [0 0.02 1500]&#x000D;&#x000A;&#x000D;&#x000A;%% Radar System_Parameters&#x000D;&#x000A;C = 3e8;&#x000D;&#x000A;SampleRate = 4e6;&#x000D;&#x000A;Fc = 10e9;&#x000D;&#x000A;Lamda = C/Fc;&#x000D;&#x000A;&#x000D;&#x000A;PRI = 100e-6;&#x000D;&#x000A;PulseWidth = 10e-6;&#x000D;&#x000A;BandWidth = 2e6;&#x000D;&#x000A;&#x000D;&#x000A;%% Beam Tuning Parameters&#x000D;&#x000A;FRxTx = Fc; % Same as carrier frequency&#x000D;&#x000A;beamTheta_Tx = 0;%tune(9); %deg&#x000D;&#x000A;beamPhi_Tx = 0;%tune(0); %deg&#x000D;&#x000A;&#x000D;&#x000A;beamTheta_Rx = 0;%tune(9); %deg&#x000D;&#x000A;beamPhi_Rx = 0;%tune(0); %deg&#x000D;&#x000A;&#x000D;&#x000A;%% RF System-Level Parameters&#x000D;&#x000A;&#x000D;&#x000A;Tx_Gain = 50; % in dB&#x000D;&#x000A;Rx_Gain = 50; % in dB&#x000D;&#x000A;&#x000D;&#x000A;%% Antenna Array Parameters&#x000D;&#x000A;NumEl = 8;%tune(8);&#x000D;&#x000A;NumEl_Total = NumEl*NumEl;&#x000D;&#x000A;&#x000D;&#x000A;%% Signal Processing Parameters&#x000D;&#x000A;FFTSize = 1024; %% Pulse Compression FFTSize&#x000D;&#x000A;CPI_Num = 32;&#x000D;&#x000A;&#x000D;&#x000A;PRI_Sample_Num = PRI * SampleRate;&#x000D;&#x000A;CPI_Sample_Num = PRI_Sample_Num*CPI_Num;&#x000D;&#x000A;&#x000D;&#x000A;%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%&#x000D;&#x000A;%% Old Code below for further reorg&#x000D;&#x000A;% ArrayState = tune(1);   &#x0009;&#x0009;&#x0009;% 1 - Rx, 2 - Tx&#x0009;&#x0009;&#x0009;   &#x0009;&#x0009;&#x000D;&#x000A;%ArrayState_Tx = 2;&#x000D;&#x000A;%ArrayState_Rx = 1;&#x000D;&#x000A;&#x000D;&#x000A;RxPwrDensity_dBm = -50;&#x0009;&#x0009;&#x0009;&#x0009;% dBm&#x000D;&#x000A;%&#x000D;&#x000A;%&#x000D;&#x000A;%SpeedOfLight = 299792458;&#x0009;&#x0009;&#x0009;% m / s&#x000D;&#x000A;%WaveLength = SpeedOfLight / (FRxTx * 1e9);&#x000D;&#x000A;%RxPwrIn_Watts = 10^( ( RxPwrDensity_dBm - 30 ) / 10 ) * WaveLength^2 / ( 4 * pi );&#x000D;&#x000A;&#x000D;&#x000A;RxPwrIn_Watts = 10^( ( RxPwrDensity_dBm - 30 ) / 10 ) * Lamda^2 / ( 4 * pi );&#x000D;&#x000A;RxPwrIn_dBm = dbm( RxPwrIn_Watts);&#x000D;&#x000A;%&#x000D;&#x000A;%PhiCutAngle = tune(0);</Text>
