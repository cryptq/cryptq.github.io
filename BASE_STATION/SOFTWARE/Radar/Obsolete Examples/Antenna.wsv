<Item XName="Notes" UserName="Notes" Type="Notes">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>&lt;FONT color=#ff0000&gt;&amp;nbsp;&lt;/FONT&gt; &#x000D;&#x000A;&lt;P class=MsoTitle style=&quot;BORDER-TOP: medium none; BORDER-RIGHT: medium none; BORDER-BOTTOM: windowtext 0.75pt solid; PADDING-BOTTOM: 1pt; PADDING-TOP: 0in; PADDING-LEFT: 0in; MARGIN: 0in 0in 0pt; BORDER-LEFT: medium none; PADDING-RIGHT: 0in&quot; align=center&gt;&lt;FONT color=#000000 size=5&gt;&lt;SPAN style=&quot;FONT-SIZE: 18pt; FONT-FAMILY: Arial&quot;&gt;&lt;STRONG&gt;Antenna Pattern&lt;/STRONG&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoBodyText style=&quot;MARGIN: 0in 0in 0pt&quot; align=center&gt;&lt;FONT color=#000000 size=2&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: Arial; mso-bidi-font-size: 12.0pt&quot;&gt;Keysight Technologies SystemVue Example Workspace&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoBodyText style=&quot;MARGIN: 0in 0in 0pt&quot; align=center&gt;&lt;FONT size=2&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: Arial; mso-bidi-font-size: 12.0pt&quot;&gt;&lt;/SPAN&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; mso-bidi-font-size: 12.0pt&quot;&gt;&lt;?xml:namespace prefix = &quot;o&quot; /&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;FONT color=#000000&gt;&amp;nbsp;&lt;/FONT&gt;&lt;/P&gt;&lt;/FONT&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: Arial; mso-bidi-font-size: 12.0pt&quot;&gt;&lt;FONT size=2&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: Arial; mso-bidi-font-size: 12.0pt&quot;&gt;&lt;/SPAN&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: center; MARGIN: 0in 0in 0pt&quot; align=center&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: Arial; mso-bidi-font-size: 12.0pt&quot;&gt;&lt;FONT color=#000000&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: center; MARGIN: 0in 0in 0pt&quot; align=center&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; mso-bidi-font-size: 12.0pt&quot;&gt;&lt;FONT color=#000000&gt;&lt;?xml:namespace prefix = &quot;o&quot; ns = &quot;urn:schemas-microsoft-com:office:office&quot; /&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoBodyText style=&quot;MARGIN: 0in 0in 0pt&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;&lt;FONT color=#000000 size=4&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/P&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;&lt;FONT size=4&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 10pt&quot;&gt;&lt;FONT color=#000000&gt;&lt;/FONT&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 10pt&quot;&gt;&lt;FONT color=#000000 face=Calibri&gt;&lt;STRONG&gt;************************************************&lt;/STRONG&gt;&lt;/FONT&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 10pt&quot;&gt;&lt;FONT color=#000000 size=4 face=Calibri&gt;&lt;STRONG&gt;Simulation Task &lt;/STRONG&gt;&lt;/FONT&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 10pt&quot;&gt;&lt;FONT color=#000000 face=Calibri&gt;&lt;STRONG&gt;************************************************&lt;/STRONG&gt;&lt;/FONT&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 10pt&quot;&gt;&lt;FONT color=#000000 face=Calibri&gt;This example shows how to generate the antenna pattern with RADAR_AntennaTx model. (RADAR_AntennaRx is another model which is used at the receiver). &lt;/FONT&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 10pt&quot;&gt;&lt;FONT color=#000000 face=Calibri&gt;&lt;/FONT&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt&quot;&gt;&lt;FONT size=4&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 10pt&quot;&gt;&lt;FONT color=#000000 face=Calibri&gt;&lt;/FONT&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 10pt&quot;&gt;&lt;FONT color=#000000 face=Calibri&gt;&lt;STRONG&gt;************************************************&lt;/STRONG&gt;&lt;/FONT&gt;&lt;/P&gt;&lt;FONT size=4&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 10pt&quot;&gt;&lt;FONT color=#000000 size=4 face=Calibri&gt;&lt;STRONG&gt;Workspace Description&lt;/STRONG&gt;&lt;/FONT&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 10pt&quot;&gt;&lt;/FONT&gt;&lt;FONT color=#000000 face=Calibri&gt;************************************************&lt;/FONT&gt;&lt;/P&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/SPAN&gt;&#x000D;&#x000A;&lt;P&gt;&lt;FONT face=Calibri&gt;Two MATLAB Script models are used to scan the elevation and azimuth angles of main beam in order to get the antenna pattern.&lt;/FONT&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P&gt;&lt;FONT face=Calibri&gt;The different weighting window functions and scan mode can be selected from the parameter list.&lt;/FONT&gt;&lt;/P&gt;</Text>
<Item XName="Page" Type="PageMgr">
<Item XName="Display0" Type="NotesDisp">
<DVport><T>Array_Dbl64</T><D>1;4;;;O424;qo14</D></DVport>
<PVPort><T>Array_Dbl64</T><D>1;4;;;BhhikoOh134;uSYl9{dKm24</D></PVPort>
<Show><T>Bool</T><D>1</D></Show>
<ShowCmd><T>Int</T><D>1</D></ShowCmd>
<Window><T>Array_I64</T><D>1;4;;;WA;N5</D></Window>
<ZOrder><T>Int</T><D>1</D></ZOrder></Item></Item></Item>
<Item XName="Page" Type="PageMgr" /></Item>
<Item XName="Equation1" UserName="Equation1" Type="Equation">
<AutoCalc><T>Bool</T><D>0</D></AutoCalc>
<Selected><T>Bool</T><D>0</D></Selected>
<Text>using(&apos;Design1_Data&apos;);&#x000D;&#x000A;&#x000D;&#x000A;%% get Pattern &#x000D;&#x000A;pattern_re = real(Pattern);&#x000D;&#x000A;pattern_im = imag(Pattern);&#x000D;&#x000A;pattern = pattern_re + j * pattern_im;&#x000D;&#x000A;%% reshape pattern to specific size&#x000D;&#x000A;pattern_mat = reshape(pattern, 180, 360);&#x000D;&#x000A;&#x000D;&#x000A;%% elevation and azimuth angle range in degrees&#x000D;&#x000A;elv = [-90 : 89];&#x000D;&#x000A;azm = [-180 : 179];&#x000D;&#x000A;&#x000D;&#x000A;%% plot circular Scan pattern&#x000D;&#x000A;[T P] = meshgrid(elv, azm);&#x000D;&#x000A;&#x000D;&#x000A;%% manually convert to cartesian coordinates&#x000D;&#x000A;u = sin(T/180*pi) .* cos(P/180*pi);&#x000D;&#x000A;v = sin(T/180*pi) .* sin(P/180*pi);&#x000D;&#x000A;w = cos(T/180*pi);&#x000D;&#x000A;&#x000D;&#x000A;Pattern_figure = graph_figure(&apos;Antenna Pattern&apos;);&#x000D;&#x000A;Pattern_figure.add_mesh_data(u,v,abs(pattern_mat).&apos;);&#x000D;&#x000A;Pattern_figure.set_label_x(&apos;horizontal&apos;);&#x000D;&#x000A;Pattern_figure.set_label_y(&apos;vertical&apos;);&#x000D;&#x000A;Pattern_figure.set_label_z(&apos;amplitude&apos;);&#x000D;&#x000A;&#x000D;&#x000A;%% reduce workspace size by clearing temporary variables&#x000D;&#x000A;clear u v w T P</Text>
<UnitUse><T>Int</T><D>2</D></UnitUse>
<Item XName="BPMgr" Type="BPMgr">
<BPLines><T>Empty</T></BPLines>
<BPStates><T>Empty</T></BPStates></Item>
<Item XName="EqnBlock" Type="EqnBlock">
<Lang><T>Int</T><D>1</D></Lang></Item>
<Item XName="Font" Type="Font">
<Name>Courier New</Name>
<Size><T>Double</T><D>125</D></Size></Item>
<Item XName="FunctionBlock" Type="FunctionBlock" />
<Item XName="Page" Type="PageMgr">
<Item XName="Display0" Type="EquationDisp">
<DVport><T>Array_Dbl64</T><D>1;4;;;q224;mU14</D></DVport>
<PVPort><T>Array_Dbl64</T><D>1;4;;;uSYl9{dK034;7ERumXVhQ24</D></PVPort>
<Show><T>Bool</T><D>0</D></Show>
<ShowCmd><T>Int</T><D>1</D></ShowCmd>
<Split><T>Double</T><D>0.3</D></Split>
<Split2><T>Double</T><D>0.1664374140302614</D></Split2>
<Window><T>Array_I64</T><D>1;4;k9;;RJ;b2</D></Window>
<ZOrder><T>Int</T><D>6</D></ZOrder></Item></Item>
<Item XName="VarBlock" Type="VarBlock" /></Item>
<Item XName="Equation2" UserName="Equation2" Type="Equation">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>using(&apos;Design1_Data&apos;);&#x000D;&#x000A;&#x000D;&#x000A;%% reshape pattern to specific size&#x000D;&#x000A;pattern_mat = (reshape(pattern, 180, 360));&#x000D;&#x000A;&#x000D;&#x000A;Pattern_figure = graph_figure(&apos;Antenna Pattern Spherical_1&apos;);&#x000D;&#x000A;Pattern_figure.add_spherical_data(abs(pattern_mat),&apos;Amplitude&apos;);&#x000D;&#x000A;&#x000D;&#x000A;Pattern_figure = graph_figure(&apos;Antenna Pattern Spherical_2&apos;);&#x000D;&#x000A;[azm,elv]      = meshgrid( (-180:179)*pi/180,(-90:89)*pi/180 );&#x000D;&#x000A;Pattern_figure.add_spherical_data(azm,elv,abs(pattern_mat),&apos;Amplitude&apos;);&#x000D;&#x000A;&#x000D;&#x000A;clear azm elv pattern_mat</Text>
