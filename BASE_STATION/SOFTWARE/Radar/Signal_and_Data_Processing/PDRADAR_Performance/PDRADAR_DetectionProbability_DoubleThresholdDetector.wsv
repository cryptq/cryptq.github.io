<Item XName="Equations" Type="Equation">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>%% ---- VAR_Src&#x000D;&#x000A;fs=BB_SamplingRate;&#x000D;&#x000A;SamplesPerPulse=PulseWidth*fs;&#x000D;&#x000A;PRI_Num=floor(PRI*fs);&#x000D;&#x000A;f0=0;&#x000D;&#x000A;&#x000D;&#x000A;Sample_Num = PRI_Num*10;&#x000D;&#x000A;Target_Pos = ceil(Distance*2/3e8*BB_SamplingRate)+1;&#x000D;&#x000A;&#x000D;&#x000A;FFTSize = 2^ceil(log2(PRI*fs + PulseWidth*fs));&#x000D;&#x000A;%% ---- VAR_ENV&#x000D;&#x000A;DurationTime=PRI;&#x000D;&#x000A;&#x000D;&#x000A;%% ---- VAR_SNR&#x000D;&#x000A;c=3e8;&#x000D;&#x000A;WaveLen=c/RF_Freq;&#x000D;&#x000A;&#x000D;&#x000A;if (floor(IncludeProp)&lt;1)&#x000D;&#x000A;&#x0009;PropEffect=1;&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;PropEffect=8*pi*sqrt(pi)*(Distance^2)/WaveLen&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;Gain=1e3;&#x000D;&#x000A;%SNR=-16;&#x000D;&#x000A;CNR=10;&#x000D;&#x000A;DefaultRIn = 50;&#x000D;&#x000A;P_Lin=Gain^2/2/DefaultRIn/(PropEffect^2);&#x000D;&#x000A;P_dBm=10*log10(P_Lin)+30;&#x000D;&#x000A;N_dBm=P_dBm-SNR;&#x000D;&#x000A;Pc_dBm=N_dBm+CNR;&#x000D;&#x000A;NDensity=N_dBm-10*log10(BandWidth);&#x000D;&#x000A;Gain_AGC=PropEffect/Gain;&#x000D;&#x000A;Pc_Lin=10^(Pc_dBm/10-3);&#x000D;&#x000A;&#x000D;&#x000A;% Gain_Clutter=sqrt(Pc_Lin*2*DefaultRIn);&#x000D;&#x000A;&#x000D;&#x000A;%N_stddev = sqrt(10^(N_dBm / 10) / 2);&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;</Text>
<UnitUse><T>Int</T><D>2</D></UnitUse>
