<Item XName="Equations" Type="Equation">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>% Initialization&#x000D;&#x000A;&#x000D;&#x000A;RatesIn = 1;&#x000D;&#x000A;RatesOut = 1;&#x000D;&#x000A;&#x000D;&#x000A;UpSample_Option = 1; % FIR based anti-aliasing fitlering&#x000D;&#x000A;&#x000D;&#x000A;Ratio = BB_UpSamplingRatio;&#x000D;&#x000A;Alpha = RC_ExcessBW;&#x000D;&#x000A;if (Ratio==1)&#x000D;&#x000A;&#x0009;RaisedCosineCoe = [1];&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;RaisedCosineCoe = Ratio*firrcos(20*Ratio,1,Alpha,2*Ratio,&apos;rolloff&apos;);&#x000D;&#x000A;end</Text>
<UnitUse><T>Int</T><D>2</D></UnitUse>
