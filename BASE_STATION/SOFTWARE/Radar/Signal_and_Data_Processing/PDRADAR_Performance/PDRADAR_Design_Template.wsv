<Item XName="Equation1" UserName="Equation1" Type="Equation">
<AutoCalc><T>Bool</T><D>0</D></AutoCalc>
<Selected><T>Bool</T><D>0</D></Selected>
<Text>PRI_Num = 5000;&#x000D;&#x000A;FFT_Size = 16;&#x000D;&#x000A;PRI = 5e-4;&#x000D;&#x000A;RF_Freq = 1e9;&#x000D;&#x000A;c = 3e8;&#x000D;&#x000A;range_max = c*PRI/2;&#x000D;&#x000A;fd_max = 1/PRI/2;&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;using(&apos;Design2 Analysis_Data&apos;);&#x000D;&#x000A;rd_mtx = reshape( abs(PD_Out), PRI_Num, FFT_Size );&#x000D;&#x000A;dopplerspec = rd_mtx;&#x000D;&#x000A;dopplerspec_dB = 20*log10(abs(rd_mtx));&#x000D;&#x000A;&#x000D;&#x000A;r_axis = [0:PRI_Num-1]/PRI_Num*range_max;&#x000D;&#x000A;v_axis = [[0:FFT_Size/2-1],[-FFT_Size/2:-1]] / (FFT_Size/2)*fd_max * c / 2 / RF_Freq;&#x000D;&#x000A;&#x000D;&#x000A;[r, d] = find( rd_mtx == max(max(rd_mtx)) );&#x000D;&#x000A;%convert from matlab 1-start-index to 0-start-index&#x000D;&#x000A;r = r-1;&#x000D;&#x000A;d = d-1;&#x000D;&#x000A;d1=d % this will be used to plot range.&#x000D;&#x000A;range = r / PRI_Num * range_max;&#x000D;&#x000A;&#x000D;&#x000A;%assume FFT_Size is an even number&#x000D;&#x000A;if d &gt;= FFT_Size/2&#x000D;&#x000A;&#x0009;d = -(FFT_Size - d);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;fd = d / (FFT_Size/2) * fd_max;&#x000D;&#x000A;if fd &gt; 1 / (2*PRI)&#x000D;&#x000A;&#x0009;velocity = c * fd / 2 / RF_Freq - c / 2 / PRI / RF_Freq;&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;velocity = c * fd / 2 / RF_Freq;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;graph1 = graph_figure(&apos;PD Result&apos;);&#x000D;&#x000A;graph1.add_surface_data(v_axis, r_axis, rd_mtx);&#x000D;&#x000A;graph1.set_label_x(&apos;Velocity (m/s)&apos;);&#x000D;&#x000A;graph1.set_label_y(&apos;Range (x10 Km)&apos;);&#x000D;&#x000A;</Text>
<UnitUse><T>Int</T><D>2</D></UnitUse>
