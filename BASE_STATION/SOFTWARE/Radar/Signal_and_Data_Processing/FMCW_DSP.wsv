<Item XName="Equations" Type="Equation">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>%Basic parameter&#x000D;&#x000A;Wavelength = 3e8 / fc;&#x000D;&#x000A;&#x000D;&#x000A;%Tx and Rx Gain&#x000D;&#x000A;GainTx = 1;&#x000D;&#x000A;&#x000D;&#x000A;%PropEffect&#x000D;&#x000A;PropEffect=8*pi*sqrt(pi)*(Distance^2)/Wavelength;&#x000D;&#x000A;&#x000D;&#x000A;DefaultRIn = 50;&#x000D;&#x000A;P_Lin=GainTx^2/2/DefaultRIn/(PropEffect^2);&#x000D;&#x000A;P_dBm=10*log10(P_Lin)+30;&#x000D;&#x000A;N_dBm=P_dBm-SNR;&#x000D;&#x000A;NoiseDensity=N_dBm-10*log10(Bandwidth);&#x000D;&#x000A;</Text>
<UnitUse><T>Int</T><D>2</D></UnitUse>
