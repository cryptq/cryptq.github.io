<Item XName="Equation1" UserName="Equation1" Type="Equation">
<AutoCalc><T>Bool</T><D>0</D></AutoCalc>
<Selected><T>Bool</T><D>0</D></Selected>
<Text>using(&apos;Design1 Analysis2_Design2_Data&apos;);&#x000D;&#x000A;velocity1 = velocity(end);&#x000D;&#x000A;range1 = range(end);&#x000D;&#x000A;&#x000D;&#x000A;PRI = 1e-5;&#x000D;&#x000A;fs = 100e6;&#x000D;&#x000A;&#x000D;&#x000A;%PRI_Sample_Num = floor(PRI * fs);&#x000D;&#x000A;FFTSize = 1024;&#x000D;&#x000A;CPI_Num = 256;&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;PD_Result_re = real(mtd_up);&#x000D;&#x000A;PD_Result_im = imag(mtd_up);&#x000D;&#x000A;&#x000D;&#x000A;wavelength = 3e8 / 77e9;&#x000D;&#x000A;PRF = 1 / PRI;&#x000D;&#x000A;&#x000D;&#x000A;PD_result_cplx = PD_Result_re + j * PD_Result_im;&#x000D;&#x000A;PD_result_mat = reshape(PD_result_cplx, FFTSize, CPI_Num);&#x000D;&#x000A;&#x000D;&#x000A;y = [0 : FFTSize - 1];&#x000D;&#x000A;velocity = ([0:CPI_Num-1]) / CPI_Num * PRF * wavelength / 2;&#x000D;&#x000A;graph1 = graph_figure(&apos;MTD Result&apos;);&#x000D;&#x000A;graph1.add_surface_data(velocity, y ,abs(PD_result_mat));&#x000D;&#x000A;graph1.set_label_x(&apos;Velocity&apos;);&#x000D;&#x000A;graph1.set_label_y(&apos;PRF&apos;);&#x000D;&#x000A;graph1.set_label_z(&apos;Amplitide&apos;);</Text>
<UnitUse><T>Int</T><D>2</D></UnitUse>
