<ShortSymbol />
<Symbol>AutoSymDF{MATLAB_SCRIPT_LOGO}</Symbol>
<Item XName="ModelsParamSet" Type="ModelsParamSet">
<Item XName="ModelSet_0" Type="ModelListEntry">
<Indentifier />
<ModelName>MATLAB_Script@Data Flow Models</ModelName>
<SymbolName>AutoSymDF{MATLAB_SCRIPT_LOGO}</SymbolName>
<Item XName="ParamSet" Type="ParamSet">
<Item XName="Bandwidth" Type="PartParam">
<Custom><T>Bool</T><D>1</D></Custom>
<DataEntry>Bandwidth</DataEntry>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="CPI_Num" Type="PartParam">
<Custom><T>Bool</T><D>1</D></Custom>
<DataEntry>CPI_Num</DataEntry>
<Unit><T>Int</T><D>0</D></Unit>
<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="EquationBP" Type="PartParam">
<DataEntry>[]</DataEntry>
<Description>Equation Breakpoints</Description>
<DocSymbol />
<IsSettable><T>Bool</T><D>0</D></IsSettable>
<Range />
<RunTimeTunable><T>Bool</T><D>0</D></RunTimeTunable>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>5</D></Validate></Item>
<Item XName="EquationBPStates" Type="PartParam">
<DataEntry>[]</DataEntry>
<Description>Equation Breakpoint States</Description>
<DocSymbol />
<IsSettable><T>Bool</T><D>0</D></IsSettable>
<Range />
<RunTimeTunable><T>Bool</T><D>0</D></RunTimeTunable>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>5</D></Validate></Item>
<Item XName="EquationSet" Type="PartParam">
<DataEntry />
<Description>Flags that we need a right-click &quot;Edit Equations&quot; menu</Description>
<DocSymbol />
<IsSettable><T>Bool</T><D>0</D></IsSettable>
<Range />
<RunTimeTunable><T>Bool</T><D>0</D></RunTimeTunable>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>4</D></Validate></Item>
<Item XName="EquationText" Type="PartParam">
<DataEntry>max_val = max(input);&#x000D;&#x000A;&#x000D;&#x000A;idx = find(max_val == input(:))-1;&#x000D;&#x000A;doppler_bin = floor(idx/PRI_Sample);&#x000D;&#x000A;range_bin = idx - (doppler_bin)*PRI_Sample;&#x000D;&#x000A;&#x000D;&#x000A;PRF = 1 / PRI;&#x000D;&#x000A;&#x000D;&#x000A;if (doppler_bin &gt; CPI_Num / 2)&#x000D;&#x000A;&#x0009;doppler_bin = doppler_bin - CPI_Num;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;fd = doppler_bin / CPI_Num * PRF;&#x000D;&#x000A;&#x000D;&#x000A;wavelength = 3e8 / fc;&#x000D;&#x000A;velocity = fd * wavelength / 2.0;&#x000D;&#x000A;&#x000D;&#x000A;if (range_bin &gt; PRI_Sample/2)&#x000D;&#x000A;&#x0009;range_bin = PRI_Sample - range_bin;&#x000D;&#x000A;end&#x000D;&#x000A;range_df = range_bin / PRI_Sample * fs ;&#x000D;&#x000A;&#x000D;&#x000A;range_f = range_bin / PRI_Sample * fs;&#x000D;&#x000A;range = range_f * 3e8 * (PRI/2) / (2 * Bandwidth);&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;</DataEntry>
<Description>Equation Text to Parse, edited in the equation set</Description>
<DocSymbol />
<IsSettable><T>Bool</T><D>0</D></IsSettable>
<Range />
<RunTimeTunable><T>Bool</T><D>0</D></RunTimeTunable>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>4</D></Validate></Item>
<Item XName="IOInfo" Type="PartParam">
<DataEntry>input?1?0?floor(FFTSize*CPI_Num)?17#velocity?0?0?1?17#range?0?0?1?17#</DataEntry>
<Description>IO Port Info</Description>
<DocSymbol />
<IsSettable><T>Bool</T><D>0</D></IsSettable>
<Range />
<RunTimeTunable><T>Bool</T><D>0</D></RunTimeTunable>
<Show><T>Bool</T><D>0</D></Show>
<Validate><T>Int</T><D>4</D></Validate></Item>
