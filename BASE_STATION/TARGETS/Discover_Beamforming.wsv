<Data><T>Double</T><D>7.152066466270222e-13</D></Data></Item>
<Item XName="RxPwrIn_dBm" Type="Variable">
<Creator>Constants</Creator>
<Data><T>Double</T><D>-91.45568458166241</D></Data></Item>
<Item XName="SpeedOfLight" Type="Variable">
<Creator>Constants</Creator>
<Data><T>Double</T><D>299792458</D></Data></Item>
<Item XName="WaveLength" Type="Variable">
<Creator>Constants</Creator>
<Data><T>Double</T><D>0.0299792458</D></Data></Item>
