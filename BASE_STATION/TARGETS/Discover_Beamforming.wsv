<Creator>PlotPattern</Creator>
<Data><T>Array_Char64</T><D>2;12;1;21;b1;X1;j1;G1;X1;q1;q1;b1;o1;k1;n</D></Data></Item>
<Item XName="beamPhi" Type="Variable">
