<Item XName="Tune7" Type="TuneParam">
<Param>WorkspaceVariables\VarBlock\beamPhi</Param></Item>
<Item XName="Tune8" Type="TuneParam">
<Param>WorkspaceVariables\VarBlock\beamTheta</Param></Item></Item>
