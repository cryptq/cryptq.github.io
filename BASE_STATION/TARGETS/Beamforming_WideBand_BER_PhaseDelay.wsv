<Item XName="Equations" Type="Equation">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>% ---------------------------------- FREQUENTLY USED PARAMETERS --------------------------------&#x000D;&#x000A;% one typical setting for comparison between theoretical QPSK BER and OFDM-based QPSK BER in HBF system&#x000D;&#x000A;fc = 28.5e9; % carrier frequency&#x000D;&#x000A;BaseSampleRate = 2e9; % sampling rate without oversampling&#x000D;&#x000A;OversamplingRatio = 0; % oversampling ratio&#x000D;&#x000A;fs = BaseSampleRate*2^OversamplingRatio; % sampling rate, it&apos;s also bandwidth when oversampling ratio is 1&#x000D;&#x000A;% [1] number of streams&#x000D;&#x000A;% [2] we recommend the number of streams equals to the number of Tx/Rx side RF Chains&#x000D;&#x000A;NumOfStreams = 1; % current, the number of RF links need equal to NumOfStreams&#x000D;&#x000A;% Tx Antenna Array Placement&#x000D;&#x000A;NumOfTxAntx = 1; % number of antennas in x-axis direction in Tx&#x000D;&#x000A;NumOfTxAnty = 4; % number of antennas in y-axis direction in Tx&#x000D;&#x000A;NumOfTxAntz = 4; % number of antennas in z-axis direction in Tx&#x000D;&#x000A;Nt = NumOfTxAntx * NumOfTxAnty * NumOfTxAntz; % overall antenna number in Tx&#x000D;&#x000A;TxBearingAngle = zeros(Nt,1); % Bearing angle for antenna element pattern coordinate rotation&#x000D;&#x000A;TxDowntiltAngle = zeros(Nt,1); % Downtilt angle for antenna element pattern coordinate rotation&#x000D;&#x000A;TxSlantAngle = zeros(Nt,1); % Slant angle for antenna element pattern coordinate rotation&#x000D;&#x000A;% Rx Antenna Array Placement&#x000D;&#x000A;NumOfRxAntx = 1; % number of antennas in x-axis direction in Rx&#x000D;&#x000A;NumOfRxAnty = 4; % number of antennas in y-axis direction in Rx&#x000D;&#x000A;NumOfRxAntz = 1; % number of antennas in z-axis direction in Rx&#x000D;&#x000A;Nr = NumOfRxAntx * NumOfRxAnty * NumOfRxAntz; % overall antenna number in Rx&#x000D;&#x000A;RxBearingAngle = zeros(Nr,1); % Bearing angle for antenna element pattern coordinate rotation&#x000D;&#x000A;RxDowntiltAngle = zeros(Nr,1); % Downtilt angle for antenna element pattern coordinate rotation&#x000D;&#x000A;RxSlantAngle = zeros(Nr,1); % Slant angle for antenna element pattern coordinate rotation&#x000D;&#x000A;% [1] for easy comparison&#x000D;&#x000A;% [2] since there is beamforming gains in Tx/Rx side&#x000D;&#x000A;%     we introduce the parameter to shift the BER-SNR curve (subtract the ideal gain from beamforming)&#x000D;&#x000A;%     to compare the theoretical QPSK BER and the BER results in current design&#x000D;&#x000A;BeamformingGain = 10*log10(Nt) + 10*log10(Nr);&#x000D;&#x000A;Preamble1Boost = 28; % power boost for Preamble1 power in dB, which make sure synchronization maintains&#x000D;&#x000A;if Nt&gt;16&#x000D;&#x000A;&#x0009;Preamble1Boost = Preamble1Boost + 10*log10(Nt/16); % power boost adaptive to different Nt&#x000D;&#x000A;end&#x000D;&#x000A;PilotBoost = 6;      % power boost for pilot power in dB   &#x000D;&#x000A;NumFrames = 100;     % number of frames for BER simulation&#x000D;&#x000A;% ------------------------------------- OTHER PARAMETERS ----------------------------------------&#x000D;&#x000A;% ------------------------------------ System Configuration -------------------------------------&#x000D;&#x000A;BBPrecodingEnable = 1;&#x000D;&#x000A;OSR = 2^OversamplingRatio; % &#x000D;&#x000A;NumOfPreamble1Sym = 1; % number of ofdm symbols in Preamble 1 part&#x000D;&#x000A;NumOfDataSym = 16; % number of ofdm symbols in Data part&#x000D;&#x000A;Num_Subcarriers = 64;&#x000D;&#x000A;GuardLowerSubcarriers =2;&#x000D;&#x000A;GuardUpperSubcarriers =1;&#x000D;&#x000A;NumOfDC_Subcarriers =1;&#x000D;&#x000A;Ns = NumOfStreams;&#x000D;&#x000A;LenOfOFDMSym_woCP = Num_Subcarriers;&#x000D;&#x000A;LenOfCP = 16;&#x000D;&#x000A;LenOfOFDM = LenOfOFDMSym_woCP + LenOfCP;&#x000D;&#x000A;% --------------------------------- Antenna Array Configuration ----------------------------------&#x000D;&#x000A;% Tx Antenna Array&#x000D;&#x000A;TxDx = 0.5; TxDy = 0.5; TxDz = 0.5; % antenna spacing in x/y/z-axis direction in Tx&#x000D;&#x000A;Ntrf = Ns; % number of RF Chains in Tx, which need equal to number of streams&#x000D;&#x000A;NumOfTxRFChains = Ntrf;&#x000D;&#x000A;TxAntennaArrayMask = ones(Nt,Ntrf); % configure the connections between each RF chain and each antenna element in Tx&#x000D;&#x000A;%TxAntennaArrayMask = eye(Nt);&#x000D;&#x000A;TxPhaseShifterDistortion = ones(Nt,Ntrf); % antenna calibration error in Txs&#x000D;&#x000A;TxPosition_X = zeros(Nt,1); % antenna position coordinate in x-axis in Tx&#x000D;&#x000A;TxPosition_Y = reshape(repmat(TxDy*[0:NumOfTxAnty-1]&apos;,NumOfTxAntz,1),[],1); % antenna position coordinate in y-axis in Tx&#x000D;&#x000A;TxPosition_Z = kron(TxDz*[0:NumOfTxAntz-1]&apos;,ones(NumOfTxAnty,1)); % antenna position coordinate in z-axis in Tx&#x000D;&#x000A;% Rx Antenna Array&#x000D;&#x000A;RxDx = 0.5; RxDy = 0.5; RxDz = 0.5; % antenna spacing in x/y/z-axis direction in Rx&#x000D;&#x000A;Nrrf = Ntrf; % number of RF Chains in Rx&#x000D;&#x000A;NumOfRxRFChains = Nrrf;&#x000D;&#x000A;RxAntennaArrayMask = ones(Nr,Nrrf); % configure the connections between each RF chain and each antenna element in Rx&#x000D;&#x000A;%RxAntennaArrayMask = eye(Nr);&#x000D;&#x000A;RxPhaseShifterDistortion = ones(Nr,Nrrf); % antenna calibration error in Rx&#x000D;&#x000A;RxPosition_X = zeros(Nr,1); % antenna position coordinate in x-axis in Rx&#x000D;&#x000A;RxPosition_Y = reshape(repmat(RxDy*[0:NumOfRxAnty-1]&apos;,NumOfRxAntz,1),[],1); % antenna position coordinate in y-axis in Rx&#x000D;&#x000A;RxPosition_Z = kron(RxDz*[0:NumOfRxAntz-1]&apos;,ones(NumOfRxAnty,1)); % antenna position coordinate in y-axis in Rx&#x000D;&#x000A;% ----------------------------------------- Pilot Generation for Data Part --------------------------------------&#x000D;&#x000A;Pilot_CarrierIndex =[(-Num_Subcarriers/2+GuardLowerSubcarriers):3:-1,1:3:Num_Subcarriers/2-1-GuardUpperSubcarriers];&#x000D;&#x000A;Pilot_NumOfCarriers = length(Pilot_CarrierIndex);&#x000D;&#x000A;Pilot_Value_t = sign(randn(1,length(Pilot_CarrierIndex)));&#x000D;&#x000A;P_Matrix = hadamard(Ntrf);&#x000D;&#x000A;Pilots_Value_Block =zeros(Ntrf,length(Pilot_CarrierIndex)*NumOfDataSym);&#x000D;&#x000A;for i=1:Ntrf&#x000D;&#x000A;&#x0009;for k =1:NumOfDataSym/Ntrf&#x000D;&#x000A;&#x0009;&#x0009;for j=1:Ntrf&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;Pilots_Value_Block(i,(k-1)*length(Pilot_CarrierIndex)*Ntrf+(j-1)*length(Pilot_CarrierIndex)+1:(k-1)*length(Pilot_CarrierIndex)*Ntrf+j*length(Pilot_CarrierIndex)) = P_Matrix(i,j)*Pilot_Value_t;&#x000D;&#x000A;&#x0009;&#x0009;end&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x0009;&#x0009;&#x000D;&#x000A;Pilots_Values1 = zeros(1,NumOfDataSym*length(Pilot_CarrierIndex)*Ntrf);&#x000D;&#x000A;Pilots_Values1 = reshape(Pilots_Value_Block.&apos;,1,NumOfDataSym*length(Pilot_CarrierIndex)*Ntrf);&#x000D;&#x000A;Pilot1_Seq = Pilots_Values1*10^(PilotBoost/20);  % 10^(PilotBoost/20) boost Tx energy for pilot symbols&#x000D;&#x000A;% ----------------------------------------- Frequency Allocation for Data Part ------------------------------------&#x000D;&#x000A;Data_NumOfCarriers = Num_Subcarriers - GuardLowerSubcarriers - GuardUpperSubcarriers- NumOfDC_Subcarriers - Pilot_NumOfCarriers;&#x000D;&#x000A;AvaliableNumOfCarriers = Num_Subcarriers - GuardLowerSubcarriers - GuardUpperSubcarriers- NumOfDC_Subcarriers;&#x000D;&#x000A;Data_CarrierIndex_t = [(-Num_Subcarriers/2+GuardLowerSubcarriers+1):3:-1,2:3:Num_Subcarriers/2-1-GuardUpperSubcarriers,(-Num_Subcarriers/2+GuardLowerSubcarriers+2):3:-1,3:3:Num_Subcarriers/2-1-GuardUpperSubcarriers];&#x000D;&#x000A;Data_CarrierIndex = sort(Data_CarrierIndex_t);&#x000D;&#x000A;EVM_NumOfCarriers = Num_Subcarriers - GuardLowerSubcarriers - GuardUpperSubcarriers- NumOfDC_Subcarriers;&#x000D;&#x000A;EVM_CarrierIndex = [(-Num_Subcarriers/2+GuardLowerSubcarriers):-1,1:Num_Subcarriers/2-1-GuardUpperSubcarriers];&#x000D;&#x000A;% ------------------------------- FlexOFDM Source Modulation Configuration ----------------------------&#x000D;&#x000A;Data1_MappingType = 1; %for QPSK&#x000D;&#x000A;MappingTable = [1,2,4,6,8,0,3,5,7,9,10,11,12]; % number of bit per each symbol&#x000D;&#x000A;BitsPerSym = MappingTable(Data1_MappingType+1); % number of bits per symbol&#x000D;&#x000A;BitsPerFrame = BitsPerSym; % number of bits per frame&#x000D;&#x000A;BitRate = fs/OSR*BitsPerSym*NumOfStreams; % bit rate&#x000D;&#x000A;SymRate = BitRate/(BitsPerSym*NumOfStreams); % symbol rate&#x000D;&#x000A;BitsPerSampleTime = BitsPerSym * NumOfStreams; % bits number per sample time&#x000D;&#x000A;% -------------------- Generation of Frequency Signal for Preamble 1 and Preamble 2 --------------------&#x000D;&#x000A;Preamble1_Seq = (randn(1,Num_Subcarriers)+ 1i*randn(1,Num_Subcarriers))/sqrt(2);&#x000D;&#x000A;%Here 10^(Preamble1Boost/20) is added to boost Preamble1 to ensure timing synchronization works in lower SNR in the receiver&#x000D;&#x000A;Preamble1_Seq = 10^(Preamble1Boost/20)*repmat(Preamble1_Seq,1,Ntrf); &#x000D;&#x000A;&#x000D;&#x000A;Preamble_CarrierIndex=[-Num_Subcarriers/2:Num_Subcarriers/2-1];&#x000D;&#x000A;&#x000D;&#x000A;FreRefSig = (1-2*(randn(LenOfOFDMSym_woCP,1)&gt;0))+sqrt(-1)*(1-2*(randn(LenOfOFDMSym_woCP,1)&gt;0));&#x000D;&#x000A;FreRefSig_trans = FreRefSig.&apos;;&#x000D;&#x000A;for i = 0:Ntrf-1&#x000D;&#x000A;&#x0009;for j = 0:Nt/Ntrf*Nr/Nrrf-1&#x000D;&#x000A;&#x0009;&#x0009;Preamble2_Seq(i*Nt/Ntrf*Nr/Nrrf*LenOfOFDMSym_woCP + j*LenOfOFDMSym_woCP + [1:LenOfOFDMSym_woCP]) = kron(FreRefSig_trans(i+1:Ntrf:end),circshift([1,zeros(1,Ntrf-1)],[0,i]));&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x000D;&#x000A; &#x000D;&#x000A;BBPrecodingEnable = 1;&#x000D;&#x000A;LenOfPrecodingBlockF = AvaliableNumOfCarriers;&#x000D;&#x000A;LenOfPrecodingBlockT = 16;&#x000D;&#x000A;% ----------------------------- Generation of Tx/Rx training beams -------------------------------------&#x000D;&#x000A;TxTrainingBeam_mtx = exp(-sqrt(-1)*2*pi*[0:Nt-1]&apos;*[0:Nt-1]/Nt); % the pool of Tx training beams&#x000D;&#x000A;TxTrainingBeam_vec = TxTrainingBeam_mtx(:);&#x000D;&#x000A;RxTrainingBeam_mtx = exp(-sqrt(-1)*2*pi*[0:Nr-1]&apos;*[0:Nr-1]/Nr); % the pool of Rx training beams&#x000D;&#x000A;RxTrainingBeam_vec = RxTrainingBeam_mtx(:);&#x000D;&#x000A;% TxBeam for timing seq&#x000D;&#x000A;TxSigBeamForTimingSeq_vec = [1;zeros(Nt-1,1)];&#x000D;&#x000A;% TxBeam for preamble 2&#x000D;&#x000A;TxSigBeamForSounding_vec = zeros(Nt*Ntrf*Nt/Ntrf*Nr/Nrrf,1);&#x000D;&#x000A;for i = 0:Ntrf-1&#x000D;&#x000A;&#x0009;for j = 0:Nt/Ntrf*Nr/Nrrf-1&#x000D;&#x000A;&#x0009;&#x0009;TxSigBeamForSounding_vec(j*Nt*Ntrf+i*Nt+[1:Nt],1) = TxTrainingBeam_mtx(:,i+1+Ntrf*floor(j/(Nr/Nrrf)));&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x000D;&#x000A;% RxBeam for searching and timing seq&#x000D;&#x000A;RxSigBeamForSearch_vec = reshape((repmat([1,zeros(1,Nr-1)],Nrrf,1)).&apos;,[],1);&#x000D;&#x000A;RxSigBeamForTimingSeq_vec = reshape((repmat([1,zeros(1,Nr-1)],Nrrf,OSR*LenOfOFDM*NumOfPreamble1Sym)).&apos;,[],1);&#x000D;&#x000A;% RxBeam for preamble 2&#x000D;&#x000A;RxSigBeamForPreamble2 = zeros(Nrrf,Nr*OSR*LenOfOFDM*Nt/Ntrf*Nr/Nrrf);&#x000D;&#x000A;RxSigBeamForSounding_vec = zeros(Nr*Nrrf*Nt/Ntrf*Nr/Nrrf,1);&#x000D;&#x000A;for i = 0:Nrrf-1&#x000D;&#x000A;&#x0009;for j = 0:Nt/Ntrf*Nr/Nrrf-1&#x000D;&#x000A;&#x0009;&#x0009;RxSigBeamForSounding_vec(j*Nr*Nrrf+i*Nr+[1:Nr],1) = conj(RxTrainingBeam_mtx(:,i+1+Nrrf*mod(j,Nr/Nrrf)));&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end&#x000D;&#x000A;%% -------------------------------------- 1-path channel ---------------------------------------&#x000D;&#x000A;NumberofPath = 1; % number of multiple paths&#x000D;&#x000A;PathDelay = [0]; % time delay for each path in seconds&#x000D;&#x000A;PathPowerindB = [0]; % path power gain in dB&#x000D;&#x000A;PathAoA = [0]; % azimuth angle of arrival in Rx&#x000D;&#x000A;PathAoD = [0]; % azimuth angle of departure in Tx&#x000D;&#x000A;ASofAoA = [0]; % angular spread of AoA in Rx&#x000D;&#x000A;ASofAoD = [0]; % angular spread of AoD in Tx&#x000D;&#x000A;PathZoA = [90]; % zenith angle of arrival in Rx&#x000D;&#x000A;PathZoD = [90]; % zenith angle of departure in Tx&#x000D;&#x000A;ZSofZoA = [0]; % zenith spread of ZoA&#x000D;&#x000A;ZSofZoD = [0]; % zenith spread of ZoD&#x000D;&#x000A;RicianFactorindB = [6]; % Rician Factor in dB&#x000D;&#x000A;XPRindB = -9; % XPR&#x000D;&#x000A;%% normalize PathPowerindB&#x000D;&#x000A;%PathPowerLinear = 10.^(PathPowerindB/10);&#x000D;&#x000A;%PathPowerLinear = PathPowerLinear/sum(PathPowerLinear);&#x000D;&#x000A;%PathPowerindB = 10*log10(PathPowerLinear);&#x000D;&#x000A;% -------------------------------------- 2-path channel ---------------------------------------&#x000D;&#x000A;%NumberofPath = 2; % number of multiple paths&#x000D;&#x000A;%PathDelay = [0,0]; % time delay for each path in seconds&#x000D;&#x000A;%PathPowerindB = [0,-1]; % path power gain in dB&#x000D;&#x000A;%PathAoA = [320,30]; % azimuth angle of arrival in Rx&#x000D;&#x000A;%PathAoD = [330,20]; % azimuth angle of departure in Tx&#x000D;&#x000A;%ASofAoA = [17,17]; % angular spread of AoA in Rx&#x000D;&#x000A;%ASofAoD = [3,3]; % angular spread of AoD in Tx&#x000D;&#x000A;%PathZoA = [70,110]; % zenith angle of arrival in Rx&#x000D;&#x000A;%PathZoD = [60,120]; % zenith angle of departure in Tx&#x000D;&#x000A;%ZSofZoA = [7,7]; % zenith spread of ZoA&#x000D;&#x000A;%ZSofZoD = [3,3]; % zenith spread of ZoD&#x000D;&#x000A;%RicianFactorindB = [6,-999]; % Rician Factor in dB&#x000D;&#x000A;%XPRindB = -9; % XPR&#x000D;&#x000A;%% normalize PathPowerindB&#x000D;&#x000A;%PathPowerLinear = 10.^(PathPowerindB/10);&#x000D;&#x000A;%PathPowerLinear = PathPowerLinear/sum(PathPowerLinear);&#x000D;&#x000A;%PathPowerindB = 10*log10(PathPowerLinear);&#x000D;&#x000A;%% -------------------------------------- 4-path channel --------------------------------------&#x000D;&#x000A;%NumberofPath = 4; % number of multiple paths&#x000D;&#x000A;%%PathDelay = [0,0,0,0];&#x000D;&#x000A;%PathDelay = [0,1/fs,2.5/fs,5/fs]; % time delay for each path in seconds&#x000D;&#x000A;%PathPowerindB = [0,-1,1,2]; % path power gain in dB&#x000D;&#x000A;%PathAoA = [330,330,30,30]; % azimuth angle of arrival in Rx&#x000D;&#x000A;%PathAoD = [320,320,40,40]; % azimuth angle of departure in Tx&#x000D;&#x000A;%ASofAoA = [17,17,17,17]; % angular spread of AoA in Rx&#x000D;&#x000A;%ASofAoD = [3,3,3,3]; % angular spread of AoD in Tx&#x000D;&#x000A;%PathZoA = [70,110,70,110]; % zenith angle of arrival in Rx&#x000D;&#x000A;%PathZoD = [60,120,60,120]; % zenith angle of departure in Tx&#x000D;&#x000A;%ZSofZoA = [7,7,7,7]; % zenith spread of ZoA&#x000D;&#x000A;%ZSofZoD = [3,3,3,3]; % zenith spread of ZoD&#x000D;&#x000A;%RicianFactorindB = [6,-999,-999,-999]; % Rician Factor in dB&#x000D;&#x000A;%XPRindB = -9; % XPR&#x000D;&#x000A;%% ----------------------------------- 4-path channel large AS ----------------------------------&#x000D;&#x000A;%NumberofPath = 4; % number of multiple paths&#x000D;&#x000A;%%PathDelay = [0,0,0,0];&#x000D;&#x000A;%PathDelay = [0,1/fs,1.5/fs,2/fs]; % time delay for each path in seconds&#x000D;&#x000A;%PathPowerindB = [0,-1,1,2]; % path power gain in dB&#x000D;&#x000A;%PathAoA = [330,330,30,30]; % azimuth angle of arrival in Rx&#x000D;&#x000A;%PathAoD = [320,320,40,40]; % azimuth angle of departure in Tx&#x000D;&#x000A;%ASofAoA = [170,170,170,170]; % angular spread of AoA in Rx&#x000D;&#x000A;%ASofAoD = [130,130,130,130]; % angular spread of AoD in Tx&#x000D;&#x000A;%PathZoA = [70,110,70,110]; % zenith angle of arrival in Rx&#x000D;&#x000A;%PathZoD = [60,120,60,120]; % zenith angle of departure in Tx&#x000D;&#x000A;%ZSofZoA = [170,170,170,170]; % zenith spread of ZoA&#x000D;&#x000A;%ZSofZoD = [130,130,130,130]; % zenith spread of ZoD&#x000D;&#x000A;%RicianFactorindB = [6,-999,-999,-999]; % Rician Factor in dB&#x000D;&#x000A;%XPRindB = -9; % XPR&#x000D;&#x000A;% -------------------------------------------- Range Check -----------------------------------------------&#x000D;&#x000A;%if NumberofPath &lt; Ntrf || NumberofPath &lt; Nrrf&#x000D;&#x000A;%&#x0009;error(&apos;Please kindly ensure NumberofPath larger than Ntrf/Nrrf.&apos;);&#x000D;&#x000A;%end&#x000D;&#x000A;% -------------------------------------------- Noise Density ---------------------------------------------&#x000D;&#x000A;Power_dBm = 10; % transmission power per each RF stream&#x000D;&#x000A;SubtractionDuetoCH = 0.306; % when current Antenna and channel configuration is applied,the channel will introduce 0.306 dB power boost &#x000D;&#x000A;%SubtractionDuetoCH = 0.345; % for 64x16 and 64x8 Antenna configuration is applied &#x000D;&#x000A;NDensity_dBm = Power_dBm - (SNR - SubtractionDuetoCH) - 10*log10(BaseSampleRate*AvaliableNumOfCarriers/Num_Subcarriers) + 10*log10(Ntrf) + 10*log10(Nt) + BeamformingGain; % noise density for full connection mode&#x000D;&#x000A;&#x000D;&#x000A;if Ns ~= Ntrf&#x000D;&#x000A;&#x0009;error(&apos;In this release, Ns should equal to Ntrf.&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;</Text>
<Item XName="BPMgr" Type="BPMgr">
<BPLines><T>Empty</T></BPLines>
<BPStates><T>Empty</T></BPStates></Item>
<Item XName="EqnBlock" Type="EqnBlock">
<Lang><T>Int</T><D>1</D></Lang></Item>
<Item XName="Font" Type="Font">
<Name>Courier New</Name>
<Size><T>Double</T><D>125</D></Size></Item>
<Item XName="FunctionBlock" Type="FunctionBlock" />
<Item XName="Page" Type="PageMgr">
<Item XName="Display0" Type="EquationDisp">
<DVport><T>Array_Dbl64</T><D>1;4;;;G24;G24</D></DVport>
<PVPort><T>Array_Dbl64</T><D>1;4;qCpCpCpZA2C;QcPcPcvBH2C;qCpCpCdG234;qCpCpCNe734</D></PVPort>
<Show><T>Bool</T><D>0</D></Show>
<Split><T>Double</T><D>0.3</D></Split>
<Split2><T>Double</T><D>0.3</D></Split2></Item></Item>
<Item XName="VarBlock" Type="VarBlock">
<Item XName="ASofAoA" Type="Variable">
<Creator>Equations</Creator>
<Data><T>Double</T><D>0</D></Data></Item>
<Item XName="ASofAoD" Type="Variable">
<Creator>Equations</Creator>
<Data><T>Double</T><D>0</D></Data></Item>
<Item XName="AvaliableNumOfCarriers" Type="Variable">
<Creator>Equations</Creator>
<Data><T>Double</T><D>60</D></Data></Item>
<Item XName="BBPrecodingEnable" Type="Variable">
<Creator>Equations</Creator>
<Data><T>Double</T><D>1</D></Data></Item>
<Item XName="BaseSampleRate" Type="Variable">
<Creator>Equations</Creator>
<Data><T>Double</T><D>2000000000</D></Data></Item>
<Item XName="BeamformingGain" Type="Variable">
<Creator>Equations</Creator>
<Data><T>Double</T><D>18.06179973983887</D></Data></Item>
<Item XName="BitRate" Type="Variable">
<Creator>Equations</Creator>
<Data><T>Double</T><D>4000000000</D></Data></Item>
<Item XName="BitsPerFrame" Type="Variable">
<Creator>Equations</Creator>
<Data><T>Double</T><D>2</D></Data></Item>
<Item XName="BitsPerSampleTime" Type="Variable">
<Creator>Equations</Creator>
<Data><T>Double</T><D>2</D></Data></Item>
<Item XName="BitsPerSym" Type="Variable">
<Creator>Equations</Creator>
<Data><T>Double</T><D>2</D></Data></Item>
<Item XName="Data1_MappingType" Type="Variable">
<Creator>Equations</Creator>
<Data><T>Double</T><D>1</D></Data></Item>
<Item XName="Data_CarrierIndex" Type="Variable">
<Creator>Equations</Creator>
<Data><T>Array_Dbl64</T><D>2;40;1;z0C;y0C;w0C;v0C;t0C;s0C;q0C;p0C;n0C;m0C;i0C;g0C;c0C;a0C;W0C;R0C;K0C;G0C;C;m}B;4;804;K04;O04;W04;Y04;c04;e04;i04;k04;n04;o04;q04;r04;t04;u04;w04;x04;z04;{04</D></Data></Item>
<Item XName="Data_CarrierIndex_t" Type="Variable">
<Creator>Equations</Creator>
<Data><T>Array_Dbl64</T><D>2;40;1;z0C;w0C;t0C;q0C;n0C;i0C;c0C;W0C;K0C;C;4;K04;W04;c04;i04;n04;q04;t04;w04;z04;y0C;v0C;s0C;p0C;m0C;g0C;a0C;R0C;G0C;m}B;804;O04;Y04;e04;k04;o04;r04;u04;x04;{04</D></Data></Item>
<Item XName="Data_NumOfCarriers" Type="Variable">
<Creator>Equations</Creator>
<Data><T>Double</T><D>40</D></Data></Item>
