&#x0009;&#x0009;&#x0009;Preamble2_Seq_PerAnt_Size = length(Preamble2_Seq)/NumOfTx;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;Preamble2_Seq_Tmp = zeros(1,Preamble2_Seq_PerAnt_Size);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;for kk = 1:NumOfTx&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;%make sure the preambles are not overlapped.&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;Preamble2_Seq_Tmp(:) = Preamble2_Seq_Tmp(:) + Preamble2_Seq((kk-1)*Preamble2_Seq_PerAnt_Size+1:(kk-1)*Preamble2_Seq_PerAnt_Size+Preamble2_Seq_PerAnt_Size);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;end;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;Prml2_Nonzeros=Preamble2_Seq_Tmp(Preamble2_Seq_Tmp~=0);            &#x000D;&#x000A;           &#x0009; &#x0009;Prml2_Nonzeros_Num=length(Prml2_Nonzeros);&#x000D;&#x000A;            &#x0009;Prml2_Seq_Re=real(Prml2_Nonzeros);&#x000D;&#x000A;            &#x0009;Prml2_Seq_Im=imag(Prml2_Nonzeros);    &#x0009;&#x0009;&#x000D;&#x000A;            &#x0009;for ii=1:Preamble2_RepeatTimes&#x000D;&#x000A;                &#x0009;for jj=1:Prml2_Nonzeros_Num-1&#x000D;&#x000A;                    &#x0009;fprintf(fid_preamble, &apos;%f%c%f%c&apos;, Prml2_Seq_Re(jj),&apos;,&apos;, Prml2_Seq_Im(jj),&apos;,&apos;);&#x000D;&#x000A;                &#x0009;end;&#x000D;&#x000A;                &#x0009;fprintf(fid_preamble,&apos;%f%c%f\n&apos;,Prml2_Seq_Re(Prml2_Nonzeros_Num),&apos;,&apos;,Prml2_Seq_Im(Prml2_Nonzeros_Num));&#x000D;&#x000A;            &#x0009;end;&#x0009;&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;else               %Type2&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;   Preamble1_Seq_PerAnt_Size = length(Preamble1_Seq)/NumOfTx;&#x000D;&#x000A;&#x0009;    &#x0009;   Preamble2_Seq_PerAnt_Size = length(Preamble2_Seq)/NumOfTx;&#x000D;&#x000A;               for kk = 1:NumOfTx&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;   Preamble1_Seq_Tmp = Preamble1_Seq((kk-1)*Preamble1_Seq_PerAnt_Size+1:(kk-1)*Preamble1_Seq_PerAnt_Size+Preamble1_Seq_PerAnt_Size);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;   Prml1_Nonzeros=Preamble1_Seq_Tmp(Preamble1_Seq_Tmp~=0);            &#x000D;&#x000A;               Prml1_Nonzeros_Num=length(Prml1_Nonzeros);&#x000D;&#x000A;               Prmll_Seq_Re=real(Prml1_Nonzeros);&#x000D;&#x000A;               Prmll_Seq_Im=imag(Prml1_Nonzeros);    &#x0009;&#x0009;&#x000D;&#x000A;               for ii=1:Preamble1_RepeatTimes&#x000D;&#x000A;                   for jj=1:Prml1_Nonzeros_Num-1&#x000D;&#x000A;                       fprintf(fid_preamble, &apos;%f%c%f%c&apos;, Prmll_Seq_Re(jj),&apos;,&apos;, Prmll_Seq_Im(jj),&apos;,&apos;);&#x000D;&#x000A;                   end;&#x000D;&#x000A;                   fprintf(fid_preamble,&apos;%f%c%f\n&apos;,Prmll_Seq_Re(Prml1_Nonzeros_Num),&apos;,&apos;,Prmll_Seq_Im(Prml1_Nonzeros_Num));&#x000D;&#x000A;               end;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;   &#x000D;&#x000A;&#x0009;&#x0009;&#x0009;   Preamble2_Seq_Tmp = Preamble2_Seq((kk-1)*Preamble2_Seq_PerAnt_Size+1:(kk-1)*Preamble2_Seq_PerAnt_Size+Preamble2_Seq_PerAnt_Size);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;   Prml2_Nonzeros=Preamble2_Seq_Tmp(Preamble2_Seq_Tmp~=0);  &#x000D;&#x000A;               Prml2_Nonzeros_Num=length(Prml2_Nonzeros);&#x000D;&#x000A;               Prml2_Seq_Re=real(Prml2_Nonzeros);&#x000D;&#x000A;               Prml2_Seq_Im=imag(Prml2_Nonzeros);    &#x0009;&#x0009;&#x000D;&#x000A;               for ii=1:Preamble2_RepeatTimes&#x000D;&#x000A;                   for jj=1:Prml2_Nonzeros_Num-1&#x000D;&#x000A;                       fprintf(fid_preamble, &apos;%f%c%f%c&apos;, Prml2_Seq_Re(jj),&apos;,&apos;, Prml2_Seq_Im(jj),&apos;,&apos;);&#x000D;&#x000A;                   end;&#x000D;&#x000A;                   fprintf(fid_preamble,&apos;%f%c%f\n&apos;,Prml2_Seq_Re(Prml2_Nonzeros_Num),&apos;,&apos;,Prml2_Seq_Im(Prml2_Nonzeros_Num));&#x000D;&#x000A;               end;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;   end;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;end;&#x000D;&#x000A;&#x0009;&#x0009;end;&#x000D;&#x000A;    end;&#x000D;&#x000A;    &#x000D;&#x000A;    fclose(fid_preamble);&#x000D;&#x000A;    &#x000D;&#x000A;    if (0==SubcarrierAllocationType)&#x000D;&#x000A;    &#x000D;&#x000A;        %  Resource Type        Meaning&#x000D;&#x000A;        %       0            data subcarrier&#x000D;&#x000A;        %       1            pilot subcarrier, know&#x000D;&#x000A;        %       2            pilot subcarrier, unknow&#x000D;&#x000A;        %       3            preamble subcarrier&#x000D;&#x000A;        %       4            null subcarrier&#x000D;&#x000A;        fid_resourcemap=fopen(SV_ResourceMap,&apos;w&apos;);&#x000D;&#x000A;    &#x000D;&#x000A;&#x0009;&#x0009;% insert QAM_Identifiers instead of actual QAM Mod Type&#x000D;&#x000A;        fid_resourcemod=fopen(SV_ResourceMod,&apos;w&apos;);&#x000D;&#x000A;        % Write Preamble 1 resource map and modulation&#x000D;&#x000A;        ResourceMap=4*ones(1,NumOfCarriers);&#x000D;&#x000A;        ResourceMod=zeros(1,NumOfCarriers);&#x000D;&#x000A;        if (1==Preamble1_Enable)&#x000D;&#x000A;            if (0==Preamble_FrequencyDomain)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;if (MIMOType == 0) %Type1&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;    &#x0009;%MIMOIndex = [0, 64, 128];&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;NumPrmlPerAnt = length(Preamble1_Seq)/NumOfTx;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;for ant=1:NumOfTx,&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;for idx = 1: NumPrmlPerAnt,&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;if (Preamble1_Seq((ant-1)*NumPrmlPerAnt+idx)~=0) %set the subcarrier for this antenna&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;ResourceMap(idx)=3+MIMOIndex(ant);&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;end;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;end;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;end;&#x0009;&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;else               %Type2&#x000D;&#x000A;                &#x0009;ResourceMap(Preamble_CarrierIndex(find(Preamble1_Seq(1:end/NumOfTx)~=0))+Subcarrier_Index_Start)=3+MIMOIndex;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;end;&#x000D;&#x000A;                for ii=1:Preamble1_RepeatTimes&#x000D;&#x000A;                    for jj=1:NumOfCarriers-1&#x000D;&#x000A;                        fprintf(fid_resourcemap, &apos;%d%c&apos;, ResourceMap(jj),&apos;,&apos;);&#x000D;&#x000A;                        fprintf(fid_resourcemod, &apos;%d%c&apos;, ResourceMod(jj),&apos;,&apos;);&#x000D;&#x000A;                    end;&#x000D;&#x000A;                    fprintf(fid_resourcemap,&apos;%d\n&apos;,ResourceMap(NumOfCarriers));&#x000D;&#x000A;    &#x0009;&#x0009;        fprintf(fid_resourcemod,&apos;%d\n&apos;,ResourceMod(NumOfCarriers));&#x000D;&#x000A;                end;            &#x000D;&#x000A;&#x0009;&#x0009;&#x0009;end;&#x000D;&#x000A;        end;&#x000D;&#x000A;    &#x000D;&#x000A;        % Write Preamble 2 resource map and modulation&#x000D;&#x000A;        ResourceMap=4*ones(1,NumOfCarriers);&#x000D;&#x000A;        ResourceMod=zeros(1,NumOfCarriers);&#x000D;&#x000A;        if (1==Preamble2_Enable)&#x000D;&#x000A;            if (0==Preamble_FrequencyDomain)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;if (MIMOType == 0) %Type1&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;    &#x0009;%MIMOIndex = [0, 64, 128];&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;NumPrmlPerAnt = length(Preamble2_Seq)/NumOfTx;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;for ant=1:NumOfTx,&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;for idx = 1: NumPrmlPerAnt,&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;if (Preamble2_Seq((ant-1)*NumPrmlPerAnt+idx)~=0) %set the subcarrier for this antenna&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;ResourceMap(idx)=3+MIMOIndex(ant);&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;end;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;end;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;end;&#x0009;&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;else               %Type2&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;    &#x0009;ResourceMap(Preamble_CarrierIndex(find(Preamble2_Seq(1:end/NumOfTx)~=0))+Subcarrier_Index_Start)=3+MIMOIndex;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;end;&#x000D;&#x000A;                for ii=1:Preamble2_RepeatTimes&#x000D;&#x000A;                    for jj=1:NumOfCarriers-1&#x000D;&#x000A;                        fprintf(fid_resourcemap, &apos;%d%c&apos;, ResourceMap(jj),&apos;,&apos;);&#x000D;&#x000A;    &#x0009;&#x0009;&#x0009;        fprintf(fid_resourcemod, &apos;%d%c&apos;, ResourceMod(jj),&apos;,&apos;);&#x000D;&#x000A;                    end;&#x000D;&#x000A;                    fprintf(fid_resourcemap,&apos;%d\n&apos;,ResourceMap(NumOfCarriers));&#x000D;&#x000A;    &#x0009;&#x0009;        fprintf(fid_resourcemod,&apos;%d\n&apos;,ResourceMod(NumOfCarriers));&#x000D;&#x000A;                end;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;end;&#x000D;&#x000A;        end;&#x000D;&#x000A;    &#x000D;&#x000A;        ResourceMap=4*ones(1,NumOfCarriers);&#x000D;&#x000A;        ResourceMod=zeros(1,NumOfCarriers);&#x000D;&#x000A;        Data_CarrierPos=Data_CarrierIndex+Subcarrier_Index_Start;&#x000D;&#x000A;        if (Pilot1_Enable==1)    &#x000D;&#x000A;            if (Pilot2_Enable==0)&#x000D;&#x000A;                Pilot_Position=Pilot1_CarrierIndex;&#x000D;&#x000A;            else&#x000D;&#x000A;                Pilot_Position=[Pilot1_CarrierIndex,Pilot2_CarrierIndex];&#x000D;&#x000A;            end&#x000D;&#x000A;        else&#x000D;&#x000A;            if (Pilot2_Enable==1)&#x000D;&#x000A;                Pilot_Position=Pilot2_CarrierIndex;&#x000D;&#x000A;            end&#x000D;&#x000A;        end;&#x000D;&#x000A;        &#x000D;&#x000A;        ResourceMap(Data_CarrierPos)=0;     %Data subcarrier should be 0 in mapping file&#x000D;&#x000A;        &#x000D;&#x000A;        if ((Pilot1_Enable==1)||(Pilot2_Enable==1)) &#x000D;&#x000A;            Pilot_CarrierPos=sort(Pilot_Position)+Subcarrier_Index_Start;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;            ResourceMap(Pilot_CarrierPos)=1+MIMOIndex(1);    %Pilot subcarrier should be 1 in mapping file&#x0009;&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;ResourceMod(Pilot_CarrierPos)=Pilot_MappingType+1;  % Pilot subcarrier should be MappingType+1 in modulation file&#x000D;&#x000A;        end;&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;&#x0009;clear ResourceMapNew1;&#x000D;&#x000A;&#x0009;&#x0009;clear ResourceMapNew2;&#x000D;&#x000A;&#x0009;&#x0009;ResourceMapNew1 = zeros(Data1_NumOfSym,NumOfCarriers);&#x000D;&#x000A;&#x0009;&#x0009;ResourceMapNew2 = zeros(Data2_NumOfSym,NumOfCarriers);&#x000D;&#x000A;        for ii=1:Data1_NumOfSym    &#x000D;&#x000A;        &#x0009;for jj=1:NumOfCarriers&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;ResourceMapNew1(ii,jj) = ResourceMap(jj);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;end;&#x000D;&#x000A;&#x0009;&#x0009;end;&#x000D;&#x000A;        for ii=1:Data2_NumOfSym    &#x000D;&#x000A;        &#x0009;for jj=1:NumOfCarriers&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;ResourceMapNew2(ii,jj) = ResourceMap(jj);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;end;&#x000D;&#x000A;&#x0009;&#x0009;end;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;if (MIMOType == 0) %Type1&#x000D;&#x000A;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;Data_NumOfSym = 0;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;Data_NumOfSym = Data_NumOfSym + Data1_NumOfSym;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;if (Data2_Enable==1)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;Data_NumOfSym = Data_NumOfSym + Data2_NumOfSym;&#x000D;&#x000A;&#x0009;&#x0009;end;&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;&#x0009;if (Pilot1_Enable==1)  &#x000D;&#x000A;&#x0009;&#x0009;&#x0009;Pilot1_CarrierIndex_Size = length(Pilot1_CarrierIndex);&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;Pilot1_Num_Per_Ant = Pilot1_CarrierIndex_Size*Data_NumOfSym;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;for ant = 1:NumOfTx&#x000D;&#x000A;        &#x0009;&#x0009;for ii=1:Data1_NumOfSym    &#x000D;&#x000A;        &#x0009;&#x0009;&#x0009;for jj=1:Pilot1_CarrierIndex_Size&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;if (Pilot1_Seq((ant-1)*Pilot1_Num_Per_Ant+(ii-1)*Pilot1_CarrierIndex_Size+jj) ~=0)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;ResourceMapNew1(ii,Pilot1_CarrierIndex(jj)+Subcarrier_Index_Start) = 1+MIMOIndex(ant); &#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;end;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;end;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;end;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;end;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;if (Data2_Enable==1)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;for ant = 1:NumOfTx&#x000D;&#x000A;        &#x0009;&#x0009;&#x0009;for ii=1:Data2_NumOfSym    &#x000D;&#x000A;        &#x0009;&#x0009;&#x0009;&#x0009;for jj=1:Pilot1_CarrierIndex_Size&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;if (Pilot1_Seq((ant-1)*Pilot1_Num_Per_Ant+(ii-1)*Pilot1_CarrierIndex_Size+jj) ~=0)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;ResourceMapNew2(ii,Pilot1_CarrierIndex(jj)+Subcarrier_Index_Start) = 1+MIMOIndex(ant); &#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;end;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;end;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;end;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;end;&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;end;&#x000D;&#x000A;&#x0009;&#x0009;end;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;        ResourceMod(Data_CarrierPos)=Data1_QAM_Identifiers;&#x000D;&#x000A;        for ii=1:Data1_NumOfSym    &#x000D;&#x000A;        &#x0009;for jj=1:NumOfCarriers-1&#x000D;&#x000A;            &#x0009;fprintf(fid_resourcemap, &apos;%d%c&apos;, ResourceMapNew1(ii,jj),&apos;,&apos;);&#x000D;&#x000A;            &#x0009;fprintf(fid_resourcemod, &apos;%d%c&apos;, ResourceMod(jj),&apos;,&apos;);&#x000D;&#x000A;        &#x0009;end;&#x000D;&#x000A;        &#x0009;fprintf(fid_resourcemap,&apos;%d\n&apos;,ResourceMapNew1(ii,NumOfCarriers));&#x000D;&#x000A;        &#x0009;fprintf(fid_resourcemod,&apos;%d\n&apos;,ResourceMod(NumOfCarriers));&#x000D;&#x000A;&#x0009;&#x0009;end;&#x000D;&#x000A;        if (Data2_Enable==1)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;for ii=1:Data2_NumOfSym&#x000D;&#x000A;            &#x0009;ResourceMod(Data_CarrierPos)=Data2_QAM_Identifiers;&#x000D;&#x000A;            &#x0009;for jj=1:NumOfCarriers-1&#x000D;&#x000A;                &#x0009;fprintf(fid_resourcemap, &apos;%d%c&apos;, ResourceMapNew2(ii,jj),&apos;,&apos;);&#x000D;&#x000A;                &#x0009;fprintf(fid_resourcemod, &apos;%d%c&apos;, ResourceMod(jj),&apos;,&apos;); &#x000D;&#x000A;            &#x0009;end;&#x000D;&#x000A;            &#x0009;fprintf(fid_resourcemap,&apos;%d\n&apos;,ResourceMapNew2(ii,NumOfCarriers));&#x000D;&#x000A;            &#x0009;fprintf(fid_resourcemod,&apos;%d\n&apos;,ResourceMod(NumOfCarriers));&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;end;&#x000D;&#x000A;        end;&#x000D;&#x000A;&#x0009;&#x0009;end;&#x000D;&#x000A;        fclose(fid_resourcemap);&#x000D;&#x000A;        fclose(fid_resourcemod);&#x000D;&#x000A;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;%Pilot&#x000D;&#x000A;        fid_pilot=fopen(SV_PilotIQ,&apos;w&apos;);&#x000D;&#x000A;&#x0009;&#x0009;if (MIMOType == 0) %Type1&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;Pilot_Num = 0;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;Pilot1_Seq1 = [];&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;        &#x0009;for ii=1:Data1_NumOfSym    &#x000D;&#x000A;        &#x0009;   for jj=1:Pilot1_CarrierIndex_Size&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;if ( mod(ResourceMapNew1(ii,Pilot1_CarrierIndex(jj)+Subcarrier_Index_Start), 64) == 1)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;ant = floor(ResourceMapNew1(ii,Pilot1_CarrierIndex(jj)+Subcarrier_Index_Start)/64)+1;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;Pilot_Num = Pilot_Num + 1;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;Pilot1_Seq1 = [Pilot1_Seq1, Pilot1_Seq((ant-1)*Pilot1_Num_Per_Ant+(ii-1)*Pilot1_CarrierIndex_Size+jj)];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;end;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;end;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;end;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;            Pilot_Seq_Re=real(Pilot1_Seq1);&#x000D;&#x000A;            Pilot_Seq_Im=imag(Pilot1_Seq1);&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;            P_Start=1;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;            for ii=1:Data1_NumOfSym&#x000D;&#x000A;                for jj=1:Pilot_Num/Data1_NumOfSym-1&#x000D;&#x000A;                    fprintf(fid_pilot, &apos;%f%c%f%c&apos;, Pilot_Seq_Re(P_Start),&apos;,&apos;, Pilot_Seq_Im(P_Start),&apos;,&apos;);&#x000D;&#x000A;                    P_Start=P_Start+1;&#x000D;&#x000A;                end;&#x000D;&#x000A;                fprintf(fid_pilot,&apos;%f%c%f\n&apos;,Pilot_Seq_Re(P_Start),&apos;,&apos;,Pilot_Seq_Im(P_Start));&#x000D;&#x000A;                P_Start=P_Start+1;&#x000D;&#x000A;            end;&#x000D;&#x000A;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;if (Data2_Enable==1)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;Pilot_Num = 0;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;Pilot1_Seq1 = [];&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;        &#x0009;for ii=Data1_NumOfSym+1:Data1_NumOfSym+Data2_NumOfSym    &#x000D;&#x000A;        &#x0009;   for jj=1:Pilot1_CarrierIndex_Size&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;if ( mod(ResourceMapNew2(ii-Data1_NumOfSym,Pilot1_CarrierIndex(jj)+Subcarrier_Index_Start), 64) == 1)&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;ant = floor(ResourceMapNew2(ii-Data1_NumOfSym,Pilot1_CarrierIndex(jj)+Subcarrier_Index_Start)/64)+1;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;Pilot_Num = Pilot_Num + 1;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;Pilot1_Seq1 = [Pilot1_Seq1, Pilot1_Seq((ant-1)*Pilot1_Num_Per_Ant+(ii-1)*Pilot1_CarrierIndex_Size+jj)];&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;end;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;end;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;end;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;            Pilot_Seq_Re=real(Pilot1_Seq1);&#x000D;&#x000A;            Pilot_Seq_Im=imag(Pilot1_Seq1);&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;            P_Start=1;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;            for ii=1:Data2_NumOfSym&#x000D;&#x000A;                for jj=1:Pilot_Num/Data2_NumOfSym-1&#x000D;&#x000A;                    fprintf(fid_pilot, &apos;%f%c%f%c&apos;, Pilot_Seq_Re(P_Start),&apos;,&apos;, Pilot_Seq_Im(P_Start),&apos;,&apos;);&#x000D;&#x000A;                    P_Start=P_Start+1;&#x000D;&#x000A;                end;&#x000D;&#x000A;                fprintf(fid_pilot,&apos;%f%c%f\n&apos;,Pilot_Seq_Re(P_Start),&apos;,&apos;,Pilot_Seq_Im(P_Start));&#x000D;&#x000A;                P_Start=P_Start+1;&#x000D;&#x000A;            end;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;end;&#x000D;&#x000A;&#x0009;&#x0009;else&#x000D;&#x000A;        if (1==Pilot1_Enable)&#x000D;&#x000A;            if (0==Pilot2_Enable)&#x000D;&#x000A;                Pilot_Num=length(Pilot1_Seq);&#x000D;&#x000A;                Pilot_Seq_Re=real(Pilot1_Seq);&#x000D;&#x000A;                Pilot_Seq_Im=imag(Pilot1_Seq);&#x000D;&#x000A;                P_Start=1;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;for kk = 1:NumOfTx&#x000D;&#x000A;                for ii=1:Data_NumSym&#x000D;&#x000A;                    for jj=1:Pilot1_NumOfCarriers-1&#x000D;&#x000A;                        fprintf(fid_pilot, &apos;%f%c%f%c&apos;, Pilot_Seq_Re(P_Start),&apos;,&apos;, Pilot_Seq_Im(P_Start),&apos;,&apos;);&#x000D;&#x000A;                        P_Start=P_Start+1;&#x000D;&#x000A;                    end;&#x000D;&#x000A;                    fprintf(fid_pilot,&apos;%f%c%f\n&apos;,Pilot_Seq_Re(P_Start),&apos;,&apos;,Pilot_Seq_Im(P_Start));&#x000D;&#x000A;                    P_Start=P_Start+1;&#x000D;&#x000A;                end;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;end;&#x000D;&#x000A;            else&#x000D;&#x000A;                Pilot_Position=[Pilot1_CarrierIndex,Pilot2_CarrierIndex];&#x000D;&#x000A;                [Pilot_CarrierIndex,P_index]=sort(Pilot_Position);&#x000D;&#x000A;                Pilot_Num=Pilot1_NumOfCarriers+Pilot2_NumOfCarriers;&#x000D;&#x000A;                for ii=1:Data_NumSym&#x000D;&#x000A;                    Pilot_SeqPerOFDM=[Pilot1_Seq((ii-1)*Pilot1_NumOfCarriers+1:ii*Pilot1_NumOfCarriers),Pilot2_Seq((ii-1)*Pilot2_NumOfCarriers+1:ii*Pilot2_NumOfCarriers)];&#x000D;&#x000A;                    Pilot_SeqPerOFDM=Pilot_SeqPerOFDM(P_index)&#x000D;&#x000A;                    Pilot_Seq((ii-1)*Pilot_Num+1:ii*Pilot_Num)=Pilot_SeqPerOFDM;&#x000D;&#x000A;                end;&#x000D;&#x000A;            &#x000D;&#x000A;                Pilot_Seq_Re=real(Pilot_Seq);&#x000D;&#x000A;                Pilot_Seq_Im=imag(Pilot_Seq);&#x000D;&#x000A;    &#x000D;&#x000A;                P_Start=1;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;for kk = 1:NumOfTx&#x000D;&#x000A;                for ii=1:Data_NumSym&#x000D;&#x000A;                    for jj=1:Pilot_Num-1&#x000D;&#x000A;                        fprintf(fid_pilot, &apos;%f%c%f%c&apos;, Pilot_Seq_Re(P_Start),&apos;,&apos;, Pilot_Seq_Im(P_Start),&apos;,&apos;);&#x000D;&#x000A;                        P_Start=P_Start+1;&#x000D;&#x000A;                    end;&#x000D;&#x000A;                    fprintf(fid_pilot,&apos;%f%c%f\n&apos;,Pilot_Seq_Re(P_Start),&apos;,&apos;,Pilot_Seq_Im(P_Start));&#x000D;&#x000A;                    P_Start=P_Start+1;&#x000D;&#x000A;                end;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;end;&#x000D;&#x000A;            end;&#x000D;&#x000A;        else&#x000D;&#x000A;            if (1==Pilot2_Enable)&#x000D;&#x000A;                Pilot_Num=length(Pilot2_Seq);&#x000D;&#x000A;                Pilot_Seq_Re=real(Pilot2_Seq);&#x000D;&#x000A;                Pilot_Seq_Im=imag(Pilot2_Seq);&#x000D;&#x000A;                P_Start=1;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;for kk = 1:NumOfTx&#x000D;&#x000A;                for ii=1:Data_NumSym&#x000D;&#x000A;                    for jj=1:Pilot2_NumOfCarriers-1&#x000D;&#x000A;                        fprintf(fid_pilot, &apos;%f%c%f%c&apos;, Pilot_Seq_Re(P_Start),&apos;,&apos;, Pilot_Seq_Im(P_Start),&apos;,&apos;);&#x000D;&#x000A;                        P_Start=P_Start+1;&#x000D;&#x000A;                    end;&#x000D;&#x000A;                    fprintf(fid_pilot,&apos;%f%c%f\n&apos;,Pilot_Seq_Re(P_Start),&apos;,&apos;,Pilot_Seq_Im(P_Start));&#x000D;&#x000A;                    P_Start=P_Start+1;&#x000D;&#x000A;                end;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;end;&#x000D;&#x000A;            end;&#x000D;&#x000A;        end;&#x000D;&#x000A;&#x0009;&#x0009;end;&#x000D;&#x000A;    &#x000D;&#x000A;        fclose(fid_pilot);&#x0009;&#x0009;&#x000D;&#x000A;    else&#x000D;&#x000A;%        fid_pilot=fopen(SV_PilotIQ,&apos;w&apos;);&#x000D;&#x000A;%        if (1==Pilot1_Enable)&#x000D;&#x000A;%            if (0==Pilot2_Enable)&#x000D;&#x000A;%                Pilot_Seq_Re=real(Pilot1_Seq);&#x000D;&#x000A;%                Pilot_Seq_Im=imag(Pilot1_Seq);&#x000D;&#x000A;%    &#x000D;&#x000A;%                P_Start=1;&#x000D;&#x000A;%                for ii=1:Data_NumSym&#x000D;&#x000A;%                    if (0~=Pilot1_NumOfCarriers(ii))&#x000D;&#x000A;%                        for jj=1:Pilot1_NumOfCarriers(ii)-1&#x000D;&#x000A;%                            fprintf(fid_pilot, &apos;%f%c%f%c&apos;, Pilot_Seq_Re(P_Start),&apos;,&apos;, Pilot_Seq_Im(P_Start),&apos;,&apos;);&#x000D;&#x000A;%                            P_Start=P_Start+1;&#x000D;&#x000A;%                        end;&#x000D;&#x000A;%                        fprintf(fid_pilot,&apos;%f%c%f\n&apos;,Pilot_Seq_Re(P_Start),&apos;,&apos;,Pilot_Seq_Im(P_Start));&#x000D;&#x000A;%                        P_Start=P_Start+1;&#x000D;&#x000A;%                    end;&#x000D;&#x000A;%                end;&#x000D;&#x000A;%            else&#x000D;&#x000A;%                P1_Start=1; &#x000D;&#x000A;%                P1_Stop=Pilot1_NumOfCarriers(1);&#x000D;&#x000A;%                P2_Start=1;&#x000D;&#x000A;%                P2_Stop=Pilot2_NumOfCarriers(1);&#x000D;&#x000A;%                P_Start=1;&#x000D;&#x000A;%                P_Stop=P1_Stop+P2_Stop;&#x000D;&#x000A;%                for ii=1:Data_NumSym-1&#x000D;&#x000A;%                    Pilot_Position=[Pilot1_CarrierIndex(P1_Start:P1_Stop),Pilot2_CarrierIndex(P2_Start:P2_Stop)];&#x000D;&#x000A;%                    [Pilot_CarrierIndex,P_index]=sort(Pilot_Position);&#x000D;&#x000A;%                    Pilot_Num=Pilot1_NumOfCarriers(ii)+Pilot2_NumOfCarriers(ii);&#x000D;&#x000A;%                    Pilot_SeqPerOFDM=[Pilot1_Seq(P1_Start:P1_Stop),Pilot2_Seq(P2_Start:P2_Stop)];&#x000D;&#x000A;%                    Pilot_SeqPerOFDM=Pilot_SeqPerOFDM(P_index);&#x000D;&#x000A;%                    Pilot_Seq(P_Start:P_Stop)=Pilot_SeqPerOFDM;&#x000D;&#x000A;%                    P1_Start=P1_Stop+1;&#x000D;&#x000A;%                    P1_Stop=P1_Stop+Pilot1_NumOfCarriers(ii+1);&#x000D;&#x000A;%                    P2_Start=P2_Stop+1;&#x000D;&#x000A;%                    P2_Stop=P2_Stop+Pilot2_NumOfCarriers(ii+1);&#x000D;&#x000A;%                    P_Start=P_Stop+1;&#x000D;&#x000A;%                    P_Stop=P1_Stop+P2_Stop;&#x000D;&#x000A;%                end;&#x000D;&#x000A;%                Pilot_Position=[Pilot1_CarrierIndex(P1_Start:P1_Stop),Pilot2_CarrierIndex(P2_Start:P2_Stop)];&#x000D;&#x000A;%                [Pilot_CarrierIndex,P_index]=sort(Pilot_Position);&#x000D;&#x000A;%                Pilot_Num=Pilot1_NumOfCarriers(Data_NumSym)+Pilot2_NumOfCarriers(Data_NumSym);&#x000D;&#x000A;%                Pilot_SeqPerOFDM=[Pilot1_Seq(P1_Start:P1_Stop),Pilot2_Seq(P2_Start:P2_Stop)];&#x000D;&#x000A;%                Pilot_SeqPerOFDM=Pilot_SeqPerOFDM(P_index)&#x000D;&#x000A;%                Pilot_Seq(P_Start:P_Stop)=Pilot_SeqPerOFDM;&#x000D;&#x000A;%    &#x000D;&#x000A;%                Pilot_Seq_Re=real(Pilot_Seq);&#x000D;&#x000A;%                Pilot_Seq_Im=imag(Pilot_Seq);&#x000D;&#x000A;%    &#x000D;&#x000A;%                P_Start=1;&#x000D;&#x000A;%                for ii=1:Data_NumSym&#x000D;&#x000A;%                    Pilot_Num=Pilot1_NumOfCarriers(ii)+Pilot2_NumOfCarriers(ii);&#x000D;&#x000A;%                    if (0~=Pilot_Num)&#x000D;&#x000A;%                        for jj=1:Pilot_Num-1&#x000D;&#x000A;%                            fprintf(fid_pilot, &apos;%f%c%f%c&apos;, Pilot_Seq_Re(P_Start),&apos;,&apos;, Pilot_Seq_Im(P_Start),&apos;,&apos;);&#x000D;&#x000A;%                            P_Start=P_Start+1;&#x000D;&#x000A;%                        end;&#x000D;&#x000A;%                        fprintf(fid_pilot,&apos;%f%c%f\n&apos;,Pilot_Seq_Re(P_Start),&apos;,&apos;,Pilot_Seq_Im(P_Start));&#x000D;&#x000A;%                        P_Start=P_Start+1;&#x000D;&#x000A;%                    end;&#x000D;&#x000A;%                end;&#x000D;&#x000A;%            end;&#x000D;&#x000A;%        else &#x000D;&#x000A;%            if (0==Pilot2_Enable)&#x000D;&#x000A;%                Pilot_Seq_Re=real(Pilot2_Seq);&#x000D;&#x000A;%                Pilot_Seq_Im=imag(Pilot2_Seq);&#x000D;&#x000A;%    &#x000D;&#x000A;%                P_Start=1;&#x000D;&#x000A;%                for ii=1:Data_NumSym&#x000D;&#x000A;%                    if (0~=Pilot2_NumOfCarriers(ii))&#x000D;&#x000A;%                        for jj=1:Pilot2_NumOfCarriers(ii)-1&#x000D;&#x000A;%                            fprintf(fid_pilot, &apos;%f%c%f%c&apos;, Pilot_Seq_Re(P_Start),&apos;,&apos;, Pilot_Seq_Im(P_Start),&apos;,&apos;);&#x000D;&#x000A;%                            P_Start=P_Start+1;&#x000D;&#x000A;%                        end;&#x000D;&#x000A;%                        fprintf(fid_pilot,&apos;%f%c%f\n&apos;,Pilot_Seq_Re(P_Start),&apos;,&apos;,Pilot_Seq_Im(P_Start));&#x000D;&#x000A;%                        P_Start=P_Start+1;&#x000D;&#x000A;%                    end;&#x000D;&#x000A;%                end;&#x000D;&#x000A;%            end;&#x000D;&#x000A;%        end;&#x000D;&#x000A;%        &#x000D;&#x000A;%        fclose(fid_pilot);&#x000D;&#x000A;%    &#x000D;&#x000A;%        %  Resource Type        Meaning&#x000D;&#x000A;%        %       0            data subcarrier&#x000D;&#x000A;%        %       1            pilot subcarrier, know&#x000D;&#x000A;%        %       2            pilot subcarrier, unknow&#x000D;&#x000A;%        %       3            preamble subcarrier&#x000D;&#x000A;%        %       4            null subcarrier&#x000D;&#x000A;%        fid_resourcemap=fopen(SV_ResourceMap,&apos;w&apos;);&#x000D;&#x000A;%    &#x000D;&#x000A;%        fid_resourcemod=fopen(SV_ResourceMod,&apos;w&apos;);&#x000D;&#x000A;%        % Write Preamble 1 resource map and modulation&#x000D;&#x000A;%        ResourceMap=4*ones(1,NumOfCarriers);&#x000D;&#x000A;%        ResourceMod=zeros(1,NumOfCarriers);&#x000D;&#x000A;%        if (1==Preamble1_Enable)&#x000D;&#x000A;%            if (0==Preamble_FrequencyDomain)&#x000D;&#x000A;%                ResourceMap(Preamble_CarrierIndex(find(Preamble1_Seq~=0))+Subcarrier_Index_Start)=3;&#x000D;&#x000A;%&#x0009;&#x0009;&#x0009;&#x0009;%ResourceMap(find(Preamble1_Seq~=0))=3;&#x000D;&#x000A;%                for ii=1:Preamble1_RepeatTimes&#x000D;&#x000A;%                    for jj=1:NumOfCarriers-1&#x000D;&#x000A;%                        fprintf(fid_resourcemap, &apos;%d%c&apos;, ResourceMap(jj),&apos;,&apos;);&#x000D;&#x000A;%                        fprintf(fid_resourcemod, &apos;%d%c&apos;, ResourceMod(jj),&apos;,&apos;);&#x000D;&#x000A;%                    end;&#x000D;&#x000A;%                    fprintf(fid_resourcemap,&apos;%d\n&apos;,ResourceMap(NumOfCarriers));&#x000D;&#x000A;%                    fprintf(fid_resourcemod,&apos;%d\n&apos;,ResourceMod(NumOfCarriers));&#x000D;&#x000A;%                end;&#x000D;&#x000A;%            end;&#x000D;&#x000A;%        end;&#x000D;&#x000A;%        % Write Preamble 2 resource map and modulation&#x000D;&#x000A;%        ResourceMap=4*ones(1,NumOfCarriers);&#x000D;&#x000A;%        ResourceMod=zeros(1,NumOfCarriers);&#x000D;&#x000A;%        if (1==Preamble2_Enable)&#x000D;&#x000A;%            if (0==Preamble_FrequencyDomain)&#x000D;&#x000A;%                ResourceMap(Preamble_CarrierIndex(find(Preamble2_Seq~=0))+Subcarrier_Index_Start)=3;&#x000D;&#x000A;%                for ii=1:Preamble2_RepeatTimes&#x000D;&#x000A;%                    for jj=1:NumOfCarriers-1&#x000D;&#x000A;%                        fprintf(fid_resourcemap, &apos;%d%c&apos;, ResourceMap(jj),&apos;,&apos;);&#x000D;&#x000A;%                        fprintf(fid_resourcemod, &apos;%d%c&apos;, ResourceMod(jj),&apos;,&apos;);&#x000D;&#x000A;%                    end;&#x000D;&#x000A;%                    fprintf(fid_resourcemap,&apos;%d\n&apos;,ResourceMap(NumOfCarriers));&#x000D;&#x000A;%                    fprintf(fid_resourcemod,&apos;%d\n&apos;,ResourceMod(NumOfCarriers));&#x000D;&#x000A;%                end;&#x000D;&#x000A;%            end;&#x000D;&#x000A;%        end;&#x000D;&#x000A;%    &#x000D;&#x000A;%        ResourceMap=4*ones(1,NumOfCarriers);&#x000D;&#x000A;%        ResourceMod=zeros(1,NumOfCarriers);&#x000D;&#x000A;%        Data_Start=1; &#x000D;&#x000A;%        Data_Stop=Data_NumOfCarriers(1);&#x000D;&#x000A;%        if (1==Pilot1_Enable)&#x000D;&#x000A;%            P1_Start=1; &#x000D;&#x000A;%            P1_Stop=Pilot1_NumOfCarriers(1);&#x000D;&#x000A;%        else&#x000D;&#x000A;%            P1_Start=0;&#x000D;&#x000A;%            P1_Stop=0;&#x000D;&#x000A;%        end;&#x000D;&#x000A;%        if (Pilot2_Enable==1)&#x000D;&#x000A;%            P2_Start=1;&#x000D;&#x000A;%            P2_Stop=Pilot2_NumOfCarriers(1);&#x000D;&#x000A;%        else&#x000D;&#x000A;%            P2_Start=0;&#x000D;&#x000A;%            P2_Stop=0;&#x000D;&#x000A;%        end;&#x000D;&#x000A;%        P_Start=1;&#x000D;&#x000A;%        P_Stop=P1_Stop+P2_Stop;&#x000D;&#x000A;%        for ii=1:Data1_NumOfSym-1&#x000D;&#x000A;%            Data_CarrierPos=Data_CarrierIndex(Data_Start:Data_Stop)+Subcarrier_Index_Start;&#x000D;&#x000A;%            if (Pilot1_Enable==1)&#x000D;&#x000A;%                if (Pilot2_Enable==0)&#x000D;&#x000A;%                    Pilot_Position=Pilot1_CarrierIndex(P1_Start:P1_Stop);&#x000D;&#x000A;%                else&#x000D;&#x000A;%                    Pilot_Position=[Pilot1_CarrierIndex(P1_Start:P1_Stop),Pilot2_CarrierIndex(P2_Start:P2_Stop)];&#x000D;&#x000A;%                end&#x000D;&#x000A;%            else&#x000D;&#x000A;%                if (Pilot2_Enable==1)&#x000D;&#x000A;%                    Pilot_Position=Pilot2_CarrierIndex(P2_Start:P2_Stop);&#x000D;&#x000A;%                end;&#x000D;&#x000A;%            end;&#x000D;&#x000A;%            if ((1==Pilot1_Enable)||(1==Pilot2_Enable))&#x000D;&#x000A;%                Pilot_CarrierPos=sort(Pilot_Position)+Subcarrier_Index_Start;&#x000D;&#x000A;%                ResourceMap(Pilot_CarrierPos)=1;    %Pilot subcarrier should be 1 in mapping file&#x000D;&#x000A;%                ResourceMod(Pilot_CarrierPos)=Pilot_MappingType+1;  % Pilot subcarrier should be MappingType+1 in modulation file&#x000D;&#x000A;%            end;&#x000D;&#x000A;%    &#x000D;&#x000A;%            ResourceMap(Data_CarrierPos)=0;     %Data subcarrier should be 0 in mapping file&#x000D;&#x000A;%    %        ResourceMap(Pilot_CarrierPos)=1;    %Pilot subcarrier should be 1 in mapping file&#x000D;&#x000A;%    &#x000D;&#x000A;%            ResourceMod(Data_CarrierPos)=Data1_QAM_Identifiers;&#x000D;&#x000A;%    &#x000D;&#x000A;%            for jj=1:NumOfCarriers-1&#x000D;&#x000A;%                fprintf(fid_resourcemap, &apos;%d%c&apos;, ResourceMap(jj),&apos;,&apos;);&#x000D;&#x000A;%                fprintf(fid_resourcemod, &apos;%d%c&apos;, ResourceMod(jj),&apos;,&apos;);&#x000D;&#x000A;%            end;&#x000D;&#x000A;%            fprintf(fid_resourcemap,&apos;%d\n&apos;,ResourceMap(NumOfCarriers));&#x000D;&#x000A;%            fprintf(fid_resourcemod,&apos;%d\n&apos;,ResourceMod(NumOfCarriers));&#x000D;&#x000A;%            Data_Start=Data_Stop+1; &#x000D;&#x000A;%            Data_Stop=Data_Stop+Data_NumOfCarriers(ii+1);&#x000D;&#x000A;%            if (1==Pilot1_Enable)&#x000D;&#x000A;%                P1_Start=P1_Stop+1;&#x000D;&#x000A;%    &#x0009;        P1_Stop=P1_Stop+Pilot1_NumOfCarriers(ii+1);&#x000D;&#x000A;%            else&#x000D;&#x000A;%                P1_Start=0;&#x000D;&#x000A;%                P1_Stop=0;&#x000D;&#x000A;%            end;&#x000D;&#x000A;%            if (Pilot2_Enable==1)&#x000D;&#x000A;%                P2_Start=P2_Stop+1;&#x000D;&#x000A;%    &#x0009;        P2_Stop=P2_Stop+Pilot2_NumOfCarriers(ii+1);&#x000D;&#x000A;%    &#x0009;    else&#x000D;&#x000A;%    &#x0009;        P2_Start=0;&#x000D;&#x000A;%    &#x0009;        P2_Stop=0;&#x000D;&#x000A;%    &#x0009;    end;&#x000D;&#x000A;%            P_Start=P_Stop+1;&#x000D;&#x000A;%            P_Stop=P1_Stop+P2_Stop;&#x000D;&#x000A;%            ResourceMap=4*ones(1,NumOfCarriers);&#x000D;&#x000A;%            ResourceMod=zeros(1,NumOfCarriers);&#x000D;&#x000A;%        end;&#x000D;&#x000A;%        Data_CarrierPos=Data_CarrierIndex(Data_Start:Data_Stop)+Subcarrier_Index_Start;&#x000D;&#x000A;%    &#x000D;&#x000A;%        if (1==Pilot1_Enable)&#x000D;&#x000A;%            if (Pilot2_Enable==0)&#x000D;&#x000A;%                Pilot_Position=Pilot1_CarrierIndex(P1_Start:P1_Stop);&#x000D;&#x000A;%            else&#x000D;&#x000A;%                Pilot_Position=[Pilot1_CarrierIndex(P1_Start:P1_Stop),Pilot2_CarrierIndex(P2_Start:P2_Stop)];&#x000D;&#x000A;%            end&#x000D;&#x000A;%        else&#x000D;&#x000A;%            if (Pilot2_Enable==1)&#x000D;&#x000A;%                Pilot_Position=Pilot2_CarrierIndex(P2_Start:P2_Stop);&#x000D;&#x000A;%            end;&#x000D;&#x000A;%        end;&#x000D;&#x000A;%        &#x000D;&#x000A;%        if ((1==Pilot1_Enable)||(1==Pilot2_Enable))&#x000D;&#x000A;%            Pilot_CarrierPos=sort(Pilot_Position)+Subcarrier_Index_Start;&#x000D;&#x000A;%            ResourceMap(Pilot_CarrierPos)=1;    %Pilot subcarrier should be 1 in mapping file&#x000D;&#x000A;%            ResourceMod(Pilot_CarrierPos)=Pilot_MappingType+1;  % Pilot subcarrier should be MappingType+1 in modulation file&#x000D;&#x000A;%        end;&#x000D;&#x000A;%    &#x000D;&#x000A;%        ResourceMap(Data_CarrierPos)=0;     %Data subcarrier should be 0 in mapping file&#x000D;&#x000A;%    %    ResourceMap(Pilot_CarrierPos)=1;    %Pilot subcarrier should be 1 in mapping file&#x000D;&#x000A;%    &#x000D;&#x000A;%        ResourceMod(Data_CarrierPos)=Data1_QAM_Identifiers;&#x000D;&#x000A;%    &#x000D;&#x000A;%        for jj=1:NumOfCarriers-1&#x000D;&#x000A;%            fprintf(fid_resourcemap, &apos;%d%c&apos;, ResourceMap(jj),&apos;,&apos;);&#x000D;&#x000A;%            fprintf(fid_resourcemod, &apos;%d%c&apos;, ResourceMod(jj),&apos;,&apos;);&#x000D;&#x000A;%        end;&#x000D;&#x000A;%        fprintf(fid_resourcemap,&apos;%d\n&apos;,ResourceMap(NumOfCarriers));&#x000D;&#x000A;%        fprintf(fid_resourcemod,&apos;%d\n&apos;,ResourceMod(NumOfCarriers));&#x000D;&#x000A;%            &#x000D;&#x000A;%        &#x000D;&#x000A;%        if (Data2_Enable==1)&#x000D;&#x000A;%            ResourceMap=4*ones(1,NumOfCarriers);&#x000D;&#x000A;%            ResourceMod=zeros(1,NumOfCarriers);&#x000D;&#x000A;%            Data_Start=Data_Stop+1; &#x000D;&#x000A;%            Data_Stop=Data_Stop+Data_NumOfCarriers(Data1_NumOfSym+1);&#x000D;&#x000A;%            if (1==Pilot1_Enable)        &#x000D;&#x000A;%                P1_Start=P1_Stop+1;&#x000D;&#x000A;%    &#x0009;        P1_Stop=P1_Stop+Pilot1_NumOfCarriers(Data1_NumOfSym+1);&#x000D;&#x000A;%            else&#x000D;&#x000A;%    &#x0009;        P1_Start=0;&#x000D;&#x000A;%    &#x0009;        P1_Stop=0;&#x000D;&#x000A;%            end;&#x000D;&#x000A;%            if (Pilot2_Enable==1)&#x000D;&#x000A;%                P2_Start=P2_Stop+1;&#x000D;&#x000A;%    &#x0009;        P2_Stop=P2_Stop+Pilot2_NumOfCarriers(Data1_NumOfSym+1);&#x000D;&#x000A;%    &#x0009;    else&#x000D;&#x000A;%    &#x0009;        P2_Start=0;&#x000D;&#x000A;%    &#x0009;        P2_Stop=0;&#x000D;&#x000A;%    &#x0009;    end;&#x000D;&#x000A;%            P_Start=P_Stop+1;&#x000D;&#x000A;%            P_Stop=P1_Stop+P2_Stop;&#x000D;&#x000A;%            for ii=Data1_NumOfSym+1:Data1_NumOfSym+Data2_NumOfSym-1&#x000D;&#x000A;%                Data_CarrierPos=Data_CarrierIndex(Data_Start:Data_Stop)+Subcarrier_Index_Start;&#x000D;&#x000A;%                if (1==Pilot1_Enable)&#x000D;&#x000A;%                    if (Pilot2_Enable==0)&#x000D;&#x000A;%                        Pilot_Position=Pilot1_CarrierIndex(P1_Start:P1_Stop);&#x000D;&#x000A;%                    else&#x000D;&#x000A;%                        Pilot_Position=[Pilot1_CarrierIndex(P1_Start:P1_Stop),Pilot2_CarrierIndex(P2_Start:P2_Stop)];&#x000D;&#x000A;%                    end&#x000D;&#x000A;%                else&#x000D;&#x000A;%                    if (Pilot2_Enable==1)&#x000D;&#x000A;%                        Pilot_Position=Pilot2_CarrierIndex(P2_Start:P2_Stop);&#x000D;&#x000A;%                    end;&#x000D;&#x000A;%                end;&#x000D;&#x000A;%    &#x000D;&#x000A;%                if ((1==Pilot1_Enable)||(1==Pilot2_Enable))&#x000D;&#x000A;%                    Pilot_CarrierPos=sort(Pilot_Position)+Subcarrier_Index_Start;&#x000D;&#x000A;%                    ResourceMap(Pilot_CarrierPos)=1;    %Pilot subcarrier should be 1 in mapping file&#x000D;&#x000A;%                    ResourceMod(Pilot_CarrierPos)=Pilot_MappingType+1;  % Pilot subcarrier should be MappingType+1 in modulation file&#x000D;&#x000A;%                end;&#x000D;&#x000A;%    &#x000D;&#x000A;%                ResourceMap(Data_CarrierPos)=0;     %Data subcarrier should be 0 in mapping file&#x000D;&#x000A;%    %            ResourceMap(Pilot_CarrierPos)=1;    %Pilot subcarrier should be 1 in mapping file&#x000D;&#x000A;%    &#x000D;&#x000A;%                ResourceMod(Data_CarrierPos)=Data2_QAM_Identifiers;&#x000D;&#x000A;%    &#x000D;&#x000A;%                for jj=1:NumOfCarriers-1&#x000D;&#x000A;%                    fprintf(fid_resourcemap, &apos;%d%c&apos;, ResourceMap(jj),&apos;,&apos;);&#x000D;&#x000A;%                    fprintf(fid_resourcemod, &apos;%d%c&apos;, ResourceMod(jj),&apos;,&apos;);&#x000D;&#x000A;%                end;&#x000D;&#x000A;%                fprintf(fid_resourcemap,&apos;%d\n&apos;,ResourceMap(NumOfCarriers));&#x000D;&#x000A;%                fprintf(fid_resourcemod,&apos;%d\n&apos;,ResourceMod(NumOfCarriers));&#x000D;&#x000A;%                Data_Start=Data_Stop+1; &#x000D;&#x000A;%                Data_Stop=Data_Stop+Data_NumOfCarriers(ii+1);&#x000D;&#x000A;%                &#x000D;&#x000A;%                if (1==Pilot1_Enable)&#x000D;&#x000A;%                    P1_Start=P1_Stop+1;&#x000D;&#x000A;%    &#x0009;            P1_Stop=P1_Stop+Pilot1_NumOfCarriers(ii+1);&#x000D;&#x000A;%                else&#x000D;&#x000A;%    &#x0009;            P1_Start=0;&#x000D;&#x000A;%    &#x0009;            P1_Stop=0;&#x000D;&#x000A;%    &#x0009;        end;&#x000D;&#x000A;%    &#x000D;&#x000A;%                if (Pilot2_Enable==1)&#x000D;&#x000A;%                    P2_Start=P2_Stop+1;&#x000D;&#x000A;%    &#x0009;            P2_Stop=P2_Stop+Pilot2_NumOfCarriers(ii+1);&#x000D;&#x000A;%    &#x0009;        else&#x000D;&#x000A;%    &#x0009;            P2_Start=0;&#x000D;&#x000A;%    &#x0009;            P2_Stop=0;&#x000D;&#x000A;%    &#x0009;        end;&#x000D;&#x000A;%                P_Start=P_Stop+1;&#x000D;&#x000A;%                P_Stop=P1_Stop+P2_Stop;&#x000D;&#x000A;%                ResourceMap=4*ones(1,NumOfCarriers);&#x000D;&#x000A;%                ResourceMod=zeros(1,NumOfCarriers);&#x000D;&#x000A;%            end;&#x000D;&#x000A;%    &#x000D;&#x000A;%            Data_CarrierPos=Data_CarrierIndex(Data_Start:Data_Stop)+Subcarrier_Index_Start;&#x000D;&#x000A;%            if (1==Pilot1_Enable)        &#x000D;&#x000A;%                if (Pilot2_Enable==0)&#x000D;&#x000A;%                    Pilot_Position=Pilot1_CarrierIndex(P1_Start:P1_Stop);&#x000D;&#x000A;%                else&#x000D;&#x000A;%                    Pilot_Position=[Pilot1_CarrierIndex(P1_Start:P1_Stop),Pilot2_CarrierIndex(P2_Start:P2_Stop)];&#x000D;&#x000A;%                end&#x000D;&#x000A;%            else&#x000D;&#x000A;%                if (Pilot2_Enable==1)&#x000D;&#x000A;%                    Pilot_Position=Pilot2_CarrierIndex(P2_Start:P2_Stop);&#x000D;&#x000A;%                end&#x000D;&#x000A;%            end;&#x000D;&#x000A;%    &#x000D;&#x000A;%            if ((1==Pilot1_Enable)||(1==Pilot2_Enable))&#x000D;&#x000A;%                Pilot_CarrierPos=sort(Pilot_Position)+Subcarrier_Index_Start;&#x000D;&#x000A;%                ResourceMap(Pilot_CarrierPos)=1+MIMOIndex;    %Pilot subcarrier should be 1 in mapping file&#x000D;&#x000A;%                ResourceMod(Pilot_CarrierPos)=Pilot_MappingType+1;  % Pilot subcarrier should be MappingType+1 in modulation file&#x000D;&#x000A;%            end;&#x000D;&#x000A;%            ResourceMap(Data_CarrierPos)=0;     %Data subcarrier should be 0 in mapping file&#x000D;&#x000A;%    %        ResourceMap(Pilot_CarrierPos)=1;    %Pilot subcarrier should be 1 in mapping file&#x000D;&#x000A;%    &#x000D;&#x000A;%            ResourceMod(Data_CarrierPos)=Data2_QAM_Identifiers;&#x000D;&#x000A;%    &#x000D;&#x000A;%            for jj=1:NumOfCarriers-1&#x000D;&#x000A;%                fprintf(fid_resourcemap, &apos;%d%c&apos;, ResourceMap(jj),&apos;,&apos;);&#x000D;&#x000A;%                fprintf(fid_resourcemod, &apos;%d%c&apos;, ResourceMod(jj),&apos;,&apos;);&#x000D;&#x000A;%            end;&#x000D;&#x000A;%            fprintf(fid_resourcemap,&apos;%d\n&apos;,ResourceMap(NumOfCarriers));&#x000D;&#x000A;%            fprintf(fid_resourcemod,&apos;%d\n&apos;,ResourceMod(NumOfCarriers));&#x000D;&#x000A;%        end;&#x000D;&#x000A;%        fclose(fid_resourcemap);&#x000D;&#x000A;%        fclose(fid_resourcemod);&#x000D;&#x000A;    end;&#x000D;&#x000A;end;&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;%%%%%%%%%%%%%%%%%%%%%%%PN_Sync&#x000D;&#x000A;P1BeforeFFT = zeros(1,DFTSize);&#x000D;&#x000A;for i=1:Preamble_NumOfCarriers&#x000D;&#x000A;&#x0009;P1BeforeFFT(Preamble_CarrierIndex(i)+DFTSize/2+1)= Preamble1_Seq(i);&#x000D;&#x000A;end&#x000D;&#x000A;P1BeforeFFTOversample = [zeros(1,DFTSize*(2^(OversamplingRatio)-1)/2),P1BeforeFFT,zeros(1,DFTSize*(2^(OversamplingRatio)-1)/2)];&#x000D;&#x000A;P1BeforeFFTOversample = [P1BeforeFFTOversample(DFTSize_OVS/2+1:end),P1BeforeFFTOversample(1:DFTSize_OVS/2)];&#x000D;&#x000A;P1AfterFFTOversample = DFTSize_OVS/sqrt(ActualCarriers)*ifft(P1BeforeFFTOversample);&#x000D;&#x000A;P1Repeat =zeros(1,DFTSize_OVS*Preamble1_RepeatTimes);&#x000D;&#x000A;for i=1:Preamble1_RepeatTimes&#x000D;&#x000A;&#x0009;P1Repeat((i-1)*DFTSize_OVS+1:i*DFTSize_OVS) = P1AfterFFTOversample;&#x000D;&#x000A;end&#x000D;&#x000A;PNLocal = zeros(1,Preamble1_RepeatTimes*DFTSize_OVS*(1+Preamble1_GuardInterval))&#x000D;&#x000A;if (0==Preamble1_GuardPosition)&#x000D;&#x000A;&#x0009;if(GuardIntervalType == 0)&#x000D;&#x000A;&#x0009;&#x0009;PNLocal = [P1Repeat(end-DFTSize_OVS*Preamble1_GuardInterval+1:end),P1Repeat];&#x000D;&#x000A;&#x0009;else&#x000D;&#x000A;&#x0009;&#x0009;PNLocal = [zeros(1,DFTSize_OVS*Preamble1_GuardInterval),P1Repeat];&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;if(GuardIntervalType == 0)&#x000D;&#x000A;&#x0009;&#x0009;PNLocal = [P1Repeat,P1Repeat(1:DFTSize_OVS*Preamble1_GuardInterval),];&#x000D;&#x000A;&#x0009;else&#x000D;&#x000A;&#x0009;&#x0009;PNLocal = [P1Repeat,zeros(1,DFTSize_OVS*Preamble1_GuardInterval)];&#x000D;&#x000A;&#x0009;end&#x000D;&#x000A;end</Text>
