<Validate><T>Int</T><D>0</D></Validate></Item>
<Item XName="fc" Type="PartParam">
<DataEntry>2e9</DataEntry>
<Description>carrier frequency</Description>
<Validate><T>Int</T><D>0</D></Validate></Item></Item></Item>
