<Text>runanalysis(&apos;PhasedArrayRx&apos;);&#x000D;&#x000A;using(&apos;PhasedArrayRx_PhasedArrayRxSch_Data&apos;);&#x000D;&#x000A;PhiGrid = squeeze(ArrayMeas_Directivity_PhiGrid);&#x000D;&#x000A;ThetaGrid = squeeze(ArrayMeas_Directivity_ThetaGrid);&#x000D;&#x000A;DirectivityPattern = squeeze(ArrayMeas_Directivity_Pattern);&#x000D;&#x000A;graph3=graph_figure(&apos;BeamPatternRx&apos;);&#x000D;&#x000A;graph3.add_spherical_data(PhiGrid,ThetaGrid,max(10*log10(DirectivityPattern),-30));&#x000D;&#x000A;</Text>
