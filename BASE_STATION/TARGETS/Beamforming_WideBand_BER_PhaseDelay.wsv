<Item XName="Equations" Type="Equation">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>%%%%%%%%preamble2_repear_flag%%%%%%%%&#x000D;&#x000A;if(Preamble2_Enable==0)&#x000D;&#x000A;&#x0009;Preamble2_RepeatFlag = 1;&#x000D;&#x000A;else if(Preamble2_RepeatTimes==1)&#x000D;&#x000A;&#x0009; &#x0009;Preamble2_RepeatFlag = 2;&#x000D;&#x000A;&#x0009; else&#x000D;&#x000A;&#x0009; &#x0009;Preamble2_RepeatFlag = 0;&#x000D;&#x000A;&#x0009; end&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;%%%Parameters for the receiver:&#x000D;&#x000A;Preamble1_NumOfSyms = length(Preamble1_Seq)/Preamble_NumOfCarriers;%/2; %Need to consider MIMOType&#x000D;&#x000A;&#x000D;&#x000A;if ((Pilot1_Enable ==1)&amp;(Pilot2_Enable==1))&#x000D;&#x000A;&#x0009;NumDemux = 3;&#x000D;&#x000A;&#x0009;else if((Pilot1_Enable ==1)|(Pilot2_Enable==1))&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;NumDemux = 2;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x000D;&#x000A;&#x0009;&#x0009; else&#x000D;&#x000A;&#x0009;&#x0009;    NumDemux = 1;&#x000D;&#x000A;&#x0009;&#x0009; end&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if(Data2_Enable ==1)&#x000D;&#x000A;&#x0009;DataNum =2;&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;DataNum =1;&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;NumChannel = NumOfTx*NumOfRx;&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;%%%Important notes: need to remove this before the release%%%%&#x000D;&#x000A;&#x000D;&#x000A;%Only support &quot;Fixed&quot; mode of subcarrier allocation&#x000D;&#x000A;%For MIMOType=0 (Type1), only Pilot1 is supported (Pilot2 is not supported).&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;if (MIMOType == 0 &amp; Pilot2_Enable == 1)&#x000D;&#x000A;&#x0009;error(&apos;When MIMOType is set to Type 1 (non-overlapping preamble and pilots), only one pilot set is supported which means Pilot2_Enable should be set to OFF.&apos;);&#x000D;&#x000A;end;&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;%See the help doc of VSA 89600 for Custom MIMO OFDM&#x000D;&#x000A;if (NumOfTx == 1)&#x000D;&#x000A;&#x0009;MIMOIndex = 0;&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;if (MIMOType == 0) %Type1&#x000D;&#x000A;&#x0009;&#x0009;MIMOIndex = 64*[0:NumOfTx-1];&#x000D;&#x000A;&#x0009;else               %Type2&#x000D;&#x000A;&#x0009;&#x0009;MIMOIndex = 512;&#x000D;&#x000A;&#x0009;end;&#x000D;&#x000A;end;&#x000D;&#x000A;&#x000D;&#x000A;MappingTypeTable=[0;1;3;5;7;12;2;4;6;8;9;10;11];&#x000D;&#x000A;Data1_MappingTypeNew = MappingTypeTable(Data1_MappingType+1);&#x000D;&#x000A;Data2_MappingTypeNew = MappingTypeTable(Data2_MappingType+1);&#x000D;&#x000A;&#x000D;&#x000A;%Find the index in QAM_Identifiers according to QAM_Levels&#x000D;&#x000A;Data1_QAM_Identifiers = Data1_MappingTypeNew+1;&#x000D;&#x000A;if find(QAM_Levels==Data1_MappingTypeNew+1)&#x000D;&#x000A;    Data1_QAM_Identifiers  = QAM_Identifiers(find(QAM_Levels==Data1_MappingTypeNew+1));&#x000D;&#x000A;end;&#x000D;&#x000A;&#x000D;&#x000A;Data2_QAM_Identifiers = Data2_MappingTypeNew+1;&#x000D;&#x000A;if (find(QAM_Levels==Data2_MappingTypeNew+1))&#x000D;&#x000A;    Data2_QAM_Identifiers  = QAM_Identifiers(find(QAM_Levels==Data2_MappingTypeNew+1));&#x000D;&#x000A;end;&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;DFTSize_OVS=DFTSize*2^OversamplingRatio;&#x000D;&#x000A;&#x000D;&#x000A;if (0==Preamble1_Enable)&#x000D;&#x000A;    Preamble1_Flag=1;&#x000D;&#x000A;    Preamble1_DomainFlag=1;&#x000D;&#x000A;    Preamble1_TimeFlag=1;&#x000D;&#x000A;else&#x000D;&#x000A;    Preamble1_Flag=0;&#x000D;&#x000A;    if (Preamble_FrequencyDomain==1)&#x000D;&#x000A;        Preamble1_DomainFlag=1;&#x000D;&#x000A;        Preamble1_TimeFlag=0;&#x000D;&#x000A;    else&#x000D;&#x000A;        Preamble1_DomainFlag=0;&#x000D;&#x000A;        Preamble1_TimeFlag=1;&#x000D;&#x000A;    end&#x000D;&#x000A;end;&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;if (0==Preamble2_Enable)&#x000D;&#x000A;    Preamble2_Flag=1;&#x000D;&#x000A;    Preamble2_DomainFlag=1;&#x000D;&#x000A;    Preamble2_TimeFlag=1;&#x000D;&#x000A;else&#x000D;&#x000A;    Preamble2_Flag=0;&#x000D;&#x000A;    if (Preamble_FrequencyDomain==1)&#x000D;&#x000A;        Preamble2_DomainFlag=1;&#x000D;&#x000A;        Preamble2_TimeFlag=0;&#x000D;&#x000A;    else&#x000D;&#x000A;        Preamble2_DomainFlag=0;&#x000D;&#x000A;        Preamble2_TimeFlag=1;&#x000D;&#x000A;    end&#x000D;&#x000A;end;&#x000D;&#x000A;&#x000D;&#x000A;if (0==Data2_Enable)&#x000D;&#x000A;    Data2_Flag=2;&#x000D;&#x000A;    Data2_Flag1=1;&#x000D;&#x000A;else&#x000D;&#x000A;    Data2_Flag=0;&#x000D;&#x000A;    Data2_Flag1=0;&#x000D;&#x000A;end;&#x000D;&#x000A;&#x000D;&#x000A;if (SymbolWindowing_Enable==0)&#x000D;&#x000A;    SymbolWindowingFlay=2;&#x000D;&#x000A;else&#x000D;&#x000A;    SymbolWindowingFlay=0;&#x000D;&#x000A;end;&#x000D;&#x000A;&#x000D;&#x000A;% For VTB&#x000D;&#x000A;BusWidth_1 = 2 - SymbolWindowingFlay/2&#x000D;&#x000A;&#x000D;&#x000A;if (0==Idle)&#x000D;&#x000A;    Idle_Flag=1;&#x000D;&#x000A;else&#x000D;&#x000A;    Idle_Flag=0;&#x000D;&#x000A;end;&#x000D;&#x000A;&#x000D;&#x000A;clear SymWindow_BlockSize;&#x000D;&#x000A;clear SymWindow_PreGI;&#x000D;&#x000A;clear SymWindow_PostGI;&#x000D;&#x000A;if (0==Preamble_FrequencyDomain)&#x000D;&#x000A;    Preamble1_Blocksize_OVS=DFTSize_OVS;&#x000D;&#x000A;    Preamble2_Blocksize_OVS=DFTSize_OVS;&#x000D;&#x000A;    Preamble1_Blk_GI=DFTSize;&#x000D;&#x000A;    Preamble2_Blk_GI=DFTSize;&#x000D;&#x000A;    Preamble1_GI=Preamble1_RepeatTimes*DFTSize*Preamble1_GuardInterval;&#x000D;&#x000A;    Preamble2_GI=Preamble2_RepeatTimes*DFTSize*Preamble2_GuardInterval;&#x000D;&#x000A;else&#x000D;&#x000A;    Preamble1_Blocksize_OVS=Preamble1_Blocksize*2^OversamplingRatio;&#x000D;&#x000A;    Preamble2_Blocksize_OVS=Preamble2_Blocksize*2^OversamplingRatio;&#x000D;&#x000A;    Preamble1_Blk_GI=Preamble1_Blocksize;&#x000D;&#x000A;    Preamble2_Blk_GI=Preamble2_Blocksize;&#x000D;&#x000A;    Preamble1_GI=Preamble1_RepeatTimes*Preamble1_Blocksize*Preamble1_GuardInterval;&#x000D;&#x000A;    Preamble2_GI=Preamble2_RepeatTimes*Preamble2_Blocksize*Preamble2_GuardInterval;&#x000D;&#x000A;end;&#x000D;&#x000A;&#x000D;&#x000A;if (0==Preamble1_GuardPosition)&#x000D;&#x000A;    Preamble1_Prefix=Preamble1_GI;&#x000D;&#x000A;    Preamble1_Postfix=0;&#x000D;&#x000A;else&#x000D;&#x000A;    Preamble1_Postfix=Preamble1_GI;&#x000D;&#x000A;    Preamble1_Prefix=0;&#x000D;&#x000A;end;&#x000D;&#x000A;&#x000D;&#x000A;if (0==Preamble2_GuardPosition)&#x000D;&#x000A;    Preamble2_Prefix=Preamble2_GI;&#x000D;&#x000A;    Preamble2_Postfix=0;&#x000D;&#x000A;else&#x000D;&#x000A;    Preamble2_Postfix=Preamble2_GI;&#x000D;&#x000A;    Preamble2_Prefix=0;&#x000D;&#x000A;end;&#x000D;&#x000A;&#x000D;&#x000A;Data_GI=DFTSize*GuardInterval;&#x000D;&#x000A;Data_GI_OVS=Data_GI*2^OversamplingRatio;&#x000D;&#x000A;&#x000D;&#x000A;if (0==Data2_Enable)&#x000D;&#x000A;    Data_NumSym=Data1_NumOfSym;&#x000D;&#x000A;else&#x000D;&#x000A;    Data_NumSym=Data1_NumOfSym+Data2_NumOfSym;&#x000D;&#x000A;end&#x000D;&#x000A;if (0==SubcarrierAllocationType) &#x000D;&#x000A;if length(Data_NumOfCarriers) == 1&#x000D;&#x000A;    Data1_Carriers=Data1_NumOfSym*Data_NumOfCarriers;&#x000D;&#x000A;    if (1==Data2_Enable)&#x000D;&#x000A;        Data2_Carriers=Data2_NumOfSym*Data_NumOfCarriers;&#x000D;&#x000A;&#x0009;else&#x000D;&#x000A;&#x0009;&#x0009;Data2_Carriers =0;&#x000D;&#x000A;&#x0009;end;&#x000D;&#x000A;else&#x000D;&#x000A;    Data1_Carriers=Data1_NumOfSym/length(Data_NumOfCarriers)*sum(Data_NumOfCarriers);&#x000D;&#x000A;    if (1==Data2_Enable)&#x000D;&#x000A;        Data2_Carriers=Data2_NumOfSym/length(Data_NumOfCarriers)*sum(Data_NumOfCarriers);&#x000D;&#x000A;&#x0009;else&#x000D;&#x000A;&#x0009;&#x0009;Data2_Carriers =0;&#x000D;&#x000A;&#x0009;end;&#x000D;&#x000A;end;&#x000D;&#x000A;else&#x000D;&#x000A;    Data1_Carriers=0;&#x000D;&#x000A;    for ii=1:Data1_NumOfSym&#x000D;&#x000A;        Data1_Carriers=Data1_Carriers+Data_NumOfCarriers(ii);&#x000D;&#x000A;    end;&#x000D;&#x000A;    if (1==Data2_Enable)&#x000D;&#x000A;        Data2_Carriers=0;&#x000D;&#x000A;        for ii=1:Data2_NumOfSym&#x000D;&#x000A;           Data2_Carriers=Data2_Carriers+Data_NumOfCarriers(Data1_NumOfSym+ii);&#x000D;&#x000A;        end;&#x000D;&#x000A;    end;&#x000D;&#x000A;end;&#x000D;&#x000A;&#x000D;&#x000A;if (0==Data2_Enable)&#x000D;&#x000A;    Data_Commutator=[Data1_Carriers,0];&#x000D;&#x000A;else&#x000D;&#x000A;    Data_Commutator=[Data1_Carriers,Data2_Carriers];&#x000D;&#x000A;end;&#x000D;&#x000A;&#x000D;&#x000A;if (Preamble_DimCarrierIndex==1)&#x000D;&#x000A;    Pr_DimCarrierIndex=2;&#x000D;&#x000A;else&#x000D;&#x000A;    Pr_DimCarrierIndex=0;&#x000D;&#x000A;end;&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;if (Data_DimCarrierIndex==1)&#x000D;&#x000A;    D_DimCarrierIndex=2;&#x000D;&#x000A;else&#x000D;&#x000A;    D_DimCarrierIndex=0;&#x000D;&#x000A;end;&#x000D;&#x000A;&#x000D;&#x000A;if (Pilot_DimCarrierIndex==1)&#x000D;&#x000A;    P_DimCarrierIndex=2;&#x000D;&#x000A;else&#x000D;&#x000A;    P_DimCarrierIndex=0;&#x000D;&#x000A;end;&#x000D;&#x000A;&#x000D;&#x000A;if (EVMRef_DimCarrierIndex==1)&#x000D;&#x000A;    E_DimCarrierIndex=2;&#x000D;&#x000A;else&#x000D;&#x000A;    E_DimCarrierIndex=0;&#x000D;&#x000A;end;&#x000D;&#x000A;&#x000D;&#x000A;if (0==Pilot1_Enable)&#x000D;&#x000A;    Pilot1_NumOfCarriers=0;&#x000D;&#x000A;    Pilot1_CarrierIndex=[];&#x000D;&#x000A;end;&#x000D;&#x000A;&#x000D;&#x000A;if (0==Pilot2_Enable)&#x000D;&#x000A;    Pilot2_NumOfCarriers=0;&#x000D;&#x000A;    Pilot2_CarrierIndex=[];&#x000D;&#x000A;end;&#x000D;&#x000A;&#x000D;&#x000A;if (1==Preamble1_Enable)&#x000D;&#x000A;    if (0==Preamble_FrequencyDomain)&#x000D;&#x000A;        %Preamble1_Samps=Preamble1_RepeatTimes*DFTSize_OVS*(1+Preamble1_GuardInterval);&#x000D;&#x000A;&#x0009;&#x0009;Preamble1_Samps=Preamble1_NumOfSym*Preamble1_RepeatTimes*DFTSize_OVS*(1+Preamble1_GuardInterval);&#x000D;&#x000A;    else&#x000D;&#x000A;        %Preamble1_Samps=Preamble1_RepeatTimes*Preamble1_Blocksize_OVS*(1+Preamble1_GuardInterval);&#x000D;&#x000A;&#x0009;&#x0009;Preamble1_Samps=Preamble1_NumOfSym*Preamble1_RepeatTimes*Preamble1_Blocksize_OVS*(1+Preamble1_GuardInterval);&#x000D;&#x000A;    end;&#x000D;&#x000A;else&#x000D;&#x000A;    Preamble1_Samps=0;&#x000D;&#x000A;end;&#x000D;&#x000A;&#x000D;&#x000A;if (1==Preamble2_Enable)&#x000D;&#x000A;    if (0==Preamble_FrequencyDomain)&#x000D;&#x000A;        %Preamble2_Samps=Preamble2_RepeatTimes*DFTSize_OVS*(1+Preamble2_GuardInterval);&#x000D;&#x000A;&#x0009;&#x0009;Preamble2_Samps=Preamble2_NumOfSym*Preamble2_RepeatTimes*DFTSize_OVS*(1+Preamble2_GuardInterval);&#x000D;&#x000A;    else&#x000D;&#x000A;        %Preamble2_Samps=Preamble2_RepeatTimes*Preamble2_Blocksize_OVS*(1+Preamble2_GuardInterval);&#x000D;&#x000A;&#x0009;&#x0009;Preamble2_Samps=Preamble2_NumOfSym*Preamble2_RepeatTimes*Preamble2_Blocksize_OVS*(1+Preamble2_GuardInterval);&#x000D;&#x000A;    end;&#x000D;&#x000A;else&#x000D;&#x000A;    Preamble2_Samps=0;&#x000D;&#x000A;end;&#x000D;&#x000A;&#x000D;&#x000A;Data_Samps=Data_NumSym*DFTSize_OVS*(1+GuardInterval);&#x000D;&#x000A;&#x000D;&#x000A;AddIdle_OFDMSym=DFTSize_OVS*(1+GuardInterval);&#x000D;&#x000A;&#x000D;&#x000A;Frame_Samps=Preamble1_Samps+Preamble2_Samps+Data_Samps;&#x000D;&#x000A;Frame_Commutator=[Preamble1_Samps,Preamble2_Samps,Data_Samps];&#x000D;&#x000A;&#x000D;&#x000A;clear SymWindow_BlockSize;&#x000D;&#x000A;clear SymWindow_PreGI;&#x000D;&#x000A;clear SymWindow_PostGI;&#x000D;&#x000A;if ((0==Preamble1_Enable)&amp;&amp;(0==Preamble2_Enable))&#x000D;&#x000A;    SymWindow_BlockSize(1:Data_NumSym+1)=DFTSize*ones(Data_NumSym+1,1);&#x000D;&#x000A;    SymWindow_PreGI(1:Data_NumSym+1)=Data_GI*ones(Data_NumSym+1,1);&#x000D;&#x000A;    SymWindow_PostGI=zeros(1+Data_NumSym,1);&#x000D;&#x000A;elseif ((1==Preamble1_Enable)&amp;&amp;(0==Preamble2_Enable))&#x000D;&#x000A;    SymWindow_BlockSize(1)=Preamble1_Blk_GI*Preamble1_RepeatTimes;&#x000D;&#x000A;    SymWindow_BlockSize(2:Data_NumSym+2)=DFTSize*ones(Data_NumSym+1,1);&#x000D;&#x000A;    SymWindow_PreGI(1)=Preamble1_Prefix;&#x000D;&#x000A;    SymWindow_PreGI(2:Data_NumSym+2)=Data_GI*ones(Data_NumSym+1,1);&#x000D;&#x000A;    SymWindow_PostGI=zeros(2+Data_NumSym,1);&#x000D;&#x000A;    SymWindow_PostGI(1)=Preamble1_Postfix;&#x000D;&#x000A;elseif ((0==Preamble1_Enable)&amp;&amp;(1==Preamble2_Enable))&#x000D;&#x000A;    SymWindow_BlockSize(1)=Preamble2_Blk_GI*Preamble2_RepeatTimes;&#x000D;&#x000A;    SymWindow_BlockSize(2:Data_NumSym+2)=DFTSize*ones(Data_NumSym+1,1);&#x000D;&#x000A;    SymWindow_PreGI(1)=Preamble2_Prefix;&#x000D;&#x000A;    SymWindow_PreGI(2:Data_NumSym+2)=Data_GI*ones(Data_NumSym+1,1);&#x000D;&#x000A;    SymWindow_PostGI=zeros(2+Data_NumSym,1);&#x000D;&#x000A;    SymWindow_PostGI(1)=Preamble2_Postfix;&#x000D;&#x000A;else&#x000D;&#x000A;    if ((Preamble1_Prefix==0)&amp;&amp;(Preamble1_Postfix==0))&#x000D;&#x000A;        SymWindow_BlockSize(1)=Preamble1_Blk_GI*Preamble1_RepeatTimes+Preamble2_Blk_GI*Preamble2_RepeatTimes;&#x000D;&#x000A;        SymWindow_BlockSize(2:Data_NumSym+2)=DFTSize*ones(Data_NumSym+1,1);&#x000D;&#x000A;        SymWindow_PreGI(1)=Preamble2_Prefix;&#x000D;&#x000A;        SymWindow_PreGI(2:Data_NumSym+2)=Data_GI*ones(Data_NumSym+1,1);&#x000D;&#x000A;        SymWindow_PostGI=zeros(2+Data_NumSym,1);&#x000D;&#x000A;        SymWindow_PostGI(1)=Preamble2_Postfix;&#x000D;&#x000A;    else&#x000D;&#x000A;        SymWindow_BlockSize(1)=Preamble1_Blk_GI*Preamble1_RepeatTimes;&#x000D;&#x000A;        SymWindow_BlockSize(2)=Preamble2_Blk_GI*Preamble2_RepeatTimes;&#x000D;&#x000A;        SymWindow_BlockSize(3:Data_NumSym+3)=DFTSize*ones(Data_NumSym+1,1);&#x000D;&#x000A;        SymWindow_PreGI(1)=Preamble1_Prefix;&#x000D;&#x000A;        SymWindow_PreGI(2)=Preamble2_Prefix;&#x000D;&#x000A;        SymWindow_PreGI(3:Data_NumSym+3)=Data_GI*ones(Data_NumSym+1,1);&#x000D;&#x000A;        SymWindow_PostGI=zeros(3+Data_NumSym,1);&#x000D;&#x000A;        SymWindow_PostGI(1)=Preamble1_Postfix;&#x000D;&#x000A;        SymWindow_PostGI(2)=Preamble2_Postfix;&#x000D;&#x000A;    end;&#x000D;&#x000A;end;&#x000D;&#x000A;&#x000D;&#x000A;SymbolWindowing_Delay=(RC_SlopeLength*2^OversamplingRatio)/2;&#x000D;&#x000A;&#x000D;&#x000A;if (0==Idle)&#x000D;&#x000A;    Idle_Commutator=[0,Frame_Samps];&#x000D;&#x000A;else&#x000D;&#x000A;    Idle_Commutator=[Idle,Frame_Samps];&#x000D;&#x000A;end;&#x000D;&#x000A;&#x000D;&#x000A;if (Data1_MappingTypeNew==0)&#x000D;&#x000A;    D1_MappingType=0;&#x000D;&#x000A;elseif (Data1_MappingTypeNew==1)&#x000D;&#x000A;    D1_MappingType=1;&#x000D;&#x000A;elseif (Data1_MappingTypeNew==2)&#x000D;&#x000A;    D1_MappingType=2;&#x000D;&#x000A;elseif (Data1_MappingTypeNew==3)&#x000D;&#x000A;    D1_MappingType=4;&#x000D;&#x000A;elseif (Data1_MappingTypeNew==4)&#x000D;&#x000A;    D1_MappingType=5;&#x000D;&#x000A;elseif (Data1_MappingTypeNew==5)&#x000D;&#x000A;    D1_MappingType=6;&#x000D;&#x000A;elseif (Data1_MappingTypeNew==6)&#x000D;&#x000A;    D1_MappingType=7;&#x000D;&#x000A;elseif (Data1_MappingTypeNew==7)&#x000D;&#x000A;    D1_MappingType=8;&#x000D;&#x000A;elseif (Data1_MappingTypeNew==8)&#x000D;&#x000A;    D1_MappingType=10;&#x000D;&#x000A;elseif (Data1_MappingTypeNew==9)&#x000D;&#x000A;    D1_MappingType=11;&#x000D;&#x000A;elseif (Data1_MappingTypeNew==10)&#x000D;&#x000A;    D1_MappingType=12;&#x000D;&#x000A;elseif (Data1_MappingTypeNew==11)&#x000D;&#x000A;    D1_MappingType=13;&#x000D;&#x000A;else&#x000D;&#x000A;    D1_MappingType=9;&#x000D;&#x000A;end;&#x000D;&#x000A;&#x000D;&#x000A;if (Data2_MappingTypeNew==0)&#x000D;&#x000A;    D2_MappingType=0;&#x000D;&#x000A;elseif (Data2_MappingTypeNew==1)&#x000D;&#x000A;    D2_MappingType=1;&#x000D;&#x000A;elseif (Data2_MappingTypeNew==2)&#x000D;&#x000A;    D2_MappingType=2;&#x000D;&#x000A;elseif (Data2_MappingTypeNew==3)&#x000D;&#x000A;    D2_MappingType=4;&#x000D;&#x000A;elseif (Data2_MappingTypeNew==4)&#x000D;&#x000A;    D2_MappingType=5;&#x000D;&#x000A;elseif (Data2_MappingTypeNew==5)&#x000D;&#x000A;    D2_MappingType=6;&#x000D;&#x000A;elseif (Data2_MappingTypeNew==6)&#x000D;&#x000A;    D2_MappingType=7;&#x000D;&#x000A;elseif (Data2_MappingTypeNew==7)&#x000D;&#x000A;    D2_MappingType=8;&#x000D;&#x000A;elseif (Data2_MappingTypeNew==8)&#x000D;&#x000A;    D2_MappingType=10;&#x000D;&#x000A;elseif (Data2_MappingTypeNew==9)&#x000D;&#x000A;    D2_MappingType=11;&#x000D;&#x000A;elseif (Data2_MappingTypeNew==10)&#x000D;&#x000A;    D2_MappingType=12;&#x000D;&#x000A;elseif (Data2_MappingTypeNew==11)&#x000D;&#x000A;    D2_MappingType=13;&#x000D;&#x000A;else&#x000D;&#x000A;    D2_MappingType=9;&#x000D;&#x000A;end;&#x000D;&#x000A;&#x000D;&#x000A;Subcarrier_Index_Start=DFTSize/2-GuardLowerSubcarriers+1;&#x000D;&#x000A;ActualCarriers=DFTSize-GuardLowerSubcarriers-GuardUpperSubcarriers-NumOfDC_Subcarriers;&#x000D;&#x000A;NumOfCarriers=DFTSize-GuardLowerSubcarriers-GuardUpperSubcarriers;&#x000D;&#x000A;&#x000D;&#x000A;BusWidth_2 = 1 + Idle_Flag&#x000D;&#x000A;&#x000D;&#x000A;if (SubcarrierAllocationType==0)&#x000D;&#x000A;    ActualCarriers=Data_NumOfCarriers(1);&#x000D;&#x000A;    if (Pilot1_Enable==1)&#x000D;&#x000A;        ActualCarriers=Data_NumOfCarriers(1)+Pilot1_NumOfCarriers(1);&#x000D;&#x000A;    end;&#x000D;&#x000A;    if (Pilot2_Enable==1)&#x000D;&#x000A;        ActualCarriers=Data_NumOfCarriers(1)+Pilot2_NumOfCarriers(1);&#x000D;&#x000A;    end;&#x000D;&#x000A;    if (NumOfCarriers==0)&#x000D;&#x000A;        ActualCarriers=DFTSize-GuardLowerSubcarriers-GuardUpperSubcarriers-NumOfDC_Subcarriers;&#x000D;&#x000A;    end;&#x000D;&#x000A;end;&#x000D;&#x000A;&#x000D;&#x000A;if (0==GenConfigFile)   %GenConfigFile=Yes to generate configureation files for VSA89600 custom OFDM option&#x000D;&#x000A;    fid_preamble=fopen(SV_PreambleIQ,&apos;w&apos;);&#x000D;&#x000A;&#x0009;if (0==Preamble_FrequencyDomain)&#x000D;&#x000A;    &#x0009;if (1==Preamble1_Enable &amp; 0==Preamble2_Enable)   &#x000D;&#x000A;&#x0009;&#x0009;&#x0009;if (MIMOType == 0) %Type1&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0009;Preamble1_Seq_PerAnt_Size = length(Preamble1_Seq)/NumOfTx;&#x000D;&#x000A;&#x0009;&#x0009;&#x0009;&#x0