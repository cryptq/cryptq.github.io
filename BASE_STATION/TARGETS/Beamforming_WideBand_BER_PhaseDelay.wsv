<Item XName="VarBlock" Type="VarBlock">
<Item XName="EnableSignal" Type="Variable">
<Creator>Equations</Creator>
<Data><T>Array_Dbl64</T><D>2;1;16;;m}3;m}3;m}3;m}3;m}3;m}3;m}3;m}3;m}3;m}3;m}3;m}3;m}3;m}3;m}3</D></Data></Item>
<Item XName="LenOfOFDM" Type="Variable">
<Data><T>Double</T><D>80</D></Data></Item>
<Item XName="MaxNumOfRxRFChains" Type="Variable">
<Creator>Equations</Creator>
<Data><T>Double</T><D>16</D></Data></Item>
<Item XName="Nr" Type="Variable">
<Data><T>Double</T><D>8</D></Data></Item>
<Item XName="Nrrf" Type="Variable">
<Data><T>Double</T><D>1</D></Data></Item>
<Item XName="Nt" Type="Variable">
