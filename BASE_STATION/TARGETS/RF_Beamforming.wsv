<Item XName="setup" UserName="setup" Type="Equation">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>SymbolRate = 250e6;&#x000D;&#x000A;%SampleRate = 250e6*4; %assume 16-QAM or Star-16QAM&#x000D;&#x000A;NDensity = -115;&#x000D;&#x000A;&#x000D;&#x000A;FilterFactor = 0.10;&#x000D;&#x000A;Filter_Length = 321;&#x000D;&#x000A;&#x000D;&#x000A;NumOfAnt_X = 8;&#x000D;&#x000A;NumOfAnt_Y = 8;&#x000D;&#x000A;NumAnts = NumOfAnt_X * NumOfAnt_Y;&#x000D;&#x000A;&#x000D;&#x000A;% Amplifier parameters&#x000D;&#x000A;Amp_NF = 5;&#x000D;&#x000A;Amp_OIP3 = 31;&#x000D;&#x000A;Amp_P1dB = 20;&#x000D;&#x000A;&#x000D;&#x000A;% Phase shifter parameters&#x000D;&#x000A;&#x000D;&#x000A;% Theta = 0 deg, Phi = N/A deg&#x000D;&#x000A;weights1=ones(64,1);&#x000D;&#x000A;phases1 = angle(weights1)/pi*180;&#x000D;&#x000A;weights = weights1;&#x000D;&#x000A;%weights for 8x8 array are in row major&#x000D;&#x000A;phases1 = reshape(phases1,NumOfAnt_Y,NumOfAnt_X)&apos;;&#x000D;&#x000A;&#x000D;&#x000A;% Theta = 22 deg, Phi = 155 deg&#x000D;&#x000A;weights2=[&#x000D;&#x000A;    1.0000          &#x000D;&#x000A;    0.4831 + 0.8756i&#x000D;&#x000A;   -0.5332 + 0.8460i&#x000D;&#x000A;   -0.9983 - 0.0582i&#x000D;&#x000A;   -0.4314 - 0.9022i&#x000D;&#x000A;    0.5815 - 0.8135i&#x000D;&#x000A;    0.9932 + 0.1161i&#x000D;&#x000A;    0.3781 + 0.9257i&#x000D;&#x000A;    0.8788 - 0.4771i&#x000D;&#x000A;    0.8423 + 0.5390i&#x000D;&#x000A;   -0.0650 + 0.9979i&#x000D;&#x000A;   -0.9051 + 0.4252i&#x000D;&#x000A;   -0.8095 - 0.5871i&#x000D;&#x000A;    0.1229 - 0.9924i&#x000D;&#x000A;    0.9283 - 0.3718i&#x000D;&#x000A;    0.7740 + 0.6332i&#x000D;&#x000A;    0.5447 - 0.8386i&#x000D;&#x000A;    0.9974 + 0.0718i&#x000D;&#x000A;    0.4190 + 0.9080i&#x000D;&#x000A;   -0.5926 + 0.8055i&#x000D;&#x000A;   -0.9916 - 0.1297i&#x000D;&#x000A;   -0.3655 - 0.9308i&#x000D;&#x000A;    0.6384 - 0.7697i&#x000D;&#x000A;    0.9823 + 0.1872i&#x000D;&#x000A;    0.0786 - 0.9969i&#x000D;&#x000A;    0.9108 - 0.4128i&#x000D;&#x000A;    0.8014 + 0.5981i&#x000D;&#x000A;   -0.1365 + 0.9906i&#x000D;&#x000A;   -0.9333 + 0.3591i&#x000D;&#x000A;   -