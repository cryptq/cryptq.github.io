<Item XName="plot" UserName="plot" Type="Equation">
<AutoCalc><T>Bool</T><D>0</D></AutoCalc>
<Selected><T>Bool</T><D>0</D></Selected>
<Text>weights = weights1+weights2+weights3+weights4;&#x000D;&#x000A;&#x000D;&#x000A;Nx = NumOfAnt_X;&#x000D;&#x000A;Ny = NumOfAnt_Y;&#x000D;&#x000A;&#x000D;&#x000A;Dx = 0.5; % in terms of wavelength&#x000D;&#x000A;Dy = 0.5; % in terms of wavelength&#x000D;&#x000A;&#x000D;&#x000A;TWOPI = 2*pi;&#x000D;&#x000A;&#x000D;&#x000A;theta = [0 : pi/180 : pi/2];&#x000D;&#x000A;phi = [0 : pi/180 : 2 * pi];&#x000D;&#x000A;&#x000D;&#x000A;[THETA,PHI]=meshgrid(theta,phi);&#x000D;&#x000A;&#x000D;&#x000A;AF_Tx = zeros(size(THETA));&#x000D;&#x000A;&#x000D;&#x000A;for n = 1 : Ny&#x000D;&#x000A;&#x0009;for m = 1 : Nx&#x000D;&#x000A;        AF_Tx = AF_Tx + weights(m+(n-1)*Nx) * exp(j * TWOPI * ((m-1) * Dx * cos(PHI) + (n-1) * Dy * sin(PHI)) .* sin(THETA));&#x000D;&#x000A;    end&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;AF_Tx=max(10*log10(abs(AF_Tx)),0);&#x000D;&#x000A;&#x000D;&#x000A;ftx = graph_figure(&apos;Tx Spherical&apos;);&#x000D;&#x000A;ftx.add_spherical_data(PHI,THETA,AF_Tx);</Text>
