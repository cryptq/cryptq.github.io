<Item XName="Equations" Type="Equation">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>% ------------------------------- FREQUENTLY USED PARAMETERS ------------------------------&#x000D;&#x000A;fc = 73e9; % carrier frequency&#x000D;&#x000A;fs = 5e3; % sampling rate&#x000D;&#x000A;OSR = 4; % oversampling ratio&#x000D;&#x000A;Ns = 1; % number of streams&#x000D;&#x000A;% Tx antenna array&#x000D;&#x000A;NumOfTxAntx = 1; % number of antennas in x-axis direction in Tx&#x000D;&#x000A;NumOfTxAnty = 4; % number of antennas in y-axis direction in Tx&#x000D;&#x000A;NumOfTxAntz = 4; % number of antennas in z-axis direction in Tx&#x000D;&#x000A;Nt = NumOfTxAntx*NumOfTxAnty*NumOfTxAntz; % overall antenna number in Tx&#x000D;&#x000A;Ntrf = 1; % number of RF Chains in Tx&#x000D;&#x000A;% Rx antenna array&#x000D;&#x000A;NumOfRxAntx = 1; % number of antennas in x-axis direction in Rx&#x000D;&#x000A;NumOfRxAnty = 4; % number of antennas in y-axis direction in Rx&#x000D;&#x000A;NumOfRxAntz = 1; % number of antennas in z-axis direction in Rx&#x000D;&#x000A;Nr = NumOfRxAntx*NumOfRxAnty*NumOfRxAntz; % overall antenna number in Rx&#x000D;&#x000A;Nrrf = Ntrf; % number of RF Chains in Rx; should be equal to Ntrf&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;% ----------------------------------- OTHER PARAMETERS ------------------------------------&#x000D;&#x000A;% ------------------------------- Sim and Analysis Parameters -----------------------------&#x000D;&#x000A;NumOfTimestamps = 3; % the number of time stamps for plotting analysis&#x000D;&#x000A;TimeStampPeriod = 17; % sampling period for plotting analysis&#x000D;&#x000A;TimeStampStartPos = 16; % sampling offset during each period&#x000D;&#x000A;nSim = 10000; % number of simulation loops&#x000D;&#x000A;nDiscard = 15; % number of discard&#x000D;&#x000A;% ----------------------------------- Common Parameters -----------------------------------&#x000D;&#x000A;BitsPerSym = 2; % number of bits per symbol&#x000D;&#x000A;BitsPerFrame = BitsPerSym; % number of bits per frame&#x000D;&#x000A;BitRate = fs/OSR*BitsPerSym*Ns; % bit rate&#x000D;&#x000A;SymRate = BitRate/(BitsPerSym*Ns); % symbol rate&#x000D;&#x000A;BitsPerSampleTime = BitsPerSym * Ns; % bits number per sample time&#x000D;&#x000A;%NoisePow = 1; % noise power for HBF_Controller_NB module&#x000D;&#x000A;SmoothingFactor = 0.1; % smoothing factor for covariance matrix calculation in HBF_Controller module&#x000D;&#x000A;&#x000D;&#x000A;SigPow_dBm = 20;&#x000D;&#x000A;BeamformingGain = 10*log10(Nt) + 10*log10(Nr);&#x000D;&#x000A;NDensity_dBm = SigPow_dBm + 10*log10(Nt) - SNR - 10*log10(fs/OSR) + BeamformingGain; % noise density for full connection mode &#x000D;&#x000A;NoisePow = 10^((NDensity_dBm-30)/10); % &#x000D;&#x000A;&#x000D;&#x000A;% ----------------------------------- Parameters for Tx -----------------------------------&#x000D;&#x000A;% Tx Antenna Array&#x000D;&#x000A;TxDx = 0.5; TxDy = 0.5; TxDz = 0.5; % antenna spacing in x/y/z-axis direction in Tx&#x000D;&#x000A;Ntrf = Ns; % number of RF Chains in Tx&#x000D;&#x000A;NumOfTxRFChains = Ntrf;&#x000D;&#x000A;TxAntennaArrayMask = ones(Nt,Ntrf); % configure the connections between each RF chain and each antenna element in Tx&#x000D;&#x000A;%TxAntennaArrayMask = eye(Nt);&#x000D;&#x000A;TxPhaseShifterDistortion = ones(Nt,Ntrf); % antenna calibration error in Txs&#x000D;&#x000A;TxPosition_X = zeros(Nt,1); % antenna position coordinate in x-axis in Tx&#x000D;&#x000A;TxPosition_Y = reshape(repmat(TxDy*(0:NumOfTxAnty-1)&apos;,NumOfTxAntz,1),[],1); % antenna position coordinate in y-axis in Tx&#x000D;&#x000A;TxPosition_Z = kron(TxDz*[0:NumOfTxAntz-1]&apos;,ones(NumOfTxAnty,1)); % antenna position coordinate in z-axis in Tx&#x000D;&#x000A;% Rx Antenna Array&#x000D;&#x000A;RxDx = 0.5; RxDy = 0.5; RxDz = 0.5; % antenna spacing in x/y/z-axis direction in Rx&#x000D;&#x000A;Nrrf = Ntrf; % number of RF Chains in Rx&#x000D;&#x000A;NumOfRxRFChains = Nrrf;&#x000D;&#x000A;RxAntennaArrayMask = ones(Nr,Nrrf); % configure the connections between each RF chain and each antenna element in Rx&#x000D;&#x000A;%RxAntennaArrayMask = eye(Nr);&#x000D;&#x000A;RxPhaseShifterDistortion = ones(Nr,Nrrf); % antenna calibration error in Rx&#x000D;&#x000A;RxPosition_X = zeros(Nr,1); % antenna position coordinate in x-axis in Rx&#x000D;&#x000A;RxPosition_Y = reshape(repmat(RxDy*[0:NumOfRxAnty-1]&apos;,NumOfRxAntz,1),[],1); % antenna position coordinate in y-axis in Rx&#x000D;&#x000A;RxPosition_Z = kron(RxDz*[0:NumOfRxAntz-1]&apos;,ones(NumOfRxAnty,1)); % antenna position coordinate in y-axis in Rx&#x000D;&#x000A;RxAntennaArrayMask = ones(Nr,Nrrf); % configure the connections between each RF chain and each antenna element in Rx&#x000D;&#x000A;RxPhaseShifterDistortion = ones(Nr,Nrrf); % antenna calibration error in Rx&#x000D;&#x000A;&#x000D;&#x000A;% -------------------------------------- 1-path channel ---------------------------------------&#x000D;&#x000A;NumberofPath = 1; % number of multiple paths&#x000D;&#x000A;PathDelay = [0]; % time delay for each path in seconds&#x000D;&#x000A;PathPowerindB = [0]; % path power gain in dB&#x000D;&#x000A;PathAoA = [40]; % azimuth angle of arrival in Rx&#x000D;&#x000A;PathAoD = [30]; % azimuth angle of departure in Tx&#x000D;&#x000A;ASofAoA = [0]/1700; % angular spread of AoA in Rx&#x000D;&#x000A;ASofAoD = [0]/1700; % angular spread of AoD in Tx&#x000D;&#x000A;PathZoA = [90]; % zenith angle of arrival in Rx&#x000D;&#x000A;PathZoD = [90]; % zenith angle of departure in Tx&#x000D;&#x000A;ZSofZoA = [0]/1000; % zenith spread of ZoA&#x000D;&#x000A;ZSofZoD = [0]/1000; % zenith spread of ZoD&#x000D;&#x000A;RicianFactorindB = [6]; % Rician Factor in dB&#x000D;&#x000A;XPRindB = -9; % XPR&#x000D;&#x000A;&#x000D;&#x000A;%&#x000D;&#x000A;%% normalize PathPowerindB&#x000D;&#x000A;%PathPowerLinear = 10.^(PathPowerindB/10);&#x000D;&#x000A;%PathPowerLinear = PathPowerLinear/sum(PathPowerLinear);&#x000D;&#x000A;%PathPowerindB = 10*log10(PathPowerLinear);&#x000D;&#x000A;%&#x000D;&#x000A;%%% -------------------------------------- 2-path channel ---------------------------------------&#x000D;&#x000A;%NumberofPath = 2; % number of multiple paths&#x000D;&#x000A;%PathDelay = [0,0]; % time delay for each path in seconds&#x000D;&#x000A;%PathPowerindB = [0,-1]; % path power gain in dB&#x000D;&#x000A;%PathAoA = [320,30]; % azimuth angle of arrival in Rx&#x000D;&#x000A;%PathAoD = [330,20]; % azimuth angle of departure in Tx&#x000D;&#x000A;%ASofAoA = [17,17]; % angular spread of AoA in Rx&#x000D;&#x000A;%ASofAoD = [3,3]; % angular spread of AoD in Tx&#x000D;&#x000A;%PathZoA = [70,110]; % zenith angle of arrival in Rx&#x000D;&#x000A;%PathZoD = [60,120]; % zenith angle of departure in Tx&#x000D;&#x000A;%ZSofZoA = [7,7]; % zenith spread of ZoA&#x000D;&#x000A;%ZSofZoD = [3,3]; % zenith spread of ZoD&#x000D;&#x000A;%RicianFactorindB = [6,-999]; % Rician Factor in dB&#x000D;&#x000A;%XPRindB = -9; % XPR&#x000D;&#x000A;%% normalize PathPowerindB&#x000D;&#x000A;%PathPowerLinear = 10.^(PathPowerindB/10);&#x000D;&#x000A;%PathPowerLinear = PathPowerLinear/sum(PathPowerLinear);&#x000D;&#x000A;%PathPowerindB = 10*log10(PathPowerLinear);&#x000D;&#x000A;%% -------------------------------------- 4-path channel --------------------------------------&#x000D;&#x000A;%NumberofPath = 4; % number of multiple paths&#x000D;&#x000A;%%PathDelay = [0,0,0,0];&#x000D;&#x000A;%PathDelay = [0,1/fs,2.5/fs,5/fs]; % time delay for each path in seconds&#x000D;&#x000A;%PathPowerindB = [0,-1,1,2]; % path power gain in dB&#x000D;&#x000A;%PathAoA = [330,330,30,30]; % azimuth angle of arrival in Rx&#x000D;&#x000A;%PathAoD = [320,320,40,40]; % azimuth angle of departure in Tx&#x000D;&#x000A;%ASofAoA = [17,17,17,17]; % angular spread of AoA in Rx&#x000D;&#x000A;%ASofAoD = [3,3,3,3]; % angular spread of AoD in Tx&#x000D;&#x000A;%PathZoA = [70,110,70,110]; % zenith angle of arrival in Rx&#x000D;&#x000A;%PathZoD = [60,120,60,120]; % zenith angle of departure in Tx&#x000D;&#x000A;%ZSofZoA = [7,7,7,7]; % zenith spread of ZoA&#x000D;&#x000A;%ZSofZoD = [3,3,3,3]; % zenith spread of ZoD&#x000D;&#x000A;%RicianFactorindB = [6,-999,-999,-999]; % Rician Factor in dB&#x000D;&#x000A;%XPRindB = -9; % XPR&#x000D;&#x000A;%% ----------------------------------- 4-path channel large AS ----------------------------------&#x000D;&#x000A;%NumberofPath = 4; % number of multiple paths&#x000D;&#x000A;%%PathDelay = [0,0,0,0];&#x000D;&#x000A;%PathDelay = [0,1/fs,1.5/fs,2/fs]; % time delay for each path in seconds&#x000D;&#x000A;%PathPowerindB = [0,-1,1,2]; % path power gain in dB&#x000D;&#x000A;%PathAoA = [330,330,30,30]; % azimuth angle of arrival in Rx&#x000D;&#x000A;%PathAoD = [320,320,40,40]; % azimuth angle of departure in Tx&#x000D;&#x000A;%ASofAoA = [170,170,170,170]; % angular spread of AoA in Rx&#x000D;&#x000A;%ASofAoD = [130,130,130,130]; % angular spread of AoD in Tx&#x000D;&#x000A;%PathZoA = [70,110,70,110]; % zenith angle of arrival in Rx&#x000D;&#x000A;%PathZoD = [60,120,60,120]; % zenith angle of departure in Tx&#x000D;&#x000A;%ZSofZoA = [170,170,170,170]; % zenith spread of ZoA&#x000D;&#x000A;%ZSofZoD = [130,130,130,130]; % zenith spread of ZoD&#x000D;&#x000A;%RicianFactorindB = [6,-999,-999,-999]; % Rician Factor in dB&#x000D;&#x000A;%XPRindB = -9; % XPR&#x000D;&#x000A;% ------------------------------- Pulse Shaping Filter Desing -------------------------------&#x000D;&#x000A;filter_taps_tmp = [-1.88433856145506e-003, -2.87083130451095e-003, -7.36650419386987e-004, 3.21559885820013e-003, 5.32971429942469e-003, 2.4934994654815e-003, -4.59527265564694e-003, -1.07226776074469e-002, -9.42169280727528e-003, 1.51240098753274e-003, 1.63995751429225e-002, 2.36346425718719e-002, 1.33242857485617e-002, -1.3812453451094e-002, -4.27714205714213e-002, -4.99092325885788e-002, -1.61336029397479e-002, 5.9740632384347e-002, 0.156168690982266, 0.236882449220743, 0.268313366490428, 0.236882449220743, 0.156168690982265, 5.9740632384347e-002, -1.61336029397479e-002, -4.99092325885788e-002, -4.27714205714213e-002, -1.38124534510939e-002, 1.33242857485617e-002, 2.36346425718719e-002, 1.63995751429225e-002, 1.51240098753266e-003, -9.42169280727528e-003, -1.07226776074469e-002, -4.59527265564693e-003, 2.4934994654815e-003, 5.3297142994247e-003, 3.21559885820013e-003, -7.36650419386987e-004, -2.87083130451095e-003, -1.88433856145506e-003];&#x000D;&#x000A;ene = sum(abs(filter_taps_tmp).^2);&#x000D;&#x000A;filter_taps = filter_taps_tmp/sqrt(ene);&#x000D;&#x000A;filterLength = floor(length(filter_taps-1)/OSR); %Symbol delay in symbols due to transmit upsampler and receiver downsampler&#x000D;&#x000A;% --------------------------------- Range Check ---------------------------------------------&#x000D;&#x000A;if (sum(abs(PathDelay))-0) &gt; 1e-10&#x000D;&#x000A;&#x0009;error(&apos;PathDelay should be all zeros for narrowband HBF system simulation.&apos;);&#x000D;&#x000A;end&#x0009;</Text>
