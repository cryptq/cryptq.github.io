<Item XName="Equations" Type="Equation">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>MaxNum = 16;&#x000D;&#x000A;EnableSignal = zeros(MaxNum,1);&#x000D;&#x000A;&#x000D;&#x000A;if (NumChannels &lt; 1) || (NumChannels &gt; MaxNum)&#x000D;&#x000A;&#x0009;error(&apos;The range of NumChannels should be [1,16].&apos;);&#x000D;&#x000A;end&#x000D;&#x000A;&#x000D;&#x000A;if NumChannels == MaxNum&#x000D;&#x000A;&#x0009;EnableSignal = zeros(MaxNum,1);&#x000D;&#x000A;else&#x000D;&#x000A;&#x0009;EnableSignal = [zeros(NumChannels,1);ones(MaxNum-NumChannels,1)];&#x000D;&#x000A;end</Text>
