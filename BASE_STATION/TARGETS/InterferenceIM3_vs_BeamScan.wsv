<Item XName="PlotRxPowerVsScanAngle" UserName="PlotRxPowerVsScanAngle" Type="Equation">
<AutoCalc><T>Bool</T><D>0</D></AutoCalc>
<Selected><T>Bool</T><D>0</D></Selected>
<Text>using(&apos;DF2_Design2_Data&apos;);&#x000D;&#x000A;theta = [0 : 90] * pi/180;&#x000D;&#x000A;phi = [0 : 360] * pi/180;&#x000D;&#x000A;[THETA,PHI]=meshgrid(theta,phi);&#x000D;&#x000A;MAG1000M = reshape(Spec1000M,361,91);&#x000D;&#x000A;graph1=graph_figure(&apos;RxPowerVsScanAngle_1000MHz&apos;);&#x000D;&#x000A;graph1.add_spherical_data( PHI, THETA, max(10*log10(MAG1000M)+30,-30) );&#x000D;&#x000A;&#x000D;&#x000A;MAG900M = reshape(Spec900M,361,91);&#x000D;&#x000A;graph2=graph_figure(&apos;RxPowerVsScanAngle_900MHz&apos;);&#x000D;&#x000A;graph2.add_spherical_data( PHI, THETA, max(10*log10(MAG900M)+30,-30) );&#x000D;&#x000A;&#x000D;&#x000A;MAG1100M = reshape(Spec1100M,361,91);&#x000D;&#x000A;graph3=graph_figure(&apos;RxPowerVsScanAngle_1100MHz&apos;);&#x000D;&#x000A;graph3.add_spherical_data( PHI, THETA, max(10*log10(MAG1100M)+30,-30) );&#x000D;&#x000A;&#x000D;&#x000A;MAG800M = reshape(Spec800M,361,91);&#x000D;&#x000A;graph4=graph_figure(&apos;RxPowerVsScanAngle_800MHz&apos;);&#x000D;&#x000A;graph4.add_spherical_data( PHI, THETA, max(10*log10(MAG800M)+30,-30) );&#x000D;&#x000A;</Text>
