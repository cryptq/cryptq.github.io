<Item XName="Equations" Type="Equation">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>FlexOFDM_SamplingRate=OFDM_SampleFreq*2^OversamplingRatio;&#x000D;&#x000A;Idle=floor(IdleInterval*FlexOFDM_SamplingRate+0.5);&#x000D;&#x000A;&#x000D;&#x000A;if (MIMOType == 0 &amp; Pilot2_Enable == 1)&#x000D;&#x000A;&#x0009;error(&apos;When MIMOType is set to Type 1 (non-overlapping preamble and pilots), only one pilot set is supported which means Pilot2_Enable should be set to OFF.&apos;);&#x000D;&#x000A;end;&#x000D;&#x000A;&#x000D;&#x000A;&#x000D;&#x000A;if (0==GenConfigFile)     &#x000D;&#x000A;     % go into the workspace directory&#x000D;&#x000A;     current_dir = getworkspacedir;&#x000D;&#x000A;     cd(current_dir);&#x000D;&#x000A;     &#x000D;&#x000A;     % open files&#x000D;&#x000A;     fid_system=fopen(SV_SystemInfo,&apos;w&apos;);&#x000D;&#x000A;&#x0009; if(fid_system ==-1)&#x000D;&#x000A;     &#x0009;error(&apos;There is no permission to write a file!&apos;);&#x000D;&#x000A;&#x0009; end&#x000D;&#x000A;     fprintf(fid_system, &apos;%s %f %s\n&apos; , &apos;FCarrier:&apos;, FCarrier, &apos;Hz&apos;);&#x000D;&#x000A;     fprintf(fid_system, &apos;%s %f %s\n&apos; , &apos;Power:&apos;, Power_dBm, &apos;W&apos;);&#x000D;&#x000A;     fprintf(fid_system, &apos;%s %f %s\n&apos; , &apos;OFDM System Sample Frequency:&apos;, OFDM_SampleFreq, &apos;Hz&apos;);&#x000D;&#x000A;     fprintf(fid_system, &apos;%s %d\n&apos; , &apos;Upsampling ratio:&apos;, 2^OversamplingRatio);&#x000D;&#x000A;     fprintf(fid_system, &apos;%s %f %s\n&apos; , &apos;Subcarrier Space:&apos;, OFDM_SampleFreq/DFTSize, &apos;Hz&apos;);&#x000D;&#x000A;     fprintf(fid_system, &apos;\n&apos;);&#x000D;&#x000A;     &#x000D;&#x000A;     fprintf(fid_system, &apos;%s %d\n&apos; , &apos;FFT Length:&apos;, DFTSize);&#x000D;&#x000A;     fprintf(fid_system, &apos;%s %d\n&apos; , &apos;Guard Lower Subcarriers:&apos;, GuardLowerSubcarriers);&#x000D;&#x000A;     fprintf(fid_system, &apos;%s %d\n&apos; , &apos;Guard Upper Subcarriers:&apos;, GuardUpperSubcarriers);&#x000D;&#x000A;     fprintf(fid_system, &apos;%s %d\n&apos; , &apos;DC Subcarriers:&apos;, NumOfDC_Subcarriers);&#x000D;&#x000A;     fprintf(fid_system, &apos;%s %f\n&apos; , &apos;Guard Interval:&apos;, GuardInterval);&#x000D;&#x000A;     fprintf(fid_system, &apos;\n&apos;);&#x000D;&#x000A;     &#x000D;&#x000A;     if (0==Preamble_FrequencyDomain)&#x000D;&#x000A;         fprintf(fid_system, &apos;%s %s\n&apos; , &apos;Preamble is in frequency domian:&apos;, &apos;YES&apos;);&#x000D;&#x000A;     else&#x000D;&#x000A;         fprintf(fid_system, &apos;%s %s\n&apos; , &apos;Preamble is in frequency domian:&apos;, &apos;NO&apos;);&#x000D;&#x000A;     end;&#x000D;&#x000A;            &#x000D;&#x000A;     if (0==Preamble1_Enable)&#x000D;&#x000A;         fprintf(fid_system, &apos;%s %s\n&apos; , &apos;Preamble1 is ON or OFF:&apos;, &apos;OFF&apos;);&#x000D;&#x000A;     else&#x000D;&#x000A;         fprintf(fid_system, &apos;%s %s\n&apos; , &apos;Preamble1 is ON or OFF:&apos;, &apos;ON&apos;);&#x000D;&#x000A;     end;&#x000D;&#x000A;     &#x000D;&#x000A;     if (0==Preamble2_Enable)&#x000D;&#x000A;         fprintf(fid_system, &apos;%s %s\n&apos; , &apos;Preamble2 is ON or OFF:&apos;, &apos;OFF&apos;);&#x000D;&#x000A;     else&#x000D;&#x000A;         fprintf(fid_system, &apos;%s %s\n&apos; , &apos;Preamble2 is ON or OFF:&apos;, &apos;ON&apos;);&#x000D;&#x000A;     end;&#x000D;&#x000A;     &#x000D;&#x000A;     fprintf(fid_system, &apos;\n&apos;);&#x000D;&#x000A;     &#x000D;&#x000A;     fprintf(fid_system, &apos;%s %d\n&apos; , &apos;Data1 number of OFDM symbols:&apos;, Data1_NumOfSym);&#x000D;&#x000A;     if (0==Data2_Enable)&#x000D;&#x000A;         fprintf(fid_system, &apos;%s %s\n&apos; , &apos;Data2 is ON or OFF:&apos;, &apos;OFF&apos;);&#x000D;&#x000A;     else&#x000D;&#x000A;         fprintf(fid_system, &apos;%s %s\n&apos; , &apos;Data2 is ON or OFF:&apos;, &apos;ON&apos;);&#x000D;&#x000A;         fprintf(fid_system, &apos;%s %d\n&apos; , &apos;Data2 number of OFDM symbols:&apos;, Data2_NumOfSym);&#x000D;&#x000A;     end;&#x000D;&#x000A;     &#x000D;&#x000A;     fprintf(fid_system, &apos;\n&apos;);&#x000D;&#x000A;     if (0==Pilot1_Enable)&#x000D;&#x000A;         fprintf(fid_system, &apos;%s %s\n&apos; , &apos;Pilot1 is ON or OFF:&apos;, &apos;OFF&apos;);&#x000D;&#x000A;     else&#x000D;&#x000A;         fprintf(fid_system, &apos;%s %s\n&apos; , &apos;Pilot1 is ON or OFF:&apos;, &apos;ON&apos;);&#x000D;&#x000A;     end;&#x000D;&#x000A;     &#x000D;&#x000A;     if (0==Pilot2_Enable)&#x000D;&#x000A;         fprintf(fid_system, &apos;%s %s\n&apos; , &apos;Pilot2 is ON or OFF:&apos;, &apos;OFF&apos;);&#x000D;&#x000A;     else&#x000D;&#x000A;         fprintf(fid_system, &apos;%s %s\n&apos; , &apos;Pilot2 is ON or OFF:&apos;, &apos;ON&apos;);&#x000D;&#x000A;     end;&#x000D;&#x000A;     &#x000D;&#x000A;     fprintf(fid_system, &apos;\n&apos;);&#x000D;&#x000A;     if (0==SymbolWindowing_Enable)&#x000D;&#x000A;         fprintf(fid_system, &apos;%s %s\n&apos; , &apos;Symbol windowing function is ON or OFF:&apos;, &apos;OFF&apos;);&#x000D;&#x000A;     else&#x000D;&#x000A;         fprintf(fid_system, &apos;%s %s\n&apos; , &apos;Symbol windowing function is ON or OFF:&apos;, &apos;ON&apos;);&#x000D;&#x000A;     end;&#x000D;&#x000A;&#x000D;&#x000A;     DFTSize_OVS=DFTSize*2^OversamplingRatio;&#x000D;&#x000A;     if (1==Preamble1_Enable)&#x000D;&#x000A;         if (0==Preamble_FrequencyDomain)&#x000D;&#x000A;             Preamble1_Samps=Preamble1_RepeatTimes*DFTSize_OVS*(1+Preamble1_GuardInterval);&#x000D;&#x000A;         else&#x000D;&#x000A;             Preamble1_Samps=Preamble1_RepeatTimes*Preamble1_Blocksize_OVS*(1+Preamble1_GuardInterval);&#x000D;&#x000A;         end;&#x000D;&#x000A;     else&#x000D;&#x000A;         Preamble1_Samps=0;&#x000D;&#x000A;     end;&#x000D;&#x000A;&#x000D;&#x000A;     if (1==Preamble2_Enable)&#x000D;&#x000A;         if (0==Preamble_FrequencyDomain)&#x000D;&#x000A;             Preamble2_Samps=Preamble2_RepeatTimes*DFTSize_OVS*(1+Preamble2_GuardInterval);&#x000D;&#x000A;         else&#x000D;&#x000A;             Preamble2_Samps=Preamble2_RepeatTimes*Preamble2_Blocksize_OVS*(1+Preamble2_GuardInterval);&#x000D;&#x000A;         end;&#x000D;&#x000A;     else&#x000D;&#x000A;         Preamble2_Samps=0;&#x000D;&#x000A;     end;&#x000D;&#x000A;&#x000D;&#x000A;     if (0==Data2_Enable)&#x000D;&#x000A;         Data_NumSym=Data1_NumOfSym;&#x000D;&#x000A;     else&#x000D;&#x000A;         Data_NumSym=Data1_NumOfSym+Data2_NumOfSym;&#x000D;&#x000A;     end&#x000D;&#x000A;&#x000D;&#x000A;     Data_Samps=Data_NumSym*DFTSize_OVS*(1+GuardInterval);&#x000D;&#x000A;&#x000D;&#x000A;     Frame_Samps=Preamble1_Samps+Preamble2_Samps+Data_Samps+Idle;&#x000D;&#x000A;     fprintf(fid_system, &apos;%s %d\n&apos; , &apos;Number of samples per frame:&apos;, Frame_Samps);&#x000D;&#x000A;     fclose(fid_system);&#x000D;&#x000A;end;</Text>
<UnitUse><T>Int</T><D>2</D></UnitUse>
<Item XName="BPMgr" Type="BPMgr">
<BPLines><T>Array_I64</T><D>1;0;</D></BPLines>
<BPStates><T>Array_I64</T><D>1;0;</D></BPStates></Item>
