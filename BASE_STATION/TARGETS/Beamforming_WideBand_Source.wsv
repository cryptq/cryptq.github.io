<Lang><T>Int</T><D>1</D></Lang></Item>
<Item XName="Font" Type="Font">
<Name>Courier New</Name>
<Size><T>Double</T><D>125</D></Size></Item>
<Item XName="FunctionBlock" Type="FunctionBlock" />
<Item XName="Page" Type="PageMgr" />
<Item XName="VarBlock" Type="VarBlock">
<Item XName="DFTSize" Type="Variable">
<Data><T>Double</T><D>64</D></Data></Item>
<Item XName="Data1_MappingTable" Type="Variable">
<Data><T>Array_Dbl64</T><D>1;0;</D></Data></Item>
<Item XName="Data1_MappingType" Type="Variable">
<Data><T>Double</T><D>1</D></Data></Item>
<Item XName="Data1_NumOfSym" Type="Variable">
<Data><T>Double</T><D>5</D></Data></Item>
<Item XName="Data2_Enable" Type="Variable">
<Data><T>Double</T><D>1</D></Data></Item>
<Item XName="Data2_MappingTable" Type="Variable">
<Data><T>Array_Dbl64</T><D>1;0;</D></Data></Item>
<Item XName="Data2_MappingType" Type="Variable">
<Data><T>Double</T><D>3</D></Data></Item>
<Item XName="Data2_NumOfSym" Type="Variable">
<Data><T>Double</T><D>5</D></Data></Item>
<Item XName="Data_CarrierIndex" Type="Variable">
<Data><T>Array_Dbl64</T><D>2;48;1;w0C;v0C;u0C;t0C;s0C;q0C;p0C;o0C;n0C;m0C;k0C;i0C;g0C;e0C;c0C;a0C;Y0C;W0C;O0C;K0C;G0C;80C;C;m}B;m}3;4;804;G04;K04;O04;W04;Y04;a04;c04;e04;g04;i04;k04;m04;n04;o04;p04;q04;s04;t04;u04;v04;w04</D></Data></Item>
<Item XName="Data_DimCarrierIndex" Type="Variable">
<Data><T>Double</T><D>0</D></Data></Item>
<Item XName="Data_FileFormat" Type="Variable">
<Data><T>Double</T><D>0</D></Data></Item>
<Item XName="Data_FileName" Type="Variable">
<Data /></Item>
<Item XName="Data_NumOfCarriers" Type="Variable">
<Data><T>Double</T><D>48</D></Data></Item>
<Item XName="EVMRef_CarrierIndex" Type="Variable">
<Data><T>Array_Dbl64</T><D>2;52;1;w0C;v0C;u0C;t0C;s0C;r0C;q0C;p0C;o0C;n0C;m0C;k0C;i0C;g0C;e0C;c0C;a0C;Y0C;W0C;R0C;O0C;K0C;G0C;80C;C;m}B;m}3;4;804;G04;K04;O04;R04;W04;Y04;a04;c04;e04;g04;i04;k04;m04;n04;o04;p04;q04;r04;s04;t04;u04;v04;w04</D></Data></Item>
<Item XName="EVMRef_DimCarrierIndex" Type="Variable">
<Data><T>Double</T><D>0</D></Data></Item>
<Item XName="EVMRef_FileFormat" Type="Variable">
<Data><T>Double</T><D>0</D></Data></Item>
<Item XName="EVMRef_FileName" Type="Variable">
<Data /></Item>
<Item XName="EVMRef_NumOfCarriers" Type="Variable">
<Data><T>Double</T><D>52</D></Data></Item>
<Item XName="FCarrier" Type="Variable">
<Data><T>Double</T><D>5000000000</D></Data>
<Unit><T>Int</T><D>1003</D></Unit></Item>
<Item XName="FlexOFDM_SamplingRate" Type="Variable">
<Creator>Equations</Creator>
<Data><T>Double</T><D>40000000</D></Data>
<Unit><T>Int</T><D>1001</D></Unit></Item>
<Item XName="GenConfigFile" Type="Variable">
<Data><T>Double</T><D>1</D></Data></Item>
<Item XName="GuardInterval" Type="Variable">
<Data><T>Double</T><D>0.25</D></Data></Item>
<Item XName="GuardIntervalType" Type="Variable">
<Data><T>Double</T><D>0</D></Data></Item>
<Item XName="GuardLowerSubcarriers" Type="Variable">
<Data><T>Double</T><D>6</D></Data></Item>
<Item XName="GuardUpperSubcarriers" Type="Variable">
<Data><T>Double</T><D>5</D></Data></Item>
<Item XName="Idle" Type="Variable">
<Creator>Equations</Creator>
<Data><T>Double</T><D>160</D></Data></Item>
<Item XName="IdleInterval" Type="Variable">
<Data><T>Double</T><D>4e-06</D></Data>
<Unit><T>Int</T><D>7002</D></Unit></Item>
