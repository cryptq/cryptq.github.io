<Item XName="FunctionBlock" Type="FunctionBlock" />
<Item XName="VarBlock" Type="VarBlock" /></Item>
<Item XName="Note" UserName="Note" Type="Notes">
<Selected><T>Bool</T><D>0</D></Selected>
<Text>&lt;SPAN style=&quot;FONT-SIZE: 12pt; FONT-FAMILY: &apos;Times New Roman&apos;,&apos;serif&apos;; mso-fareast-font-family: &apos;Times New Roman&apos;&quot;&gt;&lt;?xml:namespace prefix = &quot;o&quot; ns = &quot;urn:schemas-microsoft-com:office:office&quot; /&gt;&lt;o:p&gt; &#x000D;&#x000A;&lt;P class=MsoTitle style=&quot;BORDER-TOP: medium none; BORDER-RIGHT: medium none; BORDER-BOTTOM: windowtext 0.75pt solid; PADDING-BOTTOM: 1pt; PADDING-TOP: 0in; PADDING-LEFT: 0in; MARGIN: 0in 0in 0pt; BORDER-LEFT: medium none; PADDING-RIGHT: 0in&quot; align=center&gt;&lt;FONT size=5 face=Arial&gt;&lt;SPAN style=&quot;FONT-SIZE: 18pt; FONT-FAMILY: Arial&quot;&gt;&lt;STRONG&gt;Wideband OFDM Beamforming Measurement &lt;/STRONG&gt;&lt;/SPAN&gt;&lt;/FONT&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoBodyText style=&quot;MARGIN: 0in 0in 0pt&quot; align=center&gt;&lt;FONT size=2&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: Arial; mso-bidi-font-size: 12.0pt&quot;&gt;Keysight Technologies SystemVue Example Workspace&lt;/SPAN&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; mso-bidi-font-size: 12.0pt&quot;&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;TEXT-ALIGN: center; MARGIN: 0in 0in 0pt; LINE-HEIGHT: normal&quot; align=center&gt;&lt;/FONT&gt;&amp;nbsp;&lt;/o:p&gt;&lt;/SPAN&gt;&lt;/P&gt;&lt;SPAN style=&quot;FONT-SIZE: 10pt; FONT-FAMILY: &apos;Arial&apos;,&apos;sans-serif&apos;; mso-fareast-font-family: &apos;Times New Roman&apos;&quot;&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 8pt&quot;&gt;&lt;FONT face=Calibri&gt;This example provides the measurement for beamforming transmission with wideband OFDM system.&lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 8pt&quot;&gt;&lt;FONT face=Calibri&gt;Supported features:&lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoListParagraphCxSpFirst style=&quot;MARGIN: 0in 0in 0pt 0.5in; LINE-HEIGHT: 105%; TEXT-INDENT: -0.25in; mso-list: l2 level1 lfo1&quot;&gt;&lt;SPAN style=&quot;FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol&quot;&gt;&lt;SPAN style=&quot;mso-list: Ignore&quot;&gt;&#x00B7;&lt;SPAN style=&quot;FONT: 7pt &apos;Times New Roman&apos;&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;FONT face=Calibri&gt;Support flexible beamforming structure, including full digital beamforming, hybrid beamforming and full RF/analog beamforming. &lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoListParagraphCxSpMiddle style=&quot;MARGIN: 0in 0in 0pt 0.5in; LINE-HEIGHT: 105%; TEXT-INDENT: -0.25in; mso-list: l2 level1 lfo1&quot;&gt;&lt;SPAN style=&quot;FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol&quot;&gt;&lt;SPAN style=&quot;mso-list: Ignore&quot;&gt;&#x00B7;&lt;SPAN style=&quot;FONT: 7pt &apos;Times New Roman&apos;&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;FONT face=Calibri&gt;Support OFDM MIMO transmission&lt;/FONT&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoListParagraphCxSpMiddle style=&quot;MARGIN: 0in 0in 0pt 0.5in; LINE-HEIGHT: 105%; TEXT-INDENT: -0.25in; mso-list: l2 level1 lfo1&quot;&gt;&lt;FONT face=Calibri&gt;&lt;SPAN style=&quot;FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol&quot;&gt;&lt;SPAN style=&quot;mso-list: Ignore&quot;&gt;&#x00B7;&lt;SPAN style=&quot;FONT: 7pt &apos;Times New Roman&apos;&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;Support RF impairments&lt;/FONT&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoListParagraphCxSpMiddle style=&quot;MARGIN: 0in 0in 0pt 0.5in; LINE-HEIGHT: 105%; TEXT-INDENT: -0.25in; mso-list: l2 level1 lfo1&quot;&gt;&lt;SPAN style=&quot;FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol&quot;&gt;&lt;SPAN style=&quot;mso-list: Ignore&quot;&gt;&#x00B7;&lt;SPAN style=&quot;FONT: 7pt &apos;Times New Roman&apos;&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;FONT face=Calibri&gt;Support Taylor window for RF beamforming&lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoListParagraphCxSpMiddle style=&quot;MARGIN: 0in 0in 0pt 0.5in; LINE-HEIGHT: 105%; TEXT-INDENT: -0.25in; mso-list: l2 level1 lfo1&quot;&gt;&lt;SPAN style=&quot;FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol&quot;&gt;&lt;SPAN style=&quot;mso-list: Ignore&quot;&gt;&#x00B7;&lt;SPAN style=&quot;FONT: 7pt &apos;Times New Roman&apos;&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;FONT face=Calibri&gt;Support antenna coupling&lt;/FONT&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoListParagraphCxSpMiddle style=&quot;MARGIN: 0in 0in 0pt 0.5in; LINE-HEIGHT: 105%; TEXT-INDENT: -0.25in; mso-list: l2 level1 lfo1&quot;&gt;&lt;SPAN style=&quot;FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol&quot;&gt;&lt;SPAN style=&quot;mso-list: Ignore&quot;&gt;&#x00B7;&lt;SPAN style=&quot;FONT: 7pt &apos;Times New Roman&apos;&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;FONT face=Calibri&gt;Support CCDF and spectrum measurement&lt;/FONT&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoListParagraphCxSpMiddle style=&quot;MARGIN: 0in 0in 0pt 0.5in; LINE-HEIGHT: 105%; TEXT-INDENT: -0.25in; mso-list: l2 level1 lfo1&quot;&gt;&lt;FONT face=Calibri&gt;&lt;SPAN style=&quot;FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol&quot;&gt;&lt;SPAN style=&quot;mso-list: Ignore&quot;&gt;&#x00B7;&lt;SPAN style=&quot;FONT: 7pt &apos;Times New Roman&apos;&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;Support transmitter dynamic 3D beam plotting for combined signal and each RF channel&lt;/FONT&gt;&lt;/P&gt;&lt;FONT face=Calibri&gt;&#x000D;&#x000A;&lt;P class=MsoListParagraphCxSpMiddle style=&quot;MARGIN: 0in 0in 0pt 0.5in; LINE-HEIGHT: 105%; TEXT-INDENT: -0.25in; mso-list: l2 level1 lfo1&quot;&gt;&lt;SPAN style=&quot;FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol&quot;&gt;&lt;SPAN style=&quot;mso-list: Ignore&quot;&gt;&#x00B7;&lt;SPAN style=&quot;FONT: 7pt &apos;Times New Roman&apos;&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;FONT face=Calibri&gt;Support customer beam pattern import with EMpro and HFSS formats&lt;/FONT&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoListParagraphCxSpLast style=&quot;MARGIN: 0in 0in 8pt 0.5in; LINE-HEIGHT: 105%; TEXT-INDENT: -0.25in; mso-list: l2 level1 lfo1&quot;&gt;&lt;SPAN style=&quot;FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol&quot;&gt;&lt;SPAN style=&quot;mso-list: Ignore&quot;&gt;&#x00B7;&lt;SPAN style=&quot;FONT: 7pt &apos;Times New Roman&apos;&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;FONT face=Calibri&gt;Support EVM measurement and constellation output&lt;/FONT&gt;&lt;/FONT&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoListParagraphCxSpLast style=&quot;MARGIN: 0in 0in 8pt 0.5in; LINE-HEIGHT: 105%; TEXT-INDENT: -0.25in; mso-list: l2 level1 lfo1&quot; align=left&gt;&lt;FONT face=Calibri&gt;&lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&amp;nbsp;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 8pt&quot;&gt;&lt;FONT face=Calibri&gt;The parameters to configure the simulation are located in Equation Tab of&amp;nbsp;Design1&amp;nbsp;with the following categories.&lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoListParagraphCxSpFirst style=&quot;MARGIN: 0in 0in 0pt 0.5in; TEXT-INDENT: -0.25in; mso-list: l0 level1 lfo3&quot;&gt;&lt;SPAN style=&quot;FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol&quot;&gt;&lt;SPAN style=&quot;mso-list: Ignore&quot;&gt;&#x00B7;&lt;SPAN style=&quot;FONT: 7pt &apos;Times New Roman&apos;&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;FONT face=Calibri&gt;&lt;STRONG&gt;System configuration&lt;/STRONG&gt;: set key parameters for the whole system, including central frequency, sample rate, power and RF chains. Also users can set desired beam direction for each RF chains.&lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoListParagraphCxSpMiddle style=&quot;MARGIN: 0in 0in 0pt 0.5in; TEXT-INDENT: -0.25in; mso-list: l0 level1 lfo3&quot;&gt;&lt;SPAN style=&quot;FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol&quot;&gt;&lt;SPAN style=&quot;mso-list: Ignore&quot;&gt;&#x00B7;&lt;SPAN style=&quot;FONT: 7pt &apos;Times New Roman&apos;&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;FONT face=Calibri&gt;&lt;STRONG&gt;Antenna array configuration&lt;/STRONG&gt;: define antenna array structure and the mapping from RF chains to antennas.&lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoListParagraphCxSpMiddle style=&quot;MARGIN: 0in 0in 0pt 0.5in; TEXT-INDENT: -0.25in; mso-list: l0 level1 lfo3&quot;&gt;&lt;SPAN style=&quot;FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol&quot;&gt;&lt;SPAN style=&quot;mso-list: Ignore&quot;&gt;&#x00B7;&lt;SPAN style=&quot;FONT: 7pt &apos;Times New Roman&apos;&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;FONT face=Calibri&gt;&lt;STRONG&gt;Impairment analysis&lt;/STRONG&gt;: set the impairments in antenna array, RF power amplifiers.&lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoListParagraphCxSpLast style=&quot;MARGIN: 0in 0in 8pt 0.5in; TEXT-INDENT: -0.25in; mso-list: l0 level1 lfo3&quot;&gt;&lt;SPAN style=&quot;FONT-FAMILY: Symbol; mso-fareast-font-family: Symbol; mso-bidi-font-family: Symbol&quot;&gt;&lt;SPAN style=&quot;mso-list: Ignore&quot;&gt;&#x00B7;&lt;SPAN style=&quot;FONT: 7pt &apos;Times New Roman&apos;&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;FONT face=Calibri&gt;&lt;STRONG&gt;OFDM source configuration&lt;/STRONG&gt;: configure OFDM MIMO source&lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 8pt&quot;&gt;&lt;o:p&gt;&lt;FONT face=Calibri&gt;It is suggested to change parameters in &lt;STRONG&gt;System configuration&lt;/STRONG&gt;, &lt;STRONG&gt;Antenna array configuration&lt;/STRONG&gt; and &lt;STRONG&gt;Impairment analysis &lt;/STRONG&gt;per system configuration, and leave the parameter in &lt;STRONG&gt;OFDM source configuration &lt;/STRONG&gt;unchanged for OFDM MIMO source if there is no need to change OFDM signals.&lt;/FONT&gt;&lt;/o:p&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 8pt&quot;&gt;&lt;o:p&gt;&amp;nbsp;&lt;/o:p&gt;&lt;FONT face=Calibri&gt;Notes: &lt;o:p&gt;&lt;/o:p&gt;&lt;/FONT&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoListParagraphCxSpFirst style=&quot;MARGIN: 0in 0in 0pt 0.5in; TEXT-INDENT: -0.25in; mso-list: l1 level1 lfo2&quot;&gt;&lt;SPAN style=&quot;mso-fareast-font-family: Calibri; mso-bidi-font-family: Calibri; mso-fareast-theme-font: minor-latin; mso-bidi-theme-font: minor-latin&quot;&gt;&lt;SPAN style=&quot;mso-list: Ignore&quot;&gt;&lt;FONT face=Calibri&gt;1.&lt;/FONT&gt;&lt;SPAN style=&quot;FONT: 7pt &apos;Times New Roman&apos;&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;FONT face=Calibri&gt;For antenna array, ULA (uniform&amp;nbsp;linear array) and UPA (uniform planar array)&amp;nbsp;arrays are supported. And the antenna array is expected to be placed on Y-Z plane which means the number of antennas in x-axis (NumOfAntx) should be equal to 1. &lt;/FONT&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoListParagraphCxSpFirst style=&quot;MARGIN: 0in 0in 0pt 0.5in; TEXT-INDENT: -0.25in; mso-list: l1 level1 lfo2&quot;&gt;&lt;SPAN style=&quot;mso-fareast-font-family: Calibri; mso-bidi-font-family: Calibri; mso-fareast-theme-font: minor-latin; mso-bidi-theme-font: minor-latin&quot;&gt;&lt;SPAN style=&quot;mso-list: Ignore&quot;&gt;&lt;FONT face=Calibri&gt;2.&lt;/FONT&gt;&lt;SPAN style=&quot;FONT: 7pt &apos;Times New Roman&apos;&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;/SPAN&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&lt;FONT face=Calibri&gt;For antenna pattern predefined for three sector antenna when &lt;STRONG&gt;AntennaPatternType &lt;/STRONG&gt;=&lt;STRONG&gt; Three Sector Antenna for Y-Z URA&lt;/STRONG&gt;, the generated antenna pattern towards x-axis which is consistent with the assumption of antenna array in Y-Z plane.&lt;/FONT&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoListParagraphCxSpLast style=&quot;MARGIN: 0in 0in 8pt 0.5in; TEXT-INDENT: -0.25in; mso-list: l1 level1 lfo2&quot;&gt;&lt;FONT face=Calibri&gt;3.&amp;nbsp;&amp;nbsp; &lt;/FONT&gt;&lt;SPAN style=&quot;FONT-SIZE: 11pt; FONT-FAMILY: &apos;Calibri&apos;,&apos;sans-serif&apos;; LINE-HEIGHT: 107%; mso-fareast-font-family: SimSun; mso-bidi-font-family: &apos;Times New Roman&apos;; mso-fareast-theme-font: minor-fareast; mso-bidi-theme-font: minor-bidi; mso-ascii-theme-font: minor-latin; mso-hansi-theme-font: minor-latin; mso-ansi-language: EN-US; mso-fareast-language: ZH-CN; mso-bidi-language: AR-SA&quot;&gt;As a result, to have custom antenna pattern work properly, it is expected that custom 3D antenna beam&amp;nbsp;pattern towards x-axis when&amp;nbsp;&lt;STRONG&gt;AntennaPatternType&lt;/STRONG&gt; = &lt;STRONG&gt;Pattern File&lt;/STRONG&gt;.&lt;/SPAN&gt;&lt;/P&gt;&#x000D;&#x000A;&lt;P class=MsoListParagraphCxSpLast style=&quot;MARGIN: 0in 0in 8pt 0.5in; TEXT-INDENT: -0.25in; mso-list: l1 level1 lfo2&quot;&gt;&lt;SPAN style=&quot;FONT-SIZE: 11pt; FONT-FAMILY: &apos;Calibri&apos;,&apos;sans-serif&apos;; LINE-HEIGHT: 107%; mso-fareast-font-family: SimSun; mso-bidi-font-family: &apos;Times New Roman&apos;; mso-fareast-theme-font: minor-fareast; mso-bidi-theme-font: minor-bidi; mso-ascii-theme-font: minor-latin; mso-hansi-theme-font: minor-latin; mso-ansi-language: EN-US; mso-fareast-language: ZH-CN; mso-bidi-language: AR-SA&quot;&gt;4.&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; For EVM measurement, the default receiver beamforming is optimal&amp;nbsp;as the recevier beams (defined by RxTheta and RxPhi in Equations Tab) are exactly pointed to transmit beam directions. Users can change thest two values if reveiver beamforming is not ideal.&lt;/SPAN&gt;&lt;/P&gt;&lt;SPAN style=&quot;FONT-SIZE: 11pt; FONT-FAMILY: &apos;Calibri&apos;,&apos;sans-serif&apos;; LINE-HEIGHT: 107%; mso-fareast-font-family: SimSun; mso-bidi-font-family: &apos;Times New Roman&apos;; mso-fareast-theme-font: minor-fareast; mso-bidi-theme-font: minor-bidi; mso-ascii-theme-font: minor-latin; mso-hansi-theme-font: minor-latin; mso-ansi-language: EN-US; mso-fareast-language: ZH-CN; mso-bidi-language: AR-SA&quot;&gt;&#x000D;&#x000A;&lt;P class=MsoNormal style=&quot;MARGIN: 0in 0in 0pt; LINE-HEIGHT: normal; mso-layout-grid-align: none&quot;&gt;&lt;FONT face=Calibri&gt;&amp;nbsp;With default, the dataset does not exist in this workspace due to its huge size. To get the results, please run the simulation.&lt;/FONT&gt;&lt;/P&gt;&lt;/SPAN&gt;&lt;/SPAN&gt;&#x000D;&#x000A;&lt;P&gt;&amp;nbsp;&lt;/P&gt;&#x000D;&#x000A;&lt;P&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;/P&gt;</Text>
